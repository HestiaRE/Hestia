# editorconfig.org - HestiaRE. Also read by shfmt, which is why the shell block below is not merely
# cosmetic: it IS the format contract the lint gate enforces (#477). The settings match the
# prettier-plugin-sh config HestiaCP uses, so the existing tree already conforms.
#
# PHP is the exception: php-cs-fixer does NOT read this file, so its contract lives in
# .php-cs-fixer.dist.php and repeats the indentation there. Change one, change the other - a
# disagreement means the formatter rewrites the whole tree on the next run.
root = true

[*]
charset = utf-8
indent_style = tab
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing whitespace is meaningful in Markdown (two spaces = line break).
[*.md]
trim_trailing_whitespace = false

# YAML forbids tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell: the house style deviates from shfmt's defaults on all three counts, so a bare `shfmt -d`
# would want to rewrite the whole tree. Spaced redirections (`2> /dev/null`), a leading `&&` on
# continuation lines, and indented case arms.
# The three extensionless scripts are named one by one because their directories also hold
# non-shell files; the gate's own coverage check is what keeps that list from going stale.
[{bin/h-*,sbin/*,include/*.sh,install.sh,update.sh,.gitea/tools/*.sh,share/**.sh,web/locale/*.sh,share/apache2/httpd-prerotate/awstats,share/bubblewrap/jailbash,share/security/hestia-jail.init,share/dovecot/sieve-learn/hestia-rspamd-learn,share/quota/initramfs/hestia-quota.hook,share/quota/initramfs/hestia-quota.premount}]
switch_case_indent = true
space_redirects = true
binary_next_line = true

#!/bin/bash
# info: update user notification
# options: USER NOTIFICATION
#
# example: h-acknowledge-user-notification
#
# Marks one notification of a user, or all of them, as read.

user=$1
id=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER NOTIFICATION'
if [ "$id" = "all" ]; then
	is_format_valid 'user'
else
	is_format_valid 'user' 'id'
fi
is_object_valid 'user' 'USER' "$user"

if [ "$id" = 'all' ]; then
	# The ids from the records themselves: the plain list carries decoded text, which may span lines.
	for id in $(grep -o "^NID='[0-9]*'" "$USER_DATA/notifications.conf" 2> /dev/null | cut -d "'" -f 2); do
		update_object_value 'notifications' 'NID' "$id" '$ACK' 'yes' 2> /dev/null
	done
	notice='no'
else
	update_object_value 'notifications' 'NID' "$id" '$ACK' 'yes' 2> /dev/null

	if [ -e "$USER_DATA/notifications.conf" ]; then
		if [ -z "$(grep NID= $USER_DATA/notifications.conf)" ]; then
			notice='no'
		fi
		if [ -z "$(grep "ACK='no'" $USER_DATA/notifications.conf)" ]; then
			notice='no'
		fi
	else
		notice='no'
	fi
fi

if [ "$notice" = 'no' ]; then
	if [ -z "$(grep NOTIFICATIONS $USER_DATA/user.conf)" ]; then
		sed -i "s/^TIME/NOTIFICATIONS='no'\nTIME/g" $USER_DATA/user.conf
	else
		update_user_value "$user" '$NOTIFICATIONS' "no"
	fi
fi

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add backup host
# options: TYPE HOST USERNAME PASSWORD [PATH] [PORT] [KEEP]
#
# example: h-add-backup-host sftp backup.acme.com admin 'P4$$w@rD'
#
# Add a new remote backup location. Currently SFTP, FTP and rclone are supported

type=$1
host=$2
# The REMOTE login, apart from $user: that one falls back to $ROOT_USER, and a local target has no login at all.
remote_user=$3
raw_password=$4
# A /tmp secret file is resolved BEFORE quotemeta, or is_password_valid sees an escaped path; a key file keeps its path.
if [[ "$raw_password" =~ ^/tmp/ ]] && [[ "$raw_password" != *../* ]] && [ ! -L "$raw_password" ] \
	&& [ -f "$raw_password" ] && ! grep -q "OPENSSH PRIVATE" "$raw_password" 2> /dev/null; then
	raw_password="$(head -n1 "$raw_password")"
fi
HIDE=4
password=$(perl -e 'print quotemeta shift(@ARGV)' "${raw_password}")
path=${5-/backup}
port=$6
# How many sets THIS target retains; empty mirrors the BACKUPS of the customer package.
keep=$7

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$type" != 'local' ]; then
	check_args '2' "$#" "TYPE HOST USERNAME PASSWORD [PATH] [PORT] [KEEP]"
	# The dispatch picks the validator by VARIABLE name: the alias carries the family-open check for a remote address.
	host46="$host"
	is_format_valid 'host46' 'path' 'port'
	if [ -n "$keep" ]; then
		is_int_format_valid "$keep" 'keep'
		# 0 is refused: handed to the rotation it deletes everything on this target, and an admin typing 0 means "empty".
		if [ "$keep" -eq 0 ]; then
			check_result "$E_INVALID" "keep 0 would retain nothing - leave it empty to mirror the package limit"
		fi
	fi
	is_type_valid 'sftp,ftp,rclone' "$type"
	is_username_format_valid "$remote_user" "username"
	privatekey="no"
	if [ -f "$raw_password" ]; then
		if [[ $(cat "$raw_password" | grep "OPENSSH PRIVATE") ]]; then
			privatekey="yes"
			password="$raw_password"
		else
			is_password_valid
		fi
	else
		is_password_valid
	fi
	format_no_quotes "$password" "password"

	if [ "$type" = 'sftp' ]; then
		which expect > /dev/null 2>&1
		check_result $? "expect command not found" "$E_NOTEXIST"
	fi
	if [ "$type" != 'rclone' ]; then
		if ! looks_like_ip46 "$host"; then
			host "$host" > /dev/null 2>&1
			check_result $? "host connection failed" "$E_CONNECT"
		fi
	fi
fi

if [ "$type" = 'ftp' ]; then
	if [ -z $port ]; then
		port=21
	fi
	PORT=$port
	USERNAME=$remote_user
	PASSWORD=$password
	HOST=$host
	PRIVATEKEY=$privatekey

	fconn=$(ftpc 2>&1)
	ferror=$(echo $fconn \
		| grep -i -e failed -e error -e "can't" -e "not conn" -e "incorrect")
	if [ -n "$ferror" ]; then
		echo "Error: can't login to ftp $remote_user@$host"
		log_event "$E_CONNECT" "$ARGUMENTS"
		exit "$E_CONNECT"
	fi

	if [ -z $path ]; then
		ftmpdir="vst.bK76A9SUkt"
	else
		ftpc "mkdir $path" > /dev/null 2>&1
		ftmpdir="$path/vst.bK76A9SUkt"
	fi
	ftp_result=$(ftpc "mkdir $ftmpdir" "rm $ftmpdir" | grep -v Trying)
	if [ -n "$ftp_result" ]; then
		echo "$ftp_result"
		rm -rf $tmpdir
		echo "Error: can't create $ftmpdir folder on the ftp"
		log_event "$E_FTP" "$ARGUMENTS"
		exit "$E_FTP"
	fi
fi

if [ "$type" = 'sftp' ]; then
	if [ -z $port ]; then
		port=22
	fi
	PORT=$port
	USERNAME=$remote_user
	PASSWORD=$password
	HOST=$host
	if [ -z $path ]; then
		sftmpdir="vst.bK76A9SUkt"
		sftpc "mkdir $sftmpdir" "rmdir $sftmpdir" > /dev/null 2>&1
	else
		if sftpc "mkdir $path" > /dev/null 2>&1; then
			sftmpdir="$path/vst.bK76A9SUkt"
			sftpc "mkdir $sftmpdir" "rmdir $sftmpdir" > /dev/null 2>&1
		else
			sftmpdir="$path/vst.bK76A9SUkt"
			sftpc "mkdir $sftmpdir" "rmdir $sftmpdir" > /dev/null 2>&1
		fi
	fi
	rc=$?
	if [[ "$rc" -ne 0 ]]; then
		case $rc in
			$E_CONNECT) echo "Error: can't login to sftp $remote_user@$host" ;;
			$E_FTP) echo "Error: can't create temp folder on the sftp host" ;;
			*) echo "Error Unable to connect via sftp." ;;
		esac
		log_event "$rc" "$ARGUMENTS"
		exit "$rc"
	fi
fi

if [ "$type" = 'rclone' ]; then
	# No installer download: rclone is an OS package, and an unbounded curl|bash is the external-download trap.
	which rclone > /dev/null 2>&1 || check_result "$E_NOTEXIST" "rclone is not installed (apt install rclone)"
	if [ ! -z "$(cat /root/.config/rclone/rclone.conf | grep "\[$host\]")" ]; then
		echo "test" > /tmp/hestia-backup.txt
		if [ -z "$path" ]; then
			rclone copy /tmp/hestia-backup.txt $host:/hestia-backup.txt
			rclone delete $host:/hestia-backup.txt
		else
			rclone copy /tmp/hestia-backup.txt $host:$path/hestia-backup.txt
			rclone delete $host:$path/hestia-backup.txt
		fi
	else
		check_result "$E_CONNECT" "Rclone config does not exist"
	fi
fi

if [ $type == 'ftp' ] || [ $type = 'sftp' ]; then
	new_timestamp
	str="HOST='$host'\nUSERNAME='$remote_user'\nPASSWORD='$password'\nPRIVATEKEY='$privatekey'"
	str="$str\nBPATH='$path'\nPORT='$port'\nBACKUPS_KEEP='$keep'\nTIME='$time'\nDATE='$date'"
	echo -e "$str" > $HESTIA/conf/$type.backup.conf
	chmod 660 $HESTIA/conf/$type.backup.conf
elif [ $type == "rclone" ]; then
	new_timestamp
	str="HOST='$host'\nBPATH='$path'"
	str="$str\nBACKUPS_KEEP='$keep'\nTIME='$time'\nDATE='$date'"
	echo -e "$str" > $HESTIA/conf/$type.backup.conf
fi

# Through the token function: an unanchored sed on the key name rewrote DB_MARIADB_SYSTEM through DB_SYSTEM.
sys_key_token_set BACKUP_SYSTEM add "$type" > /dev/null || check_result "$E_UPDATE" "BACKUP_SYSTEM: could not record $type"

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add cron job
# options: USER MIN HOUR DAY MONTH WDAY CRON_COMMAND [JOB] [RESTART]
#
# example: h-add-cron-job admin * * * * * sudo /usr/local/hestia/bin/h-backup-users
#
# Adds a cron job for the user; with CRON_REPORTS on, its output is mailed to the contact address.

user=$1
min=$2
hour=$3
day=$4
month=$5
wday=$6
cron_command=$7
job=$8
restart=$9

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# After the includes: the encoder lives in main.sh, and called earlier it yields an empty command.
cron_command=$(record_value_encode "$cron_command")

HIDE=7

check_args '7' "$#" 'USER MIN HOUR DAY MONTH WDAY CRON_COMMAND [JOB] [RESTART]'
is_format_valid 'user' 'min' 'hour' 'day' 'month' 'wday' 'cron_command'
is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_package_full 'CRON_JOBS'
get_next_cronjob
is_format_valid 'job'
is_format_valid 'restart'
is_object_new 'cron' 'JOB' "$job"

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

str="JOB='$job' MIN='$min' HOUR='$hour' DAY='$day' MONTH='$month' WDAY='$wday'"
str="$str CMD='$cron_command' SUSPENDED='no' TIME='$time' DATE='$date'"

# Never store a line the readers cannot parse back, whatever slipped past the field checks.
record_line_valid "$str" || check_result "$E_INVALID" "refusing to store an unreadable cron record"

echo "$str" >> $CONF_DIR/users/$user/cron.conf

chmod 660 $CONF_DIR/users/$user/cron.conf

sort_cron_jobs

sync_cron_jobs

increase_user_value $user '$U_CRON_JOBS'

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Cron Jobs" "Cron job added (ID: $job, Command: $cron_command)"
log_event "$OK" "$ARGUMENTS"

exit

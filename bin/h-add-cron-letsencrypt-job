#!/bin/bash
# info: add cron job for Let's Encrypt certificates
# options: NONE
#
# Adds the queue line that runs scheduled Let's Encrypt orders to the hestia crontab.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'

cmd="bin/h-update-sys-queue letsencrypt"
check_cron=$(grep "$cmd" "/var/spool/cron/crontabs/hestia" 2> /dev/null)
if [ -z "$check_cron" ] && [ -n "$CRON_SYSTEM" ]; then
	sed -i -e "\$a*/5 * * * * sudo /usr/local/hestia/bin/h-update-sys-queue letsencrypt" "/var/spool/cron/crontabs/hestia"
fi

log_event "$OK" "$ARGUMENTS"

exit

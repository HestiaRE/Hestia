#!/bin/bash
# info: add new database server
# options: TYPE HOST DBUSER DBPASS [MAX_DB] [CHARSETS] [TEMPLATE] [PORT] [TLS]
#
# example: h-add-database-host mysql localhost alice p@$$wOrd
#
# Adds a local or remote database server holding at most MAX_DB databases; TEMPLATE is pgsql only (template1).
# A remote PostgreSQL host must offer TLS with a certificate this box trusts; TLS=no (pgsql only) allows plaintext on
# purpose. The MariaDB client enforces TLS itself from 11.4 on; the 10.11 client on Debian 12 and Ubuntu 24.04 does not.

type=$1
host=$2
dbuser=$3
password=$4
HIDE=4
max_db=${5:-500}
charsets=${6}
template=${7}
port=${8}
tls=${9:-yes}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

is_mysql_host_alive() {
	mycnf=$(mktemp)
	echo "[client]" > $mycnf
	echo "host='$host'" >> $mycnf
	echo "user='$dbuser'" >> $mycnf
	echo "password='$password'" >> $mycnf
	echo "port='$port'" >> $mycnf

	chmod 600 $mycnf
	mysql_out=$(mktemp)
	if [ -f '/usr/bin/mariadb' ]; then
		mariadb --defaults-file=$mycnf -e 'SELECT VERSION()' > $mysql_out 2>&1
	else
		mysql --defaults-file=$mycnf -e 'SELECT VERSION()' > $mysql_out 2>&1
	fi
	if [ "$?" -ne '0' ]; then
		# One error number covers an untrusted certificate and no TLS at all, and each needs a different fix.
		case "$(tr 'A-Z' 'a-z' < "$mysql_out")" in
			*'certificate'*)
				echo "Error: MySQL connection to $host failed: the server's TLS certificate is not trusted"
				echo "       Install a certificate from a CA this box trusts, or add that CA here."
				;;
			*ssl* | *tls*)
				echo "Error: MySQL connection to $host failed: the server does not offer TLS"
				echo "       A remote database host must speak TLS."
				;;
			*)
				echo "Error: MySQL connection to $host failed"
				;;
		esac
		sed 's/^/       /' "$mysql_out" | head -3
		rm -f "$mycnf" "$mysql_out"
		log_event "$E_CONNECT" "$ARGUMENTS"
		exit "$E_CONNECT"
	fi
	rm -f "$mysql_out"

	if [ -f '/usr/bin/mariadb' ]; then
		grants=$(mariadb --defaults-file=$mycnf -e 'SHOW GRANTS FOR CURRENT_USER();')
	else
		grants=$(mysql --defaults-file=$mycnf -e 'SHOW GRANTS FOR CURRENT_USER();')
	fi

	if [ "$?" -ne '0' ]; then
		echo "Error: MySQL connection to $host failed"
		rm $mycnf
		log_event "$E_CONNECT" "$ARGUMENTS"
		exit "$E_CONNECT"
	fi

	check_grants=$(echo $grants | grep "WITH GRANT OPTION")
	if [ -z "$check_grants" ]; then
		echo "Error: MySQL connection to $host failed. Unable to grant other users"
		rm $mycnf
		log_event "$E_CONNECT" "$ARGUMENTS"
		exit "$E_CONNECT"
	fi
	rm $mycnf
}

is_pgsql_host_alive() {
	local pg_out
	export PGPASSWORD="$dbpass"
	pg_out=$(mktemp)
	psql_env "$host" "$tls"
	# C locale: the cases below match libpq's words, which it translates.
	LC_ALL=C psql -h $host -U $dbuser -p $port -c "SELECT VERSION()" > "$pg_out" 2>&1
	if [ "$?" -ne '0' ]; then
		case "$(tr 'A-Z' 'a-z' < "$pg_out")" in
			*'certificate'*)
				echo "Error: PostgreSQL connection to $host failed: the server's TLS certificate is not trusted"
				echo "       Install a certificate from a CA this box trusts, or add that CA here."
				;;
			*ssl* | *tls*)
				echo "Error: PostgreSQL connection to $host failed: the server does not offer TLS"
				echo "       A remote database host must speak TLS."
				;;
			*)
				echo "Error: PostgreSQL connection to $host failed"
				;;
		esac
		sed 's/^/       /' "$pg_out" | head -3
		rm -f "$pg_out"
		log_event "$E_CONNECT" "$ARGUMENTS"
		exit "$E_CONNECT"
	fi
	rm -f "$pg_out"
}

args_usage='TYPE HOST DBUSER DBPASS [MAX_DB] [CHARSETS] [TEMPLATE] [PORT] [TLS]'
check_args '4' "$#" "$args_usage"

if [ -z $charsets ]; then charsets="UTF8,LATIN1,WIN1250,WIN1251,WIN1252,WIN1256,WIN1258,KOI8"; fi
if [ -z $template ]; then template="template1"; fi

database_set_default_ports

is_format_valid 'host' 'dbuser' 'max_db' 'charsets' 'template' 'port'
# Not is_type_valid/is_system_enabled: adding the first host of a type is what puts it into DB_SYSTEM.
case "$type" in
	mysql | pgsql) ;;
	*) check_result "$E_INVALID" "database type '$type' is not supported (mysql|pgsql)" ;;
esac
case "$type:$tls" in
	*:yes | pgsql:no) ;;
	mysql:no) check_result "$E_INVALID" "TLS=no exists only for pgsql, the MariaDB client enforces TLS itself" ;;
	*) check_result "$E_INVALID" "invalid TLS value '$tls' (yes|no)" ;;
esac
is_dbhost_new
is_password_valid
dbpass="$password"

case $type in
	mysql) is_mysql_host_alive ;;
	pgsql) is_pgsql_host_alive ;;
esac

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

case $type in
	mysql)
		str="HOST='$host' USER='$dbuser' PASSWORD='$dbpass'"
		str="$str CHARSETS='$charsets' MAX_DB='$max_db' U_SYS_USERS=''"
		str="$str U_DB_BASES='0' SUSPENDED='no' TIME='$time' DATE='$date' PORT='$port'"
		;;
	pgsql)
		str="HOST='$host' USER='$dbuser' PASSWORD='$dbpass'"
		str="$str CHARSETS='$charsets' TPL='$template' MAX_DB='$max_db'"
		str="$str U_SYS_USERS='' U_DB_BASES='0' SUSPENDED='no'"
		str="$str TIME='$time' DATE='$date' PORT='$port' TLS='$tls'"
		;;
esac

echo "$str" >> $HESTIA/conf/$type.conf
chmod 660 $HESTIA/conf/$type.conf

# Never a bare sed on DB_SYSTEM: its pattern also matches DB_MARIADB_SYSTEM.
sys_key_token_set DB_SYSTEM add "$type" > /dev/null || check_result "$E_UPDATE" "DB_SYSTEM: could not record $type"

$BIN/h-log-action "system" "Info" "Database" "Added external $type database server ($host) to the system."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: create one-time phpMyAdmin SSO handoff token
# options: USER DATABASE CLIENT_IP
# labels: internal
# caller: the panel phpMyAdmin single sign-on
#
# example: h-add-database-sso-token admin admin_wp 203.0.113.5
#
# Creates a database user valid for 60 minutes, leaves its login in a one-time handoff file in /run/hestia-sso
# that only the phpMyAdmin pool (caddy) can read, and prints the token. hestia-sso.php?token= consumes the file and
# opens the session, so the phpMyAdmin pool itself needs no sudo rule.

user=$1
database=$2
client_ip=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

SSO_DIR="/run/hestia-sso"
# Seconds a handoff token stays valid; keep in step with TOKEN_TTL in hestia-sso.php.
TOKEN_TTL=60

check_args '3' "$#" 'USER DATABASE CLIENT_IP'
is_format_valid 'user' 'database'
is_ip46_format_valid "$client_ip"

# Owner and suspension are checked there, and it schedules its own cleanup.
creds=$("$BIN/h-add-database-temp-user" "$user" "$database" mysql) || {
	echo "Error: Unable to create temp user"
	exit 2
}
dbuser=$(echo "$creds" | jq -r '.login.user')
dbpass=$(echo "$creds" | jq -r '.login.password')
if [ -z "$dbuser" ] || [ "$dbuser" = "null" ]; then
	echo "Error: Unable to parse temp user credentials"
	exit 2
fi

# 0730: the pool opens and unlinks by exact name but cannot list, so it cannot harvest tokens it was not handed.
mkdir -p "$SSO_DIR"
chown root:caddy "$SSO_DIR"
chmod 730 "$SSO_DIR"

# A click that never reached hestia-sso.php leaves its file behind.
find "$SSO_DIR" -type f -mmin +2 -delete 2> /dev/null

token=$(openssl rand -hex 32)
umask 037
# The password through the environment: argv is readable for every local user.
SSO_PASS="$dbpass" jq -n --arg u "$dbuser" --arg ip "$client_ip" \
	--argjson t "$(date +%s)" \
	'{user: $u, password: env.SSO_PASS, ip: $ip, time: $t}' > "$SSO_DIR/$token"
chown root:caddy "$SSO_DIR/$token"

echo "$token"

# No log here: h-add-database-temp-user logs the grant, and the token must not be logged.
exit

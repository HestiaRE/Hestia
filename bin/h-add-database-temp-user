#!/bin/bash
# info: add temp database user
# options: USER DATABASE [TYPE] [HOST] [TTL]
# labels: internal
# caller: h-add-database-sso-token
#
# example: h-add-database-temp-user admin admin_wp_db mysql
#
# Creates a MySQL user hestia_sso_XXXXXXXX with a random password and access to DATABASE only; an at job drops it
# after TTL minutes (default 60, 0 keeps it). Prints the login as JSON for h-add-database-sso-token.

user=$1
database="$2"
type=${3-mysql}
host=$4
ttl=$5

if [ "$ttl" == '' ]; then
	ttl=60
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DATABASE [TYPE] [HOST] [TTL]'
is_format_valid 'user' 'database' 'ttl'
is_type_valid "$DB_SYSTEM" "$type"
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"
is_object_unsuspended 'db' 'DB' "$database"

get_database_values
# The login only works on the server that holds the database.
[ -z "$host" ] || [ "$host" = 'default' ] || [ "$host" = "$HOST" ] \
	|| check_result "$E_INVALID" "database $database is on $HOST, not on $host"
host="$HOST"

dbpass=$(generate_password)
dbuser="hestia_sso_$(generate_password)"

add_mysql_database_temp_user
if [ $? -ne 0 ]; then
	echo "Error: Unable to create temp user"
	exit 2
fi

if [[ "$ttl" -gt 0 ]]; then
	echo "$BIN/h-delete-database-temp-user $user $database $dbuser mysql $host" | at "now +${ttl} minute" > /dev/null 2>&1
fi
# Escaped copies: $dbuser is still needed raw by the log line below.
json_dbuser="$dbuser"
json_dbpass="$dbpass"
json_escape json_dbuser json_dbpass
echo '{'
echo '    "login": {'
printf '        "user": "%s",\n' "$json_dbuser"
printf '        "password": "%s"\n' "$json_dbpass"
echo '    }'
echo '}'

$BIN/h-log-action "$user" "Info" "Databases" "Granted user $dbuser access to database $database."
log_event "$OK" "$ARGUMENTS"
exit

#!/bin/bash
# info: add web/mail domain
# options: USER DOMAIN [IP] [RESTART]
#
# example: h-add-domain admin example.com
#
# Adds the web and the mail domain on the sides the package offers; a side that fails later leaves the other in place.

user=$1
domain=$2
ip=$3
restart=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [IP] [RESTART]'
is_format_valid 'user' 'domain' 'restart'
if [ -n "$ip" ]; then
	is_format_valid 'ip'
fi
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# get_user_ip refuses a box without any address; an empty v4 slot is the v6-only box, the sub-commands resolve v6.
[ -z "$ip" ] && get_user_ip

# A side the package does not offer (limit 0) is left out; a full offered side refuses before anything is added.
web='' mail=''
[ -n "$WEB_SYSTEM" ] && [ "$(get_user_value '$WEB_DOMAINS')" != 0 ] && web=yes
[ -n "$MAIL_SYSTEM" ] && [ "$(get_user_value '$MAIL_DOMAINS')" != 0 ] && mail=yes
[ -n "$web$mail" ] || check_result "$E_LIMIT" "the package offers neither web nor mail domains"
[ -n "$web" ] && is_package_full 'WEB_DOMAINS'
[ -n "$mail" ] && is_package_full 'MAIL_DOMAINS'

if [ -n "$web" ]; then
	$BIN/h-add-web-domain "$user" "$domain" "$ip" 'no'
	check_result $? "can't add web domain"
fi

if [ -n "$mail" ]; then
	$BIN/h-add-mail-domain "$user" "$domain"
	check_result $? "can't add mail domain"
fi

$BIN/h-restart-web "$restart"
check_result $? "can't restart web" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "can't restart proxy" > /dev/null

exit

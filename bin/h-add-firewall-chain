#!/bin/bash
# info: add firewall chain
# options: CHAIN [PORT] [PROTOCOL]
# labels: internal
# caller: the fail2ban actions, h-add-firewall-ban and h-update-firewall
#
# example: h-add-firewall-chain CRM 5678 TCP
#
# Wires a fail2ban jail into the live ruleset and records it in chains.conf. Known chains bring their own ports.

chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')
port="$2"
port_ext="$2"
protocol="$3"
[ -z "$protocol" ] && protocol='TCP'
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
source_conf "$HESTIA/conf/hestia.conf"

# From BACKEND_PORT, not the nginx.conf Caddy replaced: scraping that guarded the default on a changed panel port.
hestiaport="${BACKEND_PORT:-8083}"

check_args '1' "$#" 'CHAIN [PORT] [PROTOCOL]'
is_format_valid 'chain' 'port_ext' 'protocol'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

case $chain in
	SSH)
		sshport="$($BIN/h-list-sys-sshd-port plain | sed ':a;N;$!ba;s/\n/,/g')"
		if [ -z "$sshport" ]; then
			sshport=22
		fi
		port=$sshport
		protocol=TCP
		;;
	FTP)
		port=21
		protocol=TCP
		;;
	MAIL)
		port='25,465,587,110,995,143,993'
		protocol=TCP
		;;
	WEB)
		port='80,443'
		protocol=TCP
		;;
	# Same ports as WEB, own chain: the scanner jails drop while the logins on these ports reject (fw_jail_verdict).
	WEBSCAN)
		port='80,443'
		protocol=TCP
		;;
	DB)
		port='3306,5432'
		protocol=TCP
		;;
	HESTIA)
		port=$hestiaport
		protocol=TCP
		;;
	RECIDIVE)
		port='1:65535'
		protocol=TCP
		;;
	*) check_args '2' "$#" 'CHAIN PORT' ;;
esac

wired=yes
fw_jail_wired "$chain" || wired=''
# Inserts the rules only while the input chain does not match the jail's set yet, so a re-run is a no-op.
fw_jail_attach "$chain" "$protocol" "$port"

# A jail stop destroys the set and keeps its rows; fail2ban restores only its own bans, a manual one would stay out.
banlist="$CONF_DIR/firewall/banlist.conf"
if [ -z "$wired" ] && [ -f "$banlist" ]; then
	grep -F "CHAIN='$chain' " "$banlist" | grep -o "^IP='[^']*'" | cut -d"'" -f2 | while read -r ban; do
		fw_ban_add "$chain" "$ban"
	done
fi

chains="$CONF_DIR/firewall/chains.conf"
check_chain=""
[ -f "$chains" ] && check_chain=$(grep "CHAIN='$chain'" "$chains")
if [ -z "$check_chain" ]; then
	echo "CHAIN='$chain' PORT='$port' PROTOCOL='$protocol'" >> "$chains"
fi

[ -f "$chains" ] && chmod 660 "$chains"

$BIN/h-log-action "system" "Info" "Firewall" "Added service to firewall (Service: $chain, Port: $port, Protocol: $protocol)."
log_event "$OK" "$ARGUMENTS"

exit

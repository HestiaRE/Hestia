#!/bin/bash
# info: add firewall chain
# options: CHAIN [PORT] [PROTOCOL]
# labels: internal
# caller: the fail2ban actions and h-update-firewall
#
# example: h-add-firewall-chain CRM 5678 TCP
#
# This function adds new rule to system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')
port="$2"
port_ext="$2"
protocol="$3"
[ -z "$protocol" ] && protocol='TCP'
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')

# Defining absolute path to iptables

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# From BACKEND_PORT. It was scraped out of the nginx.conf Caddy replaced, so the sed errored on every jail
# creation and fell back to the default - guarding the wrong port wherever the panel port had been changed.
hestiaport="${BACKEND_PORT:-8083}"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CHAIN [PORT] [PROTOCOL]'
is_format_valid 'chain' 'port_ext' 'protocol'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking known chains
case $chain in
	SSH) # Get ssh port (or ports) using h-list-sys-sshd-port.
		sshport="$($BIN/h-list-sys-sshd-port plain | sed ':a;N;$!ba;s/\n/,/g')"
		if [ -z "$sshport" ]; then
			sshport=22
		fi
		port=$sshport
		protocol=TCP
		;;
	FTP)
		port=21
		protocol=TCP
		;;
	MAIL)
		port='25,465,587,110,995,143,993'
		protocol=TCP
		;;
	WEB)
		port='80,443'
		protocol=TCP
		;;
	# Same ports as WEB, separate chain purely so the scanner-signature jails can drop while the
	# webmail/phpMyAdmin logins on the same ports keep rejecting (see fw_jail_verdict).
	WEBSCAN)
		port='80,443'
		protocol=TCP
		;;
	DB)
		port='3306,5432'
		protocol=TCP
		;;
	HESTIA)
		port=$hestiaport
		protocol=TCP
		;;
	RECIDIVE)
		port='1:65535'
		protocol=TCP
		;;
	*) check_args '2' "$#" 'CHAIN PORT' ;;
esac

# Only wires the jump when the chain did not exist yet, so a re-run is a no-op.
fw_jail_attach "$chain" "$protocol" "$port"

# Preserving chain
chains="$CONF_DIR/firewall/chains.conf"
check_chain=""
[ -f "$chains" ] && check_chain=$(grep "CHAIN='$chain'" "$chains")
if [ -z "$check_chain" ]; then
	echo "CHAIN='$chain' PORT='$port' PROTOCOL='$protocol'" >> "$chains"
fi

# Changing permissions
[ -f "$chains" ] && chmod 660 "$chains"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "Firewall" "Added service to firewall (Service: $chain, Port: $port, Protocol: $protocol)."
log_event "$OK" "$ARGUMENTS"

exit

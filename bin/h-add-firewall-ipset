#!/bin/bash
# info: add firewall ipset
# options: NAME [SOURCE] [IPVERSION] [AUTOUPDATE] [REFRESH]
#
# example: h-add-firewall-ipset country-nl "https://raw.githubusercontent.com/ipverse/rir-ip/master/country/nl/ipv4-aggregated.txt"
#
# This function adds new ipset to system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

ip_name=${1}
data_source=${2}
ip_version=${3:-v4}
autoupdate=${4:-yes}
refresh=${5:-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'NAME [SOURCE] [IPVERSION] [AUTOUPDATE] [REFRESH]'
is_format_valid 'ip_name'
# Set names start with a letter for nft; a name it cannot parse fails the whole ruleset document.
[[ "$ip_name" =~ ^[A-Za-z][A-Za-z0-9._-]{0,63}$ ]] || check_result "$E_INVALID" "invalid ipset name :: $ip_name"
is_boolean_format_valid "$autoupdate" 'Automatically update IP list (yes/no)'
is_boolean_format_valid "$refresh" 'Refresh IP list (yes/no)'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# No ipset binary probe or install: the renderer builds native nft sets, so the package is not on this path.
ipset_hstobject="$CONF_DIR/firewall/ipset"
IPSET_PATH="$CONF_DIR/firewall/ipset"

# Ensure ipset configuration path and master file exist before attempting to parse
mkdir -p "$IPSET_PATH"
if [ ! -f "$CONF_DIR/firewall/ipset.conf" ]; then
	touch $CONF_DIR/firewall/ipset.conf
fi

if [ -z "$data_source" ]; then
	if [ ! -f "${IPSET_PATH}.conf" ] || [[ ! $(grep "LISTNAME='$ip_name'" "${IPSET_PATH}.conf") ]]; then
		check_args '2' "$#" 'NAME SOURCE [IPVERSION] [AUTOUPDATE] [REFRESH]'
	fi

	data_source="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$SOURCE')"
	ip_version="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$IP_VERSION')"
else
	is_object_new "$ipset_hstobject" 'LISTNAME' "$ip_name"
fi

if [ "$ip_version" != "v4" ] && [ "$ip_version" != "v6" ]; then
	check_result "$E_INVALID" "invalid ip version, valid: (v4|v6)"
fi

if ! echo "$data_source" | grep -Eq '^(https?|script|file):'; then
	check_result "$E_INVALID" "invalid ipset source, valid: (http[s]://|script:|file:)"
fi
# Several sources make one combined set (#510): only https, and nothing that would break the record's quoting.
read -ra sources <<< "$data_source"
if [ "${#sources[@]}" -gt 1 ]; then
	for url in "${sources[@]}"; do
		[[ "$url" =~ ^https://[^\'\"]+$ ]] || check_result "$E_INVALID" "a combined ipset takes https:// sources only :: $url"
	done
fi

IPSET_FILE="${ip_name}.${ip_version}"
IPSET_MIN_SIZE=5

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

iplist_new=''

# Generate ip lists file if missing or required refresh
if [ ! -f "${IPSET_PATH}/${IPSET_FILE}.iplist" ] || [ "$refresh" = "yes" ]; then

	iplist_tempfile=$(mktemp)
	trap 'rm -f "$iplist_tempfile" "$iplist_tempfile.part" "$iplist_tempfile.ok"' EXIT

	if [[ "$data_source" =~ ^https?:// ]]; then

		# A source that fails is skipped and logged: lists do die, and a set that stays on its old state for good
		# is worse than one that loses a source. Only when every source fails does the set keep its last load.
		fetched=0
		for url in "${sources[@]}"; do
			if timeout 300 wget --tries=3 --timeout=15 --read-timeout=15 --waitretry=3 --no-dns-cache --quiet "$url" -O "$iplist_tempfile.part"; then
				cat "$iplist_tempfile.part" >> "$iplist_tempfile"
				echo >> "$iplist_tempfile"
				fetched=$((fetched + 1))
			else
				$BIN/h-log-action "system" "Warning" "Firewall" "IPset $ip_name: source skipped, download failed ($url)."
			fi
		done
		rm -f "$iplist_tempfile.part"
		[ "$fetched" -gt 0 ] || check_result "$E_CONNECT" "Downloading ip list: no source could be fetched"

		# Advanced: a script with the same basename gets to pre-process the downloaded list.
		if [ -x "${IPSET_PATH}/${IPSET_FILE}.sh" ]; then
			preprocess_output="$(cat "$iplist_tempfile" | setpriv --clear-groups --reuid nobody --regid nogroup -- "${IPSET_PATH}/${IPSET_FILE}.sh" "$ip_name" "$iplist_tempfile")"
			check_result $? "Preprocessing script failed (${IPSET_FILE}.sh)"
			[[ "$preprocess_output" ]] && echo "$preprocess_output" > "$iplist_tempfile"
		fi

	elif [[ "$data_source" =~ ^script:/ ]]; then

		# An external script generates the list, e.g. compiled from several sources on demand.
		if [ -x "${data_source#script:}" ]; then

			setpriv --clear-groups --reuid nobody --regid nogroup -- "${data_source#script:}" "$ip_name" > "$iplist_tempfile"
			check_result $? "Running custom ip list update script"

		fi

	elif [[ "$data_source" =~ ^file:/ ]]; then

		# An external file another app maintains, e.g. one that is continuously updated.
		[ -f "${data_source#file:}" ] && cp -f "${data_source#file:}" "$iplist_tempfile"

	fi

	# Every line is checked as an address, family and prefix: nft rejects the whole set over one bad element, and
	# a /0 to /7 in a third-party list would drop most of the internet.
	sed -r -i -e 's/\r$//' -e 's/[;#].*$//' -e 's/^[ \t]*//' -e 's/[ \t]*$//' -e '/^$/d' "$iplist_tempfile"
	iplist_raw_size="$(grep -c . "$iplist_tempfile")"
	"$HESTIA_PHP" -r '
		$fam = $argv[2] === "v6" ? FILTER_FLAG_IPV6 : FILTER_FLAG_IPV4;
		[$min, $max] = $argv[2] === "v6" ? [19, 128] : [8, 32];
		foreach (file($argv[1], FILE_IGNORE_NEW_LINES) as $l) {
			$p = explode("/", $l, 2);
			if (!filter_var($p[0], FILTER_VALIDATE_IP, $fam)) continue;
			if (isset($p[1]) && !(ctype_digit($p[1]) && $p[1] >= $min && $p[1] <= $max)) continue;
			echo $l, "\n";
		}' "$iplist_tempfile" "$ip_version" > "$iplist_tempfile.ok"
	mv -f "$iplist_tempfile.ok" "$iplist_tempfile"

	# Validate iplist file size
	iplist_size="$(grep -c . "$iplist_tempfile")"
	# The form only SYNCS the family for its presets; the handler must not trust it. A hand-picked
	# mismatch used to die below as "too small", hiding the actual fault behind a size complaint.
	if [[ "$iplist_size" -lt "$IPSET_MIN_SIZE" ]] && [[ "$iplist_raw_size" -ge "$IPSET_MIN_SIZE" ]]; then
		check_result "$E_INVALID" "source holds ${iplist_raw_size} entries but only ${iplist_size} are ${ip_version} - wrong IP version for this source?"
	fi
	[[ "$iplist_size" -lt "$IPSET_MIN_SIZE" ]] && check_result "$E_INVALID" "IP list ${IPSET_FILE} is too small (<${IPSET_MIN_SIZE}), ignoring"
	# A truncated download still exits 0. Only when every source answered: losing a dead source is meant to shrink.
	if [ -f "${IPSET_PATH}/${IPSET_FILE}.iplist" ] && [ "${fetched:-0}" -eq "${#sources[@]}" ]; then
		previous_size="$(grep -c . "${IPSET_PATH}/${IPSET_FILE}.iplist")"
		if [ "$((iplist_size * 2))" -lt "$previous_size" ]; then
			check_result "$E_INVALID" "IP list ${IPSET_FILE} shrank from ${previous_size} to ${iplist_size} entries, keeping the previous one"
		fi
	fi
	iplist_new="$iplist_tempfile"

fi

if [ -z "$iplist_new" ]; then
	iplist_new="${IPSET_PATH}/${IPSET_FILE}.iplist"
	[ -f "$iplist_new" ] || check_result "$E_NOTEXIST" "iplist file not found: $iplist_new"
	iplist_size="$(grep -c . "$iplist_new")"
	[[ "$iplist_size" -lt "$IPSET_MIN_SIZE" ]] && check_result "$E_INVALID" "IP list file $iplist_new is too small (<${IPSET_MIN_SIZE}), ignoring"
fi

# The kernel first, the cache second: a list nft refused must not become the cache the next render reads. An
# unreferenced list has no set in the table by design, the renderer declares one only where a rule matches it.
fw_family=4
[ "$ip_version" = 'v6' ] && fw_family=6
if fw_set_exists "$ip_name"; then
	fw_set_replace "$ip_name" "$iplist_new" "$fw_family" || check_result "$E_INVALID" "nft refused the new ${IPSET_FILE} list, the loaded set is unchanged"
fi
[ "$iplist_new" = "${IPSET_PATH}/${IPSET_FILE}.iplist" ] || mv -f "$iplist_new" "${IPSET_PATH}/${IPSET_FILE}.iplist"

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

if [ ! -f "${IPSET_PATH}.conf" ] || [ -z "$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$LISTNAME')" ]; then

	# Concatenating rule
	str="LISTNAME='$ip_name' IP_VERSION='$ip_version' SOURCE='$data_source'"
	str="$str AUTOUPDATE='$autoupdate' SUSPENDED='no'"
	str="$str TIME='$time' DATE='$date'"
	echo "$str" >> $CONF_DIR/firewall/ipset.conf
	log_type="added"

elif [ "$refresh" = "yes" ]; then

	# Update iplist last regen time
	update_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$TIME' "$time"
	update_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$DATE' "$date"
	log_type="refreshed"

fi

# Changing permissions
chmod 660 $CONF_DIR/firewall/ipset.conf
chmod 660 "${IPSET_PATH}/${IPSET_FILE}.iplist"

# A timer, not a line in the daily queue: the queue gave every list the same schedule and no way to see or
# change it, while a timer shows up in list-timers and its interval is a config key.
fw_blocklist_timer_install

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "Firewall" "IPset IP list ${log_type:-loaded} (Name: $ip_name, IP version: $ip_version, Autoupdate: $autoupdate)."
log_event "$OK" "$ARGUMENTS"

exit

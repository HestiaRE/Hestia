#!/bin/bash
# info: add firewall rule
# options: ACTION IP_CIDR PORT [PROTOCOL] [COMMENT] [RULE]
#
# example: h-add-firewall-rule DROP 185.137.111.77 25
#
# Adds a rule to the firewall; without RULE it takes the next free id.

action=$(echo "$1" | tr '[:lower:]' '[:upper:]')
ipv4_cidr=$2
port_ext=$3
protocol=${4:-TCP}
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')
comment=$5
rule=$6

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
source_conf "$HESTIA/conf/hestia.conf"

get_next_fw_rule() {
	if [ -z "$rule" ]; then
		curr_str=$(grep "RULE=" $CONF_DIR/firewall/rules.conf \
			| cut -f 2 -d \' | sort -n | tail -n1)
		rule="$((curr_str + 1))"
	fi
}

sort_fw_rules() {
	cat $CONF_DIR/firewall/rules.conf \
		| sort -n -k 2 -t \' > $CONF_DIR/firewall/rules.conf.tmp
	mv -f $CONF_DIR/firewall/rules.conf.tmp \
		$CONF_DIR/firewall/rules.conf
}

check_args '3' "$#" 'ACTION IP_CIDR PORT [PROTOCOL] [COMMENT] [RULE]'
[ -n "$port_ext" ] || check_result "$E_INVALID" "PORT is empty (0 means every port)"
is_format_valid 'action' 'protocol' 'port_ext'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
get_next_fw_rule
is_format_valid 'rule'
is_object_new "$CONF_DIR/firewall/rules" 'RULE' "$rule"
if [ -n "$comment" ]; then
	is_format_valid 'comment'
fi
if [[ "$ipv4_cidr" =~ ^ipset: ]]; then
	ipset_name="${ipv4_cidr#ipset:}"
	fw_ipset_known "$ipset_name" || check_result "$E_NOTEXIST" "ipset object not found"
else
	# Either family (a v6 source renders `ip6 saddr`); the variable keeps its legacy name.
	is_ip_cidr_format_valid "$ipv4_cidr"
fi

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

str="RULE='$rule' ACTION='$action' PROTOCOL='$protocol' PORT='$port_ext'"
str="$str IP='$ipv4_cidr' COMMENT='$comment' SUSPENDED='no'"
str="$str TIME='$time' DATE='$date'"

fw_conf_checkpoint "$CONF_DIR/firewall/rules.conf"
echo "$str" >> $CONF_DIR/firewall/rules.conf

chmod 660 $CONF_DIR/firewall/rules.conf

sort_fw_rules

fw_update_or_rollback || check_result "$E_INVALID" "the ruleset rejected the change, rule not added"

if [ -z "$port_ext" ]; then
	port_ext="0"
fi

$BIN/h-log-action "system" "Info" "Firewall" "Added firewall rule (Action: $action, Port: $port_ext, Protocol: $protocol)."
log_event "$OK" "$ARGUMENTS"

exit

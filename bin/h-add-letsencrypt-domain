#!/bin/bash
# info: check letsencrypt domain
# options: USER DOMAIN [ALIASES] [MAIL] [KEY_ALGO]
#
# example: h-add-letsencrypt-domain admin wonderland.com www.wonderland.com,demo.wonderland.com
# example: h-add-letsencrypt-domain admin wonderland.com '' yes
# example: h-add-letsencrypt-domain admin wonderland.com '' '' rsa
#
# Issues a Let's Encrypt certificate for a web domain, or with MAIL for its mail names. HTTP-01 where a name points
# here; DNS-01 through the DNS provider account of its zone for a wildcard alias and where HTTP-01 cannot reach the box.
# MAIL=host is h-add-letsencrypt-host on mail-only: the hostname, answered by the default server.
# KEY_ALGO is ecdsa-256, ecdsa-384 or rsa. Without it the domain keeps the one it has, rsa for a certificate issued
# before the record carried it, and a new one gets ecdsa-256.

user=$1
domain=$2
aliases=$3
# A blank list means none: the panel and HestiaCP-style callers pass ' ', and the validator splits on commas only.
[[ "$aliases" =~ ^[[:space:]]*$ ]] && aliases=''
mail=${4// /}
host=''
if [ "$mail" = 'host' ]; then
	host='yes'
	mail=''
fi
key_algo=${5,,}

deleted_redirect=0
deleted_force_ssl=0

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/dns.sh
source $HESTIA/include/dns.sh
# shellcheck source=/usr/local/hestia/include/dns-provider.sh
source $HESTIA/include/dns-provider.sh
source_conf "$HESTIA/conf/hestia.conf"

LE_API=$(le_api)

if [ -x "$CONF_DIR/hooks/le_pre.sh" ]; then
	$CONF_DIR/hooks/le_pre.sh "$user" "$domain" "$aliases" "$mail"
fi

encode_base64() {
	cat | base64 | tr '+/' '-_' | tr -d '\r\n='
}

query_le_v2() {
	protected='{"nonce": "'$3'",'
	protected=''$protected' "url": "'$1'",'
	protected=''$protected' "alg": "RS256", "kid": "'$KID'"}'
	content="Content-Type: application/jose+json"

	payload_=$(echo -n "$2" | encode_base64)
	protected_=$(echo -n "$protected" | encode_base64)
	signature_=$(printf "%s" "$protected_.$payload_" \
		| openssl dgst -sha256 -binary -sign $USER_DATA/ssl/user.key \
		| encode_base64)

	post_data='{"protected":"'"$protected_"'",'
	post_data=$post_data'"payload":"'"$payload_"'",'
	post_data=$post_data'"signature":"'"$signature_"'"}'

	# Response headers always go to stdout, the body to $4 when given. Without --retry-max-time curl sleeps out the
	# Retry-After of a rate limit, which is hours.
	local save_to_file=${4:-"/dev/stdout"}
	curl --location --user-agent "HestiaCP" --connect-timeout 15 --max-time 60 --retry 5 --retry-max-time 120 --retry-connrefused --silent --dump-header /dev/stdout --data "$post_data" "$1" --header "$content" --output "$save_to_file"
	debug_log "API call" "exit status: $?"
}

# A rate limit is the one failure no retry within the run cures, so it says how long to wait and which limit, and
# exits E_LIMIT, which the renewal does not count as a failed attempt. Retry-After may be a date; only seconds are used.
le_status_fail() {
	local msg="$1" code="${2:-$E_CONNECT}" after detail
	if [ "$status" = 429 ]; then
		after=$(grep -i -m1 '^retry-after:' <<< "$answer" | cut -d: -f2- | tr -d ' \r')
		[[ "$after" =~ ^[0-9]+$ ]] || after=''
		# The problem document is the JSON object; header blocks before it (a redirect, 100 Continue) do not matter.
		detail=$(sed -n '/^{/,$p' <<< "$answer" | jq -r '.detail // empty' 2> /dev/null)
		msg="Let's Encrypt rate limit ($domain)${after:+, retry in $((after / 3600))h $((after % 3600 / 60))m}${detail:+: $detail}"
		code=$E_LIMIT
	fi
	check_result "$code" "$msg"
}

# A failed renewal must not leave the domain without the redirect and force-ssl it had.
on_error_exit() {
	local exit_code=$?
	# The _acme-challenge records of this run go whatever its outcome.
	[ -z "$le_dns_used" ] || dnsp_acme_clear "$$" > /dev/null 2>&1
	if [[ $exit_code -eq 0 ]]; then
		exit "$exit_code"
	fi

	if [[ -z "$mail" ]]; then
		if [[ "$domain_forcessl" == 'yes' && "${deleted_force_ssl:-0}" -eq 1 ]]; then
			"$BIN/h-add-web-domain-ssl-force" "$user" "$domain"
		fi
		if [[ -n "$domain_redirect" && "${deleted_redirect:-0}" -eq 1 ]]; then
			"$BIN/h-add-web-domain-redirect" "$user" "$domain" "$domain_redirect" "$domain_redirect_code"
		fi
	fi
}

trap on_error_exit EXIT

check_args '2' "$#" 'USER DOMAIN [ALIASES] [MAIL] [KEY_ALGO]'
is_format_valid 'user' 'domain' 'aliases' 'key_algo'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
if [ -n "$mail" ]; then
	is_boolean_format_valid "$mail" 'mail'
fi

if [ -n "$host" ]; then
	if [ -n "$WEB_SYSTEM" ] || [ "$(webmail_front)" != 'nginx' ]; then
		check_result "$E_INVALID" "the host mode is for the mail-only model, elsewhere the hostname is a web domain"
	fi
	[ "$domain" = "$(hostname -f)" ] || check_result "$E_INVALID" "$domain is not the hostname of this server"
	[ -z "$aliases" ] || check_result "$E_INVALID" "the host mode takes no aliases"
elif [ -z "$mail" ] || [ "$mail" = 'no' ]; then
	mail=''
	is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
	is_object_valid 'web' 'DOMAIN' "$domain"
	is_object_unsuspended 'web' 'DOMAIN' "$domain"
	get_domain_values 'web'
	IFS=, read -ra _alias_list <<< "$aliases"
	for alias in "${_alias_list[@]}"; do
		[ -n "$alias" ] || continue
		if [[ "$alias" = *'*'* ]] && [[ "$alias" != '*.'* || "${alias:2}" = *'*'* ]]; then
			check_result "$E_INVALID" "a wildcard certificate name is *. before a domain: $alias"
		fi
		if [[ ",$ALIAS," != *",$alias,"* ]]; then
			check_result "$E_NOTEXIST" "domain alias $alias doesn't exist"
		fi
	done
else
	is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
	is_object_valid 'mail' 'DOMAIN' "$domain"
	is_object_unsuspended 'mail' 'DOMAIN' "$domain"
fi

debug_log() {
	echo -e "\n==[${1}]==\n${2}\n" >> "$log_file"
}

if [ -n "$mail" ]; then
	root_domain=$domain
	domain="mail.$root_domain"
	webmail=$(get_object_value "mail" "DOMAIN" "$root_domain" '$WEBMAIL')
	if [ -n "$webmail" ]; then
		aliases="$WEBMAIL_ALIAS.$root_domain"
	fi
elif [ -z "$host" ]; then
	parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

	domain_redirect="$REDIRECT"
	if [[ -n "$domain_redirect" ]]; then
		domain_redirect_code="$REDIRECT_CODE"
		$BIN/h-delete-web-domain-redirect $user $domain
		deleted_redirect=1
	fi

	domain_forcessl="$SSL_FORCE"
	if [[ "$domain_forcessl" == 'yes' ]]; then
		$BIN/h-delete-web-domain-ssl-force $user $domain
		deleted_force_ssl=1
	fi
fi

if [ -z "$key_algo" ] && [ -z "$host" ]; then
	if [ -n "$mail" ]; then
		key_algo=$(get_object_value 'mail' 'DOMAIN' "$root_domain" '$SSL_KEY_ALGO')
		had_le=$(get_object_value 'mail' 'DOMAIN' "$root_domain" '$LETSENCRYPT')
	else
		key_algo=$SSL_KEY_ALGO
		had_le=$LETSENCRYPT
	fi
	[ -n "$key_algo" ] || [ "$had_le" != 'yes' ] || key_algo=rsa
fi
key_algo=${key_algo:-ecdsa-256}
# A restored record brings its own value.
is_format_valid 'key_algo'

log_file="/var/log/hestia/LE-${user}-${domain}.log"
touch "$log_file"
chmod 600 "$log_file"

echo -e "\n\n=============================
Date Time: $(date +%Y-%m-%d) $(date +%H:%M:%S)
WEB_SYSTEM: ${WEB_SYSTEM}
PROXY_SYSTEM: ${PROXY_SYSTEM}
user: ${user}
domain: ${domain}
" >> "$log_file"

le_acc=$($BIN/h-add-letsencrypt-user $user)
le_acc_rc=$?
if [ "$le_acc_rc" -ne 0 ]; then
	send_notice "LETSENCRYPT" "Account registration failed ($user)"
	[ "$le_acc_rc" -eq "$E_LIMIT" ] || le_acc_rc=$E_CONNECT
	check_result "$le_acc_rc" "LE account registration ($user): ${le_acc#Error: }"
fi

le_conf_load "$USER_DATA/ssl/le.conf"

# The challenge per name, LE takes one for each: HTTP-01 where the name points here, DNS-01 through the provider
# account of its zone for a wildcard and wherever HTTP-01 cannot reach this box. An array, not a word list: a
# wildcard would glob against the current directory.
declare -A le_proto
le_dns_used=''
mapfile -t le_names < <(tr ',' '\n' <<< "$domain,$aliases" | sed '/^$/d' | sort -u)
for name in "${le_names[@]}"; do
	identifier=$name
	if [[ "$identifier" = *[![:ascii:]]* ]]; then
		identifier=$(idn2 --quiet "$identifier")
	fi
	if [[ "$identifier" = '*.'* ]]; then
		dnsp_acme_zone "${identifier#\*.}" \
			|| check_result "$E_INVALID" "$name needs DNS-01, and no DNS provider account holds its zone"
		le_proto[$identifier]=dns-01
		continue
	fi
	le_dns_check "$identifier"
	found=$?
	if [ "$found" = 0 ] && le_name_here "$identifier"; then
		le_proto[$identifier]=http-01
		continue
	fi
	if dnsp_acme_zone "$identifier"; then
		le_proto[$identifier]=dns-01
		continue
	fi
	le_proto[$identifier]=http-01
	case $found in
		0) ;;
		1)
			# DNS lives elsewhere: a webmail name not created yet must not cost the customer mail.<domain>.
			if [ -n "$mail" ] && [ "$name" = "$WEBMAIL_ALIAS.$root_domain" ]; then
				echo "Notice: no DNS record for $identifier, left out of the certificate"
				debug_log "DNS" "- $identifier has no record, left out"
				aliases=''
			else
				check_result "$E_NOTEXIST" "DNS record for $identifier doesn't exist"
			fi
			;;
		*) check_result "$E_CONNECT" "cannot verify DNS for $identifier - neither the local resolver nor any fallback answered" ;;
	esac
done
mapfile -t le_names < <(tr ',' '\n' <<< "$domain,$aliases" | sed '/^$/d' | sort -u)

echo -e "
- aliases: ${aliases}
- proto: $(for k in "${!le_proto[@]}"; do printf '%s=%s ' "$k" "${le_proto[$k]}"; done)
- key_algo: ${key_algo}
" >> "$log_file"

# Step 1: nonce
answer=$(curl --user-agent "HestiaCP" --connect-timeout 15 --max-time 60 -s -I "$LE_API/directory")
nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')

debug_log "Step 1" "- status: ${status}\n- nonce: ${nonce}\n- answer: ${answer}"

if [[ "$status" -ne 200 ]]; then
	le_status_fail "Let's Encrypt nonce request status $status ($domain)"
fi

# Step 2: new order
url="$LE_API/acme/new-order"
payload='{"identifiers":['
for identifier in "${le_names[@]}"; do
	if [[ "$identifier" = *[![:ascii:]]* ]]; then
		identifier=$(idn2 --quiet "$identifier")
	fi
	payload=$payload'{"type":"dns","value":"'$identifier'"},'
done
payload=$(echo "$payload" | sed "s/,$//")
payload=$payload']}'

answer=$(query_le_v2 "$url" "$payload" "$nonce")
nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
authz=$(echo "$answer" | grep "acme/authz" | cut -f2 -d '"')
finalize=$(echo "$answer" | grep 'finalize":' | cut -f4 -d '"')
status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f2 -d ' ')
order=$(echo -e "$answer" | grep -i location | cut -f2 -d \  | tr -d '\r\n')
debug_log "Step 2" "- status: ${status}\n- nonce: ${nonce}\n- authz: ${authz}\n- finalize: ${finalize}\n- payload: ${payload}\n- answer: ${answer}\n order: ${order}"

if [[ "$status" -ne 201 ]]; then
	le_status_fail "Let's Encrypt new auth status $status ($domain)"
fi

# Step 3: authorizations. Every challenge is published before the first is answered: a wildcard and its base name
# share one _acme-challenge name, and a resolver that LE asked for the first would hold that answer without the second.
le_urls=()
le_idents=()
for auth in $authz; do
	payload=''
	answer=$(query_le_v2 "$auth" "$payload" "$nonce")
	# The authorization names its identifier without the "*." and says wildcard instead.
	body=$(sed -n '/^{/,$p' <<< "$answer")
	ident=$(jq -r '.identifier.value // empty' <<< "$body" 2> /dev/null)
	[ "$(jq -r '.wildcard // false' <<< "$body" 2> /dev/null)" = 'true' ] && ident="*.$ident"
	proto=${le_proto[$ident]:-http-01}
	url=$(jq -r --arg p "$proto" 'first(.challenges[]? | select(.type == $p) | .url) // empty' <<< "$body" 2> /dev/null)
	token=$(jq -r --arg p "$proto" 'first(.challenges[]? | select(.type == $p) | .token) // empty' <<< "$body" 2> /dev/null)
	nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
	status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')

	debug_log "Step 3" "- status: ${status}\n- nonce: ${nonce}\n- identifier: ${ident}\n- proto: ${proto}\n- url: ${url}\n- token: ${token}\n- answer: ${answer}"

	if [[ "$status" -ne 200 ]]; then
		le_status_fail "Let's Encrypt acme/authz bad status $status ($domain)"
	fi

	# A name LE validated recently has no pending challenge and needs none.
	if [ "$(jq -r '.status' <<< "$body" 2> /dev/null)" = 'valid' ]; then
		debug_log "Step 3" "- authorization already valid, no challenge"
		continue
	fi

	# Step 4: challenge. The token names a file below: base64url only.
	if [[ ! "$token" =~ ^[A-Za-z0-9_-]+$ ]] || [ -z "$url" ]; then
		check_result "$E_INVALID" "Let's Encrypt sent no usable $proto challenge for ${ident:-a name} ($domain)"
	fi
	if [ "$proto" = 'dns-01' ]; then
		# Set before the first record, so the exit trap removes whatever this run got out.
		if [ -z "$le_dns_used" ]; then
			le_dns_used=1
			dnsp_acme_clear stale > /dev/null 2>&1
		fi
		acme_dns=${ident#\*.}
		acme_txt=$(printf '%s' "$token.$THUMB" | openssl dgst -sha256 -binary | encode_base64)
		dnsp_acme_set "$acme_dns" "$acme_txt" \
			|| check_result "$E_CONNECT" "the DNS provider did not take _acme-challenge.$acme_dns ($domain): $DNSP_ERROR"
		dnsp_acme_wait "$acme_dns" "$acme_txt" 300 \
			|| check_result "$E_CONNECT" "_acme-challenge.$acme_dns did not reach the name servers of its zone in 5 minutes ($domain)"
		debug_log "Step 4" "- _acme-challenge.$acme_dns set and answered by every name server of its zone"
	elif [ -n "$host" ]; then
		# Per token, so the cleanup below leaves the directory the default server points at.
		acme_name="host/$token"
		acme_token_write host "$token" "$token.$THUMB"
	elif [ -z "$mail" ]; then
		if [ "$WEB_SYSTEM" = 'nginx' ] || [ "$PROXY_SYSTEM" = 'nginx' ]; then
			conf="$HOMEDIR/$user/conf/web/$domain/nginx.conf_letsencrypt"
			sconf="$HOMEDIR/$user/conf/web/$domain/nginx.ssl.conf_letsencrypt"
			echo 'location ~ "^/\.well-known/acme-challenge/(.*)$" {' \
				> $conf
			echo '    default_type text/plain;' >> $conf
			printf '    return 200 "$1.%s";\n' "$THUMB" >> $conf
			echo '}' >> $conf
			if [ ! -e "$sconf" ]; then
				ln -s "$conf" "$sconf"
			fi
			if [ -n "$PROXY_SYSTEM" ]; then
				$BIN/h-restart-proxy
				check_result $? "Proxy restart failed" > /dev/null
			fi
		else
			acme_name="web/$domain"
			acme_apache_publish "$HOMEDIR/$user/conf/web/$domain" "$acme_name" "$token" "$token.$THUMB"
			$BIN/h-restart-web
			check_result $? "Web restart failed" > /dev/null
		fi
	else
		# The webmail vhost answers here; on mail-only that is nginx with no WEB_SYSTEM at all.
		if [ "$(webmail_front)" = 'nginx' ] || [ "$PROXY_SYSTEM" = 'nginx' ]; then
			conf="$HOMEDIR/$user/conf/mail/$root_domain/nginx.conf_letsencrypt"
			sconf="$HOMEDIR/$user/conf/mail/$root_domain/nginx.ssl.conf_letsencrypt"
			echo 'location ~ "^/\.well-known/acme-challenge/(.*)$" {' \
				> $conf
			echo '    default_type text/plain;' >> $conf
			printf '    return 200 "$1.%s";\n' "$THUMB" >> $conf
			echo '}' >> $conf
			if [ ! -e "$sconf" ]; then
				ln -s "$conf" "$sconf"
			fi
			if [ -n "$PROXY_SYSTEM" ]; then
				$BIN/h-restart-proxy
				check_result $? "Proxy restart failed" > /dev/null
			fi
		else
			if [ -d "$HOMEDIR/$user/conf/mail/$root_domain" ]; then
				acme_name="mail/$root_domain"
				acme_apache_publish "$HOMEDIR/$user/conf/mail/$root_domain" "$acme_name" "$token" "$token.$THUMB"
				$BIN/h-restart-web
				check_result $? "Web restart failed" > /dev/null
			fi
		fi
	fi
	if [ "$proto" != 'dns-01' ] && [ "$(webmail_front)" = 'nginx' ]; then
		$BIN/h-restart-web
		check_result $? "Web restart failed" > /dev/null
	fi

	le_urls+=("$url")
	le_idents+=("$ident")
done

for k in "${!le_urls[@]}"; do
	url=${le_urls[$k]}
	ident=${le_idents[$k]}
	# Step 5: validation. The {} asks LE to check, and every answer carries the challenge's state; it is read as
	# JSON, which tells pending from valid for either challenge type.
	i=0
	while :; do
		answer=$(query_le_v2 "$url" '{}' "$nonce")
		nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
		status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')
		body=$(sed -n '/^{/,$p' <<< "$answer")
		validation=$(jq -r '.status // empty' <<< "$body" 2> /dev/null)
		details=$(jq -r '.error.detail // empty' <<< "$body" 2> /dev/null)

		debug_log "Step 5" "- status: ${status}\n- url: ${url}\n- nonce: ${nonce}\n- validation: ${validation}\n- details: ${details}\n- answer: ${answer}"

		if [[ "$status" -ne 200 ]]; then
			[ "$status" != 429 ] || le_status_fail "Let's Encrypt validation status $status ($domain)"
			result=$(wget -qO- --timeout=15 --tries=2 "$url")
			debug_log "Debug information Step 5" "$result"
			details=$(echo $result | jq '.error.detail')
			error_code=$(echo $result | jq '.error.status')

			debug_log "Abort Step 5" "=> Wrong status"
			check_result "$E_CONNECT" "Let's Encrypt validation status $status ($domain). Details: $error_code:$details"
		fi
		[ "$validation" = 'pending' ] || [ "$validation" = 'processing' ] || break
		i=$((i + 1))
		if [ "$i" -gt 45 ]; then
			debug_log "Abort Step 5" "=> Too many validation retries"
			check_result "$E_CONNECT" "Let's Encrypt domain validation timeout ($domain)"
		fi
		sleep 2
	done
	if [ "$validation" != 'valid' ]; then
		check_result "$E_CONNECT" "Let's Encrypt domain verification failed (${ident:-$domain}${details:+: $details})"
	fi
done

ssl_dir=$($BIN/h-generate-ssl-cert "$domain" "info@$domain" "US" "California" \
	"San Francisco" "Hestia" "IT" "$aliases" shell "$key_algo" | tail -n1 | awk '{print $2}')

# Step 6: finalize with the CSR
csr=$(openssl req -in $ssl_dir/$domain.csr -outform DER | encode_base64)
payload='{"csr":"'$csr'"}'
answer=$(query_le_v2 "$finalize" "$payload" "$nonce")
nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')
certificate=$(echo "$answer" | grep 'certificate":' | cut -f4 -d '"')

debug_log "Step 6" "- status: ${status}\n- nonce: ${nonce}\n- payload: ${payload}\n- certificate: ${certificate}\n- answer: ${answer}"

if [[ "$status" -ne 200 ]]; then
	[ -d "$ssl_dir" ] && rm -rf "$ssl_dir"
	le_status_fail "Let's Encrypt finalize bad status $status ($domain)"
fi

if [ -z "$certificate" ]; then
	validation="processing"
	i=1
	while [ "$validation" = "processing" ]; do
		answer=$(query_le_v2 "$order" "" "$nonce")
		i=$((i + 1))

		nonce=$(echo "$answer" | grep -i nonce | cut -f2 -d \  | tr -d '\r\n')
		status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')
		validation=$(echo "$answer" | grep 'status":' | cut -f4 -d '"')
		certificate=$(echo "$answer" | grep 'certificate":' | cut -f4 -d '"')
		[ "$status" != 429 ] || le_status_fail "Let's Encrypt order status $status ($domain)"
		sleep $((i * 2)) # Sleep for 2s, 4s, 6s, 8s
		if [ $i -gt 10 ]; then
			check_result "$E_CONNECT" "Certificate processing timeout ($domain)"
		fi
		debug_log "Step 7" "- status: ${status}\n- nonce: ${nonce}\n- payload: ${payload}\n- certificate: ${certificate}\n- answer: ${answer}"
	done
fi

# Step 7: download
status=0
retry=0

while [[ $status != 200 && $retry -lt 3 ]]; do

	answer=$(query_le_v2 "$certificate" "" "$nonce" "$ssl_dir/$domain.pem")
	status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')

	debug_log "Step 8" "- status: ${status}\n- retry: ${retry}\n- answer: ${answer}"

	if [[ $status != 200 ]]; then
		retry=$((retry + 1))
		sleep $((retry * 2)) # Sleep for 2s, 4s, 6s, 8s
	fi

done

# Fallback: the deprecated unauthenticated GET.
if [[ $status != 200 ]]; then
	answer=$(curl --user-agent "HestiaCP" --connect-timeout 15 --max-time 60 --retry 5 --retry-max-time 120 --retry-connrefused --silent --dump-header /dev/stdout "$certificate" --output "$ssl_dir/$domain.pem")
	status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f 2 -d ' ')

	debug_log "Step 8 - Fallback" "- status: ${status}\n- answer: ${answer}"
fi

debug_log "CERT DIR" "$(ls -las "$ssl_dir/")"
debug_log "CERT PEM" "$(cat "$ssl_dir/$domain.pem")"

if [[ "$status" -ne 200 ]]; then
	[ -d "$ssl_dir" ] && rm -rf "$ssl_dir"
	le_status_fail "Let's Encrypt downloading signed cert failed status:$status ($domain)" "$E_NOTEXIST"
fi

crt_end=$(grep -n 'END CERTIFICATE' $ssl_dir/$domain.pem | head -n1 | cut -f1 -d:)
head -n $crt_end $ssl_dir/$domain.pem > $ssl_dir/$domain.crt

pem_lines=$(wc -l $ssl_dir/$domain.pem | cut -f 1 -d ' ')
ca_end=$(grep -n 'BEGIN CERTIFICATE' $ssl_dir/$domain.pem | tail -n1 | cut -f 1 -d :)
ca_end=$((pem_lines - crt_end + 1))
tail -n $ca_end $ssl_dir/$domain.pem > $ssl_dir/$domain.ca

debug_log "CERT CRT" "$(cat "$ssl_dir/$domain.crt")"
debug_log "CERT CA-1" "$(cat "$ssl_dir/$domain.ca")"
# Some chains arrive with a doubled END CERTIFICATE line.
if [[ $(head -n 1 $ssl_dir/$domain.ca) = "-----END CERTIFICATE-----" ]]; then
	sed -i '1,2d' $ssl_dir/$domain.ca
fi
debug_log "CERT CA-2" "$(cat "$ssl_dir/$domain.ca")"

if [ -n "$mail" ]; then
	mv $ssl_dir/$domain.ca $ssl_dir/$root_domain.ca
	mv $ssl_dir/$domain.crt $ssl_dir/$root_domain.crt
	mv $ssl_dir/$domain.csr $ssl_dir/$root_domain.csr
	mv $ssl_dir/$domain.key $ssl_dir/$root_domain.key
	mv $ssl_dir/$domain.pem $ssl_dir/$root_domain.pem
fi

if [ -n "$host" ]; then
	# No record: h-update-host-certificate hands these to the services.
	install -m 660 "$ssl_dir/$domain".{crt,key,ca,pem} "$USER_DATA/ssl/"
elif [ -z "$mail" ]; then
	ssl_enabled="$(get_object_value 'web' 'DOMAIN' "$domain" '$SSL')"
	if [ "$ssl_enabled" = "yes" ]; then
		$BIN/h-update-web-domain-ssl "$user" "$domain" "$ssl_dir" "updatessl"
	else
		$BIN/h-add-web-domain-ssl "$user" "$domain" "$ssl_dir" "" "updatessl"
	fi
else
	ssl_enabled="$(get_object_value 'mail' 'DOMAIN' "$root_domain" '$SSL')"
	if [ "$ssl_enabled" = "yes" ]; then
		$BIN/h-update-mail-domain-ssl "$user" "$root_domain" "$ssl_dir" "updatessl"
	else
		$BIN/h-add-mail-domain-ssl "$user" "$root_domain" "$ssl_dir" "updatessl"
	fi
fi
ssl_rc=$?

if [ "$ssl_rc" -ne 0 ]; then
	[ -d "$ssl_dir" ] && rm -rf "$ssl_dir"
	send_notice 'LETSENCRYPT' "$domain certificate installation failed ($domain)"
	check_result "$ssl_rc" "SSL install" > /dev/null
fi

# A missing crontab is syshealth's to restore with owner and mode.
_ct=/var/spool/cron/crontabs/hestia
if [ -f "$_ct" ] && ! grep -qF "$BIN/h-update-letsencrypt-ssl" "$_ct"; then
	sed -i "\#sudo $BIN/h-update-letsencrypt\$#d" "$_ct"
	min=$(generate_password '012345' '2')
	hour=$(generate_password '1234567' '1')
	echo "$min $hour * * * sudo $BIN/h-update-letsencrypt-ssl" >> "$_ct"
fi

if [ -z "$mail" ] && [ -z "$host" ]; then
	if [ -z "$LETSENCRYPT" ]; then
		add_object_key "web" 'DOMAIN' "$domain" 'LETSENCRYPT' 'FTP_USER'
		add_object_key "web" 'DOMAIN' "$domain" 'LETSENCRYPT_FAIL_COUNT' 'LETSENCRYPT'
	fi
	add_object_key "web" 'DOMAIN' "$domain" 'SSL_KEY_ALGO' 'LETSENCRYPT'
	update_object_value 'web' 'DOMAIN' "$domain" '$LETSENCRYPT' 'yes'
	update_object_value 'web' 'DOMAIN' "$domain" '$LETSENCRYPT_FAIL_COUNT' "0"
	update_object_value 'web' 'DOMAIN' "$domain" '$SSL_KEY_ALGO' "$key_algo"

	if [[ "$domain_forcessl" == 'yes' ]]; then
		$BIN/h-add-web-domain-ssl-force $user $domain
		deleted_force_ssl=0
	fi
	if [[ -n "$domain_redirect" ]]; then
		$BIN/h-add-web-domain-redirect $user $domain $domain_redirect $domain_redirect_code
		deleted_redirect=0
	fi

elif [ -n "$mail" ]; then
	if [ -z "$LETSENCRYPT" ]; then
		add_object_key "mail" 'DOMAIN' "$root_domain" 'LETSENCRYPT'
		add_object_key "mail" 'DOMAIN' "$root_domain" 'LETSENCRYPT_FAIL_COUNT' 'LETSENCRYPT'
	fi
	add_object_key "mail" 'DOMAIN' "$root_domain" 'SSL_KEY_ALGO' 'LETSENCRYPT'
	update_object_value 'mail' 'DOMAIN' "$root_domain" '$LETSENCRYPT' 'yes'
	update_object_value 'mail' 'DOMAIN' "$root_domain" '$LETSENCRYPT_FAIL_COUNT' "0"
	update_object_value 'mail' 'DOMAIN' "$root_domain" '$SSL_KEY_ALGO' "$key_algo"
fi

if [ -x "$CONF_DIR/hooks/le_post.sh" ]; then
	$CONF_DIR/hooks/le_post.sh "$user" "$domain" "$aliases" "$mail"
fi

# The answered tokens; the fragment stays and points at an empty name.
if [ -n "$acme_name" ]; then
	rm -rf "${ACME_APACHE_DIR:?}/$acme_name"
fi

[ -d "$ssl_dir" ] && rm -rf "$ssl_dir"

send_notice 'LETSENCRYPT' "$domain SSL has been installed successfully"

log_event "$OK" "$ARGUMENTS"

rm -f "$log_file"

exit

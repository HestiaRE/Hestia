#!/bin/bash
# info: add letsencrypt for host and backend
# options: NONE
#
# example: h-add-letsencrypt-host
#
# Gives the hostname a Let's Encrypt certificate, through a web domain of that name, unless the current
# one still verifies, and hands it to the panel. On mail-only without a web domain; renewed from there.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

domain=$(hostname -f)
if [ -z $domain ]; then
	domain=$HOSTNAME
fi
user="$($BIN/h-search-domain-owner "$domain" web)"
[[ -z "$user" ]] && user="$ROOT_USER"

USER_DATA=$CONF_DIR/users/$user

# No aliases argument: the domain is derived from the hostname.
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Mail-only: no web domain, and the nightly renewal calls this, so nothing is issued or handed over unless due.
if [ -z "$WEB_SYSTEM" ] && [ "$(webmail_front)" = 'nginx' ]; then
	cert_end() { # FILE: seconds of its notAfter, 0 when unreadable
		local _e
		_e=$(openssl x509 -noout -enddate -in "$1" 2> /dev/null | cut -d= -f2)
		[ -n "$_e" ] && date -d "$_e" +%s 2> /dev/null || echo 0
	}
	cert_verifies() { openssl verify -untrusted "$2" "$1" 2> /dev/null | grep -q ": OK$"; } # CRT CHAIN
	days=31
	[ "$LE_STAGING" = 'yes' ] && days=181

	# mail.<d> is mail domain d's name: its certificate is stored under that name and renewed with the domain.
	mail_owner=''
	if [[ "$domain" == mail.* ]]; then
		mail_owner=$($BIN/h-search-domain-owner "${domain#mail.}" mail)
	fi
	[ -n "$mail_owner" ] && user=$mail_owner
	crt="$CONF_DIR/users/$user/ssl/$domain"

	# Never twice a day, whatever verify says: a nightly misjudgement would spend the LE duplicate limit.
	fresh=no
	_start=$(openssl x509 -noout -startdate -in "$crt.crt" 2> /dev/null | cut -d= -f2)
	if [ -n "$_start" ] && [ "$(date -d "$_start" +%s)" -gt $(($(date +%s) - 86400)) ]; then
		fresh=yes
	fi
	if [ -z "$mail_owner" ] && [ "$fresh" = no ] && { ! cert_verifies "$crt.crt" "$crt.ca" \
		|| ! openssl x509 -checkend $((days * 86400)) -noout -in "$crt.crt" > /dev/null 2>&1; }; then
		$BIN/h-add-letsencrypt-domain "$user" "$domain" '' host
		check_result $? "Let's Encrypt SSL creation failed" "$E_UPDATE"
	fi

	if ! cert_verifies "$crt.crt" "$crt.ca" || ! openssl x509 -checkend 0 -noout -in "$crt.crt" > /dev/null 2>&1; then
		if [ -n "$mail_owner" ]; then
			echo "Notice: $domain gets its certificate with the Let's Encrypt of mail domain ${domain#mail.}"
			exit
		fi
		check_result "$E_NOTEXIST" "no valid certificate for $domain in $crt.*"
	fi
	# Handed over when the installed one does not verify or ends earlier: a valid one put there by hand stays.
	inst="$HESTIA_SSL/certificate.crt"
	if ! cert_verifies "$inst" "$inst" || [ "$(cert_end "$crt.crt")" -gt "$(cert_end "$inst")" ]; then
		$BIN/h-update-host-certificate "$user" "$domain"
	fi
	exit
fi

is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'

if [ "$($BIN/h-list-web-domain $user $domain plain | cut -f 1)" != "$domain" ]; then
	$BIN/h-add-web-domain "$user" "$domain"
fi

is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

add_ssl="yes"

if [ "$SSL" = "yes" ]; then
	if [ -e "$USER_DATA/ssl/$domain.ca" ]; then
		# The .ca file itself, not `openssl x509 -in` of it: that prints only the first certificate, so a
		# two-link chain fails and a valid cert is re-issued on every run, burning the LE rate limit.
		if openssl verify -CAfile "$USER_DATA/ssl/$domain.ca" "$USER_DATA/ssl/$domain.pem" | grep -q "$domain.pem: OK"; then
			add_ssl="no"
		fi
	else
		if openssl verify "$USER_DATA/ssl/$domain.pem" | grep -q "$domain.pem: OK"; then
			add_ssl="no"
		fi
	fi
fi

if [ "$add_ssl" = "yes" ]; then
	$BIN/h-add-letsencrypt-domain "$user" "$domain"
	check_result $? "Let's Encrypt SSL creation failed" "$E_UPDATE"
fi

$BIN/h-update-host-certificate "$user" "$domain"

$BIN/h-add-web-domain-ssl-force "$user" "$domain" > /dev/null 2>&1
$BIN/h-add-web-domain-ssl-hsts "$user" "$domain" > /dev/null 2>&1

exit

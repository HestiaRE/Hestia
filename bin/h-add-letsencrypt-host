#!/bin/bash
# info: add letsencrypt for host and backend
# options: NONE
#
# example: h-add-letsencrypt-host
#
# Gives the hostname a Let's Encrypt certificate, through a web domain of that name, unless the current
# one still verifies, and hands it to the panel.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

domain=$(hostname -f)
if [ -z $domain ]; then
	domain=$HOSTNAME
fi
user="$($BIN/h-search-domain-owner "$domain" web)"
[[ -z "$user" ]] && user="$ROOT_USER"

USER_DATA=$CONF_DIR/users/$user

# No aliases argument: the domain is derived from the hostname.
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'

if [ "$($BIN/h-list-web-domain $user $domain plain | cut -f 1)" != "$domain" ]; then
	$BIN/h-add-web-domain "$user" "$domain"
fi

is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

add_ssl="yes"

if [ "$SSL" = "yes" ]; then
	if [ -e "$USER_DATA/ssl/$domain.ca" ]; then
		# The .ca file itself, not `openssl x509 -in` of it: that prints only the first certificate, so a
		# two-link chain fails and a valid cert is re-issued on every run, burning the LE rate limit.
		if openssl verify -CAfile "$USER_DATA/ssl/$domain.ca" "$USER_DATA/ssl/$domain.pem" | grep -q "$domain.pem: OK"; then
			add_ssl="no"
		fi
	else
		if openssl verify "$USER_DATA/ssl/$domain.pem" | grep -q "$domain.pem: OK"; then
			add_ssl="no"
		fi
	fi
fi

if [ "$add_ssl" = "yes" ]; then
	$BIN/h-add-letsencrypt-domain "$user" "$domain"
	check_result $? "Let's Encrypt SSL creation failed" "$E_UPDATE"
fi

$BIN/h-update-host-certificate "$user" "$domain"

$BIN/h-add-web-domain-ssl-force "$user" "$domain" > /dev/null 2>&1
$BIN/h-add-web-domain-ssl-hsts "$user" "$domain" > /dev/null 2>&1

exit

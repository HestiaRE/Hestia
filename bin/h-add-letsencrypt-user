#!/bin/bash
# info: register letsencrypt user account
# options: USER
#
# example: h-add-letsencrypt-user bob
#
# Registers the user's Let's Encrypt account, or registers it again when the key no longer matches.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

LE_API='https://acme-v02.api.letsencrypt.org'

if [[ "$LE_STAGING" = 'yes' ]]; then
	LE_API='https://acme-staging-v02.api.letsencrypt.org'
fi

encode_base64() {
	cat | base64 | tr '+/' '-_' | tr -d '\r\n='
}

query_le_v2() {
	protected='{"nonce": "'$3'",'
	protected=''$protected' "url": "'$1'",'
	protected=''$protected' "alg": "RS256", "jwk": '$jwk'}'
	content="Content-Type: application/jose+json"

	payload_=$(echo -n "$2" | encode_base64)
	protected_=$(echo -n "$protected" | encode_base64)
	signature_=$(printf "%s" "$protected_.$payload_" \
		| openssl dgst -sha256 -binary -sign $USER_DATA/ssl/user.key \
		| encode_base64)

	post_data='{"protected":"'"$protected_"'",'
	post_data=$post_data'"payload":"'"$payload_"'",'
	post_data=$post_data'"signature":"'"$signature_"'"}'

	curl --user-agent "HestiaCP" --connect-timeout 15 --max-time 60 -s -i -d "$post_data" "$1" -H "$content"
}

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ -e "$USER_DATA/ssl/le.conf" ]; then
	le_conf_load "$USER_DATA/ssl/le.conf"
fi
# A restored or hand-replaced user.key no longer matches the registered modulus, and the early exit below
# would sign every issuance with a key the account does not know. Drop key and account so registration reruns.
if [ -e "$USER_DATA/ssl/user.key" ] && [ -n "$MODULUS" ]; then
	current_modulus=$(openssl rsa -in "$USER_DATA/ssl/user.key" -modulus -noout \
		| sed -e 's/^Modulus=//' | xxd -r -p | encode_base64)
	if [ "$current_modulus" != "$MODULUS" ]; then
		echo "Key mismatch detected, regenerating user key..."
		rm -f "$USER_DATA/ssl/user.key"
		unset KID MODULUS EXPONENT THUMB
	fi
fi
if [ -n "$KID" ]; then
	exit
fi

if [[ -z "$EMAIL" ]]; then
	EMAIL=$(get_user_value '$CONTACT')
fi

agreement=''

KEY="$USER_DATA/ssl/user.key"
if [ ! -e "$KEY" ]; then
	openssl genrsa -out "$KEY" 4096 > /dev/null 2>&1
	chmod 600 $KEY
fi

if [ -z "$EXPONENT" ]; then
	EXPONENT=$(openssl pkey -inform pem -in "$KEY" -noout -text_pub \
		| grep Exponent: | cut -f 2 -d '(' | cut -f 1 -d ')' | sed -e 's/x//' \
		| xxd -r -p | encode_base64)
fi

if [ -z "$MODULUS" ]; then
	MODULUS=$(openssl rsa -in "$KEY" -modulus -noout \
		| sed -e 's/^Modulus=//' | xxd -r -p | encode_base64)
fi

jwk='{"e":"'$EXPONENT'","kty":"RSA","n":"'"$MODULUS"'"}'

if [ -z "$THUMB" ]; then
	THUMB="$(echo -n "$jwk" | openssl dgst -sha256 -binary | encode_base64)"
fi

nonce=$(curl --connect-timeout 15 --max-time 60 -s -I "$LE_API/directory" | grep -i nonce | cut -f2 -d\  | tr -d '\r\n')

url="$LE_API/acme/new-acct"
payload='{"termsOfServiceAgreed": true}'
answer=$(query_le_v2 "$url" "$payload" "$nonce")
kid=$(echo "$answer" | grep -i location: | cut -f2 -d ' ' | tr -d '\r')

status=$(echo "$answer" | grep HTTP/ | tail -n1 | cut -f2 -d ' ')
if [[ "${status:0:2}" -ne "20" ]]; then
	check_result "$E_CONNECT" "Let's Encrypt acc registration failed $status"
fi

if [ ! -e "$USER_DATA/ssl/le.conf" ]; then
	echo "EXPONENT='$EXPONENT'" > $USER_DATA/ssl/le.conf
	echo "MODULUS='$MODULUS'" >> $USER_DATA/ssl/le.conf
	echo "THUMB='$THUMB'" >> $USER_DATA/ssl/le.conf
	echo "EMAIL='$EMAIL'" >> $USER_DATA/ssl/le.conf
	echo "KID='$kid'" >> $USER_DATA/ssl/le.conf
	chmod 660 $USER_DATA/ssl/le.conf
else
	# The key-derived values too: a stale MODULUS fires the mismatch check above on every later run.
	sed -i '/^\(EXPONENT\|MODULUS\|THUMB\|KID\)=/d' $USER_DATA/ssl/le.conf
	echo "EXPONENT='$EXPONENT'" >> $USER_DATA/ssl/le.conf
	echo "MODULUS='$MODULUS'" >> $USER_DATA/ssl/le.conf
	echo "THUMB='$THUMB'" >> $USER_DATA/ssl/le.conf
	echo "KID='$kid'" >> $USER_DATA/ssl/le.conf
fi

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add mail domain account
# options: USER DOMAIN ACCOUNT PASSWORD [QUOTA]
#
# example: h-add-mail-account user example.com john 'Secret-Pass-2026'
#
# Adds a mailbox, QUOTA in MB and unlimited when left out. PASSWORD may name a file under /tmp holding it.

user=$1
domain=$2
account=$3
password=$4
HIDE=4
quota=${5:-unlimited}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

if [[ "$account" =~ [[:upper:]] ]]; then
	account=$(echo "$account" | tr '[:upper:]' '[:lower:]')
fi

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT PASSWORD [QUOTA]'
is_format_valid 'user' 'domain' 'account'
if [ "$quota" != 'unlimited' ]; then
	is_format_valid 'quota'
	# Every later test would read 08 as a broken octal number.
	quota=$((10#$quota))
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_package_full 'MAIL_ACCOUNTS'
is_mail_new "$account"
is_password_valid
[ -n "$password" ] || check_result "$E_INVALID" "an empty password logs anyone in"

# The mailbox first: nothing is written for an account whose directory root may not create.
mail_account_maildir_ensure "$user" "$domain_idn" "$account" \
	|| check_result "$E_FORBIDEN" "$HOMEDIR/$user/mail/$domain_idn/$account is not a plain directory under ~/mail"

md5=$(mail_password_hash "$password") || check_result "$E_UPDATE" "no password hash for $account@$domain"
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	if [ "$quota" = 'unlimited' ]; then
		quota='0'
	fi
	mail_passwd_line "$user" "$account" "$md5" "$quota" >> $HOMEDIR/$user/conf/mail/$domain/passwd
	echo "$account:$account:$user:mail:$HOMEDIR/$user" >> $HOMEDIR/$user/conf/mail/$domain/accounts
fi

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

if [[ "$quota" -eq '0' ]]; then
	quota='unlimited'
fi

str="ACCOUNT='$account' ALIAS='' AUTOREPLY='no' FWD='' FWD_ONLY=''"
str="$str MD5='$md5' QUOTA='$quota' U_DISK='0' SUSPENDED='no'"
str="$str TIME='$time' DATE='$date'"
echo "$str" >> $USER_DATA/mail/$domain.conf
chmod 660 $USER_DATA/mail/$domain.conf

syshealth_repair_mail_account_config

touch $HOMEDIR/$user/conf/mail/$domain/limits

user_rate_limit=$(get_object_value 'mail' 'DOMAIN' "$domain" '$RATE_LIMIT')
if [ -n "$user_rate_limit" ]; then
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/limits "$account@$domain_idn:"
	echo "$account@$domain_idn:$user_rate_limit" >> $HOMEDIR/$user/conf/mail/$domain/limits
else
	system=$(cat /etc/exim4/limit.conf)
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/limits "$account@$domain_idn:"
	echo "$account@$domain_idn:$system" >> $HOMEDIR/$user/conf/mail/$domain/limits
fi

accounts=$(wc -l $USER_DATA/mail/$domain.conf | cut -f 1 -d ' ')
increase_user_value "$user" '$U_MAIL_ACCOUNTS'
update_object_value 'mail' 'DOMAIN' "$domain" '$ACCOUNTS' "$accounts"

$BIN/h-log-action "$user" "Info" "Mail" "Added new mail account ($account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

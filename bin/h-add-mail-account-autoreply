#!/bin/bash
# info: add mail account autoreply message
# options: USER DOMAIN ACCOUNT MESSAGE
#
# example: h-add-mail-account-autoreply admin example.com user 'Out of office until Monday.'
#
# Sets the account's autoreply text; with Sieve it goes into the vacation rule of the webmail's script.

user=$1
domain=$2
account=$3
autoreply=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT MESSAGE'
is_format_valid 'user' 'domain' 'account' 'autoreply'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"
# No check for an empty AUTOREPLY: the panel changes an existing text through this command.

msg=$(mktemp)
printf '%s\n' "$autoreply" > "$msg"

# With Sieve the vacation rule answers and exim stays silent, or the sender gets both.
if vacation_sieve_on; then
	vacation_enable "$user" "$domain" "$domain_idn" "$account" "$msg"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		rm -f "$msg"
		[ "$rc" -eq 3 ] && check_result "$E_FORBIDEN" "$account@$domain keeps its autoreply in a Sieve script the panel does not manage (own script or several vacation rules), change it in the webmail"
		check_result "$E_UPDATE" "the Sieve script of $account@$domain was not changed"
	fi
	rm -f "$(vacation_exim_file "$user" "$domain" "$account")"
elif [[ "$MAIL_SYSTEM" =~ exim ]]; then
	vacation_exim_write "$user" "$domain" "$account" "$msg"
fi

# Kept with Sieve too: the backup carries it to HestiaCP, and h-delete-sys-sieve falls back to exim.
mv -f "$msg" "$USER_DATA/mail/$account@$domain.msg"
chmod 660 "$USER_DATA/mail/$account@$domain.msg"
update_object_value "mail/$domain" 'ACCOUNT' "$account" '$AUTOREPLY' 'yes'

$BIN/h-log-action "$user" "Info" "Mail" "Added auto-reply message for mail account $account@$domain."
log_event "$OK" "$ARGUMENTS"

exit

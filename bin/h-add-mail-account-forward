#!/bin/bash
# info: add mail account forward address
# options: USER DOMAIN ACCOUNT FORWARD
#
# example: h-add-mail-account-forward admin acme.com alice bob@example.org
#
# Adds a forward address; :blackhole: discards the account's mail instead.

user=$1
domain=$2
account=$3
email_forward=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT FORWARD'
is_format_valid 'user' 'domain' 'account'
if [ "$email_forward" != ':blackhole:' ]; then
	is_format_valid 'email_forward'
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"
fwd=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD')
IFS=, read -ra fwd_list <<< "$fwd"
for f in "${fwd_list[@]}"; do
	[ "$f" != "$email_forward" ] || check_result "$E_EXISTS" "forward $email_forward exists"
done

if [ -z "$fwd" ]; then
	fwd="$email_forward"
else
	fwd="$fwd,$email_forward"
fi

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/aliases "$account@$domain_idn:"
	echo "$account@$domain_idn:$fwd" >> $HOMEDIR/$user/conf/mail/$domain/aliases
	# exim's alias router reads nothing out of :blackhole:, the discard is forward-only's devnull.
	if [ "$email_forward" = ':blackhole:' ]; then
		remove_exact_line $HOMEDIR/$user/conf/mail/$domain/fwd_only "$account"
		echo "$account" >> $HOMEDIR/$user/conf/mail/$domain/fwd_only
	fi
fi

update_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD' "$fwd"
if [ "$email_forward" = ':blackhole:' ]; then
	add_object_key "mail/$domain" 'ACCOUNT' "$account" 'FWD_ONLY' 'MD5'
	update_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD_ONLY' 'yes'
fi

$BIN/h-log-action "$user" "Warning" "Mail" "Mail forwarding on mail account $account@$domain enabled (send to: $email_forward)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add mail account forward address
# options: USER DOMAIN ACCOUNT FORWARD
#
# example: h-add-mail-account-forward admin acme.com alice bob@example.org
#
# Adds a forward address, a redirect in the mailbox's Sieve script; :blackhole: discards the account's mail instead.

user=$1
domain=$2
account=$3
email_forward=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/forward.sh
source $HESTIA/include/forward.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT FORWARD'
is_format_valid 'user' 'domain' 'account'
if [ "$email_forward" != ':blackhole:' ]; then
	is_format_valid 'email_forward'
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"
# The mail rebuild holds it while it refills aliases, where forward_sync would read an exim forward as taken out.
web_lock_acquire || exit 1
# The webmail may have changed the forward since; this command changes what the script holds.
forward_sync "$user" "$domain" "$domain_idn" "$account"
forward_result $? "$account@$domain" "the Sieve script of $account@$domain could not be read"
fwd=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD')
only=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD_ONLY')
IFS=, read -ra fwd_list <<< "$fwd"
for f in "${fwd_list[@]}"; do
	[ "${f,,}" != "${email_forward,,}" ] || check_result "$E_EXISTS" "forward $email_forward exists"
done

fwd="${fwd:+$fwd,}$email_forward"
n=0
for f in "${fwd_list[@]}" "$email_forward"; do
	[ "$f" = ':blackhole:' ] || n=$((n + 1))
done
[ "$n" -le "$FORWARD_MAX" ] || check_result "$E_LIMIT" "$account@$domain forwards to $FORWARD_MAX addresses at most"
# exim's alias router reads nothing out of :blackhole:, the discard is forward-only's devnull.
[ "$email_forward" != ':blackhole:' ] || only='yes'

forward_apply "$user" "$domain" "$domain_idn" "$account" "$fwd" "$only"
forward_result $? "$account@$domain" "the forward of $account@$domain was not changed"
forward_record "$domain" "$account" "$fwd" "$only"

$BIN/h-log-action "$user" "Warning" "Mail" "Mail forwarding on mail account $account@$domain enabled (send to: $email_forward)."
log_event "$OK" "$ARGUMENTS"

exit

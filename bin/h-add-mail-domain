#!/bin/bash
# info: add mail domain
# options: USER DOMAIN [ANTISPAM] [ANTIVIRUS] [DKIM] [DKIM_SIZE] [RESTART] [REJECT_SPAM]
#
# example: h-add-mail-domain admin mydomain.tld
#
# Adds a mail domain with its config dir and maildir, and unless DKIM is no a DKIM key of DKIM_SIZE bits
# (1024, 2048, 4096).

user=$1
domain=$2
antispam=${3-yes}
antivirus=${4-yes}
dkim=${5-yes}
dkim_size=${6-2048}
restart="$7"
reject=${8-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

format_domain
format_domain_idn
domain_utf=$(idn2 --quiet -d "$domain_idn")

check_args '2' "$#" 'USER DOMAIN [ANTISPAM] [ANTIVIRUS] [DKIM] [DKIM_SIZE] [RESTART] [REJECT_SPAM]'
is_format_valid 'user' 'domain' 'antispam' 'antivirus' 'dkim' 'dkim_size' 'restart' 'reject'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Both spellings: a domain may be on record in its UTF-8 or its punycode form.
is_domain_new 'mail' "$domain_utf"
is_domain_new 'mail' "$domain_idn"
# looks_like_ip46, not is_ip46_format_valid: the validator logs its refusal, and here refusal is the normal case.
if looks_like_ip46 "$domain"; then
	echo "Error: Invalid domain format. IP address detected as input."
	exit 1
fi

is_package_full 'MAIL_DOMAINS'
mail_dir_trusted "$user" && [ ! -L "$HOMEDIR/$user/mail/$domain_idn" ] \
	|| check_result "$E_FORBIDEN" "$HOMEDIR/$user/mail is not root's own directory, or $domain_idn in it is a link"

is_base_domain_owner "$domain"

source_conf "$USER_DATA/user.conf"
domain_ip=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP')
if [ ! -z "$domain_ip" ]; then
	local_ip=$(get_real_ip "$domain_ip")
	is_ip_valid "$local_ip" "$user"
else
	get_user_ip
fi

new_timestamp

if [ -z "$ANTISPAM_SYSTEM" ]; then
	antispam="no"
	reject="no"
fi
if [ -z "$ANTIVIRUS_SYSTEM" ]; then
	antivirus="no"
fi

if [ "$dkim" = 'yes' ]; then
	mail_dkim_keys_write "$domain" "$dkim_size" || check_result "$E_DISK" "DKIM key generation failed for $domain"
fi

s="DOMAIN='$domain' ANTIVIRUS='$antivirus' ANTISPAM='$antispam' REJECT='$reject' DKIM='$dkim' WEBMAIL=''"
s="$s SSL='no' LETSENCRYPT='no' CATCHALL='' ACCOUNTS='0' RATE_LIMIT='$RATE_LIMIT' U_DISK='0' SUSPENDED='no' TIME='$time'"
s="$s DATE='$date'"
echo $s >> $USER_DATA/mail.conf
touch $USER_DATA/mail/$domain.conf

syshealth_repair_mail_config

chmod 660 $USER_DATA/mail/$domain.*
chmod 660 $USER_DATA/mail.conf

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	mkdir $HOMEDIR/$user/conf/mail/$domain
	mkdir $HOMEDIR/$user/mail/$domain_idn
	touch $HOMEDIR/$user/conf/mail/$domain/aliases
	touch $HOMEDIR/$user/conf/mail/$domain/passwd
	touch $HOMEDIR/$user/conf/mail/$domain/fwd_only
	touch $HOMEDIR/$user/conf/mail/$domain/accounts
	touch $HOMEDIR/$user/conf/mail/$domain/limits
	ln -s $HOMEDIR/$user/conf/mail/$domain \
		/etc/$MAIL_SYSTEM/domains/$domain_idn

	if [ -n "$local_ip" ]; then
		echo "$local_ip" > $HOMEDIR/$user/conf/mail/$domain/ip
	fi
	# The v6 pin without a relay check: no relay can exist yet at add time, and adding one removes both pins.
	local_ip6=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP6' 2> /dev/null)
	if [ -z "$local_ip6" ] && get_user_ip6; then
		local_ip6="$ip6"
	fi
	if [ -n "$local_ip6" ] && [ -e "$CONF_DIR/ips/$local_ip6" ]; then
		echo "$local_ip6" > $HOMEDIR/$user/conf/mail/$domain/ipv6
	fi

	if [ -n "$ANTISPAM_SYSTEM" ]; then
		if [ "$antispam" = 'yes' ]; then
			touch "$HOMEDIR/$user/conf/mail/$domain/antispam"
		fi
		if [ "$reject" = 'yes' ]; then
			touch "$HOMEDIR/$user/conf/mail/$domain/reject_spam"
		fi
	fi

	if [ -n "$ANTIVIRUS_SYSTEM" ]; then
		if [ "$antivirus" = 'yes' ]; then
			touch "$HOMEDIR/$user/conf/mail/$domain/antivirus"
		fi
	fi

	if [ "$dkim" = 'yes' ]; then
		cp -f $USER_DATA/mail/$domain.pem \
			$HOMEDIR/$user/conf/mail/$domain/dkim.pem
	fi

	chmod 771 $HOMEDIR/$user/conf/mail/$domain
	chmod 660 $HOMEDIR/$user/conf/mail/$domain/*
	chmod 770 $HOMEDIR/$user/mail/$domain_idn

	chown -R $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain
	if [ "$IMAP_SYSTEM" = 'dovecot' ]; then
		chown -R dovecot:mail $HOMEDIR/$user/conf/mail/$domain/passwd
	fi
	chown $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/accounts
	chown $user:mail $HOMEDIR/$user/mail/$domain_idn
fi

# Keyed on the front, not WEB_SYSTEM: a mailfront box has no WEB_SYSTEM but nginx as WEBMAIL_FRONT.
if [ -n "$(webmail_front)" ] || [ -n "$PROXY_SYSTEM" ]; then
	if [ -n "$IMAP_SYSTEM" ]; then
		$BIN/h-add-mail-domain-webmail "$user" "$domain" '' 'no'
	fi
fi

if [ -x "$CONF_DIR/hooks/add-mail-domain.sh" ]; then
	$CONF_DIR/hooks/add-mail-domain.sh "$user" "$domain"
fi

increase_user_value "$user" '$U_MAIL_DOMAINS'

if [ "$dkim" = 'yes' ]; then
	increase_user_value "$user" '$U_MAIL_DKIM'
fi

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Mail" "Added new mail domain ($domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add mail domain dkim support
# options: USER DOMAIN [DKIM_SIZE] [DKIM_SELECTOR]
#
# example: h-add-mail-domain-dkim admin acme.com
#
# Signs the domain's outgoing mail with a new DKIM key of DKIM_SIZE bits (1024, 2048, 4096; default 2048),
# published under DKIM_SELECTOR (default mail).

user=$1
domain=$2
dkim_size=${3-2048}
dkim_selector=${4:-mail}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [DKIM_SIZE] [DKIM_SELECTOR]'
is_format_valid 'user' 'domain' 'dkim_size' 'dkim_selector'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_empty 'mail' 'DOMAIN' "$domain" '$DKIM'

mail_dkim_keys_write "$domain" "$dkim_size" || check_result "$E_DISK" "DKIM key generation failed for $domain"
chmod 660 $USER_DATA/mail/$domain.*

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	cp $USER_DATA/mail/$domain.pem $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	chown -h $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	chmod 660 $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	# The record follows the file: a selector exim cannot read signs as mail, and the record must say so.
	if ! mail_dkim_selector_write "$user" "$domain" "$dkim_selector"; then
		echo "Warning: cannot write the DKIM selector of $domain, it signs as mail" >&2
		dkim_selector=''
	fi
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$DKIM' 'yes'
add_object_key 'mail' 'DOMAIN' "$domain" 'DKIM_SELECTOR' 'DKIM'
update_object_value 'mail' 'DOMAIN' "$domain" '$DKIM_SELECTOR' "$dkim_selector"
increase_user_value "$user" '$U_MAIL_DKIM'

$BIN/h-log-action "$user" "Info" "Mail" "DKIM message signing enabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add mail domain dkim support
# options: USER DOMAIN [DKIM_SIZE]
#
# example: h-add-mail-domain-dkim admin acme.com
#
# This function adds DKIM signature to outgoing domain emails.

user=$1
domain=$2
dkim_size=${3-2048}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [DKIM_SIZE]'
is_format_valid 'user' 'domain' 'dkim_size'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_empty 'mail' 'DOMAIN' "$domain" '$DKIM'

mail_dkim_keys_write "$domain" "$dkim_size" || check_result "$E_DISK" "DKIM key generation failed for $domain"
chmod 660 $USER_DATA/mail/$domain.*

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	cp $USER_DATA/mail/$domain.pem $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	chown -h $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/dkim.pem
	chmod 660 $HOMEDIR/$user/conf/mail/$domain/dkim.pem
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$DKIM' 'yes'
increase_user_value "$user" '$U_MAIL_DKIM'

$BIN/h-log-action "$user" "Info" "Mail" "DKIM message signing enabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

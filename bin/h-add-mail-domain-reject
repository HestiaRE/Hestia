#!/bin/bash
# info: add mail domain reject spam support
# options: USER DOMAIN
# labels: mail
#
# example: h-add-mail-domain-reject admin mydomain.tld
#
# Refuses incoming mail at SMTP whose spam score is above the reject threshold, while the spam scan is on.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_empty 'mail' 'DOMAIN' "$domain" '$REJECT'

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	touch $HOMEDIR/$user/conf/mail/$domain/reject_spam
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$REJECT' 'yes'

$BIN/h-log-action "$user" "Info" "Mail" "Spam rejection enabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

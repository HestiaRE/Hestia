#!/bin/bash
# info: add mail domain smtp relay support
# options: USER DOMAIN HOST [USERNAME] [PASSWORD] [PORT]
#
# example: h-add-mail-domain-smtp-relay user domain.tld srv.smtprelay.tld uname123 pass12345
#
# Sends the domain's outgoing mail through HOST. PASSWORD may name a file under /tmp holding it; an empty one next
# to the stored USERNAME keeps the stored password.

user=$1
domain=$2
host=$3
username=$4
password=$5
# Read while main.sh is sourced, so it has to stand before the includes.
HIDE=5
port=${6-587}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER DOMAIN HOST [USERNAME] [PASSWORD] [PORT]'
is_format_valid 'port' 'user' 'domain' 'host'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_password_valid
# The panel never shows the stored password, so an empty one next to the same username keeps it.
if [ -z "$password" ] && [ -n "$username" ] \
	&& [ "$(record_value_decode "$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_USERNAME')")" = "$username" ]; then
	password=$(record_value_decode "$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_PASSWORD')")
fi
is_username_format_valid "$username" "Username"
format_no_quotes "$password" "Password"

relay_conf="$HOMEDIR/$user/conf/mail/$domain/smtp_relay.conf"
smtp_relay_write "$relay_conf" 'Debian-exim:mail' 660 "$host" "$port" "$username" "$password" \
	|| check_result "$E_DISK" "cannot write $relay_conf"
rm -f $HOMEDIR/$user/conf/mail/$domain/ip
rm -f $HOMEDIR/$user/conf/mail/$domain/ipv6

if [ -z "$U_SMTP_RELAY" ]; then
	add_object_key 'mail' 'DOMAIN' "$domain" 'U_SMTP_RELAY' 'ACCOUNTS'
	add_object_key 'mail' 'DOMAIN' "$domain" 'U_SMTP_RELAY_HOST' 'ACCOUNTS'
	add_object_key 'mail' 'DOMAIN' "$domain" 'U_SMTP_RELAY_PORT' 'ACCOUNTS'
	add_object_key 'mail' 'DOMAIN' "$domain" 'U_SMTP_RELAY_USERNAME' 'ACCOUNTS'
	add_object_key 'mail' 'DOMAIN' "$domain" 'U_SMTP_RELAY_PASSWORD' 'ACCOUNTS'
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY' 'true'
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_HOST' "$host"
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_PORT' "$port"
# Encoded: a \ or ` is fine for exim but not for the record grammar, and h-restore-user refuses such a record.
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_USERNAME' "$(record_value_encode "$username")"
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_PASSWORD' "$(record_value_encode "$password")"

$BIN/h-log-action "$user" "Info" "Mail" "SMTP Relay enabled (Domain: $domain, Host: $host, Port: $port)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add sender to per-domain spam blacklist
# options: USER DOMAIN SENDER
#
# example: h-add-mail-domain-spam-blacklist user domain.tld partner@example.com
# example: h-add-mail-domain-spam-blacklist user domain.tld '*.example.com'
#
# Adds a sender pattern to the domain's spam blacklist: matching mail is always
# treated as spam (marked, .Spam foldered, refused at SMTP while "Reject Spam" is
# on). Whitelist wins over blacklist. Patterns match the lowercased envelope
# sender + its domain (wildlsearch); only applied while Spam Filter is enabled.
# Source of truth: U_SPAM_BLACKLIST in mail.conf, mirrored one-per-line to the
# spam_blacklist file exim reads per message (no reload needed).

user=$1
domain=$2
sender=$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

check_args '3' "$#" 'USER DOMAIN SENDER'
is_format_valid 'user' 'domain'
spam_sender_pattern_ok "$sender" || check_result "$E_INVALID" "invalid sender pattern :: $sender"
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_system_enabled "$ANTISPAM_SYSTEM" 'ANTISPAM_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

list_file="$HOMEDIR/$user/conf/mail/$domain/spam_blacklist"
current=$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_BLACKLIST')

if [[ ",$current," = *",$sender,"* ]]; then
	exit
fi

if [ -z "$current" ]; then
	new_list="$sender"
else
	new_list="$current,$sender"
fi

spam_list_write "$list_file" "$new_list"

add_object_key 'mail' 'DOMAIN' "$domain" 'U_SPAM_BLACKLIST' 'ACCOUNTS'
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_BLACKLIST' "$new_list"

$BIN/h-log-action "$user" "Info" "Mail" "Spam blacklist entry added (Domain: $domain, Sender: $sender)."
log_event "$OK" "$ARGUMENTS"

exit

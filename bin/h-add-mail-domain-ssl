#!/bin/bash
# info: add mail domain ssl support
# options: USER DOMAIN SSL_DIR [RESTART]
#
# example: h-add-mail-domain-ssl admin example.com /home/admin/tmp/ssl
#
# Turns on SSL for the domain's IMAP, POP3 and SMTP. SSL_DIR holds DOMAIN.crt and DOMAIN.key, DOMAIN.ca optionally.

user=$1
domain=$2
ssl_dir=$3
restart="$4"

if [[ "$domain" =~ [[:upper:]] ]]; then
	domain=$(echo "$domain" | tr '[:upper:]' '[:lower:]')
fi
if [[ "$domain" =~ ^www\..* ]]; then
	domain=$(echo "$domain" | sed -e "s/^www.//")
fi
if [[ "$domain" =~ .*\.$ ]]; then
	domain=$(echo "$domain" | sed -e "s/\.$//")
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN SSL_DIR [RESTART]'
is_format_valid 'user' 'domain' 'ssl_dir' 'restart'
format_no_quotes "$ssl_dir"
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_empty 'mail' 'DOMAIN' "$domain" '$SSL'
if [ -n "$restart" ]; then
	is_restart_format_valid "$restart" 'restart'
fi

is_web_domain_cert_valid

domain_ip=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP')
if [ -n "$domain_ip" ]; then
	local_ip=$(get_real_ip "$domain_ip")
	is_ip_valid "$local_ip" "$user"
else
	get_user_ip
fi

add_mail_ssl_config

select_webmail_template "$WEBMAIL"

add_webmail_config "$(webmail_front)" "${WEBMAIL_TEMPLATE}.stpl"

if [ -n "$PROXY_SYSTEM" ]; then
	add_webmail_config "$PROXY_SYSTEM" "${PROXY_TEMPLATE}.stpl"
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$SSL' "yes"

$BIN/h-restart-mail "$restart"
check_result $? "Mail restart failed" > /dev/null

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Mail" "SSL enabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

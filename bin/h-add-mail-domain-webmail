#!/bin/bash
# info: add webmail support for a domain
# options: USER DOMAIN [WEBMAIL] [RESTART] [QUIET]
#
# example: h-add-mail-domain-webmail user domain.com
# example: h-add-mail-domain-webmail user domain.com tachyon
# example: h-add-mail-domain-webmail user domain.com roundcube
#
# This function enables webmail client for a mail domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
webmail=$3
restart="$4"
quiet=$5

if [ -z "$restart" ]; then
	restart="yes"
fi

# Additional argument formatting
if [[ "$domain" =~ [[:upper:]] ]]; then
	domain=$(echo "$domain" | tr '[:upper:]' '[:lower:]')
fi
if [[ "$domain" =~ ^www\..* ]]; then
	domain=$(echo "$domain" | sed -e "s/^www.//")
fi
if [[ "$domain" =~ .*\.$ ]]; then
	domain=$(echo "$domain" | sed -e "s/\.$//")
fi

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$webmail" ]; then
	# Default mirrors the panel (web/add/mail): the first INSTALLED client in the order of
	# WEBMAIL_KNOWN_CLIENTS (roundcube first), never the position in WEBMAIL_SYSTEM - the token
	# writers append, so a position would make the default depend on install order.
	for c in $WEBMAIL_KNOWN_CLIENTS; do
		# exact token, not a word boundary: grep -w would take roundcube from roundcube-next
		case ",$WEBMAIL_SYSTEM," in *",$c,"*)
			webmail="$c"
			break
			;;
		esac
	done
fi

# The WEBMAIL record's value domain (#584): '' (resolved above), 'disabled', or a client from
# WEBMAIL_KNOWN_CLIENTS (include/main.sh - the one list, smoke-guarded against the shipped
# templates). Known STATICALLY, not by install state: a client that is merely absent right now
# - delete/re-add window, backend-switch reinstall - keeps its record, renders degraded via
# select_webmail_template, and heals when the client returns. Deriving validity from
# WEBMAIL_SYSTEM instead silently converged every domain of a client to 'disabled' DURING its
# own reinstall. Only values outside the domain (legacy 'snappymail', a typo) normalize,
# loudly. Never an abort: rebuild paths feed recorded values back in here.
if [ -n "$webmail" ] && [ "$webmail" != "disabled" ] \
	&& ! grep -qwF -- "$webmail" <<< "$WEBMAIL_KNOWN_CLIENTS"; then
	echo "NOTE: unknown webmail client '$webmail' - storing 'disabled' for $domain"
	webmail="disabled"
fi

check_args '2' "$#" 'USER DOMAIN [WEBMAIL] [RESTART]'
is_format_valid 'user' 'domain' 'restart'
# the webmail vhost needs a front, not customer web: on a mailfront box
# WEB_SYSTEM is empty by design (#193) and WEBMAIL_FRONT carries nginx
front=$(webmail_front)
is_system_enabled "$front" 'WEBMAIL front (WEB_SYSTEM/WEBMAIL_FRONT)'
is_system_enabled "$IMAP_SYSTEM" 'IMAP_SYSTEM'
# The client was normalized above; select_webmail_template (below) additionally degrades
# an uninstalled client to the safe 'disabled' vhost at render time, so a rebuild after a
# webmailer is removed can never fail (#119).
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Inherit web domain local ip address
domain_ip=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP')
if [ -n "$domain_ip" ]; then
	local_ip=$(get_real_ip "$domain_ip")
	is_ip_valid "$local_ip" "$user"

	ip=$local_ip
	nat_ip=$(get_ip_value '$NAT')
	if [ -n "$nat_ip" ]; then
		ip=$nat_ip
	fi
else
	get_user_ip
fi
# v6 mirror: web domain's IP6, else default v6, else none
local_ip6=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP6')
if [ -z "$local_ip6" ] && get_user_ip6; then
	local_ip6="$ip6"
fi
if [ -n "$local_ip6" ] && [ ! -e "$CONF_DIR/ips/$local_ip6" ]; then
	local_ip6=''
fi

# Verify that webmail alias variable exists and create it if it does not
if [ -z "$WEBMAIL_ALIAS" ]; then
	$BIN/h-change-sys-config-value 'WEBMAIL_ALIAS' "webmail"
else

	# Resolve template names (degrades to 'disabled' when the client isn't installed)
	select_webmail_template "$webmail"

	add_webmail_config "$front" "${WEBMAIL_TEMPLATE}.tpl"

	if [ -n "$PROXY_SYSTEM" ]; then
		add_webmail_config "$PROXY_SYSTEM" "${PROXY_TEMPLATE}.tpl"
	fi

	# Enable SSL for webmail if available
	if [ -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt ] || [ "$SSL" = 'yes' ]; then
		add_webmail_config "$front" "${WEBMAIL_TEMPLATE}.stpl"

		if [ -n "$PROXY_SYSTEM" ]; then
			add_webmail_config "$PROXY_SYSTEM" "${PROXY_TEMPLATE}.stpl"
		fi
	fi
fi

# Create the log files the vhost will write (mirrors the web-domain rebuild):
# nginx only creates them on first traffic, but the fail2ban web jails hang on
# EXISTING logs - without this the first webmail domain would not arm them
if [ -n "$front" ]; then
	mkdir -p "/var/log/$front/domains"
	touch "/var/log/$front/domains/$WEBMAIL_ALIAS.$domain.log" \
		"/var/log/$front/domains/$WEBMAIL_ALIAS.$domain.error.log"
	chown root:$user "/var/log/$front/domains/$WEBMAIL_ALIAS.$domain."* 2> /dev/null
fi
# first log on the box arms the web jails (change-detected, no-op otherwise)
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
declare -F fail2ban_regate_web_apply > /dev/null 2>&1 || source "$HESTIA/include/fail2ban.sh"
fail2ban_regate_web_apply

WEBMAIL=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
if [ -z "$WEBMAIL" ]; then
	add_object_key 'mail' 'DOMAIN' "$domain" 'WEBMAIL' 'SSL'
fi

# Set SSL as enabled in configuration
update_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL' "$webmail"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

if [ "$restart" = 'yes' ]; then
	# Restarting web server
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null

	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null
fi

# Logging
if [ "$quiet" != 'yes' ]; then
	$BIN/h-log-action "$user" "Info" "Mail" "Webmail access enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

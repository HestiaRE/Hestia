#!/bin/bash
# info: add webmail support for a domain
# options: USER DOMAIN [WEBMAIL] [RESTART] [QUIET]
#
# example: h-add-mail-domain-webmail user domain.com
# example: h-add-mail-domain-webmail user domain.com tachyon
# example: h-add-mail-domain-webmail user domain.com roundcube
#
# This function enables webmail client for a mail domain.

user=$1
domain=$2
webmail=$3
restart="$4"
quiet=$5

if [ -z "$restart" ]; then
	restart="yes"
fi

if [[ "$domain" =~ [[:upper:]] ]]; then
	domain=$(echo "$domain" | tr '[:upper:]' '[:lower:]')
fi
if [[ "$domain" =~ ^www\..* ]]; then
	domain=$(echo "$domain" | sed -e "s/^www.//")
fi
if [[ "$domain" =~ .*\.$ ]]; then
	domain=$(echo "$domain" | sed -e "s/\.$//")
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

if [ -z "$webmail" ]; then
	# Keep in step with web/add/mail: the first installed client in WEBMAIL_KNOWN_CLIENTS order, not WEBMAIL_SYSTEM's.
	for c in $WEBMAIL_KNOWN_CLIENTS; do
		# Exact token, not grep -w: that would take roundcube from roundcube-next.
		case ",$WEBMAIL_SYSTEM," in *",$c,"*)
			webmail="$c"
			break
			;;
		esac
	done
fi

# Known by WEBMAIL_KNOWN_CLIENTS, not install state: an absent client keeps its record and renders degraded until it
# returns. Anything else becomes 'disabled', never an abort: rebuild paths feed recorded values back in here.
# One exact name: grep -w passed a value of several lines or one spanning several names.
if [ -n "$webmail" ] && [ "$webmail" != "disabled" ]; then
	known=''
	for c in $WEBMAIL_KNOWN_CLIENTS; do
		[ "$webmail" = "$c" ] && known='yes'
	done
	if [ -z "$known" ]; then
		echo "NOTE: unknown webmail client '$webmail' - storing 'disabled' for $domain"
		webmail="disabled"
	fi
fi

check_args '2' "$#" 'USER DOMAIN [WEBMAIL] [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
# The front, not WEB_SYSTEM: on a mailfront box WEB_SYSTEM is empty and WEBMAIL_FRONT carries nginx.
front=$(webmail_front)
is_system_enabled "$front" 'WEBMAIL front (WEB_SYSTEM/WEBMAIL_FRONT)'
is_system_enabled "$IMAP_SYSTEM" 'IMAP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

domain_ip=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP')
if [ -n "$domain_ip" ]; then
	local_ip=$(get_real_ip "$domain_ip")
	is_ip_valid "$local_ip" "$user"

	ip=$local_ip
	nat_ip=$(get_ip_value '$NAT')
	if [ -n "$nat_ip" ]; then
		ip=$nat_ip
	fi
else
	get_user_ip
fi
local_ip6=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP6')
if [ -z "$local_ip6" ] && get_user_ip6; then
	local_ip6="$ip6"
fi
if [ -n "$local_ip6" ] && [ ! -e "$CONF_DIR/ips/$local_ip6" ]; then
	local_ip6=''
fi

if [ -z "$WEBMAIL_ALIAS" ]; then
	$BIN/h-change-sys-config-value 'WEBMAIL_ALIAS' "webmail"
else

	select_webmail_template "$webmail"

	add_webmail_config "$front" "${WEBMAIL_TEMPLATE}.tpl"

	if [ -n "$PROXY_SYSTEM" ]; then
		add_webmail_config "$PROXY_SYSTEM" "${PROXY_TEMPLATE}.tpl"
	fi

	if [ -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt ] || [ "$SSL" = 'yes' ]; then
		add_webmail_config "$front" "${WEBMAIL_TEMPLATE}.stpl"

		if [ -n "$PROXY_SYSTEM" ]; then
			add_webmail_config "$PROXY_SYSTEM" "${PROXY_TEMPLATE}.stpl"
		fi
	fi
fi

# As the web-domain rebuild does: the fail2ban web jails arm only on existing logs, nginx writes them on first traffic.
if [ -n "$front" ]; then
	mkdir -p "/var/log/$front/domains"
	touch "/var/log/$front/domains/$WEBMAIL_ALIAS.$domain.log" \
		"/var/log/$front/domains/$WEBMAIL_ALIAS.$domain.error.log"
	chown root:$user "/var/log/$front/domains/$WEBMAIL_ALIAS.$domain."* 2> /dev/null
	# As the web domain logs; the caller's umask would leave them 644 or 600.
	chmod 640 "/var/log/$front/domains/$WEBMAIL_ALIAS.$domain."* 2> /dev/null
fi
# The first log on the box arms the web jails; a no-op otherwise.
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
declare -F fail2ban_regate_web_apply > /dev/null 2>&1 || source "$HESTIA/include/fail2ban.sh"
fail2ban_regate_web_apply

WEBMAIL=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
if [ -z "$WEBMAIL" ]; then
	add_object_key 'mail' 'DOMAIN' "$domain" 'WEBMAIL' 'SSL'
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL' "$webmail"

if [ "$restart" = 'yes' ]; then
	# A new vhost needs a reload; a restart would cut the panel request asking for it.
	$BIN/h-restart-web ''
	check_result $? "Web restart failed" > /dev/null

	$BIN/h-restart-proxy ''
	check_result $? "Proxy restart failed" > /dev/null
fi

if [ "$quiet" != 'yes' ]; then
	$BIN/h-log-action "$user" "Info" "Mail" "Webmail access enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

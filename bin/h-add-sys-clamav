#!/bin/bash
# info: install ClamAV mail antivirus
# options: NONE
#
# example: h-add-sys-clamav
#
# Installs ClamAV and wires it as the mail antivirus, mirroring h-add-sys-rspamd.
# Arms the exim CLAMD macro + ANTIVIRUS_SYSTEM=clamav ONLY once clamd answers on the
# socket: av_scanner=clamd: with malware=*/defer_ok is FAIL-OPEN, so an armed-but-blind
# clamd would silently accept mail unscanned. DB still downloading -> macro stays OFF
# + WARN to re-run. Idempotent. Also called by the installer.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

EXIM_USER="Debian-exim"
CLAMD_USER="clamav"
CLAMD_DB_DIR="/var/lib/clamav"
EXIM_TPL="/etc/exim4/exim4.conf.template"

# Only an answer on the socket proves clamd can actually scan.
clamd_alive() { clamdscan --ping 1 > /dev/null 2>&1; }

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'

if grep -q '^CLAMD = yes' "$EXIM_TPL" 2> /dev/null \
	&& [ "$ANTIVIRUS_SYSTEM" = 'clamav' ] && clamd_alive; then
	echo "INFO: ClamAV is already installed and active."
	exit 0
fi

# An interrupted delete can strand the DB under .saved. Reclaimed before apt, so the postinst finds it in place.
if [ -d "$CLAMD_DB_DIR.saved" ]; then
	rm -rf "$CLAMD_DB_DIR"
	mv "$CLAMD_DB_DIR.saved" "$CLAMD_DB_DIR"
fi

# clamav brings clamdscan for the ping; clamav-daemon only recommends it.
if ! dpkg -l clamav-daemon 2> /dev/null | grep -q '^ii'; then
	echo "Installing ClamAV (clamav clamav-daemon clamav-freshclam)..."
	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq \
		install clamav clamav-daemon clamav-freshclam > /dev/null 2>&1
	# The freshclam postinst blocks on the first DB download and can time out, leaving the set half-configured.
	if ! dpkg -l clamav-daemon 2> /dev/null | grep -q '^ii'; then
		dpkg --configure -a > /dev/null 2>&1 || true
	fi
	if ! dpkg -l clamav-daemon 2> /dev/null | grep -q '^ii'; then
		echo "ERROR: ClamAV installation failed."
		exit "$E_INVALID"
	fi
fi

# Both directions: exim writes the clamd socket, clamd reads the exim spool. Without the second, scanning fails open.
cp -f "$HESTIA/share/clamav/clamd.conf" /etc/clamav/clamd.conf
usermod -aG "$CLAMD_USER" "$EXIM_USER"
usermod -aG "$EXIM_USER" "$CLAMD_USER"

# The clamav uid may have changed across a purge and reinstall.
[ -d "$CLAMD_DB_DIR" ] && chown -R "$CLAMD_USER:$CLAMD_USER" "$CLAMD_DB_DIR"

# Socket mode 0660 goes into the .socket unit: clamd is socket-activated, so LocalSocketMode is not the live mode.
mkdir -p /etc/systemd/system/clamav-daemon.socket.d
cp -f "$HESTIA/share/clamav/socket-hardening.conf" \
	/etc/systemd/system/clamav-daemon.socket.d/hardening.conf
systemctl daemon-reload
systemctl restart clamav-daemon.socket > /dev/null 2>&1

# The stock profile already allows the spool read; the override keeps it under a stricter base profile.
if [ -f /etc/apparmor.d/usr.sbin.clamd ]; then
	mkdir -p /etc/apparmor.d/local
	cp -f "$HESTIA/share/clamav/apparmor-local" /etc/apparmor.d/local/usr.sbin.clamd
	apparmor_parser -r /etc/apparmor.d/usr.sbin.clamd > /dev/null 2>&1 || true
fi

# The freshclam service pulls the DB: a manual freshclam would collide with its lock.
systemctl enable --now clamav-freshclam > /dev/null 2>&1
echo "Waiting for the virus database (freshclam, up to 5 min)..."
db_ready=0
for _ in $(seq 1 300); do
	if { [ -e "$CLAMD_DB_DIR/main.cvd" ] || [ -e "$CLAMD_DB_DIR/main.cld" ]; } \
		&& { [ -e "$CLAMD_DB_DIR/daily.cvd" ] || [ -e "$CLAMD_DB_DIR/daily.cld" ]; }; then
		db_ready=1
		break
	fi
	sleep 1
done

# restart, not enable --now: apt may have started clamd before the usermod, without the new group and socket mode.
systemctl enable clamav-daemon > /dev/null 2>&1
systemctl restart clamav-daemon > /dev/null 2>&1
clamd_up=0
if [ "$db_ready" = 1 ]; then
	for _ in $(seq 1 60); do
		clamd_alive && {
			clamd_up=1
			break
		}
		sleep 1
	done
fi

# Arming a clamd that does not answer would pass mail unscanned.
if [ "$clamd_up" = 1 ]; then
	sed -i 's/^#CLAMD = yes/CLAMD = yes/' "$EXIM_TPL"
	# The macro is fail-open, so a template without the line would scan nothing and say nothing.
	if ! grep -q '^CLAMD = yes' "$EXIM_TPL"; then
		echo "ERROR: no CLAMD macro in $EXIM_TPL, antivirus is NOT active."
		exit "$E_NOTEXIST"
	fi
	systemctl restart exim4
	if ! systemctl is-active --quiet exim4; then
		sed -i 's/^CLAMD = yes/#CLAMD = yes/' "$EXIM_TPL"
		systemctl restart exim4
		echo "ERROR: exim4 failed to restart with ClamAV enabled, it runs again without it."
		exit "$E_RESTART"
	fi
	$BIN/h-change-sys-config-value 'ANTIVIRUS_SYSTEM' 'clamav'
	echo "ClamAV is now active (mail antivirus)."
else
	echo "WARNING: ClamAV installed, but clamd is not answering yet (virus DB still"
	echo "         downloading). Antivirus is NOT active. Re-run 'h-add-sys-clamav'"
	echo "         once the DB is ready to activate scanning."
	$BIN/h-log-action "system" "Warning" "System" "Installed ClamAV, not active: clamd does not answer."
	# Non-zero so the installer lists it among its warnings.
	exit "$E_CONNECT"
fi

$BIN/h-log-action "system" "Info" "System" "Installed ClamAV mail antivirus."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: accept an inbound CrowdSec mesh pairing request
# options: IP HANDOFF_FILE
# labels: internal
# caller: web/mesh-pair.php
#
# example: h-add-sys-crowdsec-peer-request 10.5.5.13 /run/hestia/mesh/in/abc123
#
# Accepting half of the pairing handshake. HANDOFF_FILE is the peer's JSON {code, token, port, host}, staged 0600 by the
# panel to keep code and token off argv, and removed on sight. IP is the observed source, never a self-reported one.
# The one-time code is the whole authorisation, so it is checked before any side effect. Prints only the JSON reply.

ip=$1
handoff=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/crowdsec-mesh.sh
source $HESTIA/include/crowdsec-mesh.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

# Errors go to stderr: stdout carries the JSON reply and nothing else.
fail() {
	echo "ERROR: $1" >&2
	[ -n "$handoff_ok" ] && rm -f "$handoff"
	exit "${2:-$E_INVALID}"
}

# Single use, also shut on expiry and on too many wrong guesses: brute force gets one short window, a few tries.
pairing_close() {
	rm -f "$MESH_PAIRING_CONF" "$MESH_RUN_DIR/pairing"
}

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root" >&2
	exit 10
fi

check_args '2' "$#" 'IP HANDOFF_FILE'

# Before anything that could remove it: a refused path is never touched.
handoff_ok=''
mesh_handoff_valid "$handoff" || fail "handoff file must be a file in $MESH_RUN_DIR/in" "$E_NOTEXIST"
handoff_ok=yes
mesh_load || fail "fleet-mesh is not enabled" "$E_DISABLED"
[ -f "$MESH_PAIRING_CONF" ] || fail "no pairing window is open" "$E_NOTEXIST"

# Either family: the peer is paired on the source address it actually used.
(is_ip46_format_valid "$ip") > /dev/null 2>&1 || fail "invalid source address"

# shellcheck source=/etc/hestia/crowdsec/pairing.conf
source "$MESH_PAIRING_CONF"
code=$(jq -r '.code // empty' "$handoff" 2> /dev/null | tr '[:lower:]' '[:upper:]' | LC_ALL=C tr -dc 'A-Z0-9')
token=$(jq -r '.token // empty' "$handoff" 2> /dev/null)
peer_port=$(jq -r '.port // empty' "$handoff" 2> /dev/null)
peer_host=$(jq -r '.host // empty' "$handoff" 2> /dev/null)
rm -f "$handoff"

[ "$(date +%s)" -le "${PAIRING_EXPIRES:-0}" ] || {
	pairing_close
	fail "pairing window expired" "$E_NOTEXIST"
}

tries=$((${PAIRING_TRIES:-0} + 1))
if [ "$tries" -gt "$MESH_PAIRING_TRIES" ]; then
	pairing_close
	fail "too many failed pairing attempts - window closed" "$E_PASSWORD"
fi
if [ "$(mesh_hash "$code")" != "${PAIRING_HASH:-x}" ]; then
	sed -i "s/^PAIRING_TRIES=.*/PAIRING_TRIES='$tries'/" "$MESH_PAIRING_CONF"
	$BIN/h-log-action "system" "Warning" "System" "CrowdSec mesh pairing rejected (bad code from $ip)." > /dev/null 2>&1
	fail "invalid pairing code" "$E_PASSWORD"
fi

# Shut the window before the work: a replay must not get a second peer even if the steps below fail.
pairing_close

[[ "$token" =~ ^[a-f0-9]{32,128}$ ]] || fail "peer sent no usable token" "$E_PARSING"
# The host lands in the pull config, where a newline would be a second curl directive.
if [[ "$peer_host" == *:* ]]; then
	(is_ipv6_format_valid "$peer_host" 'peer host') > /dev/null 2>&1 \
		|| fail "peer sent no usable host" "$E_PARSING"
	peer_host=$(ip6_canonical "$peer_host") || fail "cannot canonicalise the peer's v6 host" "$E_PARSING"
elif ! [[ "$peer_host" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,253}$ ]]; then
	fail "peer sent no usable host" "$E_PARSING"
fi
[[ "$peer_port" =~ ^[0-9]{1,5}$ ]] || peer_port="${BACKEND_PORT:-8083}"

# The peer's own name is only a label; we connect to the observed IP.
peer=$(mesh_peer_id "$peer_host")
[ -n "$peer" ] || peer=$(mesh_peer_id "$ip")
[ -n "$peer" ] || fail "could not derive a peer id" "$E_INVALID"
if [ -f "$MESH_PEERS_CONF" ] && grep -q "^PEER='$peer'" "$MESH_PEERS_CONF"; then
	peer="$peer-$(mesh_peer_id "$ip")"
	grep -q "^PEER='$peer'" "$MESH_PEERS_CONF" && fail "peer $peer already paired" "$E_EXISTS"
fi

mesh_fw_open "$ip" "$peer"
pin=$(mesh_spki_pin "$ip" "$peer_port") || {
	mesh_fw_close "$peer"
	fail "cannot read the TLS key of $ip:$peer_port (is its panel reachable from here?)" "$E_CONNECT"
}

serve_token=$(mesh_token_new)
time_n_date=$(date +'%T %F')
str="PEER='$peer' HOST='$ip' PORT='$peer_port' IP='$ip' PIN='$pin'"
str="$str PULL_TOKEN='$token' SERVE_TOKEN='$serve_token' SUSPENDED='no'"
str="$str TIME='$(echo "$time_n_date" | cut -f1 -d ' ')' DATE='$(echo "$time_n_date" | cut -f2 -d ' ')'"
touch "$MESH_PEERS_CONF"
chmod 600 "$MESH_PEERS_CONF"
echo "$str" >> "$MESH_PEERS_CONF"

# No full refresh: its pull back to a peer still inside this request can outlast that request's timeout.
mesh_stage_serve

jq -n --arg token "$serve_token" --arg port "${BACKEND_PORT:-8083}" \
	--arg host "$(hostname -f 2> /dev/null || hostname)" \
	'{token: $token, port: $port, host: $host}'

$BIN/h-log-action "system" "Info" "System" "CrowdSec mesh peer accepted (Peer: $peer, IP: $ip)." > /dev/null 2>&1
log_event "$OK" "PEER='$peer'"

exit

#!/bin/bash
# info: install Docker for per-user rootless containers
# options: NONE
#
# example: h-add-sys-docker
#
# Host side of per-user rootless Docker (#389): repo, packages, prerequisites.
# Enabling it for a customer is a separate action. Idempotent.
#
# Official Docker repo, a deliberate exception to the OS-repo rule: neither Debian
# packages compose v2, the OS docker.io spans 20.10 to 29.1 across the targets, and
# dockerd-rootless.sh ships only in Debian's build. Scoped - the addon adds the repo,
# h-delete-sys-docker removes it. Unpinned: no OS package shares a name with this repo,
# so there is nothing to shadow.
#
# The rootful daemon is disabled - one daemon per customer runs under their companion.
# docker.socket goes too, else socket activation resurrects it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/helper.sh
source $HESTIA/include/helper.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

DOCKER_KEYRING='/usr/share/keyrings/docker-keyring.gpg'
DOCKER_LIST='/etc/apt/sources.list.d/docker.list'

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-docker can only be executed by the root user"
	exit 10
fi

# On cgroup v1 container resource limits are silent no-ops - refuse rather than
# half-install.
if [ "$(stat -fc %T /sys/fs/cgroup 2> /dev/null)" != 'cgroup2fs' ]; then
	echo "ERROR: /sys/fs/cgroup is not cgroup v2 - rootless Docker is not supported here."
	exit "$E_INVALID"
fi

os_id="$(. /etc/os-release 2> /dev/null && echo "${ID:-}")"
os_codename="$(. /etc/os-release 2> /dev/null && echo "${VERSION_CODENAME:-}")"
if [ "$os_id" != 'debian' ] && [ "$os_id" != 'ubuntu' ]; then
	echo "ERROR: unsupported distribution '$os_id' for the Docker repo."
	exit "$E_INVALID"
fi
[ -n "$os_codename" ] || {
	echo "ERROR: cannot determine the OS codename."
	exit "$E_INVALID"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# installed = package present AND registered. Both halves: a package the OS dragged in without our
# config is not an installation, and the installer must still get through on a half-built box.
if dpkg -l docker-ce 2> /dev/null | grep -q '^ii' && [ "$DOCKER_SYSTEM" = 'docker' ]; then
	echo "INFO: Docker is already installed."
	exit
fi

# The old inline addon installed the OS docker.io, which is the rootful daemon this
# feature replaces. It conflicts with docker-ce, so it goes first rather than letting
# apt resolve it mid-transaction.
if dpkg-query -W -f='${db:Status-Status}' docker.io 2> /dev/null | grep -q '^installed$'; then
	echo "Removing the OS docker.io (superseded by docker-ce)..."
	apt-get -y -qq purge docker.io > /dev/null 2>&1
fi

echo "Adding the Docker repository..."
install -m 0755 -d /usr/share/keyrings
if [ ! -s "$DOCKER_KEYRING" ]; then
	curl -fsSL "https://download.docker.com/linux/$os_id/gpg" -o /tmp/docker_apt.gpg \
		|| {
			echo "ERROR: failed to download the Docker signing key"
			exit "$E_CONNECT"
		}
	gpg --dearmor < /tmp/docker_apt.gpg > "$DOCKER_KEYRING" \
		|| {
			echo "ERROR: failed to dearmor the Docker signing key"
			rm -f /tmp/docker_apt.gpg
			exit "$E_INVALID"
		}
	rm -f /tmp/docker_apt.gpg
fi
[ -s "$DOCKER_KEYRING" ] || {
	echo "ERROR: Docker keyring empty"
	exit "$E_INVALID"
}
chmod a+r "$DOCKER_KEYRING"

arch="$(dpkg --print-architecture 2> /dev/null || uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')"
printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/%s %s stable\n' \
	"$arch" "$DOCKER_KEYRING" "$os_id" "$os_codename" > "$DOCKER_LIST"

apt-get -qq update > /dev/null 2>&1

# Named explicitly, not left to Recommends: rootless-extras only *recommends*
# slirp4netns, buildx arrives the same way, and --no-install-recommends would then yield
# a Docker that cannot network or build. systemd-container is for systemd-run --machine,
# since su creates no session.
docker_req="docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras docker-compose-plugin"
host_req="uidmap slirp4netns dbus-user-session systemd-container"
# Degradations, not blockers: no supported target needs fuse-overlayfs, and buildx only
# matters for building images rather than pulling them.
optional_pkgs="fuse-overlayfs docker-buildx-plugin"

apt_log="$(mktemp -t hestia-docker-apt.XXXXXX)"
echo "Installing Docker ($docker_req)..."
# shellcheck disable=SC2086
apt-get -y -qq install $docker_req $host_req $optional_pkgs > "$apt_log" 2>&1

# Every package, not a sample: apt can report success on a partial transaction, and the
# gap would surface only when a customer is enabled.
missing=''
for p in $docker_req $host_req; do
	dpkg-query -W -f='${db:Status-Status}' "$p" 2> /dev/null | grep -q '^installed$' \
		|| missing="$missing $p"
done
if [ -n "$missing" ]; then
	echo "ERROR: required package(s) not installed:$missing"
	echo "       apt output: $apt_log"
	exit "$E_INVALID"
fi
for p in $optional_pkgs; do
	dpkg-query -W -f='${db:Status-Status}' "$p" 2> /dev/null | grep -q '^installed$' \
		|| echo "Warning: $p is not installed (apt output: $apt_log)" >&2
done
rm -f "$apt_log"

echo "Disabling the rootful daemon..."
systemctl disable --now docker.service docker.socket > /dev/null 2>&1 || true
# End state, not exit code: systemd warns about triggering units even when both are
# handled in one call.
for u in docker.service docker.socket; do
	if [ "$(systemctl is-active "$u" 2> /dev/null)" = 'active' ]; then
		echo "ERROR: $u is still active - a rootful daemon would preempt the per-user ones."
		exit "$E_INVALID"
	fi
done

docker_drop_orphan_bridge

# No cgroup delegation drop-in: systemd already ships user@.service with
# `Delegate=pids memory cpu` (verified down to systemd 252), which is what --memory,
# --cpus and `docker stats` need. Adding cpuset/io on the template would widen every
# session on the box for limits nothing asks for; it belongs on the companion's uid.

# runc cannot start a container scope while hidepid hides the pids, so the companion
# needs the exemption group (#565); created here, before any customer is enabled.
if command -v proc_hardening_apply > /dev/null 2>&1; then
	proc_hardening_apply || true
else
	echo "Warning: proc_hardening_apply unavailable - ensure group procvis exists before enabling a customer." >&2
fi

# The panel only learns about an addon through hestia.conf (FILE_MANAGER_PORT precedent):
# without it the per-customer switch in edit-user has nothing to gate on.
$BIN/h-change-sys-config-value 'DOCKER_SYSTEM' 'docker'

echo "Docker is now installed. Enable it per customer to create their companion."

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Installed Docker (rootless, per-user)."
log_event "$OK" "$ARGUMENTS"

exit

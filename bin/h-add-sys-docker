#!/bin/bash
# info: install Docker for per-user rootless containers
# options: NONE
#
# example: h-add-sys-docker
#
# Host side of per-user rootless Docker; enabling it for a customer is a separate action. The rootful daemon stays off.
# Docker's own repo is a deliberate exception to the OS-repo rule: no OS build ships compose v2 and rootless together.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/helper.sh
source $HESTIA/include/helper.sh
source_conf "$HESTIA/conf/hestia.conf"

DOCKER_KEYRING='/usr/share/keyrings/docker-keyring.gpg'
DOCKER_LIST='/etc/apt/sources.list.d/docker.list'

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-docker can only be executed by the root user"
	exit 10
fi

# On cgroup v1 container limits are silent no-ops.
if [ "$(stat -fc %T /sys/fs/cgroup 2> /dev/null)" != 'cgroup2fs' ]; then
	echo "ERROR: /sys/fs/cgroup is not cgroup v2 - rootless Docker is not supported here."
	exit "$E_INVALID"
fi

os_id="$(. /etc/os-release 2> /dev/null && echo "${ID:-}")"
os_codename="$(. /etc/os-release 2> /dev/null && echo "${VERSION_CODENAME:-}")"
if [ "$os_id" != 'debian' ] && [ "$os_id" != 'ubuntu' ]; then
	echo "ERROR: unsupported distribution '$os_id' for the Docker repo."
	exit "$E_INVALID"
fi
[ -n "$os_codename" ] || {
	echo "ERROR: cannot determine the OS codename."
	exit "$E_INVALID"
}

# Installed = package present and registered; a package the OS dragged in is not an installation.
if dpkg -l docker-ce 2> /dev/null | grep -q '^ii' && [ "$DOCKER_SYSTEM" = 'docker' ]; then
	echo "INFO: Docker is already installed."
	exit 0
fi

# docker.io conflicts with docker-ce, so it goes first rather than mid-transaction.
if dpkg-query -W -f='${db:Status-Status}' docker.io 2> /dev/null | grep -q '^installed$'; then
	echo "Removing the OS docker.io (superseded by docker-ce)..."
	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq purge docker.io > /dev/null 2>&1
fi

echo "Adding the Docker repository..."
install -m 0755 -d /usr/share/keyrings
if [ ! -s "$DOCKER_KEYRING" ]; then
	apt_key_fetch docker "https://download.docker.com/linux/$os_id/gpg" "$DOCKER_KEYRING" || exit "$E_CONNECT"
fi
[ -s "$DOCKER_KEYRING" ] || {
	echo "ERROR: Docker keyring empty"
	exit "$E_INVALID"
}
chmod a+r "$DOCKER_KEYRING"

arch="$(dpkg --print-architecture 2> /dev/null || uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')"
printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/%s %s stable\n' \
	"$arch" "$DOCKER_KEYRING" "$os_id" "$os_codename" > "$DOCKER_LIST"

DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -qq update > /dev/null 2>&1

# Named explicitly: as mere Recommends, --no-install-recommends would leave a Docker that cannot network or build.
docker_req="docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras docker-compose-plugin"
host_req="uidmap slirp4netns dbus-user-session systemd-container"
# Degradations, not blockers.
optional_pkgs="fuse-overlayfs docker-buildx-plugin"

apt_log="$(mktemp -t hestia-docker-apt.XXXXXX)"
echo "Installing Docker ($docker_req)..."
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq install $docker_req $host_req $optional_pkgs > "$apt_log" 2>&1

# Every package: apt can report success on a partial transaction.
missing=''
for p in $docker_req $host_req; do
	dpkg-query -W -f='${db:Status-Status}' "$p" 2> /dev/null | grep -q '^installed$' \
		|| missing="$missing $p"
done
if [ -n "$missing" ]; then
	echo "ERROR: required package(s) not installed:$missing"
	echo "       apt output: $apt_log"
	exit "$E_INVALID"
fi
for p in $optional_pkgs; do
	dpkg-query -W -f='${db:Status-Status}' "$p" 2> /dev/null | grep -q '^installed$' \
		|| echo "Warning: $p is not installed (apt output: $apt_log)" >&2
done
rm -f "$apt_log"

echo "Disabling the rootful daemon..."
systemctl disable --now docker.service docker.socket > /dev/null 2>&1 || true
# End state, not exit code: systemd warns about triggering units even when both go in one call.
for u in docker.service docker.socket; do
	if [ "$(systemctl is-active "$u" 2> /dev/null)" = 'active' ]; then
		echo "ERROR: $u is still active - a rootful daemon would preempt the per-user ones."
		exit "$E_INVALID"
	fi
done

docker_drop_orphan_bridge

# No cgroup delegation drop-in: user@.service already delegates pids, memory and cpu, all that the limits need.

# runc cannot start a container scope while hidepid hides the pids, so the companion needs the exemption group.
if command -v proc_hardening_apply > /dev/null 2>&1; then
	proc_hardening_apply || true
else
	echo "Warning: proc_hardening_apply unavailable - ensure group procvis exists before enabling a customer." >&2
fi

# The panel's per-customer switch gates on this key.
$BIN/h-change-sys-config-value 'DOCKER_SYSTEM' 'docker'

echo "Docker is now installed. Enable it per customer to create their companion."

$BIN/h-log-action "system" "Info" "System" "Installed Docker (rootless, per-user)."
log_event "$OK" "$ARGUMENTS"

exit

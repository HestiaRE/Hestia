#!/bin/bash
# info: install the fail2ban brute-force protection addon
# options: NONE
#
# example: h-add-sys-fail2ban
#
# fail2ban wired as a CLIENT of the hestia firewall, so bans survive a rebuild. Refuses without FIREWALL_SYSTEM.
# Idempotent; the work is fail2ban_apply, shared with the installer.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# The ban action writes into the hestia ruleset; with no firewall there is nothing to write to.
if [ -z "$FIREWALL_SYSTEM" ]; then
	echo "ERROR: fail2ban needs the system firewall; enable it first (h-add-sys-firewall)."
	exit "$E_INVALID"
fi

if [ "$FIREWALL_EXTENSION" = 'fail2ban' ] && systemctl is-active --quiet fail2ban 2> /dev/null; then
	echo "INFO: fail2ban is already installed and active."
	exit 0
fi

echo "[ * ] Installing fail2ban..."
DEBIAN_FRONTEND=noninteractive apt-get -y -qq install fail2ban > /dev/null 2>&1
if ! dpkg -l fail2ban 2> /dev/null | grep -q '^ii'; then
	echo "ERROR: the fail2ban package failed to install."
	exit "$E_INVALID"
fi

# Gate the mail/ftp jails on the actual model (an enabled jail on a missing log aborts the daemon).
mail='no'
[ -n "$MAIL_SYSTEM" ] && mail='yes'
ftp='no'
[ -n "$FTP_SYSTEM" ] && ftp='yes'

source "$HESTIA/include/fail2ban.sh"
if ! fail2ban_apply "$mail" "$ftp"; then
	systemctl -q disable --now fail2ban 2> /dev/null
	echo "ERROR: fail2ban did not start; check 'fail2ban-client -d'."
	exit "$E_INVALID"
fi

# Only once the daemon answers: set before a failed start, the key and the CrowdSec hand-over leave SSH unguarded.
$BIN/h-change-sys-config-value "FIREWALL_EXTENSION" "fail2ban"
if [ -f "$CONF_DIR/firewall/crowdsec.conf" ]; then
	# shellcheck source=/usr/local/hestia/include/crowdsec.sh
	source "$HESTIA/include/crowdsec.sh"
	crowdsec_gate_bruteforce
fi

# The feeder's denylist keys off FIREWALL_EXTENSION, just set, so it is refreshed now rather than on its timer.
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && $BIN/h-update-firewall-crowdsec

$BIN/h-log-action "system" "Info" "System" "Installed fail2ban addon."
log_event "$OK" "$ARGUMENTS"

exit

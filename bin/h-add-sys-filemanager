#!/bin/bash
# info: install the web file manager
# options: NONE
#
# example: h-add-sys-filemanager
#
# Installs the file manager module (#419): deploys the shared read-only app code to
# /usr/share/filemanager/fm, generates the Caddy<->listener secret, adds the
# Panel-Caddy /fm/ forward_auth route + tmpfiles socket dir, and reactivates any
# saved per-user flags. Per customer, h-add-user-filemanager then adds a pool + vhost
# that run as that customer. Reverse: h-delete-sys-filemanager.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# shellcheck source=/usr/local/hestia/include/filemanager.sh
source "$HESTIA/include/filemanager.sh"

ROUTE="/etc/caddy/apps/filemanager.conf"
TMPFILES="/etc/tmpfiles.d/hestia-fm.conf"
: "${FILE_MANAGER_PORT:=8092}"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

[ "$(id -u)" = '0' ] || {
	echo "ERROR: h-add-sys-filemanager must be run as root"
	exit 10
}

[ -s "$FM_CODE_SRC/index.php" ] || {
	echo "ERROR: FM app code missing ($FM_CODE_SRC)"
	exit "$E_NOTEXIST"
}
front=$(fm_front)
[ -n "$front" ] || check_result "$E_DISABLED" "the file manager needs a customer web server, this box has none"

if [ -f "$FM_CODE_DIR/index.php" ] && [ -s "$FM_SECRET_FILE" ] && [ -f "$ROUTE" ]; then
	fm_refresh yes || check_result "$E_RESTART" "file manager refresh failed"
	echo "INFO: file manager is already installed, code and listeners refreshed."
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "[ * ] Installing file manager module..."

# Secret: Caddy proves it to the private listener; only root reads it (baked into
# the caddy config below), so caddy itself never needs to read the file.
if [ ! -s "$FM_SECRET_FILE" ]; then
	(umask 077 && openssl rand -hex 32 > "$FM_SECRET_FILE")
fi
chown root:root "$FM_SECRET_FILE"
chmod 600 "$FM_SECRET_FILE"
secret="$(cat "$FM_SECRET_FILE")"

$BIN/h-change-sys-config-value 'FILE_MANAGER_PORT' "$FILE_MANAGER_PORT"

# Runtime socket dir (tmpfs, recreated each boot)
cp -f "$HESTIA/share/tmpfiles.d/hestia-fm.conf" "$TMPFILES"
systemd-tmpfiles --create "$TMPFILES" > /dev/null 2>&1

# Code, catch-all and the listeners of customers that had it enabled before a prior uninstall.
fm_code_install || check_result "$E_NOTEXIST" "file manager code not installed"
fm_refresh yes || check_result "$E_RESTART" "$front restart failed"

# The route goes last: until it exists the module counts as not installed, so a re-run repeats every step.
# It carries the secret -> 0640 root:caddy.
mkdir -p /etc/caddy/apps
sed -e "s|%FILE_MANAGER_PORT%|$FILE_MANAGER_PORT|g" -e "s|%FM_SECRET%|$secret|g" \
	"$HESTIA/share/panel-caddy/apps/filemanager.tpl" > "$ROUTE"
chown root:caddy "$ROUTE"
chmod 640 "$ROUTE"
if ! $BIN/h-restart-service caddy > /dev/null 2>&1; then
	# Without the route the panel comes back as it was.
	rm -f "$ROUTE"
	$BIN/h-restart-service caddy > /dev/null 2>&1
	check_result "$E_RESTART" "caddy restart failed, file manager route withdrawn"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

echo "[ OK ] File manager installed."
$BIN/h-log-action "system" "Info" "Plugins" "File manager installed."
log_event "$OK" "$ARGUMENTS"
exit

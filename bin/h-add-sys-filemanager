#!/bin/bash
# info: install the web file manager
# options: NONE
#
# example: h-add-sys-filemanager
#
# Installs the file manager module (#419): deploys the shared read-only app code to
# /usr/share/filemanager/fm, generates the Caddy<->listener secret, adds the
# Panel-Caddy /fm/ forward_auth route + tmpfiles socket dir, and reactivates any
# saved per-user flags. Per customer, h-add-user-filemanager then adds a pool + vhost
# that run as that customer. Reverse: h-delete-sys-filemanager.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

CODE_SRC="$HESTIA/share/filemanager/fm"
CODE_DIR="/usr/share/filemanager/fm"
SECRET_FILE="/etc/hestia/conf/.filemanager.key"
ROUTE="/etc/caddy/apps/filemanager.conf"
TMPFILES="/etc/tmpfiles.d/hestia-fm.conf"
: "${FILE_MANAGER_PORT:=8092}"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

[ "$(id -u)" = '0' ] || {
	echo "ERROR: h-add-sys-filemanager must be run as root"
	exit 10
}

[ -s "$CODE_SRC/index.php" ] || {
	echo "ERROR: FM app code missing ($CODE_SRC)"
	exit "$E_NOTEXIST"
}

if [ -f "$CODE_DIR/index.php" ] && [ -s "$SECRET_FILE" ] && [ -f "$ROUTE" ]; then
	echo "INFO: file manager is already installed."
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "[ * ] Installing file manager module..."

# 1. Shared read-only app code — one copy for all customers, outside /home + backups
mkdir -p "$CODE_DIR"
cp -rf "$CODE_SRC/." "$CODE_DIR/"
chown -R root:root "$CODE_DIR"
find "$CODE_DIR" -type d -exec chmod 755 {} +
find "$CODE_DIR" -type f -exec chmod 644 {} +

# 2. Secret: Caddy proves it to the private listener; only root reads it (baked into
# the caddy config below), so caddy itself never needs to read the file.
if [ ! -s "$SECRET_FILE" ]; then
	(umask 077 && openssl rand -hex 32 > "$SECRET_FILE")
fi
chown root:root "$SECRET_FILE"
chmod 600 "$SECRET_FILE"
secret="$(cat "$SECRET_FILE")"

# 3. Port
$BIN/h-change-sys-config-value 'FILE_MANAGER_PORT' "$FILE_MANAGER_PORT"

# 4. Runtime socket dir (tmpfs, recreated each boot)
cp -f "$HESTIA/share/tmpfiles.d/hestia-fm.conf" "$TMPFILES"
systemd-tmpfiles --create "$TMPFILES" > /dev/null 2>&1

# 5. apache-only front needs a global Listen on the private port (nginx self-listens)
if ! { [ "$WEB_SYSTEM" = 'nginx' ] || [ "$PROXY_SYSTEM" = 'nginx' ]; }; then
	echo "Listen 127.0.0.1:$FILE_MANAGER_PORT" > /etc/apache2/conf.d/fm-listen.conf
	$BIN/h-restart-service apache2 > /dev/null 2>&1 || true
fi

# 6. Panel-Caddy /fm/ route (carries the secret -> 0640 root:caddy)
mkdir -p /etc/caddy/apps
sed -e "s|%FILE_MANAGER_PORT%|$FILE_MANAGER_PORT|g" -e "s|%FM_SECRET%|$secret|g" \
	"$HESTIA/share/panel-caddy/apps/filemanager.tpl" > "$ROUTE"
chown root:caddy "$ROUTE"
chmod 640 "$ROUTE"
$BIN/h-restart-service caddy > /dev/null 2>&1 || true

# 7. Saved state: reactivate customers that had it enabled before a prior uninstall.
# Batch the pools with no per-user webserver restart, then reload the front once.
for uconf in "$CONF_DIR"/users/*/user.conf; do
	[ -f "$uconf" ] || continue
	if grep -q "^FILE_MANAGER='yes'" "$uconf"; then
		u=$(basename "$(dirname "$uconf")")
		$BIN/h-add-user-filemanager "$u" no > /dev/null 2>&1 || true
	fi
done
$BIN/h-restart-service "${PROXY_SYSTEM:-$WEB_SYSTEM}" > /dev/null 2>&1 || true

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

echo "[ OK ] File manager installed."
$BIN/h-log-action "system" "Info" "Plugins" "File manager installed."
log_event "$OK" "$ARGUMENTS"
exit

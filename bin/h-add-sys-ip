#!/bin/bash
# info: add system IP address
# options: IP NETMASK [INTERFACE] [USER] [IP_STATUS] [IP_NAME] [NAT_IP]
#
# example: h-add-sys-ip 203.0.113.1 255.255.255.0
#
# Adds an IP to the box, its network config and the panel. IP_NAME is the root of temporary aliases:
# a domain on the IP also answers as <domain>.<IP_NAME>, given a wildcard record for it.

# ip46 selects the validator (dispatch is by variable name); $ip aliased for the ip.sh helpers
ip46="${1// /}"
ip="$ip46"
netmask="$2"

iface="$(ip -d -j addr show | jq --arg IP "$ip46" -r '.[] | if .addr_info[].local == $IP then .ifname else empty end')"
# Else the default route of either family: a v6-only box has no v4 route. Same twin in h-delete-sys-ip.
if [ -z "$iface" ]; then
	iface="$(ip -d -j route show | jq -r '.[] | if .dst == "default" then .dev else empty end')"
fi
if [ -z "$iface" ]; then
	iface="$(ip -6 -d -j route show | jq -r '.[] | if .dst == "default" then .dev else empty end')"
fi

# :- not -: an EMPTY third argument (h-update-sys-ip passes jq output) must fall back
iface="${3:-$iface}"
ip_status="${5-shared}"
ip_name="$6"
nat_ip="$7"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/web-model.sh
source $HESTIA/include/web-model.sh
source_conf "$HESTIA/conf/hestia.conf"

# Bound after the includes: main.sh refuses a $user that is set but empty, and USER is optional here.
user="${4:-$ROOT_USER}"

check_args '2' "$#" 'IP NETMASK [INTERFACE] [USER] [IP_STATUS] [IP_NAME] [NAT_IP]'
is_format_valid 'ip46' 'iface' 'user' 'ip_status'
family=$(ip_family "$ip46")
if [ "$family" = 6 ]; then
	ip46=$(ip6_canonical "$ip46") || check_result "$E_INVALID" "cannot canonicalise the v6 address - the panel php backend did not answer"
	ip="$ip46"
	# NETMASK carries the prefix length for v6; a dotted netmask has no v6 meaning
	if ! [[ "$netmask" =~ ^[0-9]{1,3}$ ]] || [ "$netmask" -gt 128 ]; then
		check_result "$E_INVALID" "a v6 address takes a prefix length (0-128), not a netmask"
	fi
else
	is_format_valid 'netmask'
fi
is_ip_free
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
if [ -n "$ip_name" ]; then
	is_format_valid 'ip_name'
fi
if [ -n "$nat_ip" ]; then
	[ "$family" = 6 ] && check_result "$E_INVALID" "NAT is an IPv4 concept - a v6 IP cannot carry a NAT address"
	is_format_valid 'nat_ip'
fi
if [ "$user" != "$ROOT_USER" ]; then
	ip_status="dedicated"
fi

if [ "$family" = 6 ]; then
	cidr="$netmask"
else
	cidr="$(convert_netmask "$netmask")"
	broadcast="$(get_broadcast "$ip" "$netmask")"
fi

# jq exact match, not grep -w: colons are word boundaries, so a longer v6 with the same prefix matched.
sys_ip_check="$(ip -j addr show | jq --arg IP "$ip" -r '.[].addr_info[] | select(.local == $IP) | .local' 2> /dev/null | head -1)"
if [ -z "$sys_ip_check" ]; then
	# v6 knows neither broadcast nor labels. A failed add stops before record, render and restart.
	if [ "$family" = 6 ]; then
		ip -6 addr add "$ip/$cidr" dev "$iface" \
			|| check_result "$E_INVALID" "cannot add $ip/$cidr on $iface - nothing was written"
		# DAD: a bind() fails while the address is tentative, and the web restart below binds it. Bounded wait.
		for _i in $(seq 1 10); do
			ip -6 -j addr show dev "$iface" 2> /dev/null | grep -q '"tentative"' || break
			sleep 0.5
		done
		# dadfailed is permanent (another host answers), tentative after 5 s only slow: both go on, each said.
		if ip -6 -j addr show dev "$iface" 2> /dev/null | grep -q '"dadfailed"'; then
			echo "Warning: duplicate address detection FAILED for $ip - another host answers for it; web listeners will not bind until that is resolved" >&2
		elif ip -6 -j addr show dev "$iface" 2> /dev/null | grep -q '"tentative"'; then
			echo "Warning: $ip still tentative after 5s - the web restart below may race the bind" >&2
		fi
	else
		ip addr add "$ip/$cidr" dev "$iface" broadcast "$broadcast" label "$iface" \
			|| check_result "$E_INVALID" "cannot add $ip/$cidr on $iface - nothing was written"
	fi

	if [ -n "$(netplan generate --mapping "$iface" 2> /dev/null | grep networkd)" ]; then
		netplan="true"
	else
		netplan="false"
	fi

	if [ "$netplan" = "true" ]; then
		netplan_file="/etc/netplan/60-hestia.yaml"
		if [ -f "$netplan_file" ]; then
			netplan_file_exists="true"
		else
			netplan_file_exists="false"
			install -m 600 /dev/null "$netplan_file"
		fi

		if [ "$netplan_file_exists" = "true" ]; then
			sys_ip="        - $ip/$cidr"
		else
			sys_ip="# Added by Hestia, please do not edit the file manually!"
			sys_ip="$sys_ip\nnetwork:"
			sys_ip="$sys_ip\n  version: 2"
			sys_ip="$sys_ip\n  renderer: networkd"
			sys_ip="$sys_ip\n  ethernets:"
			sys_ip="$sys_ip\n    $iface:"
			sys_ip="$sys_ip\n      addresses:"
			sys_ip="$sys_ip\n        - $ip/$cidr"
		fi
		echo -e "$sys_ip" >> "$netplan_file"
	else
		sys_ip="\n# Added by Hestia Control Panel"
		sys_ip="$sys_ip\nauto $iface"
		if [ "$family" = 6 ]; then
			sys_ip="$sys_ip\niface $iface inet6 static"
			sys_ip="$sys_ip\naddress $ip/$cidr"
		else
			sys_ip="$sys_ip\niface $iface inet static"
			sys_ip="$sys_ip\naddress $ip"
			sys_ip="$sys_ip\nnetmask $netmask"
		fi
		echo -e "$sys_ip" >> /etc/network/interfaces
	fi
fi

new_timestamp

echo "OWNER='$user'
STATUS='$ip_status'
NAME='$ip_name'
U_SYS_USERS=''
U_WEB_DOMAINS='0'
INTERFACE='$iface'
NETMASK='$netmask'
NAT='$nat_ip'
TIME='$time'
DATE='$date'" > $CONF_DIR/ips/$ip
chmod 660 $CONF_DIR/ips/$ip

# Both families: the renderer brackets v6 itself.
rebuild_ip_web_config "$ip"

apache_remoteip_refresh

# The proftpd drop-in derives from the records (first NAT), so a record carrying one changes it.
if [ -n "$nat_ip" ] && [ -n "$FTP_SYSTEM" ]; then
	proftpd_nat_apply
	$BIN/h-restart-ftp
fi

increase_user_value "$user" '$IP_OWNED'
if [ "$user" = $ROOT_USER ]; then
	if [ "$ip_status" = 'shared' ]; then
		for hestia_user in $("$BIN/h-list-users" list); do
			increase_user_value "$hestia_user" '$IP_AVAIL'
		done
	else
		increase_user_value $ROOT_USER '$IP_AVAIL'
	fi
else
	increase_user_value "$user" '$IP_AVAIL'
	increase_user_value $ROOT_USER '$IP_AVAIL'
fi

$BIN/h-restart-web
check_result $? "Web restart failed" > /dev/null

if [ -n "$PROXY_SYSTEM" ]; then
	$BIN/h-restart-proxy
	check_result $? "Proxy restart failed" > /dev/null
fi

if [ -n "$FIREWALL_SYSTEM" ]; then
	$BIN/h-update-firewall
fi

$BIN/h-log-action "system" "Info" "Network" "Added new IP address to the system (IP: $ip)."
log_event "$OK" "$ARGUMENTS"

exit

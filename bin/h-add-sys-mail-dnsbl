#!/bin/bash
# info: add a dnsbl host for exim to check
# options: HOST [RESTART]
#
# example: h-add-sys-mail-dnsbl zen.spamhaus.org
#
# Adds a DNSBL zone to the list exim checks incoming mail against, optionally with exim's != result filter.

host=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

# Edited in place, no shadow copy: exim4.conf.template reads this path per message, a second master would need a sync.
DNSBL_CONF="/etc/exim4/dnsbl.conf"

check_args '1' "$#" 'HOST [RESTART]'
# Host with an optional "!=" filter; anything else lands in exim's colon-joined dnslists as a broken ACL.
# Spelled out: under a German locale a-z matches umlauts.
an='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
if [[ ! "$host" =~ ^[$an]([$an.-]*[$an])?(!=[0123456789.,]+)?$ ]]; then
	check_result "$E_INVALID" "invalid dnsbl host format :: $host"
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'

touch "$DNSBL_CONF"
if grep -qxF -- "$host" "$DNSBL_CONF"; then
	check_result "$E_EXISTS" "dnsbl host $host already exists"
fi

# A hand-edited file without a final newline would glue the new host onto the last one.
[ ! -s "$DNSBL_CONF" ] || [ -z "$(tail -c1 "$DNSBL_CONF")" ] || echo >> "$DNSBL_CONF"
echo "$host" >> "$DNSBL_CONF"
chmod 644 "$DNSBL_CONF"

"$BIN/h-log-action" "system" "Info" "Mail" "DNSBL host added (Host: $host)."
log_event "$OK" "$ARGUMENTS"

# No restart, RESTART stays only for the signature: exim reads the list for every message.

exit

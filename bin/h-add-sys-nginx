#!/bin/bash
# info: add the nginx web server (move the web model toward nginx)
# options: [MODE] [--purge] [--force] [--recover]
#
# example: h-add-sys-nginx yes
#
# Entry point to the web-model switch in include/web-model.sh: the model follows from the resulting component set.
# Without MODE 'yes' it only previews.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/web-model.sh
source $HESTIA/include/web-model.sh
source_conf "$HESTIA/conf/hestia.conf"

web_component_main add nginx "$@"
exit

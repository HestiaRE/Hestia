#!/bin/bash
# info: Install phpMyAdmin database administration tool
# options: NONE
#
# Installs phpMyAdmin from the OS package with its configuration storage database, served by Panel-Caddy.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

PMA_CONFIG="/etc/phpmyadmin"

if [ "$(id -u)" != '0' ]; then
	echo "ERROR: h-add-sys-phpmyadmin must be run as root"
	exit 10
fi

if [ -z "$HESTIA" ]; then HESTIA="/usr/local/hestia"; fi

if ! echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	echo "ERROR: MySQL not available. Installation aborted."
	exit 2
fi

if [ -f "$PMA_CONFIG/config-db.php" ] && [ -f "/var/lib/phpmyadmin/blowfish_secret.inc.php" ]; then
	echo "INFO: phpMyAdmin is already installed and configured."
	exit 0
fi

# keep dbconfig-common out: it would prompt, and the storage database is set up below
echo "phpmyadmin phpmyadmin/dbconfig-install boolean false" \
	| debconf-set-selections

# The php-* metas resolve to libapache2-mod-phpX on some targets, dragging in apache2, which takes *:80 from nginx.
# Refused only where absent: apache2- would REMOVE a real one.
pma_no_apache=""
if ! dpkg-query -W -f='${Status}' apache2 2> /dev/null | grep -q "install ok installed"; then
	pma_no_apache="apache2-"
fi
# No recommends: they pull the newest Sury PHP onto a box that runs none of it. php-tcpdf is the PDF export.
# shellcheck disable=SC2086  # deliberately unquoted: empty must expand to no argument at all
DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends install phpmyadmin php-tcpdf $pma_no_apache \
	|| check_result "$E_UPDATE" "apt could not install phpmyadmin"

blowfish="$(openssl rand -base64 32 | tr -d '/+=' | cut -c1-32)"
mkdir -p /var/lib/phpmyadmin
cat > /var/lib/phpmyadmin/blowfish_secret.inc.php << 'PHP'
<?php
$cfg['blowfish_secret'] = '_BLOWFISH_';
PHP
sed -i "s/_BLOWFISH_/$blowfish/" /var/lib/phpmyadmin/blowfish_secret.inc.php
chmod 640 /var/lib/phpmyadmin/blowfish_secret.inc.php
chown root:caddy /var/lib/phpmyadmin/blowfish_secret.inc.php

mkdir -p /var/lib/phpmyadmin/tmp
chown caddy:caddy /var/lib/phpmyadmin/tmp
chmod 770 /var/lib/phpmyadmin/tmp

dbpass=$(generate_password)
db_client="mysql"
[ -x /usr/bin/mariadb ] && db_client="mariadb"

# a phpmyadmin database this install did not create belongs to someone else
if $db_client -e "SHOW DATABASES LIKE 'phpmyadmin'" 2> /dev/null | grep -q 'phpmyadmin'; then
	echo "ERROR: Database 'phpmyadmin' already exists but is not managed by this HestiaRE instance."
	echo "       Remove it manually first, or run h-delete-sys-phpmyadmin if it was a previous install."
	exit 1
fi

$db_client -e "CREATE DATABASE IF NOT EXISTS \`phpmyadmin\` DEFAULT CHARACTER SET utf8 COLLATE utf8_bin" \
	|| {
		echo "ERROR: Failed to create phpmyadmin database"
		exit 1
	}
$db_client <<< "CREATE USER IF NOT EXISTS 'pma'@'localhost' IDENTIFIED BY '$dbpass'" \
	|| {
		echo "ERROR: Failed to create pma database user"
		exit 1
	}
$db_client -e "GRANT ALL ON \`phpmyadmin\`.* TO 'pma'@'localhost'" \
	|| {
		echo "ERROR: Failed to grant pma privileges"
		exit 1
	}
$db_client -e "FLUSH PRIVILEGES"
$db_client phpmyadmin < /usr/share/phpmyadmin/sql/create_tables.sql \
	|| {
		echo "ERROR: Failed to initialize phpMyAdmin config storage schema"
		exit 1
	}

# the OS config.inc.php reads it for the configuration storage
mkdir -p "$PMA_CONFIG"
cat > "$PMA_CONFIG/config-db.php" << 'PHP'
<?php
$dbserver='localhost';
$dbport='';
$dbname='phpmyadmin';
$dbuser='pma';
$dbpass='_PMAPASS_';
PHP
sed -i "s/_PMAPASS_/$dbpass/" "$PMA_CONFIG/config-db.php"
chmod 640 "$PMA_CONFIG/config-db.php"
chown root:caddy "$PMA_CONFIG/config-db.php"

# h-add-sys-pma-sso writes its include here
mkdir -p "$PMA_CONFIG/conf.d"
chmod 750 "$PMA_CONFIG/conf.d"
chown root:caddy "$PMA_CONFIG/conf.d"

if ! grep -q "^DB_PMA_ALIAS=" "$HESTIA/conf/hestia.conf"; then
	$BIN/h-change-sys-config-value 'DB_PMA_ALIAS' 'phpmyadmin'
fi

cp -f "$HESTIA/share/panel-php/pool.d/phpmyadmin.conf" /etc/php/hestia/fpm/pool.d/phpmyadmin.conf
systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true
$BIN/h-change-sys-db-alias pma "${DB_PMA_ALIAS:-phpmyadmin}" > /dev/null 2>&1 || true

$BIN/h-log-action "system" "Info" "Plugins" "phpMyAdmin installed (OS package)."
log_event "$OK" "$ARGUMENTS"

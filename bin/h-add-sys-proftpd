#!/bin/bash
# info: install ProFTPD FTP server
# options: NONE
#
# example: h-add-sys-proftpd
#
# Installs proftpd with the curated config from share/proftpd, opens the FTP rule and registers FTP_SYSTEM.
# Re-running repairs a partial install.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-proftpd can only be executed by the root user"
	exit 10
fi

if [ -z "$HESTIA" ]; then HESTIA="/usr/local/hestia"; fi

# Installed = package, key and a running daemon: a package without our config, or a run that died, is not one.
if dpkg -l proftpd-core 2> /dev/null | grep -q '^ii' && [ "$FTP_SYSTEM" = 'proftpd' ] \
	&& systemctl is-active --quiet proftpd; then
	echo "INFO: ProFTPD is already installed."
	exit 0
fi

if [ -n "$FTP_SYSTEM" ] && [ "$FTP_SYSTEM" != 'proftpd' ]; then
	echo "ERROR: FTP_SYSTEM is already '$FTP_SYSTEM' — refusing to switch to proftpd."
	exit "$E_INVALID"
fi

# proftpd-basic exists on bookworm only, and from 1.3.9 mod_tls lives in mod-crypto: unnamed, FTPS silently goes.
proftpd_pkgs="proftpd-core proftpd-mod-vroot proftpd-mod-crypto"

echo "Installing ProFTPD ($proftpd_pkgs)..."
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq install $proftpd_pkgs > /dev/null 2>&1
if ! dpkg -l proftpd-core 2> /dev/null | grep -q '^ii'; then
	echo "ERROR: ProFTPD installation failed."
	exit "$E_INVALID"
fi

# The config test cannot see a missing mod_tls: it is IfModule-guarded.
if ! find /usr/lib -name 'mod_tls.so' 2> /dev/null | grep -q .; then
	echo "ERROR: mod_tls not installed — FTPS would be silently disabled."
	exit "$E_INVALID"
fi

cp -f "$HESTIA/share/proftpd/proftpd.conf" /etc/proftpd/proftpd.conf
cp -f "$HESTIA/share/proftpd/tls.conf" /etc/proftpd/tls.conf

# Ubuntu 26 enforces a profile that cannot read the panel certificate.
if [ -f /etc/apparmor.d/proftpd ]; then
	mkdir -p /etc/apparmor.d/local
	cp -f "$HESTIA/share/proftpd/apparmor-local" /etc/apparmor.d/local/proftpd
	apparmor_parser -r /etc/apparmor.d/proftpd > /dev/null 2>&1 || true
fi

# A NAT set before proftpd existed was never written for it.
proftpd_nat_apply

if ! proftpd -t > /tmp/hst-proftpd-test.log 2>&1; then
	echo "ERROR: proftpd config test failed after deploying the curated config:"
	tail -n 3 /tmp/hst-proftpd-test.log | sed 's/^/       /'
	rm -f /tmp/hst-proftpd-test.log
	exit "$E_INVALID"
fi
rm -f /tmp/hst-proftpd-test.log

# The passive range comes from PassivePorts, never a second copy.
if [ -n "$FIREWALL_SYSTEM" ] && [ "$FIREWALL_SYSTEM" != 'no' ] && [ -f "$CONF_DIR/firewall/rules.conf" ]; then
	pp=$(awk '/^PassivePorts/{print $2"-"$3}' /etc/proftpd/proftpd.conf)
	if [ -n "$pp" ]; then
		fw_ports="21,$pp"
	else
		echo "WARN: no PassivePorts in proftpd.conf — opening control port 21 only."
		fw_ports="21"
	fi
	if ! grep -q "COMMENT='FTP'" "$CONF_DIR/firewall/rules.conf"; then
		$BIN/h-add-firewall-rule 'ACCEPT' '0.0.0.0/0' "$fw_ports" 'TCP' 'FTP' > /dev/null 2>&1
	fi
fi

systemctl enable proftpd > /dev/null 2>&1
systemctl restart proftpd

if ! systemctl is-active --quiet proftpd; then
	echo "ERROR: proftpd failed to start."
	exit "$E_RESTART"
fi

# Registered only once the daemon runs, so a failed run is not taken for an installation.
$BIN/h-change-sys-config-value 'FTP_SYSTEM' 'proftpd'

# The install prunes the FTP jail before proftpd exists. The log goes first, or the reload prunes it again.
if [ -n "$FIREWALL_EXTENSION" ] && [ -f "$HESTIA/include/fail2ban.sh" ]; then
	[ -e /var/log/proftpd/proftpd.log ] || {
		mkdir -p /var/log/proftpd
		touch /var/log/proftpd/proftpd.log
	}
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source "$HESTIA/include/fail2ban.sh"
	fail2ban_rearm_jail proftpd-iptables
fi

echo "ProFTPD is now installed."

$BIN/h-log-action "system" "Info" "System" "Installed ProFTPD FTP server."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: install restic for the incremental backup mode
# options: NONE
#
# example: h-add-sys-restic
#
# Installs the distribution's restic package. The version is whatever the OS ships (0.14 to
# 0.18 across the four targets); capabilities are asked from the binary, never derived from
# the number, and nothing here ever replaces a package-owned file.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '0' "$#" 'NONE'

if ! dpkg -l restic 2> /dev/null | grep -q '^ii'; then
	echo "[ * ] Installing restic..."
	DEBIAN_FRONTEND=noninteractive apt-get -y -qq install restic > /dev/null 2>&1
fi

# The package can be present while the binary is broken or diverted: ask the binary.
if ! restic version > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "restic is not runnable after the install"
fi
restic_version=$(restic version 2>&1 | awk '{print $2}' | head -1)

# Status of the addon only; a configured repository is BACKUP_INCREMENTAL, not this key.
change_sys_value "RESTIC_SYSTEM" "restic"
echo "restic $restic_version is installed - configure a repository with h-add-backup-host-restic"
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: Install Roundcube webmail client
# options: NONE
#
# This function installs Roundcube from OS repositories, sets up a
# dedicated MySQL database, deploys the HestiaRE password driver, and
# configures panel integration.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
source_conf "$HESTIA/conf/hestia.conf"

RC_CONFIG_DIR="/etc/roundcube"
RC_DRIVERS_DIR="/usr/share/roundcube/plugins/password/drivers"

if [ "$(id -u)" != '0' ]; then
	echo "ERROR: h-add-sys-roundcube must be run as root"
	exit 10
fi

# Decided once, recorded in config.inc.php: a MariaDB added later never flips it, switching means reinstalling.
RC_DB_BACKEND="sqlite"
RC_DB_PKG="roundcube-sqlite3"
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	RC_DB_BACKEND="mysql"
	RC_DB_PKG="roundcube-mysql"
else
	echo "NOTE: no MySQL/MariaDB on this box - Roundcube uses the SQLite backend"
fi

# Keyed on the pool conf, written last and only by this command: the OS package ships a config.inc.php of its own.
if echo "$WEBMAIL_SYSTEM" | grep -qw 'roundcube' \
	&& [ -f /etc/php/hestia/fpm/pool.d/roundcube.conf ]; then
	echo "INFO: Roundcube is already installed and configured."
	exit 0
fi

# dbconfig-common must not set up a database of its own.
echo "roundcube-core roundcube/dbconfig-install boolean false" \
	| debconf-set-selections

# No recommends: enchant never loads in the panel pool, and classic/larry are skins nobody selects.
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y --no-install-recommends install \
	roundcube "$RC_DB_PKG" roundcube-plugins || {
	echo "ERROR: Roundcube packages did not install"
	exit 1
}

if [ "$RC_DB_BACKEND" = "mysql" ]; then
	dbpass=$(generate_password)
	db_client="mysql"
	[ -x /usr/bin/mariadb ] && db_client="mariadb"

	# A 'roundcube' DB with tables is someone's data; an empty one is what an aborted run leaves, and is reused.
	rc_tables=$($db_client -N -e \
		"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='roundcube'" 2> /dev/null)
	if [ "${rc_tables:-0}" != 0 ]; then
		echo "ERROR: Database 'roundcube' already exists and holds tables, it is not reused."
		echo "       Remove it manually first, or run h-delete-sys-roundcube if it was a previous install."
		exit 1
	fi

	$db_client -e "CREATE DATABASE IF NOT EXISTS \`roundcube\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" \
		|| {
			echo "ERROR: Failed to create roundcube database"
			exit 1
		}
	# ALTER as well: a user left from an earlier install would otherwise keep its old password.
	$db_client -e "CREATE USER IF NOT EXISTS 'roundcube'@'localhost' IDENTIFIED BY '$dbpass';
		ALTER USER 'roundcube'@'localhost' IDENTIFIED BY '$dbpass'" \
		|| {
			echo "ERROR: Failed to create roundcube database user"
			exit 1
		}
	$db_client -e "GRANT ALL ON \`roundcube\`.* TO 'roundcube'@'localhost'" \
		|| {
			echo "ERROR: Failed to grant roundcube database privileges"
			exit 1
		}
	$db_client -e "FLUSH PRIVILEGES"
	$db_client roundcube < /usr/share/roundcube/SQL/mysql.initial.sql \
		|| {
			echo "ERROR: Failed to initialize roundcube database schema"
			exit 1
		}

	# roundcube-core reads the DSN from here through debian-db-roundcube.php.
	cat > "$RC_CONFIG_DIR/debian-db.php" << 'PHP'
<?php
$dbtype='mysql';
$dbserver='localhost';
$dbport='';
$dbname='roundcube';
$dbuser='roundcube';
$dbpass='_RCPASS_';
$basepath='/var/lib/roundcube';
?>
PHP
	sed -i "s/_RCPASS_/$dbpass/" "$RC_CONFIG_DIR/debian-db.php"
	chmod 640 "$RC_CONFIG_DIR/debian-db.php"
	chown root:caddy "$RC_CONFIG_DIR/debian-db.php"
else
	# The seed below and the serving pool both need pdo_sqlite.
	ensure_panel_sqlite_driver \
		|| {
			echo "ERROR: panel PHP lacks the sqlite driver (php-sqlite3 for the pinned version)"
			exit 1
		}
	# The directory, not just the file: sqlite writes its journal next to the database.
	mkdir -p /var/lib/roundcube/db
	chown caddy:caddy /var/lib/roundcube/db
	chmod 750 /var/lib/roundcube/db
	# Seeded now with the pool's PHP and ini chain, so a broken chain fails the install and not the first visit.
	if [ ! -s /etc/php/hestia/php-version ]; then
		echo "ERROR: no pinned panel PHP (/etc/php/hestia/php-version) - is the panel stage done?"
		exit 1
	fi
	panel_php="php$(cat /etc/php/hestia/php-version)"
	runuser -u caddy -- env PHP_INI_SCAN_DIR=/etc/php/hestia/fpm/conf.d "$panel_php" -r '
		$pdo = new PDO("sqlite:/var/lib/roundcube/db/roundcube.db");
		$pdo->exec(file_get_contents("/usr/share/roundcube/SQL/sqlite.initial.sql"));
		$n = $pdo->query("SELECT count(*) FROM sqlite_master")->fetchColumn();
		if ($n < 1) { fwrite(STDERR, "no schema objects after import\n"); exit(1); }
		echo "roundcube sqlite schema: $n objects\n";
	' || {
		echo "ERROR: Failed to initialize roundcube sqlite schema"
		exit 1
	}
	chmod 640 /var/lib/roundcube/db/roundcube.db
fi

des_key="$(openssl rand -base64 30 | tr -d '/' | cut -c1-24)"
if [ "$RC_DB_BACKEND" = "mysql" ]; then
	cat > "$RC_CONFIG_DIR/config.inc.php" << 'PHP'
<?php
// DB connection via Debian package mechanism (/etc/roundcube/debian-db.php)
include('/etc/roundcube/debian-db-roundcube.php');
PHP
else
	cat > "$RC_CONFIG_DIR/config.inc.php" << 'PHP'
<?php
// SQLite backend (no MariaDB on the box when Roundcube was installed). This line IS the
// recorded backend decision - a later MariaDB install must never rewrite it (#584).
$config['db_dsnw'] = 'sqlite:////var/lib/roundcube/db/roundcube.db?mode=0640';
PHP
fi
cat >> "$RC_CONFIG_DIR/config.inc.php" << 'PHP'

$config['imap_host'] = 'localhost:143';
$config['smtp_host'] = 'localhost:587';
$config['des_key'] = '_DES_KEY_';
$config['max_recipients'] = 100;
$config['log_dir'] = '/var/log/roundcube/';
$config['smtp_log'] = false;
$config['log_session'] = true;
// Log failed logins to /var/log/roundcube/userlogins for the fail2ban webmail jail. remote_ip() reports
// the socket peer (the panel-Caddy hop, 127.0.0.1) plus an "X-Real-IP: <client>" annotation only when the
// proxy is trusted - so 127.0.0.1 must be whitelisted or the real client never appears in the log line.
$config['log_logins'] = true;
$config['proxy_whitelist'] = ['127.0.0.1'];
$config['imap_conn_options'] = ['ssl' => [
	'verify_peer' => false,
	'verify_peer_name' => false,
	'cafile' => '/etc/ssl/certs/ca-certificates.crt',
]];
$config['smtp_conn_options'] = ['ssl' => [
	'verify_peer' => false,
	'verify_peer_name' => false,
	'cafile' => '/etc/ssl/certs/ca-certificates.crt',
]];
PHP
# From the shared derivation, not the heredoc: the sieve commands rewrite this very line later.
printf "\$config['plugins'] = [%s];\n" "$(webmail_roundcube_plugins)" >> "$RC_CONFIG_DIR/config.inc.php"
sed -i "s/_DES_KEY_/$des_key/" "$RC_CONFIG_DIR/config.inc.php"
# 640: the des_key encrypts the IMAP credentials in the session cookie, shell customers must not read it.
chmod 640 "$RC_CONFIG_DIR/config.inc.php"
chown root:caddy "$RC_CONFIG_DIR/config.inc.php"

# Extra files in apt-managed dirs survive upgrades: dpkg only removes files it installed.
cp -f "$HESTIA/share/roundcube/hestia.php" "$RC_DRIVERS_DIR/hestia.php"
chmod 644 "$RC_DRIVERS_DIR/hestia.php"

# The OS package symlinks this into the plugin directory.
cat > "$RC_CONFIG_DIR/plugins/password/config.inc.php" << 'PHP'
<?php
$config['password_driver'] = 'hestia';
$config['password_confirm_current'] = true;
$config['password_minimum_length'] = 8;
$config['password_log'] = false;
$config['password_hestia_host'] = 'localhost';
PHP
# The panel may have moved off 8083 before this (re)install; h-change-sys-port rewrites this line later.
printf "\$config['password_hestia_port'] = '%s';\n" "${BACKEND_PORT:-8083}" \
	>> "$RC_CONFIG_DIR/plugins/password/config.inc.php"
chmod 644 "$RC_CONFIG_DIR/plugins/password/config.inc.php"
chown root:caddy "$RC_CONFIG_DIR/plugins/password/config.inc.php"

cp -f "$HESTIA/share/roundcube/plugins/config_newmail_notifier.inc.php" \
	"/usr/share/roundcube/plugins/newmail_notifier/config.inc.php"
cp -f "$HESTIA/share/roundcube/plugins/config_zipdownload.inc.php" \
	"/usr/share/roundcube/plugins/zipdownload/config.inc.php"

# The packaged gc and cleandb timers run as www-data, which owns none of our caddy-held state.
# The cron.d fallback lines stay as shipped: they are no-ops wherever PID1 is systemd, i.e. on every target.
mkdir -p /etc/systemd/system/roundcube-gc.service.d /etc/systemd/system/roundcube-cleandb.service.d
cp -f "$HESTIA/share/roundcube/systemd-caddy.conf" /etc/systemd/system/roundcube-gc.service.d/hestia.conf
cp -f "$HESTIA/share/roundcube/systemd-caddy.conf" /etc/systemd/system/roundcube-cleandb.service.d/hestia.conf
# The drop-in adds this scan dir for both units (PHP 8.5 compat, see the ini).
mkdir -p /etc/php/hestia/roundcube-cli
cp -f "$HESTIA/share/roundcube/cli-php85-compat.ini" /etc/php/hestia/roundcube-cli/95-hestia-roundcube.ini
systemctl daemon-reload

mkdir -p /var/log/roundcube
chown caddy:caddy /var/log/roundcube
chmod 750 /var/log/roundcube
# The fail2ban roundcube-auth jail tails userlogins, so the log must rotate.
# Diverted, as logrotate fails on a path in two files; the target sits outside logrotate.d, which reads any suffix.
if ! dpkg-divert --list /etc/logrotate.d/roundcube-core | grep -q 'roundcube-core'; then
	mkdir -p "$CONF_DIR/diverted"
	dpkg-divert --quiet --local --rename \
		--divert "$CONF_DIR/diverted/roundcube-core.logrotate" \
		--add /etc/logrotate.d/roundcube-core
fi
cp -f "$HESTIA/share/roundcube/logrotate" /etc/logrotate.d/roundcube

# Debian ships temp/ www-data-owned, the caddy pool needs it. Loud: a swallowed chown breaks the first upload.
mkdir -p /var/lib/roundcube/temp
chown caddy:caddy /var/lib/roundcube/temp || {
	echo "ERROR: cannot chown roundcube temp dir"
	exit 1
}
cp -f "$HESTIA/share/panel-php/pool.d/roundcube.conf" /etc/php/hestia/fpm/pool.d/roundcube.conf
systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true
cp -f "$HESTIA/share/panel-caddy/webmail-roundcube.conf" /etc/caddy/webmail-roundcube.conf
# The :8083/webmail admin route is Roundcube-only: Tachyon is root-mounted and cannot run under a sub-path.
mkdir -p /etc/caddy/apps
cp -f "$HESTIA/share/panel-caddy/apps/webmail.tpl" /etc/caddy/apps/webmail.conf
systemctl try-restart caddy > /dev/null 2>&1 || true

# No prepend: the position in the key carries no meaning, the default follows WEBMAIL_KNOWN_CLIENTS order.
sys_key_token_set WEBMAIL_SYSTEM add roundcube > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record roundcube"

# A domain recorded with roundcube rendered the 'disabled' vhost while the client was missing.
$BIN/h-update-mail-templates yes > /dev/null 2>&1 \
	|| echo "Warning: not every mail domain was re-rendered, h-update-mail-templates names them."

$BIN/h-log-action "system" "Info" "Plugins" "Roundcube installed (OS package)."
# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

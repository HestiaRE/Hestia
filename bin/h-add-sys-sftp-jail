#!/bin/bash
# info: add system sftp jail
# options: [RESTART]
#
# example: h-add-sys-sftp-jail yes
#
# Installs the pam_namespace SFTP jail: mountpoint, iscript, namespace.conf, the PAM group gate and one
# Match Group sftp-jailed block. Idempotent; the installer calls it too.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

restart=$1

config='/etc/ssh/sshd_config'
pam='/etc/pam.d/sshd'
nsconf='/etc/security/namespace.conf'
nsdir='/etc/security/namespace.d'
nsinit="$nsdir/hestia-jail.init"

getent group sftp-jailed > /dev/null 2>&1 || groupadd sftp-jailed

cp -f "$HESTIA/share/tmpfiles.d/hestia-jail.conf" /etc/tmpfiles.d/hestia-jail.conf
systemd-tmpfiles --create /etc/tmpfiles.d/hestia-jail.conf > /dev/null 2>&1

mkdir -p "$nsdir"
cp -f "$HESTIA/share/security/hestia-jail.init" "$nsinit"
chmod 755 "$nsinit"

# Field 4 blank: the PAM stack already scopes to the group.
nsline="/run/hestia/jail   /run/hestia/jail-inst/   tmpfs:mntopts=size=1M,nosuid,nodev,noexec:iscript=hestia-jail.init"
if ! grep -q '^/run/hestia/jail[[:space:]]' "$nsconf" 2> /dev/null; then
	echo "$nsline" >> "$nsconf"
fi

# success=1 skips pam_namespace for anyone outside the group, so the two lines must stay adjacent.
if ! grep -qE '^[[:space:]]*session[[:space:]].*pam_namespace\.so' "$pam" 2> /dev/null; then
	{
		echo ""
		echo "# HestiaRE SFTP jail (#413): run pam_namespace only for the sftp-jailed group"
		echo "session [success=1 default=ignore] pam_succeed_if.so quiet user notingroup sftp-jailed"
		echo "session required     pam_namespace.so"
	} >> "$pam"
fi

# The Subsystem line, from the one place that decides it.
changed=''
[ "$(jail_sshd_subsystem_apply)" = changed ] && changed='yes'

# Our block is the marker, one Match line and its indented lines; whatever follows is the admin's and stays.
# Built and checked in a copy, so a refused config never becomes the live one.
tmp=$(mktemp "$config.hst-XXXXXX") || check_result "$E_DISK" "no temp file next to $config"
awk '
	held && !/^# Hestia SFTP Chroot$/ { print ""; held=0 }
	/^$/ && !held && !skip { held=1; next }
	/^# Hestia SFTP Chroot$/ { skip=1; seen=0; held=0; next }
	skip && /^Match / && !seen { seen=1; next }
	skip && /^[[:space:]]/ { next }
	skip { skip=0 }
	{ print }
	END { if (held) print "" }
' "$config" > "$tmp"
{
	echo ""
	echo "# Hestia SFTP Chroot"
	echo "Match Group sftp-jailed"
	echo "    ChrootDirectory /run/hestia/jail/%u"
	echo "    X11Forwarding no"
	echo "    AllowTCPForwarding no"
	echo "    ForceCommand internal-sftp"
} >> "$tmp"

# A refused config mails root and never goes live: sshd must stay restartable.
subj="OpenSSH restart failed"
email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf" 2> /dev/null | cut -f 2 -d \')
if ! /usr/sbin/sshd -t -f "$tmp" > /dev/null 2>&1; then
	mail_text="The SFTP jail was not written, OpenSSH would refuse the config:
            \n\n$(/usr/sbin/sshd -t -f "$tmp" 2>&1)"
	rm -f "$tmp"
	[ -n "$email" ] && echo -e "$mail_text" | $SENDMAIL -s "$subj" $email
	echo "ERROR: sshd config invalid with the SFTP jail, left as it was."
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi
if cmp -s "$tmp" "$config"; then
	rm -f "$tmp"
else
	cat "$tmp" > "$config" && rm -f "$tmp"
	changed='yes'
fi

if [ "$changed" = 'yes' ] && [ "$restart" != 'no' ]; then
	service ssh restart > /dev/null 2>&1
fi

log_event "$OK" "$ARGUMENTS"

exit

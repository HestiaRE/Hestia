#!/bin/bash
# info: add sieve mail filtering (ManageSieve + delivery-time execution)
# options: NONE
#
# example: h-add-sys-sieve
#
# Installs dovecot-managesieved + dovecot-sieve: the version-specific sieve conf.d
# overlay enables sieve on port 4190 (localhost-only) and stores per-account
# scripts in the maildir. exim's SIEVE macro switches clean local delivery to
# dovecot-lda so scripts run at delivery; spam keeps the direct .Spam appendfile.
#
# QUIRK: sieve runs ONLY on non-spam mail — rspamd-tagged spam bypasses dovecot-lda
# and lands in .Spam directly, so customer sieve rules never see it (spam foldering
# is exim's job). Over-quota behaviour is identical on both paths (defer, not bounce)
# via quota_full_tempfail + return_fail_output.
# New h-* command — no v-* symlink.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_system_enabled "$IMAP_SYSTEM" 'IMAP_SYSTEM'

# Already at the target state, which for this component is presence: rc 0 and say so (E13, #945).
# The status key is part of the condition, so it already says yes.
if [ "$SIEVE_SYSTEM" = 'yes' ] && dpkg -l dovecot-managesieved 2> /dev/null | grep -q '^ii'; then
	echo "INFO: sieve is already installed."
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "Installing sieve (dovecot-managesieved, dovecot-sieve)..."
apt-get -y -qq install dovecot-managesieved dovecot-sieve > /dev/null 2>&1
if ! dpkg -l dovecot-managesieved 2> /dev/null | grep -q '^ii'; then
	echo "ERROR: sieve installation failed."
	exit "$E_INVALID"
fi

# version-specific overlay (2.3/2.4) replacing the package defaults
DOVECOT_VER=$(dovecot --version 2> /dev/null | cut -d. -f1,2 || echo "2.3")
if [ "$(printf '%s\n2.4' "$DOVECOT_VER" | sort -V | head -1)" = "2.4" ]; then
	DCDIR="$HESTIA/share/dovecot/2.4"
else
	DCDIR="$HESTIA/share/dovecot/2.3"
fi
cp -f "$DCDIR/sieve/"* /etc/dovecot/conf.d/
# global script dir referenced by the sieve config (pipe/global extensions)
mkdir -p /etc/dovecot/sieve

# IMAP-triggered learning. Collected rather than aborted: filters and vacation work without any of
# it, so a half-wired learner is a degradation and not a failure.
learn_failures=''
sieve_imap_plugin_add || learn_failures="$learn_failures$(printf '\n  the imap_sieve trigger')"
sieve_mail_group_add || learn_failures="$learn_failures$(printf '\n  the rspamd controller group')"
sieve_learn_install

systemctl restart dovecot
if ! systemctl is-active --quiet dovecot; then
	echo "ERROR: dovecot failed to restart with sieve enabled."
	exit "$E_RESTART"
fi

# Only now: the compiler asks the running dovecot (see sieve_learn_compile).
sieve_learn_compile || learn_failures="$learn_failures$(printf '\n  the learn scripts')"

# switch clean local delivery to dovecot-lda so sieve scripts run at delivery
sed -i 's/^#SIEVE = yes/SIEVE = yes/' /etc/exim4/exim4.conf.template
systemctl restart exim4
if ! systemctl is-active --quiet exim4; then
	echo "ERROR: exim4 failed to restart with sieve delivery enabled."
	exit "$E_RESTART"
fi

$BIN/h-change-sys-config-value 'SIEVE_SYSTEM' 'yes'

# Without this the only way in is a client that speaks ManageSieve itself - the panel has no screen.
webmail_sieve_apply

echo "sieve is now active (ManageSieve on 4190, filters and vacation in the webmail)."
# Into the exit code, not only the log: a caller reading the status must see the missing half (#746).
if [ -n "$learn_failures" ]; then
	check_result "$E_PARSING" "IMAP-triggered spam learning is NOT wired:$learn_failures"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "Installed sieve mail filtering."
log_event "$OK" "$ARGUMENTS"

exit

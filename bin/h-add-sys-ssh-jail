#!/bin/bash
# info: add system ssh jail
# options: NONE
#
# example: h-add-sys-ssh-jail
#
# This function enables ssh jailed environment.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Not installable without bubblewrap: say so, and leave no token behind. The installer puts bubblewrap in
# its base package set and calls this with || true, so the non-zero exit changes nothing there.
if [ ! -x /bin/bwrap ]; then
	echo "ERROR: bubblewrap (/bin/bwrap) is not installed, the SSH jail needs it."
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Move jailbash to /usr/sbin
if [ ! -x /usr/sbin/jailbash ]; then
	cp -f $HESTIA/share/bubblewrap/jailbash /usr/sbin/jailbash
	chmod +x /usr/sbin/jailbash

	# only install the apparmor profile is abi 4.0 is available
	if [ -f /etc/apparmor.d/abi/4.0 ]; then
		cp -f $HESTIA/share/bubblewrap/bwrap-userns-restrict /etc/apparmor.d/bwrap-userns-restrict
	fi

	service apparmor reload > /dev/null 2>&1
fi

# Register /usr/sbin/jailbash
if [ -z "$(grep ^/usr/sbin/jailbash /etc/shells)" ]; then
	echo "/usr/sbin/jailbash" >> /etc/shells
fi

# The Subsystem line, from the one place that decides it: the ssh jail needs the sftp-server binary so a
# jailbash user's sftp runs inside bwrap (#941). No status token any more, see h-add-sys-sftp-jail (#945).
[ "$(jail_sshd_subsystem_apply)" = changed ] && service ssh restart > /dev/null 2>&1

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

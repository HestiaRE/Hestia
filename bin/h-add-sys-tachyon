#!/bin/bash
# info: Install Tachyon webmail client
# options: [MODE]
#
# This function installs the Tachyon webmail client (the maintained SnappyMail fork,
# adopted in #584 after SnappyMail upstream went dormant).
#
# Source is the GitHub release for the version pinned in share/manifest.json: a pinned
# version is the only one we can verify.
#
# Fetched and verified before anything is removed - an unreachable source must not take an
# existing installation down with it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

tx_v=$(manifest_get '.software_versions.tachyon')

MODE=$1
UPDATE="no"
TX_FILE="tachyon-${tx_v}.tar.gz"

TX_URL="https://github.com/kimusan/Tachyon/releases/download/v${tx_v}/tachyon-${tx_v}.tar.gz"

# Folder paths
TX_INSTALL_DIR="/var/lib/tachyon"
TX_CONFIG_DIR="/etc/tachyon"
TX_LOG="/var/log/tachyon"

# fetch_release_asset carries the bound and the mirror fallback (include/main.sh). The tarball
# is pinned like the plugins: gzip -t passes on ANY valid gzip, and the mirror is a second host.
tx_fetch() {
	local dest="$1" sum
	sum=$(manifest_get '.software_versions.tachyon_sha256')
	[ -n "$sum" ] && [ "$sum" != "null" ] || return 1
	fetch_release_asset tachyon "$TX_URL" "$dest" || return 1
	gzip -t "$dest" 2> /dev/null || return 1
	echo "$sum  $dest" | sha256sum -c --quiet - 2> /dev/null || return 1
}

# Same fail-before-touch bar as the main tarball, plus a pinned sha256: change-password-hestia
# changes system passwords, so a swapped release asset must die here, not install. Never via
# Tachyon's own Repository - that fetches packages.json from the master branch, a moving address.
tx_fetch_plugin() {
	local name="$1" dest="$2" ver sum
	ver=$(manifest_get ".software_versions.tachyon_plugins[\"$name\"].version")
	sum=$(manifest_get ".software_versions.tachyon_plugins[\"$name\"].sha256")
	{ [ -n "$ver" ] && [ "$ver" != "null" ] && [ -n "$sum" ] && [ "$sum" != "null" ]; } || return 1
	fetch_release_asset tachyon \
		"https://github.com/kimusan/Tachyon/releases/download/v${tx_v}/${name}-${ver}.tgz" "$dest" || return 1
	echo "$sum  $dest" | sha256sum -c --quiet - 2> /dev/null || return 1
}

TX_PLUGINS="change-password change-password-hestia add-x-originating-ip-header"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-tachyon can only be executed by the root user"
	exit 10
fi

# Ensure that $HESTIA (/usr/local/hestia/) and other variables are valid.
if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

if [ -z "$HOMEDIR" ]; then
	echo "ERROR: Environment variables not present, installation aborted."
	exit 2
fi

# Contacts backend, decided ONCE here and recorded in Tachyon's own config (the artefact
# that every later path reads): MySQL when the box has it, otherwise Tachyon's shipped
# SQLite default. A MariaDB added later never flips an existing install - no silent
# contact-data migration; switching means reinstalling the webmailer (#584).
TX_DB_BACKEND="sqlite"
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	TX_DB_BACKEND="mysql"
else
	echo "NOTE: no MySQL/MariaDB on this box - Tachyon contacts use the SQLite backend"
	# fail here, not at the customer's first contacts write: the serving pool needs the driver
	ensure_panel_sqlite_driver \
		|| {
			echo "ERROR: panel PHP lacks the sqlite driver (php-sqlite3 for the pinned version)"
			exit 2
		}
fi

# Without it the release URL would resolve to .../download/v/tachyon-.tar.gz and 404.
if [ -z "$tx_v" ]; then
	echo "ERROR: no Tachyon version pinned in share/manifest.json. Installation aborted"
	exit 2
fi

# Get current version
if [ -f "/var/lib/tachyon/data/VERSION" ]; then
	version=$(cat $TX_INSTALL_DIR/data/VERSION)
	if [ "$version" == "$tx_v" ]; then
		# The one component whose target state is more than presence: the pin. Standing on it is success,
		# not failure (E13, #945). rc 2 here also meant "no pin", "download failed" and "no sqlite driver",
		# so the installer read a box that was exactly right as a failed install and said so on every re-run.
		# The key writer sits further down, past this exit, so it is done here: a box that has Tachyon and
		# not the token gets it now (the 1b build rule).
		echo "INFO: Tachyon $version is already installed and matches the pinned version."
		sys_key_token_set WEBMAIL_SYSTEM add tachyon > /dev/null \
			|| check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record tachyon"
		exit 0
	else
		UPDATE="yes"
	fi
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$UPDATE" == "no" ]; then
	# Fetched before the removals below: a dead source must not cost the running install.
	tx_tmp="$(mktemp -t tachyon.XXXXXX.tar.gz)"
	if ! tx_fetch "$tx_tmp"; then
		rm -f "$tx_tmp"
		echo "ERROR: could not download Tachyon $tx_v from $TX_URL"
		echo "       Installation aborted - nothing was changed."
		exit 2
	fi

	# Plugins under the same rule: all fetched and verified before anything is removed.
	declare -A tx_plugin_tmp
	for p in $TX_PLUGINS; do
		tx_plugin_tmp[$p]="$(mktemp -t tachyon-plugin.XXXXXX.tgz)"
		if ! tx_fetch_plugin "$p" "${tx_plugin_tmp[$p]}"; then
			rm -f "$tx_tmp"
			for q in $TX_PLUGINS; do rm -f "${tx_plugin_tmp[$q]}"; done
			echo "ERROR: could not fetch/verify Tachyon plugin $p (pin in share/manifest.json)"
			echo "       Installation aborted - nothing was changed."
			exit 2
		fi
	done

	rm -f -r $TX_INSTALL_DIR
	rm -f -r $TX_CONFIG_DIR

	mkdir $TX_INSTALL_DIR
	mkdir $TX_CONFIG_DIR

	cd "$TX_INSTALL_DIR" || exit 2
	mv "$tx_tmp" "${TX_INSTALL_DIR}/${TX_FILE}"

	key=$(openssl rand -hex 4)
	suffix=$(openssl rand -hex 4)
	admin_account="admin_$key"
	admin_password=$(generate_password)

	echo "Username: admin_$key" > ~/.tachyon
	echo "Password: $admin_password" >> ~/.tachyon
	echo "Admin Panel key: admin_$suffix" >> ~/.tachyon

	tar -xzf ${TX_INSTALL_DIR}/${TX_FILE}
	# No set -e here: an empty tree would otherwise run the rest of this script to exit 0,
	# leaving a dangling data symlink and a WEBMAIL_SYSTEM claiming an install nobody had.
	if [ ! -s ./data/VERSION ]; then
		echo "ERROR: Tachyon archive did not unpack (no data/VERSION). Installation aborted."
		exit 2
	fi
	version=$(cat ./data/VERSION)

	mv ./data $TX_CONFIG_DIR/
	ln -s $TX_CONFIG_DIR/data/ ./data

	# Create cache folder and set permissions
	mkdir -p "$TX_CONFIG_DIR/data/_data_/_default_/cache/"

	# Unpack the verified plugins; install.php only writes their config and enables them.
	mkdir -p "$TX_CONFIG_DIR/data/_data_/_default_/plugins/"
	for p in $TX_PLUGINS; do
		tar -xzf "${tx_plugin_tmp[$p]}" -C "$TX_CONFIG_DIR/data/_data_/_default_/plugins/"
		rm -f "${tx_plugin_tmp[$p]}"
	done

	chown -R www-data:www-data ./data

	r=""
	if [ "$TX_DB_BACKEND" = "mysql" ]; then
		if [ -f '/usr/bin/mariadb' ]; then
			mariadb -e "CREATE DATABASE tachyon" 2>&1
			r=$(generate_password)
			mariadb -e "GRANT ALL ON tachyon.*
			 TO tachyon@localhost IDENTIFIED BY '$r'"
		else
			mysql -e "CREATE DATABASE tachyon" 2>&1
			r=$(generate_password)
			mysql -e "GRANT ALL ON tachyon.*
			 TO tachyon@localhost IDENTIFIED BY '$r'"
		fi
	fi
	# Temporarily set the permissions to www-data
	chown -R www-data:www-data $TX_CONFIG_DIR/
	# Same PHP the pool serves with (pinned version + the pool's curated ini chain), not the
	# PATH's CLI php - install.php loads Tachyon's own framework, so this run must prove the
	# chain that carries the traffic afterwards.
	if [ ! -s /etc/php/hestia/php-version ]; then
		echo "ERROR: no pinned panel PHP (/etc/php/hestia/php-version) - is the panel stage done?"
		exit 2
	fi
	panel_php="php$(cat /etc/php/hestia/php-version)"
	env PHP_INI_SCAN_DIR=/etc/php/hestia/fpm/conf.d "$panel_php" -f $HESTIA/share/tachyon/install.php "admin_$key" "admin_$suffix" "$admin_password" "$r" "$BACKEND_PORT" "$TX_DB_BACKEND"

	# back to caddy (the FPM pool user); explicit 0750 keeps the data dir caddy-private
	chown -R caddy:caddy $TX_CONFIG_DIR/
	chmod -R 750 $TX_CONFIG_DIR/data

	# After the chown, because the rewrite copies owner and mode from the file it replaces. A webmail
	# installed after sieve must not come up without the filter screen.
	webmail_sieve_apply

	# Auth-log target for the fail2ban webmail jail. Tachyon runs as caddy and writes
	# /var/log/tachyon/fail2ban/auth.txt (see share/tachyon/install.php); create the root here so
	# the first failed login has somewhere to write and the jail has a file to watch.
	mkdir -p /var/log/tachyon
	chown caddy:caddy /var/log/tachyon
	chmod 750 /var/log/tachyon
	# the fail2ban tachyon-auth jail tails fail2ban/auth.txt, so the log must rotate
	cp -f "$HESTIA/share/tachyon/logrotate" /etc/logrotate.d/tachyon

	# Remove the downloaded file
	rm ${TX_INSTALL_DIR}/${TX_FILE}
	# Add robots.txt
	echo "User-agent: *" > $TX_INSTALL_DIR/robots.txt
	echo "Disallow: /" >> $TX_INSTALL_DIR/robots.txt

	# Panel-Caddy delivery: caddy FPM pool behind the :8091 loopback listener
	# (the caddy-owned data dir only works because the pool runs as caddy)
	mkdir -p $TX_INSTALL_DIR/tmp
	chown caddy:caddy $TX_INSTALL_DIR/tmp
	chmod 770 $TX_INSTALL_DIR/tmp
	cp -f "$HESTIA/share/panel-php/pool.d/tachyon.conf" /etc/php/hestia/fpm/pool.d/tachyon.conf
	systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true
	cp -f "$HESTIA/share/panel-caddy/webmail-tachyon.conf" /etc/caddy/webmail-tachyon.conf
	systemctl try-restart caddy > /dev/null 2>&1 || true

	# Updating hestia.conf through the token function; the position carries no meaning, so no prepend
	sys_key_token_set WEBMAIL_SYSTEM add tachyon > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record tachyon"

else
	if [ ! -s "${TX_INSTALL_DIR}/${TX_FILE}" ] && ! tx_fetch "${TX_INSTALL_DIR}/${TX_FILE}"; then
		rm -f "${TX_INSTALL_DIR}/${TX_FILE}"
		echo "ERROR: could not download Tachyon $tx_v from $TX_URL"
		echo "       Update aborted - the installed version is untouched."
		exit 2
	fi

	version=$(cat $TX_INSTALL_DIR/data/VERSION)
	cd "$TX_INSTALL_DIR" || exit 2
	tx_peek=$(mktemp -d -t tachyon-peek.XXXXXX)
	tar -xzf "$TX_FILE" -C "$tx_peek/"
	version_source=$(cat "$tx_peek/data/VERSION")
	# check the version in the tarball in case hestia hasn't updated yet
	if [ "$version" != "$version_source" ]; then
		tar -xzf ${TX_INSTALL_DIR}/${TX_FILE}
		rm $TX_INSTALL_DIR/$TX_FILE
	fi
	rm -fr "$tx_peek"
fi

# re-render mail domains so they pick up the new client immediately
$BIN/h-update-mail-templates yes > /dev/null 2>&1 || true

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

if [ "$UPDATE" = "yes" ]; then
	$BIN/h-log-action "system" "Info" "Plugins" "Tachyon updated (Version: $version)."
else
	$BIN/h-log-action "system" "Info" "Plugins" "Tachyon enabled (Version: $version)."
fi
# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

#!/bin/bash
# info: Install Tachyon webmail client
# options: NONE
#
# example: h-add-sys-tachyon
#
# Installs or upgrades Tachyon, the maintained SnappyMail fork, at the release pinned in share/manifest.json.
# Everything is fetched and verified before anything is removed.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
source_conf "$HESTIA/conf/hestia.conf"

tx_v=$(manifest_get '.software_versions.tachyon')

UPDATE="no"
TX_FILE="tachyon-${tx_v}.tar.gz"

TX_URL="https://github.com/kimusan/Tachyon/releases/download/v${tx_v}/tachyon-${tx_v}.tar.gz"

TX_INSTALL_DIR="/var/lib/tachyon"
TX_CONFIG_DIR="/etc/tachyon"

# Pinned like the plugins: gzip -t passes on any valid gzip, and fetch_release_asset may fall back to a mirror.
tx_fetch() {
	local dest="$1" sum
	sum=$(manifest_get '.software_versions.tachyon_sha256')
	[ -n "$sum" ] && [ "$sum" != "null" ] || return 1
	fetch_release_asset tachyon "$TX_URL" "$dest" || return 1
	gzip -t "$dest" 2> /dev/null || return 1
	echo "$sum  $dest" | sha256sum -c --quiet - 2> /dev/null || return 1
}

# Pinned: change-password-hestia changes system passwords, so a swapped release asset must die here.
# Never through Tachyon's own Repository: it reads packages.json from the master branch, a moving address.
tx_fetch_plugin() {
	local name="$1" dest="$2" ver sum
	ver=$(manifest_get ".software_versions.tachyon_plugins[\"$name\"].version")
	sum=$(manifest_get ".software_versions.tachyon_plugins[\"$name\"].sha256")
	{ [ -n "$ver" ] && [ "$ver" != "null" ] && [ -n "$sum" ] && [ "$sum" != "null" ]; } || return 1
	fetch_release_asset tachyon \
		"https://github.com/kimusan/Tachyon/releases/download/v${tx_v}/${name}-${ver}.tgz" "$dest" || return 1
	echo "$sum  $dest" | sha256sum -c --quiet - 2> /dev/null || return 1
}

TX_PLUGINS="change-password change-password-hestia add-x-originating-ip-header"
TX_PLUGIN_DIR="$TX_CONFIG_DIR/data/_data_/_default_/plugins"
declare -A tx_plugin_tmp

# All fetched and verified before anything is touched.
tx_fetch_plugins() {
	local p q
	for p in "$@"; do
		tx_plugin_tmp[$p]="$(mktemp -t tachyon-plugin.XXXXXX.tgz)"
		if ! tx_fetch_plugin "$p" "${tx_plugin_tmp[$p]}"; then
			for q in "$@"; do rm -f "${tx_plugin_tmp[$q]}"; done
			echo "ERROR: could not fetch/verify Tachyon plugin $p (pin in share/manifest.json)"
			return 1
		fi
	done
}

# Over the installed ones: a plugin's config lives in configs/, not in its directory.
tx_unpack_plugins() {
	local p
	mkdir -p "$TX_PLUGIN_DIR"
	for p in "$@"; do
		tar -xzf "${tx_plugin_tmp[$p]}" -C "$TX_PLUGIN_DIR/" || return 1
		rm -f "${tx_plugin_tmp[$p]}"
		chown -R caddy:caddy "$TX_PLUGIN_DIR/$p"
		chmod -R 750 "$TX_PLUGIN_DIR/$p"
	done
	# Ours on top of the pinned driver: it names the client, for the mail password grace.
	cp -f "$HESTIA/share/tachyon/plugins/change-password-hestia/driver.php" \
		"$TX_PLUGIN_DIR/change-password-hestia/driver.php"
}

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-sys-tachyon can only be executed by the root user"
	exit 10
fi

# Decided once, recorded in Tachyon's config: a MariaDB added later never flips it, switching means reinstalling.
TX_DB_BACKEND="sqlite"
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	TX_DB_BACKEND="mysql"
else
	echo "NOTE: no MySQL/MariaDB on this box - Tachyon contacts use the SQLite backend"
	# Fail here, not at the customer's first contacts write: the serving pool needs the driver.
	ensure_panel_sqlite_driver \
		|| {
			echo "ERROR: panel PHP lacks the sqlite driver (php-sqlite3 for the pinned version)"
			exit 2
		}
fi

# Without it the release URL would resolve to .../download/v/tachyon-.tar.gz and 404.
if [ -z "$tx_v" ]; then
	echo "ERROR: no Tachyon version pinned in share/manifest.json. Installation aborted"
	exit 2
fi

if [ -f "/var/lib/tachyon/data/VERSION" ]; then
	version=$(cat $TX_INSTALL_DIR/data/VERSION)
	# The pool is written last; without it an earlier run stopped halfway, and wiping here could cost contacts.
	if [ ! -f /etc/php/hestia/fpm/pool.d/tachyon.conf ]; then
		echo "ERROR: Tachyon $version is unpacked but not set up. Run h-delete-sys-tachyon, then this command again."
		exit 2
	fi
	if [ "$version" == "$tx_v" ]; then
		# Standing on the pin is success. The token writer further down sits past this exit, so it runs here too.
		echo "INFO: Tachyon $version is already installed and matches the pinned version."
		sys_key_token_set WEBMAIL_SYSTEM add tachyon > /dev/null \
			|| check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record tachyon"
		exit 0
	else
		UPDATE="yes"
	fi
fi

if [ "$UPDATE" == "no" ]; then
	# Fetched before the removals below: a dead source must not cost the running install.
	tx_tmp="$(mktemp -t tachyon.XXXXXX.tar.gz)"
	if ! tx_fetch "$tx_tmp"; then
		rm -f "$tx_tmp"
		echo "ERROR: could not download Tachyon $tx_v from $TX_URL"
		echo "       Installation aborted - nothing was changed."
		exit 2
	fi

	if ! tx_fetch_plugins $TX_PLUGINS; then
		rm -f "$tx_tmp"
		echo "       Installation aborted - nothing was changed."
		exit 2
	fi

	rm -f -r $TX_INSTALL_DIR
	rm -f -r $TX_CONFIG_DIR

	mkdir $TX_INSTALL_DIR
	mkdir $TX_CONFIG_DIR

	cd "$TX_INSTALL_DIR" || exit 2
	mv "$tx_tmp" "${TX_INSTALL_DIR}/${TX_FILE}"

	key=$(openssl rand -hex 4)
	suffix=$(openssl rand -hex 4)
	admin_account="admin_$key"
	admin_password=$(generate_password)

	echo "Username: admin_$key" > ~/.tachyon
	echo "Password: $admin_password" >> ~/.tachyon
	echo "Admin Panel key: admin_$suffix" >> ~/.tachyon

	tar -xzf ${TX_INSTALL_DIR}/${TX_FILE}
	# No set -e here: an empty tree would run the rest to exit 0 and record an install nobody has.
	if [ ! -s ./data/VERSION ]; then
		echo "ERROR: Tachyon archive did not unpack (no data/VERSION). Installation aborted."
		exit 2
	fi
	version=$(cat ./data/VERSION)

	mv ./data $TX_CONFIG_DIR/
	ln -s $TX_CONFIG_DIR/data/ ./data

	mkdir -p "$TX_CONFIG_DIR/data/_data_/_default_/cache/"

	# install.php only writes their config and enables them.
	if ! tx_unpack_plugins $TX_PLUGINS; then
		echo "ERROR: a Tachyon plugin did not unpack. Installation aborted."
		exit 2
	fi

	r=""
	if [ "$TX_DB_BACKEND" = "mysql" ]; then
		db_client="mysql"
		[ -x /usr/bin/mariadb ] && db_client="mariadb"
		r=$(generate_password)
		if ! $db_client -e "CREATE DATABASE IF NOT EXISTS tachyon" \
			|| ! $db_client -e "GRANT ALL ON tachyon.* TO tachyon@localhost IDENTIFIED BY '$r'"; then
			echo "ERROR: could not create the tachyon database or its user. Installation aborted."
			exit 2
		fi
	fi
	# The pool's PHP and ini chain, not the PATH's CLI php: install.php loads Tachyon's framework, so it proves that chain.
	if [ ! -s /etc/php/hestia/php-version ]; then
		echo "ERROR: no pinned panel PHP (/etc/php/hestia/php-version) - is the panel stage done?"
		exit 2
	fi
	panel_php="php$(cat /etc/php/hestia/php-version)"
	if ! env PHP_INI_SCAN_DIR=/etc/php/hestia/fpm/conf.d "$panel_php" -f $HESTIA/share/tachyon/install.php \
		"admin_$key" "admin_$suffix" "$admin_password" "$r" "$BACKEND_PORT" "$TX_DB_BACKEND"; then
		echo "ERROR: Tachyon setup (install.php) failed. Installation aborted."
		exit 2
	fi

	# Back to caddy, the pool user; 0750 keeps the data dir caddy-private.
	chown -R caddy:caddy $TX_CONFIG_DIR/
	chmod -R 750 $TX_CONFIG_DIR/data

	# After the chown, as the rewrite copies owner and mode; a webmail added after sieve needs the filter screen.
	webmail_sieve_apply

	# Tachyon writes fail2ban/auth.txt below this as caddy (share/tachyon/install.php); the jail needs it to exist.
	mkdir -p /var/log/tachyon
	chown caddy:caddy /var/log/tachyon
	chmod 750 /var/log/tachyon
	# The fail2ban tachyon-auth jail tails fail2ban/auth.txt, so the log must rotate.
	cp -f "$HESTIA/share/tachyon/logrotate" /etc/logrotate.d/tachyon

	rm ${TX_INSTALL_DIR}/${TX_FILE}
	echo "User-agent: *" > $TX_INSTALL_DIR/robots.txt
	echo "Disallow: /" >> $TX_INSTALL_DIR/robots.txt

	# The pool behind the :8091 loopback listener runs as caddy, which the caddy-owned data dir depends on.
	mkdir -p $TX_INSTALL_DIR/tmp
	chown caddy:caddy $TX_INSTALL_DIR/tmp
	chmod 770 $TX_INSTALL_DIR/tmp
	cp -f "$HESTIA/share/panel-php/pool.d/tachyon.conf" /etc/php/hestia/fpm/pool.d/tachyon.conf
	systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true
	cp -f "$HESTIA/share/panel-caddy/webmail-tachyon.conf" /etc/caddy/webmail-tachyon.conf
	systemctl try-restart caddy > /dev/null 2>&1 || true

	# No prepend: the position in the key carries no meaning, the default follows WEBMAIL_KNOWN_CLIENTS order.
	sys_key_token_set WEBMAIL_SYSTEM add tachyon > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record tachyon"

else
	if [ ! -s "${TX_INSTALL_DIR}/${TX_FILE}" ] && ! tx_fetch "${TX_INSTALL_DIR}/${TX_FILE}"; then
		rm -f "${TX_INSTALL_DIR}/${TX_FILE}"
		echo "ERROR: could not download Tachyon $tx_v from $TX_URL"
		echo "       Update aborted - the installed version is untouched."
		exit 2
	fi

	# The plugins come from the same release, so a bump of the pin may carry new ones.
	tx_stale=()
	for p in $TX_PLUGINS; do
		pin=$(manifest_get ".software_versions.tachyon_plugins[\"$p\"].version")
		grep -qE "VERSION[[:space:]]*=[[:space:]]*'${pin//./\\.}'" "$TX_PLUGIN_DIR/$p/index.php" 2> /dev/null \
			|| tx_stale+=("$p")
	done
	if [ "${#tx_stale[@]}" -gt 0 ] && ! tx_fetch_plugins "${tx_stale[@]}"; then
		rm -f "${TX_INSTALL_DIR}/${TX_FILE}"
		echo "       Update aborted - the installed version is untouched."
		exit 2
	fi

	version=$(cat $TX_INSTALL_DIR/data/VERSION)
	cd "$TX_INSTALL_DIR" || exit 2
	tx_peek=$(mktemp -d -t tachyon-peek.XXXXXX)
	if ! tar -xzf "$TX_FILE" -C "$tx_peek/"; then
		rm -fr "$tx_peek"
		check_result "$E_PARSING" "Tachyon $tx_v tarball could not be unpacked - the installed version is untouched"
	fi
	version_source=$(cat "$tx_peek/data/VERSION")
	if [ "$version" != "$version_source" ]; then
		# Copied from the peek, not unpacked over the tree: data/ is a symlink and tar refuses to write through it.
		for _e in "$tx_peek"/* "$tx_peek"/.[!.]*; do
			[ -e "$_e" ] || continue
			case "${_e##*/}" in data) continue ;; esac
			cp -a "$_e" "$TX_INSTALL_DIR/" || check_result "$E_PARSING" "could not install ${_e##*/} from the Tachyon $tx_v tarball"
		done
		# VERSION is the marker the next run reads: a stale one makes every run upgrade again.
		cp -f "$tx_peek/data/.htaccess" "$tx_peek/data/README.md" "$tx_peek/data/VERSION" "$TX_INSTALL_DIR/data/" \
			|| check_result "$E_PARSING" "could not write the Tachyon $tx_v version marker"
		chown --reference="$TX_INSTALL_DIR/data" "$TX_INSTALL_DIR"/data/{.htaccess,README.md,VERSION}
		rm $TX_INSTALL_DIR/$TX_FILE
		# The log line below reports what is installed now, not what was there before.
		version="$version_source"
	fi
	rm -fr "$tx_peek"
	if [ "${#tx_stale[@]}" -gt 0 ] && ! tx_unpack_plugins "${tx_stale[@]}"; then
		check_result "$E_PARSING" "a Tachyon $tx_v plugin did not unpack"
	fi
	sys_key_token_set WEBMAIL_SYSTEM add tachyon > /dev/null \
		|| check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not record tachyon"
fi

# A domain recorded with tachyon renders the 'disabled' vhost until the client is installed and recorded.
$BIN/h-update-mail-templates yes > /dev/null 2>&1 \
	|| echo "Warning: not every mail domain was re-rendered, h-update-mail-templates names them."

if [ "$UPDATE" = "yes" ]; then
	$BIN/h-log-action "system" "Info" "Plugins" "Tachyon updated (Version: $version)."
else
	$BIN/h-log-action "system" "Info" "Plugins" "Tachyon enabled (Version: $version)."
fi
# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

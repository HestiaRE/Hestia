#!/bin/bash
# info: add 2fa to existing user
# options: USER
#
# example: h-add-user-2fa admin
#
# Enables two-factor authentication for a user and stores the secret and QR code.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

source_conf "$USER_DATA/user.conf"

if [ -n "$TWOFA" ]; then
	echo "Error: 2FA already enabled"
	exit "$E_EXISTS"
fi

data=$($HESTIA_PHP $HESTIA/web/inc/2fa/secret.php)

IFS='-' read -r -a array <<< "$data"
secret=${array[0]}
qrcode=${array[1]}

[[ "$secret" =~ ^[A-Z2-7]{16,}$ && "$qrcode" == data:image/* ]] \
	|| check_result "$E_CONNECT" "the 2FA secret could not be generated"

update_user_value "$user" '$TWOFA' "$secret" && update_user_value "$user" '$QRCODE' "$qrcode"
if [ $? -ne 0 ]; then
	update_user_value "$user" '$TWOFA' ""
	check_result "$E_DISK" "2FA could not be stored for $user"
fi

$BIN/h-log-action "system" "Info" "System" "Two-factor authentication enabled (User: $user)."
$BIN/h-log-action "$user" "Info" "System" "Two-factor authentication enabled."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: add 2fa to existing user
# options: USER
#
# example: h-add-user-2fa admin
#
# This function creates a new 2fa token for user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Reading user values
source_conf "$USER_DATA/user.conf"

# Check if 2FA is already enabled
if [ -n "$TWOFA" ]; then
	echo "Error: 2FA already enabled"
	exit "$E_EXISTS"
fi

# Get secret and qr code from 2fa library
data=$($HESTIA_PHP $HESTIA/web/inc/2fa/secret.php)

# Split to secret and qrcode using delimiter
IFS='-' read -r -a array <<< "$data"
secret=${array[0]}
qrcode=${array[1]}

[[ "$secret" =~ ^[A-Z2-7]{16,}$ && "$qrcode" == data:image/* ]] \
	|| check_result "$E_CONNECT" "the 2FA secret could not be generated"

update_user_value "$user" '$TWOFA' "$secret" && update_user_value "$user" '$QRCODE' "$qrcode"
if [ $? -ne 0 ]; then
	update_user_value "$user" '$TWOFA' ""
	check_result "$E_DISK" "2FA could not be stored for $user"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Two-factor authentication enabled (User: $user)."
$BIN/h-log-action "$user" "Info" "System" "Two-factor authentication enabled."
log_event "$OK" "$ARGUMENTS"

exit

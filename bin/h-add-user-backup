#!/bin/bash
# info: register an archive that is already in the backup folder
# options: USER ARCHIVE
#
# example: h-add-user-backup alpha alpha.2026-08-19_05-46-38.tar
#
# Writes the backup.conf record for an archive put into the backup folder by hand (a HestiaCP one), from its members.
# ARCHIVE is a basename, never a path: this runs as root and reads the file, so a path would let it read any file.
# The record is marked ADOPTED so the nightly age pruning never rotates the operator's own file away.

user=$1
archive=$2

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER ARCHIVE'
is_format_valid 'user'
# By value: this argument is called archive, and is_format_valid resolves 'backup' to a variable of that name.
is_object_format_valid "$archive" 'backup'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

backup_archive_path "$user" "$archive"
case $? in
	1) check_result "$E_NOTEXIST" "$archive doesn't exist in '$BACKUP/$user' or '$BACKUP'" ;;
	2) check_result "$E_INVALID" "$archive does not resolve to a file inside '$BACKUP'" ;;
esac
archive_path="$BACKUP_ARCHIVE"
archive_at="$BACKUP_ARCHIVE_DIR"

probedir=$(mktemp -d -p "${BACKUP_TEMP:-$BACKUP}" -t adopt.XXXXXX) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$probedir"' EXIT

if ! backup_probe "$archive_path" "$probedir"; then
	check_result "$E_PARSING" "$archive cannot be read as a backup archive"
fi
if [ "$PROBE_VESTA" = 'yes' ]; then
	check_result "$E_PARSING" "$archive is a Vesta archive - HestiaRE restores HestiaCP and HestiaRE archives only"
fi

# A comma in an object name cannot be represented in the comma-list record field, so such names are left out and named.
#
# Called plainly, not inside $( ): ADOPT_LIST is a global and a subshell would swallow it.
adopt_skipped=''
adopt_list() {
	local _item
	ADOPT_LIST=''
	while IFS= read -r _item; do
		[ -n "$_item" ] || continue
		# Home entries are named by the customer, so they also have to fit the record; the other lists hold object names.
		if [ "${_item#*,}" != "$_item" ] || { [ "${2:-}" = udir ] && ! is_record_list_item "$_item"; }; then
			adopt_skipped="$adopt_skipped $_item"
			continue
		fi
		ADOPT_LIST="$ADOPT_LIST,$_item"
	done <<< "$1"
	ADOPT_LIST="${ADOPT_LIST#,}"
}
# stat, not du -m: -m is a GNU extension, and the size is a byte count either way.
size=$((($(stat -c %s "$archive_path") + 1048575) / 1048576))

adopt_list "$PROBE_WEB"
web_list="$ADOPT_LIST"
adopt_list "$PROBE_DNS"
dns_list="$ADOPT_LIST"
adopt_list "$PROBE_MAIL"
mail_list="$ADOPT_LIST"
adopt_list "$PROBE_DB"
db_list="$ADOPT_LIST"
adopt_list "$PROBE_UDIR" udir
udir_list="$ADOPT_LIST"

backup_str="BACKUP='$archive'"
backup_str="$backup_str TYPE='$BACKUP_SYSTEM' SIZE='$size'"
backup_str="$backup_str WEB='$web_list'"
backup_str="$backup_str DNS='$dns_list'"
backup_str="$backup_str MAIL='$mail_list'"
backup_str="$backup_str DB='$db_list'"
backup_str="$backup_str CRON='$([ "$PROBE_CRON" = 'yes' ] && echo 1)'"
backup_str="$backup_str UDIR='$udir_list'"
backup_str="$backup_str WEB_SYSTEM='$PROBE_WEB_SYSTEM' PROXY_SYSTEM='$PROBE_PROXY_SYSTEM'"
backup_str="$backup_str ADOPTED='yes' RUNTIME='0'"
backup_str="$backup_str TIME='$(stat -c %y "$archive_path" | cut -f2 -d\  | cut -f1 -d.)'"
backup_str="$backup_str DATE='$(stat -c %y "$archive_path" | cut -f1 -d\ )'"

# The gate the restore uses before it trusts an archived line: this one is built out of archive content.
if ! record_line_valid "$backup_str"; then
	check_result "$E_INVALID" "$archive holds an object name that cannot be written to a record"
fi

touch $USER_DATA/backup.conf
# Escaped: the archive name is a pattern here, and a bare dot matches any character.
sed -i "/BACKUP='${archive//./\\.}'/d" $USER_DATA/backup.conf
echo "$backup_str" >> $USER_DATA/backup.conf
chmod 660 $USER_DATA/backup.conf

# Said out loud: a whole restore still brings these back, but they cannot be picked individually in the panel.
if [ -n "$adopt_skipped" ]; then
	echo "Warning!: name(s) the record cannot hold are not in it and cannot be selected singly:$adopt_skipped"
fi

U_BACKUPS=$(grep -c BACKUP $USER_DATA/backup.conf)
update_user_value "$user" '$U_BACKUPS' "$U_BACKUPS"

where="the customer folder $BACKUP/$user"
[ "$archive_at" = 'root' ] && where="the hand-off location $BACKUP"
echo "$archive adopted from $where"
$BIN/h-log-action "system" "Info" "Backup" "Archive adopted (User: $user, Archive: $archive)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: enable rootless Docker for a user
# options: USER [BACKUP_SCOPE]
#
# example: h-add-user-docker john
# example: h-add-user-docker john full
#
# Creates the customer's companion and starts their own rootless daemon (#389).
#
# Two accounts, one trust domain. The companion is container uid 0 and runs the daemon;
# the customer is container uid 1000, the id stock images expect, so upstream compose
# files work unmodified. The customer never touches the companion account - they reach
# the daemon through a group-owned socket in ~/.companion, and socket access is full
# daemon control, which is why only their own group gets it.
#
# The companion home sits INSIDE the customer home so both travel as one backup unit,
# and is created there directly: relocating later breaks the absolute enable symlinks
# the rootless setup writes.
#
# Re-runnable in both directions: a partial enable heals, a healthy one is left alone
# (see the guard before the restart block).
#
# BACKUP_SCOPE picks what h-backup-user keeps of the Docker data root: 'volumes' (default) or
# 'full'. Only those two are sound - anything in between separates the layer store from the metadata
# indexing it and restores a store referencing layers that are not there.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
backup_scope=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/identity.sh
source $HESTIA/include/identity.sh
# shellcheck source=/usr/local/hestia/include/docker.sh
source $HESTIA/include/docker.sh
# shellcheck source=/usr/local/hestia/include/helper.sh
source $HESTIA/include/helper.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# NOT su: no login session means no user bus, so systemctl --user cannot reach the
# manager. systemd-run builds one whatever the login shell is, and starts from a bare
# environment - the rootless setuptool refuses without HOME.
companion_run() {
	systemd-run --machine="${companion}@" --user --pipe --wait --quiet \
		--setenv=HOME="$companion_home" --setenv=PATH=/usr/bin:/bin:/usr/sbin:/sbin \
		--setenv=XDG_RUNTIME_DIR="/run/user/$companion_uid" "$@"
}

# Not [ -S ] on the socket file: dockerd leaves that behind when it dies, so a dead
# daemon looks identical to a live one.
docker_alive() {
	DOCKER_HOST="unix://$companion_home/docker.sock" \
		docker version --format '{{.Server.Version}}' > /dev/null 2>&1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [BACKUP_SCOPE]'
is_format_valid 'user'
if [ -n "$backup_scope" ] && [ "$backup_scope" != 'volumes' ] && [ "$backup_scope" != 'full' ]; then
	echo "ERROR: BACKUP_SCOPE must be 'volumes' or 'full', got '$backup_scope'."
	exit "$E_INVALID"
fi
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-add-user-docker can only be executed by the root user"
	exit 10
fi

command -v dockerd-rootless.sh > /dev/null 2>&1 \
	|| {
		echo "ERROR: Docker is not installed - run h-add-sys-docker first."
		exit "$E_NOTEXIST"
	}

# Docker needs a real shell (compose files, the docker CLI) and the jail is not measured for
# it - so the decision is unjailed SSH or no docker, and the check is here rather than only in
# the panel, because the panel is not the only caller.
user_shell="$(getent passwd "$user" | cut -f 7 -d :)"
case "$user_shell" in
	*nologin | *false | *rssh | *jailbash | '')
		echo "ERROR: docker needs an unjailed login shell, $user has '${user_shell:-none}'."
		exit "$E_INVALID"
		;;
esac
if id -nG "$user" 2> /dev/null | tr ' ' '\n' | grep -qx 'sftp-jailed'; then
	echo "ERROR: $user is in the sftp jail - docker needs an unjailed account."
	exit "$E_INVALID"
fi

uid="$(id -u "$user" 2> /dev/null)"
gid="$(id -g "$user" 2> /dev/null)"
[ -n "$uid" ] || {
	echo "ERROR: $user has no system account."
	exit "$E_NOTEXIST"
}

# The companion sits one block below, and the subordinate base comes from the slot the
# uid encodes. A uid outside the band predates the allocator and has no reserved
# companion block, so there is nowhere safe to put one.
k="$(identity_k_from_uid "$uid")" \
	|| {
		echo "ERROR: $user has uid $uid, outside the panel band - no companion block is reserved for it."
		exit "$E_INVALID"
	}
companion="${user}-docker"
# Group names cap at 32 on every target and the companion needs its own group, so a customer name
# over 25 characters would only fail deep inside groupadd, with the account already created.
[ ${#companion} -le 32 ] || {
	echo "ERROR: user name '$user' is too long for docker - the companion '$companion' exceeds 32 characters."
	exit "$E_INVALID"
}
companion_uid=$((uid - IDENTITY_BLOCK))
sub_base="$(identity_sub_base_from_k "$k")"
companion_home="$HOMEDIR/$user/.companion"
# useradd -m would build the home through a link the customer left there.
[ -L "$companion_home" ] && check_result "$E_FORBIDEN" "$companion_home is a link"

existing="$(getent passwd "$companion_uid" | cut -d: -f1)"
if [ -n "$existing" ] && [ "$existing" != "$companion" ]; then
	echo "ERROR: companion uid $companion_uid is held by '$existing'."
	exit "$E_EXISTS"
fi
# Symmetric to the uid check: a foreign group would otherwise only surface as "could not
# create <companion>" from the useradd.
existing="$(getent group "$companion_uid" | cut -d: -f1)"
if [ -n "$existing" ] && [ "$existing" != "$companion" ]; then
	echo "ERROR: companion gid $companion_uid is held by group '$existing'."
	exit "$E_EXISTS"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Before the health guard below, which exits early on a healthy customer: putting this after it
# would make the scope unchangeable for exactly the customers that are already running.
#
# update_user_value alone is not enough - it rewrites an existing line and does nothing at all when
# the key is absent, which is the normal state until a rebuild seeds it (#559). Inserted before
# TIME= rather than appended, so the key never lands on the last line.
if [ -n "$backup_scope" ] || ! grep -q "^DOCKER_BACKUP='" "$USER_DATA/user.conf" 2> /dev/null; then
	scope="${backup_scope:-$(get_user_value '$DOCKER_BACKUP')}"
	# Normalise, do not just default: the argument is validated above, but a value carried over from
	# user.conf is not, and a hand-edited one would otherwise be written back unchecked. h-backup-user
	# treats anything but 'full' as 'volumes', so this keeps the file saying what actually happens.
	[ "$scope" = 'full' ] || scope='volumes'
	if grep -q "^DOCKER_BACKUP='" "$USER_DATA/user.conf" 2> /dev/null; then
		update_user_value "$user" '$DOCKER_BACKUP' "$scope"
	else
		sed -i "/^TIME=/i DOCKER_BACKUP='$scope'" "$USER_DATA/user.conf"
	fi
	echo "Backup scope: $scope"
fi

# One loopback /24 per customer: .1 is the daemon default bind, so a plain compose file needs no
# address; the domain picks its octet per app. Keep a restored /24 when free, else first-free.
docker_ip="$(get_user_value '$DOCKER_IP')"
docker_ip_valid "$docker_ip" || docker_ip=''
recorded_ip=$docker_ip
if [ -n "$docker_ip" ]; then
	docker_net="${docker_ip%.*}"
	holder=$(grep -l "DOCKER_IP='$docker_net\." "$CONF_DIR"/users/*/user.conf 2> /dev/null \
		| grep -Fxv "$USER_DATA/user.conf" | head -1)
	if [ -n "$holder" ]; then
		echo "Docker net $docker_net.0/24 is held by $(basename "$(dirname "$holder")") - allocating a new one."
		docker_ip=''
	fi
fi
if [ -z "$docker_ip" ]; then
	# one /24 base per line; -x so 127.20.1 cannot shadow 127.20.10
	used=$(grep -ho "DOCKER_IP='[^']*'" "$CONF_DIR"/users/*/user.conf 2> /dev/null \
		| cut -d"'" -f2 | sed 's/\.[0-9]*$//')
	for i in $(seq 0 254); do
		grep -qxF "127.20.$i" <<< "$used" || {
			docker_ip="127.20.$i.1"
			break
		}
	done
	[ -n "$docker_ip" ] || {
		echo "ERROR: no free docker /24 left under 127.20.0.0/16"
		exit "$E_LIMIT"
	}
fi
if grep -q "^DOCKER_IP='" "$USER_DATA/user.conf" 2> /dev/null; then
	update_user_value "$user" '$DOCKER_IP' "$docker_ip"
else
	sed -i "/^TIME=/i DOCKER_IP='$docker_ip'" "$USER_DATA/user.conf"
fi
echo "Docker address: $docker_ip"
# A first enable that fails must not leave the record saying docker is on; a held address stays for the re-run.
if [ -z "$recorded_ip" ]; then
	trap '[ $? -eq 0 ] || sed -i "/^DOCKER_IP=/d" "$USER_DATA/user.conf"' EXIT
fi

if ! getent passwd "$companion" > /dev/null 2>&1; then
	echo "Creating companion $companion (uid $companion_uid)..."
	# Its OWN group: the customer home is group::--- with other::--x, so an account in that
	# group is caught by the empty entry and never reaches other:: - it could not even
	# traverse into its own home.
	getent group "$companion" > /dev/null 2>&1 \
		|| /usr/sbin/groupadd -g "$companion_uid" "$companion" \
		|| {
			echo "ERROR: could not create group $companion (gid $companion_uid)"
			exit "$E_INVALID"
		}
	# SUB_UID_COUNT=0 suppresses the range useradd assigns on Ubuntu, which would sit
	# FIRST in /etc/subuid and shift the whole mapping.
	/usr/sbin/useradd "$companion" -u "$companion_uid" -g "$companion_uid" \
		-K UID_MAX="$IDENTITY_BAND_END" -K SUB_UID_COUNT=0 -K SUB_GID_COUNT=0 \
		-d "$companion_home" -m -s /usr/sbin/nologin \
		-c "Docker companion for $user" \
		|| {
			echo "ERROR: could not create $companion"
			exit "$E_INVALID"
		}
fi

# The DIRECTORY carries the customer's group at 0710: traverse to the socket, no listing.
home_dir_own "$companion_home" "$companion:$gid" 0710 || check_result "$E_FORBIDEN" "$companion_home is not a directory"

# Order is semantic: newuidmap consumes the lines in file order, giving container
# 1-999, container 1000 = the customer, container 1001-65536. Deleted before appending
# so a re-run cannot stack a second set.
echo "Writing subordinate id ranges..."
for f in /etc/subuid /etc/subgid; do
	sed -i "/^${companion//./\\.}:/d" "$f"
done
{
	printf '%s:%s:999\n' "$companion" "$sub_base"
	printf '%s:%s:1\n' "$companion" "$uid"
	printf '%s:%s:64536\n' "$companion" "$((sub_base + 999))"
} >> /etc/subuid
{
	printf '%s:%s:999\n' "$companion" "$sub_base"
	printf '%s:%s:1\n' "$companion" "$gid"
	printf '%s:%s:64536\n' "$companion" "$((sub_base + 999))"
} >> /etc/subgid

# hidepid hides the pids runc needs for its container scope; the companion runs it (#565).
if command -v proc_visible_add > /dev/null 2>&1; then
	proc_visible_add "$companion" > /dev/null 2>&1 || true
fi

# Containers have to survive logout and reboot, which is what linger buys - and it is
# the one real capability change here.
loginctl enable-linger "$companion" > /dev/null 2>&1
for _ in $(seq 1 20); do
	[ "$(systemctl is-active "user@${companion_uid}.service" 2> /dev/null)" = 'active' ] && break
	sleep 1
done
if [ "$(systemctl is-active "user@${companion_uid}.service" 2> /dev/null)" != 'active' ]; then
	echo "ERROR: the companion's user manager did not start."
	exit "$E_INVALID"
fi

# Only intervene where something is missing. A re-run is the supported recovery path, so
# it must not restart a daemon that is serving containers - that is a real outage.
override_dir="$companion_home/.config/systemd/user/docker.service.d"
override_want="$(sed -e "s|__RUNSOCK__|/run/user/$companion_uid/docker.sock|g" \
	-e "s|__SOCK__|$companion_home/docker.sock|g" -e "s|__GID__|1000|g" \
	"$HESTIA/share/docker/systemd/docker-rootless-override.conf")"

# BOTH keys: "ip" covers only the default bridge and compose creates a project net per stack;
# default-network-opts extends the bind to every new bridge net (measured).
daemon_json="$companion_home/.config/docker/daemon.json"
daemon_json_want="$(printf '{\n  "ip": "%s",\n  "default-network-opts": {\n    "bridge": {\n      "com.docker.network.bridge.host_binding_ipv4": "%s"\n    }\n  }\n}' "$docker_ip" "$docker_ip")"

if docker_alive && [ "$(cat "$override_dir/hestia.conf" 2> /dev/null)" = "$override_want" ] \
	&& [ "$(cat "$daemon_json" 2> /dev/null)" = "$daemon_json_want" ]; then
	echo "Docker is already enabled and running for $user."
	$BIN/h-log-action "system" "Info" "System" "Verified rootless Docker for $user."
	log_event "$OK" "$ARGUMENTS"
	exit
fi

# Exit code is NOT the verdict: its last act is starting the daemon, which fails when
# one already runs or a stale unit arrived with a restored home. It writes the unit; the
# liveness probe below decides.
echo "Installing the rootless daemon..."
setup_log="$(mktemp -t hestia-docker-setup.XXXXXX)"
companion_run dockerd-rootless-setuptool.sh install > "$setup_log" 2>&1 || true

# Both sockets and the numeric group: see the template header. Placeholders are __UPPER__
# so substitution cannot rewrite the prose around them.
# Written as the companion: the customer can plant links below .companion before it is handed over.
companion_write() {
	setpriv --reuid "$companion_uid" --regid "$companion_uid" --clear-groups -- \
		sh -c 'mkdir -p "${1%/*}" && cat > "$1"' _ "$1"
}
printf '%s\n' "$override_want" | companion_write "$override_dir/hestia.conf" \
	|| check_result "$E_FORBIDEN" "cannot write $override_dir/hestia.conf as $companion"

# The daemon reads it at start; the restart below picks up an address change
printf '%s\n' "$daemon_json_want" | companion_write "$daemon_json" \
	|| check_result "$E_FORBIDEN" "cannot write $daemon_json as $companion"
chown -R "$companion":"$gid" "$companion_home/.config"

install -m 644 "$HESTIA/share/docker/profile.d-hestia-docker.sh" /etc/profile.d/hestia-docker.sh

# restart, not enable --now: on a running unit --now is a no-op and the daemon keeps the
# pre-override ExecStart. reset-failed is not cosmetic either - a restored home brings
# the unit enabled plus the previous host's override, whose socket path carries the old
# companion uid, so linger starts it, dockerd dies binding it, and the rate limiter
# latches; the restart would then be refused outright.
companion_run systemctl --user daemon-reload > /dev/null 2>&1
companion_run systemctl --user reset-failed docker > /dev/null 2>&1
companion_run systemctl --user enable docker > /dev/null 2>&1
companion_run systemctl --user restart docker > /dev/null 2>&1
for _ in $(seq 1 60); do
	docker_alive && break
	sleep 1
done
if ! docker_alive; then
	echo "ERROR: the companion daemon at $companion_home/docker.sock does not answer"
	echo "       unit: $(companion_run systemctl --user is-active docker 2>&1 | tail -1)"
	echo "       rootless setup output: $setup_log"
	exit "$E_INVALID"
fi
rm -f "$setup_log"

# The slice exists only once the manager runs, so the cap goes on here rather than at package time
docker_slice_apply "$user" "$(get_user_value '$DOCKER_LIMIT')"

echo "Docker is enabled for $user."

# The /24 separation rule renders from the user records; follow enable/disable immediately
if [ -n "$FIREWALL_SYSTEM" ]; then
	$BIN/h-update-firewall > /dev/null 2>&1
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Enabled rootless Docker for $user."
log_event "$OK" "$ARGUMENTS"

exit

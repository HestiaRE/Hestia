#!/bin/bash
# info: enable the file manager for a user
# options: USER [RESTART]
#
# example: h-add-user-filemanager alice
#
# Enables the file manager for a user: an FPM pool running as the customer and the private listener vhost.
# Idempotent; rebuild, restore and h-add-sys-filemanager call it to bring saved flags back.

user="$1"
restart="$2"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# shellcheck source=/usr/local/hestia/include/filemanager.sh
source "$HESTIA/include/filemanager.sh"
: "${FILE_MANAGER_PORT:=8092}"

check_args '1' "$#" 'USER [RESTART]'
[ "$(id -u)" = '0' ] || {
	echo "ERROR: h-add-user-filemanager must be run as root"
	exit 10
}

is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

if [ ! -s "$FM_SECRET_FILE" ] || [ ! -f "$FM_CODE_DIR/index.php" ]; then
	echo "ERROR: file manager module not installed — run h-add-sys-filemanager first"
	exit "$E_NOTEXIST"
fi
fm_web=$(fm_front)
[ -n "$fm_web" ] || check_result "$E_DISABLED" "the file manager needs a customer web server, this box has none"

# An absent key goes in before TIME=, never last.
fm_flag_set() {
	if grep -q "^FILE_MANAGER='" "$USER_DATA/user.conf" 2> /dev/null; then
		update_user_value "$user" '$FILE_MANAGER' 'yes'
	else
		sed -i "/^TIME=/i FILE_MANAGER='yes'" "$USER_DATA/user.conf"
	fi
}

# A suspended account keeps the choice and h-unsuspend-user builds the listener, unless the policy keeps
# suspended accounts open, as h-suspend-user does.
if [ "$(get_user_value '$SUSPENDED')" = 'yes' ] && [ "$POLICY_USER_VIEW_SUSPENDED" != 'yes' ]; then
	fm_flag_set
	log_event "$OK" "$ARGUMENTS"
	exit
fi

# The server's default php version, never a pinned one.
ver="$(multiphp_default_version)"
[ -n "$ver" ] && [ -x "/usr/sbin/php-fpm$ver" ] || check_result "$E_NOTEXIST" "no php-fpm for the default php version '$ver'"
pool="/etc/php/$ver/fpm/pool.d/fm-$user.conf"

if [ "$fm_web" = 'nginx' ]; then
	vhost="/etc/nginx/conf.d/fm-$user.conf"
	tpl='nginx'
else
	vhost="/etc/apache2/conf.d/fm-$user.conf"
	tpl='apache'
fi

# Session and upload dir, the same the customer's web pool uses.
home_dir_own "$HOMEDIR/$user/tmp" "$user:$user" 700 || check_result "$E_FORBIDEN" "$HOMEDIR/$user/tmp is not a directory"

# A pool php-fpm refuses would take every site of that version down at its next start.
mkdir -p "$(dirname "$pool")"
prev=''
[ -f "$pool" ] && prev=$(< "$pool")
sed "s|%user%|$user|g" "$HESTIA/share/filemanager/fpm-pool.tpl" > "$pool"
chmod 644 "$pool"
if ! "/usr/sbin/php-fpm$ver" -t > /dev/null 2>&1; then
	# The test can fail over another pool; a listener that worked before stays as it was.
	if [ -n "$prev" ]; then
		printf '%s\n' "$prev" > "$pool"
	else
		rm -f "$pool"
	fi
	check_result "$E_INVALID" "php$ver-fpm config test fails with the file manager pool for $user"
fi
# Only once the new pool passed: one left in a former default version would hold the socket from a second master.
for old in /etc/php/*/fpm/pool.d/fm-"$user".conf; do
	[ -e "$old" ] || continue
	[ "$old" = "$pool" ] && continue
	rm -f "$old"
	old_ver=${old#/etc/php/}
	old_ver=${old_ver%%/*}
	systemctl reload "php$old_ver-fpm" 2> /dev/null || systemctl restart "php$old_ver-fpm" 2> /dev/null || true
done
systemctl reload "php$ver-fpm" 2> /dev/null || systemctl restart "php$ver-fpm" 2> /dev/null || true

# fm-auth gates on the socket, which appears a moment after the reload; a quick click would get a 403.
sock="/run/hestia/fm/$user.sock"
for _ in $(seq 1 50); do
	[ -S "$sock" ] && break
	sleep 0.1
done
# Before the vhost and the flag, so a failed enable leaves nothing behind.
if [ ! -S "$sock" ]; then
	rm -f "$pool"
	systemctl reload "php$ver-fpm" 2> /dev/null
	check_result "$E_NOTEXIST" "file manager pool socket did not appear ($sock) — php$ver-fpm reload may have failed"
fi

# Private-listener vhost. It carries the secret every customer's vhost shares, so root only, from the first byte.
rm -f "$vhost"
(
	umask 077
	fm_render "$HESTIA/share/filemanager/$tpl.tpl" "$user" > "$vhost"
)
chmod 600 "$vhost"
if [ "$restart" != 'no' ]; then
	$BIN/h-restart-service "$fm_web" > /dev/null 2>&1 || true
fi

fm_flag_set

$BIN/h-log-action "system" "Info" "Plugins" "File manager enabled for $user."
log_event "$OK" "$ARGUMENTS"
exit

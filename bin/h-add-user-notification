#!/bin/bash
# info: add user notification
# options: USER TOPIC NOTICE [TYPE] [PRIORITY]
#
# Adds a notification to a user's panel bell.

user=$1
topic=$2
type=$4
priority=$5

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# After the includes: the encoder is a shell function, and before main.sh it yields an empty value.
topic=$(record_value_encode "$topic")
# NOTICE renders as HTML, so it is sanitized before storing, and encoded after: the sanitizer re-serialises
# attributes with a double quote.
clean=$("$HESTIA_PHP" "$HESTIA/include/sanitize_html.php" "$3") || check_result "$E_INVALID" "the notice could not be sanitized"
notice=$(record_value_encode "$clean")

check_args '2' "$#" 'USER TOPIC NOTICE [TYPE] [PRIORITY]'
is_format_valid 'user' 'topic' 'notice' 'priority'
is_object_valid 'user' 'USER' "$user"
is_common_format_valid "$type"

if [ -e "$USER_DATA/notifications.conf" ]; then
	nid=$(grep "NID=" $USER_DATA/notifications.conf | cut -f 2 -d \')
	nid=$(echo "$nid" | sort -n | tail -n1)
	if [ -n "$nid" ]; then
		nid="$((nid + 1))"
	else
		nid=1
	fi
else
	nid=1
fi

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

str="NID='$nid' TOPIC='$topic' NOTICE='$notice' TYPE='$type' PRIORITY='$priority'"
str="$str ACK='no' TIME='$time' DATE='$date'"

echo "$str" >> $USER_DATA/notifications.conf

chmod 660 $USER_DATA/notifications.conf

if [ -z "$(grep NOTIFICATIONS $USER_DATA/user.conf)" ]; then
	sed -i "s/^TIME/NOTIFICATIONS='yes'\nTIME/g" $USER_DATA/user.conf
else
	update_user_value "$user" '$NOTIFICATIONS' "yes"
fi

exit

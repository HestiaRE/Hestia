#!/bin/bash
# info: add user sftp jail
# options: USER [RESTART]
#
# example: h-add-user-sftp-jail admin
#
# Puts a nologin account into the sftp-jailed group; pam_namespace builds the jail per session.
# RESTART is accepted and ignored, the group applies at the next login.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user'

# Only nologin accounts; a real login shell (bash/jailbash) is not chrooted
user_shell=$(getent passwd "$user" | cut -d : -f 7)
[ "${user_shell##*/}" = 'nologin' ] || exit

add_chroot_jail "$user"

# RESTART stays for the callers that pass it.
: "${restart:=}"

log_event "$OK" "$ARGUMENTS"

exit

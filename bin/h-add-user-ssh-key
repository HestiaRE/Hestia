#!/bin/bash
# info: add ssh key
# options: USER SSH_PUBLIC_KEY
#
# example: h-add-user-ssh-key user 'valid ssh key'
#
# Adds an SSH key to a user's authorized_keys; a key already there is refused.

user=$1
key=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER SSH_PUBLIC_KEY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

source_conf "$USER_DATA/user.conf"

AUTHKEY_FILE=$(authkeys_file)
path_within "$AUTHKEY_FILE" "$HOMEDIR/$user/.ssh" || check_result "$E_FORBIDEN" "Invalid authorized keys path"

[ -z "$key" ] && check_result "$E_NOTEXIST" "Empty ssh public key"
# One line: a second one would be written unchecked next to the key that passed.
is_no_new_line_format "$key"
new_ids=$(authkey_ids "$key") || check_result "$E_PARSING" "Validating user private key"

current=$(authkeys_read)
while IFS= read -r line; do
	ids=$(authkey_ids "$line") || continue
	[ "${ids% *}" != "${new_ids% *}" ] || check_result "$E_EXISTS" "SSH key already exists"
done <<< "$current"

{
	[ -n "$current" ] && printf '%s\n' "$current"
	printf '%s\n' "$key"
} | authkeys_write
check_result $? "authorized_keys of $user could not be written"

$BIN/h-log-action "$user" "Info" "System" "Added a new SSH key."
log_event "$OK" "$ARGUMENTS"

exit

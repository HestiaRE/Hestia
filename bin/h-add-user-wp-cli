#!/bin/bash
# info: add wp-cli for a user
# options: USER [UPDATE]
#
# example: h-add-user-wp-cli user
#
# This function adds support for wp-cli to the user account

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
update=$2

if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [UPDATE]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

WPCLI_DIR="$HOMEDIR/$user/.wp-cli"
WPCLI_BIN="$WPCLI_DIR/wp"

# Everything in the home is written as the customer: root following a planted link there would hand
# them a file of root's choosing.
install_phar() {
	local tmp rc
	tmp=$(mktemp) || return 1
	fetch_wp_cli_phar "$tmp" && user_exec mkdir -p "$WPCLI_DIR" \
		&& user_exec sh -c 'cat > "$1.new" && chmod 755 "$1.new" && mv -f "$1.new" "$1"' _ "$WPCLI_BIN" < "$tmp"
	rc=$?
	rm -f "$tmp"
	return $rc
}

if user_exec test -f "$WPCLI_BIN"; then
	if [ "$update" = 'yes' ]; then
		# re-pin, not `wp cli update`: the user's copy converges to the manifest pin
		install_phar || check_result "$E_CONNECT" "Download of the pinned wp-cli phar failed"
		exit
	fi
	check_result "$E_EXISTS" "For user name '$user' WP-CLI already available!"
	exit
fi

# pinned + sha256-verified release phar - never a moving branch address
install_phar || check_result "$E_CONNECT" "Download of the pinned wp-cli phar failed"
bash_alias_set wp "$WPCLI_BIN" || check_result "$E_FORBIDEN" "$HOMEDIR/$user/.bash_aliases is not writable by $user"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "Plugins" "WP-CLI support enabled."
log_event "$OK" "$ARGUMENTS"

exit

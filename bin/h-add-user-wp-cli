#!/bin/bash
# info: add wp-cli for a user
# options: USER [UPDATE]
#
# example: h-add-user-wp-cli user
#
# This function adds support for wp-cli to the user account

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
update=$2

if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [UPDATE]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

WPCLI_DIR="/home/$user/.wp-cli"
WPCLI_BIN="$WPCLI_DIR/wp"

if [ -f "$WPCLI_BIN" ]; then
	if [ "$update" = 'yes' ]; then
		# re-pin, not `wp cli update`: the user's copy converges to the manifest pin
		fetch_wp_cli_phar "$WPCLI_BIN" || check_result "$E_CONNECT" "Download of the pinned wp-cli phar failed"
		chown $user:$user "$WPCLI_BIN"
		exit
	fi
	check_result "$E_EXISTS" "For user name '$user' WP-CLI already available!"
	exit
fi

[ -z "$(readlink -m "$WPCLI_DIR" | egrep "^$HOMEDIR/$user/")" ] && check_result "$E_FORBIDEN" "Path outside of user homedir (WP Cli dir)"
[ -z "$(readlink -m "$WPCLI_BIN" | egrep "^$HOMEDIR/$user/")" ] && check_result "$E_FORBIDEN" "Path outside of user homedir (WP Cli bin)"

mkdir -p "$WPCLI_DIR"
chown $user:$user "$WPCLI_DIR"

# pinned + sha256-verified release phar - never a moving branch address
fetch_wp_cli_phar "$WPCLI_BIN" || check_result "$E_CONNECT" "Download of the pinned wp-cli phar failed"
chown $user:$user "$WPCLI_BIN"
echo "alias wp=/home/"$user"/.wp-cli/wp" >> /home/$user/.bash_aliases

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "Plugins" "WP-CLI support enabled."
log_event "$OK" "$ARGUMENTS"

exit

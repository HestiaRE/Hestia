#!/bin/bash
# info: add web domain
# options: USER DOMAIN [IP] [RESTART] [ALIASES] [PROXY_EXTENSIONS]
#
# example: h-add-web-domain admin wonderland.com 192.18.22.43 yes www.wonderland.com
#
# This function adds virtual host to a server. In cases when ip is
# undefined in the script, "default" template will be used. The alias of
# `www.domain.tld` type will be automatically assigned to the domain unless
# "none" is transmited as argument. If ip have associated dns name, this
# domain will also get the alias domain-tpl.$ipname. An alias with the ip
# name is useful during the site testing while dns isn't moved to server yet.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
ip46=$3
ip="$ip46" # the dispatch is by variable name; $ip is what every consumer below reads
restart=$4 # will be moved to the end soon
aliases=$5
proxy_ext=$6

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn
format_aliases
domain_utf=$(idn2 --quiet -d "$domain_idn")

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
check_args '2' "$#" 'USER DOMAIN [IP] [RESTART] [ALIASES] [PROXY_EXTENSIONS]'
is_format_valid 'user' 'domain' 'aliases' 'ip46' 'proxy_ext' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_package_full 'WEB_DOMAINS'

if [ "$aliases" != "none" ]; then
	ALIAS="$aliases"
	is_package_full 'WEB_ALIASES'
fi

# Both spellings, unconditionally. The listing comparison these used to hang on could not be
# false - a stray space inside the quotes - so the guard always ran; that is kept, without
# the appearance of a condition.
is_domain_new 'web' "$domain_utf,$aliases"
is_domain_new 'web' "$domain_idn,$aliases"
# The silent predicate, not the validator: the validator logs its refusal, and this is the
# success path of every domain add (#925).
if looks_like_ip46 "$domain"; then
	echo "Error: Invalid domain format. IP address detected as input."
	exit 1
fi

is_dir_symlink "$HOMEDIR/$user/web"
is_dir_symlink "$HOMEDIR/$user/web/$domain"

is_base_domain_owner "$domain,$aliases"

if [ -n "$ip" ]; then
	if [ "$(ip_family "$ip")" = 6 ]; then
		ip=$(ip6_canonical "$ip") || check_result "$E_INVALID" "cannot canonicalise the v6 address - the panel php backend did not answer"
	fi
	is_ip_valid "$ip" "$user"
else
	get_user_ip
fi
# Auto-assign the default v6 alongside (#602, decided): a box carrying a v6 IP object
# serves new domains on both families; the AAAA record stays the operator's move.
local_ip6=''
if [ "$(ip_family "$ip")" = 6 ]; then
	# a v6 handed in here belongs in IP6: the IP field and every %ip% listen line are
	# v4-shaped, and the renderer brackets the v6 slot only
	local_ip6="$ip"
	ip=''
	local_ip=''
elif get_user_ip6; then
	local_ip6="$ip6"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Reading user values
source_conf "$USER_DATA/user.conf"

[[ -e "$HOMEDIR/$user/web/$domain" ]] && check_result "$E_EXISTS" "Web domain folder for $domain should not exist"

# Creating domain directories
mkdir $HOMEDIR/$user/web/$domain
chown $user:$user $HOMEDIR/$user/web/$domain
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/public_html"
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/document_errors"
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/cgi-bin"
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/private"
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/stats"
$BIN/h-add-fs-directory "$user" "$HOMEDIR/$user/web/$domain/logs"

# Creating domain logs
touch /var/log/$WEB_SYSTEM/domains/$domain.bytes \
	/var/log/$WEB_SYSTEM/domains/$domain.log \
	/var/log/$WEB_SYSTEM/domains/$domain.error.log
ln -f -s /var/log/$WEB_SYSTEM/domains/$domain.*log \
	$HOMEDIR/$user/web/$domain/logs/

# fail2ban resolves its logpath glob once, at jail start, so a domain added later goes unwatched until the
# daemon restarts. Hand it the new file explicitly.
if [ -n "$FIREWALL_EXTENSION" ]; then
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source $HESTIA/include/fail2ban.sh
	fail2ban_watch_domain add "$domain"
fi

# Adding domain skeleton
user_exec cp -r $SHARETPL/skel/* "$HOMEDIR/$user/web/$domain/" > /dev/null 2>&1
for file in $(find "$HOMEDIR/$user/web/$domain/" -type f); do
	sed -i "s/%domain%/$domain/g" $file
done

# Changing file owner & permission
chown -R $user:$user $HOMEDIR/$user/web/$domain
chown root:$user /var/log/$WEB_SYSTEM/domains/$domain.*
chmod 640 /var/log/$WEB_SYSTEM/domains/$domain.*
user_exec chmod 751 $HOMEDIR/$user/web/$domain/*
user_exec chmod 551 $HOMEDIR/$user/web/$domain/stats $HOMEDIR/$user/web/$domain/logs
# Apply 755 to directories and 644 to files
find $HOMEDIR/$user/web/$domain/public_html -type d -exec chmod 755 {} +
find $HOMEDIR/$user/web/$domain/public_html -type f -exec chmod 644 {} +

# domain folder permissions: DOMAINDIR_WRITABLE: default-val:no source:hestia.conf
DOMAINDIR_MODE=551
if [ "$DOMAINDIR_WRITABLE" = 'yes' ]; then DOMAINDIR_MODE=751; fi

user_exec chmod $DOMAINDIR_MODE $HOMEDIR/$user/web/$domain
chown --no-dereference $user:www-data $HOMEDIR/$user/web/$domain/public_*html

# Adding PHP-FPM backend
if [ -n "$WEB_BACKEND" ]; then
	if [ -z "$BACKEND_TEMPLATE" ]; then
		BACKEND_TEMPLATE='default'
		if [ -z "$(grep BACKEND_TEMPLATE $USER_DATA/user.conf)" ]; then
			sed -i "s/^DNS_TEMPL/BACKEND_TEMPLATE='default'\nDNS_TEMPL/g" \
				$USER_DATA/user.conf
		else
			update_user_value "$user" '$BACKEND_TEMPLATE' "default"
		fi
	fi
	# Lax on the APPLY side: the package is an admin's stored choice, and a value that
	# aged out since must not block the customer from creating a domain. Editing the
	# package itself stays strict (h-add-user-package).
	# Effect discarded on purpose: only the proxy role can yield one (see map_legacy_template)
	read -r BACKEND_TEMPLATE _ <<< "$(accept_web_template 'backend' "$BACKEND_TEMPLATE")"
	export BACKEND="$BACKEND_TEMPLATE"
	# The version is its own field now; a fresh domain takes the system default. The pool
	# is rendered at the same version (prepare_web_backend falls to it while the record
	# does not yet exist), so field and pool agree.
	PHP_VERSION=$(multiphp_default_version)
	$BIN/h-add-web-domain-backend "$user" "$domain" "$BACKEND_TEMPLATE" "$restart"
	check_result $? "Backend error" > /dev/null
fi

# Preparing domain aliases
if [ "$aliases" = 'none' ]; then
	ALIAS=''
else
	ALIAS="www.$domain"
	if [ -z "$aliases" ]; then
		# Check and skip www alias for subdomains.
		IFS='.' read -r -a domain_elements <<< "$domain"
		if [ "${#domain_elements[@]}" -gt 2 ]; then
			is_valid_2_part_extension $domain
			if [ $? -ne 0 ]; then
				ALIAS=""
			else
				ALIAS="www.$domain"
			fi
		else
			ALIAS="www.$domain"
		fi
	else
		ALIAS="$aliases"
	fi

	ip_alias=$(get_ip_alias "$domain")
	if [ -n "$ip_alias" ]; then
		ALIAS="$ALIAS,$ip_alias"
	fi
fi

# Preparing domain variables
prepare_web_domain_values

if [ -z "$WEB_TEMPLATE" ]; then
	WEB_TEMPLATE='default'
	update_user_value "$user" '$WEB_TEMPLATE' "default"
fi

# Adding web server config (lax, see the backend template above)
read -r WEB_TEMPLATE _ <<< "$(accept_web_template 'web' "$WEB_TEMPLATE")" # effect: proxy role only
add_web_config "$WEB_SYSTEM" "$WEB_TEMPLATE.tpl"

# Adding proxy config
if [ -n "$PROXY_SYSTEM" ]; then
	PROXY_EXT="$proxy_ext"
	if [ -z "$proxy_ext" ]; then
		PROXY_EXT=$(default_proxy_ext)
	fi
	if [ -z "$PROXY_TEMPLATE" ]; then
		PROXY_TEMPLATE='default'
		update_user_value "$user" '$PROXY_TEMPLATE' "default"
	fi

	read -r PROXY_TEMPLATE proxy_tpl_effect <<< "$(accept_web_template 'proxy' "$PROXY_TEMPLATE")"
	add_web_config "$PROXY_SYSTEM" "$PROXY_TEMPLATE.tpl"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Adding domain in web.conf
echo "DOMAIN='$domain' IP='$ip' IP6='$local_ip6' CUSTOM_DOCROOT='' ALIAS='$ALIAS' TPL='$WEB_TEMPLATE'\
 SSL='no' SSL_FORCE='no' SSL_HOME='same' DOCKER='' DOCKER_PORT='' DOCKER_OCTET='' LETSENCRYPT='no' WP='' FTP_USER='' FTP_MD5=''\
 BACKEND='$BACKEND_TEMPLATE' PHP_VERSION='$PHP_VERSION' PROXY='$PROXY_TEMPLATE' PROXY_EXT='$PROXY_EXT'\
 STATS='' STATS_USER='' STATS_CRYPT='' U_DISK='0' U_BANDWIDTH='0'\
 SUSPENDED='no' TIME='$time' DATE='$date'" >> $USER_DATA/web.conf

syshealth_repair_web_config

# Counters after the record, not before: an abort between the two used to leave the box counting
# a domain that does not exist (#601).
[ -n "$local_ip" ] && increase_ip_value "$local_ip"
[ -n "$local_ip6" ] && increase_ip_value "$local_ip6"
increase_user_value "$user" '$U_WEB_DOMAINS'
increase_user_value "$user" '$U_WEB_ALIASES' "$alias_number"

# A package still carrying the old caching template means the cache switch. Output kept
# and the result checked: discarding both is how the mapping promises a feature the
# domain then does not have.
if [ "$proxy_tpl_effect" = 'cache' ]; then
	$BIN/h-add-web-domain-cache "$user" "$domain"
	check_result $? "Proxy cache setup failed" > /dev/null
fi

# Restarting web server
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

# Restarting proxy server
$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging

# first/last log on the box arms/disarms the fail2ban web jails (change-detected)
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
declare -F fail2ban_regate_web_apply > /dev/null 2>&1 || source "$HESTIA/include/fail2ban.sh"
fail2ban_regate_web_apply
$BIN/h-log-action "$user" "Info" "Web" "Added new web domain (Name: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

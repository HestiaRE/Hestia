#!/bin/bash
# info: add web domain alias
# options: USER DOMAIN ALIASES [RESTART]
#
# example: h-add-web-domain-alias admin acme.com www.acme.com yes
#
# Adds one or more aliases to a domain, wildcards (*.domain.tld) included.

user=$1
domain=$2
aliases=$3
restart="$4"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn
format_aliases

if [ -z "$aliases" ]; then
	check_result "$E_INVALID" "Invalid alias format: empty"
fi

check_args '3' "$#" 'USER DOMAIN ALIASES [RESTART]'
is_format_valid 'user' 'domain' 'aliases' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_domain_new 'web' "$aliases"
is_base_domain_owner "$aliases"

get_domain_values 'web'

local_ip=$(get_real_ip $IP)
if [ -z "$ALIAS" ]; then
	ALIAS="$aliases"
else
	ALIAS="$ALIAS,$aliases"
fi
prepare_web_domain_values

is_package_full 'WEB_ALIASES'

del_web_config "$WEB_SYSTEM" "$TPL.tpl"
add_web_config "$WEB_SYSTEM" "$TPL.tpl"

if [ -n "$PROXY_SYSTEM" ] && [ -n "$PROXY" ]; then
	del_web_config "$PROXY_SYSTEM" "$PROXY.tpl"
	add_web_config "$PROXY_SYSTEM" "$PROXY.tpl"
fi

update_object_value 'web' 'DOMAIN' "$domain" '$ALIAS' "$ALIAS"
increase_user_value "$user" '$U_WEB_ALIASES'

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Web" "Added new web domain alias (Alias: $aliases, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: Allow other users create subdomains
# options: USER DOMAIN
#
# example: h-add-web-domain-allow-users admin admin.com
#
# Lets other users create subdomains of this base domain (the panel's Share switch).
# ENFORCE_SUBDOMAIN_OWNERSHIP='no' in hestia.conf (CLI only) lifts the check box-wide.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
# is_base_domain_owner reads the flag of the base domain only; on a subdomain it would be set and never read.
get_base_domain "$domain"
if [ "$basedomain" != "$domain" ]; then
	check_result "$E_INVALID" "$domain is not a base domain, sharing is decided on $basedomain"
fi

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ -z "$ALLOW_USERS" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'ALLOW_USERS' 'TIME'
fi

update_object_value 'web' 'DOMAIN' "$domain" '$ALLOW_USERS' "yes"

$BIN/h-log-action "$user" "Warning" "Web" "Subdomain ownership enforcement disabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

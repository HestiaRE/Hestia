#!/bin/bash
# info: add web domain backend
# options: USER DOMAIN [TEMPLATE] [RESTART]
#
# example: h-add-web-domain-backend admin example.com default yes
#
# Writes the PHP-FPM pool of a web domain from its record and a pool profile.

user=$1
domain=$2
template=${3-default}
restart=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

check_args '2' "$#" 'USER DOMAIN [TEMPLATE] [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_BACKEND" 'WEB_BACKEND'
is_object_valid 'user' 'USER' "$user"
# Legacy values are mapped rather than rejected; a typo still errors out
if ! tpl_accepted=$(accept_web_template 'backend' "$template" strict); then
	is_backend_template_valid "$template"
fi
read -r template tpl_effect <<< "$tpl_accepted"

# The record first: prepare_web_backend reads PHP_VERSION.
get_domain_values 'web'

# 'none' and a docker domain mean no pool; decided here so every caller reconciles alike.
if [ "$PHP_VERSION" = 'none' ] || [ -n "$DOCKER" ]; then
	backend_type="$domain"
	delete_web_backend
	exit
fi

prepare_web_backend

if [[ -n "$BACKEND" && "$BACKEND" != "$template" ]]; then
	check_result "$E_EXISTS" "Pool already exists"
fi

backend_port=9000
ports=$(grep -v '^;' $pool/* 2> /dev/null | grep listen | grep -o :[0-9].*)
ports=$(echo "$ports" | sed "s/://" | sort -n)
for port in $ports; do
	if [ "$backend_port" -eq "$port" ]; then
		backend_port=$((backend_port + 1))
	fi
done

cat $PHPTPL/$template.tpl \
	| sed -e "s|%backend_port%|$backend_port|" \
		-e "s|%user%|$user|g" \
		-e "s|%domain%|$domain|g" \
		-e "s|%backend%|$backend_type|g" \
		-e "s|%backend_version%|$backend_version|g" > $pool/$backend_type.conf

if [ -n "$CUSTOM_DOCROOT" ]; then
	docroot="$CUSTOM_DOCROOT"
	if [ -n "$CUSTOM_PHPROOT" ]; then
		docroot="$CUSTOM_PHPROOT"
	fi
	sed -i "s|/home\/$user\/web\/$domain\/public_html|$docroot|g" $pool/$backend_type.conf
else
	docroot="$HOMEDIR/$user/web/$domain/public_html/"
fi

$BIN/h-restart-web-backend "$restart" "$backend_version"
check_result $? "PHP restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Web" "Web domain configuration applied (Domain: $domain, Backend: $WEB_BACKEND)."
log_event "$OK" "$ARGUMENTS"

exit

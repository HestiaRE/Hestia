#!/bin/bash
# info: Enable nginx proxy cache for a domain
# options: USER DOMAIN [DURATION] [RESTART]
#
# example: h-add-web-domain-cache user domain.tld 30m
#
# Enables the nginx proxy cache of a domain: one zone file per domain, a fragment inside location /.
# DURATION is <n>s, <n>m or <n>d, at most a year.

user=$1
domain=$2
duration=${3-5m}
restart=${4-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

check_args '2' "$#" 'USER DOMAIN [DURATION] [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

is_cache_duration_format_valid "$duration"

if [ "$PROXY_SYSTEM" != 'nginx' ]; then
	echo "Error: nginx proxy is not available in this web model"
	exit "$E_NOTEXIST"
fi

# shellcheck disable=SC2046  # word splitting carries the record into KEY='v' tokens
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

# Zone before fragment: a reload in between would otherwise meet a dangling zone and fail -t.
echo "proxy_cache_path /var/cache/nginx/$domain levels=1:2 use_temp_path=off keys_zone=$domain:10m inactive=60m max_size=256m;" \
	> "/etc/nginx/conf.d/cache-zone.$domain.conf"

# The bypass keeps logged-in traffic out of the cache. Every nginx variable is \$-escaped.
frag_dir="$HOMEDIR/$user/conf/web/$domain/nginx.location.d"
mkdir -p "$frag_dir"
chown root:$user "$frag_dir"
chmod 751 "$frag_dir"

cat << EOF > $frag_dir/proxy_cache.conf
proxy_cache $domain;
proxy_cache_valid 200 $duration;
proxy_cache_valid 301 302 10m;
proxy_cache_valid 404 10m;
proxy_cache_bypass \$no_cache \$cookie_session \$http_x_update;
proxy_no_cache \$no_cache;

set \$no_cache 0;

if (\$request_uri ~* "/wp-admin/|/wp-json/|wp-.*.php|xmlrpc.php|/store.*|/cart.*|/my-account.*|/checkout.*|/user/|/admin/|/administrator/|/manager/|index.php") {
	set \$no_cache 1;
}

if (\$http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart|woocommerce_cart_hash|PHPSESSID") {
	set \$no_cache 1;
}

if (\$http_cookie ~ SESS) {
	set \$no_cache 1;
}
EOF
chown root:$user $frag_dir/proxy_cache.conf
chmod 640 $frag_dir/proxy_cache.conf

# add_object_key is idempotent; a value guard would re-insert an existing empty key.
add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE' 'ALIAS'
add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE_DURATION' 'ALIAS'

update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE' 'yes'
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE_DURATION' "$duration"

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Web" "Proxy cache enabled (Domain: $domain, Duration: $duration)."
log_event "$OK" "$ARGUMENTS"

exit

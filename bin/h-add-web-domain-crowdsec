#!/bin/bash
# info: enable CrowdSec protection for a web domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: h-add-web-domain-crowdsec admin acme.com
#
# Enables the per-request CrowdSec ban check (Layer A, 403) on the domain's public
# nginx vhost. CrowdSec is nginx-gated, so nginx must be the public web server.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart="$3"
quiet="$4"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/crowdsec.sh
source $HESTIA/include/crowdsec.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# CrowdSec only enforces where nginx is the public front (nginx-only / both).
if [ -n "$PROXY_SYSTEM" ]; then pub="$PROXY_SYSTEM"; else pub="$WEB_SYSTEM"; fi
if [ "$pub" != "nginx" ]; then
	echo "Error: CrowdSec requires nginx as the public web server"
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ -z "$CROWDSEC" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'CROWDSEC' 'SUSPENDED'
fi
update_object_value 'web' 'DOMAIN' "$domain" '$CROWDSEC' 'yes'

crowdsec_render_domain_fragment "$user" "$domain"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null
$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

if [ "$quiet" != "yes" ]; then
	$BIN/h-log-action "$user" "Info" "Web" "CrowdSec protection enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

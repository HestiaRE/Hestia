#!/bin/bash
# info: add ftp account for web domain.
# options: USER DOMAIN FTP_USER FTP_PASSWORD [FTP_PATH]
#
# example: h-add-web-domain-ftp alice wonderland.com alice_ftp p4$$vvOrD
#
# Adds an FTP/SFTP sub-account of the domain, chrooted to FTP_PATH below the domain folder.

user=$1
domain=$2
# Stored as <owner>_<name>; either form is accepted, as by the delete and change-* commands.
if [[ "$3" == "${1}_"* ]]; then ftp_user="$3"; else ftp_user="${1}_${3}"; fi
password=$4
HIDE=4
ftp_path=$5

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN FTP_USER FTP_PASSWORD [FTP_PATH]'
is_format_valid 'user' 'domain' 'ftp_user'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
if getent passwd "$ftp_user" > /dev/null && [ "$FTP_USER" != "$ftp_user" ]; then
	echo "Error: ftp user $ftp_user already exists"
	log_event "$E_EXISTS" "$ARGUMENTS"
	exit "$E_EXISTS"
fi
is_password_valid

get_domain_values 'web'

shell=$(which nologin)
if [ -n "$FTP_SHELL" ]; then
	shell=$FTP_SHELL
fi

if [ -z "$ftp_path" ]; then
	ftp_path_a="$HOMEDIR/$user/web/$domain"
else
	ftp_path_a=$(readlink -f "$HOMEDIR/$user/web/$domain/$ftp_path")
	is_record_path_valid "$ftp_path_a" "$HOMEDIR/$user/web/$domain" 'ftp path'

	if [ ! -e "$ftp_path_a" ]; then
		mkdir -p "$ftp_path_a"
		chown --no-dereference $user:$user "$ftp_path_a"
		chmod 751 "$ftp_path_a"
	fi
fi

/usr/sbin/useradd $ftp_user \
	-s $shell \
	-o -u $(id -u $user) \
	-g $(id -g $user) \
	-G hestia-users \
	-M -d "$ftp_path_a" > /dev/null 2>&1

echo "$ftp_user:$password" | /usr/sbin/chpasswd

if [ $? -ne 0 ]; then
	/usr/sbin/deluser "$ftp_user" > /dev/null 2>&1
	echo "Error: Password not accepted due to PAM restrictions"
	exit 2
fi

ftp_md5=$(awk -v user=$ftp_user -F : 'user == $1 {print $2}' /etc/shadow)

$BIN/h-add-user-sftp-jail "$ftp_user"

manage_sshd_allowusers add "$ftp_user"

ftp_path_r=$(echo $ftp_path_a | sed "s%$HOMEDIR/$user/web/$domain%%")

# ftp_user becomes the stored list here, so keep the account name.
ftp_account="$ftp_user"
if [ ! -z "$FTP_USER" ]; then
	ftp_user="$FTP_USER:$ftp_user"
	ftp_md5="$FTP_MD5:$ftp_md5"
	ftp_path="$FTP_PATH:$ftp_path_r"
fi

add_object_key "web" 'DOMAIN' "$domain" 'FTP_PATH' 'PROXY'

update_object_value 'web' 'DOMAIN' "$domain" '$FTP_USER' "$ftp_user"
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_MD5' "$ftp_md5"
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_PATH' "$ftp_path"

$BIN/h-log-action "$user" "Info" "Web" "Added new FTP account (Name: $ftp_account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

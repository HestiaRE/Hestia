#!/bin/bash
# info: enable HTTP/3 (QUIC) for a domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: h-add-web-domain-http3 admin acme.com
#
# Enables HTTP/3 on the nginx front. Needs SSL and an nginx built with http_v3, which the OS nginx of deb12 and
# ub24 is not.

user=$1
domain=$2
restart="$3"
quiet="$4"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# -F: as a regex a.b.com would match aXb.com. The record supplies both gates and the fragment's IP.
# shellcheck disable=SC2046  # word splitting carries the record into KEY='v' tokens
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ "$SSL" != 'yes' ]; then
	check_result "$E_NOTEXIST" "SSL is not enabled - HTTP/3 needs a TLS vhost"
fi

# On the nginx front: the proxy in the both model, else nginx as web server. apache-only has none.
if [ "$PROXY_SYSTEM" != 'nginx' ] && [ "$WEB_SYSTEM" != 'nginx' ]; then
	check_result "$E_NOTEXIST" "HTTP/3 needs an nginx front (nginx-only or both model)"
fi

# The actual build decides: a quic listen without http_v3 fails nginx -t for the whole box.
if ! nginx_has_http3; then
	check_result "$E_NOTEXIST" "the installed nginx has no HTTP/3 (http_v3) support"
fi

# UDP/443 comes from the firewall seed, not from here: an imperative open is lost on the next firewall rebuild.
local_ip=$(get_real_ip "$IP")
add_web_http3_config "$local_ip" "$IP6"

if [ -z "$HTTP3" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'HTTP3' 'LETSENCRYPT'
fi
update_object_value 'web' 'DOMAIN' "$domain" '$HTTP3' 'yes'

# Only the nginx front carries the fragment.
if [ "$PROXY_SYSTEM" = 'nginx' ]; then
	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null
else
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null
fi

if [ "$quiet" != "yes" ]; then
	$BIN/h-log-action "$user" "Info" "Web" "HTTP/3 enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

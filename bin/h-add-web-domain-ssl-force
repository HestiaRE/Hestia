#!/bin/bash
# info: Adding force SSL for a domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: h-add-web-domain-ssl-force admin acme.com
#
# Redirects http to https for the domain.

user=$1
domain=$2
restart="$3"
quiet="$4"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

check_args '2' "$#" 'USER DOMAIN [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ "$SSL" != 'yes' ]; then
	echo "Error: SSL is not enabled"
	exit "$E_NOTEXIST"
fi

if [ -n "$PROXY_SYSTEM" ]; then
	forcessl="$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.forcessl.conf"
else
	forcessl="$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.forcessl.conf"
fi

if [ -n "$PROXY_SYSTEM" ] || [ "$WEB_SYSTEM" = 'nginx' ]; then
	echo 'return 301 https://$host$request_uri;' > $forcessl
else
	echo 'RewriteEngine On' > $forcessl
	echo 'RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]' >> $forcessl
fi

chown root:$user $forcessl
chmod 640 $forcessl

if [ -z "$SSL_FORCE" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'SSL_FORCE' 'LETSENCRYPT'
fi

update_object_value 'web' 'DOMAIN' "$domain" '$SSL_FORCE' 'yes'

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

if [ "$quiet" != "yes" ]; then
	$BIN/h-log-action "$user" "Info" "Web" "Automatic HTTPS redirection enabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

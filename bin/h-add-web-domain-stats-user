#!/bin/bash
# info: add password protection to web domain statistics
# options: USER DOMAIN STATS_USER STATS_PASSWORD [RESTART]
#
# example: h-add-web-domain-stats-user admin example.com watchdog your_password
#
# This function is used for securing the web statistics page.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
stats_user=$3
password=$4
HIDE=4
restart=$5

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER DOMAIN STATS_USER STATS_PASSWORD [RESTART]'
is_format_valid 'user' 'domain' 'stats_user' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_password_valid

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

salt=$(generate_password "$PW_MATRIX" "8")
stats_pass=$($BIN/h-generate-password-hash md5 $salt $password)
web_stats_auth_write "$stats_user" "$stats_pass"
check_result $? "stats password files not written"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Adding stats user in config
update_object_value 'web' 'DOMAIN' "$domain" '$STATS_USER' "$stats_user"
update_object_value 'web' 'DOMAIN' "$domain" '$STATS_CRYPT' "$stats_pass"

# Restarting web server
if [ "$WEB_SYSTEM" = 'nginx' ]; then
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null
fi

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Web traffic analyzer password enabled (Username: $stats_user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

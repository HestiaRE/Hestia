#!/bin/bash
# info: install a panel-managed WordPress into a web domain
# options: USER DOMAIN [LOCALE] [TITLE]
#
# example: h-add-web-domain-wordpress john blog.acme.com
# example: h-add-web-domain-wordpress john blog.acme.com de_DE "Acme Blog"
#
# Installs WordPress as the customer: the checksum-verified en_US core plus the locale as a language pack, the
# database through h-add-database, credentials only in wp-config.php, and a cron job instead of wp-cron.

user=$1
domain=$2
locale=$3
title=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

WP_BIN="/usr/local/bin/wp"

check_args '2' "$#" 'USER DOMAIN [LOCALE] [TITLE]'
is_format_valid 'user' 'domain'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

if [ -z "$(echo "$DB_SYSTEM" | grep -w 'mysql')" ]; then
	check_result "$E_NOTEXIST" "WordPress needs a MySQL database (DB_SYSTEM has no mysql)"
fi

[ -x "$WP_BIN" ] || check_result "$E_NOTEXIST" "wp-cli is not installed ($WP_BIN)"

wp_state=$(get_object_value 'web' 'DOMAIN' "$domain" '$WP')
[ "$wp_state" = "yes" ] && check_result "$E_EXISTS" "WordPress is already managed for $domain"

docker=$(get_object_value 'web' 'DOMAIN' "$domain" '$DOCKER')
[ -n "$docker" ] && check_result "$E_FORBIDEN" "$domain is a docker proxy domain"

tpl=$(get_object_value 'web' 'DOMAIN' "$domain" '$TPL')
[ "$tpl" = "no-php" ] && check_result "$E_FORBIDEN" "$domain has no PHP backend (template no-php)"

# custom docroot has its own owner semantics - a managed install must live in the default path
custom_docroot=$(get_object_value 'web' 'DOMAIN' "$domain" '$CUSTOM_DOCROOT')
[ -n "$custom_docroot" ] && check_result "$E_FORBIDEN" "$domain uses a custom docroot"

docroot="$HOMEDIR/$user/web/$domain/public_html"
[ -d "$docroot" ] || check_result "$E_NOTEXIST" "docroot $docroot does not exist"

# Never over an existing site; the shipped skeleton has none of these.
if [ -e "$docroot/wp-config.php" ] || [ -e "$docroot/wp-includes" ] || [ -e "$docroot/index.php" ]; then
	check_result "$E_EXISTS" "docroot is not empty ($domain already serves an application)"
fi

# needed as the WP admin address below - fail here with a name, not inside core install
admin_email=$(get_user_value '$CONTACT')
[ -n "$admin_email" ] || check_result "$E_INVALID" "user $user has no CONTACT email - set one first"

# user_exec children start in OUR cwd; a root-only cwd makes find/tar warn on exit
cd "$HOMEDIR/$user" || check_result "$E_NOTEXIST" "user homedir missing"

# The argument, else the panel language; a wrong guess only costs the language pack.
if [ -z "$locale" ]; then
	user_lang=$(get_user_value '$LANGUAGE')
	case "$user_lang" in
		de) locale="de_DE" ;;
		en | '') locale="en_US" ;;
		fr) locale="fr_FR" ;;
		es) locale="es_ES" ;;
		it) locale="it_IT" ;;
		nl) locale="nl_NL" ;;
		pt) locale="pt_BR" ;;
		*) locale="en_US" ;;
	esac
fi
[[ "$locale" =~ ^[a-z]{2,3}(_[A-Z]{2})?$ ]] || check_result "$E_INVALID" "invalid locale '$locale'"

[ -n "$title" ] || title="$domain"

wp_php=$(wp_domain_php "$domain")

wp_user() {
	user_exec env HOME="$HOMEDIR/$user" timeout 600 "$wp_php" "$WP_BIN" "$@" --path="$docroot"
}

# DB name deterministic per domain; the password lives only in wp-config.php afterwards.
db_suffix="wp_$(echo "$domain" | md5sum | cut -c1-8)"
db_pass=$(generate_password)
# h-add-database takes the suffix, everything else (incl. h-delete-database) the full name
db_name="${user}_${db_suffix}"
db_user="${user}_${db_suffix}"
# The password travels as a private file, out of argv; the name's length is h-add-database's to judge.
db_pass_file=$(mktemp /tmp/hestia-wp.XXXXXXXX) || check_result "$E_DISK" "no temp file for the database password"
printf '%s\n' "$db_pass" > "$db_pass_file"
db_out=$($BIN/h-add-database "$user" "$db_suffix" "$db_suffix" "$db_pass_file")
db_rc=$?
rm -f "$db_pass_file"
check_result "$db_rc" "database creation failed: $db_out"

cleanup_failed_install() {
	$BIN/h-delete-database "$user" "$db_name" > /dev/null 2>&1
	user_exec rm -rf "$docroot/wp-admin" "$docroot/wp-includes" "$docroot/wp-content" 2> /dev/null
	user_exec find "$docroot" -maxdepth 1 -name "wp-*.php" -delete 2> /dev/null
	user_exec rm -f "$docroot/index.php" "$docroot/xmlrpc.php" "$docroot/license.txt" "$docroot/readme.html" 2> /dev/null
}

# Own bounded download and the system tar: wp-cli's PharData extractor silently drops files. verify-checksums
# stays the proof.
wp_ver=$(curl -fsS --max-time 30 "https://api.wordpress.org/core/version-check/1.7/" | jq -r '.offers[0].current' 2> /dev/null)
if ! [[ "$wp_ver" =~ ^[0-9]+\.[0-9.]+$ ]]; then
	cleanup_failed_install
	check_result "$E_CONNECT" "could not determine the current WordPress version"
fi
echo "[ * ] Downloading WordPress $wp_ver..."
wp_tmp=$(mktemp -t wordpress.XXXXXX.tar.gz)
chmod 644 "$wp_tmp"
if ! wget "https://wordpress.org/wordpress-${wp_ver}.tar.gz" --timeout=60 --tries=3 --retry-connrefused --quiet -O "$wp_tmp" \
	|| [ ! -s "$wp_tmp" ] \
	|| ! user_exec tar -xzf "$wp_tmp" --strip-components=1 -C "$docroot" \
	|| ! wp_user core verify-checksums --locale=en_US --quiet; then
	rm -f "$wp_tmp"
	cleanup_failed_install
	check_result "$E_CONNECT" "WordPress download/verification failed - nothing was installed"
fi
rm -f "$wp_tmp"

echo "[ * ] Configuring..."
# Passwords through --prompt on stdin, never argv.
if ! printf '%s\n' "$db_pass" \
	| wp_user config create --dbname="$db_name" --dbuser="$db_user" --prompt=dbpass --quiet \
	|| ! wp_user config set DISABLE_WP_CRON true --raw --type=constant --quiet; then
	cleanup_failed_install
	check_result "$E_UPDATE" "WordPress configuration failed - nothing was installed"
fi

# scheme follows the domain's current SSL state; WordPress carries the URL in its options
scheme="http"
[ "$(get_object_value 'web' 'DOMAIN' "$domain" '$SSL')" = "yes" ] && scheme="https"

admin_pass=$(generate_password)

echo "[ * ] Installing..."
if ! printf '%s\n' "$admin_pass" \
	| wp_user core install --url="$scheme://$domain" --title="$title" \
		--admin_user="$user" --admin_email="$admin_email" --prompt=admin_password \
		--skip-email --quiet; then
	cleanup_failed_install
	check_result "$E_UPDATE" "WordPress install failed - nothing was installed"
fi

# A failed language pack only costs the translation.
if [ "$locale" != "en_US" ]; then
	wp_user language core install "$locale" --activate --quiet \
		|| echo "WARN: language pack $locale could not be installed - site stays en_US"
fi

# nginx-only serves permalinks through its own template, apache through .htaccess. A custom template stays.
if [ "$WEB_SYSTEM" = "nginx" ] && [ -z "$PROXY_SYSTEM" ] && [ "$tpl" = "default" ]; then
	$BIN/h-change-web-domain-tpl "$user" "$domain" "wordpress-disable-xmlrpc" > /dev/null
	check_result $? "template switch failed"
fi

# Seeded: WordPress writes no .htaccess from the CLI, and permalinks set through wp-cli would 404.
if [ "$WEB_SYSTEM" = "apache2" ]; then
	user_exec rm -f "$docroot/.htaccess"
	user_exec tee "$docroot/.htaccess" > /dev/null << 'HTACCESS'
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
HTACCESS
fi

# deterministic cron instead of pageview-triggered wp-cron (DISABLE_WP_CRON is set above)
wp_cron_sync "$domain" \
	|| echo "WARN: could not add the wp-cron entry (CRON quota?) - scheduled WP tasks will not run"

# the record field says only "panel-managed"; add_object_key is idempotent on key presence
add_object_key "web" 'DOMAIN' "$domain" 'WP' 'LETSENCRYPT'
update_object_value 'web' 'DOMAIN' "$domain" '$WP' "yes"

$BIN/h-log-action "$user" "Info" "Web" "WordPress installed (Domain: $domain, Locale: $locale)."
log_event "$OK" "$ARGUMENTS"

echo "WordPress installed: $scheme://$domain/"
echo "  Admin login: $scheme://$domain/wp-login.php"
echo "  Admin user:  $user"
echo "  Admin pass:  $admin_pass"
echo "  (shown once - not stored anywhere)"

exit

#!/bin/bash
# info: add php fpm version
# options: VERSION
#
# example: h-add-web-php 8.0
#
# Installs one PHP version (FPM, CLI and the module set) for customer use. Re-running it configures again.

version=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/limits.sh
source $HESTIA/include/limits.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'VERSION'

if [ -z "$WEB_BACKEND" ]; then
	echo "Multiple php versions are not supported for modphp"
fi

if [[ ! $version =~ ^[0-9]+\.[0-9]+$ ]]; then
	echo "The specified PHP version format is invalid, it should look like [0-9].[0-9]."
	echo "Example: 7.0, 7.4, 8.0"
	exit "$E_INVALID"
fi

# No "already installed" abort: at install the panel version is there before the loop that gives it its extensions.

readarray -t php_supported < <(manifest_get '.software_versions.php_supported[]')
if [[ " ${php_supported[*]} " != *" $version "* ]]; then
	echo "ERROR: Specified PHP version is not supported or does not exist."
	exit "$E_INVALID"
fi

# A version the configured repos cannot install arms Sury. Fresh lists first, and a failed update stops here: a
# mirror outage read as "not available" would put Sury on a box whose preset promises none.
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -qq update || check_result "$E_CONNECT" "apt-get update failed - cannot judge package availability"
# Only a missing candidate means "not in these repos"; a failing simulation can be a held or broken package.
candidate=$(LC_ALL=C apt-cache policy "php$version-fpm" 2> /dev/null | awk '/Candidate:/{print $2}')
if [ -z "$candidate" ] || [ "$candidate" = "(none)" ]; then
	# shellcheck source=/usr/local/hestia/include/helper.sh
	source "$HESTIA/include/helper.sh"
	codename=$(
		. /etc/os-release
		echo "$VERSION_CODENAME"
	)
	echo "php$version is not available from the configured repos - adding the Sury repo"
	add_sury_repo "$codename" || check_result "$E_CONNECT" "Sury repo setup failed"
	# The status follows the repo, not the install result: Sury takes over the OS version on the next apt run.
	change_sys_value "PHP_SOURCE" "sury"

	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -qq update || check_result "$E_CONNECT" "apt-get update failed after adding the Sury repo"
fi

# opcache has no package from 8.5 on, so a missing one drops loudly; cli and fpm must survive the filter.
# shellcheck source=/usr/local/hestia/include/helper.sh
command -v php_module_pkgs > /dev/null 2>&1 || source "$HESTIA/include/helper.sh"
# shellcheck disable=SC2046
mph=$(filter_installable_php_pkgs "opcache:8.5" $(php_module_pkgs "$version")) \
	|| check_result "$E_CONNECT" "package availability probe failed - repos unreachable or broken"
case " $mph " in *" php$version-fpm "*) ;; *)
	check_result "$E_NOTEXIST" "php$version-fpm is not installable from the configured repos"
	;;
esac
case " $mph " in *" php$version-cli "*) ;; *)
	check_result "$E_NOTEXIST" "php$version-cli is not installable from the configured repos"
	;;
esac

# Not /dev/null: a failure has to leave something to read.
apt_log=$(mktemp)
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq -o Dpkg::Options::="--force-confold" install $mph > "$apt_log" 2>&1 &

BACK_PID=$!

echo "Installing PHP-$version, please wait..."
spinner="/-\|"
spin_i=1
while kill -0 $BACK_PID > /dev/null 2>&1; do
	[ -t 1 ] && printf "\b${spinner:spin_i++%${#spinner}:1}"
	sleep 0.5
done

wait "$BACK_PID"
apt_rc=$?

echo

# Asked of the whole requested list: the panel stage may already have installed part of this version.
missing=""
for _p in $mph; do
	[ "$(dpkg-query -W -f='${db:Status-Status}' "$_p" 2> /dev/null)" = installed ] || missing="$missing $_p"
done
if [ "$apt_rc" -ne 0 ] || [ -n "$missing" ]; then
	echo "ERROR: Installation failed, please run the following command manually for debugging:"
	echo "apt-get install $mph"
	[ "$apt_rc" -ne 0 ] && echo "apt exited $apt_rc"
	[ -n "$missing" ] && echo "not installed:$missing"
	sed -n '$p' "$apt_log" 2> /dev/null
	rm -f "$apt_log"
	exit "$E_INVALID"
fi
rm -f "$apt_log"

if [ "$WEB_SYSTEM" = "apache2" ]; then
	mods_changed=""
	if ! a2query -q -m proxy_fcgi; then
		a2enmod -q proxy_fcgi && mods_changed=yes
	fi
	if ! a2query -q -m setenvif; then
		a2enmod -q setenvif && mods_changed=yes
	fi
	[ -n "$mods_changed" ] && $BIN/h-restart-web "yes"
fi

# Only the distro pool goes: a re-run on a live version keeps the customer pools.
update-rc.d php$version-fpm defaults > /dev/null 2>&1
rm -f /etc/php/$version/fpm/pool.d/www.conf
cp -f $HESTIA/share/php-fpm/dummy.conf /etc/php/$version/fpm/pool.d/
sed -i "s/%backend_version%/$version/g" /etc/php/$version/fpm/pool.d/dummy.conf
cp -f $HESTIA/share/php-fpm/php-fpm.conf /etc/php/$version/fpm/
sed -i "s/fpm_v/$version/g" /etc/php/$version/fpm/php-fpm.conf

sed -i "s/upload_max_filesize = 2M/upload_max_filesize = 100M/g" /etc/php/$version/fpm/php.ini
sed -i "s/post_max_size = 8M/post_max_size = 100M/g" /etc/php/$version/fpm/php.ini
sed -i "s/max_execution_time = 30/max_execution_time = 60/g" /etc/php/$version/fpm/php.ini
sed -i "s/;max_input_vars = 1000/max_input_vars = 4000/g" /etc/php/$version/fpm/php.ini

sed -i "s/disable_functions =.*/disable_functions = pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wifcontinued,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority,exec,system,passthru,shell_exec,proc_open,popen/g" /etc/php/$version/fpm/php.ini

# The CLI stays open: occ and the Magento indexers fork, and the FPM list above is what faces the web.
sed -i "s/^disable_functions =.*/disable_functions =/" /etc/php/$version/cli/php.ini

sed -i "s/;opcache.enable=1/opcache.enable=1/g" /etc/php/$version/fpm/php.ini
sed -i "s/;opcache.memory_consumption=128/opcache.memory_consumption=512/g" /etc/php/$version/fpm/php.ini
sed -i "s/;opcache.max_accelerated_files=10000/opcache.max_accelerated_files=100000/g" /etc/php/$version/fpm/php.ini

# Only a warning: the version itself is usable, and the smoke names one without the loader.
if [ -n "${IONCUBE_SYSTEM:-}" ]; then
	# shellcheck source=/usr/local/hestia/include/ioncube.sh
	source "$HESTIA/include/ioncube.sh"
	ioncube_fetch && ioncube_version_apply "$version"
	case $? in
		0) ;;
		3) echo "WARNING: ionCube ships no loader for PHP $version, skipped" ;;
		*) echo "WARNING: ionCube could not be enabled for PHP $version, run h-add-sys-ioncube" ;;
	esac
fi

# The whole apply, not this version's drop-in alone: it also restarts the master apt just started outside the slice.
customer_php_limit_apply

# A stale per-version pool profile would reappear in the selector.
rm -f "$PHPTPL/PHP-${version/\./_}.tpl"

# A failed record fails the command although the version is installed: a silent status gap is worse.
sys_key_token_set PHP_VERSIONS add "$version" > /dev/null || check_result "$E_UPDATE" "PHP_VERSIONS: could not record $version"

$BIN/h-log-action "system" "Info" "System" "Installed PHP $version."
log_event "$OK" "$ARGUMENTS"

exit

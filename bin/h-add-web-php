#!/bin/bash
# info: add php fpm version
# options: VERSION
#
# example: h-add-web-php 8.0
#
# Install php-fpm for provided version.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/limits.sh
source $HESTIA/include/limits.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'VERSION'

if [ -z "$WEB_BACKEND" ]; then
	echo "Multiple php versions are not supported for modphp"
fi

# Set file locations
php_fpm="/etc/init.d/php$version-fpm"

# Verify php version format
if [[ ! $version =~ ^[0-9]+\.[0-9]+ ]]; then
	echo "The specified PHP version format is invalid, it should look like [0-9].[0-9]."
	echo "Example: 7.0, 7.4, 8.0"
	exit "$E_INVALID"
fi

# No "already installed" abort: the panel version is apt-installed before the multi-PHP loop
# reaches it, and that run is what gives it the full extension set. Re-running configures.

# Check if php version is supported (release manifest, share/manifest.json)
readarray -t php_supported < <(manifest_get '.software_versions.php_supported[]')
if [[ " ${php_supported[*]} " != *" $version "* ]]; then
	echo "ERROR: Specified PHP version is not supported or does not exist."
	exit "$E_INVALID"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

mph="php$version-common php$version-mbstring php$version-bcmath php$version-cli php$version-curl
     php$version-fpm php$version-gd php$version-gmp php$version-intl php$version-mysql
     php$version-soap php$version-xml php$version-zip php$version-json php$version-bz2
     php$version-pspell php$version-imagick php$version-pgsql php$version-imap php$version-ldap php$version-apcu
     php$version-sqlite3"
# Both DB drivers unconditionally: DB_SYSTEM is empty until the db stage, which runs after this
# command, and adding pgsql later backfills nothing either. 455 KB and 276 KB, no server dependency.

# Check if version is 7.1 or below to add mcrypt
if [[ $(echo "$version 7.2" | awk '{print ($1 < $2)}') == 1 ]]; then
	mph="$mph php$version-mcrypt"
fi

# Check if version is 8.0 or higher and drop json
if [[ ${version:0:1} == "8" ]]; then
	mph=$(echo "$mph" | sed -e "s/php$version-json//")
fi

# Sury retrofit (#191): an os_single box carries no Sury repo. Asking for a version
# the configured repos cannot install IS the retrofit path - arm Sury then. Keyed on
# installability, not on a recorded mode: a hand-removed repo heals the same way.
# Fresh lists first, or a stale cache turns an installable OS version into a retrofit -
# and a FAILED update must stop here: reading a mirror outage as "not available" would
# permanently put Sury on a box whose preset promises none.
apt-get -qq update || check_result "$E_CONNECT" "apt-get update failed - cannot judge package availability"
if ! apt-get -qq -s install "php$version-fpm" > /dev/null 2>&1; then
	# shellcheck source=/usr/local/hestia/include/helper.sh
	source "$HESTIA/include/helper.sh"
	codename=$(
		. /etc/os-release
		echo "$VERSION_CODENAME"
	)
	echo "php$version is not available from the configured repos - adding the Sury repo"
	add_sury_repo "$codename" || check_result "$E_CONNECT" "Sury repo setup failed"
	# From here the box IS a Sury box, whatever the recipe promised: the repo also carries the OS version
	# and takes it over on the next apt run. So the status follows the retrofit, not the install result.
	change_sys_value "PHP_SOURCE" "sury"

	apt-get -qq update || check_result "$E_CONNECT" "apt-get update failed after adding the Sury repo"
fi

# Some names exist in no repo at all (imap has no package from 8.4 on): drop them
# loudly instead of failing the whole install, but cli+fpm must survive the filter.
# shellcheck source=/usr/local/hestia/include/helper.sh
command -v filter_installable_php_pkgs > /dev/null 2>&1 || source "$HESTIA/include/helper.sh"
# shellcheck disable=SC2086
mph=$(filter_installable_php_pkgs "imap:8.4 opcache:8.5 exif" $mph) \
	|| check_result "$E_CONNECT" "package availability probe failed - repos unreachable or broken"
case " $mph " in *" php$version-fpm "*) ;; *)
	check_result "$E_NOTEXIST" "php$version-fpm is not installable from the configured repos"
	;;
esac
case " $mph " in *" php$version-cli "*) ;; *)
	check_result "$E_NOTEXIST" "php$version-cli is not installable from the configured repos"
	;;
esac

# Install php packages
apt-get -y -qq -o Dpkg::Options::="--force-confold" install $mph > /dev/null 2>&1 &

BACK_PID=$!

# Check if package installation is done, print a spinner
echo "Installing PHP-$version, please wait..."
spinner="/-\|"
spin_i=1
while kill -0 $BACK_PID > /dev/null 2>&1; do
	printf "\b${spinner:spin_i++%${#spinner}:1}"
	sleep 0.5
done

# Do a blank echo to get the \n back
echo

# Check if installation was successful — abort instead of reporting success, so
# callers (h-change-sys-panel-php, the installer multi-PHP loop, direct users) can
# detect a failed apt run rather than continuing on a half-installed version.
if [ ! -f "$php_fpm" ]; then
	echo "ERROR: Installation failed, please run the following command manually for debugging:"
	echo "apt-get install $mph"
	exit "$E_INVALID"
fi

# Check if required modules for apache2 are enabled
if [ "$WEB_SYSTEM" = "apache2" ]; then
	if ! a2query -q -m proxy_fcgi; then
		a2enmod -q proxy_fcgi
	fi
	if ! a2query -q -m setenvif; then
		a2enmod -q setenvif
	fi
	$BIN/h-restart-web "yes"
fi

# Configure fpm. Only the distro pool goes: a re-run on a live version must not take the
# customer pools with it (the command is idempotent now, so that path is reachable).
update-rc.d php$version-fpm defaults > /dev/null 2>&1
rm -f /etc/php/$version/fpm/pool.d/www.conf
cp -f $HESTIA/share/php-fpm/dummy.conf /etc/php/$version/fpm/pool.d/
sed -i "s/%backend_version%/$version/g" /etc/php/$version/fpm/pool.d/dummy.conf
cp -f $HESTIA/share/php-fpm/php-fpm.conf /etc/php/$version/fpm/
sed -i "s/fpm_v/$version/g" /etc/php/$version/fpm/php-fpm.conf

# Increase max upload and max post size
sed -i "s/upload_max_filesize = 2M/upload_max_filesize = 100M/g" /etc/php/$version/fpm/php.ini
sed -i "s/post_max_size = 8M/post_max_size = 100M/g" /etc/php/$version/fpm/php.ini
sed -i "s/max_execution_time = 30/max_execution_time = 60/g" /etc/php/$version/fpm/php.ini
sed -i "s/;max_input_vars = 1000/max_input_vars = 4000/g" /etc/php/$version/fpm/php.ini

# Disable exec and other harmfull php functions
sed -i "s/disable_functions =.*/disable_functions = pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wifcontinued,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority,exec,system,passthru,shell_exec,proc_open,popen/g" /etc/php/$version/fpm/php.ini

sed -i "s/disable_functions =.*/disable_functions = pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wifcontinued,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority/g" /etc/php/$version/cli/php.ini

# Other use full changes
sed -i "s/;opcache.enable=1/opcache.enable=1/g" /etc/php/$version/fpm/php.ini
sed -i "s/;opcache.memory_consumption=128/opcache.memory_consumption=512/g" /etc/php/$version/fpm/php.ini
sed -i "s/;opcache.max_accelerated_files=10000/opcache.max_accelerated_files=100000/g" /etc/php/$version/fpm/php.ini

# Into the customer PHP slice (#212). The whole apply, not just this version's drop-in:
# the units may not exist yet on a box updated into this, and it restarts only the masters
# actually outside the slice - here, the one apt just started.
customer_php_limit_apply

# No per-version pool profile anymore (#591/#620): the version is the PHP_VERSION field, the
# profile set is default/small/high. Sweep a stale one so a reinstall heals the selector too.
rm -f "$PHPTPL/PHP-${version/\./_}.tpl"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# The version is on the box now, so the status says so; a re-run adds nothing twice (#933).
# The stricter of two answers, on purpose: if the record fails, the command fails although the version is
# installed. The status is part of the job, and a silent gap here is worse than a loud one; the packages
# stay, a re-run records them.
sys_key_token_set PHP_VERSIONS add "$version" > /dev/null || check_result "$E_UPDATE" "PHP_VERSIONS: could not record $version"

# Logging
$BIN/h-log-action "system" "Info" "System" "Installed PHP $version."
log_event "$OK" "$ARGUMENTS"

exit

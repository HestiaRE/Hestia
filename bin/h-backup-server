#!/bin/bash
# info: back up the state that belongs to the box, not to a customer
# options: [COMPONENT...]
#
# example: h-backup-server
# example: h-backup-server webmail
#
# The webmail store may be mysql or the sqlite fallback; both hold the same thing and both are taken.
#
# The webmail databases hold every mailbox's identities, address books and settings in one table
# set, so no per-customer archive can carry them without carrying other customers' rows. Same for
# hestia.conf, the hosting packages and the firewall sources: they describe the box.
#
# Named components take only those; with none, everything this box has. What it HAS is derived -
# a webmail that is not installed produces no component rather than an empty one.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

available=$(server_components | cut -f1)
if [ -z "$available" ]; then
	check_result "$E_NOTEXIST" "this host has none of the components a server backup carries"
fi

wanted="$available"
if [ "$#" -gt 0 ]; then
	wanted=''
	for arg in "$@"; do
		is_object_format_valid "$arg" 'component'
		if ! grep -qxF "$arg" <<< "$available"; then
			check_result "$E_NOTEXIST" "no component $arg on this host - have: $(tr '\n' ' ' <<< "$available")"
		fi
		wanted="$wanted$arg"$'\n'
	done
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

stamp=$(date +%F_%H-%M-%S)
backup_stamp_settle
tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT
# 0700 from the start: /etc/roundcube carries des_key and the database password, so the tree is
# never world readable, not even for the moment between writing and packing.
chmod 700 "$tmpdir"

mkdir -p "$tmpdir/hestia"
# Staging for anything that must be built before it is packed. Inside tmpdir so the trap takes it,
# but removed before the tar so a leftover can never become an archive member.
mkdir -p "$tmpdir/.stage"
backup_write_origin "$tmpdir/hestia/origin"

echo "-- SERVER BACKUP --"
while IFS= read -r component; do
	[ -n "$component" ] || continue
	dest="$tmpdir/server/$component"
	mkdir -p "$dest"
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		case "$item" in
			dir:*)
				src="${item#dir:}"
				# --numeric-owner nowhere, as everywhere else here: the restore resolves by name.
				tar -cf - -C "$(dirname "$src")" "$(basename "$src")" 2> /dev/null \
					| backup_compress > "$dest/$(basename "$src").tar.$(backup_codec_suffix)"
				_rc=("${PIPESTATUS[@]}")
				# tar 1 is a file that changed while read: the archive is whole, only that file is a snapshot.
				[ "${_rc[0]}" -le 1 ] && [ "${_rc[1]}" -eq 0 ] \
					|| check_result "$E_PARSING" "$src could not be archived, no server backup written"
				echo "$(date '+%F %T') $component: $src"
				;;
			sqlite:*)
				src="${item#sqlite:}"
				# Not everything named *.db in the store directory is a store. A stray file must not
				# be able to stop the whole archive - that reaction belongs to a real store that
				# cannot be secured, not to a foreign file with a matching suffix.
				if ! sqlite_is_db "$src"; then
					echo "Warning!: $component: $src is not a sqlite database - not backed up"
					continue
				fi
				snap="$tmpdir/.stage/snap.db"
				sqlite_snapshot "$src" "$snap"
				case $? in
					0) ;;
					2)
						# No client: copy it anyway - some backup beats none, and the original is
						# untouched either way - but never silently, because the copy may have
						# missed commits that are already durable.
						cp -f -- "$src" "$snap" 2> /dev/null \
							&& echo "Warning!: $component: sqlite3 is missing, $src copied without a consistency guarantee"
						;;
					*) check_result "$E_PARSING" "the sqlite snapshot of $src failed - no archive written" ;;
				esac
				backup_compress < "$snap" > "$dest/$(basename "$src").sqlite.$(backup_codec_suffix)"
				rm -f "$snap"
				echo "$(date '+%F %T') $component: $src"
				;;
			db:mysql:*)
				db="${item##*:}"
				dump="$dest/$db.mysql.sql.$(backup_codec_suffix)"
				# --add-drop-table spelled out although --opt implies it: a [mysqldump] section
				# with skip-opt turns it off, and a dump that only adds tables restores as a merge.
				mysqldump --add-drop-table --routines --triggers --single-transaction "$db" 2> /dev/null \
					| backup_compress > "$dump"
				# A half-written dump is worse than none: the restore drops the target before it
				# loads. Refuse the whole archive rather than ship one component that lies.
				if ! backup_dump_complete "$dump"; then
					check_result "$E_PARSING" "the dump of database $db did not finish - no archive written"
				fi
				echo "$(date '+%F %T') $component: database $db"
				;;
		esac
	done < <(tr ' ' '\n' <<< "$(server_component_items "$component")")
done < <(printf '%s\n' "$wanted")

archive="$BACKUP/server.$stamp.tar"
rm -rf "$tmpdir/.stage"
tar -cf "$archive" -C "$tmpdir" . || {
	rm -f "$archive"
	check_result "$E_DISK" "$archive could not be written"
}
# The archive carries the webmail secrets, so it is root's alone - unlike a user archive, which the
# customer may fetch.
chown root:root "$archive"
chmod 600 "$archive"
echo "$(date '+%F %T') -> $archive ($(($(stat -c %s "$archive") / 1024)) KB)"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "Backup" "Server backup created ($(basename "$archive"))."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: stage a restic run - metadata into the package directory, raw dumps into the home
# options: USER
#
# example: h-backup-user-config admin
#
# Readable metadata into the package directory, raw database dumps into $HOMEDIR/$user/.dumps.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

start_time=$(date '+%s')

# Derived, never arguments: both are removed as root below.
tmpdir=$(restic_meta_dir "$user")
dumpdir=$(restic_dump_dir "$user")

rm -rf "$tmpdir" "$dumpdir"
mkdir -p "$tmpdir" "$dumpdir"
# Visible but not enterable.
chown root:root "$dumpdir"
chmod 0700 "$dumpdir"

backup_user_dir "$user"

echo "-- SYSTEM --" | tee $BACKUP/$user/$user.log
mkdir -p $tmpdir/hestia

echo -e "$(date "+%F %T") $user.conf" | tee -a $BACKUP/$user/$user.log
cp -r $USER_DATA/user.conf $tmpdir/hestia/
cp -r $USER_DATA/ssl $tmpdir/hestia/

if [ -e "$USER_DATA/stats.log" ]; then
	echo -e "$(date "+%F %T") stats.log" | tee -a $BACKUP/$user/$user.log
	cp -r $USER_DATA/stats.log $tmpdir/hestia/
fi

if [ -e "$USER_DATA/history.log" ]; then
	echo -e "$(date "+%F %T") history.log" | tee -a $BACKUP/$user/$user.log
	cp -r $USER_DATA/history.log $tmpdir/hestia/
fi

if [ -e "$USER_DATA/backup-excludes.conf" ]; then
	echo -e "$(date "+%F %T") backup-excludes.conf" | tee -a $BACKUP/$user/$user.log
	cp -r $USER_DATA/backup-excludes.conf $tmpdir/hestia/
fi

mkdir -p $tmpdir/pam
echo -e "$(date "+%F %T") pam" | tee -a $BACKUP/$user/$user.log
awk -F : -v u="$user" '$1 == u' /etc/passwd > $tmpdir/pam/passwd
awk -F : -v u="$user" '$1 == u' /etc/shadow > $tmpdir/pam/shadow
awk -F : -v u="$user" '$1 == u' /etc/group > $tmpdir/pam/group
echo

if [ -e "$USER_DATA/backup-excludes.conf" ]; then
	source_conf "$USER_DATA/backup-excludes.conf"
fi

if [ -n "$WEB_SYSTEM" ] && [ "$WEB" != '*' ]; then
	echo -e "\n-- WEB --" | tee -a $BACKUP/$user/$user.log
	mkdir -p $tmpdir/web/

	conf="$USER_DATA/web.conf"
	for domain in $(search_objects 'web' 'SUSPENDED' "*" 'DOMAIN'); do
		exclusion=$(echo -e "$WEB" | tr ',' '\n' | awk -v d="$domain" '$0 == d || $0 == "*"')
		if [ -z "$exclusion" ]; then
			web_list="$web_list $domain"
		else
			echo "$(date "+%F %T") excluding $domain" | tee -a $BACKUP/$user/$user.log
		fi
	done
	web_list=$(echo "$web_list" | sed -e "s/  */\ /g" -e "s/^ //")

	i=0

	for domain in $web_list; do
		check_backup_conditions
		((i++))
		echo -e "$(date "+%F %T") $domain" | tee -a $BACKUP/$user/$user.log
		mkdir -p -p $tmpdir/web/$domain/conf
		mkdir -p -p $tmpdir/web/$domain/hestia

		domain_idn=$domain
		format_domain_idn
		get_domain_values 'web'

		cd $tmpdir/web/$domain/
		conf="$USER_DATA/web.conf"
		grep -F "DOMAIN='$domain'" $conf > hestia/web.conf

		if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf" ]; then
			cp $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf* conf/
		elif [ -e "$HOMEDIR/$user/conf/web/$domain.$WEB_SYSTEM.conf" ]; then
			cp $HOMEDIR/$user/conf/web/$domain.$WEB_SYSTEM.conf* conf/
		else
			# legacy format: all domain configs in single file
			tpl_file=$(web_template_file "$WEB_SYSTEM" "$TPL" 'tpl')
			conf="$HOMEDIR/$user/conf/web/$WEB_SYSTEM.conf"
			get_web_config_lines "$tpl_file" "$conf"
			sed -n "$top_line,$bottom_line p" $conf > conf/$WEB_SYSTEM.conf
		fi

		if [ "$SSL" = 'yes' ]; then
			if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf* conf/
			elif [ -e "$HOMEDIR/$user/conf/web/$domain.$WEB_SYSTEM.ssl.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain.$WEB_SYSTEM.ssl.conf* conf/
			else
				# Merged templates keep the SSL block in the .conf; only the include fragments exist beside it.
				cp $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf_* conf/ 2> /dev/null || true
			fi
		fi

		if [ -n "$PROXY_SYSTEM" ] && [ -n "$PROXY" ]; then
			if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf* conf/
			elif [ -e "$HOMEDIR/$user/conf/web/$domain.$PROXY_SYSTEM.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain.$PROXY_SYSTEM.conf* conf/
			else
				# legacy format: all domain configs in single file
				tpl_file=$(web_template_file "$PROXY_SYSTEM" "$PROXY" 'tpl')
				conf="$HOMEDIR/$user/conf/web/$PROXY_SYSTEM.conf"
				get_web_config_lines "$tpl_file" "$conf"
				sed -n "$top_line,$bottom_line p" $conf > conf/$PROXY_SYSTEM.conf
			fi
		fi

		if [ -n "$PROXY_SYSTEM" ] && [ -n "$PROXY" ] && [ "$SSL" = 'yes' ]; then
			if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf* conf/
			elif [ -e "$HOMEDIR/$user/conf/web/$domain.$PROXY_SYSTEM.ssl.conf" ]; then
				cp $HOMEDIR/$user/conf/web/$domain.$PROXY_SYSTEM.ssl.conf* conf/
			else
				# Merged templates keep the SSL block in the .conf; only the include fragments exist beside it.
				cp $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf_* conf/ 2> /dev/null || true
			fi
		fi

		# No template/ copy in the archive, as in h-backup-user.

		if [ "$SSL" = 'yes' ]; then
			cp $HOMEDIR/$user/conf/web/$domain/ssl/$domain.* conf/
			cp $USER_DATA/ssl/$domain.* hestia/
		fi
	done

	if [ "$i" -eq 1 ]; then
		echo -e "$(date "+%F %T") *** $i domain ***" | tee -a $BACKUP/$user/$user.log
	else
		echo -e "$(date "+%F %T") *** $i domains ***" | tee -a $BACKUP/$user/$user.log
	fi
fi

if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL" != '*' ]; then
	echo -e "\n-- MAIL --" | tee -a $BACKUP/$user/$user.log
	mkdir -p $tmpdir/mail/

	conf="$USER_DATA/mail.conf"
	for domain in $(search_objects 'mail' 'SUSPENDED' "*" 'DOMAIN'); do
		check_exl=$(echo "$MAIL" | tr ',' '\n' | grep -Fx -- "$domain")
		if [ -z "$check_exl" ]; then
			mail_list="$mail_list $domain"
		else
			echo "$(date "+%F %T") excluding $domain" | tee -a $BACKUP/$user/$user.log
		fi
	done
	mail_list=$(echo "$mail_list" | sed -e "s/  */\ /g" -e "s/^ //")

	i=0
	for domain in $mail_list; do
		check_backup_conditions
		((i++))
		echo -e "$(date "+%F %T") $domain" | tee -a $BACKUP/$user/$user.log
		mkdir -p $tmpdir/mail/$domain/conf
		mkdir -p $tmpdir/mail/$domain/hestia
		domain_idn=$domain
		format_domain_idn

		if [[ "$MAIL_SYSTEM" =~ exim ]]; then
			cd $tmpdir/mail/$domain/
			cp -r $HOMEDIR/$user/conf/mail/$domain/* conf/
		fi

		conf="$USER_DATA/mail.conf"
		grep -F "DOMAIN='$domain'" $conf > hestia/mail.conf
		cp $USER_DATA/mail/$domain.* hestia/
		# compgen, not `ls | grep *@$domain`: the glob would expand against the working directory.
		if compgen -G "$USER_DATA/mail/*@$domain.*" > /dev/null; then
			cp $USER_DATA/mail/*@$domain.* hestia/
		fi
	done

	if [ "$i" -eq 1 ]; then
		echo -e "$(date "+%F %T") *** $i domain ***" | tee -a $BACKUP/$user/$user.log
	else
		echo -e "$(date "+%F %T") *** $i domains ***" | tee -a $BACKUP/$user/$user.log
	fi
fi

if [ -n "$DB_SYSTEM" ] && [ "$DB" != '*' ]; then
	echo -e "\n-- DB --" | tee -a $BACKUP/$user/$user.log
	mkdir -p $tmpdir/db/

	for database in $(search_objects 'db' 'SUSPENDED' "*" 'DB'); do
		exclusion=$(echo "$DB" | tr ',' '\n' | grep -Fx -- "$database")
		if [ -z "$exclusion" ]; then
			db_list="$db_list $database"
		else
			echo "$(date "+%F %T") excluding $database" \
				| tee -a $BACKUP/$user/$user.log
		fi
	done

	i=0
	conf="$USER_DATA/db.conf"
	db_list=$(echo "$db_list" | sed -e "s/  */\ /g" -e "s/^ //")
	for database in $db_list; do
		check_backup_conditions
		((i++))
		get_database_values

		echo -e "$(date "+%F %T") $database ($TYPE)" | tee -a $BACKUP/$user/$user.log
		mkdir -p $tmpdir/db/$database/conf
		mkdir -p $tmpdir/db/$database/hestia

		cd $tmpdir/db/$database/
		grep -F "DB='$database'" $conf > hestia/db.conf

		# Raw: compressing here would kill restic's deduplication.
		mkdir -p "$dumpdir"
		dump="$dumpdir/$database.$TYPE.sql"
		grants="$tmpdir/db/$database/conf/$database.$TYPE.$DBUSER"
		if [ ! -f "$dump" ]; then

			WAIT_LOOP_ENTERED=0
			while true; do
				if pgrep -x "mysqldump" > /dev/null; then
					WAIT_LOOP_ENTERED=1
					echo "Wait other mysqldump to finish"
					sleep 1
				else
					if [ "$WAIT_LOOP_ENTERED" -eq 1 ]; then
						echo "We can use mysqldump now"
					fi
					break
				fi
			done

			case $TYPE in
				mysql) dump_mysql_database ;;
				pgsql) dump_pgsql_database ;;
			esac

		fi
	done

	if [ "$i" -eq 1 ]; then
		echo -e "$(date "+%F %T") *** $i database ***" \
			| tee -a $BACKUP/$user/$user.log
	else
		echo -e "$(date "+%F %T") *** $i databases ***" \
			| tee -a $BACKUP/$user/$user.log
	fi
fi

if [ -n "$CRON_SYSTEM" ] && [ "$CRON" != '*' ]; then
	echo -e "\n-- CRON --" | tee -a $BACKUP/$user/$user.log
	mkdir -p $tmpdir/cron/

	cp $USER_DATA/cron.conf $tmpdir/cron/
	cron_record=$(wc -l $USER_DATA/cron.conf | cut -f 1 -d ' ')

	if [ -e "/var/spool/cron/$user" ]; then
		cron_list="$cron_record"
		cp /var/spool/cron/$user $tmpdir/cron/
	fi

	if [ "$cron_record" -eq 1 ]; then
		echo -e "$(date "+%F %T") *** $cron_record job ***" \
			| tee -a $BACKUP/$user/$user.log
	else
		echo -e "$(date "+%F %T") *** $cron_record jobs ***" \
			| tee -a $BACKUP/$user/$user.log
	fi
fi

run_time=$((end_time - start_time))
run_time=$((run_time / 60))
current_time=$(date "+%T")
if [ "$run_time" -lt 1 ]; then
	run_time=1
fi
min=minutes
if [ "$run_time" -eq 1 ]; then
	min=minute
fi

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )
echo "$(date "+%F %T") Runtime: $run_time $min" | tee -a $BACKUP/$user/$user.log

backup_str="BACKUP='snapshot'"
backup_str="$backup_str TYPE='restic'"
backup_str="$backup_str WEB='${web_list// /,}'"
backup_str="$backup_str DNS='${dns_list// /,}'"
backup_str="$backup_str MAIL='${mail_list// /,}'"
backup_str="$backup_str DB='${db_list// /,}'"
backup_str="$backup_str CRON='$cron_record'"
backup_str="$backup_str UDIR='${udir_list// /,}'"
backup_str="$backup_str RUNTIME='$run_time' TIME='$time' DATE='$date'"
backup_str="$backup_str BACKUP_MODE='$BACKUP_MODE'"
echo "$backup_str" > $tmpdir/backup.conf

exit

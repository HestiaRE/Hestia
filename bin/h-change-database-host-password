#!/bin/bash
# info: change database server password
# options: TYPE HOST DBUSER DBPASS
#
# example: h-change-database-host-password mysql localhost root pA$$w@rD
#
# This function changes the password of a database server account and stores it in the host record.
# mysql changes it on the server for every host of the account; pgsql only updates the stored value.

type=$1
host=$2
dbuser=$3
password=$4
HIDE=4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='TYPE HOST DBUSER DBPASS'
check_args '4' "$#" "$args_usage"
is_type_valid 'mysql pgsql' "$type"
is_format_valid 'host' 'dbuser'
is_object_valid "$HESTIA/conf/$type" 'HOST' "$host"
# DBPASS may be a /tmp file instead of the secret: keeps the root password out of sudo's log.
is_password_valid
dbpass="$password"

if [ "$type" = 'mysql' ]; then
	mysql_connect "$host"
	accounts=$(mysql_query "SELECT Host FROM mysql.user WHERE User='$dbuser'" | tail -n +2)
	[ -n "$accounts" ] || check_result "$E_NOTEXIST" "$dbuser does not exist on $host"
	pass_esc=$(mysql_sql_escape "$dbpass")
	query=''
	while IFS= read -r account_host; do
		account_host=$(mysql_sql_escape "$account_host")
		# SET PASSWORD keeps an OR unix_socket alternative, which ALTER USER would drop from root.
		if [ "$mysql_fork" = 'mariadb' ]; then
			query="$query SET PASSWORD FOR '$dbuser'@'$account_host' = PASSWORD('$pass_esc');"
		else
			query="$query ALTER USER '$dbuser'@'$account_host' IDENTIFIED BY '$pass_esc';"
		fi
	done <<< "$accounts"
	# One session: the first statement may change the password this connection logs in with.
	mysql_query "$query" > /dev/null
	check_result $? "password of $dbuser on $host was not changed" "$E_DB"
	if [ "$dbuser" = 'root' ] && [ "$host" = 'localhost' ]; then
		(
			umask 077
			printf '[client]\npassword='"'"'%s'"'"'\n' "$dbpass" > /root/.my.cnf
			chmod 600 /root/.my.cnf
		)
	fi
fi

update_object_value "$HESTIA/conf/$type" 'HOST' "$host" '$USER' "$dbuser"
update_object_value "$HESTIA/conf/$type" 'HOST' "$host" '$PASSWORD' "$dbpass"

$BIN/h-log-action "system" "Warning" "Database" "Password changed for remote database host (Host: $host)."
log_event "$OK" "$ARGUMENTS"

exit

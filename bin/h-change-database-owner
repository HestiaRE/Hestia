#!/bin/bash
# info: change database owner
# options: DATABASE USER
#
# example: h-change-database-owner mydb alice
#
# This function for changing database owner.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
database=$1
user=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DATABASE USER'
is_format_valid 'database' 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Check owner existence
owner=$(echo "$database" | cut -f 1 -d '_')
if [ ! -d "$CONF_DIR/users/$owner" ]; then
	echo "Error: database owner doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

# Check if owner is the same as the dst user
if [ "$owner" = "$user" ]; then
	exit
fi

# Check db existence
db_data=$(grep -F "DB='$database'" $CONF_DIR/users/$owner/db.conf)
if [ -z "$db_data" ]; then
	echo "Error: database $database doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

parse_object_kv_list "$db_data"
# A shared user cannot follow one of its databases to another customer (#725).
[ -z "${DBUSER2:-}" ] || check_result "$E_INUSE" "$database has a second user, remove it with h-delete-database-slot2 first"
if [ "$TYPE" = 'mysql' ]; then
	(
		USER_DATA="$CONF_DIR/users/$owner"
		db_user_in_use "$DBUSER" mysql "$HOST" "$database"
	)
	[ $? -eq 1 ] || check_result "$E_INUSE" "$DBUSER is used by another database of $owner"
fi
#Fix issue #1084 with "Upper case not allowed with PGSQL"
if [ "$TYPE" == "pgsql" ]; then
	usersmall=$(echo "$user" | tr '[:upper:]' '[:lower:]')
else
	usersmall=$user
fi

# Check if database name is uniqe
new_db=$(echo "$database" | sed "s/^${owner}_/${usersmall}_/")
new_dbuser=$(echo "$DBUSER" | sed "s/^${owner}_/${usersmall}_/")
# A longer owner name makes both derived names longer, and nothing re-validated them: the move wrote
# a record over the length limit that h-delete-database then refused for the same reason - an object
# no command could remove. Measured, and it took the source database with it.
is_database_format_valid "$new_db" 'database'
is_dbuser_format_valid "$new_dbuser" 'dbuser'
# The renamed user must be free server-wide: the prefix swap alone can land on another customer's user.
! db_user_foreign "$new_dbuser" "$owner" || check_result "$E_EXISTS" "DBUSER=$new_dbuser already exists"
if [ "$TYPE" = 'mysql' ]; then
	mysql_connect "$HOST"
	! mysql_user_exists "$new_dbuser" || check_result "$E_EXISTS" "DBUSER=$new_dbuser already exists"
fi
check_db=$(grep -F "DB='$new_db'" $CONF_DIR/users/$user/db.conf)
if [ -n "$check_db" ]; then
	echo "Error: $new_db database exists"
	log_event "$E_EXISTS" "$ARGUMENTS"
	exit "$E_EXISTS"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Creating temporary directory. One owner for the cleanup, so no exit path can litter $BACKUP with a
# dump directory - the refusals above, a failing dump, and the rollback below all leave through it.
tmpdir=$(mktemp -p $BACKUP -d "tmp.$database.XXXXXXXXXX")
trap 'rm -rf "$tmpdir"' EXIT

# Suspend database
$BIN/h-suspend-database $owner $database > /dev/null 2>&1

# Dump database
dump="$tmpdir/$database.$TYPE.sql"
grants="$tmpdir/$database.$TYPE.$DBUSER"
case $TYPE in
	mysql) dump_mysql_database ;;
	pgsql) dump_pgsql_database ;;
esac

# Import configuration
db_data=$(echo "$db_data" | sed "s/'${owner}_/'${usersmall}_/g")
echo "$db_data" >> $CONF_DIR/users/$user/db.conf
parse_object_kv_list "$db_data"

# Unsuspend db
$BIN/h-unsuspend-database "$user" "$new_db" > /dev/null 2>&1

# Rebuild databases
$BIN/h-rebuild-databases "$user"

# Import dump. Unchecked, the two steps below deleted the dump and then the source database, so a
# rejected import lost both copies and still reported success.
import_rc=0
import_why=''
case $TYPE in
	mysql) import_mysql_database "$dump" || import_rc=$? ;;
	pgsql) import_pgsql_database "$dump" || import_rc=$? ;;
	*)
		import_rc=1
		import_why="unknown database type '$TYPE', no client was run"
		;;
esac
if [ "$import_rc" -ne 0 ]; then
	# Undo what this run created and hand the source back before anything is deleted.
	$BIN/h-unsuspend-database "$owner" "$database" > /dev/null 2>&1
	$BIN/h-delete-database "$user" "$new_db" > /dev/null 2>&1
	echo "Error: import into $new_db failed (${import_why:-client exit $import_rc})"
	# The dump is worth keeping only where the source did NOT come back - otherwise the customer's
	# data sits untouched in its own database and a kept copy is just litter nobody clears.
	src_line=$(grep -F "DB='$database'" "$CONF_DIR/users/$owner/db.conf" 2> /dev/null)
	if [[ "$src_line" == *"SUSPENDED='no'"* ]]; then
		echo "$database stays with $owner and is usable again"
	else
		trap - EXIT
		echo "Warning: $database could not be handed back to $owner - its dump is kept in $tmpdir"
	fi
	if grep -qF "DB='$new_db'" "$CONF_DIR/users/$user/db.conf" 2> /dev/null; then
		echo "Warning: the half-built $new_db could not be removed, delete it by hand"
	fi
	log_event "$E_DB" "$ARGUMENTS"
	exit "$E_DB"
fi

# Remove old database
$BIN/h-unsuspend-database "$owner" "$database" > /dev/null 2>&1
$BIN/h-delete-database "$owner" "$database" > /dev/null 2>&1

# Update counters
$BIN/h-update-user-counters "$owner"
$BIN/h-update-user-counters "$user"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change database password
# options: USER DATABASE DBPASS
#
# example: h-change-database-password admin wp_db neW_pAssWorD
#
# This function for changing database user password to a database. It uses the
# full name of database as argument.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
database=$2
password=$3
HIDE=3

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DATABASE DBPASS'
is_format_valid 'user' 'database'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"
is_object_unsuspended 'db' 'DB' "$database"
is_password_valid
# Empty would leave the user without a password.
[ -n "$password" ] || check_result "$E_INVALID" "DBPASS must not be empty"
dbpass="$password"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#
# Get database values
get_database_values

# A shared user's hash lives in the slot that created it (#725); this record may only point at it.
hash_at="$database MD5"
if [ "$TYPE" = 'mysql' ]; then
	canonical=$(db_user_canonical "$DBUSER" mysql "$HOST")
	case $? in
		0) hash_at="$canonical" ;;
		2) check_result "$E_INVALID" "more than one database claims the password of $DBUSER" ;;
	esac
fi

case $TYPE in
	mysql) change_mysql_password ;;
	pgsql) change_pgsql_password ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

update_object_value 'db' 'DB' "${hash_at% *}" "\$${hash_at#* }" "$md5"

# Logging
$BIN/h-log-action "$user" "Info" "Database" "Database password changed (Database: $database)."
log_event "$OK" "$ARGUMENTS"

exit

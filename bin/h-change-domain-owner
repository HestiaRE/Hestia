#!/bin/bash
# info: change domain owner
# options: DOMAIN USER
#
# example: h-change-domain-owner www.example.com bob
#
# This function of changing domain ownership.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1
user=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DOMAIN USER'
is_format_valid 'domain' 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
owner=$($BIN/h-search-domain-owner "$domain")
if [ -z "$owner" ]; then
	check_result "$E_NOTEXIST" "domain $domain doesn't exist"
fi
if [ "$owner" = "$user" ]; then
	echo "ERROR: $domain is already owned by $user."
	exit
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "Moving $domain from $owner to $user, please wait..."

# WEB domain
web_data=$(grep -F "DOMAIN='$domain'" $CONF_DIR/users/$owner/web.conf)
if [ -n "$web_data" ]; then
	echo "[*] Moving web domain..."
	$BIN/h-suspend-web-domain "$owner" "$domain" >> /dev/null 2>&1
	parse_object_kv_list "$web_data"

	if [ -n "$CUSTOM_DOCROOT" ]; then
		if [ -z "$(echo "$CUSTOM_DOCROOT" | grep -i "/home/$owner/web/$domain")" ]; then
			docdomain=$(echo "$CUSTOM_DOCROOT" | cut -d'/' -f5)
			$BIN/h-list-web-domain $user $docdomain > /dev/null
			if [ "$?" != 0 ]; then
				echo "Error: Target domain doesn't belong to the new user"
				exit $E_NOTEXIST
			fi
			new_docroot=$(echo $CUSTOM_DOCROOT | sed "s/\/home\/$owner/\/home\/$user/")
			new_php_docroot=$(echo $CUSTOM_PHPROOT | sed "s/\/home\/$owner/\/home\/$user/")

		else
			new_docroot=$(echo $CUSTOM_DOCROOT | sed "s/\/home\/$owner/\/home\/$user/")
			new_php_docroot=$(echo $CUSTOM_PHPROOT | sed "s/\/home\/$owner/\/home\/$user/")
		fi
	fi

	# get_user_ips prints one IP per line; the inner split joins them for a single grep.
	# shellcheck disable=SC2046 # intentional: fold the IP list onto one line
	if [ -z "$(echo $(get_user_ips) | grep "$IP")" ]; then
		echo "[*] IP dedicated to $owner select new ip address..."
		get_user_ip
	fi
	old_ip=$IP
	new_ip=${local_ip:-$ip}
	echo $ip

	# Change IP
	if [ -n "$ip" ]; then
		web_data=$(echo "$web_data" | sed "s/IP='$IP'/IP='$ip'/")
	fi

	# The v6 slot moves the same way. Matched per line, not through a folded list: an
	# unanchored grep accepts a longer address that merely contains this one.
	old_ip6="$IP6"
	new_ip6="$IP6"
	if [ -n "$IP6" ] && ! get_user_ips 6 | grep -qxF "$IP6"; then
		echo "[*] IPv6 dedicated to $owner select new ipv6 address..."
		new_ip6=''
		get_user_ip6 && new_ip6="$ip6"
		web_data=$(echo "$web_data" | sed "s/IP6='$IP6'/IP6='$new_ip6'/")
	fi
	if [ -n "$new_docroot" ]; then
		web_data=$(echo "$web_data" | sed "s|CUSTOM_DOCROOT='$CUSTOM_DOCROOT'|CUSTOM_DOCROOT='$new_docroot'|")
		web_data=$(echo "$web_data" | sed "s|CUSTOM_PHPROOT='$CUSTOM_PHPROOT'|CUSTOM_PHPROOT='$new_php_docroot'|")
	fi
	web_data=$(echo "$web_data" | sed "s/SUSPENDED='no'/SUSPENDED='yes'/")

	# Check SSL
	if [ "$SSL" = 'yes' ]; then
		ssl_crt=$CONF_DIR/users/$owner/ssl/$domain.crt
		ssl_key=$CONF_DIR/users/$owner/ssl/$domain.key
		ssl_ca=$CONF_DIR/users/$owner/ssl/$domain.ca
		ssl_pem=$CONF_DIR/users/$owner/ssl/$domain.pem
		cp $ssl_crt $CONF_DIR/users/$user/ssl/
		cp $ssl_key $CONF_DIR/users/$user/ssl/
		cp $ssl_ca $CONF_DIR/users/$user/ssl/ >> /dev/null 2>&1
		cp $ssl_pem $CONF_DIR/users/$user/ssl/ >> /dev/null 2>&1
	fi

	# Check ftp user account
	if [ -n "$FTP_USER" ]; then
		/usr/sbin/userdel -f "$FTP_USER" >> /dev/null 2>&1
		old_str="FTP_USER='$FTP_USER'"
		new_str=$(echo "$old_str" | sed "s/${owner}_/${user}_/")
		web_data=$(echo "$web_data" | sed "s/$old_str/$new_str/")
	fi

	# Move config - dots escaped, or moving a.b.com also drops the old owner's aXb.com record
	sed -i "/DOMAIN='${domain//./\\.}'/d" $CONF_DIR/users/$owner/web.conf
	echo "$web_data" >> $CONF_DIR/users/$user/web.conf

	# Move data
	mv $HOMEDIR/$owner/web/$domain $HOMEDIR/$user/web/

	# Change ownership
	find "$HOMEDIR/$user/web/$domain" -user "$owner" \
		-exec chown -h $user:$user {} \;

	if [ "$SSL" = 'yes' ]; then
		sleep 10
		rm $ssl_crt
		rm $ssl_key
		rm $ssl_ca > /dev/null 2>&1
		rm $ssl_pem > /dev/null 2>&1
		rm -f $HOMEDIR/$owner/conf/web/ssl.$domain.*
	fi

	# Rebuild config
	$BIN/h-unsuspend-web-domain "$user" "$domain" no >> /dev/null 2>&1
	$BIN/h-rebuild-web-domains "$owner" no
	$BIN/h-rebuild-web-domains "$user"

	# Cleanup old config
	rm -rf "$HOMEDIR/$owner/conf/web/$domain/"
fi

# MAIL domain
mail_data=$(grep -F "DOMAIN='$domain'" $CONF_DIR/users/$owner/mail.conf)
if [ -n "$mail_data" ]; then
	$BIN/h-suspend-mail-domain "$owner" "$domain" >> /dev/null 2>&1
	echo "[*] Moving mail domain and accounts..."

	parse_object_kv_list "$mail_data"

	# Ensure mail configuration directory exists for receiving user
	if [ ! -e "$HOMEDIR/$user/conf/mail/$domain/" ]; then
		mkdir -p $HOMEDIR/$user/conf/mail/$domain/
	fi

	# Move config (dots escaped, as above)
	sed -i "/DOMAIN='${domain//./\\.}'/d" $CONF_DIR/users/$owner/mail.conf
	mail_data=$(echo "$mail_data" | sed "s/SUSPENDED='no'/SUSPENDED='yes'/")
	echo "$mail_data" >> $CONF_DIR/users/$user/mail.conf
	mv -f $CONF_DIR/users/$owner/mail/$domain.conf \
		$CONF_DIR/users/$user/mail/

	# Move DKIM
	if [ -e "$CONF_DIR/users/$owner/mail/$domain.pem" ]; then
		mv -f $CONF_DIR/users/$owner/mail/$domain.pem \
			$CONF_DIR/users/$user/mail/
		mv -f $CONF_DIR/users/$owner/mail/$domain.pub \
			$CONF_DIR/users/$user/mail/
	fi

	# Move SSL certificates
	if [ "$SSL" = 'yes' ]; then
		# Ensure that SSL directory exists and move certificates
		mkdir -p $CONF_DIR/users/$user/ssl/
		mkdir -p $HOMEDIR/$user/conf/mail/$domain/ssl/

		ssl_crt=$CONF_DIR/users/$owner/ssl/mail.$domain.crt
		ssl_key=$CONF_DIR/users/$owner/ssl/mail.$domain.key
		ssl_ca=$CONF_DIR/users/$owner/ssl/mail.$domain.ca
		ssl_pem=$CONF_DIR/users/$owner/ssl/mail.$domain.pem
		mv $ssl_crt $CONF_DIR/users/$user/ssl/
		mv $ssl_key $CONF_DIR/users/$user/ssl/
		mv $ssl_ca $CONF_DIR/users/$user/ssl/ >> /dev/null 2>&1
		mv $ssl_pem $CONF_DIR/users/$user/ssl/ >> /dev/null 2>&1

		# Add certificate to user home directory
		cp -f $CONF_DIR/users/$user/ssl/mail.$domain.crt $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt
		cp -f $CONF_DIR/users/$user/ssl/mail.$domain.key $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key
		cp -f $CONF_DIR/users/$user/ssl/mail.$domain.pem $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem
		if [ -e "$CONF_DIR/users/$user/ssl/mail.$domain.ca" ]; then
			cp -f $CONF_DIR/users/$user/ssl/mail.$domain.ca $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.ca
		fi

		# Add domain SSL configuration to dovecot
		if [ -f "/etc/dovecot/conf.d/domains/$domain.conf" ]; then
			rm -f /etc/dovecot/conf.d/domains/$domain.conf
		fi

		dovecot_version="$(dovecot --version | cut -f -2 -d .)"
		if [[ "$dovecot_version" = "2.4" ]]; then
			echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "  ssl_server_cert_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "  ssl_server_key_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
		else
			echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "  ssl_cert = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "  ssl_key = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
			echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
		fi

		# Add domain SSL configuration to exim4
		# Cleanup symlinks
		find $MAIL_SNI_DIR -xtype l -delete

		ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem $MAIL_SNI_DIR/mail.$domain.crt
		ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key $MAIL_SNI_DIR/mail.$domain.key

		mail_ssl_modes "$user" "$domain"
	fi

	# Move data
	mv $HOMEDIR/$owner/mail/$domain $HOMEDIR/$user/mail/

	# Change ownership
	find $HOMEDIR/$user/mail/$domain -user $owner \
		-exec chown -h $user {} \;

	# Checking exim username for later chowning
	exim_user="exim"
	check_exim_username=$(grep -c '^Debian-exim:' /etc/passwd)
	if [ "$check_exim_username" -eq 1 ]; then
		exim_user="Debian-exim"
	fi
	# Chowning mail conf files to exim user
	if [ -d "$HOMEDIR/$user/conf/mail/$domain" ]; then
		find $HOMEDIR/$user/conf/mail/$domain -user root \
			-exec chown $exim_user {} \;
	fi

	# Remove old mail directory from original owner
	if [ -e "$HOMEDIR/$owner/mail/$domain" ]; then
		rm -rf "$HOMEDIR/$owner/mail/$domain"
	fi

	# Remove old mail configuration directory from original owner
	if [ -e "$HOMEDIR/$owner/conf/mail/$domain" ]; then
		rm -rf "$HOMEDIR/$owner/conf/mail/$domain"
	fi
	if [ -e "$CONF_DIR/users/$owner/mail/$domain.conf" ]; then
		rm -f "$CONF_DIR/users/$owner/mail/$domain.conf"
	fi

	# Rebuild config
	$BIN/h-unsuspend-mail-domain "$user" "$domain" no
	$BIN/h-rebuild-mail-domains "$owner" no
	$BIN/h-rebuild-mail-domains "$user"
fi

# Update counters
$BIN/h-update-user-counters "$owner"
$BIN/h-update-user-counters "$user"

# Mail domains currently don't have the IP variable set see #2306
if [ -n "$old_ip" ]; then
	# Recalculate ip usage
	if [ -n "$ip" ]; then
		decrease_ip_value $old_ip $owner
		increase_ip_value $new_ip
	else
		# recalculate ip
		decrease_ip_value $old_ip $owner
		increase_ip_value $old_ip
	fi
fi
# Same for the v6 object, which the block above never counted (#602)
if [ -n "$old_ip6" ] && [ -e "$CONF_DIR/ips/$old_ip6" ]; then
	decrease_ip_value "$old_ip6" "$owner"
fi
if [ -n "$new_ip6" ] && [ -e "$CONF_DIR/ips/$new_ip6" ]; then
	increase_ip_value "$new_ip6"
fi
# Send notification to panel
if [ -n "$web_data" ] || [ -n "$mail_data" ]; then
	$BIN/h-add-user-notification "$user" "$domain has been added to your account" ''
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "Domain moved between users (Domain: $domain, Old user: $owner, New User: $user)."
$BIN/h-log-action "$user" "Info" "System" "New domain added to account (Domain: $domain)."
$BIN/h-log-action "$owner" "Info" "System" "Domain removed from account (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change the source of a firewall ipset
# options: NAME SOURCE
#
# example: h-change-firewall-ipset-source firehol "https://iplists.firehol.org/files/firehol_level1.netset https://iplists.firehol.org/files/firehol_level2.netset"
#
# SOURCE is one source as for h-add-firewall-ipset, or several https URLs separated by spaces for one combined set
# (#510). The set is reloaded from it at once; if not one source can be fetched, the old SOURCE is put back, so the
# record never names sources the loaded set did not come from.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_name=$1
data_source=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'NAME SOURCE'
is_format_valid 'ip_name'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

ipset_hstobject="$CONF_DIR/firewall/ipset"
is_object_valid "$ipset_hstobject" 'LISTNAME' "$ip_name"
[ -n "$data_source" ] || check_result "$E_INVALID" "empty ipset source"
[[ "$data_source" == *\'* ]] && check_result "$E_INVALID" "invalid ipset source :: $data_source"
old_source="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$SOURCE')"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

update_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$SOURCE' "$data_source"
# h-add-firewall-ipset validates the source it reads back and reloads the set; its error is the one to show.
output=$($BIN/h-add-firewall-ipset "$ip_name" '' '' '' 'yes' 2>&1)
rc=$?
if [ "$rc" -ne 0 ]; then
	update_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$SOURCE' "$old_source"
	output="${output#Error: }"
	check_result "$rc" "${output:-reloading $ip_name failed}, source unchanged"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "Firewall" "IPset source changed (Name: $ip_name)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change firewall rule
# options: RULE ACTION IP_CIDR PORT [PROTOCOL] [COMMENT]
#
# example: h-change-firewall-rule 3 ACCEPT 5.188.123.17 443
#
# This function is used for changing existing firewall rule.
# It fully replace rule with new one but keeps same id.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
rule=$1
action=$(echo "$2" | tr '[:lower:]' '[:upper:]')
ipv4_cidr=$3
port_ext=$4
protocol=${5:-TCP}
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')
comment=$6

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Sort function
sort_fw_rules() {
	cat $CONF_DIR/firewall/rules.conf \
		| sort -n -k 2 -t \' > $CONF_DIR/firewall/rules.conf.tmp
	mv -f $CONF_DIR/firewall/rules.conf.tmp \
		$CONF_DIR/firewall/rules.conf
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'RULE ACTION IP_CIDR PORT [PROTOCOL] [COMMENT]'
[ -n "$port_ext" ] || check_result "$E_INVALID" "PORT is empty (0 means every port)"
is_format_valid 'rule' 'action' 'protocol' 'port_ext'
if [ ! -z "$comment" ]; then
	is_format_valid 'comment'
fi
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
is_object_valid "$CONF_DIR/firewall/rules" 'RULE' "$rule"

if [[ "$ipv4_cidr" =~ ^ipset: ]]; then
	ipset_name="${ipv4_cidr#ipset:}"
	$BIN/h-list-firewall-ipset plain | grep "^$ipset_name\s" > /dev/null
	check_result $? 'ipset object not found' "$E_NOTEXIST"
else
	# Either family: a v6 source renders `ip6 saddr`. The variable keeps its legacy name.
	is_ip_cidr_format_valid "$ipv4_cidr"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Concatenating firewall rule
str="RULE='$rule' ACTION='$action' PROTOCOL='$protocol' PORT='$port_ext'"
str="$str IP='$ipv4_cidr' COMMENT='$comment' SUSPENDED='no'"
str="$str TIME='$time' DATE='$date'"

# Deleting old rule
fw_conf_checkpoint "$CONF_DIR/firewall/rules.conf"
sed -i "/RULE='$rule' /d" $CONF_DIR/firewall/rules.conf

# Adding new
echo "$str" >> $CONF_DIR/firewall/rules.conf

# Sorting firewall rules by id number
sort_fw_rules

# Updating system firewall
fw_update_or_rollback || check_result "$E_INVALID" "the ruleset rejected the change, rule unchanged"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "Firewall" "Firewall rule changed (Rule: $rule, Action: $action, Protocol: $protocol, Port: $port_ext)."
log_event "$OK" "$ARGUMENTS"
exit

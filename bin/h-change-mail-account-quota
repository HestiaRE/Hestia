#!/bin/bash
# info: change mail account quota
# options: USER DOMAIN ACCOUNT QUOTA
#
# example: h-change-mail-account-quota admin mydomain.tld user01 unlimited
#
# This function changes email account disk quota.

user=$1
domain=$2
account=$3
quota=${4:-unlimited}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain

check_args '4' "$#" 'USER DOMAIN ACCOUNT QUOTA'
is_format_valid 'user' 'domain' 'account'
if [ "$quota" != 'unlimited' ]; then
	is_format_valid 'quota'
	# Every later test would read 08 as a broken octal number.
	quota=$((10#$quota))
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"

md5=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$MD5')
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	if [ "$quota" = 'unlimited' ]; then
		quota=0
	fi
	remove_line_by_prefix "$HOMEDIR/$user/conf/mail/$domain/passwd" "$account:"
	mail_passwd_line "$user" "$account" "$md5" "$quota" >> "$HOMEDIR/$user/conf/mail/$domain/passwd"
fi

if [[ "$quota" -eq 0 ]]; then
	quota='unlimited'
fi

update_object_value "mail/$domain" 'ACCOUNT' "$account" '$QUOTA' "$quota"

$BIN/h-log-action "$user" "Info" "Mail" "Mail account quota changed (Quota: $quota, Account: $account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

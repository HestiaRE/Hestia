#!/bin/bash
# info: change mail domain rate limit
# options: USER DOMAIN RATE
#
# example: h-change-mail-domain-rate-limit admin mydomain.tld 100
#
# Sets the hourly send limit of the domain's accounts; system returns to the server default.
# An account's own limit wins.

user=$1
domain=$2
rate=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN  RATE'
is_format_valid 'user' 'domain'
if [ "$rate" != 'system' ]; then
	is_format_valid 'rate'
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

if [[ "$rate" = "system" ]]; then
	rate=''
fi

update_object_value "mail" 'DOMAIN' "$domain" '$RATE_LIMIT' "$rate"
$BIN/h-rebuild-mail-domain "$user" "$domain"

$BIN/h-log-action "$user" "Info" "Mail" "Mail domain rate limit has changed ($rate)"
log_event "$OK" "$ARGUMENTS"

exit

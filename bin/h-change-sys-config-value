#!/bin/bash
# info: change sysconfig value
# options: KEY VALUE
#
# example: h-change-sys-config-value VERSION 1.0
#
# Sets a hestia.conf key.

key=$(echo "$1" | tr '[:lower:]' '[:upper:]')
value=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'KEY VALUE'
is_common_format_valid "$key" 'key'
format_no_quotes "$value" 'value'

# A key with a closed set takes the registry's spelling, case being the only leniency; other values are refused.
# The sentinel keeps the trailing newline: the empty string is a legal last member, and h-delete-sys-* clears with it.
if _set=$(sysreg_values "$key" 2> /dev/null && printf 'S'); then
	_set="${_set%S}"
	# The marker carries the hit, so a match on the empty member is not read as no match.
	_hit=$(printf '%s' "$_set" | awk -v v="$value" 'tolower($0) == tolower(v) { print "=" $0; exit }')
	if [ -z "$_hit" ]; then
		check_result "$E_INVALID" "$key accepts $(printf '%s' "$_set" | sed 's/^$/(empty)/' | paste -sd'|') - not '$value'"
	fi
	value="${_hit#=}"
fi

# One key, two scales: gzip takes 1-9, zstd 1-19. Checked here, not in the nightly run. An unset mode passes:
# during an install it may not exist yet, and the mode's own check catches the pair.
case "$key" in
	BACKUP_GZIP)
		is_int_format_valid "$value" 'BACKUP_GZIP'
		if [ "$value" -lt 1 ] || [ "$value" -gt 19 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP must be 1-19 (gzip only reaches 9)"
		fi
		if [ "${BACKUP_MODE:-}" = 'gzip' ] && [ "$value" -gt 9 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP $value is zstd-only - gzip accepts 1-9"
		fi
		;;
	BACKUP_MODE)
		if [ "$value" != 'gzip' ] && [ "$value" != 'zstd' ]; then
			check_result "$E_INVALID" "BACKUP_MODE must be gzip or zstd"
		fi
		# The other direction: a level legal under zstd stops being legal when the mode changes.
		if [ "$value" = 'gzip' ] && [ "${BACKUP_GZIP:-0}" -gt 9 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP is $BACKUP_GZIP - lower it to 9 or less before switching to gzip"
		fi
		;;
esac

change_sys_value "$key" "$value"

# Sorted through a temp file next to it, which keeps the file's own mode and owner; the trap owns it until the rename.
updconf=$(mktemp "$HESTIA/conf/hestia.conf.XXXXXX") || check_result "$E_UPDATE" "hestia.conf: cannot create a temp file next to it"
trap 'rm -f "$updconf"' EXIT
sort "$HESTIA/conf/hestia.conf" -o "$updconf" \
	&& chmod --reference="$HESTIA/conf/hestia.conf" "$updconf" \
	&& { [ "$(stat -c %u:%g "$HESTIA/conf/hestia.conf")" = "$(stat -c %u:%g "$updconf")" ] || chown --reference="$HESTIA/conf/hestia.conf" "$updconf"; } \
	&& mv -f "$updconf" "$HESTIA/conf/hestia.conf" || check_result "$E_UPDATE" "hestia.conf was not sorted: $key"
# Verified, not assumed: sed and mv fail silently on an unwritable file, and the callers trust rc 0.
if ! grep -qxF "$key='$value'" "$HESTIA/conf/hestia.conf"; then
	check_result "$E_UPDATE" "hestia.conf was not written: $key"
fi

$BIN/h-log-action "system" "Info" "System" "System configuration value changed (Key: $key, Value: $value)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change sysconfig value
# options: KEY VALUE
#
# example: h-change-sys-config-value VERSION 1.0
#
# This function is for changing main config settings such as COMPANY_NAME or
# COMPANY_EMAIL and so on.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
key=$(echo "$1" | tr '[:lower:]' '[:upper:]')
value=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'KEY VALUE'
is_common_format_valid "$key" 'key'
format_no_quotes "$value" 'value'

# One key, two scales: gzip takes 1-9, zstd 1-19. Checked where the value is set, not in the
# nightly run that would die at 3 a.m. An unset mode passes - during an install it may not exist
# yet, and the mode's own check catches the pair once it does.
case "$key" in
	BACKUP_GZIP)
		is_int_format_valid "$value" 'BACKUP_GZIP'
		if [ "$value" -lt 1 ] || [ "$value" -gt 19 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP must be 1-19 (gzip only reaches 9)"
		fi
		if [ "${BACKUP_MODE:-}" = 'gzip' ] && [ "$value" -gt 9 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP $value is zstd-only - gzip accepts 1-9"
		fi
		;;
	BACKUP_MODE)
		if [ "$value" != 'gzip' ] && [ "$value" != 'zstd' ]; then
			check_result "$E_INVALID" "BACKUP_MODE must be gzip or zstd"
		fi
		# The other direction: a level legal under zstd stops being legal when the mode changes.
		if [ "$value" = 'gzip' ] && [ "${BACKUP_GZIP:-0}" -gt 9 ]; then
			check_result "$E_INVALID" "BACKUP_GZIP is $BACKUP_GZIP - lower it to 9 or less before switching to gzip"
		fi
		;;
esac
#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

change_sys_value "$key" "$value"

# Sort configuration file in alphabetical order on change - through a temp file next to it (the old
# /tmp/updconf was a fixed name, and the mv recreated hestia.conf with the umask's mode instead of its own).
updconf=$(mktemp "$HESTIA/conf/hestia.conf.XXXXXX")
sort "$HESTIA/conf/hestia.conf" -o "$updconf" \
	&& chmod --reference="$HESTIA/conf/hestia.conf" "$updconf" \
	&& chown --reference="$HESTIA/conf/hestia.conf" "$updconf" \
	&& mv -f "$updconf" "$HESTIA/conf/hestia.conf" || rm -f "$updconf"
# The write is verified, not assumed: sed and mv fail silently on an unwritable file, and every
# caller (the repair above all) treated this command's rc 0 as "written" (#929).
if ! grep -qxF "$key='$value'" "$HESTIA/conf/hestia.conf"; then
	check_result "$E_UPDATE" "hestia.conf was not written: $key"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "System configuration value changed (Key: $key, Value: $value)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change phpmyadmin alias url
# options: TYPE ALIAS
#
# example: h-change-sys-db-alias pma phpmyadmin
#          # Sets phpMyAdmin alias to phpmyadmin
#
# Moves phpMyAdmin to another URL path, on the panel port and on every customer domain.
# Only pma has an alias: Adminer is served on the fixed /adminer/ route.

type=$1
alias=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'TYPE ALIAS'

is_common_format_valid "$alias" "Alias"
# is_common_format_valid passes an empty alias, which renders a route that redirects the panel to itself forever.
# Switching phpMyAdmin off is h-delete-sys-phpmyadmin's job: it clears the key AND removes the route.
if [ -z "$alias" ]; then
	check_result "$E_INVALID" "alias cannot be empty - to switch the editor off use h-delete-sys-phpmyadmin"
fi
case "$type" in
	pma | PMA | phpmyadmin) ;;
	*) check_result "$E_INVALID" "unknown TYPE '$type', only pma has an alias" ;;
esac
# Before anything is written: without it the customer-domain proxy would have no target.
if [ -z "$BACKEND_PORT" ]; then
	echo "Error: BACKEND_PORT is empty - the phpMyAdmin proxy would have no target"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

# phpMyAdmin lives on Panel-Caddy :8083; customer domains reach it through a proxy include in their vhosts.
mkdir -p /etc/caddy/apps

if [ "$type" = "pma" ] || [ "$type" = "PMA" ] || [ "$type" = "phpmyadmin" ]; then
	db_editor="phpMyAdmin"
	$BIN/h-change-sys-config-value 'DB_PMA_ALIAS' "$alias"

	cp -f "$HESTIA/share/panel-caddy/apps/phpmyadmin.tpl" /etc/caddy/apps/phpmyadmin.conf
	sed -i "s|%alias%|$alias|g" /etc/caddy/apps/phpmyadmin.conf
	$BIN/h-restart-service caddy

	# The port is a placeholder, not a literal: a moved panel port has to reach these two files too.
	if [ -d /etc/nginx/conf.d ]; then
		cp -f "$HESTIA/share/nginx/apps/phpmyadmin.inc" /etc/nginx/conf.d/phpmyadmin.inc
		sed -i -e "s|%pma_alias%|$alias|g" -e "s|%panel_port%|$BACKEND_PORT|g" /etc/nginx/conf.d/phpmyadmin.inc
		$BIN/h-restart-service nginx
	fi
	if [ -d /etc/apache2/conf.d ]; then
		cp -f "$HESTIA/share/apache2/apps/phpmyadmin.conf" /etc/apache2/conf.d/phpmyadmin.inc
		sed -i -e "s|%pma_alias%|$alias|g" -e "s|%panel_port%|$BACKEND_PORT|g" /etc/apache2/conf.d/phpmyadmin.inc
		$BIN/h-restart-service apache2
	fi
fi

$BIN/h-log-action "system" "Info" "System" "System access alias changed (Tool: $db_editor, Alias: $alias)."
log_event "$OK" "$ARGUMENTS"

exit

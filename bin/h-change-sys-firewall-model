#!/bin/bash
# info: switch the brute-force protection model
# options: [MODEL]
#
# example: h-change-sys-firewall-model crowdsec
#
# Runtime switch across the four models the two addons encode. The current one is DERIVED from artefacts on
# disk, not install.conf, which holds the recipe rather than the live state; no MODEL arg just prints it.
# Components are added BEFORE any removal, so a crowdsec target that refuses on apache leaves the box with
# its existing protection. crowdsec-only is best-effort: mail has no detection surface, bans only via cscli.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
model=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Derive the live model from the artefacts, not install.conf.
# The key alone is not the model: a fail2ban that never came up still carries it, and was reported as present.
f2b='no'
if [ "$FIREWALL_EXTENSION" = 'fail2ban' ]; then
	f2b='yes'
	systemctl -q is-active fail2ban 2> /dev/null || f2b='down'
fi
cs='no'
dpkg -l crowdsec 2> /dev/null | grep -q '^ii' && cs='yes'
case "$f2b/$cs" in
	no/no) current='none' ;;
	yes/no) current='fail2ban' ;;
	yes/yes) current='fail2ban+crowdsec' ;;
	no/yes) current='crowdsec' ;;
	down/no) current='fail2ban (not running)' ;;
	down/yes) current='fail2ban (not running)+crowdsec' ;;
esac

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# No argument: report the current model and exit (lets the panel and scripts read it cheaply).
if [ -z "$model" ]; then
	echo "$current"
	exit 0
fi

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

case "$model" in
	none | fail2ban | fail2ban+crowdsec | crowdsec) ;;
	*)
		echo "ERROR: MODEL must be one of: none fail2ban fail2ban+crowdsec crowdsec"
		exit "$E_INVALID"
		;;
esac

if [ "$model" = "$current" ]; then
	echo "INFO: brute-force protection model is already '$current'."
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

want_f2b='no'
want_cs='no'
case "$model" in
	fail2ban) want_f2b='yes' ;;
	fail2ban+crowdsec)
		want_f2b='yes'
		want_cs='yes'
		;;
	crowdsec) want_cs='yes' ;;
esac

# Held across the WHOLE switch, so a web switch cannot flip the front between the refuse check and the
# wiring; reentrant, so the child command shares it. Only for crowdsec transitions - a pure fail2ban toggle
# touches the firewall, not web config, and should not freeze domain ops.
if { [ "$want_cs" = 'yes' ] && [ "$cs" = 'no' ]; } || { [ "$want_cs" = 'no' ] && [ "$cs" = 'yes' ]; }; then
	web_lock_acquire || exit "$E_INUSE"
fi

# Add first, then remove: a crowdsec add that refuses on apache aborts here with the model still intact.
if [ "$want_f2b" = 'yes' ] && [ "$f2b" != 'yes' ]; then
	$BIN/h-add-sys-fail2ban || exit "$E_INVALID"
fi
if [ "$want_cs" = 'yes' ] && [ "$cs" = 'no' ]; then
	$BIN/h-add-sys-crowdsec || exit "$E_INVALID"
fi
if [ "$want_f2b" = 'no' ] && [ "$f2b" != 'no' ]; then
	$BIN/h-delete-sys-fail2ban yes || exit "$E_INVALID"
fi
if [ "$want_cs" = 'no' ] && [ "$cs" = 'yes' ]; then
	$BIN/h-delete-sys-crowdsec || exit "$E_INVALID"
fi

# No feeder refresh here: each component command owns its own L3 consequence, so calling the addon commands
# directly reaches the same enforcement state as this switch does.

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Brute-force protection model changed ($current -> $model)."
log_event "$OK" "$ARGUMENTS"

exit

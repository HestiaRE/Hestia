#!/bin/bash
# info: change hestia ssl certificate
# options: SSL_DIR [RESTART]
#
# example: h-change-sys-hestia-ssl /home/new/dir/path yes
#
# Installs certificate.crt and certificate.key from SSL_DIR as the panel certificate.

domain='certificate'
ssl_dir=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'SSL_DIR [RESTART]'
is_format_valid 'ssl_dir' 'restart'

certificate=$(cat $ssl_dir/$domain.crt | grep -n END)
certificate_count=$(echo "$certificate" | wc -l)
if [ "$certificate_count" -gt 1 ]; then
	crt_end=$(echo "$certificate" | head -n1 | cut -f 1 -d :)
	crt_lines=$(wc -l $ssl_dir/$domain.crt | cut -f1 -d ' ')
	pem_begin=$((crt_lines - crt_end))
	mv $ssl_dir/$domain.crt $ssl_dir/$domain.crt_full
	head -n $crt_end $ssl_dir/$domain.crt_full > $ssl_dir/$domain.crt
	tail -n $pem_begin $ssl_dir/$domain.crt_full > $ssl_dir/$domain.ca
	is_web_domain_cert_valid
	mv -f $ssl_dir/$domain.crt_full $ssl_dir/$domain.crt
	rm -f $ssl_dir/$domain.ca
else
	is_web_domain_cert_valid
fi

cp -f $ssl_dir/certificate.crt $HESTIA_SSL/certificate.crt
cp -f $ssl_dir/certificate.key $HESTIA_SSL/certificate.key

# Caddy runs with admin off, so a restart, not a reload. Deferred: the panel request asking for it runs
# through this Caddy and would be cut before its answer.
if [ "$restart" != 'no' ]; then
	systemd-run --quiet --on-active=3 --unit="hestia-caddy-restart-$$" /usr/bin/systemctl restart caddy > /dev/null 2>&1 \
		|| systemctl restart caddy
	$BIN/h-restart-mail "$restart"
fi

log_event "$OK" "$ARGUMENTS"

exit

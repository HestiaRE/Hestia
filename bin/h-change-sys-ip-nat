#!/bin/bash
# info: change NAT IP address
# options: IP NAT_IP [RESTART]
#
# example: h-change-sys-ip-nat 10.0.0.1 203.0.113.1
#
# This function for changing NAT IP associated with IP.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
# ip46 for the format dispatch; global $ip aliased for the sourced ip.sh helpers
ip46="$1"
ip="$ip46"
nat_ip="$2"
restart="$3"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP NAT_IP [RESTART]'
# Validate BEFORE classifying: ip_family on raw input calls anything with a colon a 6,
# so foo:bar would earn the NAT message instead of "invalid" (review round, stage 1).
is_format_valid 'ip46'
# NAT stays a v4 concept: a v6 object never carries one, and the v6 path in
# get_real_ip/get_user_ip is a passthrough precisely because of that
if [ "$(ip_family "$ip46")" = 6 ]; then
	check_result "$E_INVALID" "NAT is an IPv4 concept - a v6 IP object cannot carry a NAT address"
fi
is_format_valid 'nat_ip'
is_ip_valid "$ip"
is_restart_format_valid "$restart"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Updating IP
if [ -z "$(grep NAT= $CONF_DIR/ips/$ip)" ]; then
	sed -i "s/^TIME/NAT='$nat_ip'\nTIME/g" $CONF_DIR/ips/$ip
	old=''
	new="$nat_ip"
else
	old="$(get_ip_value '$NAT')"
	new="$nat_ip"
	sed -i "s/NAT=.*/NAT='$new'/" $CONF_DIR/ips/$ip
	if [ -z "$nat_ip" ]; then
		new="$ip"
	fi
fi

# Updating WEB configs
if [ -n "$old" ] && [ -n "$WEB_SYSTEM" ]; then
	for user in $("$BIN/h-list-users" list); do
		ip_field_replace "$CONF_DIR/users/$user/web.conf" "$old" "$new"
		$BIN/h-rebuild-web-domains "$user" no
	done
	$BIN/h-restart-web "$restart"
fi

# Updating FTP
if [ -n "$FTP_SYSTEM" ]; then
	proftpd_nat_apply
	$BIN/h-restart-ftp "$restart"
fi

# Updating firewall
if [ -n "$old" ] && [ -n "$FIREWALL_SYSTEM" ]; then
	for fw_conf in "$CONF_DIR"/firewall/*.conf; do
		[ -e "$fw_conf" ] || continue
		ip_field_replace "$fw_conf" "$old" "$new"
	done
	$BIN/h-update-firewall
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "IP NAT address changed (IP: $ip, NAT IP: $nat_ip)."
log_event "$OK" "$ARGUMENTS"

exit

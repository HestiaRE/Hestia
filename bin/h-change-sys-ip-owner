#!/bin/bash
# info: change IP owner
# options: IP USER
#
# example: h-change-sys-ip-owner 203.0.113.1 admin
#
# Gives an IP to another account; a customer's IP is always dedicated.

# ip46 for the format dispatch; global $ip aliased for the sourced ip.sh helpers
ip46="$1"
ip="$ip46"
user="$2"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'IP USER'
is_format_valid 'ip46' 'user'
if [ "$(ip_family "$ip46")" = 6 ]; then
	ip46=$(ip6_canonical "$ip46") || check_result "$E_INVALID" "cannot canonicalise the v6 address - the panel php backend did not answer"
	ip="$ip46"
fi
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_ip_valid "$ip"
is_ip_key_empty '$U_WEB_DOMAINS'
is_ip_key_empty '$U_SYS_USERS'

ip_status="$(get_ip_value '$STATUS')"

ip_owner=$(get_ip_value '$OWNER')
if [ "$ip_owner" != "$user" ]; then
	update_ip_value '$OWNER' "$user"
	decrease_user_value "$ip_owner" '$IP_OWNED'
	if [ "$ip_owner" = "$ROOT_USER" ]; then
		if [ "$ip_status" = 'shared' ]; then
			for hestia_user in $("$BIN/h-list-users" list); do
				decrease_user_value "$hestia_user" '$IP_AVAIL'
			done
		else
			decrease_user_value "$ROOT_USER" '$IP_AVAIL'
		fi
	else
		decrease_user_value "$ip_owner" '$IP_AVAIL'
		decrease_user_value "$ROOT_USER" '$IP_AVAIL'
	fi

	increase_user_value "$user" '$IP_OWNED'
	if [ "$user" = "$ROOT_USER" ]; then
		if [ "$ip_status" = 'shared' ]; then
			for hestia_user in $("$BIN/h-list-users" list); do
				increase_user_value "$hestia_user" '$IP_AVAIL'
			done
		else
			increase_user_value "$ROOT_USER" '$IP_AVAIL'
		fi
	else
		increase_user_value "$user" '$IP_AVAIL'
		increase_user_value "$ROOT_USER" '$IP_AVAIL'
	fi
fi

ip_status="$(get_ip_value '$STATUS')"
if [ "$user" != "$ROOT_USER" ] && [ "$ip_status" = 'shared' ]; then
	$BIN/h-change-sys-ip-status "$ip" 'dedicated'
fi

$BIN/h-log-action "system" "Info" "System" "IP address owner changed (IP: $ip, Owner: $user)"
log_event "$OK" "$ARGUMENTS"

exit

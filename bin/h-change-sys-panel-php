#!/bin/bash
# info: Change the PHP version the panel FPM runs on
# options: VERSION
#
# example: h-change-sys-panel-php 8.4
#
# Moves the panel's own FPM to another PHP version, installing it if missing, and rolls back if it will not start.
# h-change-sys-php is the customer default.

version=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'VERSION'

if [[ ! $version =~ ^[0-9]+\.[0-9]+$ ]]; then
	echo "The specified PHP version format is invalid, it should look like [0-9].[0-9]."
	echo "Example: 7.4, 8.3, 8.4"
	exit "$E_INVALID"
fi

version_file="/etc/php/hestia/php-version"
current=$(cat "$version_file" 2> /dev/null)

if [ "$version" = "$current" ]; then
	echo "PHP $version is already the panel FPM version."
	exit
fi

if [ -z "$($BIN/h-list-sys-php plain | grep -xF -- "$version")" ]; then
	echo "PHP $version is not installed yet — installing it for the panel..."
	if ! $BIN/h-add-web-php "$version"; then
		echo "ERROR: Failed to install PHP $version. Panel version unchanged."
		exit "$E_INVALID"
	fi
fi

# The wrapper launches /usr/sbin/php-fpm<version>.
if [ ! -x "/usr/sbin/php-fpm$version" ]; then
	echo "ERROR: /usr/sbin/php-fpm$version not found after install. Panel version unchanged."
	exit "$E_INVALID"
fi

echo "$version" > "$version_file"
# A conf.d without a critical extension still lets the pool start, so its rc decides as well.
if ! "$SBIN/hestia-php-confd" "$version" || ! systemctl restart hestia-php || ! systemctl is-active --quiet hestia-php; then
	echo "ERROR: PHP $version cannot carry the panel, rolling back."
	if [ -n "$current" ]; then
		echo "$current" > "$version_file"
		"$SBIN/hestia-php-confd" "$current"
	else
		# No previous pin: conf.d follows the version the wrapper falls back to (keep in step with hestia-php-fpm).
		rm -f "$version_file"
		fallback=$(ls -1 /usr/sbin/php-fpm[0-9].[0-9] 2> /dev/null | sort -V | tail -n1 | sed 's#.*/php-fpm##')
		[ -n "$fallback" ] && "$SBIN/hestia-php-confd" "$fallback"
	fi
	systemctl restart hestia-php
	exit "$E_INVALID"
fi

echo "Panel FPM now runs on PHP $version."

$BIN/h-log-action "system" "Info" "System" "Changed panel PHP version to $version."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: Change default php version server wide
# options: VERSION
#
# example: h-change-sys-php 8.0
#
# Moves the default customer PHP: every domain on the default is rebuilt onto it, and the file manager pools follow.

version=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'VERSION'

if [[ ! $version =~ ^[0-9]+\.[0-9]+$ ]]; then
	echo "The specified PHP version format is invalid, it should look like [0-9].[0-9]."
	echo "Example: 7.0, 7.4, 8.0"
	exit "$E_INVALID"
fi

version_check=$($BIN/h-list-sys-php plain | grep -xF -- "$version")
if [ -z "$version_check" ]; then
	echo "ERROR: Specified PHP version is not installed."
	exit "$E_INVALID"
fi

# Before the rebuild, which reads the default from update-alternatives.
update-alternatives --set php "/usr/bin/php$version" > /dev/null 2>&1
[ "$(readlink -f /etc/alternatives/php)" = "$(readlink -f "/usr/bin/php$version")" ] \
	|| check_result "$E_UPDATE" "the php alternative could not be set to $version"

failed=""
for user in $("$BIN/h-list-users" list); do
	$BIN/h-rebuild-web-domains "$user" 'no' > /dev/null 2>&1 || failed="$failed $user"
done

# File manager pools move with the default version. h-add-user-filemanager drops the old pool itself, only after the
# new one passed and once the old master let go of the shared socket.
# shellcheck source=/usr/local/hestia/include/filemanager.sh
source "$HESTIA/include/filemanager.sh"
fm_refresh no || echo "Warning: file manager pools not moved to PHP $version" >&2

$BIN/h-restart-web-backend '' $(multiphp_default_version)
$BIN/h-restart-web-backend
$BIN/h-restart-web
$BIN/h-restart-proxy

[ -z "$failed" ] || check_result "$E_UPDATE" "PHP $version is the default, but the web rebuild failed for:$failed"

log_event "$OK" "$ARGUMENTS"

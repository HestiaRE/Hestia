#!/bin/bash
# info: choose which release this box follows
# options: TARGET
#
# example: h-change-sys-release release
# example: h-change-sys-release v0.21
#
# TARGET is `release` for the newest tag, or a vX.Y pin. A pin is checked before it is written: a tag
# nobody carries would stop updates silently, and one below the installed version could never apply.

target=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/release.sh
source $HESTIA/include/release.sh

if [ -z "$target" ]; then
	echo "Usage: h-change-sys-release TARGET"
	echo ""
	echo "  release    follow the newest release of the configured source"
	echo "  vX.Y       stay on exactly this tag"
	echo ""
	echo "Current: $(sed -n "s/^RELEASE_BRANCH='\(.*\)'\$/\1/p" "$HESTIA/conf/hestia.conf" | head -1)"
	exit
fi

case "$target" in
	release) ;;
	v[0-9]*)
		echo "Checking whether the source carries $target..."
		if ! release_tag_exists "$target"; then
			check_result "$E_NOTEXIST" "the release source has no tag $target - nothing would be fetched"
		fi
		# update.sh refuses it too; here the mistake is answered where it is made.
		installed=$(cat "$HESTIA/VERSION" 2> /dev/null)
		if ! version_ge "$target" "$installed"; then
			check_result "$E_INVALID" "$target is older than the installed $installed - a pin below it would never apply"
		fi
		;;
	*) check_result "$E_INVALID" "expected 'release' or a tag like v0.21, got '$target'" ;;
esac

change_sys_value "RELEASE_BRANCH" "$target"
if [ "$target" = release ]; then
	latest=$(release_latest_tag)
	installed=$(cat "$HESTIA/VERSION" 2> /dev/null)
	echo "This box now follows the newest release (${latest:-the source did not answer})."
	if [ -n "$latest" ] && [ -n "$installed" ] && ! version_ge "$latest" "$installed"; then
		echo "Note: $latest is below the installed $installed, so the daily check refuses until a release above it is out."
	fi
else
	echo "This box is pinned to $target."
fi

$BIN/h-log-action "system" "Info" "System" "Release target changed (Value: $target)."
exit

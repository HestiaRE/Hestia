#!/bin/bash
# info: change service config
# options: CONFIG SERVICE [RESTART]
#
# example: h-change-sys-service-config /home/admin/dovecot.conf dovecot yes
#
# Replaces the file the config editor offers under SERVICE (sys_config_path) with CONFIG and restarts the service
# unless RESTART is no; a failed restart puts the old file back. php is the default fpm php.ini, php-X.Y that of X.Y.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
src=$1
service=$2
restart=$3

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'CONFIG SERVICE [RESTART]'
is_format_valid 'service' 'restart'

dst=$(sys_config_path "$service")
case $? in
	0) ;;
	1) check_result "$E_INVALID" "service $service is not offered by the config editor" ;;
	*) check_result "$E_NOTEXIST" "$service has no config file on this server" ;;
esac
[ "$service" != cron ] || check_result "$E_FORBIDEN" "the cron config is read-only"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Read as the caller: root copying a file the caller cannot read would hand it out through the editor.
new=$(mktemp) || check_result "$E_NOTEXIST" "no temporary file"
if [ -n "$SUDO_UID" ] && [ "$SUDO_UID" != 0 ]; then
	setpriv --reuid "$SUDO_UID" --regid "$SUDO_GID" --init-groups -- cat -- "$src" > "$new" 2> /dev/null
else
	cat -- "$src" > "$new" 2> /dev/null
fi
if [ $? -ne 0 ]; then
	rm -f "$new"
	check_result "$E_NOTEXIST" "$src cannot be read"
fi

if ! cmp -s "$new" "$dst"; then
	if [ -e "$dst" ]; then
		cp "$dst" "$dst.vst.back"
	else
		install -m 644 /dev/null "$dst"
	fi
	cp "$new" "$dst"
	update="yes"
fi
rm -f "$new"

if [ "$update" = 'yes' ] && [ "$service" = 'hestia' ]; then
	rm -f "$dst.vst.back"
elif [ "$update" = 'yes' ] && [ "$restart" != 'no' ]; then
	# dovecot-3, postgresql-hba and php-8.3 restart dovecot, postgresql and that version's fpm.
	service=${service%-*}
	[ "$service" != 'php' ] || service="php$(php_ini_version "$dst")-fpm"
	if ! $BIN/h-restart-service "$service" > /dev/null 2>&1; then
		if [ -e "$dst.vst.back" ]; then
			cat "$dst.vst.back" > "$dst"
			rm -f "$dst.vst.back"
		else
			rm -f "$dst"
		fi
		check_result "$E_RESTART" "ERROR: $service failed to start with new configuration."
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

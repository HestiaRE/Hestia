#!/bin/bash
# info: change system timezone
# options: TIMEZONE
#
# example: h-change-sys-timezone Europe/Berlin
#
# Sets the system time zone and date.timezone in every php.ini.

timezone=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# The list h-get-sys-timezones offers: zoneinfo also holds tables and directories that are no zone.
is_timezone_valid() {
	if ! timedatectl list-timezones 2> /dev/null | grep -qxF -- "$timezone"; then
		echo "Error: $timezone is not a time zone of this system"
		log_event "$E_NOTEXIST" "$ARGUMENTS"
		exit "$E_NOTEXIST"
	fi
}

check_args '1' "$#" 'TIMEZONE'
is_timezone_valid

timedatectl set-timezone "$timezone" > /dev/null
check_result $? "timedatectl did not set $timezone" "$E_UPDATE"
# timedated leaves /etc/timezone alone, and the targets still carry one for what reads it.
if [ -e "/etc/timezone" ]; then
	echo "$timezone" > /etc/timezone
fi

if [ -n "$WEB_SYSTEM" ]; then
	for conf in $(find /etc/php* -name php.ini); do
		sed -i "s|;date.timezone =|date.timezone =|" $conf
		sed -i "s|date.timezone =.*|date.timezone = $timezone|" $conf
	done
fi

$BIN/h-log-action "system" "Info" "System" "System time zone changed (Value: $timezone)."
log_event "$OK" "$ARGUMENTS"

exit

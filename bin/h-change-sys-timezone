#!/bin/bash
# info: change system timezone
# options: TIMEZONE
#
# example: h-change-sys-timezone Europe/Berlin
#
# This function for changing system timezone.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
timezone=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

is_timezone_valid() {
	if [ ! -e "/usr/share/zoneinfo/$timezone" ]; then
		echo "Error: tz file $timezone doesn't exist"
		log_event "$E_NOTEXIST" "$ARGUMENTS"
		exit "$E_NOTEXIST"
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'TIMEZONE'
is_timezone_valid

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The files by hand only where timedatectl cannot run (no systemd); an upstream typo used to force that way.
if ! timedatectl set-timezone "$timezone" > /dev/null 2>&1; then
	if [ -e "/etc/sysconfig/clock" ]; then
		sed -i "s/ZONE.*//" /etc/sysconfig/clock
		echo "ZONE=\"$timezone\"" >> /etc/sysconfig/clock
	fi
	rm -f /etc/localtime
	ln -sf /usr/share/zoneinfo/$timezone /etc/localtime
fi
# timedated leaves /etc/timezone alone, and Debian 12/13 and Ubuntu 24.04 still carry one for what reads it.
if [ -e "/etc/timezone" ]; then
	echo "$timezone" > /etc/timezone
fi

# Chaning php timezone
if [ -n "$WEB_SYSTEM" ]; then
	for conf in $(find /etc/php* -name php.ini); do
		sed -i "s|;date.timezone =|date.timezone =|" $conf
		sed -i "s|date.timezone =.*|date.timezone = $timezone|" $conf
	done
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "System time zone changed (Value: $timezone)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change webmail alias url
# options: WEBMAIL [RESTART]
#
# example: h-change-sys-webmail YourtrickyURLhere
#
# This function changes the webmail url in apache2 or nginx configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Get existing system webmail alias
export WEBMAIL_ALIAS="$WEBMAIL_ALIAS"

# Define aliases
OLD_ALIAS=$WEBMAIL_ALIAS
NEW_ALIAS=$1

restart=${2-yes}

check_args '1' "$#" 'WEBMAIL [RESTART]'
is_common_format_valid "$NEW_ALIAS" "Alias"
# The action tears every domain's webmail down and builds it back up; an empty alias made the write
# in between fail on its argument count, so the rebuild used the old alias and the whole run was a
# no-op that still reported success - with every customer's webmail briefly gone (#1058).
if [ -z "$NEW_ALIAS" ]; then
	check_result "$E_INVALID" "alias cannot be empty"
fi
is_restart_format_valid "$restart"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Read before the delete empties it: each domain keeps its client. A suspended domain has no webmail vhost and keeps
# its record, its unsuspend renders it under the new alias.
rows=()
for user in $("$BIN/h-list-users" list); do
	while IFS='|' read -r domain suspended webmail; do
		[ -n "$domain" ] && [ "$suspended" != 'yes' ] || continue
		rows+=("$user|$domain|$webmail")
	done < <("$BIN/h-list-mail-domains" "$user" plain | awk -F'\t' -v OFS='|' '{print $1, $9, $13}')
done

for row in "${rows[@]}"; do
	IFS='|' read -r user domain webmail <<< "$row"
	$BIN/h-delete-mail-domain-webmail "$user" "$domain" 'no'
done

$BIN/h-change-sys-config-value 'WEBMAIL_ALIAS' "$NEW_ALIAS"

for row in "${rows[@]}"; do
	IFS='|' read -r user domain webmail <<< "$row"
	$BIN/h-add-mail-domain-webmail "$user" "$domain" "$webmail"
done

if [ -s /etc/apache2/apache2.conf ]; then
	sed -i "s/IncludeOptional conf.d\/domains\/$WEBMAIL_ALIAS.*.conf/IncludeOptional conf.d\/domains\/$NEW_ALIAS.*.conf/g" /etc/apache2/apache2.conf
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restart services
$BIN/h-restart-web "$restart"
$BIN/h-restart-proxy "$restart"

# Logging
$BIN/h-log-action "system" "Info" "System" "Webmail access alias changed (Value: $NEW_ALIAS, Previous: $OLD_ALIAS)."
log_event "$OK" "$ARGUMENTS"

exit

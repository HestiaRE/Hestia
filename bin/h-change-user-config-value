#!/bin/bash
# info: changes user configuration value
# options: USER KEY VALUE
# labels: internal
# caller: the panel user settings
#
# example: h-change-user-config-value admin ROLE admin
#
# Changes key/value for specified user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
key="$2"
value="$3"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER KEY VALUE'
is_format_valid 'user' 'key'
# LOGIN_ALLOW_IPS carries addresses and networks; the common deny list rejects them on the colon
# and the slash alone, so that one key gets the list validator (#894).
if [ "${key^^}" = 'LOGIN_ALLOW_IPS' ]; then
	is_ip_list_format_valid "$value" "$key"
else
	is_common_format_valid "$value" "$key"
fi
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Set theme value
check_ckey=$(grep "^${key^^}" $USER_DATA/user.conf)
if [ -z "$check_ckey" ]; then
	# Rebuild user configuration to repair missing value
	$BIN/h-rebuild-user "$user"
fi
update_user_value "$user" "${key^^}" "$value"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: changes user configuration value
# options: USER KEY VALUE
# labels: internal
# caller: the panel user settings
#
# example: h-change-user-config-value alice LOGIN_DISABLED yes
#
# Changes one of the login and display settings the panel stores for a user. Role, password, suspension and the
# counters have their own commands, with the logging and session handling this one lacks.

user=$1
key="$2"
value="$3"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER KEY VALUE'
is_format_valid 'user'
key="${key^^}"
case "$key" in
	LOGIN_DISABLED | LOGIN_USE_IPLIST)
		[[ "$value" =~ ^(yes|no)$ ]] || check_result "$E_INVALID" "$key is yes or no"
		;;
	# Addresses and networks: the common deny list would reject them on the colon and the slash alone.
	LOGIN_ALLOW_IPS) [ -z "$value" ] || is_ip_list_format_valid "$value" "$key" ;;
	PREF_UI_SORT)
		[[ "$value" =~ ^(name|date)$ ]] || check_result "$E_INVALID" "$key is name or date"
		;;
	*) check_result "$E_FORBIDEN" "$key is not a setting this command changes" ;;
esac
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# A missing key comes from the record repair, not a full rebuild with its system side effects.
if ! grep -q "^$key='" "$USER_DATA/user.conf"; then
	# shellcheck source=/usr/local/hestia/include/syshealth.sh
	source "$HESTIA/include/syshealth.sh"
	syshealth_repair_user_config > /dev/null
fi
update_user_value "$user" "$key" "$value" || check_result "$E_NOTEXIST" "$key is missing from the record of $user"

# The login reads these once: a session opened before the change stays unless it ends here.
case "$key" in
	LOGIN_USE_IPLIST | LOGIN_ALLOW_IPS) $BIN/h-delete-user-sessions "$user" > /dev/null ;;
	LOGIN_DISABLED) [ "$value" = 'no' ] || $BIN/h-delete-user-sessions "$user" > /dev/null ;;
esac

exit

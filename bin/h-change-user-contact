#!/bin/bash
# info: change user contact email
# options: USER EMAIL
#
# example: h-change-user-contact admin admin@yahoo.com
#
# This function for changing of e-mail associated with a certain user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
email=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER EMAIL'
is_format_valid 'user' 'email'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The passwd comment carries the email too; usermod takes the passwd lock a bare sed -i does not.
/usr/sbin/usermod -c "$email" "$user"
check_result $? "the passwd comment of $user could not be set"
update_user_value "$user" '$CONTACT' "$email" || check_result "$E_NOTEXIST" "CONTACT is missing from the record of $user"

# Update crontab email
$BIN/h-rebuild-cron-jobs "$user" > /dev/null 2>&1

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "System" "Email address changed (Value: $email)."
log_event "$OK" "$ARGUMENTS"

exit

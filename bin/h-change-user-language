#!/bin/bash
# info: change user language
# options: USER LANGUAGE
#
# example: h-change-user-language admin en
#
# Changes a user's panel language.

user=$1
language=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

is_language_valid() {
	if [ "$1" != "en" ]; then
		if ! [[ "$1" =~ ^[[:alnum:]_-]+$ ]]; then
			echo "Error: language $1 is not valid"
			log_event "$E_INVALID" "$ARGUMENTS"
			exit $E_INVALID
		fi
		if [ ! -d "$HESTIA/web/locale/$1" ]; then
			echo "Error: language $1 doesn't exist"
			log_event "$E_NOTEXIST" "$ARGUMENTS"
			exit $E_NOTEXIST
		fi
	fi
}

check_args '2' "$#" 'USER LANGUAGE'
is_format_valid 'user' 'language'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_language_valid "$language"

if [ -z "$(grep LANGUAGE $USER_DATA/user.conf)" ]; then
	sed -i "s/^TIME/LANGUAGE='$language'\nTIME/g" $USER_DATA/user.conf
else
	update_user_value "$user" '$LANGUAGE' "$language"
fi

$BIN/h-log-action "$user" "Info" "System" "Display language changed (Value: $language)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change user full name
# options: USER NAME [LAST_NAME]
#
# example: h-change-user-name admin John Smith
#
# Changes the full name of a user.

user=$1
name=$2
lname=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER NAME [LAST_NAME]'
is_format_valid 'user' 'name'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_common_format_spaces_valid "$name" "name"
if [ -n "$lname" ]; then
	is_common_format_spaces_valid "$lname" "last name"
fi

if [ -n "$lname" ]; then
	update_user_value "$user" '$NAME' "$name $lname" || check_result "$E_NOTEXIST" "NAME is missing from the record of $user"
else
	update_user_value "$user" '$NAME' "$name" || check_result "$E_NOTEXIST" "NAME is missing from the record of $user"
fi

$BIN/h-log-action "$user" "Info" "System" "User display name changed (Value: $name)."
log_event "$OK" "$ARGUMENTS"

exit

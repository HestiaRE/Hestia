#!/bin/bash
# info: change the admin's notes on a user
# options: USER FILE
#
# example: h-change-user-notes alice /tmp/notes.txt
#
# Replaces the notes kept on USER (extra software, special ini settings and the like) by the text in FILE; an empty
# text removes them. Only an admin reads them, and they travel with the user's backup. The panel passes a temp file.

user=$1
file=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
[ -f "$file" ] && [ ! -L "$file" ] || check_result "$E_NOTEXIST" "file $file does not exist"
[ "$(stat -c %s "$file")" -le 65536 ] || check_result "$E_INVALID" "the notes are longer than 64 KiB"

notes=$(mktemp "$USER_DATA/.notes.XXXXXX") || check_result "$E_DISK" "cannot write the notes of $user"
# A textarea sends CRLF; trailing blank lines are dropped so an empty field means no notes.
tr -d '\r' < "$file" | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}' > "$notes"
# Tab and newline stay; every other control byte, NUL included, is refused.
if ! LC_ALL=C tr -d '\000-\010\013-\037\177' < "$notes" | cmp -s - "$notes"; then
	rm -f "$notes"
	check_result "$E_INVALID" "the notes carry a control character"
fi
if ! iconv -f UTF-8 -t UTF-8 "$notes" > /dev/null 2>&1; then
	rm -f "$notes"
	check_result "$E_INVALID" "the notes are not UTF-8"
fi

if [ -n "$(tr -d '[:space:]' < "$notes")" ]; then
	chmod 600 "$notes"
	mv -f "$notes" "$USER_DATA/notes.txt" || check_result "$E_DISK" "cannot write the notes of $user"
	"$BIN/h-log-action" "system" "Info" "Users" "Notes changed (User: $user)."
else
	rm -f "$notes" "$USER_DATA/notes.txt"
	"$BIN/h-log-action" "system" "Info" "Users" "Notes removed (User: $user)."
fi
log_event "$OK" "$ARGUMENTS"

exit

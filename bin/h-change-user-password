#!/bin/bash
# info: change user password
# options: USER [PASSWORD]
#
# example: h-change-user-password admin NewPassword123
#
# Changes a user's password and replaces RKEY.

user=$1
password=$2
HIDE=2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [PASSWORD]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

[[ -z "$password" && ! -t 0 ]] && read -r password

[[ -z "$password" ]] && read -r -s -p "Password:" password

is_password_valid

echo "$user:$password" | /usr/sbin/chpasswd

if [ $? -ne 0 ]; then
	echo "Error: Password not accepted due to PAM restrictions"
	exit 2
fi

md5=$(awk -v user=$user -F : 'user == $1 {print $2}' /etc/shadow)

update_user_value "$user" '$RKEY' "$(generate_password)"
update_user_value "$user" '$MD5' "$md5"

# The record looks unchanged after a password change, so only this ends a session opened with the old one.
$BIN/h-delete-user-sessions "$user" > /dev/null

$BIN/h-log-action "system" "Warning" "Security" "Password changed (User: $user)."
$BIN/h-log-action "$user" "Warning" "Security" "Password changed."
log_event "$OK" "$ARGUMENTS"

exit

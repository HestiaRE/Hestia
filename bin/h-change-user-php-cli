#!/bin/bash
# info: add php  version alias to .bash_aliases
# options: USER VERSION
#
# example: h-change-user-php-cli user 7.4
#
# Sets the user's default php version on the command line, through .bash_aliases.

user=$1
version=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

FILE=$HOMEDIR/$user/.bash_aliases

check_args '2' "$#" 'USER VERSION'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

source_conf "$USER_DATA/user.conf"

versions=$($BIN/h-list-sys-php plain)
support=0
for v in $versions; do
	if [ "$v" == "$version" ]; then
		support=1
	fi
done

if [ "$support" = 0 ]; then
	echo "Version is currently not supported or does not exist..."
	exit 2
fi

# The customer owns the file and can swap it for a link, so every access runs as the customer.
user_exec touch "$FILE" || check_result "$E_FORBIDEN" "$FILE is not writable by $user"

if user_exec grep -q "alias php='env php$version'" "$FILE"; then
	echo "PHP CLI Already defined"
	exit
fi

user_exec sed -i "/alias php='env/d" "$FILE"
echo "alias php='env php$version'" | user_exec tee -a "$FILE" > /dev/null \
	|| check_result "$E_FORBIDEN" "$FILE is not writable by $user"
update_user_value "$user" '$PHPCLI' "$version" || check_result "$E_NOTEXIST" "PHPCLI is missing from the record of $user"

$BIN/h-log-action "system" "Info" "Users" "Default PHP CLI version changed (User: $user, Version: $version)."

exit

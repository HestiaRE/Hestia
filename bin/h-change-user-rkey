#!/bin/bash
# info: change user random key
# options: USER [HASH]
# labels: internal
# caller: the panel password reset
#
# Sets the password reset key and the time it was issued.

user=$1
hash=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [HASH]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

if [ -n "$hash" ]; then
	password=$hash
	is_password_valid
	hash=$password
else
	hash=$(generate_password)
fi

d=$(date +%s)

update_user_value "$user" '$RKEY' "$hash"

if [ -z "$(grep RKEYEXP $USER_DATA/user.conf)" ]; then
	sed -i "s/^RKEY/RKEYEXP='$d'\nRKEY/g" $USER_DATA/user.conf
else
	update_user_value "$user" '$RKEYEXP' "$d"
fi

$BIN/h-log-action "system" "Warning" "Users" "Password reset requested (User: $user)."
$BIN/h-log-action "$user" "Warning" "System" "Password reset requested."
log_event "$OK" "$ARGUMENTS"

exit

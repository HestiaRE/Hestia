#!/bin/bash
# info: updates user role
# options: USER ROLE
#
# example: h-change-user-role user administrator
#
# Give/revoke user administrator rights to manage all accounts as admin

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
role=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

ROLE=$(get_user_value '$ROLE')

is_format_valid 'user' 'role'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Warning" "Security" "User privileges changed (User: $user, Role: $role, Previous: $ROLE)."
update_user_value "$user" '$ROLE' "$role"

# A session carries the rights it was opened with, so the new role only reaches it once it is gone.
$BIN/h-delete-user-sessions "$user" > /dev/null

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

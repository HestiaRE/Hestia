#!/bin/bash
# info: change user sort order
# options: USER SORT_ORDER
# labels: internal
# caller: the panel user settings
#
# example: h-change-user-sort-order user date
#
# Changes web UI display sort order for specified user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
sort_order=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER SORT_ORDER'
is_format_valid 'user'
case "$sort_order" in
	name | date) ;;
	*) check_result "$E_INVALID" "invalid sort order :: $sort_order (name or date)" ;;
esac
is_object_valid 'user' 'USER' "$user"

is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

$BIN/h-change-user-config-value "$user" 'PREF_UI_SORT' "$sort_order"
check_result $? "the sort order of $user could not be changed"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "System" "Sort order changed (Value: $sort_order)."
log_event "$OK" "$ARGUMENTS"

exit

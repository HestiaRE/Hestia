#!/bin/bash
# info: change user default template
# options: USER TYPE TEMPLATE
#
# example: h-change-user-template admin WEB wordpress
#
# This function changes default user web template.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
type=$(echo "$2" | tr '[:lower:]' '[:upper:]')
template=$3

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER TYPE TEMPLATE'
is_format_valid 'user' 'template'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case $type in
	WEB)
		if ! tpl_accepted=$(accept_web_template 'web' "$template" strict); then
			is_web_template_valid "$template"
		fi
		read -r template _ <<< "$tpl_accepted"
		update_user_value "$user" '$WEB_TEMPLATE' "$template" || check_result "$E_NOTEXIST" "WEB_TEMPLATE is missing from the record of $user"
		;;
	PROXY)
		if ! tpl_accepted=$(accept_web_template 'proxy' "$template" strict); then
			is_proxy_template_valid "$template"
		fi
		read -r template _ <<< "$tpl_accepted"
		update_user_value "$user" '$PROXY_TEMPLATE' "$template" || check_result "$E_NOTEXIST" "PROXY_TEMPLATE is missing from the record of $user"
		;;
	BACKEND)
		if ! tpl_accepted=$(accept_web_template 'backend' "$template" strict); then
			is_backend_template_valid "$template"
		fi
		read -r template _ <<< "$tpl_accepted"
		update_user_value "$user" '$BACKEND_TEMPLATE' "$template" || check_result "$E_NOTEXIST" "BACKEND_TEMPLATE is missing from the record of $user"
		;;
	*) check_args '1' '0' 'USER TYPE TEMPLATE' ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Default domain template changed (Type: $type, Template: $template)."
log_event "$OK" "$ARGUMENTS"

exit

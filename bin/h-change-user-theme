#!/bin/bash
# info: updates user theme
# options: USER THEME
# labels: internal
# caller: the panel user settings
#
# example:   h-change-user-theme admin dark
# example:   h-change-user-theme peter vestia
#
# Changes web UI display theme for specified user.

user=$1
theme=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/conf/hestia.conf
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER THEME'
is_format_valid 'user' 'theme'
is_common_format_valid "$theme" "theme"
is_object_valid 'user' 'USER' "$user"

is_object_unsuspended 'user' 'USER' "$user"

# Empty resets to the system theme. A name is compared as text: a pattern could store a non-theme.
if [ -n "$theme" ] && ! "$BIN/h-list-sys-themes" plain | grep -qxF -- "$theme"; then
	echo "Theme does not exist"
	exit "$E_NOTEXIST"
fi

# A missing key comes from the record repair, not a full rebuild with its system side effects.
if ! grep -q "^THEME='" "$USER_DATA/user.conf"; then
	# shellcheck source=/usr/local/hestia/include/syshealth.sh
	source "$HESTIA/include/syshealth.sh"
	syshealth_repair_user_config > /dev/null
fi
update_user_value "$user" '$THEME' "$theme" || check_result "$E_NOTEXIST" "THEME is missing from the record of $user"

$BIN/h-log-action "$user" "Info" "System" "Applied theme to user interface (Theme: $theme)."

exit

#!/bin/bash
# info: updates user theme
# options: USER THEME
# labels: internal
# caller: the panel user settings
#
# example:   h-change-user-theme admin dark
# example:   h-change-user-theme peter vestia
#
# Changes web UI display theme for specified user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
theme=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/conf/hestia.conf
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER THEME'
is_format_valid 'user' 'theme'
is_common_format_valid "$theme" "theme"
is_object_valid 'user' 'USER' "$user"

is_object_unsuspended 'user' 'USER' "$user"

themes=$($BIN/h-list-sys-themes plain)

if ! echo "$themes" | grep -q -x "$theme"; then
	echo "Theme does not exist"
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Set theme value
check_ckey=$(grep "THEME" $USER_DATA/user.conf)
if [ -z "$check_ckey" ]; then
	# Rebuild user configuration to repair missing value
	$BIN/h-rebuild-user "$user"
fi
update_user_value "$user" '$THEME' "$theme"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "$user" "Info" "System" "Applied theme to user interface (Theme: $theme)."

exit

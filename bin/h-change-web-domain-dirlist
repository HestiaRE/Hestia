#!/bin/bash
# info: enable/disable directory listing
# options: USER DOMAIN MODE [RESTART] [QUIET]
#
# example: h-change-web-domain-dirlist user demo.com on
#
# This function is used for changing the directory list mode.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument defenition
user=$1
domain=$2
mode=$3
restart="$4"
quiet="$5"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN MODE [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Fetching domain variables
get_domain_values 'web'

# nginx and apache represent directory listing differently, so dispatch on the model.
# apache: flip Options -Indexes/+Indexes in the generated vhost. nginx: no Index token
# exists (upstream's dirlist only ever handled apache, so nginx-only was a silent no-op),
# and its templates carry no autoindex directive - deliver `autoindex on;` at server level
# via a conf_* include fragment (pulled by the templates' `include .../nginx.conf_*;` glob).
# Absence of the fragment = nginx default (off). Avoids patching ~100 nginx php-fpm templates.
conf_dir="$HOMEDIR/$user/conf/web/$domain"
if [ "$mode" = "on" ]; then
	if [ "$WEB_SYSTEM" = "nginx" ]; then
		echo "autoindex on;" > "$conf_dir/nginx.conf_dirlist"
		if [ "$SSL" == "yes" ]; then
			echo "autoindex on;" > "$conf_dir/nginx.ssl.conf_dirlist"
		else
			rm -f "$conf_dir/nginx.ssl.conf_dirlist"
		fi
	else
		sed -i "s/-Index/+Index/g" "$conf_dir/$WEB_SYSTEM.conf"
		# A merged template renders both vhost blocks into that one file, so the sed above has
		# already flipped the SSL block; a separate .ssl.conf exists only for a legacy pair. Without
		# the test this is a sed error per domain on every rebuild and every restore.
		if [ -f "$conf_dir/$WEB_SYSTEM.ssl.conf" ]; then
			sed -i "s/-Index/+Index/g" "$conf_dir/$WEB_SYSTEM.ssl.conf"
		fi
	fi
	[ "$quiet" != "yes" ] && echo "Enabled directory browsing for $domain."
else
	if [ "$WEB_SYSTEM" = "nginx" ]; then
		rm -f "$conf_dir/nginx.conf_dirlist" "$conf_dir/nginx.ssl.conf_dirlist"
	else
		sed -i "s/+Index/-Index/g" "$conf_dir/$WEB_SYSTEM.conf"
		if [ -f "$conf_dir/$WEB_SYSTEM.ssl.conf" ]; then
			sed -i "s/+Index/-Index/g" "$conf_dir/$WEB_SYSTEM.ssl.conf"
		fi
	fi
	[ "$quiet" != "yes" ] && echo "Disabled directory browsing for $domain."
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Persist the state so a vhost rebuild can self-heal it. Without a web.conf key
# the setting lives only in the generated vhost and every rebuild silently drops it.
if [ -z "$DIR_LIST" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'DIR_LIST' 'SUSPENDED'
fi
if [ "$mode" = "on" ]; then
	update_object_value 'web' 'DOMAIN' "$domain" '$DIR_LIST' 'yes'
else
	update_object_value 'web' 'DOMAIN' "$domain" '$DIR_LIST' 'no'
fi

# Restart web server
$BIN/h-restart-web "$restart"

# Logging
if [ "$quiet" != "yes" ]; then
	if [ "$mode" = "on" ]; then
		$BIN/h-log-action "$user" "Warning" "Web" "Directory browsing enabled (Domain: $domain)."
	else
		$BIN/h-log-action "$user" "Info" "Web" "Directory browsing disabled (Domain: $domain)."
	fi
fi
log_event "$OK" "$EVENT"

exit

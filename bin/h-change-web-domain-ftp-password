#!/bin/bash
# info: change ftp user password.
# options: USER DOMAIN FTP_USER FTP_PASSWORD
#
# example: h-change-web-domain-ftp-password admin example.com ftp_usr ftp_qwerty
#
# Changes the password of an FTP sub-account.

user=$1
domain=$2
# Stored as <owner>_<name>; either form is accepted, as by the add and delete commands.
if [[ "$3" == "${1}_"* ]]; then ftp_user="$3"; else ftp_user="${1}_${3}"; fi
password=$4
HIDE=4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN FTP_USER FTP_PASSWORD'
is_format_valid 'user' 'domain' 'ftp_user'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_password_valid
get_domain_values 'web'
position=$(ftp_list_index "$FTP_USER" "$ftp_user")
if [ -z "$position" ]; then
	echo "Error: account $ftp_user doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

echo "$ftp_user:$password" | /usr/sbin/chpasswd

if [ $? -ne 0 ]; then
	echo "Error: Password not accepted due to PAM restrictions"
	exit 2
fi

ftp_md5=$(awk -v user=$ftp_user -F : 'user == $1 {print $2}' /etc/shadow)

ftp_md5=$(ftp_list_edit "$FTP_MD5" "$position" "$ftp_md5")

update_object_value 'web' 'DOMAIN' "$domain" '$FTP_MD5' "$ftp_md5"

$BIN/h-log-action "$user" "Info" "Web" "FTP account password changed (User: $ftp_user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

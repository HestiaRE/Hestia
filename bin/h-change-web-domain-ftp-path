#!/bin/bash
# info: change path for ftp user.
# options: USER DOMAIN FTP_USER FTP_PATH
#
# example: h-change-web-domain-ftp-path admin example.com /home/admin/example.com
#
# This function changes ftp user path.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
# Accounts are stored as <owner>_<name>. Take either form: add used to prefix while delete and
# the change-* commands wanted the stored name, so the name that worked there failed here.
if [[ "$3" == "${1}_"* ]]; then ftp_user="$3"; else ftp_user="${1}_${3}"; fi
ftp_path=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER DOMAIN FTP_USER FTP_PATH'
is_format_valid 'user' 'domain' 'ftp_user'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'
position=$(ftp_list_index "$FTP_USER" "$ftp_user")
if [ -z "$position" ]; then
	echo "Error: account $ftp_user doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi
ftp_path_a=$(readlink -f "$HOMEDIR/$user/web/$domain/$ftp_path")
is_record_path_valid "$ftp_path_a" "$HOMEDIR/$user/web/$domain" 'ftp path'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# MKDIR if path doesn't exist
if [ ! -e "$ftp_path_a" ]; then
	mkdir -p "$ftp_path_a"
	chown --no-dereference $user:$user "$ftp_path_a"
	chmod 751 "$ftp_path_a"
fi

/usr/sbin/usermod -d "$ftp_path_a" "$ftp_user"
check_result $? "home of $ftp_user was not changed" > /dev/null

# Updating chroot jail for SFTP and FTP
delete_chroot_jail $ftp_user
add_chroot_jail $ftp_user

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Transforming absolute path to relative
ftp_path_r=$(echo $ftp_path_a | sed "s%$HOMEDIR/$user/web/$domain%%")

# Rebuilding FTP variables
ftp_path=$(ftp_list_edit "$FTP_PATH" "$position" "$ftp_path_r")

# Updating config
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_PATH' "$ftp_path"

# Logging
$BIN/h-log-action "$user" "Info" "Web" "FTP account path changed (User: $ftp_user@$domain, Path: $ftp_path_a)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change web domain name
# options: USER DOMAIN NEW_DOMAIN [RESTART]
#
# example: h-change-web-domain-name alice wonderland.com lookinglass.com yes
#
# Renames a web domain. Aliases below the old name move with it; what a rename cannot carry is refused.

user=$1
domain=$2
new_domain=${3,,}
restart=${4:-yes}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN NEW_DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_domain_format_valid "$new_domain"
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
check_new_domain=$(grep -F "DOMAIN='$new_domain'" $CONF_DIR/users/*/web.conf)
if [ -n "$check_new_domain" ]; then
	check_result "$E_EXISTS" "$new_domain already exists"
fi
is_domain_new '' "$new_domain"
if [ -e "$HOMEDIR/$user/web/$new_domain" ] || [ -e "$HOMEDIR/$user/conf/web/$new_domain" ]; then
	check_result "$E_EXISTS" "a folder for $new_domain already exists"
fi

get_domain_values 'web'

# These carry the old name or path where a rename does not reach; switched off first and on again after.
blockers=''
[ "$SSL" = 'yes' ] && blockers+=', SSL'
[ -n "$FTP_USER" ] && blockers+=', FTP accounts'
[ -n "$CUSTOM_DOCROOT" ] && blockers+=', custom document root'
[ -n "$WP" ] && [ "$WP" != 'no' ] && blockers+=', WordPress'
[ -n "$STATS" ] && blockers+=', web statistics'
while IFS= read -r d; do
	[ -n "$d" ] && blockers+=", custom document root of $d"
done < <(awk -v p="CUSTOM_DOCROOT='$HOMEDIR/$user/web/$domain/" 'index($0, p) { match($0, /^DOMAIN='"'"'[^'"'"']*'"'"'/); print substr($0, 9, RLENGTH - 9) }' "$USER_DATA/web.conf")
if [ -n "$blockers" ]; then
	check_result "$E_FORBIDEN" "switch off first: ${blockers#, }"
fi

# Dots escaped, or renaming a.b.com also rewrites the aXb.com record.
sed -i "s/DOMAIN='${domain//./\\.}'/DOMAIN='$new_domain'/" $USER_DATA/web.conf

# An alias below the old name moves with it (www.old -> www.new); every other alias stays.
new_alias=''
IFS=, read -ra _alias_list <<< "$ALIAS"
for a in "${_alias_list[@]}"; do
	[ -n "$a" ] || continue
	case "$a" in
		"$domain") a=$new_domain ;;
		*."$domain") a=${a%."$domain"}.$new_domain ;;
	esac
	[ "$a" = "$new_domain" ] && continue
	[[ ",$new_alias," == *",$a,"* ]] || new_alias+="${new_alias:+,}$a"
done
if [ "$ALIAS" != "$new_alias" ]; then
	update_object_value 'web' 'DOMAIN' "$new_domain" '$ALIAS' "$new_alias"
fi

mv "$HOMEDIR/$user/web/$domain" "$HOMEDIR/$user/web/$new_domain"
cd /var/log/$WEB_SYSTEM/domains
mv "$domain.log" "$new_domain.log"
mv "$domain.error.log" "$new_domain.error.log"
mv "$domain.bytes" "$new_domain.bytes"
rm -f "$HOMEDIR/$user/web/$new_domain/logs/$domain.log" "$HOMEDIR/$user/web/$new_domain/logs/$domain.error.log"

# The jail is watching the old filename; a rename is invisible to it.
if [ -n "$FIREWALL_EXTENSION" ]; then
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source $HESTIA/include/fail2ban.sh
	fail2ban_watch_domain del "$domain"
	fail2ban_watch_domain add "$new_domain"
fi

del_web_config "$WEB_SYSTEM" "$TPL.tpl"

if [ -n "$PROXY_SYSTEM" ]; then
	del_web_config "$PROXY_SYSTEM" "$PROXY.tpl"
	# Zone and cache are keyed by the old name; the closing rebuild recreates both.
	# Literal nginx path (proxy cache is nginx-only), matching the add and delete commands.
	rm -f "/etc/nginx/conf.d/cache-zone.$domain.conf"
	rm -rf "/var/cache/nginx/$domain"
fi

if [ -n "$BACKEND" ]; then
	prepare_web_backend
	delete_web_backend
fi

# The fragments move with the domain; the rebuild renders the vhosts into the new folder.
mv "$HOMEDIR/$user/conf/web/$domain" "$HOMEDIR/$user/conf/web/$new_domain"

$BIN/h-rebuild-web-domains "$user" "$restart"

$BIN/h-log-action "$user" "Info" "Web" "Renamed web domain (Old Domain: $domain, New Domain: $new_domain)."
log_event "$OK" "$ARGUMENTS"

exit

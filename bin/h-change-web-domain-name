#!/bin/bash
# info: change web domain name
# options: USER DOMAIN NEW_DOMAIN [RESTART]
#
# example: h-change-web-domain-name alice wonderland.com lookinglass.com yes
#
# Renames a web domain. Aliases below the old name move with it; what a rename cannot carry is refused.

user=$1
domain=$2
new_domain=${3,,}
restart=${4:-yes}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN NEW_DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_domain_format_valid "$new_domain"
is_web_domain_name_valid "$new_domain"
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
get_domain_values 'web'
# The hostname's certificate is issued through the web domain of that name.
[ "$domain" != "$(hostname -f)" ] || check_result "$E_FORBIDEN" "$domain carries the hostname's certificate"

# An alias below the old name moves with it (www.old -> www.new); every other alias stays.
rename_name() { # NAME
	case "$1" in
		"$domain") echo "$new_domain" ;;
		*."$domain") echo "${1%."$domain"}.$new_domain" ;;
		*) echo "$1" ;;
	esac
}
name_idn() { # NAME
	if [[ "$1" = *[![:ascii:]]* ]]; then idn2 --quiet "$1"; else echo "$1"; fi
}
new_domain_idn=$(name_idn "$new_domain")
new_alias=''
IFS=, read -ra _alias_list <<< "$ALIAS"
for a in "${_alias_list[@]}"; do
	[ -n "$a" ] || continue
	a=$(rename_name "$a")
	[ "$a" = "$new_domain" ] && continue
	[[ ",$new_alias," == *",$a,"* ]] || new_alias+="${new_alias:+,}$a"
done

# A name the domain does not answer to yet is held to what an add demands. Not is_domain_new '': it passes
# every alias of the user, also one that another domain of the user holds.
new_names=''
IFS=, read -ra _alias_list <<< "$new_domain,$new_alias"
for a in "${_alias_list[@]}"; do
	[ -n "$a" ] || continue
	[[ ",$ALIAS," == *",$a,"* ]] && continue
	is_domain_new 'web' "$a"
	[ "$(name_idn "$a")" = "$a" ] || is_domain_new 'web' "$(name_idn "$a")"
	new_names+="${new_names:+,}$a"
done
is_base_domain_owner "$new_names"
if [ -e "$HOMEDIR/$user/web/$new_domain" ] || [ -e "$HOMEDIR/$user/conf/web/$new_domain" ]; then
	check_result "$E_EXISTS" "a folder for $new_domain already exists"
fi

# The certificate's names after the rename: the domain and each alias it covers, mapped like the aliases. An own
# certificate must already cover them, Let's Encrypt needs their DNS; both checked before anything moves.
cert_aliases=''
if [ "$SSL" = 'yes' ]; then
	crt="$USER_DATA/ssl/$domain.crt"
	san=",$(openssl x509 -noout -ext subjectAltName -in "$crt" 2> /dev/null | sed -n 's/DNS://gp' | tr -d ' '),"
	IFS=, read -ra _alias_list <<< "$ALIAS"
	for a in "${_alias_list[@]}"; do
		[ -n "$a" ] && [[ "$san" == *",$(name_idn "$a"),"* ]] || continue
		a=$(rename_name "$a")
		[ "$a" = "$new_domain" ] || [[ ",$cert_aliases," == *",$a,"* ]] || cert_aliases+="${cert_aliases:+,}$a"
	done
	IFS=, read -ra _alias_list <<< "$new_domain,$cert_aliases"
	if [ "$LETSENCRYPT" = 'yes' ]; then
		LE_API='https://acme-v02.api.letsencrypt.org'
		[ "$LE_STAGING" != 'yes' ] || LE_API='https://acme-staging-v02.api.letsencrypt.org'
		for a in "${_alias_list[@]}"; do
			le_dns_check "$(name_idn "$a")"
			case $? in
				0) ;;
				1) check_result "$E_NOTEXIST" "no DNS record for $a, Let's Encrypt cannot issue the renamed certificate" ;;
				*) check_result "$E_CONNECT" "cannot verify DNS for $a" ;;
			esac
		done
	else
		# By the text: OpenSSL 3.0 exits 0 on a mismatch as well.
		for a in "${_alias_list[@]}"; do
			openssl x509 -noout -checkhost "$(name_idn "$a")" -in "$crt" 2> /dev/null | grep -q ' does match ' \
				|| check_result "$E_FORBIDEN" "the certificate does not cover $a; replace it or switch SSL off first"
		done
	fi
fi

rename_warn=''
# Dots escaped, or renaming a.b.com also rewrites the aXb.com record.
sed -i "s/DOMAIN='${domain//./\\.}'/DOMAIN='$new_domain'/" $USER_DATA/web.conf

if [ "$ALIAS" != "$new_alias" ]; then
	update_object_value 'web' 'DOMAIN' "$new_domain" '$ALIAS' "$new_alias"
fi

if [ "$SSL" = 'yes' ]; then
	for f in crt key pem ca; do
		[ ! -e "$USER_DATA/ssl/$domain.$f" ] || mv -f "$USER_DATA/ssl/$domain.$f" "$USER_DATA/ssl/$new_domain.$f"
	done
fi

# A document root inside the old folder follows it, this domain's or another's of the user. Subshell: the
# update parses that record into the globals this command still reads.
old_dir="$HOMEDIR/$user/web/$domain"
while IFS= read -r line; do
	d=$(record_field "$line" DOMAIN) || continue
	for key in CUSTOM_DOCROOT CUSTOM_PHPROOT; do
		v=$(record_field "$line" "$key") || continue
		case "$v" in
			"$old_dir" | "$old_dir"/*)
				(update_object_value 'web' 'DOMAIN' "$d" "\$$key" "$HOMEDIR/$user/web/$new_domain${v#"$old_dir"}")
				;;
		esac
	done
done < "$USER_DATA/web.conf"

mv "$HOMEDIR/$user/web/$domain" "$HOMEDIR/$user/web/$new_domain"
for f in log error.log bytes; do
	mv "/var/log/$WEB_SYSTEM/domains/$domain.$f" "/var/log/$WEB_SYSTEM/domains/$new_domain.$f"
done
rm -f "$HOMEDIR/$user/web/$new_domain/logs/$domain.log" "$HOMEDIR/$user/web/$new_domain/logs/$domain.error.log"

# awstats names its data files by the config, the IDN name; renamed, the history stays. The rebuild writes the
# new config, link and queue line.
if [ -n "$STATS" ]; then
	sed -i "/ ${domain//./\\.}$/d" $CONF_DIR/queue/webstats.pipe
	rm -f "/etc/awstats/$STATS.$domain_idn.conf"
	stats_dir="$HOMEDIR/$user/web/$new_domain/stats"
	# 551 by design, opened for the moves as the stat build does.
	if ! user_exec test -w "$stats_dir"; then
		user_exec chmod u+w "$stats_dir"
		stats_closed=yes
	fi
	for f in "$stats_dir"/awstats[0-9]*."$domain_idn".txt "$stats_dir/dnscachelastupdate.$domain_idn.hash"; do
		[ -e "$f" ] || continue
		g=${f##*/}
		user_exec mv -n "$f" "$stats_dir/${g%."$domain_idn".*}.$new_domain_idn.${g##*.}"
	done
	[ -z "$stats_closed" ] || user_exec chmod u-w "$stats_dir"
fi

# The jail is watching the old filename; a rename is invisible to it.
if [ -n "$FIREWALL_EXTENSION" ]; then
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source $HESTIA/include/fail2ban.sh
	fail2ban_watch_domain del "$domain"
	fail2ban_watch_domain add "$new_domain"
fi

del_web_config "$WEB_SYSTEM" "$TPL.tpl"

if [ -n "$PROXY_SYSTEM" ]; then
	del_web_config "$PROXY_SYSTEM" "$PROXY.tpl"
	# Zone and cache are keyed by the old name; the closing rebuild recreates both.
	# Literal nginx path (proxy cache is nginx-only), matching the add and delete commands.
	rm -f "/etc/nginx/conf.d/cache-zone.$domain.conf"
	rm -rf "/var/cache/nginx/$domain"
fi
if [ "$WEB_SYSTEM" = 'nginx' ]; then
	remove_pool_zone /etc/nginx/conf.d/fastcgi_cache_pool.conf "$domain"
	rm -rf "/var/cache/nginx/micro/$domain"
fi

if [ -n "$BACKEND" ]; then
	prepare_web_backend
	delete_web_backend
fi

# The fragments move with the domain; the rebuild renders the vhosts into the new folder.
mv "$HOMEDIR/$user/conf/web/$domain" "$HOMEDIR/$user/conf/web/$new_domain"
# The rebuild copies the certificate in under the new name.
rm -f "$HOMEDIR/$user/conf/web/$new_domain/ssl/$domain".*
# The ssl variant of a fragment is an absolute link to the plain one; it follows the folder.
for l in "$HOMEDIR/$user/conf/web/$new_domain"/*; do
	[ -L "$l" ] || continue
	t=$(readlink "$l")
	case "$t" in
		"$HOMEDIR/$user/conf/web/$domain"/*) ln -sfn "$HOMEDIR/$user/conf/web/$new_domain/${t#"$HOMEDIR/$user/conf/web/$domain/"}" "$l" ;;
	esac
done
# A redirect to the domain itself (the panel's two choices) points at the new name, written anew.
if [ "$REDIRECT" = "$domain" ] || [ "$REDIRECT" = "www.$domain" ]; then
	$BIN/h-delete-web-domain-redirect "$user" "$new_domain" 'no' > /dev/null 2>&1
	$BIN/h-add-web-domain-redirect "$user" "$new_domain" "$(rename_name "$REDIRECT")" "${REDIRECT_CODE:-301}" 'no' > /dev/null 2>&1 \
		|| rename_warn+=", the redirect to $REDIRECT is gone"
fi

# The accounts share the customer's uid, so usermod -d refuses while any of its processes runs. Removed instead,
# the rebuild creates them again below the new folder from the record, which first gets the live hashes.
if [ -n "$FTP_USER" ]; then
	ftp_md5=$FTP_MD5
	i=0
	IFS=: read -ra _ftp_list <<< "$FTP_USER"
	for f in "${_ftp_list[@]}"; do
		i=$((i + 1))
		[ -n "$f" ] || continue
		h=$(getent shadow "$f" | cut -d: -f2)
		[ -z "$h" ] || ftp_md5=$(ftp_list_edit "$ftp_md5" "$i" "$h")
	done
	update_object_value 'web' 'DOMAIN' "$new_domain" '$FTP_MD5' "$ftp_md5"
	for f in "${_ftp_list[@]}"; do
		[ -n "$f" ] || continue
		/usr/sbin/userdel -f "$f" > /dev/null 2>&1
		getent passwd "$f" > /dev/null && rename_warn+=", FTP account $f keeps its old home"
	done
fi

$BIN/h-rebuild-web-domains "$user" "$restart"

# Last, the one step that needs the network. Failing, it leaves the domain renamed over http rather than
# serving the old name's certificate.
if [ "$SSL" = 'yes' ] && [ "$LETSENCRYPT" = 'yes' ]; then
	if ! le_msg=$($BIN/h-add-letsencrypt-domain "$user" "$new_domain" "$cert_aliases" 2>&1); then
		$BIN/h-delete-web-domain-ssl "$user" "$new_domain" "$restart" > /dev/null 2>&1
		rename_warn+=", Let's Encrypt failed and SSL is off (${le_msg//$'\n'/ }), h-add-letsencrypt-domain issues it later"
	fi
fi

# WordPress keeps its docroot in the cron job and its address in home and siteurl. An address on a name that
# moved is rewritten; links inside the content are the customer's, the output names the command for them.
if [ "$WP" = 'yes' ]; then
	old_root="$HOMEDIR/$user/web/$domain/public_html"
	docroot="$HOMEDIR/$user/web/$new_domain/public_html"
	for job in $("$BIN/h-list-cron-jobs" "$user" plain 2> /dev/null | grep -F -- "--path=$old_root " | cut -f 1); do
		"$BIN/h-delete-cron-job" "$user" "$job" > /dev/null 2>&1
	done
	wp_cron_sync "$new_domain" || rename_warn+=", the WordPress cron job was not added"
	wp_php=$(wp_domain_php "$new_domain")
	wp_user() { (cd / && user_exec env HOME="$HOMEDIR/$user" timeout 60 "$wp_php" /usr/local/bin/wp "$@" --path="$docroot"); }
	ssl_now=$(get_object_value 'web' 'DOMAIN' "$new_domain" '$SSL')
	for opt in home siteurl; do
		v=$(wp_user option get "$opt" 2> /dev/null)
		[[ "$v" =~ ^(https?)://([^/]+)$ ]] || continue
		scheme=${BASH_REMATCH[1]} host=${BASH_REMATCH[2]}
		case "$host" in
			"$domain_idn") host=$new_domain_idn ;;
			*) host=$(rename_name "$host") ;;
		esac
		[ "$ssl_now" = 'yes' ] || scheme=http
		[ "$scheme://$host" != "$v" ] || continue
		wp_user option update "$opt" "$scheme://$host" > /dev/null 2>&1 || rename_warn+=", WordPress $opt is still $v"
	done
	echo "WordPress: links inside the content still name $domain; wp search-replace '$domain' '$new_domain' takes them along"
fi

$BIN/h-log-action "$user" "Info" "Web" "Renamed web domain (Old Domain: $domain, New Domain: $new_domain)."
if [ -n "$rename_warn" ]; then
	check_result "$E_UPDATE" "$domain is renamed to $new_domain, but: ${rename_warn#, }"
fi
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change web domain php version
# options: USER DOMAIN VERSION [RESTART]
#
# example: h-change-web-domain-php admin acme.com 8.3
#
# This function changes the PHP version a web domain runs on. The version is its own
# field since #591; the pool profile (BACKEND) is left untouched.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
version=$3
restart=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN VERSION [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_BACKEND" 'WEB_BACKEND'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
# The version must be installed; 'none' is the explicit "no pool" value
if [ "$version" != 'none' ]; then
	[[ "$version" =~ ^[0-9]+\.[0-9]+$ ]] || check_result "$E_INVALID" "invalid PHP version $version"
	[ -n "$($BIN/h-list-sys-php plain | grep -xF -- "$version")" ] \
		|| check_result "$E_NOTEXIST" "PHP version $version is not installed"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Read this domain's own record with a literal match (get_domain_values greps unescaped, #594)
web_record=$(grep -F "DOMAIN='$domain'" "$USER_DATA/web.conf")
stored_version=$(grep -oE "PHP_VERSION='[^']*'" <<< "$web_record" | cut -d "'" -f 2)

# Skip only when the FIELD already holds this version. An empty field is the pre-#591 sentinel
# ("follow the system default"): always write it, even when the effective version is unchanged,
# so the domain is pinned instead of drifting on the next system-default change.
if [ -n "$stored_version" ] && [ "$stored_version" = "$version" ]; then
	exit
fi

# The version the domain actually runs right now, before the rebuild moves the pool - this is
# what still holds the old socket. Restart derives from it, not from a guessed default, so a
# first-run legacy domain does not needlessly restart the default version's master.
old_version=$(web_domain_pool_version "$domain" "$user")

# Write the field, then rebuild this one domain: the pool moves to the new version and the
# vhost picks up the new fastcgi socket.
add_object_key 'web' 'DOMAIN' "$domain" 'PHP_VERSION' 'BACKEND'
update_object_value 'web' 'DOMAIN' "$domain" '$PHP_VERSION' "$version"

$BIN/h-rebuild-web-domain "$user" "$domain" "$restart"
check_result $? "Rebuild failed" > /dev/null

if [ "$(get_object_value 'web' 'DOMAIN' "$domain" '$WP')" = 'yes' ]; then
	wp_cron_sync "$domain" || echo "WARN: the wp-cron entry could not be moved to PHP $version"
fi

# The old master still holds the now-removed pool's socket until it reloads. Checked like the
# rebuild: a failed restart must not report success while the domain serves a dead socket.
if [ -n "$old_version" ] && [ "$old_version" != "$version" ]; then
	$BIN/h-restart-web-backend "$restart" "$old_version"
	check_result $? "PHP restart failed" > /dev/null
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "$user" "Info" "Web" "PHP version changed (Domain: $domain, Version: $version)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: change web domain proxy template
# options: USER DOMAIN TEMPLATE [EXTENTIONS] [RESTART]
#
# example: h-change-web-domain-proxy-tpl admin domain.tld hosting
#
# This function changes proxy template

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
template=$3
default_extentions="jpg,jpeg,gif,png,ico,svg,css,zip,tgz,gz,rar,bz2,doc,xls,\
exe,pdf,ppt,txt,odt,ods,odp,odf,tar,wav,bmp,rtf,js,mp3,avi,mpeg,flv,html,htm"
extentions=${4-$default_extentions}
restart="$5"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TEMPLATE [EXTENTIONS] [RESTART]'
is_format_valid 'user' 'domain' 'template' 'extentions' 'restart'
is_system_enabled "$PROXY_SYSTEM" 'PROXY_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_object_value_exist 'web' 'DOMAIN' "$domain" '$PROXY'
# Legacy values are mapped rather than rejected; a typo still errors out
if ! tpl_accepted=$(accept_web_template 'proxy' "$template" strict); then
	is_proxy_template_valid $template
fi
read -r template tpl_effect <<< "$tpl_accepted"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing domain values
get_domain_values 'web'
local_ip=$(get_real_ip "$IP")

# Delete old vhost
del_web_config "$PROXY_SYSTEM" "$PROXY.tpl"

# Add new vhost
PROXY="$template"
PROXY_EXT="$extentions"

prepare_web_domain_values
add_web_config "$PROXY_SYSTEM" "$PROXY.tpl"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating config
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY' "$PROXY"
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_EXT' "$extentions"

# 'caching' is the cache switch now, so honour the intent behind the old value
if [ "$tpl_effect" = 'cache' ]; then
	$BIN/h-add-web-domain-cache "$user" "$domain"
fi

# Restarting proxy
$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Proxy template changed (Domain: $domain, Template: $template)."
log_event "$OK" "$ARGUMENTS"

exit

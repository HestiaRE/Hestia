#!/bin/bash
# info: change web domain template
# options: USER DOMAIN TEMPLATE [RESTART]
#
# example: h-change-web-domain-tpl admin acme.com wordpress
#
# This function changes template of the web configuration file. The content
# of webdomain directories remains untouched.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
template=$3
restart=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TEMPLATE [RESTART]'
is_format_valid 'user' 'domain' 'template' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
# Legacy values are mapped rather than rejected; a typo still errors out
if ! tpl_accepted=$(accept_web_template 'web' "$template" strict); then
	is_web_template_valid "$template"
fi
read -r template tpl_effect <<< "$tpl_accepted"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing domain values
get_domain_values 'web'
local_ip=$(get_real_ip "$IP")
export local_ip

# Deleting domain
del_web_config "$WEB_SYSTEM" "$TPL.tpl"

# Defining variables for new vhost config
prepare_web_domain_values
add_web_config "$WEB_SYSTEM" "$template.tpl"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Changing tpl in config
update_object_value 'web' 'DOMAIN' "$domain" '$TPL' "$template"

# Restarting web
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

# Logging
$BIN/h-log-action "$user" "Info" "Web" "Web domain template applied (Domain: $domain, Template: $template)."
log_event "$OK" "$ARGUMENTS"

exit

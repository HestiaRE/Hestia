#!/bin/bash
# info: check that a firewall jail chain is wired
# options: CHAIN
# labels: internal
# caller: the fail2ban actions
#
# example: h-check-firewall-chain SSH
#
# fail2ban's actioncheck: exits 0 while the jail's set exists and the input chain still matches it.
# A wrong "missing" is expensive: fail2ban answers a failed actioncheck with actionstop + actionstart.

chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'CHAIN'
is_format_valid 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

fw_jail_wired "$chain"
exit $?

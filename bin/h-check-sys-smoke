check_panel_cli_i18n
check_port "${BACKEND_PORT:-8083}" "panel"
check_panel_port
check_http "https://127.0.0.1:${BACKEND_PORT:-8083}/login/" "panel login page"
# The v6 twin of the same probe: a listener that binds only v4 looks identical from 127.0.0.1.
# Loopback, so it needs a v6 kernel and nothing else - measured 200 on v4-only, dual and v6-only boxes.
if [ -e /proc/net/if_inet6 ]; then
	check_http "https://[::1]:${BACKEND_PORT:-8083}/login/" "panel login page over v6"
else
	skip "panel login page over v6 (this kernel has no IPv6)"
fi
# invalid sudoers → no privileged panel action works
check_sudoers /etc/sudoers.d/hestia "hestia grant"
check_project_quota
check_customer_php_slice

# --- Configured subsystems (derived from *_SYSTEM) ---
echo "-- services --"
[ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'nginx' ] && check_service "$WEB_SYSTEM" "web"
[ -n "$PROXY_SYSTEM" ] && [ "$PROXY_SYSTEM" != 'remote' ] && check_service "$PROXY_SYSTEM" "reverse proxy"
# mailfront (#193): customer web absent by design, but the webmail/ACME front must run
[ -z "$WEB_SYSTEM" ] && [ -n "${WEBMAIL_FRONT:-}" ] && check_service "$WEBMAIL_FRONT" "webmail front"
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_service "$MAIL_SYSTEM" "mail"
check_notification_mta
check_exim_sendonly
check_family_lage
[ -n "$MAIL_SYSTEM" ] && check_exim_macro_names
[ -n "$MAIL_SYSTEM" ] && check_exim_interface_expansion
[ -n "$IMAP_SYSTEM" ] && [ "$IMAP_SYSTEM" != 'remote' ] && check_service "$IMAP_SYSTEM" "imap"
[ -n "$ANTISPAM_SYSTEM" ] && [ "$ANTISPAM_SYSTEM" != 'remote' ] && check_service "$ANTISPAM_SYSTEM" "antispam"
[ -n "$FTP_SYSTEM" ] && [ "$FTP_SYSTEM" != 'remote' ] && check_service "$FTP_SYSTEM" "ftp"
[ -n "$CRON_SYSTEM" ] && check_service "$CRON_SYSTEM" "cron"
is_on() { [ "${1:-}" = "true" ] || [ "${1:-}" = "yes" ]; }
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then check_service mariadb "database (mysql)"; fi
# postgres flag does NOT write 'pgsql' into DB_SYSTEM → key off the component flag too
if echo "$DB_SYSTEM" | grep -qw 'pgsql' || is_on "${COMPONENT_DB_POSTGRESQL:-}"; then
	check_service postgresql "database (pgsql)"
fi
if is_on "${COMPONENT_ADDON_FAIL2BAN:-}"; then
	check_service fail2ban "fail2ban"
	# The service being up says nothing about whether any jail is: these four are what make a green run
	# mean working brute-force protection.
	check_fail2ban_config
	check_fail2ban_jails
	check_fail2ban_banaction
	check_fail2ban_logpaths
	check_fail2ban_backends
	check_fail2ban_web_logpath
fi
# clamav's service check moved into the addon recount, which also verifies the other six
check_addons_swallowed
is_on "${COMPONENT_ADDON_CROWDSEC:-}" && check_service crowdsec "crowdsec"
# Layer separation runs whenever either system is present (marker or extension), not gated on a component.
{ [ -f "$CONF_DIR/firewall/crowdsec.conf" ] || [ "$FIREWALL_EXTENSION" = 'fail2ban' ]; } && check_firewall_layer_separation
# L3 feeder timer only where CrowdSec L3 is wired (the marker) - keyed off the artefact,
# not just the component flag, so a crowdsec-without-L3 state doesn't false-fail.
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && check_service hestia-crowdsec-l3.timer "crowdsec L3 feeder timer"
# fleet-mesh timer only where mesh is enabled (its marker conf), same artefact-gated reasoning.
if [ -f "$CONF_DIR/crowdsec/mesh.conf" ]; then
	check_service hestia-crowdsec-mesh.timer "crowdsec fleet-mesh timer"
	check_mesh_serve_staged
fi
# adminer/webmail: no own daemon — served by a caddy FPM pool, so check the socket
is_on "${COMPONENT_ADDON_ADMINER:-}" && check_socket /run/hestia-adminer.sock "adminer FPM"
check_webmail_value_domain
check_backup_container_meta
check_backup_diff_member_name
if echo "$WEBMAIL_SYSTEM" | grep -qw 'roundcube'; then
	check_webmail_payload roundcube /etc/roundcube/config.inc.php
	check_socket /run/hestia-webmail-roundcube.sock "roundcube FPM"
	check_http "http://127.0.0.1:8090/" "roundcube internal listener"
	grep -q "^\$config\['db_dsnw'\] = 'sqlite:" /etc/roundcube/config.inc.php 2> /dev/null \
		&& check_webmail_sqlite_driver roundcube
fi
if echo "$WEBMAIL_SYSTEM" | grep -qw 'tachyon'; then
	check_webmail_payload tachyon /etc/tachyon/data/VERSION
	check_socket /run/hestia-webmail-tachyon.sock "tachyon FPM"
	check_http "http://127.0.0.1:8091/" "tachyon internal listener"
	grep -A10 '^\[contacts\]' /etc/tachyon/data/_data_/_default_/configs/application.ini 2> /dev/null \
		| grep -q 'type = "sqlite"' && check_webmail_sqlite_driver tachyon
fi
# redis: user's DB choice or rspamd's always-present Bayes companion
if is_on "${COMPONENT_DB_REDIS:-}" || [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	check_service redis-server "redis"
fi

# --- Firewall datapath (live state, not just the daemon) ---
# The two invariants a green service check cannot see. Both keyed off FIREWALL_SYSTEM, since an
# ACCEPT policy is correct when the firewall is deliberately off. The invariants outlive the
# iptables renderer (#495 re-expresses them against nft), the mechanism below does not.
if [ -n "$FIREWALL_SYSTEM" ] && [ "$FIREWALL_SYSTEM" != 'remote' ]; then
	echo "-- firewall --"
	check_firewall_backend
	check_firewall_closed
	check_firewall_icmpv6
	check_firewall_ruleset_loadable
	check_firewall_chains_tracked
	check_firewall_rules_rendered
	check_firewall_ipsets_populated
fi

# --- Ports implied by the active config ---
echo "-- ports --"
if [ -n "$PROXY_SYSTEM" ] || [ -n "$(webmail_front)" ]; then
	check_port 80 "http"
	check_port 443 "https"
fi
echo "$DB_SYSTEM" | grep -qw 'mysql' && check_port 3306 "mysql"
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_port 25 "smtp"
# banner, not just port: IMAP/SMTP must actually answer (a hung login still listens)
if [ -n "$IMAP_SYSTEM" ] && [ "$IMAP_SYSTEM" != 'remote' ]; then
	check_banner 143 "imap"
fi
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_banner 25 "smtp"
if [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	# group-restricted unix sockets — rspamd has no TCP ports
	check_socket /run/rspamd/normal.sock "rspamd scan worker"
	check_socket /run/rspamd/controller.sock "rspamd controller"
	check_rspamd_ctrl_isolation
fi
# localhost-only (webmail managesieve plugin), not opened in the firewall
[ "$SIEVE_SYSTEM" = 'yes' ] && check_port 4190 "managesieve"

# --- Critical log markers ---
echo "-- logs --"
check_log_clean "/var/log/hestia-php-fpm.log" "PHP (Fatal|Parse) error|\[emergency\]|\[alert\]" "panel FPM"
if [ -n "$PROXY_SYSTEM" ] || [ -n "${WEBMAIL_FRONT:-}" ]; then
	check_log_clean "/var/log/nginx/error.log" "\[emerg\]|\[alert\]" "nginx"
fi
[ "$WEB_SYSTEM" = 'apache2' ] && check_log_clean "/var/log/apache2/error.log" "\[.*:emerg\]|\[.*:alert\]" "apache2"
# exim writes serious problems to a dedicated paniclog — non-empty means trouble
[ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'remote' ] && check_file_empty "/var/log/exim4/paniclog" "exim paniclog"

# --- Security invariants (static source gates) ---
echo "-- security invariants --"
check_sudo_secret_leak
# GHSA-fcq6: auth gate must not compare a bare $ROOT_USER (legit: $_SESSION["ROOT_USER"])
check_source_absent "no bare \$ROOT_USER auth gate (GHSA-fcq6)" '\$ROOT_USER' "$HESTIA/web"
# GHSA-cr7q and the GHSA-xffx class were guarded file by file here; check_eval_sites covers both and
# every other file besides, so the two named checks would only be a list to forget.
# GHSA-xffx class: source_conf must keep its identifier guard on the key, or a
# `key[$(cmd)]=` line in any parsed conf executes cmd through declare -g. Positive
# check: the sink is shared by ~500 callers, so losing the guard is a silent hole.
if grep -qE '\[\[ \$lhs =~ \^\[A-Za-z_\]' "$HESTIA/include/main.sh" 2> /dev/null; then
	ok "invariant: source_conf rejects non-identifier keys (GHSA-xffx class)"
else
	no "invariant: source_conf rejects non-identifier keys (GHSA-xffx class)" "guard missing in include/main.sh"
fi
# #438: the real session user may only be touched by allowlisted files (auth /
# dispatch / reset / real-identity display) — everything else must use the
# look-aware $user/$user_plain, or an admin impersonating a customer mis-targets.
check_session_user_allowlist "$HESTIA/web"
# #438: userContext is the effective role and is what admin-gates read. The old
# effective-mirror $_SESSION["role"] must NOT be compared against (it was unified
# onto userContext) — a divergent mirror would silently split the gate surface.
check_source_absent "no gating on the effective-mirror \$_SESSION[role] (#438 — use userContext)" \
	'\$_SESSION\["role"\][[:space:]]*(==|!=)' "$HESTIA/web"
# #441/#443: X-Accel-Redirect only from the allowlisted RRD handler; a new download
# emitting it would hit the caddy-can't-read wall (stream via inc/download.php instead).
check_xaccel_allowlist "$HESTIA/web"
# v-* compat symlinks must all resolve (no dangling alias left by a rename).
check_v_symlinks_resolve
# an sbin command called through a bin/ path resolves to nothing (the sbin split, #209).
check_sbin_not_under_bin
# a pinned locale that is not generated makes every locale-aware child warn.
check_panel_locale
# a policy fragment (crowdsec Layer A, bot rate limiting) missing from one template is a silent bypass.
check_policy_fragment_coverage
# a cache flag without its zone (or a 0-byte vhost) fails silently until the next reload.
if [ "$WEB_SYSTEM" = 'nginx' ] || [ "$PROXY_SYSTEM" = 'nginx' ]; then
	check_web_cache_zones
fi
check_vhost_nonempty
check_web_hsts_effective
check_web_http3_orphan
check_web_docker_wildcard
# #120: an interrupted model switch must not stay invisible.
check_web_model_sentinel
check_realip_header
# fail-open is invisible to users: verify the live mount, not the intent (#565).
check_proc_hardening
# a record pointing at a removed template only shows up on the next rebuild.
check_web_templates_resolvable
check_vhost_upstream_host
check_vhost_listen_form
check_web_record_has_vhost
check_logrotate_parses
check_restic_mode_supported
check_restic_pairs
check_protected_names
check_protected_names_effective
# 644 from the old /tmp sort path was silent on every box (#960).
check_hestia_conf_mode
check_install_root_owner
check_secret_file_modes
check_record_only_protected
check_eval_sites
check_yescrypt_hashing
check_record_name_patterns
check_error_code_registry
# derived counters drift silently when an increase/decrease pair dies half way.
check_object_counters
check_ip_object_counters
check_ip_object_shape
check_release_mirror
check_record_grammar
check_key_registries
check_sys_key_registry
check_system_keys_agree
check_identity_band
# a cap written for a companion that is gone would be inherited by whoever gets the uid next.
check_slice_dropins_owned

#----------------------------------------------------------#
#                       Result                             #
#----------------------------------------------------------#

echo "=== result: $pass passed, $fail failed ==="
if [ "$fail" -gt 0 ]; then
	exit 1
fi
exit 0

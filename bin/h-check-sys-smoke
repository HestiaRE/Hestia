#!/bin/bash
# info: post-install smoke test (services, ports, logs)
# options: NONE
#
# example: h-check-sys-smoke
#
# Checks that the services the configuration implies run, their ports answer and the key logs are clean.
# Expectations come from the status keys in hestia.conf; only the addon recount reads the install recipe.
# Exits 1 on any FAIL.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source $HESTIA/include/fail2ban.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
# shellcheck source=/usr/local/hestia/include/limits.sh
source $HESTIA/include/limits.sh
# shellcheck source=/usr/local/hestia/include/ports.sh
source $HESTIA/include/ports.sh
# For record_line_valid, so the grammar keeps one definition.
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"
# The recipe, for the addon recount alone (chosen-but-absent). Every other gate reads the status.
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

pass=0
fail=0

ok() {
	echo "[ PASS ] $1"
	pass=$((pass + 1))
}
no() {
	echo "[ FAIL ] $1${2:+, $2}"
	fail=$((fail + 1))
}
skip() { echo "[ skip ] $1"; }

# A guard verifies an artefact, it never fills one: nothing here calls an upd_act_*.

# A marker passed through an allowed panel call must not survive in any persistent log; whether sudo keeps argv
# out depends on its flavour. A control marker to authpriv finds the sink files first. Covers files, not journald.
check_sudo_secret_leak() {
	local probe control f sinks='' leaked=''
	id hestia > /dev/null 2>&1 || {
		skip "sudo argv leak (panel user absent)"
		return
	}
	command -v logger > /dev/null 2>&1 || {
		skip "sudo argv leak (no logger to probe with)"
		return
	}
	probe="HstProbeArgv$(openssl rand -hex 6)"
	control="HstProbeSink$(openssl rand -hex 6)"

	logger -p authpriv.notice "$control"
	runuser -u hestia -- sudo -n "$BIN/h-list-users" list "$probe" > /dev/null 2>&1
	sleep 1

	for f in /var/log/auth.log /var/log/secure /var/log/syslog /var/log/messages; do
		[ -f "$f" ] || continue
		grep -qF "$control" "$f" 2> /dev/null && sinks="$sinks $f"
	done
	if [ -z "$sinks" ]; then
		skip "sudo argv leak (no persistent authpriv file on this box)"
		return
	fi
	for f in $sinks; do
		grep -qF "$probe" "$f" 2> /dev/null && leaked="$leaked $f"
	done
	if [ -n "$leaked" ]; then
		no "panel command lines persist in the system log:$leaked" \
			"neither !log_allowed nor the rsyslog drop rule is effective - panel-set secrets land there in cleartext"
		return
	fi
	ok "no panel command line kept in the persistent logs ($(echo $sinks | wc -w) sink(s) checked)"
}

# check_service <systemd-unit> <label>
check_service() {
	local en
	if ! systemctl is-active --quiet "$1"; then
		no "service $2 ($1) not active" "$(systemctl is-active "$1" 2> /dev/null)"
		return
	fi
	# Active now is not active after a reboot.
	en=$(systemctl is-enabled "$1" 2> /dev/null)
	case "$en" in
		disabled | masked | masked-runtime) no "service $2 ($1) active but $en, a reboot leaves it down" "systemctl enable $1" ;;
		*) ok "service $2 ($1) active" ;;
	esac
}

# check_config_loaded <unit> <label> <shipped config file>...
# `systemctl start` on a running unit is a no-op, so a service can serve a config it never read. An empty file
# set fails. Not covered: per-object files, which change without a restart by design, and reloaded units, which
# keep their start time.
check_config_loaded() {
	local unit="$1" label="$2" started newest=0 n=0 f t
	shift 2
	systemctl is-active --quiet "$unit" || return 0
	started=$(date -d "$(systemctl show "$unit" -p ActiveEnterTimestamp --value 2> /dev/null)" +%s 2> /dev/null)
	if [ -z "$started" ]; then
		no "config load $label: no start timestamp for $unit" "systemctl show gave nothing to compare against"
		return
	fi
	for f in "$@"; do
		[ -f "$f" ] || continue
		n=$((n + 1))
		t=$(stat -c %Y "$f" 2> /dev/null) || continue
		[ "$t" -gt "$newest" ] && newest=$t
	done
	if [ "$n" -eq 0 ]; then
		no "config load $label: no shipped config found" "nothing was compared, so this check proves nothing"
	elif [ "$newest" -gt "$started" ]; then
		no "config load $label: $unit started $((newest - started))s before its newest config file" \
			"$n file(s) examined - the running daemon never read what is on disk, restart it"
	else
		ok "config load $label: $unit started after its newest config ($n file(s) examined)"
	fi
}

# Both jails' system layer in sshd_config, reported and never repaired: sshd_config is operator surface. Not
# covered: whether a customer is jailed, which is per-customer state.
check_jail_sshd() {
	local cfg='/etc/ssh/sshd_config' bad=''
	if [ ! -f "$cfg" ]; then
		no "jail sshd: $cfg missing" "nothing to check against"
		return
	fi
	# sshd -T prints the global section, so a Subsystem line that landed inside a Match block does not count.
	if ! sshd -T > /dev/null 2>&1; then
		no "jail sshd: sshd -T does not run" "$(sshd -t 2>&1 | head -1)"
		return
	fi
	sshd -T 2> /dev/null | grep -qiE '^subsystem[[:space:]]+sftp[[:space:]]+/usr/lib/sftp-server' \
		|| bad="$bad Subsystem-line-not-in-effect(h-add-sys-ssh-jail)"
	grep -qE '^Match[[:space:]]+Group[[:space:]]+sftp-jailed[[:space:]]*$' "$cfg" \
		|| bad="$bad Match-Group-sftp-jailed(h-add-sys-sftp-jail)"
	[ -x /usr/sbin/jailbash ] || bad="$bad jailbash(h-add-sys-ssh-jail)"
	getent group sftp-jailed > /dev/null 2>&1 || bad="$bad group-sftp-jailed(h-add-sys-sftp-jail)"
	if [ -n "$bad" ]; then
		no "jail system layer incomplete:$bad" "re-run the command named in brackets; nothing here writes sshd_config"
	else
		ok "jail system layer complete (Subsystem line, Match block, jailbash, group)"
	fi
}

# check_port <port> <label>
check_port() {
	if ss -H -tln 2> /dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"; then
		ok "port $1 ($2) listening"
	else
		no "port $1 ($2) not listening"
	fi
}

# check_socket <path> <label>, listening unix socket
check_socket() {
	if ss -H -xln 2> /dev/null | grep -qF "$1"; then
		ok "socket $2 ($1) listening"
	else
		no "socket $2 ($1) not listening"
	fi
}

# The live policy, the file the boot unit reloads, and every active rule: fw_rule skips a source that is not
# renderable, and a list without its cache file renders an empty set, both without anything going red.
check_firewall() {
	local ruleset=/etc/hestia/firewall/ruleset.nft rules="$CONF_DIR/firewall/rules.conf" bad='' pol line n=0
	pol=$(fw_policy_get INPUT)
	[ "$pol" = 'DROP' ] || bad="$bad; INPUT policy ${pol:-unreadable}"
	if [ ! -f "$ruleset" ]; then
		bad="$bad; $ruleset missing, a reboot comes up unfiltered"
	elif ! nft -c -f "$ruleset" > /dev/null 2>&1; then
		bad="$bad; nft rejects $ruleset: $(nft -c -f "$ruleset" 2>&1 | head -n1)"
	fi
	if [ -f "$rules" ]; then
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			parse_object_kv_list "$line"
			[ "${SUSPENDED:-no}" = 'yes' ] && continue
			n=$((n + 1))
			case "$IP" in
				0.0.0.0/0 | ::/0 | '') ;;
				ipset:*) [ -s "$(fw_set_src "${IP#ipset:}")" ] || bad="$bad; rule $RULE matches the empty list ${IP#ipset:}" ;;
				*) fw_is_addr "$IP" || fw_is_addr6 "$IP" || bad="$bad; rule $RULE has the unrenderable source $IP" ;;
			esac
		done < "$rules"
	fi
	if [ -n "$bad" ]; then
		no "firewall" "${bad#; }"
	else
		ok "firewall closed (INPUT DROP), persisted ruleset loads, $n active rule(s) render, their lists populated"
	fi
}

# Running must equal configured in both directions: one of ours missing, or a distro jail we never asked for.
check_fail2ban_jails() {
	local want have missing='' extra='' j
	want=$(fail2ban_enabled_jails | sort)
	have=$(fail2ban-client status 2> /dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' '\n' | sort)
	for j in $want; do grep -qx "$j" <<< "$have" || missing="$missing $j"; done
	for j in $have; do grep -qx "$j" <<< "$want" || extra="$extra $j"; done
	# Two empty sets agree too, and that is fail2ban guarding nothing.
	if [ -z "$want" ]; then
		no "fail2ban has no jail enabled in its config" "$F2B_OURS"
	elif [ -n "$missing" ]; then
		no "fail2ban jail enabled in config but not running" "${missing# }"
	elif [ -n "$extra" ]; then
		no "fail2ban is running a jail we did not enable" "${extra# } (a distro jail bans into a ruleset we do not manage)"
	else
		ok "fail2ban jails match the configured set"
	fi
}

# One dump answers three questions: a config error leaves the service up and the jail gone, a foreign banaction
# bans into a ruleset we do not manage, and a jail on a missing file never fires.
check_fail2ban_config() {
	local all errs foreign j pat missing='' bad=''
	all=$(fail2ban-client -d 2>&1)
	# The dump lines are python lists; everything else is the client's own log.
	errs=$(grep -v "^\[" <<< "$all" | grep -m1 ERROR)
	[ -n "$errs" ] && bad="$bad; config error: ${errs#*ERROR   }"
	# `action = hestia[name=SSH]` is instantiated as `hestia-SSH`; a bare `hestia` never matches.
	foreign=$(grep -oE "'addaction', '[^']+'" <<< "$all" | sed "s/.*'\(.*\)'/\1/" | sort -u | grep -v '^hestia-')
	[ -n "$foreign" ] && bad="$bad; foreign banaction: $(echo $foreign)"
	# A missing log file drops out of the dump and leaves only this warning. A glob matching nothing yet is a box
	# without web domains, not a defect.
	while read -r j; do
		[ -n "$j" ] || continue
		pat="$(fail2ban_jail_logpath "$j")"
		[[ "$pat" == *[*?]* ]] && continue
		missing="$missing $j(${pat:-logpath outside $F2B_OURS})"
	done <<< "$(grep -v "^\[" <<< "$all" | sed -n 's/.*Have not found any log file for \(.*\) jail$/\1/p' | sort -u)"
	[ -n "$missing" ] && bad="$bad; jail without its log file:$missing"
	if [ -n "$bad" ]; then
		no "fail2ban config" "${bad#; }"
	else
		ok "fail2ban config parses, bans through the hestia action only, every logpath exists"
	fi
}

# A jail on the systemd backend, or a web jail left on the old stack after a model switch, starts cleanly and
# reports healthy while it watches nothing.
check_fail2ban_watch() {
	local blind='' stale='' j pat want lp
	for j in $(fail2ban_enabled_jails); do
		fail2ban-client status "$j" > /dev/null 2>&1 || continue
		fail2ban-client get "$j" logpath 2> /dev/null | grep -q '^ *`\?- */' && continue
		# A glob matching nothing yet is a box without web domains, not a defect.
		pat="$(fail2ban_jail_logpath "$j")"
		[ -n "$pat" ] && ! compgen -G "$pat" > /dev/null 2>&1 && continue
		blind="$blind $j"
	done
	if want="$(fail2ban_web_logdir 2> /dev/null)"; then
		for j in $F2B_WEB_JAILS; do
			fail2ban_jail_enabled "$j" || continue
			lp="$(fail2ban_jail_logpath "$j")"
			[ -n "$lp" ] || continue
			case "$lp" in "$want"/*) ;; *) stale="$stale $j" ;; esac
		done
	fi
	[ -n "$blind" ] && blind="monitors no file (backend?):$blind"
	[ -n "$stale" ] && stale="not under $want:$stale"
	if [ -n "$blind$stale" ]; then
		no "fail2ban jail watches nothing" "$blind${blind:+${stale:+; }}$stale"
	else
		ok "fail2ban jails watch their log files${want:+, web jails under $want}"
	fi
}

# Installer-only: the soft addon installs (addon_install in h-install-hestia) recounted by their manifest
# artefact, so a swallowed failure does not leave a green install. After a deliberate h-delete-sys-* recipe and
# box disagree on purpose; check_manifest_artefacts watches the box from then on. An empty derivation fails.
is_on() { [ "${1:-}" = "true" ] || [ "${1:-}" = "yes" ]; }
check_addons_swallowed() {
	local m="$HESTIA/share/manifest.json" stage a cid gate key type val n=0
	local pairs
	if [ -z "${HESTIA_INSTALL_RUN:-}" ]; then
		skip "addon recount (installer-only: after a deliberate delete the recipe and the box disagree on purpose)"
		return
	fi
	pairs=$(awk '/^[a-z_]+\(\) \{/ { fn = $1 } /^[[:space:]]*addon_install [a-z0-9-]+[[:space:]]*$/ { print fn, $2 }' \
		"$HESTIA/sbin/h-install-hestia" 2> /dev/null | sort -u)
	if [ -z "$pairs" ]; then
		no "addon recount derived an empty set from h-install-hestia" "the addon_install call shape moved - update the derivation"
		return
	fi
	while read -r stage a; do
		cid="ADDON_${a^^}"
		key=$(jq -r --arg c "$cid" '.components[$c].status_key // empty' "$m" 2> /dev/null)
		type=$(jq -r --arg c "$cid" '.components[$c].status_artefact // {} | keys[0] // empty' "$m" 2> /dev/null)
		val=$(jq -r --arg c "$cid" --arg t "$type" '.components[$c].status_artefact[$t] // empty' "$m" 2> /dev/null)
		if [ -z "$key" ] || [ -z "$type" ]; then
			no "addon $a: the installer swallows its errors, the manifest has no status_key/status_artefact for $cid" "add them there"
			continue
		fi
		gate="COMPONENT_$cid"
		is_on "${!gate:-}" || continue
		[ "$stage" = 'install_mail()' ] && ! is_on "${COMPONENT_MAIL_BLOCK_PRESENT:-}" && continue
		n=$((n + 1))
		if _artefact_present "$type" "$val"; then
			ok "addon $a installed ($type present)"
			[ "$type" = 'service' ] && check_service "$val" "$a"
		else
			no "addon $a requested but its artefact is missing ($type $val)" "the installer swallowed the failure - see the install log"
		fi
	done <<< "$pairs"
	# Redis installs inline, and its package is also rspamd's companion: the key is the proof.
	if is_on "${COMPONENT_DB_REDIS:-}"; then
		n=$((n + 1))
		if [ -n "$REDIS_SYSTEM" ]; then
			ok "redis installed (REDIS_SYSTEM set)"
		else
			no "redis requested but REDIS_SYSTEM is empty" "the installer swallowed the failure - see the install log"
		fi
	fi
	if [ "$n" -eq 0 ]; then
		skip "addon recount (none of the swallowed addons requested)"
	fi
}

# CrowdSec owns Layer-7 and fail2ban owns brute force, so each side's jobs are off while the other is there.
# A transition that re-gates only one direction reintroduces the double-ban.
check_firewall_layer_separation() {
	local bad='' j s
	if [ -f "$CONF_DIR/firewall/crowdsec.conf" ]; then
		for j in $F2B_WEB_JAILS; do
			fail2ban_jail_enabled "$j" 2> /dev/null && bad="$bad webjail:$j"
		done
	fi
	if [ "$FIREWALL_EXTENSION" = 'fail2ban' ] && command -v cscli > /dev/null 2>&1; then
		for s in ssh-bf ssh-slow-bf; do
			[ -e "/etc/crowdsec/scenarios/$s.yaml" ] && bad="$bad crowdsec-bf:$s"
		done
	fi
	if [ -z "$bad" ]; then
		ok "fail2ban and crowdsec layers do not overlap (#542)"
	else
		no "fail2ban/crowdsec layer overlap" "${bad# } - a model transition did not re-gate the counterpart"
	fi
}

# check_http <url> <label>
check_http() {
	local code
	code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2> /dev/null)
	if [ "$code" = "200" ]; then
		ok "$2 (HTTP $code)"
	else
		no "$2 (HTTP ${code:-000})"
	fi
}

# The controller socket must reach the caddy proxy process but not the app pools that share the caddy user.
check_rspamd_ctrl_isolation() {
	local gid pid pgroups
	gid=$(getent group _rspamd-ctrl | cut -d: -f3)
	if [ -z "$gid" ]; then
		no "rspamd controller group _rspamd-ctrl missing"
		return
	fi
	if [ "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)" = '_rspamd-ctrl' ]; then
		ok "controller socket group is _rspamd-ctrl"
	else
		no "controller socket not group _rspamd-ctrl" "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)"
	fi
	# In the group, the app pools would inherit it through initgroups.
	if id -nG caddy 2> /dev/null | tr ' ' '\n' | grep -qxE '_rspamd(-ctrl)?'; then
		no "caddy user is in an rspamd group (app pools would inherit socket access)" "$(id -nG caddy)"
	else
		ok "caddy user not in any rspamd group (app pools isolated)"
	fi
	pid=$(systemctl show -p MainPID --value caddy.service 2> /dev/null)
	pgroups=$(grep -E '^Groups:' /proc/"${pid:-0}"/status 2> /dev/null)
	if echo "$pgroups" | tr ' \t' '\n' | grep -qx "$gid"; then
		ok "caddy proxy process holds _rspamd-ctrl (controller reachable)"
	else
		no "caddy proxy process lacks _rspamd-ctrl (controller UI would break)" "$pgroups"
	fi
}

# check_log_clean <file> <extended-regex> <label>
check_log_clean() {
	if [ ! -f "$1" ]; then
		skip "log $3 absent ($1)"
		return
	fi
	local hits
	hits=$(grep -aEc "$2" "$1" 2> /dev/null || true)
	if [ "${hits:-0}" -eq 0 ]; then
		ok "log $3 clean"
	else
		no "log $3 has $hits critical entr$([ "$hits" -eq 1 ] && echo y || echo ies)" "$1"
	fi
}

# check_file_empty <file> <label> (fail if file exists and is non-empty)
check_file_empty() {
	if [ -s "$1" ]; then
		no "$2 non-empty" "$1"
	else
		ok "$2 empty/absent"
	fi
}

# check_banner <port> <label>: active and listening is not answering, a hung IMAP login still listens.
check_banner() {
	local banner
	# head -n1, NOT head -c N: a byte-count read blocks until N bytes arrive
	banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1 && head -n1 <&3" 2> /dev/null)
	if [ -n "$banner" ]; then
		ok "port $1 ($2) answers with a banner"
	else
		no "port $1 ($2) gave no banner within 5s (service up but not functional?)"
	fi
}

# Every file the editor offers passes the path gate and opens by key and by path, and the secrets next to them
# are refused with rc 2. Expected keys come from the installed services' pages. Not covered: runtime page keys.
check_config_editor() {
	local key p n=0 bad='' gone='' neg=0 leak='' rc svc want='hestia' page exp
	sys_config_preload
	for svc in $("$BIN/h-list-sys-services" plain 2> /dev/null | cut -f1); do
		case "$svc" in
			php[0-9]*-fpm)
				p=${svc#php}
				want="$want php-${p%-fpm}"
				;;
			*)
				page="$HESTIA/web/edit/server/$svc/index.php"
				[ -f "$page" ] || continue
				want="$want $(grep -o 'server_config("[^"]*")' "$page" | sed 's/^server_config("//; s/")$//' | tr '\n' ' ')"
				;;
		esac
	done
	for key in $(sys_config_keys); do
		p=$(sys_config_path "$key") || continue
		n=$((n + 1))
		[ "$(sys_config_offered "$p")" = "$p" ] || bad="$bad $p"
	done
	set -- $want
	for key in "$@"; do
		sys_config_path "$key" > /dev/null || gone="$gone $key"
	done
	exp=$#
	[ "$exp" -ge 3 ] || gone="$gone (only $exp expected keys: ssh, cron or the service list missing)"
	"$BIN/h-open-fs-config" ssh > /dev/null 2>&1 || bad="$bad ssh"
	"$BIN/h-open-fs-config" /etc/ssh/sshd_config > /dev/null 2>&1 || bad="$bad /etc/ssh/sshd_config"
	set -- "$CONF_DIR"/users/*/user.conf
	for p in /etc/ssh/ssh_host_ed25519_key "$HESTIA/conf/mysql.conf" "$1" /etc/nginx/../ssh/ssh_host_ed25519_key; do
		[ -e "$p" ] || continue
		neg=$((neg + 1))
		"$BIN/h-open-fs-config" "$p" > /dev/null 2>&1
		rc=$?
		[ "$rc" -eq 2 ] || leak="$leak $p:$rc"
	done
	if [ -n "$gone" ]; then
		no "config editor offers no file for" "${gone# }"
	elif [ -n "$bad" ]; then
		no "config editor refuses an offered file" "${bad# }"
	elif [ "$neg" -lt 3 ]; then
		no "config editor refusal not verifiable" "only $neg of the secret files exist"
	elif [ -n "$leak" ]; then
		no "config editor hands out a secret" "${leak# }"
	else
		ok "config editor offers $n files, all $exp the service pages read, by key and path, refuses $neg secrets"
	fi
}

# An account on a language the panel does not offer shows English and keeps the value; a restore or a hand edit
# brings one in. The catalogs themselves are a tree question (check-tree.sh).
check_panel_languages() {
	local odd rc
	odd=$(languages_unlisted)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		no "panel languages" "languages.json is unreadable, so no account was checked"
		return
	fi
	odd="${odd%%$'\n'*}"
	if [ -n "$odd" ]; then
		no "panel languages: an account uses a language the panel does not offer" "$odd"
	else
		ok "panel languages: every account uses a language the panel offers"
	fi
}

# /etc/php/hestia/php-version names what the wrappers and hestia-php run; a gap there kills every request.
check_panel_php_version() {
	local v
	v=$(cat /etc/php/hestia/php-version 2> /dev/null)
	if [ -z "$v" ]; then
		no "panel PHP version file" "/etc/php/hestia/php-version is empty or missing - the hestia-php wrappers fall back blind"
		return
	fi
	if [ ! -x "/usr/bin/php$v" ] || [ ! -x "/usr/sbin/php-fpm$v" ]; then
		no "panel PHP $v binaries (cli+fpm)" "php-version names $v but /usr/bin/php$v or /usr/sbin/php-fpm$v is missing"
		return
	fi
	# A PHP update replaces the binary, and the distro postinst does not know hestia-php.service.
	local pid exe
	pid=$(systemctl show -p MainPID --value hestia-php 2> /dev/null)
	if [ -z "$pid" ] || [ "$pid" = 0 ]; then
		# The service check above already reports a stopped master.
		ok "panel PHP $v (php-version file and binaries present; master not running, see the service check)"
		return
	fi
	exe=$(readlink "/proc/$pid/exe" 2> /dev/null)
	case "$exe" in
		*" (deleted)")
			no "panel FPM master runs a deleted PHP image" "a PHP update replaced the binary - restart hestia-php (sbin/hestia-php-refresh should have)"
			return
			;;
	esac
	# A version switch without the restart leaves the master on the old binary.
	if [ -n "$exe" ] && [ "${exe##*/}" != "php-fpm$v" ]; then
		no "panel FPM master runs ${exe##*/} but php-version says $v" "restart hestia-php to load the recorded version"
		return
	fi
	ok "panel PHP $v (php-version file, binaries present, master image on disk)"
}

# PHP mail runs sendmail_path, so without that binary every notification is lost while the wrapper exits 0.
check_notification_mta() {
	local relay='' path bin
	if [ "${USE_SERVER_SMTP:-}" = 'true' ] && [ -n "${SERVER_SMTP_HOST:-}" ]; then
		relay="${SERVER_SMTP_HOST}"
	fi
	# The path PHP will use, not a guess: an ini override moves it, and then our answer is wrong.
	path=$("$HESTIA/sbin/hestia-php" -r 'echo ini_get("sendmail_path");' 2> /dev/null)
	bin=${path%% *}
	[ -n "$bin" ] || bin=/usr/sbin/sendmail
	if [ -x "$bin" ]; then
		ok "notification MTA present ($bin)"
	elif [ -n "$relay" ]; then
		skip "notification MTA: no local $bin, mail goes through the SMTP relay $relay"
	else
		no "no notification MTA: $bin is missing" \
			"panel and CLI mail is lost and still reports success - install one, or set an SMTP relay"
	fi
}

# nomail's send-only promise, measured on the generated config and the socket table, never the input file.
check_exim_sendonly() {
	local c=/etc/exim4/update-exim4.conf.conf gen=/var/lib/exim4/config.autogenerated
	if [ -n "$MAIL_SYSTEM" ]; then
		return # full mail stack: its own service checks carry it
	fi
	# Skipped visibly: check_notification_mta reports the missing MTA itself.
	if [ ! -f "$c" ]; then
		skip "exim send-only: $c absent, routing not verifiable here"
		return
	fi
	# A hand-edited input without regeneration keeps exim local-only.
	if [ ! -f "$gen" ] || ! grep -q '^dnslookup:' "$gen"; then
		no "exim send-only routing" "generated config carries no dnslookup router - remote delivery is off (regenerate: update-exim4.conf)"
		return
	fi
	# A daemon started before the regeneration runs the queue retries on the old config.
	local started gen_m
	started=$(date -d "$(systemctl show -p ActiveEnterTimestamp --value exim4 2> /dev/null)" +%s 2> /dev/null)
	gen_m=$(stat -c %Y "$gen" 2> /dev/null)
	if [ -n "$started" ] && [ -n "$gen_m" ] && [ "$gen_m" -gt "$started" ]; then
		no "exim daemon predates its generated config" "restart exim4 to load it (queue retries run on the old one)"
		return
	fi
	if ! command -v ss > /dev/null 2>&1; then
		no "exim send-only listeners" "ss not available - the listener half is NOT verifiable, not clean"
		return
	fi
	local l25
	l25=$(ss -lnt 2> /dev/null | grep -E ':25 ')
	if [ -z "$l25" ]; then
		no "exim send-only listeners" "nothing listens on port 25 at all - the local submission path is gone"
		return
	fi
	if printf '%s' "$l25" | grep -vqE '127\.0\.0\.1|\[::1\]'; then
		no "exim send-only listeners" "port 25 listens beyond loopback on a nomail box"
		return
	fi
	ok "exim send-only (dnslookup router generated, loopback listeners live)"
}

# The key against measured enforcement. quotaon -pP is no measure: it prints on without enforcing.
check_project_quota() {
	local state="${PROJECT_QUOTA%%:*}" reason="${PROJECT_QUOTA#*:}"
	case "$state" in
		active)
			if quota_home_fs && quota_enforce_probe "$QUOTA_MNT"; then
				ok "project quota enforcing on ${QUOTA_MNT:-/home} (probe with positive control)"
			else
				no "project quota" "key says active but the probe failed: ${QUOTA_PROBE_REASON:-mount unresolved} - enforcement drifted (fstab/GRUB edit, migration?)"
			fi
			;;
		pending)
			# The expected state before the install reboot; a FAIL there trains people to ignore fails.
			if [ "$reason" = 'reboot' ]; then
				skip "project quota: armed, waiting for the install reboot (pending is not verified)"
			else
				no "project quota stuck pending" "arming failed: ${reason} - see /run/hestia-quota-arm.status; h-update-sys-quota re-arms once the cause is fixed"
			fi
			;;
		*)
			skip "project quota: not enforced on this box (${PROJECT_QUOTA:-key unset}; h-update-sys-quota re-arms once the cause is fixed)"
			;;
	esac
}

# Panel port: the site it listens on against the value the firewall and proxies follow.
check_panel_port() {
	local want="${BACKEND_PORT:-8083}" live owner
	local n
	n=$(reserved_ports | awk '{print $1}' | sort -u | wc -l)
	if [ "${n:-0}" -eq 0 ]; then
		no "reserved-port scan found no listener declaration under $HESTIA" \
			"the derivation broke - every port would now pass validation unchecked"
		return
	fi
	# The count, without a verdict: an exclusion that eats too much shrinks the set silently.
	ok "reserved port set: $n ports derived from the shipped configs"
	if owner=$(reserved_port_owner "$want"); then
		no "panel port $want is reserved for $owner" "two services want the same port; h-change-sys-port <free port>"
	fi
	live=$(sed -n 's|^[[:space:]]*https\?://:\([0-9]\{2,5\}\).*|\1|p' /etc/caddy/hestia.conf 2> /dev/null | head -n1)
	if [ -z "$live" ]; then
		no "panel site declares no port (/etc/caddy/hestia.conf)" "the panel listener is unreadable - check the site file"
	elif [ "$live" != "$want" ]; then
		no "panel listens on $live, BACKEND_PORT says $want" \
			"firewall rule and phpMyAdmin proxy follow $want - re-run: h-change-sys-port $want"
	else
		ok "panel port $want consistent (caddy site, BACKEND_PORT)"
	fi
}

# The enforced cpu.max from the cgroup, never the systemd property, which reads the drop-in as soon as it is
# written. Not covered: whether the cap is the right size.
check_customer_php_slice() {
	local versions uncapped='' seen=0 ver cores cpu_max quota period pct conf
	versions=$(customer_php_versions)
	if [ -z "$versions" ]; then
		skip "customer PHP cap: no customer php-fpm on this box"
		return
	fi

	for ver in $versions; do
		[ "$(systemctl is-active "php$ver-fpm" 2> /dev/null)" = 'active' ] || continue
		seen=$((seen + 1))
		customer_php_in_slice "$ver" || uncapped="$uncapped php$ver-fpm"
	done
	# Counted: with no master running nothing was looked at, and that FPM is down is check_service's to say.
	if [ "$seen" -eq 0 ]; then
		skip "customer PHP cap: no customer php-fpm master is running (nothing to place, nothing to cap)"
		return
	fi
	if [ -z "$uncapped" ]; then
		ok "customer php-fpm masters run in $CUSTOMER_PHP_SLICE ($seen checked)"
	else
		no "customer php-fpm outside the cap:$uncapped" "customer load can starve panel, mail and ssh; systemctl restart $CUSTOMER_PHP_LIMIT_UNIT"
	fi

	cpu_max=$(customer_php_cpu_max)
	cores=$(nproc --all 2> /dev/null)
	# The boot script's reader: a value it refuses must not be reported as the configured one.
	if customer_php_percent; then
		conf="${CUSTOMER_PHP_PERCENT}%"
	else
		conf="${CUSTOMER_PHP_PERCENT}% - the file says '$CUSTOMER_PHP_PERCENT_RAW', which is refused"
	fi
	quota=${cpu_max%% *}
	period=${cpu_max##* }
	if [ -z "$cpu_max" ]; then
		# Without a quota systemd drops the cpu controller, so cpu.max is absent rather than max.
		no "customer PHP slice carries no CPU limit (cpu.max absent)" \
			"nothing is capped - systemctl restart $CUSTOMER_PHP_LIMIT_UNIT, then read its status"
	elif [ "$quota" = 'max' ]; then
		no "customer PHP cap not applied (cpu.max: $cpu_max)" \
			"nothing is capped - systemctl restart $CUSTOMER_PHP_LIMIT_UNIT, then read its status"
	else
		pct=$((quota * 100 / period / ${cores:-1}))
		ok "customer PHP cap enforced: cpu.max $cpu_max = ${pct}% of ${cores:-?} cores (configured $conf)"
	fi
}

# A de session through web/inc/i18n.php, the include chain the panel and mail-wrapper take. glibc 2.39+ ignores
# LANGUAGE under C.UTF-8, so without a generated en_US.UTF-8 every language shows English. Not covered: a panel
# FPM started before the locale existed, which this fresh process cannot see.
check_panel_translates() {
	local php out
	if ! "$HESTIA/sbin/hestia-php" -r "require '$HESTIA/web/inc/i18n.php';" > /dev/null 2>&1; then
		no "panel CLI cannot load web/inc/i18n.php" "notification mail dies at bindtextdomain - re-run hestia-php-confd (cli set)"
		return
	fi
	php='$_SESSION["language"] = "de"; require "'"$HESTIA"'/web/inc/i18n.php"; echo _("Password");'
	out=$("$HESTIA/sbin/hestia-php" -r "$php" 2> /dev/null)
	if [ -n "$out" ] && [ "$out" != "Password" ]; then
		ok "panel translates: the i18n chain loads, a de session reads '$out' for 'Password'"
	elif ! locale_present en_US.UTF-8; then
		no "panel translates" "en_US.UTF-8 is not generated: enable it in /etc/locale.gen and run locale-gen"
	else
		no "panel translates" "a de session reads '${out:-nothing}' for 'Password'"
	fi
}

# A policy fragment (CrowdSec, bot limit) must be in every domain template of its web system, or switching
# templates escapes it. Feature fragments are not checked. Scope: templates carrying %domain%.
check_policy_fragment_coverage() {
	local f frag miss=0 first="" checked=0
	# By file under both roots, not by service directory, so a template outside the usual subdirs is not skipped.
	while read -r f; do
		[ -n "$f" ] || continue
		# Decided by content, not path: a rename would otherwise shrink the guard silently.
		if grep -q '^[[:space:]]*<VirtualHost' "$f"; then
			set -- botlimit.apache2.conf
		elif grep -qE '^[[:space:]]*server[[:space:]]*\{' "$f"; then
			set -- nginx.crowdsec.conf nginx.botlimit.conf
		else
			continue
		fi
		checked=$((checked + 1))
		for frag in "$@"; do
			grep -q "$frag" "$f" && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="${f#"$HESTIA/"} lacks $frag"
		done
	done < <(grep -rl '%domain%' "$WEBTPL" "$SHARETPL" 2> /dev/null | grep -E '\.(tpl|stpl)$')
	if [ "$miss" -eq 0 ]; then
		ok "policy fragment includes complete ($checked domain templates)"
	else
		no "$miss policy fragment include(s) missing from web templates" "$first"
	fi
}

# The grant every privileged panel action and cron job goes through. One setting the running sudo rejects
# (requiretty under sudo-rs) drops the whole file, and an update no longer re-applies it, so drift stays.
check_sudoers() {
	local live=/etc/sudoers.d/hestia tree="$HESTIA/share/hestia/sudoers" bad='' m tmp
	local rtree="$HESTIA/share/hestia/rsyslog-sudo-nolog.conf" rlive=/etc/rsyslog.d/10-hestia-sudo-nolog.conf
	local fix="source $HESTIA/include/helper.sh && deploy_hestia_sudoers"
	if [ ! -f "$live" ]; then
		no "sudoers grant $live missing" "$fix"
		return
	fi
	m=$(stat -c '%a %U:%G' "$live")
	[ "$m" = "440 root:root" ] || bad="$bad; mode $m"
	visudo -cf "$live" > /dev/null 2>&1 || bad="$bad; invalid: $(visudo -cf "$live" 2>&1 | tail -1)"
	# visudo may prepend this one line on deploy, so the rest is compared.
	tmp=$(mktemp) || return
	if [ "$(head -1 "$live")" = 'Defaults:hestia !log_allowed' ]; then
		tail -n +2 "$live" > "$tmp"
	else
		cat "$live" > "$tmp"
	fi
	cmp -s "$tree" "$tmp" || bad="$bad; differs from the tree"
	rm -f "$tmp"
	if [ -f "$rtree" ] && [ -d /etc/rsyslog.d ] && ! cmp -s "$rtree" "$rlive"; then
		bad="$bad; sudo log drop rule differs from the tree"
	fi
	if [ -n "$bad" ]; then
		no "sudoers grant" "${bad#; } - $fix"
	else
		ok "sudoers grant 440 root:root, valid, matches the tree, log drop rule in place"
	fi
}

# Panel logins of yescrypt accounts run through mkpasswd; without it, or a libcrypt without yescrypt, nobody
# logs in. Asked by doing what the login does. Not covered: md5/sha-512 accounts (perl crypt).
check_yescrypt_hashing() {
	local ref again setting probe='hestia-smoke-probe'
	if ! command -v mkpasswd > /dev/null 2>&1; then
		no "mkpasswd is missing - no yescrypt account can log in" "the whois package provides it"
		return
	fi
	ref=$(mkpasswd -m yescrypt "$probe" 2> /dev/null)
	case "$ref" in
		'$y$'*) ;;
		*)
			no "mkpasswd cannot produce a yescrypt hash" "it returned '${ref:-nothing}' - check libcrypt"
			return
			;;
	esac
	setting="${ref%\$*}\$"
	again=$(mkpasswd "$probe" "$setting" 2> /dev/null)
	if [ "$again" != "$ref" ]; then
		no "yescrypt hashing does not reproduce from its own setting" "every panel login would be refused"
	else
		ok "yescrypt hashing works and reproduces from its setting"
	fi
}
# Nothing under the install root belongs to anyone but root or is group/world writable. Pool runtime dirs come
# from the FPM config, symlinks are skipped, and a scan that saw almost nothing fails.
check_install_root_owner() {
	local allowed p hits n bad
	allowed=$(grep -hoE '^ *(php_(admin_)?value\[)?(session\.save_path|upload_tmp_dir|sys_temp_dir)\]? *= *"?[^" ]+' \
		/etc/php/hestia/fpm/php.ini /etc/php/hestia/fpm/pool.d/*.conf 2> /dev/null | sed 's/.*= *"\?//' | sort -u)
	n=$(find "$HESTIA" -xdev ! -type l 2> /dev/null | wc -l)
	if [ "${n:-0}" -lt 100 ]; then
		no "install root: the scan saw only $n entries under $HESTIA"
		return
	fi
	hits=$(find "$HESTIA" -xdev ! -type l \( ! -user root -o -perm /022 \) -printf '%p\n' 2> /dev/null)
	for p in $allowed; do
		case "$p" in "$HESTIA"/*) hits=$(printf '%s\n' "$hits" | grep -vE "^$p(/|$)") ;; esac
	done
	bad=$(printf '%s\n' "$hits" | grep -c .)
	if [ "$bad" -gt 0 ]; then
		no "install root: $bad path(s) not root-owned or group/world-writable" "$(printf '%s\n' "$hits" | grep . | head -n3 | tr '\n' ' ')"
	else
		ok "install root: $n entries, nothing writable by anyone but root (pool runtime dirs from the FPM config:$(printf ' %s' $allowed))"
	fi
}

# The files whose mode means something. hestia.conf stays root's behind a 700 /etc/hestia, so the panel pool and
# every customer stop at the directory (keep in step with the seed in include/wizard.sh and include/helper.sh).
# Every private key and relay password file, found rather than listed, carries no world bit; group access is by
# design (root:mail 660, exim reads them).
check_secret_file_modes() {
	local bad='' keys k m n
	m=$(stat -c '%a %U:%G' "$CONF_DIR" 2> /dev/null)
	[ "$m" = "700 root:root" ] || bad="$bad $CONF_DIR(${m:-missing})"
	m=$(stat -c '%a %U:%G' "$CONF_DIR/conf/hestia.conf" 2> /dev/null)
	[ "$m" = "600 root:root" ] || bad="$bad hestia.conf(${m:-missing})"
	keys=$({
		find /etc/ssl/hestia /etc/exim4/ssl /etc/hestia/users/*/ssl /home/*/conf/web/*/ssl /home/*/conf/mail/*/ssl \
			-maxdepth 1 \( -name '*.key' -o -name '*.pem' \) 2> /dev/null
		find /etc/exim4/smtp_relay.conf /home/*/conf/mail/*/smtp_relay.conf -maxdepth 0 2> /dev/null
	} | sort -u)
	n=$(printf '%s\n' "$keys" | grep -c .)
	for k in $keys; do
		[ -e "$k" ] || {
			bad="$bad $k(dangling)"
			continue
		}
		m=$(stat -L -c '%a' "$k")
		case "$m" in *[1-7]) bad="$bad $k(world:$m)" ;; esac
	done
	if [ -n "$bad" ]; then
		no "secret file modes" "$bad"
	else
		ok "secret file modes: hestia.conf 600 behind a 700 $CONF_DIR, $n key/pem/relay file(s) without a world bit"
	fi
}

# Every key of h-list-sys-config json lands in $_SESSION, so the session files are asked for secret values, not
# the registry. Also holds the store path, its php.ini and the daily cleanup together. Not covered: /home/*/tmp.
check_panel_session_store() {
	local ini='/etc/php/hestia/fpm/php.ini' cron='/etc/cron.daily/php-session-cleanup'
	local path secrets f k v n=0 seen=0 bad='' named=0
	path=$(sed -n 's/^session\.save_path[[:space:]]*=[[:space:]]*//p' "$ini" 2> /dev/null | head -1)
	if [ -z "$path" ] || [ ! -d "$path" ]; then
		no "panel session store: no usable session.save_path" "$ini names '${path:-nothing}'"
		return
	fi
	grep -qF -- "$path/" "$cron" 2> /dev/null || bad="$bad cleanup-sweeps-elsewhere"
	secrets=$(sysreg_secret_keys 2> /dev/null) || secrets=''
	if [ -z "$secrets" ]; then
		no "panel session store: the registry marks no key secret" "there is nothing to look for, so a clean result would prove nothing"
		return
	fi
	for f in "$path"/sess_*; do
		[ -f "$f" ] || continue
		n=$((n + 1))
		for k in $secrets; do
			# Control: without the key name the file is no panel session, and a clean result would prove nothing.
			grep -qF -- "$k" "$f" 2> /dev/null && named=1
			v=$(sed -n "s/^$k='\(.*\)'\$/\1/p" "$HESTIA/conf/hestia.conf" 2> /dev/null | head -1)
			[ -n "$v" ] || continue
			seen=$((seen + 1))
			grep -qF -- "$v" "$f" 2> /dev/null && bad="$bad ${f##*/}:$k"
		done
	done
	if [ "$n" -eq 0 ]; then
		skip "panel session store: $path is swept by the daily cleanup, and holds no session to inspect (0 files)"
	elif [ "$named" -eq 0 ]; then
		no "panel session store: no secret key name in $n session file(s)" \
			"the files are not panel sessions or cannot be read - a clean result would prove nothing"
	elif [ -n "$bad" ]; then
		no "panel session store:$bad" "a secret's value from hestia.conf appears verbatim in a session file"
	elif [ "$seen" -eq 0 ]; then
		ok "panel session store: $n session file(s), cleanup sweeps $path, and no secret carries a value to leak"
	else
		ok "panel session store: $n session file(s), cleanup sweeps $path, no secret value among them"
	fi
}

# restic mode without restic or a repository means no backup at all, said only in the nightly log.
check_restic_mode_supported() {
	local u m repo n=0 bad=0 first=""
	# The gate's own resolution, called directly: the gate would exit through check_result.
	repo=$(restic_repo_base) || repo=""
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		m=$(sed -n "s/^.*BACKUPS_MODE='\([^']*\)'.*/\1/p" "$CONF_DIR/users/$u/user.conf" 2> /dev/null | head -1)
		[ "$m" = 'restic' ] || continue
		n=$((n + 1))
		if ! restic version > /dev/null 2>&1; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but restic is not installed"
		elif [ -z "$repo" ]; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but no repository is configured"
		fi
	done
	if [ "$bad" -eq 0 ]; then
		ok "restic mode is supported where it is set ($n customer(s))"
	else
		no "$bad customer(s) in restic mode without support" "$first"
	fi
}
# h-add-web-php only warns when a new version misses the loader. Covers loading, not the loader's behaviour.
check_ioncube_versions() {
	local v list checked=0 noload='' bad=''
	[ -n "${IONCUBE_SYSTEM:-}" ] || {
		skip "ionCube loader (addon not installed)"
		return
	}
	# shellcheck source=/usr/local/hestia/include/ioncube.sh
	source "$HESTIA/include/ioncube.sh"
	list=$("$BIN/h-list-sys-php" plain 2> /dev/null)
	if [ -z "$list" ]; then
		no "ionCube: h-list-sys-php named no PHP version" "nothing was checked"
		return
	fi
	for v in $list; do
		if [ ! -f "$IONCUBE_DIR/ioncube_loader_lin_$v.so" ]; then
			noload="$noload $v"
			continue
		fi
		checked=$((checked + 1))
		"/usr/sbin/php-fpm$v" -v 2> /dev/null | grep -q 'ionCube' || bad="$bad $v"
	done
	if [ -n "$bad" ]; then
		no "ionCube is not loaded in PHP$bad" "h-add-sys-ioncube"
	else
		ok "ionCube loaded in $checked PHP version(s)${noload:+, no loader exists for$noload}"
	fi
}
# A doubled path makes logrotate exit 1 and the unit stay failed. Only collisions with our files are red.
check_logrotate_parses() {
	local out owned line path f pat mine ours=0 base=0 first="" basefiles="" mycount=0
	if ! command -v logrotate > /dev/null 2>&1; then
		skip "logrotate not installed"
		return
	fi
	out=$(logrotate -d /etc/logrotate.conf 2>&1)
	# ours = whatever no package claims, so a file added by hand counts as ours too
	owned=$(dpkg -S /etc/logrotate.d/* 2> /dev/null | sed 's/^[^:]*: //')
	for f in /etc/logrotate.d/*; do
		[ -f "$f" ] || continue
		grep -qxF "$f" <<< "$owned" || mycount=$((mycount + 1))
	done
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		path=${line##*duplicate log entry for }
		[ "$path" != "$line" ] || continue
		mine=0
		for f in /etc/logrotate.d/*; do
			[ -f "$f" ] || continue
			grep -qxF "$f" <<< "$owned" && continue
			while read -r pat; do
				# shellcheck disable=SC2254 # the config line IS a glob, matching it is the point
				case "$path" in $pat) mine=1 ;; esac
			done < <(grep -oE '^/[^ {]+' "$f")
		done
		if [ "$mine" = 1 ]; then
			ours=$((ours + 1))
			[ -z "$first" ] && first="${line#error: }"
		else
			base=$((base + 1))
			f=${line#error: }
			f=${f%%:*}
			grep -qw "$f" <<< "$basefiles" || basefiles="${basefiles:+$basefiles, }$f"
		fi
	done <<< "$(grep '^error:' <<< "$out")"
	if [ "$ours" -gt 0 ]; then
		no "$ours logrotate collision(s) involving a file of ours" "$first"
	elif [ "$base" -gt 0 ]; then
		ok "logrotate: our $mycount file(s) collide with nothing - $base base-system conflict(s), not ours: $basefiles"
	else
		ok "logrotate parses its configuration (ours: $mycount file(s))"
	fi
}
# A vhost or fragment the server cannot load stays harmless until the next reload, which then fails box-wide.
check_web_config_test() {
	local sys out rc n=0
	for sys in $(printf '%s\n' "$WEB_SYSTEM" "$PROXY_SYSTEM" "${WEBMAIL_FRONT:-}" | grep . | sort -u); do
		case "$sys" in
			nginx) out=$(nginx -t 2>&1) rc=$? ;;
			apache2) out=$(apache2ctl -t 2>&1) rc=$? ;;
			*) continue ;;
		esac
		n=$((n + 1))
		if [ "$rc" -eq 0 ]; then
			ok "$sys accepts its configuration ($sys config test)"
		else
			no "$sys rejects its configuration, the next reload fails" "$(grep -m1 -iE 'emerg|error' <<< "$out")"
		fi
	done
	[ "$n" -gt 0 ] || skip "web config test (no nginx or apache2 configured on this box)"
}

# Every web record against what it renders from and to. A vhost that was skipped looks clean by being absent,
# and a template that no longer exists only shows on the next rebuild. A docker domain in a proxy model has its
# backend vhost removed on purpose. Not covered: the SSL variant, and whether the vhost inside is the right one.
check_web_records() {
	local u line d docker proxy tpl backend sys fronts n=0 miss=0 first=""
	if [ -z "$WEB_SYSTEM" ]; then
		skip "no web system - web records not checked"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			n=$((n + 1))
			docker=$(sed -n "s/.* DOCKER='\([^']*\)'.*/\1/p" <<< "$line")
			proxy=$(sed -n "s/.* PROXY='\([^']*\)'.*/\1/p" <<< "$line")
			tpl=$(sed -n "s/.*[^_]TPL='\([^']*\)'.*/\1/p" <<< "$line")
			backend=$(sed -n "s/.* BACKEND='\([^']*\)'.*/\1/p" <<< "$line")
			if [ -n "$docker" ] && [ -n "$PROXY_SYSTEM" ] && [ "$WEB_SYSTEM" != "$PROXY_SYSTEM" ]; then
				fronts="$PROXY_SYSTEM"
			else
				fronts="$WEB_SYSTEM"
				[ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] && fronts="$fronts $PROXY_SYSTEM"
			fi
			for sys in $fronts; do
				[ -f "/etc/$sys/conf.d/domains/$d.conf" ] && continue
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d has no $sys vhost"
			done
			if [ -n "$tpl" ] && [ ! -f "$(web_template_file "$WEB_SYSTEM" "$tpl" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d TPL='$tpl' is missing"
			fi
			if [ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] \
				&& [ ! -f "$(web_template_file "$PROXY_SYSTEM" "$proxy" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d PROXY='$proxy' is missing"
			fi
			if [ -n "$WEB_BACKEND" ] && [ -n "$backend" ] && [ ! -f "$PHPTPL/$backend.tpl" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d BACKEND='$backend' is missing"
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "every web record has its vhost and its templates ($n domain(s))"
	else
		no "$miss web record problem(s): missing vhost or template" "$first"
	fi
}

# exim knows a domain only through its link in /etc/exim4/domains: without it mail bounces and IMAP logins fail
# while the record looks fine, and a stale entry keeps accepting mail for a domain that is gone or suspended.
check_mail_domain_links() {
	local u line d idn l n=0 miss=0 first="" stray=0 sfirst="" dir="/etc/$MAIL_SYSTEM/domains"
	local -A want=()
	if [[ ! "$MAIL_SYSTEM" =~ exim ]]; then
		skip "no mail system - mail domain links not checked"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/mail.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			[[ "$line" == *"SUSPENDED='yes'"* ]] && continue
			n=$((n + 1))
			idn="$d"
			[[ "$d" =~ [^a-z0-9.-] ]] && idn=$(idn2 --quiet "$d")
			if [ -z "$idn" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d cannot be converted to punycode"
				continue
			fi
			want["$idn"]=1
			l="$dir/$idn"
			[ -L "$l" ] && [ "$(readlink "$l")" = "$HOMEDIR/$u/conf/mail/$d" ] && [ -d "$l" ] && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="$u/$d has no valid link"
		done < "$CONF_DIR/users/$u/mail.conf"
	done
	for l in "$dir"/*; do
		[ -e "$l" ] || [ -L "$l" ] || continue
		[ -n "${want[${l##*/}]:-}" ] && continue
		stray=$((stray + 1))
		[ -z "$sfirst" ] && sfirst="${l##*/} has no active mail record"
	done
	if [ "$n" -eq 0 ] && [ "$stray" -eq 0 ]; then
		skip "no active mail domain - links not checked"
	elif [ "$miss" -eq 0 ] && [ "$stray" -eq 0 ]; then
		ok "every active mail domain has its exim link, none stray ($n checked)"
	else
		no "$miss mail domain(s) without a link, $stray stray entr(ies) in $dir" "${first:-$sfirst}"
	fi
}
# Every record line against record_line_valid: a line that loses its quotes stays readable, but every writer
# looks for KEY='...' and silently changes nothing.
check_record_grammar() {
	local f n=0 bad=0 first="" line
	if ! declare -F record_line_valid > /dev/null 2>&1; then
		no "record grammar not checkable" "record_line_valid missing - include/main.sh not sourced"
		return
	fi
	for f in "$CONF_DIR/users"/*/user.conf "$CONF_DIR/users"/*/*.conf "$CONF_DIR/users"/*/mail/*.conf \
		"$CONF_DIR/ips"/* "$CONF_DIR/packages"/*.pkg "$HESTIA/conf/hestia.conf"; do
		[ -f "$f" ] || continue
		# The restic password file is a bare key, not a record, and must never be echoed.
		[ "${f##*/}" = restic.conf ] && continue
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			n=$((n + 1))
			record_line_valid "$line" && continue
			bad=$((bad + 1))
			[ -z "$first" ] && first="$f: ${line:0:60}"
		done < "$f"
	done
	# Nothing to look at is a finding: every box has records.
	if [ "$n" -eq 0 ]; then
		no "record grammar: no record lines found" "$CONF_DIR looks empty - the check saw nothing"
	elif [ "$bad" -eq 0 ]; then
		ok "record grammar holds on $n record lines"
	else
		no "$bad record line(s) are not KEY='value'" "$first - readable but unwritable: every writer looks for KEY='...'"
	fi
}

# The ip counters against the read-only check mode of their authority, the only rule source.
check_ip_object_counters() {
	local f addr line k want stored drift=0 checked=0 first='' obj_out obj_lines
	for f in "$CONF_DIR"/ips/*; do
		[ -f "$f" ] || continue
		addr=${f##*/}
		# only the two counter lines count as an answer (check_result errors land on stdout)
		obj_out=$("$BIN/h-update-sys-ip-counters" "$addr" check 2> /dev/null | grep -E "^U_(WEB_DOMAINS|SYS_USERS)='")
		obj_lines=$(grep -c . <<< "$obj_out")
		# empty is no pass PER OBJECT: a broken object must not ride on the others' green
		if [ "$obj_lines" -eq 0 ]; then
			drift=$((drift + 1))
			[ -z "$first" ] && first="$addr: authority answered nothing (broken object or stray file)"
			continue
		fi
		while IFS= read -r line; do
			k="${line%%=*}"
			want=$(sed "s/^$k='\(.*\)'$/\1/" <<< "$line")
			stored=$(sed -n "s/^$k='\(.*\)'$/\1/p" "$f" | head -1)
			checked=$((checked + 1))
			[ "$stored" = "$want" ] && continue
			drift=$((drift + 1))
			[ -z "$first" ] && first="$addr $k stored='$stored' counted='$want'"
		done <<< "$obj_out"
	done
	if [ "$checked" -eq 0 ] && [ "$drift" -eq 0 ]; then
		no "no IP object counters compared" "every box registers at least one IP - the authority or the file set broke"
	elif [ "$drift" -gt 0 ]; then
		no "$drift IP object counter(s) drifted" "$first - repair: h-update-sys-ip-counters"
	else
		ok "IP object counters match their recount ($checked compared)"
	fi
}

# The stored counters against what h-update-user-counters check would write, so the rules live in one place.
# Also a counter-shaped registry key that nothing computes.
check_object_counters() {
	local u line k stored want drift=0 checked=0 first="" computed missing="" reg
	computed=$("$BIN/h-update-user-counters" "$ROOT_USER" check 2> /dev/null | cut -d= -f1)
	if [ -z "$computed" ]; then
		no "counter authority answered nothing" "h-update-user-counters <user> check is the guard's oracle"
		return
	fi
	for reg in $(syshealth_known_keys user | tr ' ' '\n' | grep -E '^(U_|IP_|SUSPENDED_)'); do
		grep -qx "$reg" <<< "$computed" || missing="$missing $reg"
	done

	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		while IFS= read -r line; do
			k="${line%%=*}"
			want=$(sed "s/^$k='\\(.*\\)'$/\\1/" <<< "$line")
			stored=$(sed -n "s/^$k='\\(.*\\)'$/\\1/p" "$CONF_DIR/users/$u/user.conf" | head -1)
			[ -n "$stored" ] || continue
			checked=$((checked + 1))
			[ "$stored" = "$want" ] && continue
			drift=$((drift + 1))
			[ -z "$first" ] && first="$u $k stored=$stored counted=$want"
		done < <("$BIN/h-update-user-counters" "$u" check 2> /dev/null)
	done

	# Nothing compared is a finding: every box has at least the admin record.
	if [ "$checked" -eq 0 ]; then
		no "no counters compared" "the authority returned nothing for any user"
	elif [ "$drift" -gt 0 ]; then
		no "$drift counter(s) drifted from their objects" "$first - repair: h-update-user-counters <user>"
	else
		ok "object counters match what the recount would write ($checked compared)"
	fi
	[ -z "$missing" ] \
		|| no "registry counter(s) nothing computes:$missing" "outside both the recount and this guard - remove them or compute them"
}

# Every operator key the registry declares must be in hestia.conf: only h-repair-sys-config writes its default,
# and no cron runs that. An empty key set fails.
check_operator_keys_present() {
	local reg="$HESTIA/share/hestia/sys-keys.json" conf="$HESTIA/conf/hestia.conf" k n=0 miss=''
	if [ ! -f "$reg" ] || [ ! -f "$conf" ]; then
		no "operator keys not checkable" "missing $([ -f "$reg" ] || echo "$reg") $([ -f "$conf" ] || echo "$conf")"
		return
	fi
	while read -r k; do
		[ -n "$k" ] || continue
		n=$((n + 1))
		grep -q "^$k=" "$conf" || miss="$miss $k"
	done < <(jq -r '.keys | to_entries[] | select(.value.class == "betreiber") | .key' "$reg" 2> /dev/null)
	if [ "$n" -eq 0 ]; then
		no "operator keys: the registry named none" "nothing was compared, so this check proves nothing"
	elif [ -n "$miss" ]; then
		no "operator keys missing from hestia.conf:$miss" \
			"$n declared - h-repair-sys-config repair writes the registry default back"
	else
		ok "operator keys: all $n declared keys present in hestia.conf"
	fi
}

# A release is unpacked before its plan runs, and the status version is written only when the plan is
# done, so a difference is the wanted signal for an unfinished run and not cosmetic drift.
check_update_version() {
	local tree
	tree=$(cat "$HESTIA/VERSION" 2> /dev/null)
	if [ -z "$tree" ]; then
		no "the install tree carries no VERSION" "every version comparison in the updater reads this file"
		return
	fi
	if [ "$tree" = "$VERSION" ]; then
		ok "update state: tree and status agree on $tree"
	else
		no "update did not finish: tree is $tree, status says ${VERSION:-<empty>}" \
			"work the plan off, then the status follows: h-update-hestia <run directory>/update.conf"
	fi
	# A bound above the tree would leave this release unable to carry itself onward; unreadable is red.
	local bound
	# The value after the `=`, quotes stripped; a commented-out line matches nothing and is red.
	bound=$(sed -n 's/^UPDATE_MIN_VERSION=//p' "$HESTIA/update.sh" 2> /dev/null | head -1 | tr -d "\"'")
	if [ -z "$bound" ]; then
		no "update: no lower bound found in update.sh" "UPDATE_MIN_VERSION is what refuses a box below it"
	elif version_ge "$tree" "$bound"; then
		ok "update: lower bound $bound, at or below this tree"
	else
		no "update: the tree $tree is below its own lower bound $bound" "this release could not update itself onward"
	fi
	# Finished also means nothing pending; reading no manifest entry at all is red.
	if [ "$tree" != "$VERSION" ]; then
		skip "update: pending entries not checked while the run above is unfinished"
		return
	fi
	local total plan count
	total=$( (source "$HESTIA/include/update.sh" && upd_manifest_check) 2> /dev/null)
	plan=$("$BIN/h-list-sys-updates" json "$tree" 2> /dev/null)
	count=$(jq -r '.count // empty' <<< "$plan" 2> /dev/null)
	if ! [[ "$total" =~ ^[0-9]+$ ]] || [ "$total" -eq 0 ]; then
		no "update: the manifests in this tree yield no entry" "the pending check would look at nothing"
	elif ! [[ "$count" =~ ^[0-9]+$ ]]; then
		no "update: no plan could be derived against $tree" "h-list-sys-updates shell $tree says why"
	elif [ "$count" -eq 0 ]; then
		ok "update: nothing pending against $tree ($total manifest entries read)"
	else
		no "update: $count entry(s) pending against $tree: $(jq -r '.entries | map(.identity) | join(", ")' <<< "$plan")" \
			"hestia update works them off; one still listed after a run cannot negate itself here, its update.log says why"
	fi
}

# The crontab calls its jobs through sudo; sudo is asked whether the grant reaches each command path. Not
# covered: the arguments.
check_crontab_sudo_reach() {
	local ct='/var/spool/cron/crontabs/hestia' line cmd n=0 bad=''
	if [ ! -s "$ct" ]; then
		no "crontab sudo reach: $ct is missing or empty" "nothing to compare, which is not a pass"
		return
	fi
	# Controls both ways, a granted path allowed and an unrelated one refused, or a silent sudo clears every line.
	if ! sudo -l -U hestia "$HESTIA/bin/h-list-sys-services" > /dev/null 2>&1 \
		|| sudo -l -U hestia /bin/sh > /dev/null 2>&1; then
		skip "crontab sudo reach: sudo -l -U does not decide on this box, so the lines are unchecked"
		return
	fi
	while read -r line; do
		[ -n "$line" ] || continue
		# shellcheck disable=SC2086  # the crontab line is a command line; the first word is the command
		set -- $line
		cmd=$1
		n=$((n + 1))
		sudo -l -U hestia "$cmd" > /dev/null 2>&1 || bad="$bad $cmd"
	done < <(sed -n 's/^[^#]*[[:space:]]sudo[[:space:]]\{1,\}\(.*\)$/\1/p' "$ct")
	if [ "$n" -eq 0 ]; then
		no "crontab sudo reach: no sudo line in $ct" "the crontab calls its jobs through sudo, so this read nothing"
	elif [ -n "$bad" ]; then
		no "crontab sudo reach: $(echo "$bad" | wc -w) command(s) the grant does not cover:$bad" \
			"sudo refuses them nightly; move the command into $HESTIA/bin rather than widening the grant"
	else
		ok "crontab sudo reach: all $n sudo command(s) in the crontab are covered by the grant"
	fi
}

# The system keys the repair never fills: ROOT_USER names an admin record, every DB_SYSTEM token has its host
# file, every BACKUP_SYSTEM token but local its backup host file.
check_system_keys_agree() {
	local bad='' t
	if [ -z "$ROOT_USER" ]; then
		bad="$bad ROOT_USER(empty)"
	elif [ ! -f "$CONF_DIR/users/$ROOT_USER/user.conf" ] || ! grep -q "^ROLE='admin'" "$CONF_DIR/users/$ROOT_USER/user.conf"; then
		bad="$bad ROOT_USER($ROOT_USER:no-admin-record)"
	fi
	local -a _t_list
	IFS=, read -ra _t_list <<< "$DB_SYSTEM"
	for t in "${_t_list[@]}"; do
		[ -n "$t" ] || continue
		[ -f "$HESTIA/conf/$t.conf" ] || bad="$bad DB_SYSTEM($t:no-host-file)"
	done
	local -a _t_list
	IFS=, read -ra _t_list <<< "$BACKUP_SYSTEM"
	for t in "${_t_list[@]}"; do
		[ -n "$t" ] || continue
		[ "$t" = local ] && continue
		[ -f "$HESTIA/conf/$t.backup.conf" ] || bad="$bad BACKUP_SYSTEM($t:no-host-file)"
	done
	if [ -n "$bad" ]; then
		no "system keys disagree with the box" "$bad"
	else
		ok "system keys agree with the box (ROOT_USER=$ROOT_USER, DB_SYSTEM='${DB_SYSTEM}', BACKUP_SYSTEM='${BACKUP_SYSTEM}')"
	fi
}

# _artefact_present TYPE VALUE: 0 present, 1 absent, 2 unknown type. Present, not running.
_artefact_present() {
	case "$1" in
		service) [ -n "$(systemctl list-unit-files --no-legend "$2.service" 2> /dev/null)" ] ;;
		socket) [ -S "$2" ] ;;
		file) [ -e "$2" ] ;;
		command) command -v "$2" > /dev/null 2>&1 ;;
		*) return 2 ;;
	esac
}

# Every component with a status_artefact: key set if and only if the artefact is present. An unknown type and
# zero components are red. Names keys, never values.
check_manifest_artefacts() {
	local m="$HESTIA/share/manifest.json" n=0 bad='' cid key type val v rc
	while IFS=$'\t' read -r cid key type val; do
		[ -n "$cid" ] || continue
		n=$((n + 1))
		v=$(grep -m1 "^$key=" "$HESTIA/conf/hestia.conf" 2> /dev/null | cut -d"'" -f2)
		_artefact_present "$type" "$val"
		rc=$?
		if [ "$rc" -eq 2 ]; then
			bad="$bad $cid(unknown artefact type $type)"
		elif [ -n "$v" ] && [ "$rc" -ne 0 ]; then
			bad="$bad $cid($key set, $type $val absent)"
		elif [ -z "$v" ] && [ "$rc" -eq 0 ]; then
			bad="$bad $cid($key empty, $type $val present)"
		fi
	done < <(jq -r '.components | to_entries[] | select(.value.status_artefact) | .value.status_artefact as $a | ($a | keys[0]) as $t | [.key, (.value.status_key // ""), $t, ($a[$t] | tostring)] | @tsv' "$m" 2> /dev/null)
	if [ "$n" -eq 0 ]; then
		no "manifest artefacts: no component carries a status_artefact" "every swallowed addon must (1c)"
	elif [ -n "$bad" ]; then
		no "manifest artefacts disagree with the box:$bad" "key and artefact must agree in both directions"
	else
		ok "manifest artefacts agree with the box ($n components)"
	fi
}

# conf/defaults/*.conf against the key sets compiled into include/syshealth.sh: a stale registry makes the
# repair skip exactly the keys it exists to add.
check_key_registries() {
	local sys want have missing='' drift='' dupes=''
	if ! declare -F syshealth_known_keys > /dev/null 2>&1; then
		skip "syshealth_known_keys unavailable - key registries not checkable"
		return
	fi
	local unknown=''
	# system lives in share/hestia/sys-keys.json, checked by .gitea/tools/check-tree.sh.
	for sys in web mail mail_accounts user cron db ip; do
		# An empty reference would agree with the empty registry it writes.
		if ! want="$(syshealth_known_keys "$sys")" || [ -z "$want" ]; then
			unknown="$unknown $sys"
			continue
		fi
		want="$(echo "$want" | tr ' ' '\n' | sed '/^$/d')"
		if [ ! -f "$HESTIA/conf/defaults/$sys.conf" ]; then
			missing="$missing $sys"
			continue
		fi
		have="$(sed '/^$/d' "$HESTIA/conf/defaults/$sys.conf")"
		[ "$have" = "$want" ] || drift="$drift $sys"
		[ -z "$(echo "$have" | sort | uniq -d)" ] || dupes="$dupes $sys"
	done
	if [ -n "$missing$drift$dupes$unknown" ]; then
		no "key registries out of sync" \
			"missing:${missing:- none} drift:${drift:- none} duplicates:${dupes:- none} no-key-set:${unknown:- none}"
	else
		ok "key registries match the compiled key sets (7 object registries)"
	fi
}

# The live mount, not the config: a failed unit fails open silently, and a gid can drift off the group.
check_proc_hardening() {
	local unit='hestia-proc-hardening.service' mounted group_gid
	if ! systemctl list-unit-files "$unit" > /dev/null 2>&1 \
		|| [ "$(systemctl is-enabled "$unit" 2> /dev/null)" != enabled ]; then
		skip "/proc hardening not enabled here (container?)"
		return
	fi

	[ "$(systemctl is-failed "$unit" 2> /dev/null)" = failed ] \
		&& no "/proc hardening unit failed" "boot left /proc unhardened; systemctl status $unit"

	if grep -q ' /proc .*hidepid=' /proc/self/mountinfo /proc/mounts 2> /dev/null; then
		ok "/proc carries hidepid"
	else
		no "/proc has no hidepid" "every user can read foreign /proc/*/cmdline; systemctl start $unit"
	fi

	# A stale numeric gid would exempt whoever holds it now.
	mounted=$(awk '$2 == "/proc" { print $4 }' /proc/mounts | tr ',' '\n' | sed -n 's/^gid=//p')
	group_gid=$(getent group procvis 2> /dev/null | cut -d: -f3)
	if [ -z "$mounted" ]; then
		[ -z "$group_gid" ] && ok "/proc exemption absent, procvis absent" \
			|| no "/proc exemption missing while procvis exists" "gid $group_gid is not exempt; rootless Docker cannot start containers"
	elif [ "$mounted" = "$group_gid" ]; then
		ok "/proc exemption gid matches procvis"
	else
		no "/proc exemption gid $mounted is not procvis (${group_gid:-absent})" "a recycled gid silently exempts a foreign group"
	fi
}

check_mesh_serve_staged() {
	# Without the staging every peer stops receiving this box's bans, and /run is empty after a boot.
	if [ ! -s "$CONF_DIR/crowdsec/peers.conf" ]; then
		ok "crowdsec mesh has no peers paired"
	elif [ -f /run/hestia/mesh/tokens ] && [ -f /run/hestia/mesh/published.json ]; then
		ok "crowdsec mesh serve side staged"
	else
		no "crowdsec mesh peers paired but /run/hestia/mesh not staged" "run: h-update-crowdsec-mesh"
	fi
}

# An interrupted model switch reports itself instead of surfacing at the next reboot.
check_web_model_sentinel() {
	local s="/var/lib/hestia/web-model-switch/IN_PROGRESS" op
	if [ -f "$s" ]; then
		op=$(sed -n 's/^op=//p' "$s")
		no "interrupted web-model switch pending (#120)" "recover: ${op:-h-<add|delete>-sys-<nginx|apache2>} --recover"
	else
		ok "no interrupted web-model switch"
	fi
}


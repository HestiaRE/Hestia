# Action #
#----------------------------------------------------------#

echo "=== HestiaRE smoke test ==="

# --- Panel (always expected) ---
echo "-- panel --"
check_service caddy "panel webserver"
check_service hestia-php "panel PHP-FPM"
check_panel_php_version
check_panel_cli_i18n
check_panel_port
check_http "https://127.0.0.1:${BACKEND_PORT:-8083}/login/" "panel login page"
# The v6 twin of the same probe: a listener that binds only v4 looks identical from 127.0.0.1.
# Loopback, so it needs a v6 kernel and nothing else - measured 200 on v4-only, dual and v6-only boxes.
if [ -e /proc/net/if_inet6 ]; then
	check_http "https://[::1]:${BACKEND_PORT:-8083}/login/" "panel login page over v6"
else
	skip "panel login page over v6 (this kernel has no IPv6)"
fi
# invalid sudoers → no privileged panel action works
check_sudoers /etc/sudoers.d/hestia "hestia grant"
check_project_quota
check_customer_php_slice

# --- Configured subsystems (derived from *_SYSTEM) ---
echo "-- services --"
[ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'nginx' ] && check_service "$WEB_SYSTEM" "web"
[ -n "$PROXY_SYSTEM" ] && check_service "$PROXY_SYSTEM" "reverse proxy"
# mailfront: customer web absent by design, but the webmail/ACME front must run
[ -z "$WEB_SYSTEM" ] && [ -n "${WEBMAIL_FRONT:-}" ] && check_service "$WEBMAIL_FRONT" "webmail front"
[ -n "$MAIL_SYSTEM" ] && check_service "$MAIL_SYSTEM" "mail"
check_notification_mta
check_exim_sendonly
[ -n "$IMAP_SYSTEM" ] && check_service "$IMAP_SYSTEM" "imap"
# The one measured case: a dovecot that never read its own auth chain still answers on 143
# with a banner, so the liveness check above cannot see it.
[ -n "$IMAP_SYSTEM" ] \
	&& check_config_loaded dovecot "imap" /etc/dovecot/dovecot.conf /etc/dovecot/conf.d/*.conf
[ -n "$ANTISPAM_SYSTEM" ] && check_service "$ANTISPAM_SYSTEM" "antispam"
[ -n "$FTP_SYSTEM" ] && check_service "$FTP_SYSTEM" "ftp"
# Not gated on CRON_SYSTEM: cron is in the installer's base package list, so it is on every box in
# every profile. No command sets the key either, so gating here meant emptying it by hand REMOVED
# this check instead of failing it - the key names the implementation, it does not decide whether
# cron is expected (#971). An unusable registry leaves the name empty, which is red, not silent.
check_service "${CRON_SYSTEM:-$(sysreg_default CRON_SYSTEM)}" "cron"
# A LOCAL engine is the presence key, never DB_SYSTEM: that one is the host register and a token there can
# name a remote server, on which no local service is expected to run. The recipe is gone from here
# for the same reason it is gone everywhere else, it says what was chosen.
#
# What these gates do NOT cover, said out loud because the reference set got narrower: they now believe the
# status key. An empty key where the service IS installed makes the check below skip in silence, and only
# the components with a status_artefact are watched from the other side (check_manifest_artefacts).
# MariaDB, PostgreSQL, Redis, CrowdSec and Adminer are not among them, so for those five the pairing rests
# on their writers, which set the key on the success path AND on the already-installed path (the 1b build
# rule). Redis has no artefact on purpose: the package is there in both states, and only the cap marker
# tells the general service from rspamd's companion.
[ -n "$DB_MARIADB_SYSTEM" ] && check_service mariadb "database (mysql)"
[ -n "$DB_POSTGRESQL_SYSTEM" ] && check_service postgresql "database (pgsql)"
if [ "$FIREWALL_EXTENSION" = 'fail2ban' ]; then
	check_service fail2ban "fail2ban"
	# The service being up says nothing about whether any jail is: these four are what make a green run
	# mean working brute-force protection.
	check_fail2ban_config
	check_fail2ban_jails
	check_fail2ban_banaction
	check_fail2ban_logpaths
	check_fail2ban_backends
	check_fail2ban_web_logpath
fi
# clamav's service check moved into the addon recount, which also verifies the other six
check_addons_swallowed
[ -n "$CROWDSEC_SYSTEM" ] && check_service crowdsec "crowdsec"
# Layer separation runs whenever either system is present (marker or extension), not gated on a component.
{ [ -f "$CONF_DIR/firewall/crowdsec.conf" ] || [ "$FIREWALL_EXTENSION" = 'fail2ban' ]; } && check_firewall_layer_separation
# L3 feeder timer only where CrowdSec L3 is wired (the marker) - keyed off the artefact,
# not just the component flag, so a crowdsec-without-L3 state doesn't false-fail.
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && check_service hestia-crowdsec-l3.timer "crowdsec L3 feeder timer"
# fleet-mesh timer only where mesh is enabled (its marker conf), same artefact-gated reasoning.
if [ -f "$CONF_DIR/crowdsec/mesh.conf" ]; then
	check_service hestia-crowdsec-mesh.timer "crowdsec fleet-mesh timer"
	check_mesh_serve_staged
fi
# adminer: no own daemon, served by a caddy FPM pool, so check the socket
[ -n "$DB_ADMINER_ALIAS" ] && check_socket /run/hestia-adminer.sock "adminer FPM"
if echo "$WEBMAIL_SYSTEM" | grep -qw 'roundcube'; then
	# The listener serves through the pool socket, so a 200 also proves socket and payload.
	check_http "http://127.0.0.1:8090/" "roundcube internal listener"
fi
if echo "$WEBMAIL_SYSTEM" | grep -qw 'tachyon'; then
	check_http "http://127.0.0.1:8091/" "tachyon internal listener"
fi
# redis: the general service or rspamd's always-present Bayes companion
if [ -n "$REDIS_SYSTEM" ] || [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	check_service redis-server "redis"
fi

# --- Firewall datapath (live state, not just the daemon) ---
# The two invariants a green service check cannot see. Both keyed off FIREWALL_SYSTEM, since an
# ACCEPT policy is correct when the firewall is deliberately off. The invariants outlive the
# iptables renderer (re-expresses them against nft), the mechanism below does not.
if [ -n "$FIREWALL_SYSTEM" ]; then
	echo "-- firewall --"
	check_firewall_closed
	check_firewall_ruleset_loadable
	check_firewall_rules_rendered
	check_firewall_ipsets_populated
fi

# --- Ports implied by the active config ---
echo "-- ports --"
if [ -n "$PROXY_SYSTEM" ] || [ -n "$(webmail_front)" ]; then
	check_port 80 "http"
	check_port 443 "https"
fi
# The LOCAL engine key, not the host register: a registered mysql host may be a remote one, and then no
# local listener is expected. Reachable after h-delete-sys-mariadb on a box that also has a remote host,
# because the token only goes when the LAST host of its type does (measured: red on exactly that state).
[ -n "$DB_MARIADB_SYSTEM" ] && check_port 3306 "mysql"
# banner, not just port: IMAP/SMTP must actually answer (a hung login still listens)
if [ -n "$IMAP_SYSTEM" ]; then
	check_banner 143 "imap"
fi
[ -n "$MAIL_SYSTEM" ] && check_banner 25 "smtp"
if [ "$ANTISPAM_SYSTEM" = 'rspamd' ]; then
	# group-restricted unix sockets, rspamd has no TCP ports
	check_socket /run/rspamd/normal.sock "rspamd scan worker"
	check_socket /run/rspamd/controller.sock "rspamd controller"
	check_rspamd_ctrl_isolation
fi
# localhost-only (webmail managesieve plugin), not opened in the firewall
[ "$SIEVE_SYSTEM" = 'yes' ] && check_port 4190 "managesieve"

# --- Critical log markers ---
echo "-- logs --"
check_log_clean "/var/log/hestia-php-fpm.log" "PHP (Fatal|Parse) error|\[emergency\]|\[alert\]" "panel FPM"
if [ -n "$PROXY_SYSTEM" ] || [ -n "${WEBMAIL_FRONT:-}" ]; then
	check_log_clean "/var/log/nginx/error.log" "\[emerg\]|\[alert\]" "nginx"
fi
[ "$WEB_SYSTEM" = 'apache2' ] && check_log_clean "/var/log/apache2/error.log" "\[.*:emerg\]|\[.*:alert\]" "apache2"
# exim writes serious problems to a dedicated paniclog, non-empty means trouble
[ -n "$MAIL_SYSTEM" ] && check_file_empty "/var/log/exim4/paniclog" "exim paniclog"

# --- Invariants of this box (live state and records; the tree-only guards run in CI, check-tree.sh) ---
echo "-- invariants --"
check_sudo_secret_leak
# v-* compat symlinks must all resolve (no dangling alias left by a rename).
check_v_symlinks_resolve
check_panel_languages
check_panel_translates
# a policy fragment (crowdsec Layer A, bot rate limiting) missing from one template is a silent bypass.
check_policy_fragment_coverage
check_web_config_test
# An interrupted model switch must not stay invisible.
check_web_model_sentinel
# fail-open is invisible to users: verify the live mount, not the intent.
check_proc_hardening
# a record pointing at a removed template only shows up on the next rebuild.
check_web_templates_resolvable
check_web_record_has_vhost
check_logrotate_parses
check_restic_mode_supported
check_ioncube_versions
check_protected_names_effective
# 644 from the old /tmp sort path was silent on every box.
check_hestia_conf_mode
check_install_root_owner
check_secret_file_modes
check_panel_session_store
check_yescrypt_hashing
# derived counters drift silently when an increase/decrease pair dies half way.
check_object_counters
check_ip_object_counters
check_record_grammar
check_key_registries
check_operator_keys_present
check_jail_sshd
check_update_version

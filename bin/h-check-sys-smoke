#!/bin/bash
# info: post-install smoke test (services, ports, logs)
# options: NONE
#
# example: h-check-sys-smoke
#
# Verifies that a fresh install came up: the services implied by the active
# configuration are running, the expected ports listen, the panel answers, and no
# critical markers are in the key logs. Preset-independent — it derives what to
# expect from hestia.conf's *_SYSTEM vars and install.conf's COMPONENT_* flags.
# Prints PASS/FAIL per check; exits 0 if all pass, 1 otherwise. No v-* symlink.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source $HESTIA/include/fail2ban.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
# shellcheck source=/usr/local/hestia/include/limits.sh
source $HESTIA/include/limits.sh
# shellcheck source=/usr/local/hestia/include/ports.sh
source $HESTIA/include/ports.sh
# record_line_valid, so the grammar has one definition and the guard does not carry a second
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# live component state (COMPONENT_* flags), if present
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

pass=0
fail=0

ok() {
	echo "[ PASS ] $1"
	pass=$((pass + 1))
}
no() {
	echo "[ FAIL ] $1${2:+ — $2}"
	fail=$((fail + 1))
}
skip() { echo "[ skip ] $1"; }

# check_source_absent <label> <pattern> <path...> — a vulnerable pattern must not
# reappear (static regression guard for a security fix). Comment lines excluded.
# Whether sudo keeps panel command lines out of the logs depends on the sudo flavor and the
# distro, so assert the outcome per run: a throwaway marker through an allowed panel call must
# not survive in any persistent log. The sink set is derived from a control marker written to
# authpriv - no file receives it (journald-only) means nothing to assert, not nothing found.
# Covers log FILES only; the journald copy is out of scope here.
check_sudo_secret_leak() {
	local probe control f sinks='' leaked=''
	id hestia > /dev/null 2>&1 || {
		skip "sudo argv leak (panel user absent)"
		return
	}
	command -v logger > /dev/null 2>&1 || {
		skip "sudo argv leak (no logger to probe with)"
		return
	}
	probe="HstProbeArgv$(openssl rand -hex 6)"
	control="HstProbeSink$(openssl rand -hex 6)"

	logger -p authpriv.notice "$control"
	runuser -u hestia -- sudo -n "$BIN/h-list-users" list "$probe" > /dev/null 2>&1
	sleep 1

	for f in /var/log/auth.log /var/log/secure /var/log/syslog /var/log/messages; do
		[ -f "$f" ] || continue
		grep -qF "$control" "$f" 2> /dev/null && sinks="$sinks $f"
	done
	if [ -z "$sinks" ]; then
		skip "sudo argv leak (no persistent authpriv file on this box)"
		return
	fi
	for f in $sinks; do
		grep -qF "$probe" "$f" 2> /dev/null && leaked="$leaked $f"
	done
	if [ -n "$leaked" ]; then
		no "panel command lines persist in the system log:$leaked" \
			"neither !log_allowed nor the rsyslog drop rule is effective - panel-set secrets land there in cleartext"
		return
	fi
	ok "no panel command line kept in the persistent logs ($(echo $sinks | wc -w) sink(s) checked)"
}

check_source_absent() {
	local label="$1" pat="$2"
	shift 2
	local hit
	hit=$(grep -rnE "$pat" "$@" 2> /dev/null | grep -vE ':[[:space:]]*(//|#|\*)')
	if [ -z "$hit" ]; then
		ok "invariant: $label"
	else
		no "invariant: $label" "$(echo "$hit" | head -n1)"
	fi
}

# check_session_user_allowlist <webdir> — $_SESSION["user"] is the REAL logged-in
# user; during impersonation it is the ADMIN, not the customer (who is in "look").
# Scoping customer data by it mis-targets (#438). Rather than chase every spelling
# of the bug, allowlist the files that may touch the real user at all (auth /
# dispatch / reset / real-identity display); ANY other file is red — it must use the
# look-aware $user/$user_plain from inc/main.php. Turns "did we catch every spelling"
# into "may this file see the real user".
check_session_user_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="inc/main.php login/index.php logout/index.php index.php list/index.php \
fm-auth.php rspamd-auth.php reset/index.php reset2fa/index.php edit/user/index.php \
list/log/index.php templates/includes/panel.php templates/pages/edit_server.php \
templates/pages/edit_user.php templates/pages/list_key.php templates/pages/list_log.php \
templates/pages/list_search.php templates/pages/list_user.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE '\$_SESSION\["user"\]' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: \$_SESSION[user] only in allowlisted files (#438)"
	else
		no "invariant: \$_SESSION[user] in non-allowlisted file (#438 mis-target risk)" "${bad# }"
	fi
}

# check_xaccel_allowlist <webdir> — only list/rrd/image.php may EMIT X-Accel-Redirect. Caddy serves it
# via file_server as `caddy`, which reads only the web-root files it owns (the RRD images); a download
# handler emitting it for a customer file hits the caddy-can't-read wall (#441) — stream via
# inc/download.php as `hestia` instead. Matches header(...) emission, not the handlers' prose.
check_xaccel_allowlist() {
	local webdir="$1" bad="" f rel
	local allow="list/rrd/image.php"
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		rel=${f#"$webdir"/}
		case " $allow " in *" $rel "*) continue ;; esac
		bad="$bad $rel"
	done <<< "$(grep -rlE 'header\(["'"'"']X-Accel-Redirect' "$webdir" 2> /dev/null)"
	if [ -z "$bad" ]; then
		ok "invariant: X-Accel-Redirect only emitted by allowlisted files (#441/#443)"
	else
		no "invariant: X-Accel-Redirect emitted by non-allowlisted file (caddy-can't-read wall)" "${bad# }"
	fi
}

# check_service <systemd-unit> <label>
check_service() {
	if systemctl is-active --quiet "$1"; then
		ok "service $2 ($1) active"
	else
		no "service $2 ($1) not active" "$(systemctl is-active "$1" 2> /dev/null)"
	fi
}

# check_port <port> <label>
check_port() {
	if ss -H -tln 2> /dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"; then
		ok "port $1 ($2) listening"
	else
		no "port $1 ($2) not listening"
	fi
}

# check_socket <path> <label> — listening unix socket
check_socket() {
	if ss -H -xln 2> /dev/null | grep -qF "$1"; then
		ok "socket $2 ($1) listening"
	else
		no "socket $2 ($1) not listening"
	fi
}

# check_firewall_backend - without /usr/sbin/nft, FIREWALL_SYSTEM is a claim the box cannot honour, and the
# policy check below only SKIPs, so a missing backend would pass for a permissions quirk.
check_firewall_backend() {
	if [ -x "$FW_NFT" ]; then
		ok "firewall backend present ($FW_NFT)"
	else
		no "firewall backend missing" "$FW_NFT not executable - FIREWALL_SYSTEM is set but nothing can apply a ruleset"
	fi
}

# With the firewall enabled INPUT must default to DROP; nothing else notices a box that came up with policy
# ACCEPT and no rules at all.
check_firewall_closed() {
	local pol
	pol=$(fw_policy_get INPUT)
	if [ -z "$pol" ]; then
		skip "firewall INPUT policy (backend not readable - root?)"
	elif [ "$pol" = 'DROP' ]; then
		ok "firewall INPUT policy closed (DROP)"
	else
		no "firewall INPUT policy is not DROP" "$pol"
	fi
}

# check_firewall_icmpv6 - without an explicit accept, NDP/PMTUD die under the drop policy and IPv6 breaks
# entirely (neigh INCOMPLETE, ping6 100% loss). Invisible on the v4-only fleet, hence the guard.
check_firewall_icmpv6() {
	local rules
	rules=$(nft list chain inet hestia input 2> /dev/null) || {
		skip "firewall ICMPv6 accept (inet hestia not readable)"
		return
	}
	if echo "$rules" | grep -q 'ipv6-icmp'; then
		ok "firewall accepts ICMPv6 (NDP/PMTUD - IPv6 stays functional)"
	else
		no "firewall drops ICMPv6" "no icmpv6 accept in inet hestia input - IPv6 NDP breaks under the drop policy"
	fi
}

# check_firewall_ruleset_loadable - that file IS what the boot unit reloads, so if it stops parsing the box
# boots with no ruleset at all. Sets and their rules load in one transaction now, so only this can go wrong.
check_firewall_ruleset_loadable() {
	local ruleset=/etc/hestia/firewall/ruleset.nft
	if [ ! -f "$ruleset" ]; then
		no "firewall ruleset not persisted" "$ruleset missing - a reboot would come up unfiltered"
		return
	fi
	if nft -c -f "$ruleset" > /dev/null 2>&1; then
		ok "persisted firewall ruleset loads"
	else
		no "persisted firewall ruleset is rejected by nft" "$(nft -c -f "$ruleset" 2>&1 | head -n1)"
	fi
}

# check_firewall_chains_tracked - the live ruleset must not carry a jail chain the object model forgot.
# Reproduced under iptables, where a leaked jump kept a chain referenced until its record was already gone;
# kept now the cause is fixed, because an untracked chain is a rule nobody audits.
check_firewall_chains_tracked() {
	local orphan='' c
	for c in $(fw_jail_chains_live); do
		grep -q "CHAIN='$c'" "$CONF_DIR/firewall/chains.conf" 2> /dev/null || orphan="$orphan $c"
	done
	if [ -n "$orphan" ]; then
		no "live firewall jail chain with no chains.conf record" "${orphan# }"
	else
		ok "firewall jail chains all tracked in the object model"
	fi
}

# check_firewall_rules_rendered - the other direction: fw_rule skips a source that is neither any, an ipset
# nor a valid address, so a corrupted entry drops out of the firewall with nothing going red.
check_firewall_rules_rendered() {
	local rules="$CONF_DIR/firewall/rules.conf" bad='' line
	[ -f "$rules" ] || {
		ok "firewall rules all renderable (none)"
		return
	}
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		parse_object_kv_list "$line"
		[ "${SUSPENDED:-no}" = 'yes' ] && continue
		case "$IP" in
			0.0.0.0/0 | ::/0 | '' | ipset:*) continue ;;
		esac
		fw_is_addr "$IP" || fw_is_addr6 "$IP" || bad="$bad RULE=$RULE($IP)"
	done < "$rules"
	if [ -z "$bad" ]; then
		ok "firewall rules all render (valid source per entry)"
	else
		no "firewall rule with an unrenderable source (silently skipped)" "${bad# }"
	fi
}

# check_firewall_ipsets_populated - the guard above accepts any ipset: source, but never checks the list
# behind it. No cache file renders an EMPTY set: rule present, panel shows the list, nothing matches.
check_firewall_ipsets_populated() {
	local rules="$CONF_DIR/firewall/rules.conf" bad='' line name src
	[ -f "$rules" ] || {
		ok "firewall IP lists all populated (no rules)"
		return
	}
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		parse_object_kv_list "$line"
		[ "${SUSPENDED:-no}" = 'yes' ] && continue
		case "$IP" in ipset:*) ;; *) continue ;; esac
		name="${IP#ipset:}"
		src="$(fw_set_src "$name")"
		[ -s "$src" ] || bad="$bad $name(${src##*/})"
	done < "$rules"
	if [ -z "$bad" ]; then
		ok "firewall IP lists referenced by a rule are populated"
	else
		no "firewall rule matches an empty IP list (blocks nothing)" "${bad# }"
	fi
}

# check_fail2ban_jails - running must equal configured, in both directions: one of ours missing (how the
# whole set stayed dead while the service looked healthy) and a distro jail we never asked for.
check_fail2ban_jails() {
	local want have missing='' extra='' j
	want=$(fail2ban_enabled_jails | sort)
	have=$(fail2ban-client status 2> /dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' '\n' | sort)
	for j in $want; do grep -qx "$j" <<< "$have" || missing="$missing $j"; done
	for j in $have; do grep -qx "$j" <<< "$want" || extra="$extra $j"; done
	if [ -n "$missing" ]; then
		no "fail2ban jail enabled in config but not running" "${missing# }"
	elif [ -n "$extra" ]; then
		no "fail2ban is running a jail we did not enable" "${extra# } (a distro jail bans into a ruleset we do not manage)"
	else
		ok "fail2ban jails match the configured set"
	fi
}

# check_fail2ban_config - a config error leaves the service up and the jail gone, so the exit status is not
# enough: fail2ban prints these on stderr while the dump itself still succeeds.
check_fail2ban_config() {
	local errs
	errs=$(fail2ban-client -d 2>&1 > /dev/null | grep ERROR | head -n1)
	if [ -z "$errs" ]; then
		ok "fail2ban config parses without error"
	else
		no "fail2ban config error" "${errs#*ERROR   }"
	fi
}

# check_fail2ban_banaction - one assertion covering the distro leftover, a future package default and a
# renderer swap that leaves the action behind.
check_fail2ban_banaction() {
	local foreign
	# `action = hestia[name=SSH]` is instantiated as the action `hestia-SSH`, so match the prefix. Testing
	# for a bare `hestia` looks right and never matches anything.
	foreign=$(fail2ban-client -d 2> /dev/null \
		| grep -oE "'addaction', '[^']+'" | sed "s/.*'\(.*\)'/\1/" | sort -u | grep -v '^hestia-')
	if [ -z "$foreign" ]; then
		ok "fail2ban bans through the hestia action only"
	else
		no "fail2ban jail using a foreign banaction" "$(echo "$foreign" | tr '\n' ' ')"
	fi
}

# A jail watching a missing file never fires and says so only in fail2ban's own log - how the mail jails
# stayed enabled on boxes without mail.
check_fail2ban_logpaths() {
	local missing='' p
	while read -r p; do
		[ -n "$p" ] || continue
		case "$p" in /*) [ -e "$p" ] || missing="$missing $p" ;; esac
	done <<< "$(fail2ban-client -d 2> /dev/null | grep -oE "'addlogpath', '[^']+'" | sed "s/.*'\(.*\)'/\1/" | sort -u)"
	if [ -z "$missing" ]; then
		ok "fail2ban jail logpaths all exist"
	else
		no "fail2ban jail watching a missing logpath" "${missing# }"
	fi
}

# A jail on the systemd backend keeps its logpath, starts cleanly and reports healthy while monitoring
# nothing - so neither "the file exists" nor "the jail runs" catches it. Asking what it monitors does.
check_fail2ban_backends() {
	local blind='' j pat
	for j in $(fail2ban_enabled_jails); do
		fail2ban-client status "$j" > /dev/null 2>&1 || continue
		fail2ban-client get "$j" logpath 2> /dev/null | grep -q '^ *`\?- */' && continue
		# A glob matching nothing yet is not a defect - a box with no web domains has nothing to watch. The
		# defect this guard is for is a jail whose files exist and that monitors them anyway.
		pat="$(fail2ban_jail_logpath "$j")"
		[ -n "$pat" ] && ! compgen -G "$pat" > /dev/null 2>&1 && continue
		blind="$blind $j"
	done
	if [ -z "$blind" ]; then
		ok "fail2ban jails are watching their log files"
	else
		no "fail2ban jail monitors no file (wrong backend?)" "${blind# }"
	fi
}

# WEBMAIL_SYSTEM used to be written before the install ran, so a failed download left the config claiming a
# webmail that was never unpacked (#573). The listener check catches that too, but only as an ambiguous 404
# - this names the cause.
check_webmail_payload() {
	local wm="$1" f="$2"
	[ -s "$f" ] && {
		ok "$wm payload installed"
		return
	}
	no "$wm claimed by WEBMAIL_SYSTEM but not installed" "missing $f"
}

# The SQLite exception (#584): a webmailer installed while MariaDB was deselected records the
# sqlite backend in its own config. WHERE that artefact says sqlite, the PHP driver must be in
# the panel pool - confd lists it as optional (an updated one-minor-back box lacks the package),
# so this is the guard that turns a missing driver into a hard failure exactly where it breaks.
check_webmail_sqlite_driver() {
	local wm="$1"
	if ls /etc/php/hestia/fpm/conf.d/*-sqlite3.ini > /dev/null 2>&1 \
		&& ls /etc/php/hestia/fpm/conf.d/*-pdo_sqlite.ini > /dev/null 2>&1; then
		ok "$wm sqlite backend has its PHP driver"
		return
	fi
	no "$wm records the sqlite backend but the panel pool lacks sqlite3/pdo_sqlite" \
		"install php-sqlite3 for the pinned panel version, then re-run hestia-php-confd"
}

# The write-path value domain (WEBMAIL_KNOWN_CLIENTS, include/main.sh) is a hand-kept list;
# this derives the shipped-client set from the webmail templates and asserts coverage - a
# client added by template alone would have its records normalized to 'disabled' while
# everything else works. Infrastructure template names are not clients; an empty derived
# set fails rather than passes.
check_webmail_value_domain() {
	local t c found=0 missing=''
	for t in "$HESTIA"/share/*/webmail/*.tpl; do
		c=$(basename "$t" .tpl)
		case "$c" in default | web_system | disabled | default_*) continue ;; esac
		found=$((found + 1))
		grep -qwF -- "$c" <<< "$WEBMAIL_KNOWN_CLIENTS" || missing="$missing $c"
	done
	if [ "$found" -eq 0 ]; then
		no "webmail value-domain guard found no client templates" "share/*/webmail/ empty or moved"
		return
	fi
	[ -z "$missing" ] && {
		ok "webmail value domain covers the shipped client templates"
		return
	}
	no "webmail templates outside the value domain:$missing" "extend WEBMAIL_KNOWN_CLIENTS in include/main.sh"
}

# Two files have to agree on how a diff payload is spelled: backup.sh names it, h-restore-user greps
# for it. Both are used AS SHIPPED here - the namer in a subshell, the pattern lifted out of the
# restore - so a rename on one side cannot go unnoticed. Plus the fallback that keeps pre-#840
# archives restorable: diff-named wins, whole-named still resolves.
check_backup_diff_member_name() {
	local ext n p d w r pats missing='' seen=0
	# BOTH codecs: the restore greps twice, once per codec, and a drift in the gzip line would sail
	# past a guard that only ever looks at the zstd one.
	pats=$(grep -oE "grep -E 'domain_data[^']*'" "$HESTIA/bin/h-restore-user" | cut -d"'" -f2)
	if [ "$(grep -c . <<< "$pats")" -ne 2 ]; then
		no "diff-member guard found $(grep -c . <<< "$pats") domain-list pattern(s), expected 2" \
			"the restore's domain-list greps moved or changed shape"
		return
	fi
	for ext in zst gz; do
		n=$(bash -c "source /etc/hestia/hestia.env; source \$HESTIA/include/backup.sh; backup_diff_member_name web/x/domain_data.tar.$ext" 2> /dev/null)
		p=$(grep -F "$ext" <<< "$pats" | head -1)
		if [ -z "$n" ] || [ -z "$p" ]; then
			missing="$missing $ext(no-name-or-pattern)"
			continue
		fi
		seen=$((seen + 1))
		grep -qE "$p" <<< "$n" || missing="$missing $ext"
		# The fallback that keeps pre-#840 archives restorable, per codec: diff-named wins when both
		# are there, whole-named still resolves when it is alone.
		d=$(mktemp -d) || return
		: > "$d/domain_data.tar.$ext"
		: > "$d/domain_data.diff.tar.$ext"
		r=$(bash -c "source /etc/hestia/hestia.env; source \$HESTIA/include/backup.sh; backup_payload_path '$d' domain_data.tar.$ext" 2> /dev/null)
		rm -f "$d/domain_data.diff.tar.$ext"
		w=$(bash -c "source /etc/hestia/hestia.env; source \$HESTIA/include/backup.sh; backup_payload_path '$d' domain_data.tar.$ext" 2> /dev/null)
		rm -rf "$d"
		[ "${r##*/}" = "domain_data.diff.tar.$ext" ] && [ "${w##*/}" = "domain_data.tar.$ext" ] \
			|| missing="$missing $ext(fallback:${r##*/}/${w##*/})"
	done
	if [ "$seen" -ne 2 ]; then
		no "diff-member guard checked $seen of 2 codecs" "the namer or the patterns did not answer for both"
		return
	fi
	[ -z "$missing" ] && {
		ok "diff payload name agrees across writer and restore for both codecs, fallback resolves"
		return
	}
	no "diff payload name or fallback disagrees:$missing" \
		"backup_diff_member_name, backup_payload_path and the restore's greps must match"
}

# BACKUP_CONTAINER_META is hand-kept, and the restore copies anything not on it into $USER_DATA -
# twice already a member the backup side added leaked there unread (#839). So derive what the writers
# actually emit into hestia/ and assert every name is either meta or explicitly handled. An empty
# derived set fails: it would mean the grep, not the code, changed.
check_backup_container_meta() {
	local n meta found=0 missing='' src="$HESTIA/include/backup.sh"
	# Both sides out of the file, so neither depends on this script sourcing backup.sh, and an empty
	# reference set fails instead of agreeing with everything.
	meta=$(sed -n "s/^BACKUP_CONTAINER_META='\([^']*\)'.*/\1/p" "$src")
	if [ -z "$meta" ]; then
		no "container-member guard read no BACKUP_CONTAINER_META" "the constant moved or emptied in include/backup.sh"
		return
	fi
	for n in $(grep -ohE '(\$tmpdir|\$_tmp|\$_wd)/(hestia|\$BACKUP_CONTAINER)/[A-Za-z0-9._-]+' \
		"$HESTIA/bin/h-backup-user" "$src" 2> /dev/null | sed -E 's#.*/##' | sort -u); do
		found=$((found + 1))
		# user.conf, ssl and packages are the three the restore handles by name.
		[[ " $meta user.conf ssl packages " == *" $n "* ]] || missing="$missing $n"
	done
	if [ "$found" -eq 0 ]; then
		no "container-member guard derived no members" "the writers or the path spelling moved - re-check the sweep"
		return
	fi
	[ -z "$missing" ] && {
		ok "every archive container member is meta or handled by name ($found seen)"
		return
	}
	no "container member(s) neither meta nor handled:$missing" "add them to BACKUP_CONTAINER_META in include/backup.sh"
}

# Seven addon installs in h-install-hestia swallow their errors (|| true, deliberately: a flaky
# addon must not abort the install), and nothing recounted afterwards - a failed one left a green
# install with the wizard's choice silently unmet (#843). This recounts every requested one by its
# artefact. The set comes out of the installer file itself, so a new swallowed addon without a
# mapping here fails instead of shipping unverified; an empty derivation fails too. NOT covered:
# addons installed without || true - their failure aborts the install and needs no recount.
check_addons_swallowed() {
	local addons a gate key svc mail_only n=0
	addons=$(grep -oE 'h-add-sys-[a-z]+" >> "\$LOG" 2>&1 \|\| true' "$HESTIA/sbin/h-install-hestia" 2> /dev/null \
		| grep -oE 'h-add-sys-[a-z]+' | sed 's/^h-add-sys-//' | sort -u)
	if [ -z "$addons" ]; then
		no "addon recount derived an empty set from h-install-hestia" "the || true call pattern moved - update the derivation"
		return
	fi
	for a in $addons; do
		key='' svc='' mail_only=''
		case $a in
			rspamd) key="${ANTISPAM_SYSTEM:-}" svc=rspamd mail_only=yes ;;
			sieve) key="${SIEVE_SYSTEM:-}" mail_only=yes ;; # managesieve runs inside dovecot, no own daemon
			clamav) key="${ANTIVIRUS_SYSTEM:-}" svc=clamav-daemon mail_only=yes ;;
			proftpd) key="${FTP_SYSTEM:-}" svc=proftpd ;;
			docker) key="${DOCKER_SYSTEM:-}" ;; # rootless per-user, no system daemon
			filemanager) key="${FILE_MANAGER_PORT:-}" ;;
			restic) key=$(command -v restic || true) ;;
			*)
				no "addon $a: the installer swallows its errors, this recount has no artefact mapping" "add one here"
				continue
				;;
		esac
		gate="COMPONENT_ADDON_${a^^}"
		is_on "${!gate:-}" || continue
		# the installer only attempts mail-tier addons inside install_mail
		[ -n "$mail_only" ] && ! is_on "${COMPONENT_MAIL_BLOCK_PRESENT:-}" && continue
		n=$((n + 1))
		if [ -n "$key" ]; then
			ok "addon $a installed (artefact present)"
			[ -n "$svc" ] && check_service "$svc" "$a"
		else
			no "addon $a requested but its artefact is missing" "the installer swallowed the failure - see the install log"
		fi
	done
	if [ "$n" -eq 0 ]; then
		skip "addon recount (none of the swallowed addons requested)"
	fi
}

# A web jail must watch the CURRENT web system's dir. After a switch that forgets to re-gate, its logpath
# points at the old stack - a REAL path, so the "what does a jail watch" guard cannot see it, and the next
# restart from any cause leaves it watching a stack with no traffic. Compared against the WEB_SYSTEM dir.
check_fail2ban_web_logpath() {
	local want jail lp bad=''
	want="$(fail2ban_web_logdir 2> /dev/null)" || {
		skip "web jail logpath (no web system)"
		return
	}
	for jail in $F2B_WEB_JAILS; do
		fail2ban_jail_enabled "$jail" || continue
		lp="$(fail2ban_jail_logpath "$jail")"
		[ -n "$lp" ] || continue
		case "$lp" in "$want"/*) ;; *) bad="$bad $jail" ;; esac
	done
	if [ -z "$bad" ]; then
		ok "fail2ban web jails watch the current web system ($want)"
	else
		no "fail2ban web jail logpath stale vs WEB_SYSTEM" "${bad# } not under $want - a web-model switch did not re-gate; a fail2ban restart would go blind"
	fi
}

# CrowdSec owns Layer-7 and fail2ban owns brute force, so each side's jobs are off while the other is there.
# A transition that re-gates only one direction reintroduces the double-ban.
check_firewall_layer_separation() {
	local bad='' j s
	if [ -f "$CONF_DIR/firewall/crowdsec.conf" ]; then
		for j in $F2B_WEB_JAILS; do
			fail2ban_jail_enabled "$j" 2> /dev/null && bad="$bad webjail:$j"
		done
	fi
	if [ "$FIREWALL_EXTENSION" = 'fail2ban' ] && command -v cscli > /dev/null 2>&1; then
		for s in ssh-bf ssh-slow-bf; do
			[ -e "/etc/crowdsec/scenarios/$s.yaml" ] && bad="$bad crowdsec-bf:$s"
		done
	fi
	if [ -z "$bad" ]; then
		ok "fail2ban and crowdsec layers do not overlap (#542)"
	else
		no "fail2ban/crowdsec layer overlap" "${bad# } - a model transition did not re-gate the counterpart"
	fi
}

# check_http <url> <label>
check_http() {
	local code
	code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2> /dev/null)
	if [ "$code" = "200" ]; then
		ok "$2 (HTTP $code)"
	else
		no "$2 (HTTP ${code:-000})"
	fi
}

# check_rspamd_ctrl_isolation — the controller socket must be reachable by the
# Caddy proxy process but NOT by the app FPM pools that share the caddy user.
# Checked against live process creds + /etc/group, so a config regression fails here.
check_rspamd_ctrl_isolation() {
	local gid pid pgroups
	gid=$(getent group _rspamd-ctrl | cut -d: -f3)
	if [ -z "$gid" ]; then
		no "rspamd controller group _rspamd-ctrl missing"
		return
	fi
	# 1. socket carries the dedicated group (not plain _rspamd)
	if [ "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)" = '_rspamd-ctrl' ]; then
		ok "controller socket group is _rspamd-ctrl"
	else
		no "controller socket not group _rspamd-ctrl" "$(stat -c '%G' /run/rspamd/controller.sock 2> /dev/null)"
	fi
	# 2. caddy user NOT in the controller group (else app pools inherit via initgroups)
	if id -nG caddy 2> /dev/null | tr ' ' '\n' | grep -qxE '_rspamd(-ctrl)?'; then
		no "caddy user is in an rspamd group (app pools would inherit socket access)" "$(id -nG caddy)"
	else
		ok "caddy user not in any rspamd group (app pools isolated)"
	fi
	# 3. caddy proxy process DOES hold the group (else controller UI breaks)
	pid=$(systemctl show -p MainPID --value caddy.service 2> /dev/null)
	pgroups=$(grep -E '^Groups:' /proc/"${pid:-0}"/status 2> /dev/null)
	if echo "$pgroups" | tr ' \t' '\n' | grep -qx "$gid"; then
		ok "caddy proxy process holds _rspamd-ctrl (controller reachable)"
	else
		no "caddy proxy process lacks _rspamd-ctrl (controller UI would break)" "$pgroups"
	fi
}

# check_log_clean <file> <extended-regex> <label>
check_log_clean() {
	if [ ! -f "$1" ]; then
		skip "log $2 absent ($1)"
		return
	fi
	local hits
	hits=$(grep -aEc "$2" "$1" 2> /dev/null || true)
	if [ "${hits:-0}" -eq 0 ]; then
		ok "log $3 clean"
	else
		no "log $3 has $hits critical entr$([ "$hits" -eq 1 ] && echo y || echo ies)" "$1"
	fi
}

# check_file_empty <file> <label>  (fail if file exists and is non-empty)
check_file_empty() {
	if [ -s "$1" ]; then
		no "$2 non-empty" "$1"
	else
		ok "$2 empty/absent"
	fi
}

# check_banner <port> <label> — service answers with a protocol banner in 5s.
# Catches "active + listening but dead" (e.g. dovecot IMAP login hangs) that
# check_service/check_port miss.
check_banner() {
	local banner
	# head -n1, NOT head -c N: a byte-count read blocks until N bytes arrive
	banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1 && head -n1 <&3" 2> /dev/null)
	if [ -n "$banner" ]; then
		ok "port $1 ($2) answers with a banner"
	else
		no "port $1 ($2) gave no banner within 5s (service up but not functional?)"
	fi
}

# check_v_symlinks_resolve — no v-* compat alias may dangle (catches a rename/
# removal the install-time prune should have cleared). Extra aliases are fine.
check_v_symlinks_resolve() {
	local dangling first
	dangling=$(find "$HESTIA/bin" -maxdepth 1 -name 'v-*' -xtype l 2> /dev/null)
	if [ -z "$dangling" ]; then
		ok "no dangling v-* symlinks"
	else
		no "dangling v-* symlink(s)" "$(echo "$dangling" | head -n1 | xargs basename)"
	fi
}

# check_panel_locale - the FPM pools pin env[LANG] so a child does not inherit whatever the admin's
# base install happens to have. Pinning a locale that is not generated is the same failure with more
# confidence: every child that touches locale warns, and awstats' perl warnings land in the panel log
# (that is how this was found). The expected value is READ FROM the deployed pool, not written here,
# so changing the pin cannot leave the check testing yesterday's value.
# NOT covered: locales a customer's own PHP or a cron job sets for itself.
# The panel PHP version is a file, not a constant (#191): /etc/php/hestia/php-version
# names whatever the wrappers and hestia-php.service run. An empty file or a version
# whose binaries are gone means every panel request dies at exec - say which half broke.
check_panel_php_version() {
	local v
	v=$(cat /etc/php/hestia/php-version 2> /dev/null)
	if [ -z "$v" ]; then
		no "panel PHP version file" "/etc/php/hestia/php-version is empty or missing - the hestia-php wrappers fall back blind"
		return
	fi
	if [ ! -x "/usr/bin/php$v" ] || [ ! -x "/usr/sbin/php-fpm$v" ]; then
		no "panel PHP $v binaries (cli+fpm)" "php-version names $v but /usr/bin/php$v or /usr/sbin/php-fpm$v is missing"
		return
	fi
	# a PHP package update replaces the binary; the distro postinst does not know
	# hestia-php.service, so without the apt hook the master serves the old image
	local pid exe
	pid=$(systemctl show -p MainPID --value hestia-php 2> /dev/null)
	if [ -z "$pid" ] || [ "$pid" = 0 ]; then
		# master not running: the service check above already flags that red -
		# do not claim an image state nothing looked at
		ok "panel PHP $v (php-version file and binaries present; master not running, see the service check)"
		return
	fi
	exe=$(readlink "/proc/$pid/exe" 2> /dev/null)
	case "$exe" in
		*" (deleted)")
			no "panel FPM master runs a deleted PHP image" "a PHP update replaced the binary - restart hestia-php (sbin/hestia-php-refresh should have)"
			return
			;;
	esac
	# same string carries the version: file says $v, master may still run the old one
	# (a version switch without the restart is exactly this state)
	if [ -n "$exe" ] && [ "${exe##*/}" != "php-fpm$v" ]; then
		no "panel FPM master runs ${exe##*/} but php-version says $v" "restart hestia-php to load the recorded version"
		return
	fi
	ok "panel PHP $v (php-version file, binaries present, master image on disk)"
}

# The MTA the panel actually calls (#872). PHP's mail() runs sendmail_path, so a box without
# that binary loses every notification - password reset, backup report - while the wrapper still
# exits 0. Nothing installed one without a mail block; on Debian the base image happened to ship
# exim4-daemon-light and it looked fine, on Ubuntu it never did.
# The install-time derivation is a one-shot edit; flip the kernel lage later and the
# fatal bind returns with nothing re-deriving. Holds CONFIGURED families against the
# KERNEL's. Covers dovecot listen + exim dc_local_interfaces, not the hestia template
# (immune: exim skips a missing family itself).
# Configured for a family the kernel refuses - the three places WE derive; the distro's own
# "::1 localhost" is deliberately not one of them.
check_family_lage() {
	local kernel6='' hits=0 fqdn
	[ -e /proc/net/if_inet6 ] && kernel6=yes
	if [ -n "$kernel6" ]; then
		ok "family lage: kernel has v6, listed v6 loopbacks cannot be unbindable"
		return
	fi
	if [ -f /etc/dovecot/dovecot.conf ] && grep -qE '^listen *=.*::' /etc/dovecot/dovecot.conf; then
		no "dovecot lists a v6 listener on a v6-less kernel" \
			"listen(::) is fatal at start - drop the v6 half or re-enable kernel v6"
		hits=1
	fi
	if [ -f /etc/exim4/update-exim4.conf.conf ] && grep -q '::1' /etc/exim4/update-exim4.conf.conf; then
		no "exim send-only list names ::1 on a v6-less kernel" \
			"the stock template dies at start on it - rerun the derivation or re-enable kernel v6"
		hits=1
	fi
	# derived once, at hostname time: a box that lost v6 since keeps the line
	fqdn=$(hostname -f 2> /dev/null || hostname 2> /dev/null)
	if [ -n "$fqdn" ] && grep -qE "^::1[[:space:]]+${fqdn//./\\.}$" /etc/hosts 2> /dev/null; then
		no "/etc/hosts names ::1 for $fqdn on a v6-less kernel" \
			"derived when the box still had v6 - re-derive with: h-change-sys-hostname $fqdn"
		hits=1
	fi
	[ "$hits" = 0 ] && ok "family lage: v6-less kernel, no v6 loopback listed (dovecot, exim send-only, /etc/hosts)"
}

# Exim refuses a macro whose name contains an EARLIER macro as substring; this closes
# the class instead of waiting for the next collision.
check_exim_macro_names() {
	local tpl=/etc/exim4/exim4.conf.template names n1 n2 count found=''
	if [ ! -f "$tpl" ] || ! grep -q "HestiaRE\|OUTGOING_IP" "$tpl" 2> /dev/null; then
		skip "exim macro names: no hestia template on this box"
		return
	fi
	names=$(grep -oE '^[A-Z][A-Z0-9_]+ *=' "$tpl" | sed 's/ *=$//')
	# grep -c . not -c "": an empty list must count 0, not claim one checked name
	count=$(echo "$names" | grep -c .)
	if [ "$count" = 0 ]; then
		no "exim macro names: derivation found no macros" \
			"the check would measure nothing - template layout changed under it"
		return
	fi
	# ALL collisions in one pass: reporting only the first hides the second until the
	# first is fixed, and the fix for one is how the next one gets typed
	while read -r n1; do
		while read -r n2; do
			[ "$n1" = "$n2" ] && continue
			case "$n2" in
				*"$n1"*) found="${found:+$found, }$n2>$n1" ;;
			esac
		done <<< "$(echo "$names" | grep -A999 -Fx "$n1" | tail -n +2)"
	done <<< "$names"
	if [ -n "$found" ]; then
		no "exim macro name(s) contain an earlier macro: $found" \
			"exim refuses such definitions - rename them"
		return
	fi
	ok "exim macro names: no name contains an earlier one ($count checked)"
}

# An interface expansion with an empty list element defers EVERY remote delivery, one
# layer past check_notification_mta. exim -be expands the REAL line offline: the no-pin
# case falls out naturally (empty $sender_address_domain), the pin cases run over a temp
# dir in the same expression. Macro substitution is textual - -be resolves expansions,
# not macro names.
check_exim_interface_expansion() {
	local tpl=/etc/exim4/exim4.conf.template expr m4 m6 out probe rc=0
	if [ ! -f "$tpl" ] || ! grep -q '^OUTGOING_IP = ' "$tpl"; then
		skip "exim interface expansion: no hestia template on this box"
		return
	fi
	# The expression lives TWICE (both smtp transports): expanding one is only valid
	# while both are identical, so the identity is part of the check.
	local iface_lines
	iface_lines=$(grep '^  interface = ' "$tpl")
	if [ "$(echo "$iface_lines" | grep -c .)" != 2 ] || [ "$(echo "$iface_lines" | sort -u | grep -c .)" != 1 ]; then
		no "exim interface lines diverged or changed count ($(echo "$iface_lines" | grep -c .) found)" \
			"remote_smtp and remote_forwarded_smtp must carry the SAME line - one drifted"
		return
	fi
	expr=$(echo "$iface_lines" | head -1 | sed 's/^  interface = //')
	m4=$(sed -n 's/^OUTGOING_IP = //p' "$tpl" | head -1)
	m6=$(sed -n 's/^OUTGOING6_IP = //p' "$tpl" | head -1)
	if [ -z "$expr" ] || [ -z "$m4" ] || [ -z "$m6" ]; then
		no "exim interface expansion: derivation broke (line or macros not found)" \
			"the check would measure nothing - template layout changed under it"
		return
	fi
	expr=${expr//OUTGOING6_IP/$m6}
	expr=${expr//OUTGOING_IP/$m4}
	# stdin, not an argument (-be args hit a 256-byte limit); "Failed"/empty-on-error is
	# NOT VERIFIABLE, never a pass.
	_be_expand() {
		printf '%s\n' "$1" | exim4 -be 2>&1 | head -1 | sed 's/^> //'
	}
	_iface_shape_ok() { # rejects any empty list element; empty whole = option unset = fine
		local v="$1" item
		case "$v" in *Failed* | *failed*) return 2 ;; esac
		[ -z "$v" ] && return 0
		case "$v" in "<;"*) ;; *) return 1 ;; esac
		while IFS= read -r item; do
			item="${item#"${item%%[![:space:]]*}"}"
			item="${item%"${item##*[![:space:]]}"}"
			[ -n "$item" ] || return 1
		done <<< "$(echo "${v#<;}" | tr ';' '\n')"
		return 0
	}
	# no-pin case - exactly the break that deferred every mail without pin files
	out=$(_be_expand "$expr")
	_iface_shape_ok "$out"
	case $? in
		1)
			no "exim interface expands to a broken list without pin files: '$out'" \
				"every remote delivery of a domain without conf/mail pins would defer"
			return
			;;
		2)
			no "exim interface expansion not verifiable: '$out'" \
				"the expansion itself errored - fix the check's input, do not trust a green"
			return
			;;
	esac
	# pin cases as positive control: proves the instrument expands for real
	probe=$(mktemp -d)
	local lookup_part='/etc/exim4/domains/${lookup{$sender_address_domain}dsearch{/etc/exim4/domains}}'
	local expr_probe=${expr//"$lookup_part"/$probe}
	echo "192.0.2.9" > "$probe/ip"
	out=$(_be_expand "$expr_probe")
	[ "$out" = "<; 192.0.2.9" ] || rc=1
	echo "2001:db8::9" > "$probe/ipv6"
	out=$(_be_expand "$expr_probe")
	[ "$out" = "<; 192.0.2.9 ; 2001:db8::9" ] || rc=2
	rm -f "$probe/ip"
	out=$(_be_expand "$expr_probe")
	[ "$out" = "<; 2001:db8::9" ] || rc=3
	rm -rf "$probe"
	if [ "$rc" != 0 ]; then
		no "exim interface expansion: with-pin shape $rc broke (got '$out')" \
			"the pinned source address would not reach the transport as built"
		return
	fi
	ok "exim interface expansion: all four shapes clean, no empty list element (offline via -be)"
}

check_notification_mta() {
	local relay='' path bin
	if [ "${USE_SERVER_SMTP:-}" = 'true' ] && [ -n "${SERVER_SMTP_HOST:-}" ]; then
		relay="${SERVER_SMTP_HOST}"
	fi
	# The path PHP will use, not a guess: an ini override moves it, and then our answer is wrong.
	path=$("$HESTIA/sbin/hestia-php" -r 'echo ini_get("sendmail_path");' 2> /dev/null)
	bin=${path%% *}
	[ -n "$bin" ] || bin=/usr/sbin/sendmail
	if [ -x "$bin" ]; then
		ok "notification MTA present ($bin)"
	elif [ -n "$relay" ]; then
		skip "notification MTA: no local $bin, mail goes through the SMTP relay $relay"
	else
		no "no notification MTA: $bin is missing" \
			"panel and CLI mail is lost and still reports success - install one, or set an SMTP relay"
	fi
}

# nomail's send-only promise (#192) is two config keys that a silent sed miss can
# skip: assert them on every box that carries exim but no mail block, and prove the
# listener side from the socket table rather than the config.
check_exim_sendonly() {
	local c=/etc/exim4/update-exim4.conf.conf gen=/var/lib/exim4/config.autogenerated
	if [ -n "$MAIL_SYSTEM" ]; then
		return # full mail stack: its own service checks carry it
	fi
	# Said out loud instead of returning (#872): a missing input file used to read as "not this
	# box's contract" and the check vanished from the output - on a nomail box that absence IS
	# the defect, and check_notification_mta is the one that says so.
	if [ ! -f "$c" ]; then
		skip "exim send-only: $c absent, routing not verifiable here"
		return
	fi
	# measure the EFFECT on both halves: the generated config (did the generator
	# run over the internet type - a hand-edited input without regeneration keeps
	# exim on local-only) and the live socket table, never the input file alone
	if [ ! -f "$gen" ] || ! grep -q '^dnslookup:' "$gen"; then
		no "exim send-only routing" "generated config carries no dnslookup router - remote delivery is off (regenerate: update-exim4.conf)"
		return
	fi
	# runtime vs disk (the #191 master-image pattern): a daemon started before the
	# regeneration still carries the old config in memory. Narrow but real: the
	# per-message exim spawn reads disk, the stale daemon owns the queue retries.
	local started gen_m
	started=$(date -d "$(systemctl show -p ActiveEnterTimestamp --value exim4 2> /dev/null)" +%s 2> /dev/null)
	gen_m=$(stat -c %Y "$gen" 2> /dev/null)
	if [ -n "$started" ] && [ -n "$gen_m" ] && [ "$gen_m" -gt "$started" ]; then
		no "exim daemon predates its generated config" "restart exim4 to load it (queue retries run on the old one)"
		return
	fi
	if ! command -v ss > /dev/null 2>&1; then
		no "exim send-only listeners" "ss not available - the listener half is NOT verifiable, not clean"
		return
	fi
	local l25
	l25=$(ss -lnt 2> /dev/null | grep -E ':25 ')
	if [ -z "$l25" ]; then
		no "exim send-only listeners" "nothing listens on port 25 at all - the local submission path is gone"
		return
	fi
	if printf '%s' "$l25" | grep -vqE '127\.0\.0\.1|\[::1\]'; then
		no "exim send-only listeners" "port 25 listens beyond loopback on a nomail box"
		return
	fi
	ok "exim send-only (dnslookup router generated, loopback listeners live)"
}

# Project quota (#211): the key against measured enforcement, same probe the
# installer wrote it from. Never quotaon -pP as oracle (prints "on" without
# enforcing, exits 1 when good, localizes).
check_project_quota() {
	local state="${PROJECT_QUOTA%%:*}" reason="${PROJECT_QUOTA#*:}"
	case "$state" in
		active)
			if quota_home_fs && quota_enforce_probe "$QUOTA_MNT"; then
				ok "project quota enforcing on ${QUOTA_MNT:-/home} (probe with positive control)"
			else
				no "project quota" "key says active but the probe failed: ${QUOTA_PROBE_REASON:-mount unresolved} - enforcement drifted (fstab/GRUB edit, migration?)"
			fi
			;;
		pending)
			# pending:reboot is the expected state before the demanded install
			# reboot - a FAIL there trains people to ignore fails
			if [ "$reason" = 'reboot' ]; then
				skip "project quota: armed, waiting for the install reboot (pending is not verified)"
			else
				no "project quota stuck pending" "arming failed: ${reason} - see /run/hestia-quota-arm.status; h-update-sys-quota re-arms once the cause is fixed"
			fi
			;;
		*)
			skip "project quota: not enforced on this box (${PROJECT_QUOTA:-key unset}; h-update-sys-quota re-arms once the cause is fixed)"
			;;
	esac
}

# Customer PHP CPU cap (#212): the ENFORCED value from the cgroup, never the systemd property -
# the property reads the drop-in the moment it is written, so a fleet of masters still running in
# system.slice reports itself capped. The boot step deliberately does not abort a boot, so nothing
# else would notice a cap that never got computed.
#
# Not covered: whether the cap is the right size - a hand-set value is reported, not judged.
# Panel port (#730): the site it listens on against the value the firewall and proxies follow.
check_panel_port() {
	local want="${BACKEND_PORT:-8083}" live owner
	local n
	n=$(reserved_ports | awk '{print $1}' | sort -u | wc -l)
	if [ "${n:-0}" -eq 0 ]; then
		no "reserved-port scan found no listener declaration under $HESTIA" \
			"the derivation broke - every port would now pass validation unchecked"
		return
	fi
	# The count, without a verdict: an exclusion that eats too much shrinks the set silently.
	ok "reserved port set: $n ports derived from the shipped configs"
	if owner=$(reserved_port_owner "$want"); then
		no "panel port $want is reserved for $owner" "two services want the same port; h-change-sys-port <free port>"
	fi
	live=$(sed -n 's|^[[:space:]]*https\?://:\([0-9]\{2,5\}\).*|\1|p' /etc/caddy/hestia.conf 2> /dev/null | head -n1)
	if [ -z "$live" ]; then
		no "panel site declares no port (/etc/caddy/hestia.conf)" "the panel listener is unreadable - check the site file"
	elif [ "$live" != "$want" ]; then
		no "panel listens on $live, BACKEND_PORT says $want" \
			"firewall rule and phpMyAdmin proxy follow $want - re-run: h-change-sys-port $want"
	else
		ok "panel port $want consistent (caddy site, BACKEND_PORT)"
	fi
}

check_customer_php_slice() {
	local versions uncapped='' seen=0 ver cores cpu_max quota period pct conf
	versions=$(customer_php_versions)
	if [ -z "$versions" ]; then
		skip "customer PHP cap: no customer php-fpm on this box"
		return
	fi

	for ver in $versions; do
		[ "$(systemctl is-active "php$ver-fpm" 2> /dev/null)" = 'active' ] || continue
		seen=$((seen + 1))
		customer_php_in_slice "$ver" || uncapped="$uncapped php$ver-fpm"
	done
	# Counted, not inferred from an empty list: with no master running, $uncapped stays empty and
	# the branch below would report every master capped having looked at none. Returning instead
	# of falling through, because the slice then has no cgroup either and the cap branch would
	# add "nothing is capped" - true, useless, and reading like a contradiction. That FPM is down
	# is check_service's sentence to say, once.
	if [ "$seen" -eq 0 ]; then
		skip "customer PHP cap: no customer php-fpm master is running (nothing to place, nothing to cap)"
		return
	fi
	if [ -z "$uncapped" ]; then
		ok "customer php-fpm masters run in $CUSTOMER_PHP_SLICE ($seen checked)"
	else
		no "customer php-fpm outside the cap:$uncapped" "customer load can starve panel, mail and ssh; systemctl restart $CUSTOMER_PHP_LIMIT_UNIT"
	fi

	cpu_max=$(customer_php_cpu_max)
	cores=$(nproc --all 2> /dev/null)
	# Same reader as the boot script, range check included: a value the script refuses must not
	# be reported here as the configured one.
	if customer_php_percent; then
		conf="${CUSTOMER_PHP_PERCENT}%"
	else
		conf="${CUSTOMER_PHP_PERCENT}% - the file says '$CUSTOMER_PHP_PERCENT_RAW', which is refused"
	fi
	quota=${cpu_max%% *}
	period=${cpu_max##* }
	if [ -z "$cpu_max" ]; then
		# Measured: with the quota gone systemd drops the cpu controller from the subtree, so
		# cpu.max is missing rather than "max" - and an inactive slice has no directory at all.
		# Both mean the same thing here, and neither says anything about membership.
		no "customer PHP slice carries no CPU limit (cpu.max absent)" \
			"nothing is capped - systemctl restart $CUSTOMER_PHP_LIMIT_UNIT, then read its status"
	elif [ "$quota" = 'max' ]; then
		no "customer PHP cap not applied (cpu.max: $cpu_max)" \
			"nothing is capped - systemctl restart $CUSTOMER_PHP_LIMIT_UNIT, then read its status"
	else
		# Back to a share of the machine, which is what the config file promises.
		pct=$((quota * 100 / period / ${cores:-1}))
		ok "customer PHP cap enforced: cpu.max $cpu_max = ${pct}% of ${cores:-?} cores (configured $conf)"
	fi
}

# The curated CLI conf.d is a hand-kept list against moving code (#193 found gettext
# missing three layers deep): send the wrapper through web/inc/i18n.php once - the
# exact include chain mail-wrapper takes - so a missing extension fails HERE, loudly.
check_panel_cli_i18n() {
	if "$HESTIA/sbin/hestia-php" -r "require '$HESTIA/web/inc/i18n.php';" > /dev/null 2>&1; then
		ok "panel CLI carries the mail-wrapper i18n chain (gettext loaded)"
	else
		no "panel CLI cannot load web/inc/i18n.php" "notification mail dies at bindtextdomain - re-run hestia-php-confd (cli set)"
	fi
}

check_panel_locale() {
	local pool=/etc/php/hestia/fpm/pool.d/panel.conf want
	if [ ! -f "$pool" ]; then
		no "panel FPM locale" "$pool missing - nothing pins env[LANG]"
		return
	fi
	want=$(sed -n 's/^env\[LANG\][[:space:]]*=[[:space:]]*//p' "$pool" | tail -n1)
	if [ -z "$want" ]; then
		no "panel FPM locale" "no env[LANG] in $pool - the child inherits whatever is around"
		return
	fi
	if locale -a 2> /dev/null | grep -qiFx "$(echo "$want" | tr -d '-' | tr '[:upper:]' '[:lower:]')"; then
		ok "panel FPM locale $want is generated"
	else
		no "panel FPM locale $want is NOT generated" "children warn on every locale-aware call"
	fi
}

# check_sbin_not_under_bin - nothing may invoke an sbin command through a bin/ path. The sbin split
# (#209) moved the panel-PHP wrappers and the lifecycle commands out of the sudo wildcard's reach;
# callers referencing them as "$BIN/x" kept resolving to a file that is no longer there, and the
# breakage only shows when that code path runs (a fresh install died on $BIN/hestia-php-confd).
# The set is derived from what actually IS in sbin/, so a later move needs no edit here, and an
# empty sbin/ fails rather than silently agreeing with nothing.
# NOT covered: bare "bin/x" in prose/comments (deliberate - only invocation forms are checked), and
# any path assembled at runtime from a variable this cannot see.
check_sbin_not_under_bin() {
	local names hit
	names=$(find "$HESTIA/sbin" -maxdepth 1 -type f -printf '%f\n' 2> /dev/null | grep -v '\.json$' | paste -sd'|')
	if [ -z "$names" ]; then
		no "sbin commands never invoked via bin/" "sbin/ is empty or unreadable"
		return
	fi
	hit=$(grep -rnE "(\\\$BIN|\\\$HESTIA/bin|/usr/local/hestia/bin)/($names)([\"'[:space:]]|\$)" \
		"$HESTIA/bin" "$HESTIA/sbin" "$HESTIA/func" "$HESTIA/web" "$HESTIA/share" 2> /dev/null \
		| grep -vE ':[[:space:]]*(//|#|\*|;)')
	if [ -z "$hit" ]; then
		ok "sbin commands never invoked via bin/"
	else
		no "sbin commands never invoked via bin/" "$(echo "$hit" | head -n1)"
	fi
}

# check_policy_fragment_coverage — a per-domain POLICY fragment (CrowdSec Layer A, bot rate limiting)
# must be in EVERY customer-domain template of its web system: it applies to all traffic, so a template
# missing one is a silent bypass (switch to the wordpress template, escape the throttle, nothing fails).
# Feature fragments (ssl/hsts/forcessl/fastcgi_cache) are NOT checked - they belong only to the
# templates implementing them. Scope = templates carrying %domain%, so the per-IP catch-all is skipped.
check_policy_fragment_coverage() {
	local f frag miss=0 first="" checked=0
	# By file, not by service directory: a vhost template can live anywhere under the two
	# roots (share/web/suspend/ does), and scanning fixed subdirs would quietly skip it.
	# The pool templates under templates/php carry %domain% but are not vhosts.
	while read -r f; do
		[ -n "$f" ] || continue
		# Decided by content: a vhost declares either a VirtualHost or a server block.
		# Keying on the path would break the moment a directory is renamed - which is
		# exactly what just happened - and silently shrink the guard.
		if grep -q '^[[:space:]]*<VirtualHost' "$f"; then
			set -- botlimit.apache2.conf
		elif grep -qE '^[[:space:]]*server[[:space:]]*\{' "$f"; then
			set -- nginx.crowdsec.conf nginx.botlimit.conf
		else
			continue
		fi
		checked=$((checked + 1))
		for frag in "$@"; do
			grep -q "$frag" "$f" && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="${f#"$HESTIA/"} lacks $frag"
		done
	done < <(grep -rl '%domain%' "$WEBTPL" "$SHARETPL" 2> /dev/null | grep -E '\.(tpl|stpl)$')
	if [ "$miss" -eq 0 ]; then
		ok "policy fragment includes complete ($checked domain templates)"
	else
		no "$miss policy fragment include(s) missing from web templates" "$first"
	fi
}

# check_sudoers <file> <label> — file parses under the running sudo. One rejected
# setting (e.g. requiretty under sudo-rs, ub26) makes sudo drop the WHOLE file.
check_sudoers() {
	if [ ! -f "$1" ]; then
		no "sudoers $2 ($1) missing"
		return
	fi
	if visudo -cf "$1" > /dev/null 2>&1; then
		ok "sudoers $2 ($1) valid"
	else
		no "sudoers $2 ($1) invalid" "$(visudo -cf "$1" 2>&1 | tail -1)"
	fi
}

# check_web_cache_zones - a cache flag whose zone is gone breaks nginx -t box-wide: the
# vhost references a zone nginx never loaded.
check_web_hsts_effective() {
	local u d line hsts front conf miss=0 first='' checked=0
	front="${PROXY_SYSTEM:-$WEB_SYSTEM}"
	[ -n "$front" ] || {
		skip "no web front - hsts guard not checkable"
		return
	}
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			case "$line" in *"SSL_HSTS='yes'"*) ;; *) continue ;; esac
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			checked=$((checked + 1))
			conf="$HOMEDIR/$u/conf/web/$d/$front.hsts.conf"
			# Two ways to be switched on and still send nothing: no fragment for this front, or a
			# fragment carrying the other server's directive (#638).
			hsts='ok'
			[ -s "$conf" ] || hsts='missing'
			if [ "$hsts" = 'ok' ]; then
				case "$front" in
					apache2) grep -q '^Header' "$conf" || hsts='wrong syntax' ;;
					*) grep -q '^add_header' "$conf" || hsts='wrong syntax' ;;
				esac
			fi
			[ "$hsts" = 'ok' ] && continue
			miss=$((miss + 1))
			[ -z "$first" ] && first="$d: $hsts ($front)"
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "hsts switches have a fragment the front can read ($checked on)"
	else
		no "$miss domain(s) claim hsts without an effective fragment" "$first"
	fi
}

check_web_cache_zones() {
	local u d line miss=0 first="" checked=0
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			# Same role gating as the rebuild reapply: after a switch to a proxyless model the
			# flag stays recorded (inert) and MUST NOT count as a missing zone
			if [[ "$line" == *"PROXY_CACHE='yes'"* ]] && [ "$PROXY_SYSTEM" = 'nginx' ]; then
				checked=$((checked + 1))
				if [ ! -f "/etc/nginx/conf.d/cache-zone.$d.conf" ]; then
					miss=$((miss + 1))
					[ -z "$first" ] && first="proxy zone missing: $u/$d"
				fi
			fi
			if [[ "$line" == *"FASTCGI_CACHE='yes'"* ]] && [ "$WEB_SYSTEM" = 'nginx' ]; then
				checked=$((checked + 1))
				if ! grep -qF "keys_zone=$d:" /etc/nginx/conf.d/fastcgi_cache_pool.conf 2> /dev/null; then
					miss=$((miss + 1))
					[ -z "$first" ] && first="fastcgi zone missing: $u/$d"
				fi
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "cache zones match their flags ($checked flag(s))"
	else
		no "$miss cache zone(s) missing for enabled flags" "$first"
	fi
}

# check_web_http3_orphan - a quic listen fragment (nginx.ssl.conf_http3, #613) on a box whose nginx
# lacks http_v3 fails nginx -t box-wide. The switch is capability-gated at write and the rebuild
# reconciles it off, so one surviving here means the nginx package changed under a live install, or
# a fragment was placed out of band. A recorded HTTP3='yes' WITHOUT a fragment is fine and NOT
# flagged - that is intent kept for a later move onto a capable host.
check_web_http3_orphan() {
	local u frag d stray=0 first="" checked=0
	# where nginx can do http3 a fragment is correct, so there is nothing to police
	if nginx_has_http3; then
		ok "http3 fragments match the nginx build (http_v3 present)"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		for frag in "$HOMEDIR/$u"/conf/web/*/nginx.ssl.conf_http3; do
			[ -f "$frag" ] || continue
			checked=$((checked + 1))
			stray=$((stray + 1))
			d=$(basename "$(dirname "$frag")")
			[ -z "$first" ] && first="quic fragment on a box without http_v3: $u/$d"
		done
	done
	if [ "$stray" -eq 0 ]; then
		ok "no quic fragment on a box whose nginx lacks http_v3"
	else
		no "$stray quic fragment(s) on a box whose nginx has no http_v3" "$first"
	fi
}

# check_web_docker_wildcard - the add-command's wildcard check is a snapshot: a customer can bind
# 0.0.0.0 tomorrow, or an addon can take a new wildcard port. The docker domain then keeps its
# port, the customer bind silently fails and the outage shows at the NEIGHBOUR, not the causer
# (measured, #566). This is the standing counterpart: no wildcard listener may hold a port a
# docker domain proxies to.
check_web_docker_wildcard() {
	local u line d port hit=0 first="" checked=0 wildcards
	wildcards=$(ss -ltnH 2> /dev/null | awk '{print $4}' \
		| grep -E '^(0\.0\.0\.0|\*|\[::\]):' | grep -oE '[0-9]+$' | sort -u)
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			grep -q "DOCKER='[^']" <<< "$line" || continue
			port=$(sed -n "s/.*DOCKER_PORT='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$port" ] || continue
			checked=$((checked + 1))
			if grep -qxF "$port" <<< "$wildcards"; then
				hit=$((hit + 1))
				d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
				[ -z "$first" ] && first="wildcard listener holds docker port $port ($u/$d)"
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$hit" -eq 0 ]; then
		ok "no wildcard listener on a docker domain port ($checked checked)"
	else
		no "$hit docker domain port(s) held by a wildcard listener" "$first"
	fi
}

# check_vhost_nonempty - a 0-byte vhost passes apache2 -t and the domain silently falls
# through to the box default vhost.
check_vhost_nonempty() {
	local f n=0 miss=0 first=""
	for f in "/etc/$WEB_SYSTEM/conf.d/domains"/*.conf "/etc/${PROXY_SYSTEM:-none}/conf.d/domains"/*.conf; do
		[ -e "$f" ] || continue
		n=$((n + 1))
		if [ ! -s "$f" ]; then
			miss=$((miss + 1))
			[ -z "$first" ] && first="$f is empty"
		fi
	done
	if [ "$miss" -eq 0 ]; then
		ok "no empty vhost configs ($n checked)"
	else
		no "$miss empty vhost config(s)" "$first"
	fi
}
# check_vhost_upstream_host - "http://:3000" (docker domain, owner without DOCKER_IP) makes nginx
# and apache reject the whole configuration. Read the rendered files: a custom template does it too.
# Two silent ways a vhost can be wrong: an UNBRACKETED v6 (nginx reads it as its own address,
# apache refuses to parse it), and an nginx server block with NO listen - not an error but a
# WILDCARD bind, which is what a %ip%-only custom template renders to on a v6-only box.
# Covers the vhosts plus the per-domain http3 fragments; a brace inside a string would miscount,
# so the number of blocks entered is part of the verdict.
check_vhost_listen_form() {
	local f n=0 blocks=0 bare=0 nolisten=0 first="" second="" c out
	for f in "/etc/$WEB_SYSTEM/conf.d/domains"/*.conf "/etc/${PROXY_SYSTEM:-none}/conf.d/domains"/*.conf \
		"$HOMEDIR"/*/conf/web/*/*conf_http3; do
		[ -e "$f" ] || continue
		n=$((n + 1))
		c=$(awk '
			/^[ \t]*(listen|Listen)[ \t]/ || /^[ \t]*<VirtualHost/ {
				line = $0
				sub(/^[ \t]*(listen|Listen)[ \t]+/, "", line)
				sub(/^[ \t]*<VirtualHost[ \t]+/, "", line)
				sub(/>.*$/, "", line)
				sub(/;.*$/, "", line)
				k = split(line, t, /[ \t]+/)
				for (i = 1; i <= k; i++) {
					if (gsub(/:/, ":", t[i]) >= 2 && index(t[i], "[") == 0) bad++
				}
			}
			END { print bad + 0 }' "$f")
		if [ "${c:-0}" -gt 0 ]; then
			bare=$((bare + c))
			[ -z "$first" ] && first="$f carries an unbracketed v6 address"
		fi
		case "$f" in
			/etc/nginx/*)
				# brace may sit on the next line; a comment cannot open a block
				out=$(awk '
					{
						line = $0
						sub(/#.*/, "", line)
						if (!inblock) {
							if (line ~ /^[ \t]*server[ \t]*\{/) { inblock = 1; depth = 0; seen = 0 }
							else if (line ~ /^[ \t]*server[ \t]*$/) { pending = 1; next }
							else if (pending && line ~ /\{/) { inblock = 1; depth = 0; seen = 0; pending = 0 }
							else next
						}
						depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
						if (line ~ /^[ \t]*listen[ \t]/) seen = 1
						if (depth <= 0) { blocks++; if (!seen) bad++; inblock = 0 }
					}
					END { print blocks + 0, bad + 0 }' "$f")
				blocks=$((blocks + ${out%% *}))
				c=${out##* }
				if [ "${c:-0}" -gt 0 ]; then
					nolisten=$((nolisten + c))
					[ -z "$second" ] && second="$f has a server block without a listen line - it binds the wildcard"
				fi
				;;
		esac
	done
	if [ "$n" -eq 0 ]; then
		skip "vhost listen form (no rendered web vhost on this box - a mail-only box has none)"
		return
	fi
	[ "$bare" -eq 0 ] || no "$bare unbracketed v6 address(es) in rendered vhosts" "$first"
	[ "$nolisten" -eq 0 ] || no "$nolisten nginx server block(s) without a listen line" "$second - a custom template with only %ip% renders to this on a v6-only box"
	{ [ "$bare" -eq 0 ] && [ "$nolisten" -eq 0 ]; } \
		&& ok "rendered vhosts: every v6 address bracketed, every server block bound ($n file(s), $blocks nginx server block(s) entered)"
}

check_vhost_upstream_host() {
	local f n=0 hit=0 first=""
	for f in "/etc/$WEB_SYSTEM/conf.d/domains"/*.conf "/etc/${PROXY_SYSTEM:-none}/conf.d/domains"/*.conf; do
		[ -e "$f" ] || continue
		n=$((n + 1))
		if grep -qE '://:[0-9]+' "$f"; then
			hit=$((hit + 1))
			[ -z "$first" ] && first="$f proxies to a port without a host"
		fi
	done
	if [ "$hit" -eq 0 ]; then
		ok "no vhost proxies to a hostless upstream ($n checked)"
	else
		no "$hit vhost(s) proxy to a hostless upstream" "$first"
	fi
}
# check_error_code_registry - the exit codes live twice, in the shell and in the panel, and nothing
# holds them together. Known alias: E_FORBIDEN/E_FORBIDDEN share 10 on purpose.
check_error_code_registry() {
	local sh_file="$HESTIA/include/main.sh" php_file="$HESTIA/web/inc/helpers.php"
	local name val conflict=0 dupes=0 n=0 first=""
	if [ ! -f "$sh_file" ] || [ ! -f "$php_file" ]; then
		skip "error code registries not both present"
		return
	fi
	declare -A _sh=() _php=() _seen=()
	while IFS='=' read -r name val; do
		_sh[$name]=$val
		n=$((n + 1))
	done < <(grep -oE '^E_[A-Z_]+=[0-9]+' "$sh_file")
	while read -r name val; do
		_php[$name]=$val
	done < <(sed -n 's/^const \(E_[A-Z_]*\) *= *\([0-9]*\);.*/ /p' "$php_file")
	for name in "${!_sh[@]}"; do
		[ -n "${_php[$name]:-}" ] || continue
		if [ "${_sh[$name]}" != "${_php[$name]}" ]; then
			conflict=$((conflict + 1))
			[ -z "$first" ] && first="$name is ${_sh[$name]} in the shell and ${_php[$name]} in the panel"
		fi
	done
	for name in "${!_php[@]}"; do
		case "$name" in E_FORBIDEN | E_FORBIDDEN) continue ;; esac
		val=${_php[$name]}
		if [ -n "${_seen[$val]:-}" ]; then
			dupes=$((dupes + 1))
			[ -z "$first" ] && first="${_seen[$val]} and $name both use $val in the panel"
		fi
		_seen[$val]=$name
	done
	if [ "$conflict" -eq 0 ] && [ "$dupes" -eq 0 ]; then
		ok "error codes agree between shell and panel ($n shell codes)"
	else
		no "$((conflict + dupes)) error code(s) out of step" "$first"
	fi
}
# check_eval_sites - two named files used to be guarded one by one, which is a list nobody measures:
# a new eval in a third file would have gone unseen. Derived instead - every eval used as a command
# in bin/h-* and include/*.sh is found, and only the two that have a reason may remain.
#
# Whole-line comments are dropped BEFORE the search so the search can stay broad. Command position
# is more than line start, ; & and |: `then eval`, `do eval` and `else eval` sit in it too, and the
# narrow pattern that was here first missed all three - the very blind spot a hand-kept list has.
# A trailing # is never stripped (it is not a comment in $#, ${v#p}, heredocs), so a comment that
# writes "eval " can still match. That direction is a loud false positive; the other one is the hole
# this guard exists to close.
#
# Does NOT cover: sbin/, web/, share/, and eval reached through a variable or an alias.
check_eval_sites() {
	local allowed="h-add-web-domain-ssl main.sh" f base extra='' hit='' miss='' scanned=0 carry=0
	for f in "$HESTIA/bin"/h-* "$HESTIA/include"/*.sh; do
		[ -f "$f" ] || continue
		scanned=$((scanned + 1))
		sed '/^[[:space:]]*#/d' "$f" | grep -qE '(^|[^[:alnum:]_])eval[[:space:]]' || continue
		carry=$((carry + 1))
		base=$(basename "$f")
		hit="$hit $base"
		case " $allowed " in *" $base "*) continue ;; esac
		extra="$extra $base"
	done
	# Both known sites must still turn up. A sweep that looked at nothing, or one that lost sight of
	# a site it used to see, shrank its reference set - which is worse than no guard, because green
	# then means "looked at less" instead of "found nothing".
	for base in $allowed; do
		case " $hit " in *" $base "*) ;; *) miss="$miss $base" ;; esac
	done
	if [ "$scanned" -lt 400 ]; then
		no "the eval-sweep scanned only $scanned file(s)" "expected all of $HESTIA/bin/h-* and $HESTIA/include/*.sh"
	elif [ -n "$extra" ]; then
		no "eval-use over record text outside the two known places" "$extra"
	elif [ -n "$miss" ]; then
		no "a known eval-site stopped matching - sweep or file changed" "$miss"
	else
		ok "no new eval-sites ($carry of $scanned scanned file(s) carry one, both known)"
	fi
}

# check_record_name_patterns - a record name goes into grep and sed as a PATTERN, and an archive or
# domain name carries dots, which match any character. #583 swept that class once; it came back at
# the backup record sites (#819), so the reference set is derived here instead of remembered: every
# grep or sed in bin/ and include/ whose pattern splices a shell variable next to BACKUP=' or
# DOMAIN=' must either use -F or escape through ${v//./\\.}.
#
# Does NOT cover: the KEY='$var' shape is all it recognises - h-backup-user splices a bare
# "$user.$stamp.tar" with no key in front, which this pattern cannot see without flagging half the
# tree. Nor patterns in web/ or share/, a name reached through an intermediate variable, or
# characters other than the dot (* ? [ ] are equally special; no record name has carried one yet).
check_record_name_patterns() {
	local scanned=0 bad='' f hits
	for f in "$HESTIA/bin"/h-* "$HESTIA/include"/*.sh; do
		[ -f "$f" ] || continue
		scanned=$((scanned + 1))
		hits=$(sed '/^[[:space:]]*#/d' "$f" \
			| grep -nE "(grep|sed)[^|]*(^|[^A-Z_])(BACKUP|DOMAIN)='\\\$" \
			| grep -v -- '-[a-zA-Z]*F' | grep -v '//\./' || true)
		[ -n "$hits" ] && bad="$bad $(basename "$f")"
	done
	if [ "$scanned" -lt 400 ]; then
		no "the record-pattern sweep scanned only $scanned file(s)" "expected all of $HESTIA/bin/h-* and $HESTIA/include/*.sh"
	elif [ -n "$bad" ]; then
		no "a record name is spliced into a pattern unescaped" "$bad - use grep -F or \${v//./\\.}"
	else
		ok "record names reach grep and sed escaped or literal ($scanned file(s) scanned)"
	fi
}

# check_yescrypt_hashing - the panel login of every account whose /etc/shadow entry is yescrypt runs
# through mkpasswd from the whois package, and yescrypt is the PAM default on all four targets. If
# the binary is gone or its libcrypt cannot do yescrypt, NOBODY logs in and the panel says "invalid
# password" - a total outage wearing the mask of a typo. So this asks by doing the thing the login
# does: hash a known string, then reproduce it from its own setting, which is the exact comparison
# h-check-user-password makes against the shadow entry.
#
# Does NOT cover md5/sha-512/des accounts - those go through h-generate-password-hash (perl crypt).
check_yescrypt_hashing() {
	local ref again setting probe='hestia-smoke-probe'
	if ! command -v mkpasswd > /dev/null 2>&1; then
		no "mkpasswd is missing - no yescrypt account can log in" "the whois package provides it"
		return
	fi
	ref=$(mkpasswd -m yescrypt "$probe" 2> /dev/null)
	case "$ref" in
		'$y$'*) ;;
		*)
			no "mkpasswd cannot produce a yescrypt hash" "it returned '${ref:-nothing}' - check libcrypt"
			return
			;;
	esac
	setting="${ref%\$*}\$"
	again=$(mkpasswd "$probe" "$setting" 2> /dev/null)
	if [ "$again" != "$ref" ]; then
		no "yescrypt hashing does not reproduce from its own setting" "every panel login would be refused"
	else
		ok "yescrypt hashing works and reproduces from its setting"
	fi
}

# check_protected_names - the floor that stops a record from binding PATH or BIN (#807). Two ways
# it could go green while protecting nothing: the list empties, or a name in it is also a real
# config key, in which case the floor locks that key out of every conf. Both are checked here, and
# the second is checked against the key registries rather than a second hand-kept list.
check_protected_names() {
	local n bad=0 first="" reg regs nregs
	regs="web mail mail_accounts user cron db system ip backup_excludes"
	nregs=$(wc -w <<< "$regs")
	n=$(wc -w <<< "$SOURCE_CONF_PROTECTED")
	if [ "${n:-0}" -lt 10 ]; then
		no "protected name list is empty or short ($n)" "SOURCE_CONF_PROTECTED in include/main.sh"
		return
	fi
	for reg in $regs; do
		for name in $(syshealth_known_keys "$reg"); do
			is_protected_key "$name" || continue
			bad=$((bad + 1))
			[ -z "$first" ] && first="$name is both a $reg key and a protected name"
		done
	done
	# Derived from the data, not from the compiled lists: a name can be a config key without being
	# in any registry (BACKUP_TEMP was, and the floor swallowed it in silence). If a conf on this
	# box carries a protected name as a key, the floor is dropping something real.
	local pat live
	pat="^($(tr -s ' \n' '||' <<< "$SOURCE_CONF_PROTECTED" | sed -e 's/^|//' -e 's/|$//'))="
	live=$(grep -lE "$pat" "$HESTIA/conf"/*.conf "$CONF_DIR/users"/*/user.conf \
		"$CONF_DIR/users"/*/backup-excludes.conf "$CONF_DIR/packages"/*.pkg "$CONF_DIR/ips"/* \
		2> /dev/null | head -3 | tr '\n' ' ')
	if [ "$bad" -gt 0 ]; then
		no "$bad protected name(s) collide with a real config key" "$first"
	elif [ -n "$live" ]; then
		no "a protected name is used as a key in a live config" "$live"
	else
		ok "protected names hold and collide with no config key ($n names, $nregs registries)"
	fi
}
# check_record_only_protected - RECORD_ONLY_PROTECTED carries names source_conf MUST accept (they
# are honest hestia.conf / restic.conf keys) while the record parser must refuse them. Floor and
# list differ only in WHERE a name is allowed, so the question this asks is: does one of them ever
# appear as a key in a RECORD? BACKUP is deliberately absent from the list because it is one.
#
# Does NOT cover records inside an archive - refusing those is the parser's job, not this check's.
check_record_only_protected() {
	local n names f reads=0 bad='' pat
	names="$RECORD_ONLY_PROTECTED"
	n=$(wc -w <<< "$names")
	if [ "${n:-0}" -lt 1 ]; then
		no "the record-only protected list is empty" "RECORD_ONLY_PROTECTED in include/main.sh"
		return
	fi
	pat="^[[:space:]]*($(tr -s ' \n' '||' <<< "$names" | sed -e 's/^|//' -e 's/|$//'))="
	for f in "$CONF_DIR/users"/*/*.conf "$CONF_DIR/users"/*/mail/*.conf "$CONF_DIR/packages"/*.pkg; do
		[ -f "$f" ] || continue
		# Positive control per file: it must yield a key at all. Without it a clean result is
		# indistinguishable from a sweep that read nothing.
		if grep -qE '^[A-Z][A-Z0-9_]*=' "$f"; then
			reads=$((reads + 1))
		fi
		if grep -qE "$pat" "$f"; then
			bad="$bad $(basename "$(dirname "$f")")/$(basename "$f")"
		fi
	done
	if [ "$reads" -eq 0 ]; then
		no "the record sweep read no key from any record file" "looked under $CONF_DIR/users and $CONF_DIR/packages"
	elif [ -n "$bad" ]; then
		no "a record-only protected name is used as a record key" "$bad"
	else
		ok "record-only names appear in no record ($n names, $reads record file(s) read)"
	fi
}
# check_install_root_owner - the invariant measured for #974: nothing under the install root belongs
# to anyone but root, nothing is group- or world-writable. The runtime directories a panel pool needs
# (session.save_path, upload_tmp_dir, sys_temp_dir) are read from the FPM configuration, never written
# here as a literal, so the check heals itself when such a directory moves out of the tree. Symlinks
# are skipped, their targets live elsewhere. A scan that saw almost nothing is red, not green.
check_install_root_owner() {
	local allowed p hits n bad
	allowed=$(grep -hoE '^ *(php_(admin_)?value\[)?(session\.save_path|upload_tmp_dir|sys_temp_dir)\]? *= *"?[^" ]+' \
		/etc/php/hestia/fpm/php.ini /etc/php/hestia/fpm/pool.d/*.conf 2> /dev/null | sed 's/.*= *"\?//' | sort -u)
	n=$(find "$HESTIA" -xdev ! -type l 2> /dev/null | wc -l)
	if [ "${n:-0}" -lt 100 ]; then
		no "install root: the scan saw only $n entries under $HESTIA"
		return
	fi
	hits=$(find "$HESTIA" -xdev ! -type l \( ! -user root -o -perm /022 \) -printf '%p\n' 2> /dev/null)
	for p in $allowed; do
		case "$p" in "$HESTIA"/*) hits=$(printf '%s\n' "$hits" | grep -vE "^$p(/|$)") ;; esac
	done
	bad=$(printf '%s\n' "$hits" | grep -c .)
	if [ "$bad" -gt 0 ]; then
		no "install root: $bad path(s) not root-owned or group/world-writable" "$(printf '%s\n' "$hits" | grep . | head -n3 | tr '\n' ' ')"
	else
		ok "install root: $n entries, nothing writable by anyone but root (pool runtime dirs from the FPM config:$(printf ' %s' $allowed))"
	fi
}

# check_secret_file_modes - the files whose mode means something (#974): the sudoers rule (440 root:root,
# what deploy_hestia_sudoers installs), and every private key the panel or a customer holds - the panel
# certificate under /etc/ssl/hestia, the mail SNI links under /etc/exim4/ssl (resolved), the customers'
# keys under /etc/hestia/users/*/ssl and /home/*/conf/{web,mail}/*/ssl. Rule for keys: no world bit at
# all; group access is by design (root:mail 660, exim reads them). The set is found, not listed; a box
# without a single key says so as a skip with the count, never as a pass.
check_secret_file_modes() {
	local bad='' sudoers=/etc/sudoers.d/hestia keys k m n
	if [ -f "$sudoers" ]; then
		m=$(stat -c '%a %U:%G' "$sudoers")
		[ "$m" = "440 root:root" ] || bad="$bad sudoers($m)"
	else
		bad="$bad sudoers(missing)"
	fi
	keys=$(find /etc/ssl/hestia /etc/exim4/ssl /etc/hestia/users/*/ssl /home/*/conf/web/*/ssl /home/*/conf/mail/*/ssl \
		-maxdepth 1 \( -name '*.key' -o -name '*.pem' \) 2> /dev/null | sort -u)
	n=$(printf '%s\n' "$keys" | grep -c .)
	for k in $keys; do
		[ -e "$k" ] || {
			bad="$bad $k(dangling)"
			continue
		}
		m=$(stat -L -c '%a' "$k")
		case "$m" in *[1-7]) bad="$bad $k(world:$m)" ;; esac
	done
	if [ -n "$bad" ]; then
		no "secret file modes" "$bad"
	elif [ "$n" -eq 0 ]; then
		skip "secret file modes: sudoers 440 root:root, and no private key or pem on this box to check (0 found)"
	else
		ok "secret file modes: sudoers 440 root:root, $n key/pem file(s) without a world bit"
	fi
}

# check_hestia_conf_mode - the chain that keeps hestia.conf to root: /etc/hestia at the mode the wizard
# gives it (700, so the panel pool and every customer stop at the directory), and the file at the mode the
# seed gives it. Both expectations are read from the tree (include/wizard.sh, include/helper.sh), so a
# changed seed cannot leave a stale number here; a pattern that finds nothing fails. The old /tmp sort
# path handed out the umask's 644 on every box (#960) - #959 keeps the mode, this check says whether the
# drift is really gone. A box installed before a change of the seeded mode reads red here until it is
# reinstalled - the check follows the tree, not the box. Not covered: the other files under conf/.
check_hestia_conf_mode() {
	local conf="$CONF_DIR/conf/hestia.conf" want_dir want_file live_dir live_file
	want_dir=$(sed -n 's/^[[:space:]]*chmod \([0-7]\{3,4\}\) "\$(dirname "\$INSTALL_CONF")".*/\1/p' "$HESTIA/include/wizard.sh" | head -n1)
	want_file=$(sed -n 's/^[[:space:]]*chmod \([0-7]\{3,4\}\) "\$conf_dir\/hestia\.conf".*/\1/p' "$HESTIA/include/helper.sh" | head -n1)
	if [ -z "$want_dir" ] || [ -z "$want_file" ]; then
		no "hestia.conf mode: seed line not found (dir '$want_dir' file '$want_file')" "include/wizard.sh, include/helper.sh"
		return
	fi
	live_dir=$(stat -c '%a %U:%G' "$CONF_DIR" 2> /dev/null)
	live_file=$(stat -c '%a %U:%G' "$conf" 2> /dev/null)
	if [ "$live_dir" != "$want_dir root:root" ]; then
		no "$CONF_DIR is ${live_dir:-missing}, the wizard sets $want_dir root:root" "the boundary the panel pool relies on"
	elif [ "$live_file" != "$want_file root:root" ]; then
		no "hestia.conf is ${live_file:-missing}, the seed sets $want_file root:root" "a writer handed out the umask's mode"
	else
		ok "hestia.conf keeps the seeded $want_file root:root behind a $want_dir /etc/hestia"
	fi
}

# check_protected_names_effective - the list above is a claim; this is the effect. A record that
# tries to bind PATH must not change it, and a harmless one must still bind, in the same run.
check_protected_names_effective() {
	local tmp before after
	local name_before="$NAME"
	before="$PATH"
	tmp=$(mktemp)
	printf "NAME='probe'\nPATH=/tmp/hestia-smoke-should-not-happen\n" > "$tmp"
	NAME=''
	source_conf "$tmp" 2> /dev/null
	after="$PATH"
	local bound="$NAME"
	NAME="$name_before"
	rm -f "$tmp"
	if [ "$before" != "$after" ]; then
		PATH="$before"
		no "a config file rebound PATH (#807)" "source_conf accepted a protected name"
	elif [ "$bound" != "probe" ]; then
		no "the protected-name probe never bound anything" "source_conf read nothing - the check proves nothing"
	else
		ok "a config file cannot rebind PATH, an ordinary key still binds"
	fi
}
# check_restic_pairs - a snapshot without its package cannot be restored, a package without its
# snapshot describes nothing. Derived from the tags, so it also sees a package deleted by hand.
check_restic_pairs() {
	local u repo tags pkg tag n=0 orphan_snap=0 orphan_pkg=0 first="" unread=0 first_unread=""
	repo=$(restic_repo_base) || {
		ok "no restic repository configured - pairs not checked"
		return
	}
	command -v restic > /dev/null 2>&1 || {
		skip "restic not installed"
		return
	}
	local json ids sid rc
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/restic.conf" ] || continue
		json=$(restic --repo "$repo$u" --password-file "$CONF_DIR/users/$u/restic.conf" --json \
			snapshots 2> /dev/null)
		rc=$?
		# A repository that cannot be read is not an empty one: counting orphans here would blame
		# every package for a broken line.
		if [ "$rc" -ne 0 ]; then
			unread=$((unread + 1))
			[ -z "$first_unread" ] && first_unread="repository for $u could not be read (restic rc=$rc)"
			continue
		fi
		tags=$(grep -o '"meta:[^"]*"' <<< "$json" | tr -d '"')
		ids=$(grep -o '"short_id":"[^"]*"' <<< "$json" | cut -d'"' -f4)
		for tag in $tags; do
			n=$((n + 1))
			[ -f "$BACKUP/$u/${tag#meta:}.meta.tgz" ] && continue
			orphan_snap=$((orphan_snap + 1))
			[ -z "$first" ] && first="$u: snapshot tagged $tag has no package"
		done
		for pkg in "$BACKUP/$u/$u".*.meta.tgz; do
			[ -f "$pkg" ] || continue
			tag="meta:$(basename "$pkg" .meta.tgz)"
			grep -qxF "$tag" <<< "$tags" && continue
			# Second direction: the snapshot the package names itself.
			sid=$(tar -xzOf "$pkg" ./restic.meta 2> /dev/null | sed -n "s/^SNAPSHOT='\([^']*\)'.*/\1/p")
			[ -n "$sid" ] && grep -qxF "$sid" <<< "$ids" && continue
			orphan_pkg=$((orphan_pkg + 1))
			[ -z "$first" ] && first="$u: package $(basename "$pkg") has no snapshot"
		done
	done
	if [ "$unread" -gt 0 ]; then
		no "$unread restic repository(s) could not be read - only $n pair(s) checked" "$first_unread"
	elif [ "$((orphan_snap + orphan_pkg))" -eq 0 ]; then
		ok "every restic snapshot has its package ($n pair(s))"
	else
		no "$((orphan_snap + orphan_pkg)) restic artefact(s) without a partner" "$first"
	fi
}
# check_restic_mode_supported - restic mode without the addon or without a repository means no
# backup at all, and the nightly run says so only in the log.
check_restic_mode_supported() {
	local u m repo n=0 bad=0 first=""
	# The gate's own resolution, called directly - the gate would exit through check_result.
	repo=$(restic_repo_base) || repo=""
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		m=$(sed -n "s/^.*BACKUPS_MODE='\([^']*\)'.*/\1/p" "$CONF_DIR/users/$u/user.conf" 2> /dev/null | head -1)
		[ "$m" = 'restic' ] || continue
		n=$((n + 1))
		if ! restic version > /dev/null 2>&1; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but restic is not installed"
		elif [ -z "$repo" ]; then
			bad=$((bad + 1))
			[ -z "$first" ] && first="$u is in restic mode but no repository is configured"
		fi
	done
	if [ "$bad" -eq 0 ]; then
		ok "restic mode is supported where it is set ($n customer(s))"
	else
		no "$bad customer(s) in restic mode without support" "$first"
	fi
}
# check_logrotate_parses - a doubled path makes logrotate exit 1 and the unit stay failed. Only a
# collision with one of our files is ours; base-system ones are named, not red.
check_logrotate_parses() {
	local out owned line path f pat mine ours=0 base=0 first="" basefiles="" mycount=0
	if ! command -v logrotate > /dev/null 2>&1; then
		skip "logrotate not installed"
		return
	fi
	out=$(logrotate -d /etc/logrotate.conf 2>&1)
	# ours = whatever no package claims, so a file added by hand counts as ours too
	owned=$(dpkg -S /etc/logrotate.d/* 2> /dev/null | sed 's/^[^:]*: //')
	for f in /etc/logrotate.d/*; do
		[ -f "$f" ] || continue
		grep -qxF "$f" <<< "$owned" || mycount=$((mycount + 1))
	done
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		path=${line##*duplicate log entry for }
		[ "$path" != "$line" ] || continue
		mine=0
		for f in /etc/logrotate.d/*; do
			[ -f "$f" ] || continue
			grep -qxF "$f" <<< "$owned" && continue
			while read -r pat; do
				# shellcheck disable=SC2254  # the config line IS a glob, matching it is the point
				case "$path" in $pat) mine=1 ;; esac
			done < <(grep -oE '^/[^ {]+' "$f")
		done
		if [ "$mine" = 1 ]; then
			ours=$((ours + 1))
			[ -z "$first" ] && first="${line#error: }"
		else
			base=$((base + 1))
			f=${line#error: }
			f=${f%%:*}
			grep -qw "$f" <<< "$basefiles" || basefiles="${basefiles:+$basefiles, }$f"
		fi
	done <<< "$(grep '^error:' <<< "$out")"
	if [ "$ours" -gt 0 ]; then
		no "$ours logrotate collision(s) involving a file of ours" "$first"
	elif [ "$base" -gt 0 ]; then
		ok "logrotate: our $mycount file(s) collide with nothing - $base base-system conflict(s), not ours: $basefiles"
	else
		ok "logrotate parses its configuration (ours: $mycount file(s))"
	fi
}
# check_web_record_has_vhost - the upstream check reads files, so a domain whose vhost was skipped
# looks clean by being absent. Expectation comes from the record: a docker domain in a proxy model
# has its backend vhost removed on purpose, everything else needs the front (and the proxy it names).
# Not covered: the SSL variant of a fragment, and whether the vhost inside is the right one.
check_web_record_has_vhost() {
	local u line d docker proxy sys fronts n=0 miss=0 first=""
	if [ -z "$WEB_SYSTEM" ]; then
		skip "no web system - vhost coverage not checked"
		return
	fi
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			docker=$(sed -n "s/.* DOCKER='\([^']*\)'.*/\1/p" <<< "$line")
			proxy=$(sed -n "s/.* PROXY='\([^']*\)'.*/\1/p" <<< "$line")
			if [ -n "$docker" ] && [ -n "$PROXY_SYSTEM" ] && [ "$WEB_SYSTEM" != "$PROXY_SYSTEM" ]; then
				fronts="$PROXY_SYSTEM"
			else
				fronts="$WEB_SYSTEM"
				[ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] && fronts="$fronts $PROXY_SYSTEM"
			fi
			for sys in $fronts; do
				n=$((n + 1))
				[ -f "/etc/$sys/conf.d/domains/$d.conf" ] && continue
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d has no $sys vhost"
			done
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "every web record has its vhost ($n checked)"
	else
		no "$miss web record(s) without a vhost" "$first"
	fi
}
# check_web_templates_resolvable - a record pointing at a template that no longer exists
# renders nothing. add_web_config now refuses instead of writing an empty vhost, so the
# damage is visible - but only on the next rebuild, which may be weeks away.
check_web_templates_resolvable() {
	local u line d tpl proxy backend miss=0 first="" checked=0
	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		[ -f "$CONF_DIR/users/$u/web.conf" ] || continue
		while IFS= read -r line; do
			d=$(sed -n "s/.*DOMAIN='\([^']*\)'.*/\1/p" <<< "$line")
			[ -n "$d" ] || continue
			tpl=$(sed -n "s/.*[^_]TPL='\([^']*\)'.*/\1/p" <<< "$line")
			proxy=$(sed -n "s/.* PROXY='\([^']*\)'.*/\1/p" <<< "$line")
			backend=$(sed -n "s/.* BACKEND='\([^']*\)'.*/\1/p" <<< "$line")
			checked=$((checked + 1))
			if [ -n "$WEB_SYSTEM" ] && [ -n "$tpl" ] \
				&& [ ! -f "$(web_template_file "$WEB_SYSTEM" "$tpl" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d TPL='$tpl'"
			fi
			if [ -n "$PROXY_SYSTEM" ] && [ -n "$proxy" ] \
				&& [ ! -f "$(web_template_file "$PROXY_SYSTEM" "$proxy" 'tpl')" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d PROXY='$proxy'"
			fi
			if [ -n "$WEB_BACKEND" ] && [ -n "$backend" ] \
				&& [ ! -f "$PHPTPL/$backend.tpl" ]; then
				miss=$((miss + 1))
				[ -z "$first" ] && first="$u/$d BACKEND='$backend'"
			fi
		done < "$CONF_DIR/users/$u/web.conf"
	done
	if [ "$miss" -eq 0 ]; then
		ok "every web record resolves to a template ($checked domain(s))"
	else
		no "$miss web record value(s) point at a missing template" "$first"
	fi
}

# check_record_grammar - every record line against record_line_valid, the one place that defines
# the grammar (include/backup.sh). A line that loses its quotes stays READABLE - source_conf takes
# KEY=value just fine - while every writer looks for KEY='...' and silently finds nothing. The
# record then shows a value that no change can move, and the panel looks correct while saving
# nothing. Cheap, and it catches hand edits, ours included.
check_record_grammar() {
	local f n=0 bad=0 first="" line
	if ! declare -F record_line_valid > /dev/null 2>&1; then
		no "record grammar not checkable" "record_line_valid missing - include/backup.sh not sourced"
		return
	fi
	for f in "$CONF_DIR/users"/*/user.conf "$CONF_DIR/users"/*/*.conf "$CONF_DIR/users"/*/mail/*.conf \
		"$CONF_DIR/ips"/* "$CONF_DIR/packages"/*.pkg "$HESTIA/conf/hestia.conf"; do
		[ -f "$f" ] || continue
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			n=$((n + 1))
			record_line_valid "$line" && continue
			bad=$((bad + 1))
			[ -z "$first" ] && first="$f: ${line:0:60}"
		done < "$f"
	done
	# Nothing to look at is a finding: every box has records.
	if [ "$n" -eq 0 ]; then
		no "record grammar: no record lines found" "$CONF_DIR looks empty - the check saw nothing"
	elif [ "$bad" -eq 0 ]; then
		ok "record grammar holds on $n record lines"
	else
		no "$bad record line(s) are not KEY='value'" "$first - readable but unwritable: every writer looks for KEY='...'"
	fi
}

# check_object_counters - the stored counters against what h-update-user-counters WOULD write.
# The counting rules are not repeated here: this guard had its own set, and the two that were
# missing from it (IP_AVAIL, IP_OWNED) drifted for exactly that reason (#866). The authority is
# asked in its read-only 'check' mode, so a counter added there is verified from that day on.
#
# It also asks the other way round: a counter-shaped key in the registry that the authority does
# not compute lives outside both, which is how U_MAIL_SSL survived for years.
# check_ip_object_counters - the ip-record counters had an authority but no guard (the
# IP_AVAIL lage before #867), and the NAT-blind decrease left real backlog. Object list
# derives from the files; the authority's check mode is the only rule source.
# The mirror URL is a literal in THREE places (install.sh and h-update-hestia run before or
# without this tree), so this measures them against each other. The DEFAULT only, and it never
# asks whether the host answers - that is the fetch's job.
check_release_mirror() {
	local a b c
	a=$(sed -n 's|^RELEASE_MIRROR="\(https://[^"$]*\)"$|\1|p' "$HESTIA/install.sh" 2> /dev/null | head -n1)
	b=$(sed -n 's|^RELEASE_MIRROR="${HESTIARE_MIRROR-\(https://[^"}]*\)}"$|\1|p' "$HESTIA/sbin/h-update-hestia" 2> /dev/null | head -n1)
	c=$(sed -n 's|^HESTIA_RELEASE_MIRROR="\(https://[^"$]*\)"$|\1|p' "$HESTIA/include/main.sh" 2> /dev/null | head -n1)
	if [ -z "$a" ] || [ -z "$b" ] || [ -z "$c" ]; then
		no "release mirror default unreadable" "install.sh='${a:-none}' h-update-hestia='${b:-none}' main.sh='${c:-none}' - a line moved and this guard now measures nothing"
	elif [ "$a" != "$b" ] || [ "$a" != "$c" ]; then
		no "release mirror default drifted" "install.sh=$a, h-update-hestia=$b, main.sh=$c - the bootstrap and the runtime fetches would use different hosts"
	else
		ok "release mirror default identical in all three fetch paths ($a)"
	fi
}

# v6 keeps a PREFIX LENGTH in NETMASK and never a NAT address (NAT is v4-only). Nothing to compare
# against but the file itself, so an empty set of objects is a finding, not a pass.
check_ip_object_shape() {
	local f ip fam nm nat n=0 bad=0 first=""
	for f in "$CONF_DIR/ips"/*; do
		[ -f "$f" ] || continue
		ip=$(basename "$f")
		n=$((n + 1))
		fam=$(ip_family "$ip")
		nm=$(sed -n "s/^NETMASK='\(.*\)'\$/\1/p" "$f" | head -1)
		nat=$(sed -n "s/^NAT='\(.*\)'\$/\1/p" "$f" | head -1)
		if [ "$fam" = 6 ]; then
			if ! [[ "$nm" =~ ^[0-9]{1,3}$ ]] || [ "$nm" -gt 128 ]; then
				bad=$((bad + 1))
				[ -z "$first" ] && first="$ip: NETMASK='$nm' is not a prefix length (0-128)"
			fi
			if [ -n "$nat" ]; then
				bad=$((bad + 1))
				[ -z "$first" ] && first="$ip: NAT='$nat' - NAT does not exist for v6"
			fi
		elif [ "$fam" = 4 ]; then
			if ! [[ "$nm" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
				bad=$((bad + 1))
				[ -z "$first" ] && first="$ip: NETMASK='$nm' is not a dotted-quad mask"
			fi
		else
			bad=$((bad + 1))
			[ -z "$first" ] && first="$ip: the object name is neither a v4 nor a v6 address"
		fi
	done
	if [ "$n" -eq 0 ]; then
		no "no IP object to check" "every box registers at least one - the directory or the guard moved"
	elif [ "$bad" -gt 0 ]; then
		no "$bad IP object field(s) do not match their family" "$first"
	else
		ok "IP objects match their family ($n checked: netmask form, no NAT on v6)"
	fi
}

check_ip_object_counters() {
	local f addr line k want stored drift=0 checked=0 first='' obj_out obj_lines
	for f in "$CONF_DIR"/ips/*; do
		[ -f "$f" ] || continue
		addr=${f##*/}
		# only the two counter lines count as an answer (check_result errors land on stdout)
		obj_out=$("$BIN/h-update-sys-ip-counters" "$addr" check 2> /dev/null | grep -E "^U_(WEB_DOMAINS|SYS_USERS)='")
		obj_lines=$(grep -c . <<< "$obj_out")
		# empty is no pass PER OBJECT: a broken object must not ride on the others' green
		if [ "$obj_lines" -eq 0 ]; then
			drift=$((drift + 1))
			[ -z "$first" ] && first="$addr: authority answered nothing (broken object or stray file)"
			continue
		fi
		while IFS= read -r line; do
			k="${line%%=*}"
			want=$(sed "s/^$k='\(.*\)'$/\1/" <<< "$line")
			stored=$(sed -n "s/^$k='\(.*\)'$/\1/p" "$f" | head -1)
			checked=$((checked + 1))
			[ "$stored" = "$want" ] && continue
			drift=$((drift + 1))
			[ -z "$first" ] && first="$addr $k stored='$stored' counted='$want'"
		done <<< "$obj_out"
	done
	if [ "$checked" -eq 0 ] && [ "$drift" -eq 0 ]; then
		no "no IP object counters compared" "every box registers at least one IP - the authority or the file set broke"
	elif [ "$drift" -gt 0 ]; then
		no "$drift IP object counter(s) drifted" "$first - repair: h-update-sys-ip-counters"
	else
		ok "IP object counters match their recount ($checked compared)"
	fi
}

check_object_counters() {
	local u line k stored want drift=0 checked=0 first="" computed missing="" reg
	computed=$("$BIN/h-update-user-counters" "$ROOT_USER" check 2> /dev/null | cut -d= -f1)
	if [ -z "$computed" ]; then
		no "counter authority answered nothing" "h-update-user-counters <user> check is the guard's oracle"
		return
	fi
	for reg in $(syshealth_known_keys user | tr ' ' '\n' | grep -E '^(U_|IP_|SUSPENDED_)'); do
		grep -qx "$reg" <<< "$computed" || missing="$missing $reg"
	done

	for u in $("$BIN/h-list-users" list 2> /dev/null); do
		while IFS= read -r line; do
			k="${line%%=*}"
			want=$(sed "s/^$k='\\(.*\\)'$/\\1/" <<< "$line")
			stored=$(sed -n "s/^$k='\\(.*\\)'$/\\1/p" "$CONF_DIR/users/$u/user.conf" | head -1)
			[ -n "$stored" ] || continue
			checked=$((checked + 1))
			[ "$stored" = "$want" ] && continue
			drift=$((drift + 1))
			[ -z "$first" ] && first="$u $k stored=$stored counted=$want"
		done < <("$BIN/h-update-user-counters" "$u" check 2> /dev/null)
	done

	# Nothing compared is a finding: every box has at least the admin record.
	if [ "$checked" -eq 0 ]; then
		no "no counters compared" "the authority returned nothing for any user"
	elif [ "$drift" -gt 0 ]; then
		no "$drift counter(s) drifted from their objects" "$first - repair: h-update-user-counters <user>"
	else
		ok "object counters match what the recount would write ($checked compared)"
	fi
	[ -z "$missing" ] \
		|| no "registry counter(s) nothing computes:$missing" "outside both the recount and this guard - remove them or compute them"
}

# check_record_grammar - every record line against record_line_valid, the one place that defines
# the grammar (include/backup.sh). A line that loses its quotes stays READABLE - source_conf takes
# KEY=value just fine - while every writer looks for KEY='...' and silently finds nothing. The
# record then shows a value that no change can move, and the panel looks correct while saving
# nothing. Cheap, and it catches hand edits, ours included.
check_record_grammar() {
	local f n=0 bad=0 first="" line
	if ! declare -F record_line_valid > /dev/null 2>&1; then
		no "record grammar not checkable" "record_line_valid missing - include/backup.sh not sourced"
		return
	fi
	for f in "$CONF_DIR/users"/*/user.conf "$CONF_DIR/users"/*/*.conf "$CONF_DIR/users"/*/mail/*.conf \
		"$CONF_DIR/ips"/* "$CONF_DIR/packages"/*.pkg "$HESTIA/conf/hestia.conf"; do
		[ -f "$f" ] || continue
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			n=$((n + 1))
			record_line_valid "$line" && continue
			bad=$((bad + 1))
			[ -z "$first" ] && first="$f: ${line:0:60}"
		done < "$f"
	done
	# Nothing to look at is a finding: every box has records.
	if [ "$n" -eq 0 ]; then
		no "record grammar: no record lines found" "$CONF_DIR looks empty - the check saw nothing"
	elif [ "$bad" -eq 0 ]; then
		ok "record grammar holds on $n record lines"
	else
		no "$bad record line(s) are not KEY='value'" "$first - readable but unwritable: every writer looks for KEY='...'"
	fi
}

# check_sys_key_registry - the system key registry (share/hestia/sys-keys.json, #932), three guards:
# (1) the schema, through the same sysreg_check the CI runs; (2) every key the tree writes into
# hestia.conf is registered - the write sites are extracted from the shipped code (the six mechanisms:
# wcv/_wcv, change_sys_value/clear_sys_value, h-change-sys-config-value with a literal key, repair_key,
# a direct echo/sed on hestia.conf, the web-model key set), never listed here; (3) an empty registry
# or an empty extraction is red. A key written through a variable name cannot be extracted and is
# not covered; the emitter and the repair read the registry, so such a key would surface there.
check_sys_key_registry() {
	local out written unknown='' n k
	if ! out=$(sysreg_check 2>&1); then
		no "system key registry: schema" "$(echo "$out" | head -n3 | tr '\n' ';')"
		return
	fi
	written=$({
		grep -rhoE "(_wcv|wcv|change_sys_value|clear_sys_value|repair_key) +['\"]?[A-Z][A-Z0-9_]+" "$HESTIA/bin" "$HESTIA/include" "$HESTIA/sbin" 2> /dev/null
		grep -rhoE "h-change-sys-config-value +['\"]?[A-Z][A-Z0-9_]+" "$HESTIA/bin" "$HESTIA/include" "$HESTIA/sbin" "$HESTIA/web" 2> /dev/null
		grep -rhE "hestia\.conf" "$HESTIA/bin" "$HESTIA/include" "$HESTIA/sbin" 2> /dev/null | grep -oE "(echo \"|s[|/]\^?)[A-Z][A-Z0-9_]+="
		grep -hoE '^WEB_MODEL_KEYS="[A-Z_ ]+"' "$HESTIA/include/web-model.sh" 2> /dev/null | tr ' ' '\n'
	} | grep -oE '[A-Z][A-Z0-9_]{2,}' | grep -vx 'WEB_MODEL_KEYS' | sort -u)
	# The one exclusion is the variable's own name, picked up from the line the key set is read from; it
	# is not a key. Nothing else is excluded - a written key that is not registered is the finding.
	n=$(echo "$written" | grep -c .)
	if [ "$n" -lt 20 ]; then
		no "system key registry: write-site extraction found only $n key(s)" "the grep patterns no longer match the code"
		return
	fi
	for k in $written; do
		sysreg_class "$k" > /dev/null 2>&1 || unknown="$unknown $k"
	done
	if [ -n "$unknown" ]; then
		no "system key registry: written but unregistered key(s)" "$unknown"
	else
		ok "system key registry: schema holds, all $n written keys registered ($(sysreg_keys | wc -l) entries)"
	fi
}

# check_system_keys_agree - the system keys the repair never fills, held against the box (#932): a
# lost one stays lost until something says so. ROOT_USER must name an admin record; every DB_SYSTEM
# token must have its host registration under conf/; every BACKUP_SYSTEM token except local its
# backup host file. VERSION is Phase 4, the component keys are the service gates below and the
# artefact fields of 1c.
check_system_keys_agree() {
	local bad='' t
	if [ -z "$ROOT_USER" ]; then
		bad="$bad ROOT_USER(empty)"
	elif [ ! -f "$CONF_DIR/users/$ROOT_USER/user.conf" ] || ! grep -q "^ROLE='admin'" "$CONF_DIR/users/$ROOT_USER/user.conf"; then
		bad="$bad ROOT_USER($ROOT_USER:no-admin-record)"
	fi
	for t in ${DB_SYSTEM//,/ }; do
		[ -f "$HESTIA/conf/$t.conf" ] || bad="$bad DB_SYSTEM($t:no-host-file)"
	done
	for t in ${BACKUP_SYSTEM//,/ }; do
		[ "$t" = local ] && continue
		[ -f "$HESTIA/conf/$t.backup.conf" ] || bad="$bad BACKUP_SYSTEM($t:no-host-file)"
	done
	if [ -n "$bad" ]; then
		no "system keys disagree with the box" "$bad"
	else
		ok "system keys agree with the box (ROOT_USER=$ROOT_USER, DB_SYSTEM='${DB_SYSTEM}', BACKUP_SYSTEM='${BACKUP_SYSTEM}')"
	fi
}

# check_key_registries - conf/defaults/*.conf must exist and match the key sets compiled into
# include/syshealth.sh. A registry that is missing, stale or duplicated makes the repair functions
# skip exactly the keys they exist to add, and does it silently (#559) - which is the whole reason
# this guard is here rather than a comment.
check_key_registries() {
	local sys want have missing='' drift='' dupes=''
	if ! declare -F syshealth_known_keys > /dev/null 2>&1; then
		skip "syshealth_known_keys unavailable - key registries not checkable"
		return
	fi
	local unknown=''
	# system is not here: its registry is share/hestia/sys-keys.json, checked by check_sys_key_registry (#932).
	for sys in web mail mail_accounts user cron db ip; do
		# An empty reference must not pass as agreement: the writer feeds from the same function, so
		# a subsystem with no branch would write an empty registry that then matches its own empty
		# source. Caught here rather than reported as PASS on eight empty files.
		if ! want="$(syshealth_known_keys "$sys")" || [ -z "$want" ]; then
			unknown="$unknown $sys"
			continue
		fi
		want="$(echo "$want" | tr ' ' '\n' | sed '/^$/d')"
		if [ ! -f "$HESTIA/conf/defaults/$sys.conf" ]; then
			missing="$missing $sys"
			continue
		fi
		have="$(sed '/^$/d' "$HESTIA/conf/defaults/$sys.conf")"
		[ "$have" = "$want" ] || drift="$drift $sys"
		[ -z "$(echo "$have" | sort | uniq -d)" ] || dupes="$dupes $sys"
	done
	if [ -n "$missing$drift$dupes$unknown" ]; then
		no "key registries out of sync" \
			"missing:${missing:- none} drift:${drift:- none} duplicates:${dupes:- none} no-key-set:${unknown:- none}"
	else
		ok "key registries match the compiled key sets (7 object registries)"
	fi
}

# check_identity_band - the allocator's preconditions, not its output. Panel users
# created before #388 keep their old uid by design, so their position is NOT checked;
# what must hold is that nothing can wander into the band and that the subordinate
# ranges the companion needs are actually permitted.
check_identity_band() {
	local defs='/etc/login.defs' band_start=11000 v dupes
	if [ ! -f "$defs" ]; then
		skip "login.defs absent - identity band guard not checkable"
		return
	fi

	for key in UID_MAX GID_MAX; do
		v=$(awk -v k="$key" '$1 == k { print $2; exit }' "$defs")
		if [ -n "$v" ] && [ "$v" -lt "$band_start" ] 2> /dev/null; then
			ok "$key caps below the panel band"
		else
			no "$key is ${v:-unset}, not below $band_start" "a bare useradd can land inside the band and collide with an allocation"
		fi
	done

	# The shipped default (600100000) sits below the highest range the formula produces,
	# which would reject the companion subuid ranges of roughly 43% of usernames - and
	# only at "enable Docker", long after the account was made.
	for key in SUB_UID_MAX SUB_GID_MAX; do
		v=$(awk -v k="$key" '$1 == k { print $2; exit }' "$defs")
		if [ -n "$v" ] && [ "$v" -ge 1048675999 ] 2> /dev/null; then
			ok "$key covers the whole subordinate range"
		else
			no "$key is ${v:-unset}, below the highest computed range end" "companion subuid ranges would be rejected later (#389)"
		fi
	done

	# Two panel users on one uid is corruption, not a legacy artefact.
	dupes=$(for u in "$CONF_DIR"/users/*/; do
		u=$(basename "$u")
		[ "$u" = '*' ] && continue
		id -u "$u" 2> /dev/null
	done | sort | uniq -d | wc -l)
	if [ "$dupes" -eq 0 ]; then
		ok "no two panel users share a uid"
	else
		no "$dupes uid(s) shared by more than one panel user" "ownership cannot be separated; check /etc/passwd"
	fi
}

# check_proc_hardening - the exemption is a live mount option, so verify the running
# state, not the config. Catches a failed unit (fail-open is silent to users) and a gid
# that drifted off the group after a delete/recreate cycle.
check_proc_hardening() {
	local unit='hestia-proc-hardening.service' mounted group_gid
	if ! systemctl list-unit-files "$unit" > /dev/null 2>&1 \
		|| [ "$(systemctl is-enabled "$unit" 2> /dev/null)" != enabled ]; then
		skip "/proc hardening not enabled here (container?)"
		return
	fi

	[ "$(systemctl is-failed "$unit" 2> /dev/null)" = failed ] \
		&& no "/proc hardening unit failed" "boot left /proc unhardened; systemctl status $unit"

	if grep -q ' /proc .*hidepid=' /proc/self/mountinfo /proc/mounts 2> /dev/null; then
		ok "/proc carries hidepid"
	else
		no "/proc has no hidepid" "every user can read foreign /proc/*/cmdline; systemctl start $unit"
	fi

	# A stale numeric gid would exempt whoever holds it now, which is the failure the
	# unit resolves the group at boot to avoid - so it must not reappear.
	mounted=$(awk '$2 == "/proc" { print $4 }' /proc/mounts | tr ',' '\n' | sed -n 's/^gid=//p')
	group_gid=$(getent group procvis 2> /dev/null | cut -d: -f3)
	if [ -z "$mounted" ]; then
		[ -z "$group_gid" ] && ok "/proc exemption absent, procvis absent" \
			|| no "/proc exemption missing while procvis exists" "gid $group_gid is not exempt; rootless Docker cannot start containers"
	elif [ "$mounted" = "$group_gid" ]; then
		ok "/proc exemption gid matches procvis"
	else
		no "/proc exemption gid $mounted is not procvis (${group_gid:-absent})" "a recycled gid silently exempts a foreign group"
	fi
}

# check_web_model_sentinel - flag an interrupted model switch so the box reports it
# rather than the operator discovering it at the next reboot.
check_mesh_serve_staged() {
	# Without the staging, /mesh-decisions.php 404s and every peer silently stops receiving this box's
	# bans - and since /run is tmpfs, a missed refresh after a boot looks healthy from anywhere else.
	if [ ! -s "$CONF_DIR/crowdsec/peers.conf" ]; then
		ok "crowdsec mesh has no peers paired"
	elif [ -f /run/hestia/mesh/tokens ] && [ -f /run/hestia/mesh/published.json ]; then
		ok "crowdsec mesh serve side staged"
	else
		no "crowdsec mesh peers paired but /run/hestia/mesh not staged" "run: h-update-crowdsec-mesh"
	fi
}

check_realip_header() {
	local f=/etc/nginx/conf.d/cloudflare.inc
	# The installer rewrites this file from the CF API and skips it silently on a failed
	# fetch. Without real_ip_header nginx defaults to X-Real-IP, which the client controls:
	# CF-Connecting-IP is then ignored (every visitor logs as the CF edge, so fail2ban bans
	# the edge) and a forged X-Real-IP becomes $remote_addr for every ban consumer.
	if [ ! -f "$f" ]; then
		skip "cloudflare realip include absent"
	elif grep -qE '^\s*real_ip_header' "$f"; then
		ok "cloudflare realip names its header"
	else
		no "cloudflare realip has no real_ip_header (#553)" "nginx then trusts client-set X-Real-IP; re-copy share/nginx/cloudflare.inc"
	fi
}

check_slice_dropins_owned() {
	local d uid orphan='' first=''
	for d in /etc/systemd/system.control/user-*.slice.d; do
		[ -d "$d" ] || continue
		uid=$(basename "$d")
		uid=${uid#user-}
		uid=${uid%.slice.d}
		getent passwd "$uid" > /dev/null 2>&1 && continue
		orphan=$((${orphan:-0} + 1))
		[ -z "$first" ] && first="uid $uid"
	done
	if [ -z "$orphan" ]; then
		ok "no resource drop-in outlives its account"
	else
		no "$orphan resource drop-in(s) without an account" \
			"$first - a later account reusing the uid inherits the limit with no visible cause"
	fi
}

check_web_model_sentinel() {
	local s="/var/lib/hestia/web-model-switch/IN_PROGRESS" op
	if [ -f "$s" ]; then
		op=$(sed -n 's/^op=//p' "$s")
		no "interrupted web-model switch pending (#120)" "recover: ${op:-h-<add|delete>-sys-<nginx|apache2>} --recover"
	else
		ok "no interrupted web-model switch"
	fi
}


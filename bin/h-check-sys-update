#!/bin/bash
# info: ask the release source whether a newer release is published
# options: NONE
#
# example: h-check-sys-update
#
# Writes UPDATE_AVAILABLE for the panel banner and downloads nothing. The crontab calls this, not update.sh:
# sudo grants hestia bin/ only, and bin/ is the panel-callable surface, so the grant stays as it is.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '0' "$#" 'NONE'
[ -f "$HESTIA/update.sh" ] || check_result "$E_NOTEXIST" "$HESTIA/update.sh is missing"

bash "$HESTIA/update.sh" --check

exit

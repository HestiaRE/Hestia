#!/bin/bash
# info: check user token
# options: USER TOKEN
#
# example: h-check-user-2fa admin 493690
#
# Checks a user's two-factor token.

user=$1
token=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER TOKEN'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

source_conf "$USER_DATA/user.conf"

if [ -z "$TWOFA" ]; then
	echo "Error: Two-factor authentication is not enabled."
	exit "$E_NOTEXIST"
fi

is_no_new_line_format "$token"
result=$(printf '%s\n%s\n' "$TWOFA" "$token" | $HESTIA_PHP $HESTIA/web/inc/2fa/check.php)
if [ "$result" != "ok" ]; then
	echo "Error: Authentication token mismatch."
	exit 9
fi

exit

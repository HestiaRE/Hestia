#!/bin/bash
# info: check user hash
# options: USER HASH [IP]
# labels: internal
# caller: the panel login
#
# example: h-check-user-hash admin CN5JY6SMEyNGnyCuvmK5z4r7gtHAC4mRZ...
#
# Checks the hash the panel computed from the login password against the shadow entry.

user=$1
hash=$2
HIDE=2
ip46=${3-127.0.0.1}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

check_args '2' "$#" 'USER HASH [IP]'
is_format_valid 'user' 'ip46'

if [ ! -d "$CONF_DIR/users/$user" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

is_hash_valid

if [[ -z "$hash" ]]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

shadow=$(grep "^$user:" /etc/shadow | cut -f 2 -d :)
# A suspended account's hash carries the lock prefix; it is checked without it and named only on a match.
locked=''
if [[ "$shadow" == '!'* ]]; then
	locked='yes'
	shadow=${shadow#!}
fi

if echo "$shadow" | grep -qE '^\$[0-9a-z]+\$[^\$]+\$'; then
	salt=$(echo "$shadow" | cut -f 3 -d \$)
	method=$(echo "$shadow" | cut -f 2 -d \$)
	if [ "$method" = "y" ]; then
		method="yescrypt"
	elif [ "$method" -eq '1' ]; then
		method='md5'
	elif [ "$method" -eq '6' ]; then
		method='sha-512'
	else
		echo "Error: password missmatch"
		echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
		exit 9
	fi
else
	salt=${shadow:0:2}
	method='des'
fi

if [ -z "$salt" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

if [[ "$shadow" != "$hash" ]]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi
if [ -n "$locked" ]; then
	echo "Error: Account has been suspended"
	echo "$date $time $user $ip46 has been suspended" >> $HESTIA/log/auth.log
	exit 5
fi

echo "$date $time $user $ip46 successfully logged in" >> $HESTIA/log/auth.log

exit

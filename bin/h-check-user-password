#!/bin/bash
# info: check user password
# options: USER PASSWORD [IP] [RETURN_HASH]
# labels: internal
# caller: the panel login
#
# example: h-check-user-password admin qwerty1234
#
# Checks a user's password, given as a file. With RETURN_HASH it prints the hash for h-check-user-hash.

user=$1
password=$2
HIDE=2
ip46=${3-127.0.0.1}
return_hash=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

check_args '2' "$#" 'USER PASSWORD [IP] [RETURN_HASH]'
is_format_valid 'user' 'ip46'

if [ ! -d "$CONF_DIR/users/$user" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

is_password_valid

if [[ -z "$password" ]]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

shadow=$(grep "^$user:" /etc/shadow | cut -f 2 -d :)
# A suspended account's hash carries the lock prefix; it is checked without it and named only on a match.
locked=''
if [[ "$shadow" == '!'* ]]; then
	locked='yes'
	shadow=${shadow#!}
fi

if echo "$shadow" | grep -qE '^\$[0-9a-z]+\$[^\$]+\$'; then
	salt=$(echo "$shadow" | cut -f 3 -d \$)
	method=$(echo "$shadow" | cut -f 2 -d \$)
	if [ "$method" = "y" ]; then
		method="yescrypt"
	elif [ "$method" -eq '1' ]; then
		method='md5'
	elif [ "$method" -eq '6' ]; then
		method='sha-512'
	else
		echo "Error: password missmatch"
		echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
		exit 9
	fi
else
	salt=${shadow:0:2}
	method='des'
fi

if [ -z "$salt" ]; then
	echo "Error: password missmatch"
	echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	exit 9
fi

if [ "$method" = "yescrypt" ]; then
	# The SETTING, not the whole hash: with the full hash a wrong password exits 2 as "unsupported method".
	# On stdin: argv is readable in /proc while mkpasswd runs.
	if ! hash=$(printf '%s\n' "$password" | mkpasswd --stdin -S "${shadow%\$*}\$" 2> /dev/null); then
		# Only a failing mkpasswd gets here, never a wrong password; logged so an outage is not read as a typo.
		echo "$date $time $user $ip46 yescrypt hashing unavailable - check mkpasswd (whois) and libcrypt" \
			>> $HESTIA/log/auth.log
		echo "Error: password missmatch"
		exit 9
	fi
else
	set -o noglob
	hash=$($BIN/h-generate-password-hash "$method" "$salt" <<< "$password")
	if [[ -z "$hash" ]]; then
		echo "Error: password missmatch"
		if [ -z "$return_hash" ]; then
			echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
		fi
		exit 9
	fi
fi

if [[ -z "$hash" ]] || [[ "$hash" != "$shadow" ]]; then
	echo "Error: password missmatch"
	if [ -z "$return_hash" ]; then
		echo "$date $time $user $ip46 failed to login" >> $HESTIA/log/auth.log
	fi
	exit 9
fi
# With RETURN_HASH the caller hands the hash to h-check-user-hash, which names the suspension.
if [ -n "$locked" ] && [ -z "$return_hash" ]; then
	echo "Error: Account has been suspended"
	echo "$date $time $user $ip46 has been suspended" >> $HESTIA/log/auth.log
	exit 5
fi

if [ -n "$return_hash" ]; then
	echo $hash
else
	echo "$date $time $user $ip46 successfully logged in" >> $HESTIA/log/auth.log
fi

exit

#!/bin/bash
# info: delete a backup host
# options: TYPE
#
# example: h-delete-backup-host sftp
#
# Deletes the configuration of the backup host of a type (ftp, sftp, local, ...).

type=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'TYPE'
types=$(echo "$BACKUP_SYSTEM" | sed "s/,/\n/g" | grep "^$type$")
if [ -z "$types" ]; then
	echo "Error: invalid backup type"
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi

rm -f $HESTIA/conf/$type.backup.conf

# Through the token function: an anchored edit, a bare sed would hit other keys.
sys_key_token_set BACKUP_SYSTEM remove "$type" > /dev/null || check_result "$E_UPDATE" "BACKUP_SYSTEM: could not drop $type"

$BIN/h-log-action "system" "Info" "Backup" "Removed remote backup host (Type: $type)."
log_event "$OK" "$ARGUMENTS"

exit

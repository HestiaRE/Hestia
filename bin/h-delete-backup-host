#!/bin/bash
# info: delete backup ftp server
# options: TYPE [HOST]
#
# example: h-delete-backup-host sftp
#
# This function deletes ftp backup host

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
type=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'TYPE [HOST]'
types=$(echo "$BACKUP_SYSTEM" | sed "s/,/\n/g" | grep "^$type$")
if [ -z "$types" ]; then
	echo "Error: invalid backup type"
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Deleting host config
rm -f $HESTIA/conf/$type.backup.conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating hestia.conf through the token function (anchored; the bare-sed class, #978)
sys_key_token_set BACKUP_SYSTEM remove "$type" > /dev/null || check_result "$E_UPDATE" "BACKUP_SYSTEM: could not drop $type"

# Logging
$BIN/h-log-action "system" "Info" "Backup" "Removed remote backup host (Host: $host, Type: $type)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete the restic backup host
# options: [NONE]
#
# example: h-delete-backup-host-restic
#
# Deletes the restic backup host configuration and switches the incremental mode off.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

rm -f $HESTIA/conf/restic.conf

$BIN/h-change-sys-config-value 'BACKUP_INCREMENTAL' 'no'

$BIN/h-log-action "system" "Info" "Backup" "Removed remote backup host (Type: Restic)."
log_event "$OK" "$ARGUMENTS"

exit

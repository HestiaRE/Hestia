#!/bin/bash
# info: delete cron job
# options: USER JOB [RESTART]
#
# example: h-delete-cron-job admin 9
#
# Deletes the job and renders the user's crontab again.

user=$1
job=$2
restart=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER JOB [RESTART]'
is_format_valid 'user' 'job' 'restart'
is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'cron' 'JOB' "$job"

suspended=$(grep -F "JOB='$job'" $USER_DATA/cron.conf | grep "SUSPENDED='yes'")
sed -i "/JOB='$job' /d" $USER_DATA/cron.conf

sort_cron_jobs

sync_cron_jobs

decrease_user_value "$user" '$U_CRON_JOBS'

if [ -n "$suspended" ]; then
	decrease_user_value "$user" '$SUSPENDED_CRON'
fi

$BIN/h-restart-cron "$restart"
check_result $? "Restart restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Cron Jobs" "Cron job deleted (ID: $job)."
log_event "$OK" "$ARGUMENTS"

exit

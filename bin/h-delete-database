#!/bin/bash
# info: delete database
# options: USER DATABASE
#
# example: h-delete-database admin admin_wp_db
#
# Deletes the database; its users stay while another database still has them.

user=$1
database=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DATABASE'
is_format_valid 'user' 'database'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

get_database_values
# Held apart: delete_mysql_database overwrites $SUSPENDED.
suspended=$SUSPENDED

# A shared user's password lives in this record; the customer decides which database keeps the user.
# DB_DELETE_SET (h-delete-databases): databases going in the same run need no password kept, or crosswise hashes block.
if [ "$TYPE" = 'mysql' ]; then
	if [ -n "$MD5" ]; then
		db_user_in_use "$DBUSER" mysql "$HOST" "$database" "${DB_DELETE_SET:-}"
		[ $? -eq 1 ] || check_result "$E_INUSE" "$DBUSER is used by another database; give that one its own user first"
	fi
	if [ -n "$DBUSER_SECOND" ] && [ -n "$MD5_SECOND" ]; then
		db_user_in_use "$DBUSER_SECOND" mysql "$HOST" "$database" "${DB_DELETE_SET:-}"
		[ $? -eq 1 ] || check_result "$E_INUSE" "$DBUSER_SECOND is used by another database; give that one its own user first"
	fi
fi

case $TYPE in
	mysql) delete_mysql_database ;;
	pgsql) delete_pgsql_database ;;
esac
# Before the record goes: a database left on the server needs its record to be deleted again.
check_result $? "database $database was not dropped"

remove_line_by_prefix "$USER_DATA/db.conf" "DB='$database'"

decrease_dbhost_values
decrease_user_value "$user" '$U_DATABASES'

if [ -n "$suspended" ]; then
	if [ "$suspended" == "yes" ]; then
		decrease_user_value "$user" '$SUSPENDED_DB'
	fi
fi

$BIN/h-log-action "$user" "Info" "Database" "Deleted database (Name: $database)."
log_event "$OK" "$ARGUMENTS"

exit

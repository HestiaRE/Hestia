#!/bin/bash
# info: delete database server
# options: TYPE HOST
#
# example: h-delete-database-host pgsql localhost
#
# Removes a database server from the pool, refused while databases remain on it.

type=$1
host=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'TYPE HOST'
is_format_valid 'type' 'host'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_type_valid "$DB_SYSTEM" "$type"
is_object_valid "$HESTIA/conf/$type" 'HOST' "$host"
is_dbhost_free

remove_line_by_prefix "$HESTIA/conf/$type.conf" "HOST='$host'"
# The client file with the admin password for this host.
rm -f "$HESTIA/conf/.mysql.$host"
rm -fr $HESTIA'/web/rrd/db/'$type'_'$host'.rrd'
rm -fr $HESTIA'/web/rrd/db/'*-$type'_'$host'.*'

# Only the last host of a type takes it out of DB_SYSTEM; the counterpart of h-add-database-host.
if ! grep -qs "HOST=" "$HESTIA/conf/$type.conf"; then
	rm -f "$HESTIA/conf/$type.conf"
	sys_key_token_set DB_SYSTEM remove "$type" > /dev/null || check_result "$E_UPDATE" "DB_SYSTEM: could not drop $type"
fi

$BIN/h-log-action "system" "Info" "Database" "Removed remote database host (Host: $host, Type: $type)."
log_event "$OK" "$ARGUMENTS"

exit

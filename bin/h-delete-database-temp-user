#!/bin/bash
# info: deletes temp database user
# options: USER DATABASE DBUSER [TYPE] [HOST]
# labels: internal
# caller: the at job h-add-database-temp-user schedules
#
# example: h-delete-database-temp-user admin admin_wp_db hestia_sso_XXXXXXXX mysql
#
# Revokes a hestia_sso_ user's access to DATABASE and drops the user; the counterpart of h-add-database-temp-user.

user=$1
database=$2
dbuser=$3
type=${4-mysql}
host=$5

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER DATABASE DBUSER [TYPE] [HOST]'
is_format_valid 'user' 'database' 'dbuser'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"
is_object_unsuspended 'db' 'DB' "$database"
get_next_dbhost

if [[ $dbuser != *"hestia_sso"* ]]; then
	echo "DBUSER is invalid SSO user"
	exit "$E_INVALID"
fi

get_database_values

delete_mysql_database_temp_user

$BIN/h-log-action "$user" "Info" "Database" "Revoked user access (Database: $database, User: $dbuser)."
log_event "$OK" "$ARGUMENTS"

exit

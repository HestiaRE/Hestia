#!/bin/bash
# info: delete user databases
# options: USER
#
# example: h-delete-databases admin
#
# Deletes all databases of USER.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"

# Handed down whole, so a shared user's password holder is not refused over databases that go with it.
DB_DELETE_SET=$(search_objects 'db' 'SUSPENDED' "*" 'DB' | tr '\n' ' ')
export DB_DELETE_SET
failed=''
for database in $DB_DELETE_SET; do
	$BIN/h-delete-database "$user" "$database" || failed="$failed $database"
done
# h-delete-user goes on to remove the account, so one database left behind must fail the run.
[ -z "$failed" ] || check_result "$E_DB" "not deleted:$failed"

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete user databases
# options: USER
#
# example: h-delete-databases admin
#
# This function deletes all user databases.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Databases without a hash of their own first: the one holding a shared user's password refuses to go while
# another still uses it (#725).
first=''
last=''
for database in $(search_objects 'db' 'SUSPENDED' "no" 'DB'); do
	if [ -z "$(get_object_value 'db' 'DB' "$database" '$MD5')" ]; then
		first="$first $database"
	else
		last="$last $database"
	fi
done
for database in $first $last; do
	$BIN/h-delete-database "$user" "$database"
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

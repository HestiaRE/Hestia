#!/bin/bash
# info: delete web/mail domain
# options: USER DOMAIN [RESTART]
#
# example: h-delete-domain admin domain.tld
#
# This function deletes web/dns/mail domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart="${3-yes}"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Working on Web domain
if [ -n "$WEB_SYSTEM" ]; then
	str=$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)
	if [ -n "$str" ]; then
		domain_found='yes'
		$BIN/h-delete-web-domain "$user" "$domain" 'no'
		check_result $? "can't delete web" > /dev/null
	fi
fi

# Working on Mail domain
if [ -n "$MAIL_SYSTEM" ]; then
	str=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)
	if [ -n "$str" ]; then
		domain_found='yes'
		$BIN/h-delete-mail-domain "$user" "$domain"
		check_result $? "can't delete mail" > /dev/null
	fi
fi

# Checking domain search result
if [ -z "$domain_found" ]; then
	check_result "$E_NOTEXIST" "domain $domain doesn't exist"
fi

# Restarting services
$BIN/h-restart-web "$restart"
check_result $? "can't restart web" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "can't restart proxy" > /dev/null

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

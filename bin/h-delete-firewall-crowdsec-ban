#!/bin/bash
# info: delete a CrowdSec ban decision
# options: IP
#
# example: h-delete-firewall-crowdsec-ban 203.0.113.5
#
# The panel unban path: delete the decision, then refresh the feeder so the drop lifts at once rather than at the
# next timer run. A CAPI decision is not locally deletable and is not shown in the panel.

ip=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'IP'

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Sanity-filtered before it reaches cscli; the panel quoteshellargs it too, this is depth.
if ! fw_is_addr "$ip" && ! fw_is_addr6 "$ip"; then
	check_result "$E_INVALID" "invalid IP: $ip"
fi

command -v cscli > /dev/null 2>&1 || check_result "$E_NOTEXIST" "CrowdSec is not installed"

cscli decisions delete -i "$ip" > /dev/null 2>&1 || check_result "$E_INVALID" "CrowdSec did not remove the ban on $ip"

[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && $BIN/h-update-firewall-crowdsec

$BIN/h-log-action "system" "Info" "Firewall" "Removed CrowdSec ban $ip."
log_event "$OK" "$ARGUMENTS"

exit

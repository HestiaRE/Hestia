#!/bin/bash
# info: remove an ip from the firewall whitelist
# options: IP_CIDR
#
# example: h-delete-firewall-exclude 203.0.113.10
#
# Removing an address only stops it being exempt; it does not ban it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_cidr=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'IP_CIDR'
is_format_valid 'ip_cidr'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

excludes="$CONF_DIR/firewall/excludes.conf"
if ! grep -qxF "$ip_cidr" "$excludes" 2> /dev/null; then
	check_result "$E_NOTEXIST" "IP address $ip_cidr is not whitelisted"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# grep -F to a temp file, not sed -i: a pattern built from an address would treat its dots as wildcards.
tmp="$(mktemp)"
grep -vxF "$ip_cidr" "$excludes" > "$tmp" 2> /dev/null
mv -f "$tmp" "$excludes"
chmod 660 "$excludes"

$BIN/h-update-firewall > /dev/null 2>&1

# fail2ban keeps its own copy, or the jail keeps counting an address the ruleset already exempts.
if [ -n "$FIREWALL_EXTENSION" ] && [ -f "$HESTIA/include/fail2ban.sh" ]; then
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source "$HESTIA/include/fail2ban.sh"
	fail2ban_sync_ignoreip
	systemctl reload-or-restart fail2ban > /dev/null 2>&1
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "Firewall" "Removed IP address $ip_cidr from the whitelist."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete directory
# options: USER DIRECTORY
#
# example: h-delete-fs-directory admin report1
#
# Deletes a directory in the user's home or /tmp, as the user.

user=$1
dst_dir=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DIRECTORY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

homedir=$(awk -F : -v u="$user" '$1 == u {print $6; exit}' /etc/passwd)
if [ -z "$homedir" ]; then
	echo "Error: user home directory doesn't exist"
	exit 12
fi

if ! path_within "$dst_dir" "$homedir" /tmp; then
	echo "Error: invalid destination path $dst_dir"
	exit 1
fi

user_exec rm -rf "$dst_dir"
if [ $? -ne 0 ]; then
	echo "Error: directory $dst_dir was not deleted"
	exit 3
fi

exit

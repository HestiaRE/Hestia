#!/bin/bash
# info: deleting letsencrypt ssl cetificate for domain
# options: USER DOMAIN [RESTART] [MAIL]
#
# example: h-delete-letsencrypt-domain admin acme.com yes
#
# This function turns off letsencrypt SSL support for a domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=$3
mail=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART] [MAIL]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
if [ -z "$mail" ]; then
	is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
	is_system_enabled "$WEB_SSL" 'SSL_SUPPORT'
	is_object_valid 'web' 'DOMAIN' "$domain"
	is_object_unsuspended 'web' 'DOMAIN' "$domain"
	is_object_value_exist 'web' 'DOMAIN' "$domain" '$LETSENCRYPT'
else
	is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
	is_object_valid 'mail' 'DOMAIN' "$domain"
	is_object_unsuspended 'mail' 'DOMAIN' "$domain"
	is_object_value_exist 'mail' 'DOMAIN' "$domain" '$LETSENCRYPT'
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Delete SSL
if [ -z "$mail" ]; then
	$BIN/h-delete-web-domain-ssl "$user" "$domain" "$restart" > /dev/null 2>&1
else
	$BIN/h-delete-mail-domain-ssl "$user" "$domain" "$restart" > /dev/null 2>&1
fi

if [ $? -ne "$E_NOTEXIST" ]; then
	check_result $? "SSL delete" > /dev/null
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating letsencrypt flag
if [ -z "$mail" ]; then
	update_object_value 'web' 'DOMAIN' "$domain" '$LETSENCRYPT' 'no'
else
	update_object_value 'mail' 'DOMAIN' "$domain" '$LETSENCRYPT' 'no'
fi

# Restarting web
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

if [ -n "$PROXY_SYSTEM" ]; then
	$BIN/h-restart-proxy "$restart" > /dev/null
	check_result $? "Proxy restart failed" > /dev/null
fi

if [ -n "$mail" ]; then
	# Restarting mail
	$BIN/h-restart-mail "$restart"
	check_result $? "Mail restart failed" > /dev/null
fi

# Logging
log_event "$OK" "$ARGUMENTS"

exit

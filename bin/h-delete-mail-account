#!/bin/bash
# info: delete mail account
# options: USER DOMAIN ACCOUNT
#
# example: h-delete-mail-account admin acme.com alice
#
# This function deletes email account.

user=$1
domain=$2
account=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN ACCOUNT'
is_format_valid 'user' 'domain' 'account'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	aliases=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$ALIAS')
	IFS=, read -ra _al_list <<< "$aliases"
	for al in "${_al_list[@]}"; do
		[ -n "$al" ] || continue
		# Literal comparisons, not sed patterns: deleting john.doe must not take johnXdoe's lines.
		remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/aliases "$al@$domain_idn:$account"
	done

	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/aliases "$account@$domain_idn:"
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/passwd "$account:"
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/accounts "$account:"
	remove_exact_line $HOMEDIR/$user/conf/mail/$domain/fwd_only "$account"
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/limits "$account@$domain_idn:"
	mail_dir_trusted "$user" "$domain_idn" && rm -rf "$HOMEDIR/$user/mail/$domain_idn/$account"
	mail_autoreply_once_clear "$domain_idn" "$account"
	# exim answers as long as this file exists, a new account of the same name would inherit the text.
	rm -f "$HOMEDIR/$user/conf/mail/$domain/autoreply.$account.msg"
fi
rm -f "$USER_DATA/mail/$account@$domain.msg"

remove_line_by_prefix $USER_DATA/mail/$domain.conf "ACCOUNT='$account'"

accounts=$(wc -l $USER_DATA/mail/$domain.conf | cut -f 1 -d ' ')
decrease_user_value "$user" '$U_MAIL_ACCOUNTS'
update_object_value 'mail' 'DOMAIN' "$domain" '$ACCOUNTS' "$accounts"

# A catch-all into a deleted mailbox makes every unknown address unroutable, while the panel still shows it.
catchall=$(get_object_value 'mail' 'DOMAIN' "$domain" '$CATCHALL')
if [ "$catchall" = "$account@$domain" ] || [ "$catchall" = "$account@$domain_idn" ]; then
	$BIN/h-delete-mail-domain-catchall "$user" "$domain" > /dev/null
fi

$BIN/h-log-action "$user" "Info" "Mail" "Mail account removed (User: $account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete mail account alias aka nickname
# options: USER DOMAIN ACCOUNT ALIAS
#
# example: h-delete-mail-account-alias admin example.com alice alicia
#
# This function deletes email account alias.

user=$1
domain=$2
account=$3
malias=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT ALIAS'
is_format_valid 'user' 'domain' 'account' 'malias'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
aliases=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$ALIAS')
IFS=, read -ra alias_list <<< "$aliases"
found='' aliases=''
for a in "${alias_list[@]}"; do
	if [ "$a" = "$malias" ]; then
		found=yes
	elif [ -n "$a" ]; then
		aliases="${aliases:+$aliases,}$a"
	fi
done
[ -n "$found" ] || check_result "$E_NOTEXIST" "alias $malias doesn't exist"

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/aliases "$malias@$domain_idn:$account"
fi

update_object_value "mail/$domain" 'ACCOUNT' "$account" '$ALIAS' "$aliases"

$BIN/h-log-action "$user" "Info" "Mail" "Mail account alias removed (Alias: $malias, User: $account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

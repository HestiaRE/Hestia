#!/bin/bash
# info: delete mail account autoreply message
# options: USER DOMAIN ACCOUNT
#
# example: h-delete-mail-account-autoreply admin mydomain.tld bob
#
# This function deletes an email accounts autoreply.

user=$1
domain=$2
account=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN ACCOUNT'
is_format_valid 'user' 'domain' 'account'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
# With Sieve the script decides, and the webmail may have switched it on behind a record saying no.
if ! vacation_sieve_on; then
	is_object_value_exist "mail/$domain" 'ACCOUNT' "$account" '$AUTOREPLY'
fi

# The rule is switched off, not removed: the customer's own settings in it survive for next time.
if vacation_sieve_on; then
	vacation_disable "$user" "$domain_idn" "$account"
	rc=$?
	[ "$rc" -eq 3 ] && check_result "$E_FORBIDEN" "$account@$domain keeps its autoreply in a Sieve script the panel does not manage (own script or several vacation rules), change it in the webmail"
	check_result "$rc" "the Sieve script of $account@$domain was not changed"
fi
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f "$(vacation_exim_file "$user" "$domain" "$account")"
	mail_autoreply_once_clear "$domain_idn" "$account"
fi

# Same path h-add-mail-account-autoreply writes; a copy left behind travels in a backup and comes back on restore.
rm -f $USER_DATA/mail/$account@$domain.msg

update_object_value "mail/$domain" 'ACCOUNT' "$account" '$AUTOREPLY' 'no'

$BIN/h-log-action "$user" "Info" "Mail" "Mail account auto-reply removed (User: $account@$domain)."
log_event "$OK" "$ARGUMENTS"

exit

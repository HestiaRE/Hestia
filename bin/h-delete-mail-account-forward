#!/bin/bash
# info: delete mail account forward
# options: USER DOMAIN ACCOUNT FORWARD
#
# example: h-delete-mail-account-forward admin acme.com tony bob@acme.com
#
# Deletes one forward address of the account.

user=$1
domain=$2
account=$3
forward=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '4' "$#" 'USER DOMAIN ACCOUNT FORWARD'
is_format_valid 'user' 'domain' 'account'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
fwd=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD')
# Literal, so whatever the record holds can be removed and nothing else goes with it.
IFS=, read -ra fwd_list <<< "$fwd"
found='' fwd=''
for f in "${fwd_list[@]}"; do
	if [ "$f" = "$forward" ]; then
		found=yes
	elif [ -n "$f" ]; then
		fwd="${fwd:+$fwd,}$f"
	fi
done
[ -n "$found" ] || check_result "$E_NOTEXIST" "forward $forward doesn't exist"

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	remove_line_by_prefix $HOMEDIR/$user/conf/mail/$domain/aliases "$account@$domain_idn:"
	[ -z "$fwd" ] || echo "$account@$domain_idn:$fwd" >> $HOMEDIR/$user/conf/mail/$domain/aliases
	# Forward-only without a forward sends everything to devnull.
	[ -n "$fwd" ] || remove_exact_line $HOMEDIR/$user/conf/mail/$domain/fwd_only "$account"
fi

update_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD' "$fwd"
[ -n "$fwd" ] || update_object_value "mail/$domain" 'ACCOUNT' "$account" '$FWD_ONLY' ''

$BIN/h-log-action "$user" "Info" "Mail" "Mail account forwarding address removed (User: $account@$domain, Send To: $forward)."
log_event "$OK" "$ARGUMENTS"

exit

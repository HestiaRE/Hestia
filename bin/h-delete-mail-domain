#!/bin/bash
# info: delete mail domain
# options: USER DOMAIN
#
# example: h-delete-mail-domain admin mydomain.tld
#
# This function for deleting MAIL domain. By deleting it all accounts will
# also be deleted.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

get_domain_values 'mail'
accounts=$(wc -l "$USER_DATA/mail/$domain.conf" | cut -f 1 -d ' ')

# Before the conf dir goes, and whatever the flag says: SNI links and the dovecot file can outlive SSL='no'.
if [ "$SSL" = 'yes' ]; then
	$BIN/h-delete-mail-domain-ssl "$user" "$domain"
else
	del_mail_ssl_config
	del_mail_ssl_certificates
fi

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f "/etc/$MAIL_SYSTEM/domains/$domain_idn" "/etc/$MAIL_SYSTEM/domains/$domain"
	rm -rf $HOMEDIR/$user/conf/mail/$domain
	mail_dir_trusted "$user" && rm -rf "$HOMEDIR/$user/mail/$domain_idn"
	mail_autoreply_once_clear "$domain_idn"
fi

# Keyed on the front, not WEB_SYSTEM: a mailfront box has none, and a skipped delete leaves a vhost link nginx rejects.
if [ -n "$(webmail_front)" ] || [ -n "$PROXY_SYSTEM" ]; then
	if [ -n "$IMAP_SYSTEM" ]; then
		$BIN/h-delete-mail-domain-webmail "$user" "$domain" 'yes'
	fi
fi

if [ -x "$CONF_DIR/hooks/delete-mail-domain.sh" ]; then
	$CONF_DIR/hooks/delete-mail-domain.sh "$user" "$domain"
fi

# Dots escaped, or a.b.com also drops the aXb.com record.
sed -i "/DOMAIN='${domain//./\\.}'/ d" $USER_DATA/mail.conf
rm -f $USER_DATA/mail/$domain.conf
rm -f $USER_DATA/mail/$domain.pem
rm -f $USER_DATA/mail/$domain.pub
rm -f $USER_DATA/mail/*@$domain.msg

decrease_user_value "$user" '$U_MAIL_DOMAINS'
if [ "$DKIM" = 'yes' ]; then
	decrease_user_value "$user" '$U_MAIL_DKIM'
fi

decrease_user_value "$user" '$U_MAIL_ACCOUNTS' "$accounts"

if [ -n "$SUSPENDED" ]; then
	if [ "$SUSPENDED" == "yes" ]; then
		decrease_user_value "$user" '$SUSPENDED_MAIL'
	fi
fi

$BIN/h-log-action "$user" "Info" "Mail" "Mail domain deleted (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

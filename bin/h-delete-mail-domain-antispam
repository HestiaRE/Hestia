#!/bin/bash
# info: delete mail domain antispam support
# options: USER DOMAIN
#
# example: h-delete-mail-domain-antispam admin mydomain.tld
#
# This function disable spamassasin for incoming emails.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_exist 'mail' 'DOMAIN' "$domain" '$ANTISPAM'

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	# Rejecting is a step of the spam scan, so it goes with it rather than outliving it in the record.
	rm -f "$HOMEDIR/$user/conf/mail/$domain/antispam" "$HOMEDIR/$user/conf/mail/$domain/reject_spam"
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$ANTISPAM' 'no'
update_object_value 'mail' 'DOMAIN' "$domain" '$REJECT' 'no'

$BIN/h-log-action "$user" "Info" "Mail" "Anti-spam protection disabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

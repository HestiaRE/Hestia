#!/bin/bash
# info: delete mail domain antivirus support
# options: USER DOMAIN
#
# example: h-delete-mail-domain-antivirus admin mydomain.tld
#
# This function disables clamav scan for incoming emails.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_value_exist 'mail' 'DOMAIN' "$domain" '$ANTIVIRUS'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Delete antivirus flag
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f $HOMEDIR/$user/conf/mail/$domain/antivirus
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Delete antivirus in config
update_object_value 'mail' 'DOMAIN' "$domain" '$ANTIVIRUS' 'no'

# Logging
$BIN/h-log-action "$user" "Info" "Mail" "Anti-virus scanning disabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

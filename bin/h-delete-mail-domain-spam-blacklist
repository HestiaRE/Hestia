#!/bin/bash
# info: delete sender from per-domain spam blacklist
# options: USER DOMAIN SENDER
#
# example: h-delete-mail-domain-spam-blacklist user domain.tld partner@example.com
#
# Removes SENDER from the domain's spam blacklist; one not on it is no error.

user=$1
domain=$2
sender=$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	MAIL_USER=Debian-exim
else
	MAIL_USER=exim
fi

check_args '3' "$#" 'USER DOMAIN SENDER'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

list_file="$HOMEDIR/$user/conf/mail/$domain/spam_blacklist"
current=$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_BLACKLIST')

new_list=",$current,"
new_list="${new_list/",$sender,"/,}"
new_list="${new_list#,}"
new_list="${new_list%,}"

spam_list_write "$list_file" "$new_list"

add_object_key 'mail' 'DOMAIN' "$domain" 'U_SPAM_BLACKLIST' 'ACCOUNTS'
update_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_BLACKLIST' "$new_list"

$BIN/h-log-action "$user" "Info" "Mail" "Spam blacklist entry removed (Domain: $domain, Sender: $sender)."
log_event "$OK" "$ARGUMENTS"

exit

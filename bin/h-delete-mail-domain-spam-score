#!/bin/bash
# info: delete per-domain spam mark threshold
# options: USER DOMAIN
#
# example: h-delete-mail-domain-spam-score user domain.tld
#
# Removes the per-domain spam mark threshold override; the domain falls back to
# the global SPAM_SCORE default. Idempotent.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

rm -f "$HOMEDIR/$user/conf/mail/$domain/spam_score"

# Old domains may not carry the key at all.
if [ -n "$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_SCORE')" ]; then
	update_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_SCORE' ''
fi

$BIN/h-log-action "$user" "Info" "Mail" "Spam mark threshold reset to server default (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

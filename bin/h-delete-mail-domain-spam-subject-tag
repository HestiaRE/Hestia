#!/bin/bash
# info: delete per-domain spam subject tag
# options: USER DOMAIN
#
# example: h-delete-mail-domain-spam-subject-tag user domain.tld
#
# Removes the spam subject tag; spam subjects are no longer rewritten. Idempotent.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

rm -f "$HOMEDIR/$user/conf/mail/$domain/spam_subject_tag"

# Old domains may not carry the key at all.
if [ -n "$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_SUBJECT_TAG')" ]; then
	update_object_value 'mail' 'DOMAIN' "$domain" '$U_SPAM_SUBJECT_TAG' ''
fi

$BIN/h-log-action "$user" "Info" "Mail" "Spam subject tag removed (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

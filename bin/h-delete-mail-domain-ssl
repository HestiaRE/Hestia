#!/bin/bash
# info: delete mail domain ssl support
# options: USER DOMAIN [RESTART]
#
# example: h-delete-mail-domain-ssl user demo.com
#
# Turns SSL off for the domain's mail and its webmail, and deletes the certificate.

user=$1
domain=$2
restart=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_value_exist 'mail' 'DOMAIN' "$domain" '$SSL'

del_mail_ssl_config
del_mail_ssl_certificates
del_webmail_ssl_config

update_object_value 'mail' 'DOMAIN' "$domain" '$SSL' 'no'
update_object_value 'mail' 'DOMAIN' "$domain" '$LETSENCRYPT' 'no'

$BIN/h-restart-mail "$restart"
check_result $? "Mail restart failed" > /dev/null

# The webmail SSL vhost went with it, and the web server serves it from memory until a reload.
web_restart=$restart
[ "$restart" = 'yes' ] && web_restart=''
$BIN/h-restart-web "$web_restart"
check_result $? "Web restart failed" > /dev/null
$BIN/h-restart-proxy "$web_restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Warning" "Mail" "SSL disabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

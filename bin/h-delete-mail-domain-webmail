#!/bin/bash
# info: delete webmail support for a domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: h-delete-mail-domain-webmail user demo.com
#
# Stops serving webmail for the domain.

user=$1
domain=$2
restart="${3:-yes}"
quiet=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
front=$(webmail_front)
is_system_enabled "$front" 'WEBMAIL front (WEB_SYSTEM/WEBMAIL_FRONT)'
is_system_enabled "$IMAP_SYSTEM" 'IMAP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

if [ -n "$WEBMAIL_ALIAS" ]; then
	del_webmail_config
	del_webmail_ssl_config
	# The nginx webmail templates log under nginx whatever the front is, so the proxy logs go too.
	for logdir in "/var/log/$front/domains" ${PROXY_SYSTEM:+"/var/log/$PROXY_SYSTEM/domains"}; do
		rm -f "$logdir/$WEBMAIL_ALIAS.$domain.log"* "$logdir/$WEBMAIL_ALIAS.$domain.error"*
	done
	# the LAST log leaving must disarm the jails, or the next fail2ban start dies
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	declare -F fail2ban_regate_web_apply > /dev/null 2>&1 || source "$HESTIA/include/fail2ban.sh"
	fail2ban_regate_web_apply

else
	echo "Error: WEBMAIL_ALIAS is not defined in hestia.conf."
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL' ""

if [ -n "$restart" ]; then
	# A removed vhost needs a reload; a restart would cut the panel request asking for it.
	if [ "$restart" = 'yes' ]; then
		restart=''
	fi
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null

	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null
fi

if [ "$quiet" != 'yes' ]; then
	$BIN/h-log-action "$user" "Info" "Mail" "Webmail access disabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

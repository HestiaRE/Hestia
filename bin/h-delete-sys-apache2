#!/bin/bash
# info: remove the apache2 web server (move the web model away from apache2)
# options: [MODE] [--purge] [--force] [--recover]
#
# example: h-delete-sys-apache2 yes
#
# Thin entry point over the shared web-model switch core (include/web-model.sh, #120).
# The model is derived from the resulting component set; MODE omitted/not 'yes'
# previews, 'yes' applies.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/web-model.sh
source $HESTIA/include/web-model.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

web_component_main delete apache2 "$@"
exit

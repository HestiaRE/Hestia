#!/bin/bash
# info: remove the CrowdSec security addon
# options: [FORCE]
#
# example: h-delete-sys-crowdsec
#
# Unwires L3 and the L7 bouncer, then purges the engine. /etc/crowdsec is kept so a re-add reuses the LAPI
# creds, collections and CAPI enrolment. First step of the two-step delete-nginx teardown.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

FORCE=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Trap-restore, so an aborted purge cannot strand /etc/crowdsec under .saved where a re-add never looks.
restore_cs_state() {
	if [ -d /etc/crowdsec.saved ]; then
		rm -rf /etc/crowdsec
		mv /etc/crowdsec.saved /etc/crowdsec
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Guard on the package, not COMPONENT_*: a timed-out install leaves the flag true with a half-wired engine.
source "$HESTIA/include/crowdsec.sh"

if ! dpkg -l crowdsec 2> /dev/null | grep -q '^ii' && [ "$FORCE" != 'yes' ]; then
	echo "ERROR: CrowdSec is not installed. Use FORCE=yes to clean up anyway."
	crowdsec_status_record
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# crowdsec_remove_nginx rewrites and reloads nginx config, so a concurrent web switch must not race it.
# Reentrant, so h-delete-sys-nginx's teardown passes straight through.
web_lock_acquire || exit "$E_INUSE"

# L3 first: with the marker gone, h-update-firewall skips the L3 block on the re-render.
crowdsec_l3_teardown

# L7: remove the nginx bouncer + http glue (the reload happens inside).
crowdsec_remove_nginx

# purge the engine + bouncers (no autoremove: it would rip out shared-stack siblings)
if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /etc/crowdsec.saved
elif [ -d /etc/crowdsec ]; then
	trap restore_cs_state EXIT
	rm -rf /etc/crowdsec.saved
	mv /etc/crowdsec /etc/crowdsec.saved
fi

apt-get -y -qq purge crowdsec > /dev/null 2>&1

restore_cs_state
trap - EXIT
if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /etc/crowdsec
	echo "[ * ] PURGE_DATA=yes - /etc/crowdsec removed."
fi

crowdsec_status_record

# CrowdSec no longer owns L7, so fail2ban's web jails come back on and that model regains its coverage.
if [ "$FIREWALL_EXTENSION" = 'fail2ban' ] && [ -f /etc/fail2ban/jail.d/hestia.local ]; then
	# shellcheck source=/usr/local/hestia/include/fail2ban.sh
	source "$HESTIA/include/fail2ban.sh"
	fail2ban_gate_web_jail
	fail2ban_prune_empty_jails
	systemctl reload-or-restart fail2ban > /dev/null 2>&1
fi

# The per-domain fragments stay as saved state: inert without the http-block zones, restored by a re-add.

echo "CrowdSec has been removed. You can now run h-delete-sys-nginx if the model requires it."

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Removed CrowdSec addon."
log_event "$OK" "$ARGUMENTS"

exit

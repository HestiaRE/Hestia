#!/bin/bash
# info: disable CrowdSec fleet-mesh
# options: NONE
#
# example: h-delete-sys-crowdsec-mesh
#
# Unpairs every peer, drops the imported mesh bans and the mesh config; CrowdSec and its own decisions stay.
# PURGE_DATA=yes also wipes the published and peer lists. Peers keep a dead record for this box until unpaired there.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"
source "$HESTIA/include/crowdsec.sh"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

systemctl disable --now hestia-crowdsec-mesh.timer > /dev/null 2>&1 || true
systemctl stop hestia-crowdsec-mesh.service > /dev/null 2>&1 || true
rm -f /etc/systemd/system/hestia-crowdsec-mesh.service /etc/systemd/system/hestia-crowdsec-mesh.timer
rm -f /etc/tmpfiles.d/hestia-mesh.conf
systemctl daemon-reload

# Unpair first: that is what closes each peer's panel-port ACCEPT rule, which must not outlive the mesh.
if [ -f "$CONF_DIR/crowdsec/peers.conf" ]; then
	# Snapshot the ids: each unpair rewrites the file we would otherwise be iterating.
	for peer in $(sed -n "s/^PEER='\([^']*\)'.*/\1/p" "$CONF_DIR/crowdsec/peers.conf"); do
		$BIN/h-delete-sys-crowdsec-peer "$peer" > /dev/null 2>&1
	done
	rm -f "$CONF_DIR/crowdsec/peers.conf"
fi

# `delete --scenario` is exact-match, not a prefix, so every active per-peer scenario is deleted by name.
if command -v cscli > /dev/null 2>&1 && command -v jq > /dev/null 2>&1; then
	for s in $(cscli decisions list -a -o json 2> /dev/null \
		| jq -r '(if type=="array" then .[] else . end) | (.decisions // [])[] | .scenario // empty
			| select(startswith("hestia-mesh"))' 2> /dev/null | sort -u); do
		cscli decisions delete --scenario "$s" > /dev/null 2>&1 || true
	done
fi

rm -f "$CONF_DIR/crowdsec/mesh.conf" "$CONF_DIR/crowdsec/pairing.conf"
rm -rf /run/hestia/mesh
if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /var/lib/crowdsec/mesh
	echo "[ * ] PURGE_DATA=yes - published/peer lists removed."
fi

echo "CrowdSec fleet-mesh disabled."

crowdsec_status_record
$BIN/h-log-action "system" "Info" "System" "Disabled CrowdSec fleet-mesh."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: unpair a CrowdSec fleet-mesh peer
# options: PEER
#
# example: h-delete-sys-crowdsec-peer node2
#
# Drops the peer record with its tokens, its panel-port rule, staged list and contributed bans. Unpairing is local on
# purpose, so run it on both boxes: the other side keeps a dead peer and its firewall hole until then (its pulls 403).

peer=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/crowdsec-mesh.sh
source $HESTIA/include/crowdsec-mesh.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

check_args '1' "$#" 'PEER'

if ! mesh_load; then
	echo "ERROR: CrowdSec fleet-mesh is not enabled."
	exit "$E_DISABLED"
fi

peer=$(mesh_peer_id "$peer")
if [ ! -f "$MESH_PEERS_CONF" ] || ! grep -qF "PEER='$peer' " "$MESH_PEERS_CONF"; then
	echo "ERROR: peer $peer does not exist."
	exit "$E_NOTEXIST"
fi

mesh_fw_close "$peer"
remove_line_by_prefix "$MESH_PEERS_CONF" "PEER='$peer' "
rm -f "$MESH_PEERS_DIR/$peer.json"

if command -v cscli > /dev/null 2>&1; then
	cscli decisions delete --scenario "hestia-mesh:$peer" > /dev/null 2>&1 || true
fi

mesh_stage_serve
echo "Peer $peer unpaired. Run h-delete-sys-crowdsec-peer on that box too."

$BIN/h-log-action "system" "Info" "System" "CrowdSec mesh peer removed (Peer: $peer)."
log_event "$OK" "$ARGUMENTS"

exit

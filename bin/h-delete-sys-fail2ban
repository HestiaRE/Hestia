#!/bin/bash
# info: remove the fail2ban brute-force protection addon
# options: [FORCE]
#
# example: h-delete-sys-fail2ban
#
# Stop, drop the chains, clear FIREWALL_EXTENSION, re-render, purge. Nothing is kept as saved state - our
# config re-renders from share/ - and the admin's own jail.local is never touched. PURGE_DATA=yes wipes /etc.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

FORCE=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Guard on the package, not COMPONENT_*: a timed-out install leaves the flag true with no daemon.
if ! dpkg -l fail2ban 2> /dev/null | grep -q '^ii' && [ "$FORCE" != 'yes' ]; then
	echo "ERROR: fail2ban is not installed. Use FORCE=yes to clean up anyway."
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Stop the daemon, drop the live chains/jumps + our config (banlist records go too).
source "$HESTIA/include/fail2ban.sh"
fail2ban_teardown

# Clear the key first so the re-render skips the fail2ban block, then re-render the base ruleset.
$BIN/h-change-sys-config-value "FIREWALL_EXTENSION" ""
$BIN/h-update-firewall

# purge the package (its prerm stop is a no-op now - the daemon is already down)
apt-get -y -qq purge fail2ban > /dev/null 2>&1

if [ "${PURGE_DATA:-}" = "yes" ]; then
	rm -rf /etc/fail2ban
	echo "[ * ] PURGE_DATA=yes - /etc/fail2ban removed."
fi

# Nothing enforces the auth families now unless CrowdSec takes them to L3, and its denylist keys off the
# key just cleared - so refresh, or a crowdsec-only box detects SSH brute force and enforces nothing for 45s.
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && $BIN/h-update-firewall-crowdsec

# CrowdSec takes brute force back: re-install the ssh scenarios it drops while fail2ban is around.
if dpkg -l crowdsec 2> /dev/null | grep -q '^ii'; then
	# shellcheck source=/usr/local/hestia/include/crowdsec.sh
	source "$HESTIA/include/crowdsec.sh"
	crowdsec_gate_bruteforce
fi

echo "fail2ban has been removed."

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Warning" "System" "Removed fail2ban addon."
log_event "$OK" "$ARGUMENTS"

exit

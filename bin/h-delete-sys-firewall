#!/bin/bash
# info: delete system firewall
# options: NONE
#
# example: h-delete-sys-firewall
#
# Disables the firewall and stops it; the rule files stay for a later h-add-sys-firewall.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ -z "$FIREWALL_SYSTEM" ]; then
	exit
fi

$BIN/h-change-sys-config-value "FIREWALL_SYSTEM" ""

$BIN/h-stop-firewall

$BIN/h-log-action "system" "Warning" "Firewall" "System firewall disabled."
log_event "$OK" "$ARGUMENTS"

exit

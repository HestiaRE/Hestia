#!/bin/bash
# info: delete a dnsbl host
# options: HOST [RESTART]
#
# example: h-delete-sys-mail-dnsbl zen.spamhaus.org
#
# This function removes a DNSBL server from the list exim checks.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
host=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

DNSBL_CONF="/etc/exim4/dnsbl.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'HOST [RESTART]'
if [[ ! "$host" =~ ^[a-zA-Z0-9.-]+(!=[0-9.,]+)?$ ]]; then
	check_result "$E_INVALID" "invalid dnsbl host format :: $host"
fi
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'

if [ ! -f "$DNSBL_CONF" ] || ! grep -qxF -- "$host" "$DNSBL_CONF"; then
	check_result "$E_NOTEXIST" "dnsbl host $host doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# grep -vxF, not sed: the host may contain '.' and exim's '!=' filter, both of which a sed pattern
# would reinterpret - and an unanchored match would take neighbouring entries with it.
tmp=$(mktemp)
grep -vxF -- "$host" "$DNSBL_CONF" > "$tmp"
cat "$tmp" > "$DNSBL_CONF"
rm -f "$tmp"
chmod 644 "$DNSBL_CONF"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
"$BIN/h-log-action" "system" "Info" "Mail" "DNSBL host removed (Host: $host)."
log_event "$OK" "$ARGUMENTS"

# No restart, RESTART stays only for the signature: exim reads the list for every message.

exit

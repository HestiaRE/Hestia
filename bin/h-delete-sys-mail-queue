#!/bin/bash
# info: delete exim mail queue
# options: NONE
#
# example: h-delete-sys-mail-queue
#
# Asks before removing every message in the exim queue; interactive only.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
message_count=$(exim -bpc)

answer=''
if [ "$message_count" -gt 0 ]; then
	read -p "Are you sure you want to delete $message_count messages from the exim queue? [y/N] " answer
fi
if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
	exit
fi
# exipick, not exiqgrep: exiqgrep -i without a selection prints its help and lists no message.
rm_rc=0
exipick -i | xargs -r exim -Mrm > /dev/null || rm_rc=$?
left=$(exim -bpc)

$BIN/h-log-action "system" "Info" "System" "Mail queue ($message_count) has been deleted, $left left"
[ "$rm_rc" -eq 0 ] || check_result "$E_UPDATE" "not every message could be deleted, exim -bp lists what is left"
log_event "$OK" "$ARGUMENTS"

exit

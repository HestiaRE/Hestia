#!/bin/bash
# info: delete exim mail queue
# options: NONE
#
# example: h-delete-sys-mail-queue
#
# Asks before removing every message in the exim queue; interactive only.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
message_count=$(exim -bpc)

answer=''
if [ "$message_count" -gt 0 ]; then
	read -p "Are you sure you want to delete $message_count messages from the exim queue? [y/N] " answer
fi
if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
	exit
fi
exiqgrep -i | xargs -r exim -Mrm

$BIN/h-log-action "system" "Info" "System" "Mail queue ($message_count) has been deleted"
log_event "$OK" "$ARGUMENTS"

exit

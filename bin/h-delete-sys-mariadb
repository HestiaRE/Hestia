#!/bin/bash
# info: remove MariaDB database server
# options: NONE
#
# example: h-delete-sys-mariadb
#
# Counterpart to h-add-sys-mariadb; phpMyAdmin goes with it. Refuses while customer databases remain.
# The datadir is kept. FORCE=yes skips the database check; PURGE_DATA=yes also wipes /var/lib/mysql.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if ! dpkg -l mariadb-server 2> /dev/null | grep -q '^ii'; then
	echo "ERROR: MariaDB is not installed."
	# a key without the package is drift; the delete owns the key, so it clears it before leaving
	mariadb_status_record
	exit "$E_NOTEXIST"
fi

records_unread=''
records=$(db_host_records mysql localhost) || records_unread='yes'
# unix_socket lets root in without /root/.my.cnf
databases_unread=''
databases=$(mariadb -N -e "SHOW DATABASES;" 2> /dev/null) || databases_unread='yes'
webmail_dbs=$(grep -xE 'roundcube|tachyon' <<< "$databases" | tr '\n' ' ')
if [ "${FORCE:-}" != "yes" ]; then
	# A stopped server is the state after a failed upgrade; counting 0 there would let the guard pass blind.
	if [ -n "$databases_unread" ]; then
		echo "ERROR: MariaDB does not answer, so its databases cannot be counted."
		echo "       Start it, or re-run with FORCE=yes."
		exit "$E_CONNECT"
	fi
	if [ -n "$records_unread" ]; then
		echo "ERROR: no customer records could be read, so the databases on localhost cannot be counted."
		echo "       Re-run with FORCE=yes."
		exit "$E_PARSING"
	fi
	# system schemas and app-owned databases; keep this list in step when a bundled app gets its own database
	live_db=$(grep -vxE 'information_schema|performance_schema|mysql|sys|phpmyadmin|roundcube|tachyon' <<< "$databases" \
		| grep -c .)
	if [ "$records" != "0" ] || [ "${live_db:-0}" != "0" ]; then
		echo "ERROR: MariaDB still hosts customer databases (records=$records, live=${live_db:-0})."
		echo "       Delete them first, or re-run with FORCE=yes."
		exit "$E_INUSE"
	fi
	if [ "${PURGE_DATA:-}" = "yes" ] && [ -n "$webmail_dbs" ]; then
		echo "ERROR: PURGE_DATA=yes would wipe the webmail database(s) ${webmail_dbs% }."
		echo "       Remove the webmail first, or re-run with FORCE=yes."
		exit "$E_INUSE"
	fi
fi
[ -z "$webmail_dbs" ] || echo "[ ! ] Webmail keeps its database here (${webmail_dbs% }); it is down until MariaDB is added back."
dlm_repo=''
[ ! -f /etc/apt/sources.list.d/mariadb.list ] || dlm_repo='yes'

# SSO first: h-delete-sys-phpmyadmin refuses while it is on
$BIN/h-delete-sys-pma-sso > /dev/null 2>&1 || true
$BIN/h-delete-sys-phpmyadmin > /dev/null 2>&1 || true

# h-delete-database-host refuses while database records point at localhost
if ! host_out=$($BIN/h-delete-database-host mysql localhost 2>&1); then
	echo "[ ! ] localhost stays registered, its database records stay until MariaDB is added back: $(head -n1 <<< "$host_out")"
fi

# no autoremove: it would take shared-stack siblings with it
echo "[ * ] Removing MariaDB packages..."
systemctl disable --now mariadb > /dev/null 2>&1 || true
# The client stays: a registered remote host survives, and h-add-database-host and backup dumps need it.
DEBIAN_FRONTEND=noninteractive apt-get -y -qq purge \
	mariadb-server > /dev/null 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get -y -qq install mariadb-client > /dev/null 2>&1 || true

rm -f /etc/apt/sources.list.d/mariadb.list /usr/share/keyrings/mariadb-keyring.gpg
[ -z "$dlm_repo" ] || echo "[ ! ] mariadb-client stays on its MariaDB.org version, which gets no updates without that repository."
rm -f /root/.my.cnf

# kept by default so a re-add finds the databases
if [ "${PURGE_DATA:-}" = "yes" ]; then
	echo "[ * ] PURGE_DATA=yes — wiping /var/lib/mysql..."
	rm -rf /var/lib/mysql
fi

$BIN/h-change-sys-config-value 'DB_PMA_ALIAS' '' > /dev/null 2>&1 || true
mariadb_status_record

echo "[ OK ] MariaDB removed.$([ "${PURGE_DATA:-}" = "yes" ] && echo '' || echo ' (datadir kept — PURGE_DATA=yes to wipe)')"

$BIN/h-log-action "system" "Info" "System" "MariaDB removed."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: remove the nginx web server (move the web model away from nginx)
# options: [MODE] [--purge] [--force] [--recover]
#
# example: h-delete-sys-nginx yes
#
# Thin entry point over the shared web-model switch core (include/web-model.sh, #120).
# The model is derived from the resulting component set; MODE omitted/not 'yes'
# previews, 'yes' applies. New h-* command: no v-* symlink.

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/web-model.sh
source $HESTIA/include/web-model.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# CrowdSec is nginx-only and stays that way - apache is not a supported front for it, so
# moving the model off nginx would strand it. Refuse until the addon is torn down first
# (h-delete-sys-crowdsec, #123) - a deliberate two-step teardown (#186), never automatic:
# the removal must be the operator's explicit act, because it discards state.
# Artefact- and status-based, so a half-install trips: the nginx glue file OR the status key, which the
# engine writes and a delete clears. Not the recipe, which says what was chosen, not what is there (#945).
if [ -f /etc/nginx/conf.d/crowdsec_init.conf ] || [ -n "$CROWDSEC_SYSTEM" ]; then
	# One message, not a series of echoes: check_result writes the first line itself, and
	# separate echoes interleave with it in the terminal
	msg="CrowdSec is active and only supports nginx; apache-only cannot run it."
	msg="$msg\n       Remove it first, then retry:  h-delete-sys-crowdsec"
	msg="$msg\n       This discards the local decision database, the ban history and, if"
	msg="$msg\n       enrolled, the CAPI/console registration - a later install starts fresh."
	if [ "$FIREWALL_EXTENSION" != 'fail2ban' ]; then
		msg="$msg\n       That leaves the box without L3 blocking: consider h-add-sys-fail2ban"
		msg="$msg\n       as the replacement before removing CrowdSec."
	fi
	check_result "$E_INUSE" "$(echo -e "$msg")"
fi

web_component_main delete nginx "$@"
exit

#!/bin/bash
# info: remove PostgreSQL database server
# options: NONE
#
# example: h-delete-sys-postgresql
#
# Counterpart to h-add-sys-postgresql. Refuses while customer DBs exist (counter +
# live pg_database check). Datadir kept by default. Packages are versioned, so the
# installed major (server + client) is purged explicitly, not just the metapackage.
# Opt-ins: FORCE=yes skips the DB check; PURGE_DATA=yes drops the datadir + config.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Not installed?
if ! dpkg -l postgresql 2> /dev/null | grep -q '^ii'; then
	echo "ERROR: PostgreSQL is not installed."
	change_sys_value "DB_POSTGRESQL_SYSTEM" ""
	exit "$E_NOTEXIST"
fi

# Refuse while customer databases exist (unless FORCE=yes). Counter + live check
# (templates and the default 'postgres' maintenance DB are not customer data).
if [ "${FORCE:-}" != "yes" ]; then
	u_db_bases=$(record_field "$(grep "^HOST='localhost' " "$HESTIA/conf/pgsql.conf" 2> /dev/null)" U_DB_BASES)
	# A cluster that is not ready would count 0 and let the guard pass without having looked.
	if ! live_dbs=$(cd /tmp && sudo -u postgres psql -tAXc \
		"SELECT datname FROM pg_database WHERE datistemplate=false AND datname<>'postgres';" 2> /dev/null); then
		echo "ERROR: PostgreSQL does not answer, so its databases cannot be counted."
		echo "       Start it, or re-run with FORCE=yes."
		exit "$E_CONNECT"
	fi
	live_db=$(grep -c . <<< "$live_dbs")
	if [ "${u_db_bases:-0}" != "0" ] || [ "${live_db:-0}" != "0" ]; then
		echo "ERROR: PostgreSQL still hosts customer databases (counter=${u_db_bases:-0}, live=${live_db:-0})."
		echo "       Delete them first, or re-run with FORCE=yes."
		exit "$E_INUSE"
	fi
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# deregister the local host (strips DB_SYSTEM's pgsql token); it refuses while database records point at it
if ! host_out=$($BIN/h-delete-database-host pgsql localhost 2>&1); then
	echo "[ ! ] localhost stays registered, its database records stay until PostgreSQL is added back: $(head -n1 <<< "$host_out")"
fi

# purge the installed major explicitly (versioned packages — the metapackage isn't enough)
echo "[ * ] Removing PostgreSQL packages..."
PG_MAJOR=$(pg_lsclusters -h 2> /dev/null | awk 'NR==1{print $1}')
systemctl disable --now "postgresql@${PG_MAJOR}-main" > /dev/null 2>&1 || true
systemctl disable --now postgresql > /dev/null 2>&1 || true
# Same rule as MariaDB: the server goes, the client stays for a remote host and its dumps.
_pkgs="postgresql postgresql-contrib"
[ -n "$PG_MAJOR" ] && _pkgs="$_pkgs postgresql-$PG_MAJOR"
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get -y -qq purge $_pkgs > /dev/null 2>&1 || true
DEBIAN_FRONTEND=noninteractive apt-get -y -qq install postgresql-client > /dev/null 2>&1 || true

# datadir/config kept by default (a re-add reuses the cluster); opt-in wipe
if [ "${PURGE_DATA:-}" = "yes" ]; then
	echo "[ * ] PURGE_DATA=yes — dropping cluster datadir + config..."
	rm -rf /var/lib/postgresql /etc/postgresql
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

change_sys_value "DB_POSTGRESQL_SYSTEM" ""

echo "[ OK ] PostgreSQL removed.$([ "${PURGE_DATA:-}" = "yes" ] && echo '' || echo ' (datadir kept — PURGE_DATA=yes to drop)')"

$BIN/h-log-action "system" "Info" "System" "PostgreSQL removed."
log_event "$OK" "$ARGUMENTS"

exit

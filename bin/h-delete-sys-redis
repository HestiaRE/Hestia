#!/bin/bash
# info: remove Redis as a general service
# options: NONE
#
# example: h-delete-sys-redis
#
# Ends Redis as a general service. With rspamd it stays as the capped Bayes store, data kept; without, it is purged.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

limit_marker='HestiaRE rspamd-bayes limit'

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Decided by the box, like the add, never by the recipe.
if ! dpkg -l redis-server 2> /dev/null | grep -q '^ii' || grep -q "$limit_marker" /etc/redis/redis.conf 2> /dev/null; then
	echo "ERROR: Redis is not installed as a general service."
	change_sys_value "REDIS_SYSTEM" ""
	exit "$E_NOTEXIST"
fi

if [ "$ANTISPAM_SYSTEM" = "rspamd" ]; then
	# volatile-ttl evicts only once the cap is hit, so the Bayes data survives.
	if ! grep -q "$limit_marker" /etc/redis/redis.conf 2> /dev/null; then
		cat "$HESTIA/share/rspamd/redis-rspamd-limit.conf" >> /etc/redis/redis.conf
	fi
	systemctl restart redis-server
	if ! systemctl is-active --quiet redis-server; then
		echo "ERROR: redis-server failed to restart with the rspamd cap."
		exit "$E_RESTART"
	fi
	echo "rspamd is installed — Redis kept as its hard-capped Bayes companion (demoted, not uninstalled)."
else
	systemctl disable --now redis-server > /dev/null 2>&1
	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq purge redis-server > /dev/null 2>&1
	if dpkg-query -W -f='${db:Status-Status}\n' redis-server 2> /dev/null | grep -qx installed; then
		systemctl enable --now redis-server > /dev/null 2>&1
		check_result "$E_UPDATE" "redis-server purge failed, nothing else changed"
	fi
	echo "Redis has been uninstalled."
fi

change_sys_value "REDIS_SYSTEM" ""

$BIN/h-log-action "system" "Info" "System" "Removed Redis as a general service."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: Remove Roundcube webmail client
# options: NONE
#
# example: h-delete-sys-roundcube
#
# Removes Roundcube, its database and the panel integration. Also cleans up after a failed install.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

RC_CONFIG_DIR="/etc/roundcube"

if [ "$(id -u)" != '0' ]; then
	echo "ERROR: h-delete-sys-roundcube must be run as root"
	exit 10
fi

# Any artefact is enough: the hint of a failed h-add-sys-roundcube sends the admin here before the token exists.
if [[ ",$WEBMAIL_SYSTEM," != *,roundcube,* ]] && [ ! -e /etc/php/hestia/fpm/pool.d/roundcube.conf ] \
	&& [ ! -e /etc/caddy/webmail-roundcube.conf ] && [ ! -e "$RC_CONFIG_DIR" ]; then
	echo "ERROR: Roundcube is not installed."
	exit 1
fi

# Both DB backend packages are listed, apt purges the one that is installed.
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y purge \
	roundcube roundcube-core roundcube-mysql roundcube-sqlite3 roundcube-plugins
# No autoremove: it acts on every orphan of the box, not on what this purge left.

# Intentional data loss: UI prefs and contacts go (mail lives in Dovecot), nothing carries over a delete and re-add.
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	db_client="mysql"
	[ -x /usr/bin/mariadb ] && db_client="mariadb"

	$db_client -e "DROP DATABASE IF EXISTS \`roundcube\`"
	$db_client -e "DROP USER IF EXISTS 'roundcube'@'localhost'"
	$db_client -e "FLUSH PRIVILEGES"
fi
# The SQLite backend's database, if that was the recorded backend.
rm -rf /var/lib/roundcube/db

# Holds the DB password.
rm -f "$RC_CONFIG_DIR/debian-db.php"

# Ours, not dpkg's: the purge leaves them.
rm -f "/usr/share/roundcube/plugins/password/drivers/hestia.php"
rm -f /usr/share/roundcube/plugins/{newmail_notifier,zipdownload}/config.inc.php

# What the add created beside the package: the purge leaves non-empty dirs, the login log holds customer addresses.
rm -rf /etc/php/hestia/roundcube-cli /var/log/roundcube /var/lib/roundcube/temp
rmdir /var/lib/roundcube 2> /dev/null

rm -rf "$RC_CONFIG_DIR"

# Ours goes, and the package gets its diverted fragment back.
rm -f /etc/logrotate.d/roundcube
if dpkg-divert --list /etc/logrotate.d/roundcube-core | grep -q 'roundcube-core'; then
	dpkg-divert --quiet --local --rename --remove /etc/logrotate.d/roundcube-core
fi
rmdir "$CONF_DIR/diverted" 2> /dev/null

# The User=caddy drop-ins for the packaged maintenance timers; the units went with the purge.
rm -rf /etc/systemd/system/roundcube-gc.service.d /etc/systemd/system/roundcube-cleandb.service.d
systemctl daemon-reload

rm -f /etc/caddy/webmail-roundcube.conf
rm -f /etc/caddy/apps/webmail.conf
systemctl try-restart caddy > /dev/null 2>&1 || true
rm -f /etc/php/hestia/fpm/pool.d/roundcube.conf
systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true

sys_key_token_set WEBMAIL_SYSTEM remove roundcube > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not drop roundcube"

# A domain recorded with roundcube now renders the 'disabled' vhost, even when Tachyon is installed.
$BIN/h-update-mail-templates yes > /dev/null 2>&1 \
	|| echo "Warning: not every mail domain was re-rendered, h-update-mail-templates names them."

$BIN/h-log-action "system" "Info" "Plugins" "Roundcube removed."
# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

#!/bin/bash
# info: delete system sftp jail
# options: NONE
#
# example: h-delete-sys-sftp-jail
#
# Reverses h-add-sys-sftp-jail (#413): Match block, PAM wiring, namespace.conf entry,
# iscript, tmpfiles mountpoint; restores the plain sftp subsystem. The sftp-jailed
# group is left in place (keeps membership for a re-add).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

config='/etc/ssh/sshd_config'
pam='/etc/pam.d/sshd'
nsconf='/etc/security/namespace.conf'
nsinit='/etc/security/namespace.d/hestia-jail.init'

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

cp $config $config.bak

# Token off, then the Subsystem line follows the remaining token set (#941); sshd restarts below anyway
sys_key_token_set JAIL_SYSTEM remove sftp > /dev/null || check_result "$E_UPDATE" "JAIL_SYSTEM: could not drop sftp"
jail_sshd_subsystem_apply > /dev/null

# Drop the "# Hestia SFTP Chroot" block (marker + following Match/indented lines)
if grep -q "^# Hestia SFTP Chroot" $config; then
	awk '
		/^# Hestia SFTP Chroot$/ { skip=1; next }
		skip && (/^Match / || /^[[:space:]]/) { next }
		skip { skip=0 }
		{ print }
	' "$config" > "$config.hst" && cat "$config.hst" > "$config" && rm -f "$config.hst"
	restart='yes'
fi

# Remove the pam_namespace wiring (our two lines + the comment/blank we added)
if grep -q 'pam_namespace.so' "$pam" 2> /dev/null; then
	sed -i '/# HestiaRE SFTP jail (#413)/d; /pam_succeed_if.so quiet user notingroup sftp-jailed/d; /session required     pam_namespace.so/d' "$pam"
fi

# Remove the namespace.conf entry, iscript, and tmpfiles.d mountpoint
sed -i '\#^/run/hestia/jail[[:space:]]#d' "$nsconf" 2> /dev/null
rm -f "$nsinit"
rm -f /etc/tmpfiles.d/hestia-jail.conf
# /run/hestia/jail itself is tmpfs and vanishes on reboot; drop it now too
rm -rf /run/hestia/jail /run/hestia/jail-inst 2> /dev/null

# Validate + restart
if ! /usr/sbin/sshd -t > /dev/null 2>&1; then
	subj="OpenSSH restart failed"
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf" 2> /dev/null | cut -f 2 -d \')
	mail_text="OpenSSH can not be restarted. Please check config:
            \n\n$(/usr/sbin/sshd -t 2>&1)"
	[ -n "$email" ] && echo -e "$mail_text" | $SENDMAIL -s "$subj" $email
	echo "ERROR: sshd config invalid after SFTP jail removal, restored backup."
	cp $config.bak $config
	sys_key_token_set JAIL_SYSTEM add sftp > /dev/null 2>&1
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi
service ssh restart > /dev/null 2>&1

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Warning" "Plugins" "SFTP Chroot Jail disabled."
log_event "$OK" "$ARGUMENTS"

exit

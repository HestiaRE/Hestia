#!/bin/bash
# info: remove sieve mail filtering
# options: NONE
#
# example: h-delete-sys-sieve
#
# Unwires and uninstalls sieve: exim's SIEVE macro back to inert, sieve packages purged, and
# 15-lda.conf restored to the base variant (it belongs to dovecot-core, so the purge does not bring
# it back). On dovecot 2.4 the sieve package itself STAYS - core depends on it there - and only its
# configuration goes. Per-account scripts stay in the maildirs.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if [ "$SIEVE_SYSTEM" != 'yes' ]; then
	echo "ERROR: sieve is not installed."
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Unwire exim first: clean local delivery back to the appendfile transport
sed -i 's/^SIEVE = yes/#SIEVE = yes/' /etc/exim4/exim4.conf.template
systemctl restart exim4
if ! systemctl is-active --quiet exim4; then
	echo "ERROR: exim4 failed to restart without sieve delivery."
	exit "$E_RESTART"
fi

# remove the sieve configs BEFORE purging: they are maintainer-script managed, and
# the purge's dovecot restart would fail while sieve settings are still referenced
rm -f /etc/dovecot/conf.d/20-managesieve.conf \
	/etc/dovecot/conf.d/90-sieve.conf \
	/etc/dovecot/conf.d/90-sieve-extprograms.conf \
	/etc/dovecot/conf.d/91-imapsieve.conf

# Before the restart: the rules are gone, so the plugin and the group go with them.
sieve_mail_group_del
sieve_learn_remove
sieve_imap_plugin_del
# 15-lda.conf belongs to dovecot-core — restore the base (non-sieve) variant
DOVECOT_VER=$(dovecot --version 2> /dev/null | cut -d. -f1,2 || echo "2.3")
if [ "$(printf '%s\n2.4' "$DOVECOT_VER" | sort -V | head -1)" = "2.4" ]; then
	DCDIR="$HESTIA/share/dovecot/2.4"
else
	DCDIR="$HESTIA/share/dovecot/2.3"
fi
cp -f "$DCDIR/conf.d/15-lda.conf" /etc/dovecot/conf.d/

systemctl restart dovecot
if ! systemctl is-active --quiet dovecot; then
	echo "ERROR: dovecot failed to restart without sieve."
	exit "$E_RESTART"
fi

# On dovecot 2.4 core DEPENDS on dovecot-sieve, so purging sieve takes core, imapd and pop3d with
# it - the whole mail server, for removing an optional addon. Read from the dependency and not from
# a version number: the packaging is what changes here.
purge_pkgs='dovecot-managesieved dovecot-sieve'
if apt-cache show dovecot-core 2> /dev/null | grep -qE '^Depends:.*[ ,]dovecot-sieve[ ,(]'; then
	purge_pkgs='dovecot-managesieved'
	echo "NOTE: dovecot-core requires dovecot-sieve on this release - the package stays, its configuration does not."
fi
# shellcheck disable=SC2086  # deliberate word splitting: one or two package names
apt-get -y -qq purge $purge_pkgs > /dev/null 2>&1

# no autoremove: it would rip out shared-stack siblings (deb13 autoremoved dovecot-core).
systemctl start dovecot 2> /dev/null || true
if ! systemctl is-active --quiet dovecot; then
	echo "ERROR: dovecot did not come back up after the sieve purge."
	exit "$E_RESTART"
fi

$BIN/h-change-sys-config-value 'SIEVE_SYSTEM' ''

# Take the filter screens away with the service. A UI whose backend stopped answering is worse
# than no UI: it fails at the first save, with an error nobody can act on.
webmail_sieve_apply

echo "sieve has been removed (stored scripts remain in the maildirs)."

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "Removed sieve mail filtering."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: remove sieve mail filtering
# options: NONE
#
# example: h-delete-sys-sieve
#
# Moves the autoreplies back to exim and removes sieve. On dovecot 2.4 the sieve package stays, core
# depends on it. Per-account scripts stay in the maildirs and no longer run.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/sieve.sh
source $HESTIA/include/sieve.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if [ "$SIEVE_SYSTEM" != 'yes' ]; then
	echo "ERROR: sieve is not installed."
	exit "$E_NOTEXIST"
fi

# While doveadm can still write the scripts: exim takes over every vacation that is on right now.
vacation_rc=0
vacation_all exim || vacation_rc=1

# exim first: clean local delivery goes back to the appendfile transport.
sed -i 's/^SIEVE = yes/#SIEVE = yes/' /etc/exim4/exim4.conf.template
systemctl restart exim4
if ! systemctl is-active --quiet exim4; then
	echo "ERROR: exim4 failed to restart without sieve delivery."
	exit "$E_RESTART"
fi

# Before the purge: its dovecot restart fails while the config still names sieve settings.
rm -f /etc/dovecot/conf.d/20-managesieve.conf \
	/etc/dovecot/conf.d/90-sieve.conf \
	/etc/dovecot/conf.d/90-sieve-extprograms.conf \
	/etc/dovecot/conf.d/91-imapsieve.conf \
	/etc/dovecot/conf.d/25-lmtp.conf

# Before the restart: the rules are gone, so the plugin and the group go with them.
sieve_mail_group_del
sieve_learn_remove
sieve_imap_plugin_del
# 15-lda.conf belongs to dovecot-core, so the purge does not bring the base variant back.
DOVECOT_VER=$(dovecot --version 2> /dev/null | cut -d. -f1,2 || echo "2.3")
if [ "$(printf '%s\n2.4' "$DOVECOT_VER" | sort -V | head -1)" = "2.4" ]; then
	DCDIR="$HESTIA/share/dovecot/2.4"
else
	DCDIR="$HESTIA/share/dovecot/2.3"
fi
cp -f "$DCDIR/conf.d/15-lda.conf" /etc/dovecot/conf.d/

systemctl restart dovecot
if ! systemctl is-active --quiet dovecot; then
	echo "ERROR: dovecot failed to restart without sieve."
	exit "$E_RESTART"
fi

# Where dovecot-core depends on dovecot-sieve, purging sieve would take the whole mail server with it.
# Read from the dependency, not a version number: the packaging is what changes.
# lmtpd goes in both branches: dovecot-core only Suggests it.
purge_pkgs='dovecot-managesieved dovecot-sieve dovecot-lmtpd'
if apt-cache show dovecot-core 2> /dev/null | grep -qE '^Depends:.*[ ,]dovecot-sieve[ ,(]'; then
	purge_pkgs='dovecot-managesieved dovecot-lmtpd'
	echo "NOTE: dovecot-core requires dovecot-sieve on this release - the package stays, its configuration does not."
fi
# shellcheck disable=SC2086  # deliberate word splitting: one or two package names
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -y -qq purge $purge_pkgs > /dev/null 2>&1

# no autoremove: it would rip out shared-stack siblings such as dovecot-core.
systemctl start dovecot 2> /dev/null || true
if ! systemctl is-active --quiet dovecot; then
	echo "ERROR: dovecot did not come back up after the sieve purge."
	exit "$E_RESTART"
fi

$BIN/h-change-sys-config-value 'SIEVE_SYSTEM' ''

# The filter screens go too: without a backend they fail at the first save, with nothing to act on.
webmail_sieve_apply

echo "sieve has been removed (stored scripts remain in the maildirs)."

$BIN/h-log-action "system" "Info" "System" "Removed sieve mail filtering."

# Filters and forwards stop with the service, by design; the admin learns how many.
scripts=$(find "$HOMEDIR"/*/mail -mindepth 3 -maxdepth 3 -name dovecot.sieve 2> /dev/null | wc -l)
[ "$scripts" -eq 0 ] || echo "NOTE: $scripts mailboxes keep a Sieve script, its filters and forwards no longer run."
[ "$vacation_rc" -eq 0 ] || check_result "$E_UPDATE" "not every autoreply was moved back to exim, see the warnings above"
log_event "$OK" "$ARGUMENTS"

exit

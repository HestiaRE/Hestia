#!/bin/bash
# info: delete system ssh jail
# options: NONE
#
# example: h-delete-sys-ssh-jail
#
# This function disables ssh jailed environment

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Unregister /usr/sbin/jailbash
sed -i "/\/usr\/sbin\/jailbash/d" /etc/shells

# Remove jailbash from /usr/sbin
if [ -x /usr/sbin/jailbash ]; then
	rm -f /usr/sbin/jailbash
	rm -f /etc/apparmor.d/bwrap-userns-restrict

	service apparmor reload > /dev/null 2>&1
fi

# Token off, then the Subsystem line follows the remaining token set (#941)
sys_key_token_set JAIL_SYSTEM remove ssh > /dev/null || check_result "$E_UPDATE" "JAIL_SYSTEM: could not drop ssh"
[ "$(jail_sshd_subsystem_apply)" = changed ] && service ssh restart > /dev/null 2>&1

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Warning" "Plugins" "SSH Chroot Jail disabled."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: Delete Tachyon webmail client
# options: None
#
# This function removes the Tachyon webmail client.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# live component state (COMPONENT_MAIL_WEBMAILER), if present
[ -f "$CONF_DIR/install.conf" ] && source "$CONF_DIR/install.conf"

# Folder paths
TX_INSTALL_DIR="/var/lib/tachyon"
TX_CONFIG_DIR="/etc/tachyon"
TX_LOG="/var/log/tachyon"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-delete-sys-tachyon can only be executed by the root user"
	exit 10
fi

# Ensure that $HESTIA (/usr/local/hestia/) and other variables are valid.
if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

if [ -z "$HOMEDIR" ]; then
	echo "ERROR: Environment variables not present, uninstallation aborted."
	exit 2
fi

# No MySQL requirement: a SQLite-backed install (no MariaDB on the box) must be removable too.
# The DB drop below is guarded on its own.

# Get current version
if [ -f "/var/lib/tachyon/data/VERSION" ]; then
	version=$(cat /var/lib/tachyon/data/VERSION)
else
	echo "Error: Tachyon is not installed"
	exit 2
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Panel-Caddy teardown first (listener + FPM pool), so nothing serves from the dirs we delete
rm -f /etc/caddy/webmail-tachyon.conf
systemctl try-restart caddy > /dev/null 2>&1 || true
rm -f /etc/php/hestia/fpm/pool.d/tachyon.conf
systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true

rm -f -r $TX_INSTALL_DIR
rm -f -r $TX_CONFIG_DIR
rm -f -r $TX_LOG
# logrotate fragment deployed by h-add-sys-tachyon
rm -f /etc/logrotate.d/tachyon
rm ~/.tachyon

# IF EXISTS covers the SQLite-backed install (no tachyon DB was ever created);
# the whole block only runs where a MySQL server exists at all.
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	if [ -f '/usr/bin/mariadb' ]; then
		mariadb -e "DROP DATABASE IF EXISTS tachyon" 2>&1
		mariadb -e "DROP USER IF EXISTS tachyon@localhost"
	else
		mysql -e "DROP DATABASE IF EXISTS tachyon" 2>&1
		mysql -e "DROP USER IF EXISTS tachyon@localhost"
	fi
fi
# remove tachyon from WEBMAIL_SYSTEM. Token-based strip (not sed) so no stray
# commas survive in any position.
sys_key_token_set WEBMAIL_SYSTEM remove tachyon > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not drop tachyon"

# re-render mail domains so vhosts stop proxying to the removed listener
# (fall back to the remaining client, or the safe 'disabled' vhost)
$BIN/h-update-mail-templates yes > /dev/null 2>&1 || true

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Narrow the component token set: drop our token, an emptied set becomes NONE. Only when the recorded
# set names us (a record about other clients stays), and rebuilt from the recipe minus this client, not
# from the post-strip WEBMAIL_SYSTEM: the status may not list the other client at this moment (#965).
case ",${COMPONENT_MAIL_WEBMAILER:-}," in
	*,TACHYON,*)
		if wm_set=$(webmail_component_set remove TACHYON); then
			set_install_component MAIL_WEBMAILER "$wm_set"
		fi
		;;
esac

$BIN/h-log-action "system" "Info" "Plugins" "Tachyon removed (Version: $version)."

# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

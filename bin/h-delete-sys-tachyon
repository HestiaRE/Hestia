#!/bin/bash
# info: Delete Tachyon webmail client
# options: None
#
# This function removes the Tachyon webmail client.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

TX_INSTALL_DIR="/var/lib/tachyon"
TX_CONFIG_DIR="/etc/tachyon"
TX_LOG="/var/log/tachyon"

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-delete-sys-tachyon can only be executed by the root user"
	exit 10
fi

# No MySQL requirement: a SQLite-backed install must be removable too, the DB drop below is guarded on its own.

# Any artefact is enough: an add that failed halfway leaves pieces without the VERSION file.
version=$(cat /var/lib/tachyon/data/VERSION 2> /dev/null)
if [ -z "$version" ] && [[ ",$WEBMAIL_SYSTEM," != *,tachyon,* ]] && [ ! -e /etc/caddy/webmail-tachyon.conf ] \
	&& [ ! -e /etc/php/hestia/fpm/pool.d/tachyon.conf ] && [ ! -e /var/lib/tachyon ] && [ ! -e /etc/tachyon ]; then
	echo "Error: Tachyon is not installed"
	exit 2
fi

# Listener and pool first, so nothing serves from the dirs deleted below.
rm -f /etc/caddy/webmail-tachyon.conf
systemctl try-restart caddy > /dev/null 2>&1 || true
rm -f /etc/php/hestia/fpm/pool.d/tachyon.conf
systemctl reload hestia-php 2> /dev/null || systemctl restart hestia-php 2> /dev/null || true

rm -f -r $TX_INSTALL_DIR
rm -f -r $TX_CONFIG_DIR
rm -f -r $TX_LOG
rm -f /etc/logrotate.d/tachyon
rm -f ~/.tachyon

# IF EXISTS: a SQLite-backed install never created a tachyon DB, even where MySQL arrived later.
if echo "$DB_SYSTEM" | grep -qw 'mysql'; then
	db_client="mysql"
	[ -x /usr/bin/mariadb ] && db_client="mariadb"
	$db_client -e "DROP DATABASE IF EXISTS tachyon" 2>&1
	$db_client -e "DROP USER IF EXISTS tachyon@localhost"
fi
# Token strip, not sed: no stray comma survives in any position.
sys_key_token_set WEBMAIL_SYSTEM remove tachyon > /dev/null || check_result "$E_UPDATE" "WEBMAIL_SYSTEM: could not drop tachyon"

# A domain recorded with tachyon now renders the 'disabled' vhost, even when Roundcube is installed.
$BIN/h-update-mail-templates yes > /dev/null 2>&1 \
	|| echo "Warning: not every mail domain was re-rendered, h-update-mail-templates names them."

$BIN/h-log-action "system" "Info" "Plugins" "Tachyon removed (Version: ${version:-unknown})."

# Re-gate the fail2ban webmail jails now that WEBMAIL_SYSTEM changed (no-op unless fail2ban is active).
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh"
source_conf "$HESTIA/conf/hestia.conf"
fail2ban_refresh_webmail

log_event "$OK" "$ARGUMENTS"

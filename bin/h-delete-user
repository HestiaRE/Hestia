#!/bin/bash
# info: delete user
# options: USER [RESTART] [BACKUPS]
#
# example: h-delete-user whistler no yes
#
# Deletes a user with all domains, databases and cron jobs, and ends every process still running as the user.
# The backups stay unless BACKUPS is yes: then every archive on every transport and the restic repository go too.

user=$1
restart=$2
backups=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART] [BACKUPS]'
is_format_valid 'user' 'restart' 'backups'
is_object_valid 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

# First, so a refusal leaves the account whole, and before the unsuspend, which would start it again. The companion
# lives in this home and holds subordinate id ranges; a later account on its uid would inherit what it left.
if getent passwd "${user}-docker" > /dev/null 2>&1; then
	$BIN/h-delete-user-docker "$user" > /dev/null 2>&1
	check_result $? "docker companion of $user could not be removed, the account is kept; re-run after h-delete-user-docker"
fi

if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	# No restart for the unsuspend: the domains go next, and their delete restarts once, a failure only warning. A
	# suspended user's domains cannot be unsuspended and are deleted suspended.
	if [ "$(get_user_value '$SUSPENDED')" != 'yes' ]; then
		$BIN/h-unsuspend-web-domains "$user" no
	fi
	$BIN/h-delete-web-domains "$user" "$restart"
	check_result "$?" "web domain deletion failed"
fi

if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-mail-domains "$user"
	$BIN/h-delete-mail-domains "$user"
	check_result "$?" "mail domain deletion failed"
fi

if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-databases "$user"
	$BIN/h-delete-databases "$user"
	check_result "$?" "database deletion failed"
fi

# Unsuspend first so the admin's SUSPENDED_USERS counter gives the account back.
if [ "$(get_user_value '$SUSPENDED')" = 'yes' ]; then
	$BIN/h-unsuspend-user "$user" no
fi

$BIN/h-delete-user-ips "$user"
check_result "$?" "user ip release failed"

remove_user_queue_jobs "$CONF_DIR/queue/disk.pipe" "$user"
remove_user_queue_jobs "$CONF_DIR/queue/traffic.pipe" "$user"

$BIN/h-delete-user-sftp-jail "$user"

# The file manager pool runs as this account; php-fpm refuses a pool whose user is gone.
$BIN/h-delete-user-filemanager "$user" no > /dev/null 2>&1

# Read before userdel; the limit reset below keeps dead projects out of repquota.
_quota_uid=$(id -u "$user" 2> /dev/null)

# A process outliving the account keeps its uid, and a new account of the same name gets that uid back.
if [[ "$_quota_uid" =~ ^[0-9]+$ ]] && [ "$_quota_uid" -ne 0 ]; then
	loginctl terminate-user "$user" > /dev/null 2>&1
	pkill -KILL -u "$_quota_uid" > /dev/null 2>&1
fi

/usr/sbin/userdel -f "$user" >> /dev/null 2>&1
if [ $? -ne 0 ]; then
	remove_line_by_prefix /etc/passwd "$user:"
	remove_line_by_prefix /etc/shadow "$user:"
fi

/usr/sbin/groupdel "$user" >> /dev/null 2>&1
if [ $? -ne 0 ]; then
	remove_line_by_prefix /etc/group "$user:"
fi

chattr -i $HOMEDIR/$user/conf > /dev/null 2>&1
rm -rf $HOMEDIR/$user
# What an aborted restic restore left (restic_restore_home names its stage so, keep in step).
for stage in "$HOMEDIR/.hestia-restore.$user".??????; do
	[ -e "$stage" ] || continue
	rm -rf -- "$stage"
done
rm -f /var/spool/mail/$user
rm -f /var/spool/cron/$user
rm -f /var/spool/cron/crontabs/$user
# shellcheck source=/usr/local/hestia/include/dns.sh
source "$HESTIA/include/dns.sh"
dns_written_adopt "$user" "$ROOT_USER"

# Last before the record goes: the archive list, the transports and the restic key all live in it, and an abort above
# keeps the backups of an account that is still there.
if [ "$backups" = 'yes' ]; then
	while IFS= read -r archive; do
		[ -n "$archive" ] || continue
		$BIN/h-delete-user-backup "$user" "$archive" > /dev/null 2>&1 \
			|| echo "Warning: backup $archive of $user could not be deleted"
	done < <(sed -n "s/^BACKUP='\([^']*\)'.*/\1/p" "$USER_DATA/backup.conf" 2> /dev/null)
	restic_out=$($BIN/h-delete-user-backups-restic "$user" all 2>&1)
	case $? in
		0 | "$E_NOTEXIST") ;;
		*) echo "Warning: the restic backups of $user were not deleted: ${restic_out##*Error: }" ;;
	esac
	[ -n "$BACKUP" ] && rm -f "$BACKUP/$user/$user.log"
	# Not empty means files no record knows (adopted, or left by hand): named, never taken.
	if [ -n "$BACKUP" ] && [ -d "$BACKUP/$user" ] && ! rmdir "$BACKUP/$user" 2> /dev/null; then
		echo "Kept: $BACKUP/$user holds files no backup record names"
	fi
fi
rm -rf $USER_DATA

# A no-op unless the operator activated an AllowUsers list.
manage_sshd_allowusers del "$user"

# shellcheck source=/usr/local/hestia/include/quota.sh
declare -F quota_is_active > /dev/null 2>&1 || source "$HESTIA/include/quota.sh"
if [ -n "$_quota_uid" ] && quota_is_active && quota_home_fs; then
	setquota -P "$_quota_uid" 0 0 0 0 "$QUOTA_MNT" 2> /dev/null
fi

if [ "$user" != "$ROOT_USER" ]; then
	decrease_user_value "$ROOT_USER" '$U_USERS'
fi

# A panel session outlives the account, and a new account of the same name would inherit it.
$BIN/h-delete-user-sessions "$user" > /dev/null 2>&1

$BIN/h-log-action "system" "Info" "Users" "User deleted (User: $user${backups:+, backups: $backups})."
log_event "$OK" "$ARGUMENTS"

exit

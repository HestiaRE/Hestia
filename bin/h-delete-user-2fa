#!/bin/bash
# info: delete 2fa of existing user
# options: USER
#
# example: h-delete-user-2fa admin
#
# Disables two-factor authentication for a user.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

source_conf "$USER_DATA/user.conf"

if [ -z "$TWOFA" ]; then
	echo "Error: two-factor authentication is not enabled"
	exit "$E_NOTEXIST"
fi

update_user_value "$user" '$TWOFA' ""
update_user_value "$user" '$QRCODE' ""

$BIN/h-log-action "system" "Warning" "System" "Two-factor authentication disabled (User: $user)."
$BIN/h-log-action "$user" "Warning" "System" "Two-factor authentication disabled."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete backup exclusion
# options: USER [SYSTEM]
#
# example: h-delete-user-backup-exclusions admin
#
# Deletes all backup exclusions of a user, or only one type (WEB, MAIL, DB, CRON, USER).

user=$1
system=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [SYSTEM]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

if [ -z "$system" ]; then
	WEB=''
	MAIL=''
	DB=''
	CRON=''
	USER=''
else
	touch "$USER_DATA/backup-excludes.conf"
	source_conf "$USER_DATA/backup-excludes.conf"
	case $system in
		WEB) WEB='' ;;
		MAIL) MAIL='' ;;
		DB) DB='' ;;
		CRON) CRON='' ;;
		USER) USER='' ;;
		# Silence on an unknown name is indistinguishable from success.
		*) check_result "$E_INVALID" "no such exclusion type '$system' - one of: WEB MAIL DB CRON USER" ;;
	esac
fi

echo "WEB='$WEB'" > $USER_DATA/backup-excludes.conf
echo "MAIL='$MAIL'" >> $USER_DATA/backup-excludes.conf
echo "DB='$DB'" >> $USER_DATA/backup-excludes.conf
echo "CRON='$CRON'" >> $USER_DATA/backup-excludes.conf
echo "USER='$USER'" >> $USER_DATA/backup-excludes.conf
chmod 660 $USER_DATA/backup-excludes.conf

if [ -z "$system" ]; then
	$BIN/h-log-action "$user" "Info" "Backup" "Deleted all backup exclusions."
else
	$BIN/h-log-action "$user" "Info" "Backup" "Deleted backup exclusions (Service: $system)"
fi
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete a specific user snapshot from restic backup repository.
# options: USER SNAPSHOT
#
# example: h-delete-user-backup-restic admin snapshot
#
# Delete a specific user snapshot from restic backup repository. It doesn't take in account any pruning done by the retention policy.
# This function is used for deleting a specific user snapshot from restic backup repository.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT'
check_args '2' "$#" "$args_usage"
is_format_valid 'user'
# From the panel, and handed to restic: it must not read as an option.
is_object_format_valid "$snapshot" 'snapshot'
is_object_valid 'user' 'USER' "$user"

is_restic_repo_configured

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Both halves go together: a package whose snapshot is gone describes nothing.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no snapshot $snapshot for $user, or no metadata package beside it"
fi

restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" forget "$snapshot" --prune
if [ "$?" -ne 0 ]; then
	check_result "$E_BACKUP" "restic forget failed for $user - snapshot $snapshot is still there"
fi
rm -f "$meta_pkg"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

sed -i "/h-delete-user-backup-restic '$user' '$snapshot' /d" $CONF_DIR/queue/backup.pipe

# Logging
$BIN/h-log-action "system" "Info" "Backup" "Restic snapshot successfully deleted (User: $user, Snapshot: $snapshot)."
$BIN/h-log-action "$user" "Info" "Backup" "Restic snapshot successfully deleted (Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit

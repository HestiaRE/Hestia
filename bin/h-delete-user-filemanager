#!/bin/bash
# info: disable the file manager for a user
# options: USER [RESTART] [KEEP_FLAG]
#
# example: h-delete-user-filemanager alice
#
# Disables the file manager for a user. With KEEP_FLAG the listener goes but FILE_MANAGER stays, so the
# unsuspend can bring it back.

user="$1"
restart="$2"
keep_flag="$3"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/filemanager.sh
source "$HESTIA/include/filemanager.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART] [KEEP_FLAG]'
[ "$(id -u)" = '0' ] || {
	echo "ERROR: h-delete-user-filemanager must be run as root"
	exit 10
}

is_format_valid 'user'

# Whichever php version holds the pool.
for pool in /etc/php/*/fpm/pool.d/fm-"$user".conf; do
	[ -f "$pool" ] || continue
	ver=$(echo "$pool" | sed -nE 's|/etc/php/([^/]+)/.*|\1|p')
	rm -f "$pool"
	systemctl reload "php$ver-fpm" 2> /dev/null || systemctl restart "php$ver-fpm" 2> /dev/null || true
done

rm -f "/etc/nginx/conf.d/fm-$user.conf" "/etc/apache2/conf.d/fm-$user.conf"
rm -f "/run/hestia/fm/$user.sock"
if [ "$restart" != 'no' ] && [ -n "$(fm_front)" ]; then
	$BIN/h-restart-service "$(fm_front)" > /dev/null 2>&1 || true
fi

if [ -z "$keep_flag" ] && grep -q "^FILE_MANAGER='" "$USER_DATA/user.conf" 2> /dev/null; then
	update_user_value "$user" '$FILE_MANAGER' 'no'
fi

$BIN/h-log-action "system" "Info" "Plugins" "File manager disabled for $user."
log_event "$OK" "$ARGUMENTS"
exit

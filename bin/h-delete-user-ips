#!/bin/bash
# info: delete user ips
# options: USER
#
# example: h-delete-user-ips admin
#
# Hands a user's dedicated IPs back to the admin.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

ip_list=$(grep -lF "OWNER='$user'" $CONF_DIR/ips/*)

for ip in $ip_list; do
	ip=$(basename "$ip")

	# Recounted first: the user's domains are gone by now, and a drifted counter must not abort the delete.
	$BIN/h-update-sys-ip-counters "$ip" > /dev/null 2>&1
	is_ip_key_empty '$U_WEB_DOMAINS'
	is_ip_key_empty '$U_SYS_USERS'

	update_ip_value '$OWNER' "$ROOT_USER"
	update_ip_value '$STATUS' 'dedicated'
	# IP_OWNED only: a dedicated customer IP is already in the admin's IP_AVAIL.
	increase_user_value "$ROOT_USER" '$IP_OWNED'
	$BIN/h-log-action "system" "Info" "System" "Removed IP address from user (IP: $ip, User: $user)."
done

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete user sftp jail
# options: USER
#
# example: h-delete-user-sftp-jail whistler
#
# Removes a user from the sftp-jailed group (#413); the per-session jail stops being
# built on the next login. No persistent state to tear down.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
getent passwd "$user" > /dev/null || exit

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

delete_chroot_jail "$user"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Group change applies at next login; no per-user sshd_config change → no restart.

# Logging
log_event "$OK" "$ARGUMENTS"

exit

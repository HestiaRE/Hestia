#!/bin/bash
# info: delete user sftp jail
# options: USER
#
# example: h-delete-user-sftp-jail whistler
#
# Takes a user out of the sftp-jailed group; from the next login no jail is built.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
getent passwd "$user" > /dev/null || exit

delete_chroot_jail "$user"

log_event "$OK" "$ARGUMENTS"

exit

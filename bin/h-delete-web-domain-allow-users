#!/bin/bash
# info: disables other users create subdomains
# options: USER DOMAIN
#
# example: h-delete-web-domain-allow-users admin admin.com
#
# Takes back h-add-web-domain-allow-users: only the owner creates subdomains of this base domain again.
# ENFORCE_SUBDOMAIN_OWNERSHIP='no' in hestia.conf (CLI only) lifts the check box-wide.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ -z "$ALLOW_USERS" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'ALLOW_USERS' 'TIME'
fi

update_object_value 'web' 'DOMAIN' "$domain" '$ALLOW_USERS' "no"

$BIN/h-log-action "system" "Info" "Web" "Subdomain ownership enforcement enabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

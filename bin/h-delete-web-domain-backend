#!/bin/bash
# info: deleting web domain backend configuration
# options: USER DOMAIN [RESTART]
#
# example: h-delete-web-domain-backend admin acme.com
#
# Deletes the PHP-FPM pool of a web domain.

user=$1
domain=$2
restart=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

get_domain_values 'web'
BACKEND="$template"

# No pool is the normal state for PHP 'none' and a docker domain; with two, both go. Read before they go.
pool_version=$(web_domain_pool_version "$domain" "$user")
backend_type="$domain"

delete_web_backend

# Restart the version the pool ran on, else the domain's own field, else the system default
if [ -n "$pool_version" ]; then
	version="$pool_version"
elif [ -n "$PHP_VERSION" ] && [ "$PHP_VERSION" != 'none' ]; then
	version="$PHP_VERSION"
else
	version=$(multiphp_default_version)
fi
$BIN/h-restart-web-backend "$restart" "$version"
check_result $? "PHP restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Web" "Web domain configuration deleted (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

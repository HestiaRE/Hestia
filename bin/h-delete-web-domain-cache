#!/bin/bash
# info: Disable nginx proxy cache for a domain
# options: USER DOMAIN [RESTART]
#
# example: h-delete-web-domain-cache user domain.tld
#
# Counterpart to h-add-web-domain-cache: removes fragment, zone file and cached data.

user=$1
domain=$2
restart=${3-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

# shellcheck disable=SC2046  # word splitting carries the record into KEY='v' tokens
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

rm -f "$HOMEDIR/$user/conf/web/$domain/nginx.location.d/proxy_cache.conf"
rmdir "$HOMEDIR/$user/conf/web/$domain/nginx.location.d" 2> /dev/null

rm -f "/etc/nginx/conf.d/cache-zone.$domain.conf"

if [ -d "/var/cache/nginx/$domain" ]; then
	rm -rf "/var/cache/nginx/$domain"
fi

add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE' 'ALIAS'
add_object_key "web" 'DOMAIN' "$domain" 'PROXY_CACHE_DURATION' 'ALIAS'

update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE' 'no'
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_CACHE_DURATION' '0s'

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-log-action "$user" "Info" "Web" "Proxy cache disabled (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: delete webdomain ftp account
# options: USER DOMAIN FTP_USER
#
# example: h-delete-web-domain-ftp admin wonderland.com bob_ftp
#
# Deletes an FTP sub-account of the domain.

user=$1
domain=$2
# Stored as <owner>_<name>; either form is accepted, as by the add and change-* commands.
if [[ "$3" == "${1}_"* ]]; then ftp_user="$3"; else ftp_user="${1}_${3}"; fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '3' "$#" 'USER DOMAIN FTP_USER'
is_format_valid 'user' 'domain' 'ftp_user'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
get_domain_values 'web'
position=$(ftp_list_index "$FTP_USER" "$ftp_user")
if [ -z "$position" ]; then
	echo "Error: account $ftp_user doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

$BIN/h-delete-user-sftp-jail "$ftp_user"

manage_sshd_allowusers del "$ftp_user"

# -f: the account shares the customer's uid, whose PHP pool keeps it busy.
/usr/sbin/userdel -f "$ftp_user" > /dev/null 2>&1

# ftp_user becomes the remaining list below, so keep the account name for the log line.
ftp_account="$ftp_user"
ftp_user=$(ftp_list_edit "$FTP_USER" "$position")
ftp_md5=$(ftp_list_edit "$FTP_MD5" "$position")
ftp_path=$(ftp_list_edit "$FTP_PATH" "$position")

update_object_value 'web' 'DOMAIN' "$domain" '$FTP_USER' "$ftp_user"
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_MD5' "$ftp_md5"
update_object_value 'web' 'DOMAIN' "$domain" '$FTP_PATH' "$ftp_path"

$BIN/h-log-action "$user" "Info" "Web" "Deleted FTP account (User: $ftp_account, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

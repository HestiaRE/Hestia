#!/bin/bash
# info: disable HTTP/3 (QUIC) for a domain
# options: USER DOMAIN [RESTART] [QUIET]
#
# example: h-delete-web-domain-http3 admin acme.com
#
# Disables HTTP/3 for a domain: the quic listen fragment goes.

user=$1
domain=$2
restart="$3"
quiet="$4"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART] [QUIET]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

# -F: as a regex a.b.com would match aXb.com.
# shellcheck disable=SC2046  # word splitting carries the record into KEY='v' tokens
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

del_web_http3_config

if [ -z "$HTTP3" ]; then
	add_object_key "web" 'DOMAIN' "$domain" 'HTTP3' 'LETSENCRYPT'
fi
update_object_value 'web' 'DOMAIN' "$domain" '$HTTP3' 'no'

# Only the nginx front carried the fragment.
if [ "$PROXY_SYSTEM" = 'nginx' ]; then
	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null
else
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null
fi

if [ "$quiet" != "yes" ]; then
	$BIN/h-log-action "$user" "Info" "Web" "HTTP/3 disabled (Domain: $domain)."
fi
log_event "$OK" "$ARGUMENTS"

exit

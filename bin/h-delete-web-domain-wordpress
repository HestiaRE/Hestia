#!/bin/bash
# info: detach or delete a panel-managed WordPress from a web domain
# options: USER DOMAIN [MODE]
#
# example: h-delete-web-domain-wordpress john blog.acme.com
# example: h-delete-web-domain-wordpress john blog.acme.com delete
#
# MODE=detach (default) clears only the management flag; the site keeps running unmanaged.
# MODE=delete removes the WordPress files, its database and cron entry and resets the template.

user=$1
domain=$2
mode=${3-detach}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

WP_BIN="/usr/local/bin/wp"

check_args '2' "$#" 'USER DOMAIN [MODE]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

if [ "$mode" != "detach" ] && [ "$mode" != "delete" ]; then
	check_result "$E_INVALID" "MODE must be 'detach' or 'delete'"
fi

wp_state=$(get_object_value 'web' 'DOMAIN' "$domain" '$WP')
[ "$wp_state" = "yes" ] || check_result "$E_NOTEXIST" "WordPress is not managed for $domain"

docroot="$HOMEDIR/$user/web/$domain/public_html"
# user_exec children start in our cwd; a root-only one makes find warn.
cd "$HOMEDIR/$user" || check_result "$E_NOTEXIST" "user homedir missing"

if [ "$mode" = "delete" ]; then
	# Only a database in this user's managed naming is deleted; a hand-edited wp-config is named, not followed.
	db_name=""
	if [ -f "$docroot/wp-config.php" ]; then
		db_name=$(user_exec env HOME="$HOMEDIR/$user" timeout 60 "$WP_BIN" config get DB_NAME --path="$docroot" 2> /dev/null)
	fi
	if [[ "$db_name" =~ ^${user}_wp_[0-9a-f]{8}$ ]]; then
		# h-delete-database takes the full name, not the suffix.
		$BIN/h-delete-database "$user" "$db_name" > /dev/null 2>&1 \
			|| echo "WARN: database $db_name could not be deleted"
	elif [ -n "$db_name" ]; then
		echo "NOTE: database '$db_name' does not match the managed naming - left untouched"
	fi

	# The known WordPress tree only, so foreign files in the docroot stay.
	user_exec rm -rf "$docroot/wp-admin" "$docroot/wp-includes" "$docroot/wp-content"
	user_exec find "$docroot" -maxdepth 1 -name "wp-*.php" -delete
	user_exec rm -f "$docroot/index.php" "$docroot/xmlrpc.php" "$docroot/license.txt" "$docroot/readme.html" "$docroot/.htaccess"

	for job in $($BIN/h-list-cron-jobs "$user" plain 2> /dev/null | grep -F "cron event run --due-now --path=$docroot" | cut -f 1); do
		$BIN/h-delete-cron-job "$user" "$job" > /dev/null 2>&1
	done

	tpl=$(get_object_value 'web' 'DOMAIN' "$domain" '$TPL')
	case "$tpl" in
		wordpress | wordpress-disable-xmlrpc)
			$BIN/h-change-web-domain-tpl "$user" "$domain" "default" > /dev/null
			;;
	esac
fi

update_object_value 'web' 'DOMAIN' "$domain" '$WP' ""

if [ "$mode" = "delete" ]; then
	$BIN/h-log-action "$user" "Info" "Web" "WordPress deleted (Domain: $domain)."
else
	$BIN/h-log-action "$user" "Info" "Web" "WordPress detached (Domain: $domain) - site keeps running unmanaged."
fi
log_event "$OK" "$ARGUMENTS"

exit

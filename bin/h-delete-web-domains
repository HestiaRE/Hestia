#!/bin/bash
# info: delete web domains
# options: USER [RESTART]
#
# example: h-delete-web-domains admin
#
# Deletes all web domains of a user.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"

for domain in $(search_objects 'web' 'SUSPENDED' "*" 'DOMAIN'); do
	$BIN/h-delete-web-domain "$user" "$domain" 'no'
done

restart_after_delete h-restart-web "$restart"

restart_after_delete h-restart-proxy "$restart"

log_event "$OK" "$ARGUMENTS"

exit

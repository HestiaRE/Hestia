#!/bin/bash
# info: Download backup
# options: USER BACKUP
#
# example: h-download-backup admin admin.2020-11-05_05-10-21.tar
#
# Fetch a backup archive of USER back from the remote transports into the backup folder, kept for 24 hours.

user=$1
backup=$2

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

# This run's own queue line, for the abort path (see queue_drop_job).
QUEUE_JOB="h-download-backup $user $backup"

check_args '2' "$#" 'USER BACKUP'
is_format_valid 'user' 'backup'
is_object_valid 'user' 'USER' "$user"
# The record binds the archive to this customer; h-restore-user calls the transports directly, so a DR box is fine.
if ! grep -qF "BACKUP='$backup'" "$USER_DATA/backup.conf" 2> /dev/null; then
	check_result "$E_NOTEXIST" "no record of $backup for $user"
fi

disk_usage=$(df $BACKUP | tail -n1 | tr ' ' '\n' | grep % | cut -f 1 -d %)
if [ "$disk_usage" -ge "$BACKUP_DISK_LIMIT" ]; then
	echo "Error: Not enough disk space" | $SENDMAIL -s "$subj" $email $notify
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result $E_DISK "Not enough disk space"
fi

if ! backup_archive_path "$user" "$backup"; then
	# Only an ARRIVED file counts as downloaded, so a failed fetch cannot exit green.
	for remote_type in sftp ftp rclone; do
		# Comma-bounded, not =~: ftp is a substring of sftp (same form as backup_db_type_supported).
		[[ ",$BACKUP_SYSTEM," == *",$remote_type,"* ]] || continue
		${remote_type}_download "$backup"
		if backup_archive_path "$user" "$backup"; then
			downloaded='yes'
			break
		fi
	done
	if [ -z "$downloaded" ]; then
		subj="Download of $backup failed for $user"
		$BIN/h-add-user-notification $user "$subj" "<p class='u-text-bold'>Unable to retrieve backup file from remote server.</p><p><span class='u-text-bold'>Error:</span> $backup file doesn't exist in <code>'${BACKUP}'</code> directory.</p>"
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_NOTEXIST" "backup file $backup doesn't exist in '${BACKUP}' folder"
	else
		# Through the resolver, no hand-built second two-place rule; a fetched copy gets the owner and mode of a local one.
		if backup_archive_path "$user" "$backup"; then
			chmod 0640 "$BACKUP_ARCHIVE"
			chown "hestia:$user" "$BACKUP_ARCHIVE"
			echo "rm $BACKUP_ARCHIVE" | at now + 1 day
		fi
	fi
fi

if backup_archive_path "$user" "$backup"; then
	subj="Download of $backup completed for $user"
	email=$(get_user_value '$CONTACT')
	echo "Backup file $backup was retrieved from the remote server and will be available to download for 24 hours." | $SENDMAIL -s "$subj" "$email" "$notify"
	$BIN/h-add-user-notification "$user" "$subj" "<p>Backup file <code>$backup</code> was retrieved from the remote server and will be available to download for 24 hours.</p>"
fi

queue_drop_job "$CONF_DIR/queue/backup.pipe"

$BIN/h-log-action "system" "Info" "Backup" "Backup download requested (User: $user, Archive: $backup)."
$BIN/h-log-action "$user" "Info" "Backup" "Backup download requested (Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit

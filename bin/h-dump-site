#!/bin/bash
# info: Dumps the files of a site into a zip archive
# options: USER DOMAIN [TYPE]
#
# example: h-dump-site user domain
# example: h-dump-site user domain full
#
# Zips the docroot, or with TYPE full the whole domain directory, into $BACKUP for one hour.

user=$1
domain=$2
type=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [TYPE]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

timestamp=$(date +'%Y-%m-%d_%H-%M-%S')

dir="/home/$user/web/$domain"
[ "$type" = "full" ] || dir="$dir/public_html"
cd "$dir" 2> /dev/null || check_result "$E_NOTEXIST" "$dir does not exist"

name="${user}_${domain}_${timestamp}.zip"
archive="$BACKUP/$name"

# zip reads as the customer, so the archive holds what the customer can read; root only writes the file.
# 18 is a file the customer cannot read, left out on purpose.
runuser -u "$user" -- zip -rq - . > "$archive" 2> /dev/null
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 18 ]; then
	rm -f "$archive"
	check_result "$E_BACKUP" "zip of $dir failed (rc $rc)"
fi

# Name for display, then the path the panel serves.
echo "$name"
echo "$archive"
echo "rm $archive" | at now + 1 hour > /dev/null 2>&1

log_event "$OK" "$ARGUMENTS"

exit

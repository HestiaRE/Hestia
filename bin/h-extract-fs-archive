#!/bin/bash
# info: archive to directory
# options: USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST] [FILELIST]
#
# example: h-extract-fs-archive admin latest.tar.gz /home/admin
#
# This function extracts archive into directory on the file system

user=$1
src_file=$2
dst_dir=$3
selected_dir=$4
strip=$5
test=$6
# NUL-separated list of members to extract (#712): the first pass of a differential restore lays
# down only what the base still shares with the current map. Absent means "everything", as before.
filelist=$7

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST] [FILELIST]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Checking user homedir
homedir=$(grep "^$user:" /etc/passwd | cut -f 6 -d :)
if [ -z "$homedir" ]; then
	echo "Error: user home directory doesn't exist"
	exit 12
fi

# Checking source dir
if [ ! -e "$src_file" ]; then
	echo "Error: source file $src_file doesn't exist"
	exit 3
fi

# Restore unpacks from its temp dir, which lies in BACKUP_TEMP when that is set.
if ! path_within "$src_file" "$homedir" /tmp "$BACKUP" "$BACKUP_TEMP"; then
	echo "Error: invalid source path $src_file"
	exit 2
fi

if ! path_within "$dst_dir" "$homedir" /tmp; then
	echo "Error: invalid destination path $dst_dir"
	exit 2
fi

if [ -n "$strip" ]; then
	is_int_format_valid "$strip" 'strip-components'
	tar_strip_level="--strip-components $strip"
fi
tar_select=()
if [ -n "$filelist" ]; then
	[ -f "$filelist" ] || {
		echo "Error: file list $filelist doesn't exist"
		exit 3
	}
	# --no-recursion first: the list names directories as the archive stores them, and without it
	# each one is unpacked recursively - which brings deleted files back on a differential restore.
	tar_select=(--no-recursion --null -T "$filelist")
fi
# Our backups and HestiaCP's write these two, nothing else reaches this command.
case "$src_file" in
	*.tar.zst) tar_codec=(-I pzstd) ;;
	*.tar.gz | *.tgz) tar_codec=(-z) ;;
	*)
		echo "Error: $src_file is neither .tar.zst nor .tar.gz"
		exit "$E_INVALID"
		;;
esac
if [ -z "$test" ] || [ "$test" = "no" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec tar "${tar_codec[@]}" -xf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level "${tar_select[@]}" > /dev/null 2>&1
	rc=$?
else
	user_exec tar "${tar_codec[@]}" -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
	rc=$?
fi

# Checking result
if [ "$rc" -ne 0 ]; then
	echo "Error: $src_file was not extracted"
	exit 3
fi

# Exiting
exit

#!/bin/bash
# info: archive to directory
# options: USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST] [FILELIST]
#
# example: h-extract-fs-archive admin latest.tar.gz /home/admin
#
# Extracts a .tar.zst or .tar.gz into the user's home or /tmp, as the user; the restore's unpacker.

user=$1
src_file=$2
dst_dir=$3
selected_dir=$4
strip=$5
test=$6
# NUL-separated members to extract: a differential restore lays down only what the base shares with the current map.
filelist=$7

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST] [FILELIST]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

homedir=$(awk -F : -v u="$user" '$1 == u {print $6; exit}' /etc/passwd)
if [ -z "$homedir" ]; then
	echo "Error: user home directory doesn't exist"
	exit 12
fi

if [ ! -e "$src_file" ]; then
	echo "Error: source file $src_file doesn't exist"
	exit 3
fi

# Besides home and /tmp only the restore's own mktemp dir, tmp.* directly under BACKUP_TEMP or BACKUP:
# the customers' archive folders there are no source.
src_ok=''
path_within "$src_file" "$homedir" /tmp && src_ok='yes'
src_real=$(readlink -f -- "$src_file")
for base in "$BACKUP" "$BACKUP_TEMP"; do
	[ -n "$base" ] && [ -d "$base" ] || continue
	base=$(readlink -f -- "$base")
	case "$src_real" in "$base"/tmp.*/*) src_ok='yes' ;; esac
done
if [ "$src_ok" != 'yes' ]; then
	echo "Error: invalid source path $src_file"
	exit 2
fi

if ! path_within "$dst_dir" "$homedir" /tmp; then
	echo "Error: invalid destination path $dst_dir"
	exit 2
fi

if [ -n "$strip" ]; then
	is_int_format_valid "$strip" 'strip-components'
	tar_strip_level="--strip-components $strip"
fi
tar_select=()
if [ -n "$filelist" ]; then
	[ -f "$filelist" ] || {
		echo "Error: file list $filelist doesn't exist"
		exit 3
	}
	# --no-recursion first: a listed directory would unpack whole and bring deleted files back.
	tar_select=(--no-recursion --null -T "$filelist")
fi
# Our backups and HestiaCP's write these two, nothing else reaches this command.
case "$src_file" in
	*.tar.zst) tar_codec=(-I pzstd) ;;
	*.tar.gz | *.tgz) tar_codec=(-z) ;;
	*)
		echo "Error: $src_file is neither .tar.zst nor .tar.gz"
		exit "$E_INVALID"
		;;
esac
if [ -z "$test" ] || [ "$test" = "no" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec tar "${tar_codec[@]}" -xf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level "${tar_select[@]}" > /dev/null 2>&1
	rc=$?
else
	user_exec tar "${tar_codec[@]}" -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
	rc=$?
fi

if [ "$rc" -ne 0 ]; then
	echo "Error: $src_file was not extracted"
	exit 3
fi

exit

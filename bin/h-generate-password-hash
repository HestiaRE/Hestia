#!/bin/bash
# info: generate password hash
# options: HASH_METHOD SALT [PASSWORD]
#
# example: h-generate-password-hash sha-512 rAnDom_string yourPassWord
#
# A crypt(3) hash for md5, sha-512, htpasswd or des; the password from the third argument or stdin.
# perl's crypt() is libc's, the same the PHP version used, so existing hashes still verify.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

method="$1"
salt="$2"

if [ -z "$method" ] || [ -z "$salt" ]; then
	echo "Error: not enough arguments" >&2
	echo "Usage: $0 HASH_METHOD SALT [PASSWORD]  (password may be sent on stdin)" >&2
	exit 1
fi

if [ -n "$3" ]; then
	password="$3"
else
	IFS= read -r password
fi

case "$method" in
	md5) setting="\$1\$${salt}\$" ;;
	sha-512) setting="\$6\$${salt}\$" ;;
	htpasswd) setting="$(printf '%s' "$password" | base64 -w0)" ;;
	des) setting="$salt" ;;
	*)
		echo "Error: HASH_METHOD must be one of 'md5', 'sha-512', 'htpasswd', 'des'" >&2
		exit 1
		;;
esac

# Through the environment, not argv: argv is readable in /proc, and the htpasswd setting is the password itself.
HASH_PW="$password" HASH_SETTING="$setting" perl -e 'print crypt($ENV{HASH_PW}, $ENV{HASH_SETTING}), "\n"'

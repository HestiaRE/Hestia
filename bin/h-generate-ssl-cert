#!/bin/bash
# info: generate self signed certificate and CSR request
# options: DOMAIN EMAIL COUNTRY STATE CITY ORG UNIT [ALIASES] [FORMAT]
#
# example: h-generate-ssl-cert example.com mail@yahoo.com USA California Monterey ACME.COM IT
#
# Generates a self-signed certificate and a CSR.

domain=$1
domain=$(echo "$domain" | sed -e 's/\.*$//g' -e 's/^\.*//g')
domain_alias=$domain
email=$2
country=$3
state=$4
city=$5
org=$6
org_unit=$7
aliases=$8
format=${9-shell}
KEY_SIZE=4096
DAYS=365

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list_ssl() {
	i='1' # iterator
	echo '{'
	# From the RAW files: json_escape encodes the newlines itself, and over the encoded $crt each \n would
	# become two visible characters.
	local crt="${crt_raw}" key="${key_raw}" csr="${csr_raw}"
	json_escape domain crt key csr workdir
	printf '\t"%s": {\n' "$domain"
	echo "        \"CRT\": \"$crt\","
	echo "        \"KEY\": \"$key\","
	echo "        \"CSR\": \"$csr\","
	echo "        \"DIR\": \"$workdir\""
	echo -e "\t}\n}"
}

shell_list_ssl() {
	if [ -n "$crt" ]; then
		echo -e "$crt"
	fi
	if [ -n "$key" ]; then
		echo -e "\n$key"
	fi
	if [ -n "$csr" ]; then
		echo -e "\n$csr"
	fi
	echo -e "\nDirectory: $workdir"
}

format_domain_idn
if [[ "$email" = *[![:ascii:]]* ]]; then
	local=$(echo "$email" | cut -f1 -d'@')
	email_domain=$(echo "$email" | cut -f2 -d'@')
	email_domain_idn=$(idn2 --quiet $email_domain)
	email="$local"@"$email_domain_idn"
fi

args_usage='DOMAIN EMAIL COUNTRY STATE CITY ORG UNIT [ALIASES] [FORMAT]'
check_args '7' "$#" "$args_usage"
is_format_valid 'domain' 'aliases' 'format' 'email'
is_common_format_valid "$country" "country"
is_common_format_spaces_valid "$state" "state"
is_common_format_spaces_valid "$org" "org"
is_common_format_spaces_valid "$unit" "unit"

release="$(lsb_release -s -r)"

if [ -z "$email" ] && [ "$release" = "18.04" ]; then
	echo "Email address is required"
	exit 2
fi
if [ ! -f /root/.rnd ]; then
	touch /root/.rnd
fi

workdir=$(mktemp -d)
cd $workdir

openssl genrsa "$KEY_SIZE" > "$domain.key" 2> /dev/null

subj=""
if [ -n "$email" ]; then
	subj="/emailAddress=$email"
fi

subj="$subj/C=$country/ST=$state/L=$city/O=$org"
subj="$subj/OU=$org_unit/CN=$domain_idn"

if [ -e "/etc/ssl/openssl.cnf" ]; then
	ssl_conf='/etc/ssl/openssl.cnf'
else
	ssl_conf="/etc/pki/tls/openssl.cnf"
fi

if [ -z "$aliases" ]; then
	openssl req -sha256 -new \
		-batch \
		-subj "$subj" \
		-key $domain.key \
		-reqexts SAN \
		-config <(cat $ssl_conf \
			<(printf "[SAN]\nsubjectAltName=DNS:$domain")) \
		-out $domain.csr > /dev/null 2>&1
else
	for alias in $(echo $domain,$aliases | tr ',' '\n' | sort -u); do
		if [[ "$alias" = *[![:ascii:]]* ]]; then
			alias=$(idn2 --quiet $alias)
		fi
		dns_aliases="${dns_aliases}DNS:$alias,"
	done
	dns_aliases=$(echo $dns_aliases | sed "s/,$//")
	openssl req -sha256 -new \
		-batch \
		-subj "$subj" \
		-key $domain.key \
		-reqexts SAN \
		-config <(cat $ssl_conf \
			<(printf "[SAN]\nsubjectAltName=$dns_aliases")) \
		-out $domain.csr > /dev/null 2>&1
fi

if [ -z "$aliases" ]; then
	openssl x509 -req -sha256 \
		-days $DAYS \
		-in $domain.csr \
		-signkey $domain.key \
		-extfile <(printf "[SAN]\nsubjectAltName=DNS:$domain") \
		-extensions SAN \
		-out $domain.crt > /dev/null 2>&1
else
	openssl x509 -req -sha256 \
		-days $DAYS \
		-in $domain.csr \
		-signkey $domain.key \
		-extfile <(printf "[SAN]\nsubjectAltName=$dns_aliases") \
		-extensions SAN \
		-out $domain.crt > /dev/null 2>&1
fi

if [ -e "$domain.crt" ]; then
	crt_raw=$(cat $domain.crt)
	crt=$(echo "$crt_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

if [ -e "$domain.key" ]; then
	key_raw=$(cat $domain.key)
	key=$(echo "$key_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

if [ -e "$domain.csr" ]; then
	csr_raw=$(cat $domain.csr)
	csr=$(echo "$csr_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

case $format in
	json) json_list_ssl ;;
	plain)
		nohead=1
		shell_list_ssl
		;;
	shell) shell_list_ssl ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

# The private key is in there: no access for others, and gone after 15 minutes.
chmod 660 $workdir
echo "rm -rf $workdir" | at -M "now +15 minute" > /dev/null 2>&1

log_event "$OK" "$ARGUMENTS"

exit

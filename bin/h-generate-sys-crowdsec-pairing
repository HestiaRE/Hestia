#!/bin/bash
# info: mint a one-time CrowdSec mesh pairing code
# options: NONE
#
# example: h-generate-sys-crowdsec-pairing
#
# Opens a short pairing window and prints its one-time code for the admin of the joining box (h-add-sys-crowdsec-peer).
# Root-only, and /mesh-pair.php is a 404 while no window is open, so pairing always needs an admin on both boxes.
# Single use, MESH_PAIRING_TTL seconds, dead after MESH_PAIRING_TRIES wrong guesses; only the hash is stored.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/crowdsec-mesh.sh
source $HESTIA/include/crowdsec-mesh.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if ! mesh_load; then
	echo "ERROR: CrowdSec fleet-mesh is not enabled. Run h-add-sys-crowdsec-mesh first."
	exit "$E_DISABLED"
fi

# No I/L/O/0/1, so a code read out loud cannot be mistyped into another valid one.
code=$(LC_ALL=C tr -dc 'ABCDEFGHJKMNPQRSTUVWXYZ23456789' < /dev/urandom | head -c 20)
if [ ${#code} -ne 20 ]; then
	echo "ERROR: could not generate a pairing code."
	exit "$E_PARSING"
fi
expires=$(($(date +%s) + MESH_PAIRING_TTL))

mkdir -p "$CONF_DIR/crowdsec"
printf "PAIRING_HASH='%s'\nPAIRING_EXPIRES='%s'\nPAIRING_TRIES='0'\n" \
	"$(mesh_hash "$code")" "$expires" > "$MESH_PAIRING_CONF"
chmod 600 "$MESH_PAIRING_CONF"

# The panel cannot read /etc/hestia; this secret-free marker only keeps /mesh-pair.php shut while idle.
mesh_stage_serve
printf '%s\n' "$expires" > "$MESH_RUN_DIR/pairing"
chmod 644 "$MESH_RUN_DIR/pairing"

code_fmt=$(printf '%s' "$code" | sed 's/.\{5\}/&-/g;s/-$//')
echo "$code_fmt"
echo ""
echo "Valid for $((MESH_PAIRING_TTL / 60)) minutes, one pairing only. On the joining box run:"
echo "  h-add-sys-crowdsec-peer $(hostname -f 2> /dev/null || hostname) <CODE> ${BACKEND_PORT:-8083}"

$BIN/h-log-action "system" "Info" "System" "CrowdSec mesh pairing window opened."
log_event "$OK" "$ARGUMENTS"

exit

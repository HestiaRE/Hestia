#!/bin/bash
# info: get mail account value
# options: USER DOMAIN ACCOUNT KEY
#
# example: h-get-mail-account-value admin example.tld tester QUOTA
#
# This function for getting a certain mail account parameter.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
account=$3
key=$4

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER DOMAIN ACCOUNT KEY'
is_format_valid 'user' 'domain' 'account' 'key'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"

key=$(echo "$key" | tr '[:lower:]' '[:upper:]')

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Print
# From the account's own row: a key the record does not carry is empty, never some shell variable of that name.
row=$(awk -v a="ACCOUNT='$account' " 'index($0, a) == 1' "$USER_DATA/mail/$domain.conf")
value=$(record_field "$row" "$key")
echo "$value"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

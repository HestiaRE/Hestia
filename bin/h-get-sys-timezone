#!/bin/bash
# info: get system timezone
# options:
#
# This function to get system timezone

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# timedated, not /etc/timezone: that file goes stale when the zone is set without this panel.
ZONE=$(timedatectl show -p Timezone --value 2> /dev/null)
if [ -z "$ZONE" ] && [ -h /etc/localtime ]; then
	ZONE=$(readlink /etc/localtime | sed "s%.*share/zoneinfo/%%")
fi

echo "$ZONE"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: get system timezone
# options:
#
# Prints the system time zone.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# timedated, not /etc/timezone: that file goes stale when the zone is set without this panel.
ZONE=$(timedatectl show -p Timezone --value 2> /dev/null)
if [ -z "$ZONE" ] && [ -h /etc/localtime ]; then
	ZONE=$(readlink /etc/localtime | sed "s%.*share/zoneinfo/%%")
fi

echo "$ZONE"

exit

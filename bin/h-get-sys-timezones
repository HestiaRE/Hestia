#!/bin/bash
# info: list system timezone
# options: [FORMAT]
#
# example: h-get-sys-timezones json
#
# Lists the time zones h-change-sys-timezone accepts.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	jq -ncR '[inputs]' <<< "$zones"
}

shell_list() {
	IFS=$'\n'
	echo "Timezone"
	echo "--------"
	for zone in $zones; do
		echo $zone
	done
}

plain_list() {
	IFS=$'\n'
	for zone in $zones; do
		echo $zone
	done
}

zones=$(timedatectl list-timezones)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

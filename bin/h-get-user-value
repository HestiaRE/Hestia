#!/bin/bash
# info: get user value
# options: USER KEY
#
# example: h-get-user-value admin FNAME
#
# Prints one value from a user's record.

user=$1
key=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER KEY'
is_format_valid 'user' 'key'
is_object_valid 'user' 'USER' "$user"

value=$(get_user_value "$key")

echo "$value"

exit

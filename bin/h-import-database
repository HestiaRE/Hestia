#!/bin/bash
# info: import database
# options: USER DATABASE DUMP
#
# example: h-import-database alice mydb /full/path/to.sql
#
# This function for importing database.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
database=$2
dump=$3

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DATABASE DUMP'
is_format_valid 'database' 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

if [ ! -f "$dump" ]; then
	echo "Error: dump file doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

# Check db existence
db_data=$(grep -F "DB='$database'" $CONF_DIR/users/$user/db.conf)

parse_object_kv_list "$db_data"
#Fix issue #1084 with "Upper case not allowed with PGSQL"
if [ "$TYPE" == "pgsql" ]; then
	usersmall=$(echo "$user" | tr '[:upper:]' '[:lower:]')
else
	usersmall=$user
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The client swallows its own output, so the exit code is the only signal there is - unchecked, a
# rejected dump ended in an OK log line over an empty database. An unknown TYPE fell through the
# same way: no arm ran, and the empty database was reported as imported.
rc=0
case $TYPE in
	mysql) import_mysql_database "$dump" || rc=$? ;;
	pgsql) import_pgsql_database "$dump" || rc=$? ;;
	*) check_result "$E_DB" "unknown database type '$TYPE' for $database" ;;
esac
[ "$rc" -eq 0 ] || check_result "$E_DB" "import of $dump into $database failed (client exit $rc)"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: import database
# options: USER DATABASE DUMP
#
# example: h-import-database admin admin_wp_db /root/admin_wp_db.sql
#
# Imports DUMP into DATABASE. It runs with the host's admin account and its
# statements are not limited to DATABASE, so the dump has to be trusted.

user=$1
database=$2
dump=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER DATABASE DUMP'
is_format_valid 'database' 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

if [ ! -f "$dump" ]; then
	echo "Error: dump file doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

db_data=$(grep -F "DB='$database'" $CONF_DIR/users/$user/db.conf)

parse_object_kv_list "$db_data"

# The client swallows its own output, so its exit code is the only signal; an unknown TYPE must fail too.
rc=0
case $TYPE in
	mysql) import_mysql_database "$dump" || rc=$? ;;
	pgsql) import_pgsql_database "$dump" || rc=$? ;;
	*) check_result "$E_DB" "unknown database type '$TYPE' for $database" ;;
esac
[ "$rc" -eq 0 ] || check_result "$E_DB" "import of $dump into $database failed (client exit $rc)"

log_event "$OK" "$ARGUMENTS"

exit

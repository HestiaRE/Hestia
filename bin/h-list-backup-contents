#!/bin/bash
# info: list the contents of a backup archive
# options: USER ARCHIVE [FORMAT]
#
# example: h-list-backup-contents admin admin.2026-08-18_03-31-30.tar
#
# Reads the archive file, not the backup.conf record, and reports what it holds and what this host cannot restore.
# Works for an archive with no record (a HestiaCP one put into /backup by hand), so a migration can be inspected first.
# Not scoped by $USER_DATA and the user need not exist: a panel caller needs its own per-user scope.

user=$1
backup=$2
format=${3-shell}

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

# printf %s, never a value spliced into an echo: a glob would substitute after json_escape has run.
json_list() {
	local kind list first item json_item
	json_escape backup PROBE_MODE PROBE_VESTA PROBE_CRON PROBE_WEB_SYSTEM PROBE_PROXY_SYSTEM PROBE_ORIGIN
	echo '{'
	printf '    "%s": {\n' "$backup"
	printf '        "MODE": "%s",\n' "$PROBE_MODE"
	printf '        "VESTA": "%s",\n' "$PROBE_VESTA"
	printf '        "WEB_SYSTEM": "%s",\n' "$PROBE_WEB_SYSTEM"
	printf '        "PROXY_SYSTEM": "%s",\n' "$PROBE_PROXY_SYSTEM"
	printf '        "ORIGIN": "%s",\n' "$PROBE_ORIGIN"
	printf '        "CRON": "%s",\n' "$PROBE_CRON"
	# Newline separated: a home entry may be called "my documents".
	for kind in WEB MAIL DB UDIR DNS PACKAGES; do
		list="PROBE_$kind"
		printf '        "%s": [' "$kind"
		first=1
		while IFS= read -r item; do
			[ -n "$item" ] || continue
			[ "$first" = 1 ] || printf ', '
			first=0
			json_item="$item"
			json_escape json_item
			printf '"%s"' "$json_item"
		done <<< "${!list}"
		echo '],'
	done
	echo '        "READABLE": "yes"
    }
}'
}

shell_list() {
	backup_report
}

plain_list() {
	local kind list item
	# Said in every format: an empty list for a refused Vesta archive would read like an archive holding nothing.
	if [ "$PROBE_VESTA" = 'yes' ]; then
		printf 'vesta\trefused\n'
		return
	fi
	for kind in WEB MAIL DB UDIR DNS PACKAGES; do
		list="PROBE_$kind"
		while IFS= read -r item; do
			[ -n "$item" ] || continue
			printf '%s\t%s\n' "${kind,,}" "$item"
		done <<< "${!list}"
	done
}

check_args '2' "$#" 'USER ARCHIVE [FORMAT]'
is_format_valid 'user' 'backup'
# Validated but not required to exist: a migration archive is looked at before its account is.

# The resolver is the containment: two allowed places, symlinks refused.
backup_archive_path "$user" "$backup"
case $? in
	1) check_result "$E_NOTEXIST" "backup file $backup doesn't exist in '$BACKUP/$user' or '${BACKUP}'" ;;
	2) check_result "$E_INVALID" "$backup does not resolve to a file inside '${BACKUP}'" ;;
esac
archive_path="$BACKUP_ARCHIVE"

# Read-only; the workdir goes away on every exit path, including the ones check_result takes.
probedir=$(mktemp -d -p "${BACKUP_TEMP:-$BACKUP}" -t probe.XXXXXX) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$probedir"' EXIT

if ! backup_probe "$archive_path" "$probedir"; then
	check_result "$E_PARSING" "$backup cannot be read as a backup archive"
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

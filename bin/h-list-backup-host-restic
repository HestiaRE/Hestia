#!/bin/bash
# info: list backup host
# options: [FORMAT]
#
# example: h-list-backup-host local
#
# Lists the parameters of the restic backup host.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	json_escape REPO SNAPSHOTS KEEP_DAILY KEEP_WEEKLY KEEP_MONTHLY KEEP_YEARLY
	echo '    "restic": {'
	printf '	"REPO": "%s",\n' "$REPO"
	printf '	"SNAPSHOTS": "%s",\n' "$SNAPSHOTS"
	printf '	"KEEP_DAILY": "%s",\n' "$KEEP_DAILY"
	printf '	"KEEP_WEEKLY": "%s",\n' "$KEEP_WEEKLY"
	printf '	"KEEP_MONTHLY": "%s",\n' "$KEEP_MONTHLY"
	printf '	"KEEP_YEARLY": "%s"\n' "$KEEP_YEARLY"
	echo '	}'
	echo '}'
}

shell_list() {
	echo "REPO:           $REPO"
	echo "SNAPSHOTS:      $SNAPSHOTS"
	echo "KEEP_DAILY:      $KEEP_DAILY"
	echo "KEEP_WEEKLY:     $KEEP_WEEKLY"
	echo "KEEP_MONTHLY:    $KEEP_MONTHLY"
	echo "KEEP_YEARLY:     $KEEP_YEARLY"
}

plain_list() {
	echo -e "$REPO\t$SNAPSHOTS\t$KEEP_DAILY\t$KEEP_WEEKLY\t$KEEP_MONTHLY\t$KEEP_YEARLY"
}

if [ ! -e "$HESTIA/conf/restic.conf" ]; then
	exit
fi

source_conf "$HESTIA/conf/restic.conf"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

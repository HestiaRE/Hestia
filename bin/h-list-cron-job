#!/bin/bash
# info: list cron job
# options: USER JOB [FORMAT]
#
# example: h-list-cron-job admin 7
#
# One job of the user, as json, shell or plain.

user=$1
job=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo "{"
	local CMD="$CMD_RAW"
	json_escape job MIN HOUR DAY MONTH WDAY CMD JOB SUSPENDED TIME DATE
	printf '    "%s": {\n' "$job"
	printf '        "MIN": "%s",\n' "$MIN"
	printf '        "HOUR": "%s",\n' "$HOUR"
	printf '        "DAY": "%s",\n' "$DAY"
	printf '        "MONTH": "%s",\n' "$MONTH"
	printf '        "WDAY": "%s",\n' "$WDAY"
	printf '        "CMD": "%s",\n' "$CMD"
	printf '        "JOB": "%s",\n' "$JOB"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	printf '    }'
	echo
	echo '}'
}

shell_list() {
	echo "MINUTE:         $MIN"
	echo "HOUR:           $HOUR"
	echo "DAY:            $DAY"
	echo "MONTH:          $MONTH"
	echo "DAY OF WEEK:    $WDAY"
	echo "COMMAND:        $CMD"
	echo "SUSPENDED:      $SUSPENDED"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

plain_list() {
	# printf, not echo -e: a command may carry a backslash.
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$MIN" "$HOUR" "$DAY" "$MONTH" "$WDAY" "$CMD" "$SUSPENDED" "$TIME" "$DATE"
}

check_args '2' "$#" 'USER JOB [FORMAT]'
is_format_valid 'user'
is_number_format_valid "$job" "job_id"
is_object_valid 'user' 'USER' "$user"

conf=$USER_DATA/cron.conf

cron_line=$(grep -F "JOB='$job'" $conf)
if [ -z "$cron_line" ]; then
	check_result "$E_NOTEXIST" "cron job $job doesn't exist"
fi

parse_object_kv_list "$cron_line"

CMD_RAW=$(record_value_decode "$CMD")
# For shell and plain only: json_list escapes CMD_RAW itself, and both together doubled every escape.
CMD=$(echo "$CMD_RAW" | sed -e 's/"/\\"/g')

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

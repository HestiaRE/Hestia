#!/bin/bash
# info: list user cron jobs
# options: USER [FORMAT]
#
# example: h-list-cron-jobs admin
#
# This function for obtaining the list of all users cron jobs.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep JOB $USER_DATA/cron.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		# %quote% is the storage encoding for ' (the record delimiter), so it is decoded for every
		# format; the " escaping that used to sit here is json_escape's job and doubled up with it.
		CMD=$(record_value_decode "$CMD")
		json_escape JOB MIN HOUR DAY MONTH WDAY CMD SUSPENDED TIME DATE
		printf '    "%s": {\n' "$JOB"
		printf '        "MIN": "%s",\n' "$MIN"
		printf '        "HOUR": "%s",\n' "$HOUR"
		printf '        "DAY": "%s",\n' "$DAY"
		printf '        "MONTH": "%s",\n' "$MONTH"
		printf '        "WDAY": "%s",\n' "$WDAY"
		printf '        "CMD": "%s",\n' "$CMD"
		printf '        "JOB": "%s",\n' "$JOB"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/cron.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "JOB^MIN^HOUR^DAY^MONTH^WDAY^COMMAND"
	echo "---^---^----^---^-----^----^-------"
	while read str; do
		parse_object_kv_list "$str"
		CMD=$(record_value_decode "$CMD")
		echo "$JOB^$MIN^$HOUR^$DAY^$MONTH^$WDAY^$CMD"
	done < <(cat $USER_DATA/cron.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		CMD=$(record_value_decode "$CMD")
		echo -ne "$JOB\t$MIN\t$HOUR\t$DAY\t$MONTH\t$WDAY\t$CMD\t"
		echo -e "$SUSPENDED\t$TIME\t$DATE"
	done < <(cat $USER_DATA/cron.conf)
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

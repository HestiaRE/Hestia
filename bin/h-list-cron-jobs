#!/bin/bash
# info: list user cron jobs
# options: USER [FORMAT]
#
# example: h-list-cron-jobs admin
#
# All jobs of the user, as json, shell or plain.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep JOB $USER_DATA/cron.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		# No \" escaping here: json_escape does it, and both together doubled every escape.
		CMD=$(record_value_decode "$CMD")
		json_escape JOB MIN HOUR DAY MONTH WDAY CMD SUSPENDED TIME DATE
		printf '    "%s": {\n' "$JOB"
		printf '        "MIN": "%s",\n' "$MIN"
		printf '        "HOUR": "%s",\n' "$HOUR"
		printf '        "DAY": "%s",\n' "$DAY"
		printf '        "MONTH": "%s",\n' "$MONTH"
		printf '        "WDAY": "%s",\n' "$WDAY"
		printf '        "CMD": "%s",\n' "$CMD"
		printf '        "JOB": "%s",\n' "$JOB"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/cron.conf)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "JOB^MIN^HOUR^DAY^MONTH^WDAY^COMMAND"
	echo "---^---^----^---^-----^----^-------"
	while read str; do
		parse_object_kv_list "$str"
		# The \" escaping shell and plain have always printed; JSON leaves it to json_escape.
		CMD=$(record_value_decode "$CMD")
		CMD=${CMD//\"/\\\"}
		echo "$JOB^$MIN^$HOUR^$DAY^$MONTH^$WDAY^$CMD"
	done < <(cat $USER_DATA/cron.conf)
}

plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		CMD=$(record_value_decode "$CMD")
		CMD=${CMD//\"/\\\"}
		# printf, not echo -e: a command may carry a backslash.
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$JOB" "$MIN" "$HOUR" "$DAY" "$MONTH" "$WDAY" "$CMD" "$SUSPENDED" "$TIME" "$DATE"
	done < <(cat $USER_DATA/cron.conf)
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

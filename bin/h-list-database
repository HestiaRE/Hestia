#!/bin/bash
# info: list database
# options: USER DATABASE [FORMAT]
#
# example: h-list-database admin admin_wp_db
#
# Prints the record of one database.

user=$1
database=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	json_escape database DB DBUSER DBUSER_SECOND DBUSER_SECOND_RO HOST TYPE CHARSET U_DISK SUSPENDED TIME DATE
	printf '    "%s": {\n' "$database"
	printf '        "DATABASE": "%s",\n' "$DB"
	printf '        "DBUSER": "%s",\n' "$DBUSER"
	printf '        "DBUSER_SECOND": "%s",\n' "$DBUSER_SECOND"
	printf '        "DBUSER_SECOND_RO": "%s",\n' "$DBUSER_SECOND_RO"
	printf '        "HOST": "%s",\n' "$HOST"
	printf '        "TYPE": "%s",\n' "$TYPE"
	printf '        "CHARSET": "%s",\n' "$CHARSET"
	printf '        "U_DISK": "%s",\n' "$U_DISK"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "DATABASE:       $DB"
	echo "DB USER:        $DBUSER"
	echo "SECOND USER:    $DBUSER_SECOND${DBUSER_SECOND_RO:+ (read-only)}"
	echo "HOST:           $HOST"
	echo "TYPE:           $TYPE"
	echo "CHARSET:        $CHARSET"
	echo "DISK:           $U_DISK"
	echo "SUSPENDED:      $SUSPENDED"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

plain_list() {
	echo -ne "$DB\t$DBUSER\t$HOST\t$TYPE\t$CHARSET\t$U_DISK\t"
	echo -e "$SUSPENDED\t$TIME\t$DATE"
}

check_args '2' "$#" 'USER DATABASE [FORMAT]'
is_format_valid 'user' 'database'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

parse_object_kv_list "$(grep -F "DB='$database'" $USER_DATA/db.conf)"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

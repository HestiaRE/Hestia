#!/bin/bash
# info: list the database types that have a registered host
# options: [FORMAT]
#
# example: h-list-database-types json
#
# DB_SYSTEM as h-add-database-host composes it; h-add-database takes only these types.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$(echo "${DB_SYSTEM//,/ }" | wc -w)
	i=1
	echo '['
	local -a _type_list
	IFS=, read -ra _type_list <<< "$DB_SYSTEM"
	for type in "${_type_list[@]}"; do
		[ -n "$type" ] || continue
		json_escape type
		printf '    "%s"' "$type"
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo "]"
}

shell_list() {
	echo -e "TYPE\n----"
	echo "$DB_SYSTEM" | sed -e "s/,/\n/"
}

plain_list() {
	local -a _type_list
	IFS=, read -ra _type_list <<< "$DB_SYSTEM"
	for type in "${_type_list[@]}"; do
		[ -n "$type" ] || continue
		echo "$type"
	done
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list supported database types
# options: [FORMAT]
#
# example: h-list-database-types json
#
# This function for obtaining the list of database types.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	objects=$(echo "${DB_SYSTEM//,/ }" | wc -w)
	i=1
	echo '['
	local -a _type_list
	IFS=, read -ra _type_list <<< "$DB_SYSTEM"
	for type in "${_type_list[@]}"; do
		[ -n "$type" ] || continue
		json_escape type
		printf '    "%s"' "$type"
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo "]"
}

# SHELL list function
shell_list() {
	echo -e "TYPE\n----"
	echo "$DB_SYSTEM" | sed -e "s/,/\n/"
}

# PLAIN list function
plain_list() {
	local -a _type_list
	IFS=, read -ra _type_list <<< "$DB_SYSTEM"
	for type in "${_type_list[@]}"; do
		[ -n "$type" ] || continue
		echo "$type"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

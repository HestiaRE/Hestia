#!/bin/bash
# info: listing databases
# options: USER [FORMAT]
#
# example: h-list-databases user json
#
# Lists the databases of USER.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep "DB=" $USER_DATA/db.conf | wc -l)
	echo "{"
	while read -r str; do
		# Older records have no slot-2 keys, so the previous record's would carry over.
		DBUSER_SECOND='' DBUSER_SECOND_RO=''
		parse_object_kv_list "$str"
		json_escape DB DBUSER DBUSER_SECOND DBUSER_SECOND_RO HOST TYPE CHARSET U_DISK SUSPENDED TIME DATE
		printf '    "%s": {\n' "$DB"
		printf '        "DATABASE": "%s",\n' "$DB"
		printf '        "DBUSER": "%s",\n' "$DBUSER"
		printf '        "DBUSER_SECOND": "%s",\n' "$DBUSER_SECOND"
		printf '        "DBUSER_SECOND_RO": "%s",\n' "$DBUSER_SECOND_RO"
		printf '        "HOST": "%s",\n' "$HOST"
		printf '        "TYPE": "%s",\n' "$TYPE"
		printf '        "CHARSET": "%s",\n' "$CHARSET"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/db.conf)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "DATABASE   USER   HOST   TYPE   DISK   SPND   DATE"
	echo "--------   ----   ----   ----   ----   ----   ----"
	while read str; do
		parse_object_kv_list "$str"
		echo "$DB $DBUSER $HOST $TYPE $U_DISK $SUSPENDED $DATE"
	done < <(cat $USER_DATA/db.conf)
}

plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		echo -ne "$DB\t$DBUSER\t$HOST\t$TYPE\t$CHARSET\t$U_DISK\t"
		echo -e "$SUSPENDED\t$TIME\t$DATE"
	done < <(cat $USER_DATA/db.conf)
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

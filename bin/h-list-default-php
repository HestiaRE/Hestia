#!/bin/bash
# info: list default PHP version used by default.tpl
# options: [FORMAT]
#
# example: h-list-default-php

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	i=1
	objects=$(echo "${versions[@]}" | wc -w)
	echo '['
	for version in "${versions[@]}"; do
		json_escape version
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$version"
		else
			printf '\t"%s"\n' "$version"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "VERSION"
	echo "--------"
	for version in "${versions[@]}"; do
		echo "$version"
	done
}

plain_list() {
	for version in "${versions[@]}"; do
		echo "$version"
	done
}

declare -a versions
# The system default from update-alternatives.
versions+=("$(multiphp_default_version)")

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

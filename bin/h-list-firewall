#!/bin/bash
# info: list iptables rules
# options: [FORMAT]
#
# example: h-list-firewall json
#
# Lists every rule in the firewall's rules.conf, suspended ones included.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep RULE $CONF_DIR/firewall/rules.conf | wc -l)
	echo "{"
	while read -r str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		json_escape RULE ACTION PROTOCOL PORT IP COMMENT SUSPENDED TIME DATE
		printf '    "%s": {\n' "$RULE"
		printf '        "ACTION": "%s",\n' "$ACTION"
		printf '        "PROTOCOL": "%s",\n' "$PROTOCOL"
		printf '        "PORT": "%s",\n' "$PORT"
		printf '        "IP": "%s",\n' "$IP"
		printf '        "COMMENT": "%s",\n' "$COMMENT"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $CONF_DIR/firewall/rules.conf)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "RULE^ACTION^PROTO^PORT^IP^SPND^DATE"
	echo "----^------^-----^----^--^----^----"
	while read str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		echo "$RULE^$ACTION^$PROTOCOL^$PORT^$IP^$SUSPENDED^$DATE"
	done < <(cat $CONF_DIR/firewall/rules.conf)
}

plain_list() {
	IFS=$'\n'
	while read str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		echo -ne "$RULE\t$ACTION\t$PROTOCOL\t$PORT\t$IP\t$COMMENT\t"
		echo -e "$SUSPENDED\t$TIME\t$DATE"
	done < <(cat $CONF_DIR/firewall/rules.conf)
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list firewall block list
# options: [FORMAT]
#
# example: h-list-firewall-ban json
#
# This function of obtaining the list of currently blocked ips.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep IP $CONF_DIR/firewall/banlist.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		json_escape IP CHAIN TIME DATE
		# One address can sit in several jails, so the key carries the chain or a second ban hides the first.
		printf '    "%s|%s": {\n' "$IP" "$CHAIN"
		printf '        "IP": "%s",\n' "$IP"
		printf '        "CHAIN": "%s",\n' "$CHAIN"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $CONF_DIR/firewall/banlist.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "IP   CHAIN   TIME   DATE"
	echo "--   -----   ----   ----"
	while read str; do
		parse_object_kv_list "$str"
		echo "$IP $CHAIN $TIME $DATE"
	done < <(cat $CONF_DIR/firewall/banlist.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		echo -e "$IP\t$CHAIN\t$TIME\t$DATE"
	done < <(cat $CONF_DIR/firewall/banlist.conf)
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

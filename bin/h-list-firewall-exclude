#!/bin/bash
# info: list firewall whitelist
# options: [FORMAT]
#
# example: h-list-firewall-exclude json
#
# The whitelist is a bare address per line; the formats exist to match the other h-list-firewall-* commands.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

excludes="$CONF_DIR/firewall/excludes.conf"

json_list() {
	echo '{'
	local i=0
	while read -r ip; do
		[ -n "$ip" ] || continue
		[ "$i" -gt 0 ] && echo -e '\t},'
		json_escape ip
		printf '\t"%s": {\n' "$ip"
		printf '\t\t"IP": "%s"\n' "$ip"
		i=$((i + 1))
	done < <(grep -v '^\s*$' "$excludes" 2> /dev/null)
	[ "$i" -gt 0 ] && echo -e '\t}'
	echo '}'
}

shell_list() {
	echo "IP"
	echo "----"
	grep -v '^\s*$' "$excludes" 2> /dev/null
}

plain_list() {
	grep -v '^\s*$' "$excludes" 2> /dev/null
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: List firewall ipset
# options: [FORMAT]
#
# example: h-list-firewall-ipset json
#
# This function prints defined ipset lists

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep LISTNAME $CONF_DIR/firewall/ipset.conf | wc -l)
	echo "{"
	while read -r str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		json_escape LISTNAME IP_VERSION AUTOUPDATE SUSPENDED SOURCE TIME DATE
		printf '    "%s": {\n' "$LISTNAME"
		printf '        "IP_VERSION": "%s",\n' "$IP_VERSION"
		printf '        "AUTOUPDATE": "%s",\n' "$AUTOUPDATE"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "SOURCE": "%s",\n' "$SOURCE"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		[[ "$i" -lt "$objects" ]] && echo ',' || echo
		((i++))
	done < <(cat $CONF_DIR/firewall/ipset.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "LISTNAME^IP_VERSION^AUTOUPDATE^SUSPENDED^SOURCE^TIME^DATE"
	echo "----^------^-----^----^--^----^----"
	while read str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		echo "$LISTNAME^$IP_VERSION^$AUTOUPDATE^$SUSPENDED^$SOURCE^$TIME^$DATE"
	done < <(cat $CONF_DIR/firewall/ipset.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read str; do
		[[ -z "$str" ]] && continue
		parse_object_kv_list "$str"
		echo -ne "$LISTNAME\t$IP_VERSION\t$AUTOUPDATE\t$SUSPENDED\t$SOURCE\t"
		echo -e "$TIME\t$DATE"
	done < <(cat $CONF_DIR/firewall/ipset.conf)
}

[ ! -f "$CONF_DIR/firewall/ipset.conf" ] && touch "$CONF_DIR/firewall/ipset.conf"

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: list fail2ban jail status
# options: [FORMAT]
#
# example: h-list-firewall-jail json
#
# Configured jails united with running ones, so a configured jail that is not running shows STATE='stopped'
# instead of vanishing from the list.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source $HESTIA/include/fail2ban.sh
source_conf "$HESTIA/conf/hestia.conf"

f2bcli="/usr/bin/fail2ban-client"

# Sorted and de-duplicated, so the two sources cannot report one jail twice.
jail_names() {
	{
		fail2ban_enabled_jails
		"$f2bcli" status 2> /dev/null | grep -i 'Jail list:' | cut -d':' -f2- | tr ',' '\n' | tr -d '[:blank:]'
	} | grep -v '^$' | sort -u
}

# One field out of `fail2ban-client status <jail>`; the value follows the label after whitespace.
status_field() {
	echo "$1" | sed -n "s/.*$2:[[:space:]]*//p" | head -1
}

jail_row() {
	local jail="$1" out
	out="$("$f2bcli" status "$jail" 2> /dev/null)"
	if [ -z "$out" ]; then
		JAIL="$jail" STATE='stopped' FAILED='0' FAILED_TOTAL='0' BANNED='0' BANNED_TOTAL='0' LOGPATH=''
		return 0
	fi
	JAIL="$jail"
	STATE='running'
	FAILED="$(status_field "$out" 'Currently failed')"
	FAILED_TOTAL="$(status_field "$out" 'Total failed')"
	BANNED="$(status_field "$out" 'Currently banned')"
	BANNED_TOTAL="$(status_field "$out" 'Total banned')"
	LOGPATH="$(status_field "$out" 'File list')"
}

json_list() {
	local i=0
	echo '{'
	while read -r jail; do
		jail_row "$jail"
		[ "$i" -gt 0 ] && echo -e '\t},'
		json_escape JAIL STATE FAILED FAILED_TOTAL BANNED BANNED_TOTAL LOGPATH
		printf '\t"%s": {\n' "$JAIL"
		printf '\t\t"JAIL": "%s",\n' "$JAIL"
		printf '\t\t"STATE": "%s",\n' "$STATE"
		printf '\t\t"FAILED": "%s",\n' "$FAILED"
		printf '\t\t"FAILED_TOTAL": "%s",\n' "$FAILED_TOTAL"
		printf '\t\t"BANNED": "%s",\n' "$BANNED"
		printf '\t\t"BANNED_TOTAL": "%s",\n' "$BANNED_TOTAL"
		printf '\t\t"LOGPATH": "%s"\n' "$LOGPATH"
		i=$((i + 1))
	done < <(jail_names)
	[ "$i" -gt 0 ] && echo -e '\t}'
	echo '}'
}

shell_list() {
	printf "%-20s %-9s %-8s %-8s\n" "JAIL" "STATE" "FAILED" "BANNED"
	printf "%-20s %-9s %-8s %-8s\n" "--------------------" "---------" "--------" "--------"
	while read -r jail; do
		jail_row "$jail"
		printf "%-20s %-9s %-8s %-8s\n" "$JAIL" "$STATE" "$FAILED" "$BANNED"
	done < <(jail_names)
}

plain_list() {
	while read -r jail; do
		jail_row "$jail"
		echo -e "$JAIL\t$STATE\t$FAILED\t$FAILED_TOTAL\t$BANNED\t$BANNED_TOTAL\t$LOGPATH"
	done < <(jail_names)
}

is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
is_system_enabled "$FIREWALL_EXTENSION" 'FIREWALL_EXTENSION'

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

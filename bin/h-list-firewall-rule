#!/bin/bash
# info: list firewall rule
# options: RULE [FORMAT]
#
# example: h-list-firewall-rule 2
#
# Prints the fields of one firewall rule.

rule=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	json_escape RULE ACTION PROTOCOL PORT IP COMMENT SUSPENDED TIME DATE
	printf '    "%s": {\n' "$RULE"
	printf '        "ACTION": "%s",\n' "$ACTION"
	printf '        "PROTOCOL": "%s",\n' "$PROTOCOL"
	printf '        "PORT": "%s",\n' "$PORT"
	printf '        "IP": "%s",\n' "$IP"
	printf '        "COMMENT": "%s",\n' "$COMMENT"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "ACTION:         $ACTION"
	echo "PROTOCOL:       $PROTOCOL"
	echo "PORT:           $PORT"
	echo "IP:             $IP"
	echo "COMMENT:        $COMMENT"
	echo "SUSPENDED:      $SUSPENDED"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

plain_list() {
	echo -ne "$RULE\t$ACTION\t$PROTOCOL\t$PORT\t$IP\t$COMMENT\t"
	echo -e "$SUSPENDED\t$TIME\t$DATE"
}

check_args '1' "$#" 'RULE [FORMAT]'
is_number_format_valid "$rule" "rule id"
is_object_valid "$CONF_DIR/firewall/rules" 'RULE' "$rule"

parse_object_kv_list "$(grep "RULE='$rule'" $CONF_DIR/firewall/rules.conf)"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

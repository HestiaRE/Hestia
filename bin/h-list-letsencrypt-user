#!/bin/bash
# info: list letsencrypt key
# options: USER [FORMAT]
#
# example: h-list-letsencrypt-user admin
#
# Lists the user's Let's Encrypt account key data and thumbprint.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	json_escape user EMAIL EXPONENT MODULUS THUMB KID
	printf '    "%s": {\n' "$user"
	printf '        "EMAIL": "%s",\n' "$EMAIL"
	printf '        "EXPONENT": "%s",\n' "$EXPONENT"
	printf '        "MODULUS": "%s",\n' "$MODULUS"
	printf '        "THUMB": "%s",\n' "$THUMB"
	printf '        "KID": "%s"\n' "$KID"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "USER:           $user"
	echo "EMAIL:          $EMAIL"
	echo "THUMB:          $THUMB"
	echo "EXPONENT:       $EXPONENT"
	echo "MODULUS:        $MODULUS"
	echo "KID:            $KID"
}

plain_list() {
	echo -e "$user\t$EMAIL\t$EXPONENT\t$MODULUS\t$THUMB\t$KID"
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ ! -e "$USER_DATA/ssl/le.conf" ]; then
	check_result "$E_NOTEXIST" "LetsEncrypt user account doesn't exist"
fi

le_conf_load "$USER_DATA/ssl/le.conf"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

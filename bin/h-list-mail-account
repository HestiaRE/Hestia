#!/bin/bash
# info: list mail domain account
# options: USER DOMAIN ACCOUNT [FORMAT]
#
# example: h-list-mail-account admin domain.tld tester
#
# Lists the account record.

user=$1
domain=$2
account=$3
format=${4-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	webmail_addr="$WEBMAIL_ALIAS.$domain"
	json_escape webmail_addr account ALIAS FWD FWD_ONLY AUTOREPLY QUOTA RATE_LIMIT U_DISK SUSPENDED TIME DATE
	printf '    "%s": {\n' "$account"
	printf '        "ALIAS": "%s",\n' "$ALIAS"
	printf '        "FWD": "%s",\n' "$FWD"
	printf '        "FWD_ONLY": "%s",\n' "$FWD_ONLY"
	printf '        "AUTOREPLY": "%s",\n' "$AUTOREPLY"
	printf '        "QUOTA": "%s",\n' "$QUOTA"
	printf '        "RATE_LIMIT": "%s",\n' "$RATE_LIMIT"
	printf '        "U_DISK": "%s",\n' "$U_DISK"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s",\n' "$DATE"
	printf '        "WEBMAIL_ALIAS": "%s"\n' "$webmail_addr"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "ACCOUNT:        $account"
	echo "ALIAS:          $ALIAS"
	echo "FORWARD:        $FWD"
	echo "FORWARD_ONLY:   $FWD_ONLY"
	echo "AUTOREPLY:      $AUTOREPLY"
	echo "QUOTA:          $QUOTA"
	echo "DISK:           $U_DISK"
	echo "SUSPENDED:      $SUSPENDED"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
	echo "WEBMAIL_ALIAS:  $WEBMAIL_ALIAS.$domain"
}

plain_list() {
	echo -ne "$account\t$ALIAS\t$FWD\t$FWD_ONLY\t$AUTOREPLY\t$QUOTA\t"
	echo -e "$U_DISK\t$SUSPENDED\t$TIME\t$DATE\t$WEBMAIL_ALIAS.$domain"
}

check_args '3' "$#" 'USER DOMAIN ACCOUNT [FORMAT]'
is_format_valid 'user' 'domain' 'account'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"

parse_object_kv_list "$(grep -F "ACCOUNT='$account'" $USER_DATA/mail/$domain.conf)"
# With Sieve the customer can switch it in the webmail, so the script answers, not the record.
if vacation_sieve_on; then
	format_domain_idn
	AUTOREPLY=$(vacation_live "$user" "$domain_idn" "$account" | cut -d' ' -f2)
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list mail account autoreply
# options: USER DOMAIN ACCOUNT [FORMAT]
#
# example: h-list-mail-account-autoreply admin example.com testing
#
# Lists the account's autoreply text with its SOURCE and whether it is ENABLED.

user=$1
domain=$2
account=$3
format=${4-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	# From the raw message, without a %quote% decode: no writer encodes the .msg file, decoding only altered the text.
	local msg="$msg_raw"
	echo '{'
	json_escape account msg source enabled
	printf '\t"%s": {\n' "$account"
	echo "            \"MSG\": \"$msg\","
	echo "            \"SOURCE\": \"$source\","
	echo "            \"ENABLED\": \"$enabled\""
	echo -e "\t}\n}"
}

shell_list() {
	echo "$msg"
}

plain_list() {
	echo "$msg"
}

check_args '3' "$#" 'USER DOMAIN ACCOUNT [FORMAT]'
is_format_valid 'user' 'domain' 'account'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"

# SOURCE: exim, the webmail's Sieve format (roundcube, tachyon, none yet) or custom, shown but never written.
# With Sieve the script answers, not the record: the customer may have changed it in the webmail.
source='exim'
enabled=$(get_object_value "mail/$domain" 'ACCOUNT' "$account" '$AUTOREPLY')
if vacation_sieve_on; then
	format_domain_idn
	# A script php cannot parse is shown as custom, the panel does not offer to write over it.
	st=$(vacation_state "$user" "$domain_idn" "$account") || st='{"format":"custom","enabled":false,"message":""}'
	source=$(echo "$st" | jq -r '.format')
	enabled=$(echo "$st" | jq -r 'if .enabled then "yes" else "no" end')
	msg_raw=$(echo "$st" | jq -r '.message')
	# A notice not yet in the script still shows what the panel last set.
	if [ -z "$msg_raw" ] && [ -e "$USER_DATA/mail/$account@$domain.msg" ]; then
		msg_raw=$(cat "$USER_DATA/mail/$account@$domain.msg")
	fi
elif [ -e "$USER_DATA/mail/$account@$domain.msg" ]; then
	msg_raw=$(cat $USER_DATA/mail/$account@$domain.msg)
fi
msg=$(echo "$msg_raw" | sed ':a;N;$!ba;s/\n/\\n/g')

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

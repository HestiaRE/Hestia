#!/bin/bash
# info: list mail account autoreply
# options: USER DOMAIN ACCOUNT [FORMAT]
#
# example: h-list-mail-account-autoreply admin example.com testing
#
# This function of obtaining mail account autoreply message.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
account=$3
format=${4-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	# json_escape replaces the hand-rolled sed chain and works on the RAW message: it covers the
	# backslash, the quote and the newline encoding in one place. No storage decode here: the message
	# lives in its own .msg file that no writer ever encodes, here or in the upstream this came from,
	# so decoding %quote% only rewrote a customer's literal text, and the shell branch below never
	# did it either (#1002).
	local msg="$msg_raw"
	echo '{'
	json_escape account msg
	printf '\t"%s": {\n' "$account"
	echo "            \"MSG\": \"$msg\""
	echo -e "\t}\n}"
}

# SHELL list function
shell_list() {
	echo "$msg"
}

# PLAIN list function
plain_list() {
	echo "$msg"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN ACCOUNT [FORMAT]'
is_format_valid 'user' 'domain' 'account'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"
is_object_valid "mail/$domain" 'ACCOUNT' "$account"
is_object_unsuspended "mail/$domain" 'ACCOUNT' "$account"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -e "$USER_DATA/mail/$account@$domain.msg" ]; then
	msg_raw=$(cat $USER_DATA/mail/$account@$domain.msg)
	msg=$(echo "$msg_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

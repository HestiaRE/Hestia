#!/bin/bash
# info: list mail domain accounts
# options: USER DOMAIN [FORMAT]
#
# example: h-list-mail-accounts admin acme.com
#
# Lists the accounts of one mail domain.

user=$1
domain=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/vacation.sh
source $HESTIA/include/vacation.sh
source_conf "$HESTIA/conf/hestia.conf"

# With Sieve the customer can switch it in the webmail, so the script answers, not the record.
declare -A live=()
live_autoreply() {
	if [ -n "${live[$ACCOUNT]}" ]; then
		AUTOREPLY=${live[$ACCOUNT]}
	fi
}

# Account rows only, each from empty: a blank line repeated the last account, a missing key inherited its value.
rows() {
	grep "^ACCOUNT='" "$USER_DATA/mail/$domain.conf"
}

parse_row() {
	ALIAS='' FWD='' FWD_ONLY='' AUTOREPLY='' QUOTA='' U_DISK='' SUSPENDED='' TIME='' DATE=''
	parse_object_kv_list "$1"
}

json_list() {
	IFS=$'\n'
	i=1
	objects=$(rows | wc -l)
	echo "{"
	while read -r str; do
		parse_row "$str"
		live_autoreply
		json_escape ACCOUNT ALIAS FWD FWD_ONLY AUTOREPLY QUOTA U_DISK SUSPENDED TIME DATE
		printf '    "%s": {\n' "$ACCOUNT"
		printf '        "ALIAS": "%s",\n' "$ALIAS"
		printf '        "FWD": "%s",\n' "$FWD"
		printf '        "FWD_ONLY": "%s",\n' "$FWD_ONLY"
		printf '        "AUTOREPLY": "%s",\n' "$AUTOREPLY"
		printf '        "QUOTA": "%s",\n' "$QUOTA"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(rows)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "ACCOUNT   ALIAS   FWD   DISK  DATE"
	echo "-------   -----   ---   ----  ----"
	while read str; do
		parse_row "$str"
		if [ -z "$ALIAS" ]; then
			ALIAS='no'
		else
			if [ "${#ALIAS}" -gt 12 ]; then
				ALIAS="${ALIAS:0:12}..."
			fi
		fi
		if [ -z "$FWD" ]; then
			FWD='no'
		else
			if [ "${#FWD}" -gt 20 ]; then
				FWD="${FWD:0:20}..."
			fi
		fi
		echo "$ACCOUNT $ALIAS $FWD $U_DISK $DATE"
	done < <(rows)
}

plain_list() {
	IFS=$'\n'
	while read str; do
		parse_row "$str"
		live_autoreply
		echo -ne "$ACCOUNT\t$ALIAS\t$FWD\t$FWD_ONLY\t$AUTOREPLY\t"
		echo -e "$QUOTA\t$U_DISK\t$SUSPENDED\t$TIME\t$DATE"
	done < <(rows)
}

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

if vacation_sieve_on && [ "$format" != 'shell' ]; then
	format_domain_idn
	mapfile -t accounts < <(sed -n "s/^ACCOUNT='\([^']*\)'.*/\1/p" "$USER_DATA/mail/$domain.conf")
	while read -r acc st; do
		live[$acc]=$st
	done < <(vacation_live "$user" "$domain_idn" "${accounts[@]}")
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

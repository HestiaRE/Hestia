#!/bin/bash
# info: list mail domain
# options: USER DOMAIN [FORMAT]
#
# example: h-list-mail-domain user01 mydomain.com
#
# This function of obtaining the list of domain parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
format=${3-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)"
	U_SMTP_RELAY_USERNAME=$(record_value_decode "$U_SMTP_RELAY_USERNAME")
	echo '{'
	webmail_addr="$WEBMAIL_ALIAS.$domain"
	json_escape webmail_addr DOMAIN ANTIVIRUS ANTISPAM DKIM CATCHALL ACCOUNTS RATE_LIMIT REJECT U_DISK SSL LETSENCRYPT SUSPENDED TIME DATE WEBMAIL_ALIAS WEBMAIL U_SMTP_RELAY U_SMTP_RELAY_HOST U_SMTP_RELAY_PORT U_SMTP_RELAY_USERNAME U_SPAM_SCORE U_SPAM_REJECT_SCORE U_SPAM_SUBJECT_TAG
	printf '    "%s": {\n' "$DOMAIN"
	printf '        "ANTIVIRUS": "%s",\n' "$ANTIVIRUS"
	printf '        "ANTISPAM": "%s",\n' "$ANTISPAM"
	printf '        "DKIM": "%s",\n' "$DKIM"
	printf '        "CATCHALL": "%s",\n' "$CATCHALL"
	printf '        "ACCOUNTS": "%s",\n' "$ACCOUNTS"
	printf '        "RATE_LIMIT": "%s",\n' "$RATE_LIMIT"
	printf '        "REJECT": "%s",\n' "$REJECT"
	printf '        "U_DISK": "%s",\n' "$U_DISK"
	printf '        "SSL": "%s",\n' "$SSL"
	printf '        "LETSENCRYPT": "%s",\n' "$LETSENCRYPT"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s",\n' "$DATE"
	printf '        "WEBMAIL_ALIAS": "%s",\n' "$webmail_addr"
	printf '        "WEBMAIL":"%s",\n' "$WEBMAIL"
	printf '        "U_SMTP_RELAY":"%s",\n' "$U_SMTP_RELAY"
	printf '        "U_SMTP_RELAY_HOST":"%s",\n' "$U_SMTP_RELAY_HOST"
	printf '        "U_SMTP_RELAY_PORT":"%s",\n' "$U_SMTP_RELAY_PORT"
	printf '        "U_SMTP_RELAY_USERNAME":"%s",\n' "$U_SMTP_RELAY_USERNAME"
	printf '        "U_SPAM_SCORE":"%s",\n' "$U_SPAM_SCORE"
	printf '        "U_SPAM_REJECT_SCORE":"%s",\n' "$U_SPAM_REJECT_SCORE"
	printf '        "U_SPAM_SUBJECT_TAG":"%s"\n' "$U_SPAM_SUBJECT_TAG"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "DOMAIN:             $DOMAIN"
	echo "ANTIVIRUS:          $ANTIVIRUS"
	echo "ANTISPAM:           $ANTISPAM"
	echo "DKIM:               $DKIM"
	echo "CATCHALL:           $CATCHALL"
	echo "ACCOUNTS:           $ACCOUNTS"
	echo "DISK:               $U_DISK"
	echo "SSL:                $SSL"
	echo "RATE_LIMIT:         $RATE_LIMIT"
	echo "REJECT:             $REJECT"
	echo "LETSENCRYPT:        $LETSENCRYPT"
	echo "SUSPENDED:          $SUSPENDED"
	echo "TIME:               $TIME"
	echo "DATE:               $DATE"
	echo "WEBMAIL_ALIAS:      $WEBMAIL_ALIAS.$domain"
	echo "WEBMAIL:            $WEBMAIL"
	echo "U_SMTP_RELAY:          $U_SMTP_RELAY"
	echo "U_SMTP_RELAY_HOST      $U_SMTP_RELAY_HOST"
	echo "U_SMTP_RELAY_PORT      $U_SMTP_RELAY_PORT"
	echo "U_SMTP_RELAY_USERNAME  $U_SMTP_RELAY_USERNAME"
	echo "U_SPAM_SCORE:          $U_SPAM_SCORE"
	echo "U_SPAM_REJECT_SCORE:   $U_SPAM_REJECT_SCORE"
	echo "U_SPAM_SUBJECT_TAG:    $U_SPAM_SUBJECT_TAG"
}

# PLAIN list function
plain_list() {
	# One record, one line: the two middle echoes lacked -n, so a reader got four lines - two
	# header-shaped, two data-shaped - and counted the fields of the wrong one (#861).
	echo -ne "$DOMAIN\t$ANTIVIRUS\t$ANTISPAM\t$DKIM\t$CATCHALL\t"
	echo -ne "$ACCOUNTS\t$U_DISK\t$SSL\t$LETSENCRYPT\t$SUSPENDED\t$TIME\t$DATE\t$WEBMAIL_ALIAS.$domain\t$WEBMAIL\t"
	echo -ne "$U_SMTP_RELAY\t$U_SMTP_RELAY_HOST\t$U_SMTP_RELAY_PORT\t$U_SMTP_RELAY_USERNAME\t"
	echo -e "$U_SPAM_SCORE\t$U_SPAM_REJECT_SCORE\t$U_SPAM_SUBJECT_TAG"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing mail domain
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)"
U_SMTP_RELAY_USERNAME=$(record_value_decode "$U_SMTP_RELAY_USERNAME")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: list mail domain dkim dns records
# options: USER DOMAIN [FORMAT]
#
# example: h-list-mail-domain-dkim-dns admin example.com
#
# Lists the DNS records the domain's DKIM needs.

user=$1
domain=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	echo -e "\n\t\"mail._domainkey\": {"
	echo "            \"TTL\": \"3600\","
	json_escape pub
	echo "            \"TXT\": \"'v=DKIM1; k=rsa; p=$pub'\""
	echo -e "\t}\n}"
}

shell_list() {
	echo "RECORD            TTL         TYPE      VALUE"
	echo "------            ---         ----      -----"
	echo "mail._domainkey   3600   IN   TXT      \"v=DKIM1; k=rsa; p=$pub\""
}

plain_list() {
	echo -e "mail._domainkey\t3600\tIN\tTXT\t\"v=DKIM1; k=rsa; p=$pub\""
}

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

if [ -e "$USER_DATA/mail/$domain.pub" ]; then
	pub=$(cat $USER_DATA/mail/$domain.pub | grep -v "KEY-----")
	pub=$(echo "$pub" | sed ':a;N;$!ba;s/\n//g')
else
	pub="DKIM-SUPPORT-IS-NOT-ACTIVATED"
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list smtp relay excludes for mail domain
# options: USER DOMAIN [FORMAT]
#
# example: h-list-mail-domain-relay-exclude user domain.tld json
#
# Lists the recipient domains that bypass the SMTP relay.

user=$1
domain=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	json_escape domain entries
	printf '\t"%s": {\n' "$domain"
	echo "        \"RELAY_EXCLUDE\": \"$entries\""
	echo -e "\t}\n}"
}

shell_list() {
	echo "RELAY_EXCLUDE"
	echo "-------------"
	if [ -n "$entries" ]; then
		echo "$entries" | tr ',' '\n'
	fi
}

plain_list() {
	if [ -n "$entries" ]; then
		echo "$entries" | tr ',' '\n'
	fi
}

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

entries=$(get_object_value 'mail' 'DOMAIN' "$domain" '$U_SMTP_RELAY_EXCLUDE')

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

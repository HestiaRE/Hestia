#!/bin/bash
# info: list mail domain ssl certificate
# options: USER DOMAIN [FORMAT]
#
# example: h-list-mail-domain-ssl user acme.com json
#
# This function of obtaining domain ssl files.

user=$1
domain=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

json_list() {
	# The raw files: json_escape encodes newlines itself, over the encoded copy each \n would show literally.
	local crt="${crt_raw}" key="${key_raw}" ca="${ca_raw}"
	json_escape domain crt key ca subj alt_dns before after signature pub_key issuer
	echo '{'
	printf '\t"%s": {\n' "$domain"
	echo "        \"CRT\": \"$crt\","
	echo "        \"KEY\": \"$key\","
	echo "        \"CA\": \"$ca\","
	echo "        \"SUBJECT\": \"$subj\","
	echo "        \"ALIASES\": \"$alt_dns\","
	echo "        \"NOT_BEFORE\": \"$before\","
	echo "        \"NOT_AFTER\": \"$after\","
	echo "        \"SIGNATURE\": \"$signature\","
	echo "        \"PUB_KEY\": \"$pub_key\","
	echo "        \"ISSUER\": \"$issuer\""
	echo -e "\t}\n}"
}

shell_list() {
	if [ -n "$crt" ]; then
		echo -e "$crt"
	fi
	if [ -n "$key" ]; then
		echo -e "\n$key"
	fi
	if [ -n "$ca" ]; then
		echo -e "\n$ca"
	fi
	if [ -n "$crt" ]; then
		echo
		echo
		echo "SUBJECT:        $subj"
		if [ -n "$alt_dns" ]; then
			echo "ALIASES:        ${alt_dns//,/ }"
		fi
		echo "VALID FROM:     $before"
		echo "VALID TIL:      $after"
		echo "SIGNATURE:      $signature"
		echo "PUB_KEY:        $pub_key"
		echo "ISSUER:         $issuer"
	fi
}

plain_list() {
	if [ -n "$crt" ]; then
		echo -e "$crt"
	fi
	if [ -n "$key" ]; then
		echo -e "\n$key"
	fi
	if [ -n "$ca" ]; then
		echo -e "\n$ca"
	fi
	if [ -n "$crt" ]; then
		echo "$subj"
		echo "${alt_dns//,/ }"
		echo "$before"
		echo "$after"
		echo "$signature"
		echo "$pub_key"
		echo "$issuer"
	fi

}

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"

if [ -e "$USER_DATA/ssl/mail.$domain.crt" ]; then
	crt_raw=$(cat $USER_DATA/ssl/mail.$domain.crt)
	crt=$(echo "$crt_raw" | sed ':a;N;$!ba;s/\n/\\n/g')

	info=$(openssl x509 -text -in $USER_DATA/ssl/mail.$domain.crt)
	subj=$(cert_common_name "$USER_DATA/ssl/mail.$domain.crt")
	before=$(echo "$info" | grep Before: | sed -e "s/.*Before: //")
	after=$(echo "$info" | grep "After :" | sed -e "s/.*After : //")
	signature=$(echo "$info" | grep "Algorithm:" | head -n1)
	signature=$(echo "$signature" | sed -e "s/.*Algorithm: //")
	pub_key=$(echo "$info" | grep Public-Key: | cut -f2 -d \( | tr -d \))
	issuer=$(echo "$info" | grep Issuer: | sed -e "s/.*Issuer: //")
	alt_dns=$(echo "$info" | grep DNS | sed -e 's/DNS:/\n/g' | tr -d ',')
	alt_dns=$(echo "$alt_dns" | tr -d ' ' | sed -e "/^$/d")
	alt_dns=$(echo "$alt_dns" | sed -e ':a;N;$!ba;s/\n/,/g')
fi

if [ -e "$USER_DATA/ssl/mail.$domain.key" ]; then
	key_raw=$(cat $USER_DATA/ssl/mail.$domain.key)
	key=$(echo "$key_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

if [ -e "$USER_DATA/ssl/mail.$domain.ca" ]; then
	ca_raw=$(cat $USER_DATA/ssl/mail.$domain.ca)
	ca=$(echo "$ca_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

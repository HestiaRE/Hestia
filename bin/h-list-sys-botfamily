#!/bin/bash
# info: list web bot rate-limit families
# options: [FORMAT]
#
# example: h-list-sys-botfamily json
#
# The families a domain can throttle with h-change-web-domain-botlimit, including the conf-only BURST and NODELAY.
# Without /etc/hestia/botfamilies.conf the shipped default is listed.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# Object base without .conf: get_object_value appends it.
OBJ="$CONF_DIR/botfamilies"
[ -f "$OBJ.conf" ] || OBJ="$HESTIA/share/hestia/botfamilies"

if [ ! -f "$OBJ.conf" ]; then
	[ "$format" = 'json' ] && echo '{}' || echo "No bot-family conf found."
	exit 0
fi

families=$(grep -oE "^FAMILY='[^']*'" "$OBJ.conf" | sed "s/^FAMILY='//; s/'\$//")

fam_field() { get_object_value "$OBJ" 'FAMILY' "$1" "\$$2"; }

json_list() {
	local i=1 total
	total=$(echo "$families" | grep -c .)
	echo "{"
	for f in $families; do
		# Named first, then escaped: a command substitution cannot be escaped in place, and MATCH is an
		# admin-supplied regex, the one field here that routinely carries backslashes.
		enabled=$(fam_field "$f" ENABLED)
		lenient=$(fam_field "$f" LENIENT)
		strict=$(fam_field "$f" STRICT)
		match=$(fam_field "$f" MATCH)
		burst=$(fam_field "$f" BURST)
		nodelay=$(fam_field "$f" NODELAY)
		json_escape f enabled lenient strict match burst nodelay
		printf '    "%s": {\n' "$f"
		printf '        "ENABLED": "%s",\n' "$enabled"
		printf '        "LENIENT": "%s",\n' "$lenient"
		printf '        "STRICT": "%s",\n' "$strict"
		printf '        "MATCH": "%s",\n' "$match"
		printf '        "BURST": "%s",\n' "$burst"
		printf '        "NODELAY": "%s"\n' "$nodelay"
		printf '    }'
		[ "$i" -lt "$total" ] && echo ',' || echo
		((i++))
	done
	echo '}'
}

shell_list() {
	printf '%-15s %-8s %-9s %-9s %s\n' 'FAMILY' 'ENABLED' 'LENIENT' 'STRICT' 'MATCH'
	printf '%-15s %-8s %-9s %-9s %s\n' '------' '-------' '-------' '------' '-----'
	for f in $families; do
		printf '%-15s %-8s %-9s %-9s %s\n' "$f" \
			"$(fam_field "$f" ENABLED)" "$(fam_field "$f" LENIENT)" \
			"$(fam_field "$f" STRICT)" "$(fam_field "$f" MATCH)"
	done
}

plain_list() {
	for f in $families; do
		echo -e "$f\t$(fam_field "$f" ENABLED)\t$(fam_field "$f" LENIENT)\t$(fam_field "$f" STRICT)\t$(fam_field "$f" MATCH)\t$(fam_field "$f" BURST)\t$(fam_field "$f" NODELAY)"
	done
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

log_event "$OK" "$ARGUMENTS"

exit

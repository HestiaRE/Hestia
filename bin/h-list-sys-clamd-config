#!/bin/bash
# info: list clamd config parameters
# options: [FORMAT]
#
# example: h-list-sys-clamd-config
#
# This function for obtaining the list of clamd config parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	json_escape config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "config_path:    $config_path"
}

# PLAIN list function
plain_list() {
	echo "$config_path"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config path
config_path=''
[ ! -e '/etc/clamav/clamd.conf' ] || config_path='/etc/clamav/clamd.conf'

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

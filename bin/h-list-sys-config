#!/bin/bash
# info: list system configuration
# options: [FORMAT] [KEY]
#
# example: h-list-sys-config json
# example: h-list-sys-config secret SERVER_SMTP_PASSWD
#
# This function for obtaining the list of system parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Exposed so the panel offers the per-domain http3 switch only where it works: the deb12/ub24 OS nginx
# has no http_v3 and a quic listen fails nginx -t (#613).
WEB_HTTP3=''
command -v nginx > /dev/null 2>&1 && nginx -V 2>&1 | grep -q -- '--with-http_v3_module' && WEB_HTTP3='yes'

# Every registry key, in registry order: a second list here went stale once and five POLICY_SPAM_* never
# reached a policy gate. An unreadable registry ends this non-zero, so the login refuses (#945).
json_list() {
	local _k _keys _secrets _n=0 _last
	_keys=$(sysreg_keys) || exit "$E_UPDATE"
	# Refuses like the key list above: an unreadable registry would emit every secret in cleartext.
	_secrets=$(sysreg_secret_keys) || exit "$E_UPDATE"
	_secrets=" ${_secrets//$'\n'/ } "
	_last=$(printf '%s\n' "$_keys" | tail -n1)
	echo '{'
	echo '		"config": {'
	# Not a registry key and never in hestia.conf, hence outside the loop.
	json_escape WEB_HTTP3
	printf '			"WEB_HTTP3": "%s",\n' "$WEB_HTTP3"
	for _k in $_keys; do
		# Masked: the panel puts every key in $_SESSION, which PHP writes to a file. Emptiness survives (#976).
		case "$_secrets" in *" $_k "*) [ -z "${!_k}" ] || printf -v "$_k" '%s' '********' ;; esac
		json_escape "$_k"
		_n=$((_n + 1))
		if [ "$_k" = "$_last" ]; then
			printf '			"%s": "%s"\n' "$_k" "${!_k}"
		else
			printf '			"%s": "%s",\n' "$_k" "${!_k}"
		fi
	done
	echo '		}'
	echo '	}'
}

# Only a key the registry marks secret, so this cannot become a general key dumper (#976).
secret_value() {
	local _k="$1"
	[ -n "$_k" ] || check_result "$E_INVALID" "secret: needs a key, e.g. h-list-sys-config secret SERVER_SMTP_PASSWD"
	local _s
	_s=$(sysreg_secret_keys) || check_result "$E_UPDATE" "secret: the key registry is unreadable"
	case " ${_s//$'\n'/ } " in
		*" $_k "*) printf '%s\n' "${!_k}" ;;
		*) check_result "$E_INVALID" "secret: $_k is not a key the registry marks secret" ;;
	esac
}

# Shell list
shell_list() {
	if [ -n "$WEB_SYSTEM" ]; then
		echo "Web Server:                       $WEB_SYSTEM:$WEB_PORT ($WEB_RGROUPS)"
		echo "SSL Support:                      $WEB_SSL:$WEB_SSL_PORT"
	fi
	if [ -n "$WEB_BACKEND" ]; then
		echo "PHP Intepreter:                   $WEB_BACKEND"
	fi
	if [ -n "$PROXY_SYSTEM" ]; then
		echo "Proxy Server:                     $PROXY_SYSTEM:$PROXY_PORT"
		echo "Proxy SSL:                        $PROXY_SYSTEM:$PROXY_SSL_PORT"
	fi
	if [ -n "$STATS_SYSTEM" ]; then
		echo "Statistics Engine:                ${STATS_SYSTEM//,/, }"
	fi
	if [ -n "$FTP_SYSTEM" ]; then
		echo "FTP Server:                       $FTP_SYSTEM"
	fi
	if [ -n "$MAIL_SYSTEM" ]; then
		echo -n "Mail Server:                      $MAIL_SYSTEM"
		if [ -n "$IMAP_SYSTEM" ]; then
			echo -n " + $IMAP_SYSTEM"
		fi
		if [ -n "$ANTIVIRUS_SYSTEM" ]; then
			echo -n " + $ANTIVIRUS_SYSTEM"
		fi
		if [ -n "$ANTISPAM_SYSTEM" ]; then
			echo -n " + $ANTISPAM_SYSTEM"
		fi
		echo
		if [ -n "$WEBMAIL_ALIAS" ]; then
			echo "Webmail alias:                    $WEBMAIL_ALIAS"
		fi
	fi
	if [ -n "$DB_SYSTEM" ]; then
		echo "Database:                         ${DB_SYSTEM//,/, }"
		if [ -n "$DB_PMA_ALIAS" ]; then
			echo "phpMyAdmin Alias:                 $DB_PMA_ALIAS"
		fi
		if [ -n "$DB_ADMINER_ALIAS" ]; then
			echo "Adminer Alias:                    $DB_ADMINER_ALIAS"
		fi
	fi
	if [ -n "$CRON_SYSTEM" ]; then
		echo "CRON daemon:                      $CRON_SYSTEM"
	fi
	if [ -n "$FIREWALL_SYSTEM" ]; then
		echo -n "Firewall:                         $FIREWALL_SYSTEM"
		if [ -n "$FIREWALL_EXTENSION" ]; then
			echo -n "+ $FIREWALL_EXTENSION"
		fi
		echo
	fi
	if [ -n "$BACKUP_SYSTEM" ]; then
		echo "Backups:                          ${BACKUP_SYSTEM//,/, }"
		echo "Backup Directory:                 $BACKUP"
	fi
	if [ -n "$PROJECT_QUOTA" ]; then
		echo "Project Quota:                    $PROJECT_QUOTA"
	fi
	if [ -n "$LANGUAGE" ] && [ "$LANGUAGE" != 'en' ]; then
		echo "System Language:                  $LANGUAGE"
	fi
	echo "Version:                          $VERSION"
	if [ -n "$SMTP_RELAY" ] && [ "$SMTP_RELAY" != 'false' ]; then
		echo "SMTP Relay enabled:                $SMTP_RELAY"
		echo "SMTP Relay Server:                 $SMTP_RELAY_HOST"
		echo "SMTP Relay Port:                   $SMTP_RELAY_PORT"
		echo "SMTP Relay User:                   $SMTP_RELAY_USER"
	fi

	echo "SMTP Server Account enabled:       $USE_SERVER_SMTP"

	if [ -n "$USE_SERVER_SMTP" ] && [ "$USE_SERVER_SMTP" != 'false' ]; then
		echo "SMTP Server Account Host:          $SERVER_SMTP_HOST"
		echo "SMTP Server Account Port:          $SERVER_SMTP_PORT"
		echo "SMTP Server Account Security:      $SERVER_SMTP_SECURITY"
		echo "SMTP Server Account Username:      $SERVER_SMTP_USER"
		echo "SMTP Server Account Password:      $SERVER_SMTP_PASSWD"
		echo "SMTP Server Account Address:       $SERVER_SMTP_ADDR"
	fi

	echo "Release Branch:                   $RELEASE_BRANCH"
	echo "Debug Mode:                       $DEBUG_MODE"
	echo "Theme:                            $THEME"
	echo "Restricted Admin Access:          $POLICY_SYSTEM_PROTECTED_ADMIN"
	echo "Hide System Administator:         $POLICY_SYSTEM_HIDE_ADMIN"
	echo "Updates: Notify by email:         $UPGRADE_SEND_EMAIL"
	echo "Updates: Email install log:       $UPGRADE_SEND_EMAIL_LOG"
}

# CSV list

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
# No plain: the branch dispatched shell_list, so plain promised a machine format and delivered prose
# (#861). This is the one command narrower than is_type_valid 'plain json shell', which lets plain
# through, so the message keeps the common stem and names what this one accepts.
case $format in
	json) json_list ;;
	shell) shell_list ;;
	secret) secret_value "${2-}" ;;
	*) check_result "$E_INVALID" "invalid format: $format - this command has json, shell and secret" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: list system configuration
# options: [FORMAT]
#
# example: h-list-sys-config json
#
# This function for obtaining the list of system parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# CrowdSec presence, artefact-derived (the L3 marker), exposed so the panel can gate on it - the banlist
# button must appear in the crowdsec-only model where FIREWALL_EXTENSION is empty (#527).
CROWDSEC=''
[ -f "$CONF_DIR/firewall/crowdsec.conf" ] && CROWDSEC='yes'

# nginx HTTP/3 build capability, exposed so the panel only offers the per-domain http3 switch where
# it works (#613) - the deb12/ub24 OS nginx has no http_v3 and a quic listen would fail nginx -t.
WEB_HTTP3=''
command -v nginx > /dev/null 2>&1 && nginx -V 2>&1 | grep -q -- '--with-http_v3_module' && WEB_HTTP3='yes'

# JSON list function
json_list() {
	json_escape ANTISPAM_SYSTEM CROWDSEC ANTIVIRUS_SYSTEM APP_NAME BACKEND_PORT BACKUP BACKUP_GZIP BACKUP_INCREMENTAL BACKUP_MODE BACKUP_SYSTEM CRON_SYSTEM DB_ADMINER_ALIAS DB_PMA_ALIAS DB_SYSTEM DEBUG_MODE DISABLE_IP_CHECK PROJECT_QUOTA DOCKER_SYSTEM ENFORCE_SUBDOMAIN_OWNERSHIP FIREWALL_EXTENSION FILE_MANAGER_PORT FIREWALL_SYSTEM FROM_EMAIL FROM_NAME FTP_SYSTEM HIDE_DOCS IMAP_SYSTEM INACTIVE_SESSION_TIMEOUT LANGUAGE LOGIN_STYLE MAIL_SYSTEM PHPMYADMIN_KEY POLICY_BACKUP_SUSPENDED_USERS POLICY_CSRF_STRICTNESS POLICY_SYNC_ERROR_DOCUMENTS POLICY_SYNC_SKELETON POLICY_SYSTEM_ENABLE_BACON POLICY_SYSTEM_HIDE_ADMIN POLICY_SYSTEM_HIDE_SERVICES POLICY_SYSTEM_PASSWORD_RESET POLICY_SYSTEM_PROTECTED_ADMIN POLICY_USER_CHANGE_THEME POLICY_USER_DELETE_LOGS POLICY_USER_EDIT_DETAILS POLICY_USER_EDIT_WEB_TEMPLATES POLICY_USER_VIEW_LOGS POLICY_USER_VIEW_SUSPENDED PROXY_PORT PROXY_SSL_PORT PROXY_SYSTEM RELEASE_BRANCH REPOSITORY ROOT_USER SERVER_SMTP_ADDR SERVER_SMTP_HOST SERVER_SMTP_PASSWD SERVER_SMTP_PORT SERVER_SMTP_SECURITY SERVER_SMTP_USER SMTP_RELAY SMTP_RELAY_HOST SMTP_RELAY_PORT SMTP_RELAY_USER STATS_SYSTEM SUBJECT_EMAIL THEME TITLE UPDATE_AVAILABLE UPGRADE_SEND_EMAIL UPGRADE_SEND_EMAIL_LOG USE_SERVER_SMTP VERSION WEBMAIL_ALIAS WEBMAIL_SYSTEM WEB_BACKEND WEB_PORT WEB_RGROUPS WEB_SSL WEB_SSL_PORT WEB_HTTP3 WEB_SYSTEM
	echo '{'
	echo '		"config": {'
	printf '			"ANTISPAM_SYSTEM": "%s",\n' "$ANTISPAM_SYSTEM"
	printf '			"CROWDSEC": "%s",\n' "$CROWDSEC"
	printf '			"ANTIVIRUS_SYSTEM": "%s",\n' "$ANTIVIRUS_SYSTEM"
	printf '			"APP_NAME": "%s",\n' "$APP_NAME"
	printf '			"BACKEND_PORT": "%s",\n' "$BACKEND_PORT"
	printf '			"BACKUP": "%s",\n' "$BACKUP"
	printf '			"BACKUP_GZIP": "%s",\n' "$BACKUP_GZIP"
	printf '            "BACKUP_INCREMENTAL": "%s",\n' "$BACKUP_INCREMENTAL"
	printf '			"BACKUP_MODE": "%s",\n' "$BACKUP_MODE"
	printf '			"BACKUP_SYSTEM": "%s",\n' "$BACKUP_SYSTEM"
	printf '			"CRON_SYSTEM": "%s",\n' "$CRON_SYSTEM"
	printf '			"DB_ADMINER_ALIAS": "%s",\n' "$DB_ADMINER_ALIAS"
	printf '			"DB_PMA_ALIAS": "%s",\n' "$DB_PMA_ALIAS"
	printf '			"DB_SYSTEM": "%s",\n' "$DB_SYSTEM"
	printf '			"DEBUG_MODE": "%s",\n' "$DEBUG_MODE"
	printf '			"DISABLE_IP_CHECK": "%s",\n' "$DISABLE_IP_CHECK"
	printf '			"PROJECT_QUOTA": "%s",\n' "$PROJECT_QUOTA"
	printf '			"DOCKER_SYSTEM": "%s",\n' "$DOCKER_SYSTEM"
	printf '			"ENFORCE_SUBDOMAIN_OWNERSHIP": "%s",\n' "$ENFORCE_SUBDOMAIN_OWNERSHIP"
	printf '			"FIREWALL_EXTENSION": "%s",\n' "$FIREWALL_EXTENSION"
	printf '			"FILE_MANAGER_PORT": "%s",\n' "$FILE_MANAGER_PORT"
	printf '			"FIREWALL_SYSTEM": "%s",\n' "$FIREWALL_SYSTEM"
	printf '			"FROM_EMAIL": "%s",\n' "$FROM_EMAIL"
	printf '			"FROM_NAME": "%s",\n' "$FROM_NAME"
	printf '			"FTP_SYSTEM": "%s",\n' "$FTP_SYSTEM"
	printf '			"HIDE_DOCS": "%s",\n' "$HIDE_DOCS"
	printf '			"IMAP_SYSTEM": "%s",\n' "$IMAP_SYSTEM"
	printf '			"INACTIVE_SESSION_TIMEOUT": "%s",\n' "$INACTIVE_SESSION_TIMEOUT"
	printf '			"LANGUAGE": "%s",\n' "$LANGUAGE"
	printf '			"LOGIN_STYLE": "%s",\n' "$LOGIN_STYLE"
	printf '			"MAIL_SYSTEM": "%s",\n' "$MAIL_SYSTEM"
	printf '			"PHPMYADMIN_KEY": "%s",\n' "$PHPMYADMIN_KEY"
	printf '			"POLICY_BACKUP_SUSPENDED_USERS": "%s",\n' "$POLICY_BACKUP_SUSPENDED_USERS"
	printf '			"POLICY_CSRF_STRICTNESS": "%s",\n' "$POLICY_CSRF_STRICTNESS"
	printf '			"POLICY_SYNC_ERROR_DOCUMENTS": "%s",\n' "$POLICY_SYNC_ERROR_DOCUMENTS"
	printf '			"POLICY_SYNC_SKELETON": "%s",\n' "$POLICY_SYNC_SKELETON"
	printf '			"POLICY_SYSTEM_ENABLE_BACON": "%s",\n' "$POLICY_SYSTEM_ENABLE_BACON"
	printf '			"POLICY_SYSTEM_HIDE_ADMIN": "%s",\n' "$POLICY_SYSTEM_HIDE_ADMIN"
	printf '			"POLICY_SYSTEM_HIDE_SERVICES": "%s",\n' "$POLICY_SYSTEM_HIDE_SERVICES"
	printf '			"POLICY_SYSTEM_PASSWORD_RESET": "%s",\n' "$POLICY_SYSTEM_PASSWORD_RESET"
	printf '			"POLICY_SYSTEM_PROTECTED_ADMIN": "%s",\n' "$POLICY_SYSTEM_PROTECTED_ADMIN"
	printf '			"POLICY_USER_CHANGE_THEME": "%s",\n' "$POLICY_USER_CHANGE_THEME"
	printf '			"POLICY_USER_DELETE_LOGS": "%s",\n' "$POLICY_USER_DELETE_LOGS"
	printf '			"POLICY_USER_EDIT_DETAILS": "%s",\n' "$POLICY_USER_EDIT_DETAILS"
	printf '			"POLICY_USER_EDIT_WEB_TEMPLATES": "%s",\n' "$POLICY_USER_EDIT_WEB_TEMPLATES"
	printf '			"POLICY_USER_VIEW_LOGS": "%s",\n' "$POLICY_USER_VIEW_LOGS"
	printf '			"POLICY_USER_VIEW_SUSPENDED": "%s",\n' "$POLICY_USER_VIEW_SUSPENDED"
	printf '			"PROXY_PORT": "%s",\n' "$PROXY_PORT"
	printf '			"PROXY_SSL_PORT": "%s",\n' "$PROXY_SSL_PORT"
	printf '			"PROXY_SYSTEM": "%s",\n' "$PROXY_SYSTEM"
	printf '			"RELEASE_BRANCH": "%s",\n' "$RELEASE_BRANCH"
	printf '			"REPOSITORY": "%s",\n' "$REPOSITORY"
	printf '      		"ROOT_USER": "%s",\n' "$ROOT_USER"
	printf '			"SERVER_SMTP_ADDR": "%s",\n' "$SERVER_SMTP_ADDR"
	printf '			"SERVER_SMTP_HOST": "%s",\n' "$SERVER_SMTP_HOST"
	printf '			"SERVER_SMTP_PASSWD": "%s",\n' "$SERVER_SMTP_PASSWD"
	printf '			"SERVER_SMTP_PORT": "%s",\n' "$SERVER_SMTP_PORT"
	printf '			"SERVER_SMTP_SECURITY": "%s",\n' "$SERVER_SMTP_SECURITY"
	printf '			"SERVER_SMTP_USER": "%s",\n' "$SERVER_SMTP_USER"
	printf '			"SMTP_RELAY": "%s",\n' "$SMTP_RELAY"
	printf '			"SMTP_RELAY_HOST": "%s",\n' "$SMTP_RELAY_HOST"
	printf '			"SMTP_RELAY_PORT": "%s",\n' "$SMTP_RELAY_PORT"
	printf '			"SMTP_RELAY_USER": "%s",\n' "$SMTP_RELAY_USER"
	printf '			"STATS_SYSTEM": "%s",\n' "$STATS_SYSTEM"
	printf '			"SUBJECT_EMAIL": "%s",\n' "$SUBJECT_EMAIL"
	printf '			"THEME": "%s",\n' "$THEME"
	printf '			"TITLE": "%s",\n' "$TITLE"
	printf '			"UPDATE_AVAILABLE": "%s",\n' "$UPDATE_AVAILABLE"
	printf '			"UPGRADE_SEND_EMAIL": "%s",\n' "$UPGRADE_SEND_EMAIL"
	printf '			"UPGRADE_SEND_EMAIL_LOG": "%s",\n' "$UPGRADE_SEND_EMAIL_LOG"
	printf '			"USE_SERVER_SMTP": "%s",\n' "$USE_SERVER_SMTP"
	printf '			"VERSION": "%s",\n' "$VERSION"
	printf '			"WEBMAIL_ALIAS": "%s",\n' "$WEBMAIL_ALIAS"
	printf '			"WEBMAIL_SYSTEM": "%s",\n' "$WEBMAIL_SYSTEM"
	printf '			"WEB_BACKEND": "%s",\n' "$WEB_BACKEND"
	printf '			"WEB_PORT": "%s",\n' "$WEB_PORT"
	printf '			"WEB_RGROUPS": "%s",\n' "$WEB_RGROUPS"
	printf '			"WEB_SSL": "%s",\n' "$WEB_SSL"
	printf '			"WEB_SSL_PORT": "%s",\n' "$WEB_SSL_PORT"
	printf '			"WEB_HTTP3": "%s",\n' "$WEB_HTTP3"
	printf '			"WEB_SYSTEM": "%s"\n' "$WEB_SYSTEM"
	echo '		}'
	echo '	}'
}

# Shell list
shell_list() {
	if [ -n "$WEB_SYSTEM" ]; then
		echo "Web Server:                       $WEB_SYSTEM:$WEB_PORT ($WEB_RGROUPS)"
		echo "SSL Support:                      $WEB_SSL:$WEB_SSL_PORT"
	fi
	if [ -n "$WEB_BACKEND" ]; then
		echo "PHP Intepreter:                   $WEB_BACKEND"
	fi
	if [ -n "$PROXY_SYSTEM" ]; then
		echo "Proxy Server:                     $PROXY_SYSTEM:$PROXY_PORT"
		echo "Proxy SSL:                        $PROXY_SYSTEM:$PROXY_SSL_PORT"
	fi
	if [ -n "$STATS_SYSTEM" ]; then
		echo "Statistics Engine:                ${STATS_SYSTEM//,/, }"
	fi
	if [ -n "$FTP_SYSTEM" ]; then
		echo "FTP Server:                       $FTP_SYSTEM"
	fi
	if [ -n "$MAIL_SYSTEM" ]; then
		echo -n "Mail Server:                      $MAIL_SYSTEM"
		if [ -n "$IMAP_SYSTEM" ]; then
			echo -n " + $IMAP_SYSTEM"
		fi
		if [ -n "$ANTIVIRUS_SYSTEM" ]; then
			echo -n " + $ANTIVIRUS_SYSTEM"
		fi
		if [ -n "$ANTISPAM_SYSTEM" ]; then
			echo -n " + $ANTISPAM_SYSTEM"
		fi
		echo
		if [ -n "$WEBMAIL_ALIAS" ]; then
			echo "Webmail alias:                    $WEBMAIL_ALIAS"
		fi
	fi
	if [ -n "$DB_SYSTEM" ]; then
		echo "Database:                         ${DB_SYSTEM//,/, }"
		if [ -n "$DB_PMA_ALIAS" ]; then
			echo "phpMyAdmin Alias:                 $DB_PMA_ALIAS"
		fi
		if [ -n "$DB_ADMINER_ALIAS" ]; then
			echo "Adminer Alias:                    $DB_ADMINER_ALIAS"
		fi
	fi
	if [ -n "$CRON_SYSTEM" ]; then
		echo "CRON daemon:                      $CRON_SYSTEM"
	fi
	if [ -n "$FIREWALL_SYSTEM" ]; then
		echo -n "Firewall:                         $FIREWALL_SYSTEM"
		if [ -n "$FIREWALL_EXTENSION" ]; then
			echo -n "+ $FIREWALL_EXTENSION"
		fi
		echo
	fi
	if [ -n "$BACKUP_SYSTEM" ]; then
		echo "Backups:                          ${BACKUP_SYSTEM//,/, }"
		echo "Backup Directory:                 $BACKUP"
	fi
	if [ -n "$PROJECT_QUOTA" ]; then
		echo "Project Quota:                    $PROJECT_QUOTA"
	fi
	if [ -n "$LANGUAGE" ] && [ "$LANGUAGE" != 'en' ]; then
		echo "System Language:                  $LANGUAGE"
	fi
	echo "Version:                          $VERSION"
	if [ -n "$SMTP_RELAY" ] && [ "$SMTP_RELAY" != 'false' ]; then
		echo "SMTP Relay enabled:                $SMTP_RELAY"
		echo "SMTP Relay Server:                 $SMTP_RELAY_HOST"
		echo "SMTP Relay Port:                   $SMTP_RELAY_PORT"
		echo "SMTP Relay User:                   $SMTP_RELAY_USER"
	fi

	echo "SMTP Server Account enabled:       $USE_SERVER_SMTP"

	if [ -n "$USE_SERVER_SMTP" ] && [ "$USE_SERVER_SMTP" != 'false' ]; then
		echo "SMTP Server Account Host:          $SERVER_SMTP_HOST"
		echo "SMTP Server Account Port:          $SERVER_SMTP_PORT"
		echo "SMTP Server Account Security:      $SERVER_SMTP_SECURITY"
		echo "SMTP Server Account Username:      $SERVER_SMTP_USER"
		echo "SMTP Server Account Password:      $SERVER_SMTP_PASSWD"
		echo "SMTP Server Account Address:       $SERVER_SMTP_ADDR"
	fi

	echo "Release Branch:                   $RELEASE_BRANCH"
	echo "Debug Mode:                       $DEBUG_MODE"
	echo "Theme:                            $THEME"
	echo "Restricted Admin Access:          $POLICY_SYSTEM_PROTECTED_ADMIN"
	echo "Hide System Administator:         $POLICY_SYSTEM_HIDE_ADMIN"
	echo "Updates: Notify by email:         $UPGRADE_SEND_EMAIL"
	echo "Updates: Email install log:       $UPGRADE_SEND_EMAIL_LOG"
}

# CSV list

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
# No plain here: this command never had one. The branch dispatched shell_list, which is prose
# for people, and the plain_list beside it was unreachable - so plain promised a machine format
# and delivered the other thing. Nothing asks for it; an asker is now told (#861).
#
# The only command narrower than the shared validator (is_type_valid 'plain json shell'), so
# plain passes there and stops here. The message keeps the common stem - a grep for it still
# finds all 90 dispatches - and adds what this one accepts, because here the global set is the
# wrong answer.
case $format in
	json) json_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format - this command has json and shell" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

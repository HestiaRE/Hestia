#!/bin/bash
# info: list system cpu info
# options:
#
# example: h-list-sys-cpu-status
#
# Shows processes, the process tree and the CPU.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

top -b -n1 | head -n 37
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

pstree -s
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

grep 'model name' /proc/cpuinfo | cut -f 2 -d : | sed "s/ //"
echo
lscpu 2> /dev/null

exit

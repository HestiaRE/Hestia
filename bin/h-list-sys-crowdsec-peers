#!/bin/bash
# info: list CrowdSec fleet-mesh peers
# options: [FORMAT]
#
# example: h-list-sys-crowdsec-peers json
#
# Tokens are never printed. PIN is a public-key hash: safe to show, and useful for spotting a cert change.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/crowdsec-mesh.sh
source $HESTIA/include/crowdsec-mesh.sh
source_conf "$HESTIA/conf/hestia.conf"

if ! mesh_load; then
	echo "ERROR: CrowdSec fleet-mesh is not enabled."
	exit "$E_DISABLED"
fi

[ -f "$MESH_PEERS_CONF" ] || touch "$MESH_PEERS_CONF"

# Bans contributed per peer: shows whether a link is doing anything.
declare -A MESH_SEEN
if command -v cscli > /dev/null 2>&1 && command -v jq > /dev/null 2>&1; then
	while read -r cnt scen; do
		[ -n "$scen" ] && MESH_SEEN[${scen#hestia-mesh:}]="$cnt"
	done < <(cscli decisions list -a -o json 2> /dev/null \
		| jq -r '(if type=="array" then .[] else . end) | (.decisions // [])[] | .scenario // empty
			| select(startswith("hestia-mesh:"))' 2> /dev/null | sort | uniq -c)
fi

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep -c "PEER=" "$MESH_PEERS_CONF")
	echo "{"
	while read -r str; do
		[ -z "$str" ] && continue
		parse_object_kv_list "$str"
		# BANS first: $PEER is the array key, and escaping it before the lookup would miss the entry.
		bans="${MESH_SEEN[$PEER]:-0}"
		json_escape PEER HOST PORT IP PIN bans SUSPENDED TIME DATE
		printf '    "%s": {\n' "$PEER"
		printf '        "HOST": "%s",\n' "$HOST"
		printf '        "PORT": "%s",\n' "$PORT"
		printf '        "IP": "%s",\n' "$IP"
		printf '        "PIN": "%s",\n' "$PIN"
		printf '        "BANS": "%s",\n' "$bans"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		[[ "$i" -lt "$objects" ]] && echo ',' || echo
		((i++))
	done < "$MESH_PEERS_CONF"
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "PEER^HOST^PORT^IP^BANS^SUSPENDED^TIME^DATE"
	echo "----^----^----^--^----^---------^----^----"
	while read -r str; do
		[ -z "$str" ] && continue
		parse_object_kv_list "$str"
		echo "$PEER^$HOST^$PORT^$IP^${MESH_SEEN[$PEER]:-0}^$SUSPENDED^$TIME^$DATE"
	done < "$MESH_PEERS_CONF"
}

plain_list() {
	IFS=$'\n'
	while read -r str; do
		[ -z "$str" ] && continue
		parse_object_kv_list "$str"
		echo -e "$PEER\t$HOST\t$PORT\t$IP\t${MESH_SEEN[$PEER]:-0}\t$SUSPENDED\t$TIME\t$DATE"
	done < "$MESH_PEERS_CONF"
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '^' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

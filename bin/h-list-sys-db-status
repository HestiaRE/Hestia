#!/bin/bash
# info: list db status
# options:
#
# h-list-sys-db-status
#
# This function lists db server status

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
#format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking db system
if [ -z "$DB_SYSTEM" ]; then
	exit
fi

# Checking supported database systems
for db in $(echo $DB_SYSTEM | tr ',' '\n'); do
	OLD_IFS="$IFS"
	IFS=$'\n'

	# Checking database config
	if [ -e "$HESTIA/conf/$db.conf" ]; then

		# Checking server status
		for host_str in $(cat $HESTIA/conf/$db.conf); do
			# Keys a record leaves out would otherwise carry over from the host before.
			unset TLS PORT
			parse_object_kv_list "$host_str"

			# Checking MySQL
			if [ "$db" = 'mysql' ]; then
				mycnf="$HESTIA/conf/.mysql.$HOST"
				if [ ! -e "$mycnf" ]; then
					echo "[client]" > $mycnf
					echo "host='$HOST'" >> $mycnf
					echo "user='$USER'" >> $mycnf
					echo "password='$PASSWORD'" >> $mycnf
					echo "port='${PORT:-3306}'" >> $mycnf
					chmod 600 $mycnf
				else
					mypw=$(grep password $mycnf | cut -f 2 -d \')
					if [ "$mypw" != "$PASSWORD" ]; then
						echo "[client]" > $mycnf
						echo "host='$HOST'" >> $mycnf
						echo "user='$USER'" >> $mycnf
						echo "password='$PASSWORD'" >> $mycnf
						echo "port='${PORT:-3306}'" >> $mycnf
						chmod 660 $mycnf
					fi
				fi
				if [ -f '/usr/bin/mariadb-admin' ]; then
					echo "MySQL $HOST status"
					mariadb-admin --defaults-file=$mycnf status | sed -e "s/  /\n/g"
					echo
					mariadb-admin --defaults-file=$mycnf processlist
				else
					echo "MySQL $HOST status"
					mysqladmin --defaults-file=$mycnf status | sed -e "s/  /\n/g"
					echo
					mysqladmin --defaults-file=$mycnf processlist
				fi
				echo -en "\n---------------------------------------------"
				echo -en "---------------------------------------------\n\n"
			fi

			# Checking PostgreSQL
			if [ "$db" = 'pgsql' ] && [ ! -z "$(which psql)" ]; then
				echo "PostgreSQL $HOST status"
				export PGPASSWORD="$PASSWORD"
				psql_env "$HOST" "$TLS"
				psql -h $HOST -U $USER -p "${PORT:-5432}" -c "SELECT * FROM pg_stat_activity"
			fi
		done
	fi
	IFS="$OLD_IFS"
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

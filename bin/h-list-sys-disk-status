#!/bin/bash
# info: list disk information
# options:
#
# example: h-list-sys-disk-status
#
# Shows disk and inode usage, I/O and partitions.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

df -h
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

df -ih
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

iostat -m
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

fdisk -l

exit

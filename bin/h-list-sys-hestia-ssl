#!/bin/bash
# info: list hestia ssl certificate
# options: [FORMAT]
#
# example: h-list-sys-hestia-ssl
#
# This function of obtaining hestia ssl files.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	# The certificate fields are free text (#5524 covered ISSUER only, #5585 the rest). CRT/KEY/CA
	# come from the RAW file here: json_escape encodes the newlines itself, and running it over the
	# already-encoded $crt would turn each of its \n into two visible characters in the panel.
	local crt="${crt_raw}" key="${key_raw}" ca="${ca_raw}"
	json_escape crt key ca subj alt_dns before after signature pub_key issuer
	echo '{'
	echo -e "\t\"HESTIA\": {"
	echo "        \"CRT\": \"$crt\","
	echo "        \"KEY\": \"$key\","
	echo "        \"CA\": \"$ca\","
	echo "        \"SUBJECT\": \"$subj\","
	echo "        \"ALIASES\": \"$alt_dns\","
	echo "        \"NOT_BEFORE\": \"$before\","
	echo "        \"NOT_AFTER\": \"$after\","
	echo "        \"SIGNATURE\": \"$signature\","
	echo "        \"PUB_KEY\": \"$pub_key\","
	echo "        \"ISSUER\": \"$issuer\""
	echo -e "\t}\n}"
}

# SHELL list function
shell_list() {
	if [ -n "$crt" ]; then
		echo -e "$crt"
	fi
	if [ -n "$key" ]; then
		echo -e "\n$key"
	fi
	if [ -n "$crt" ]; then
		echo
		echo
		echo "SUBJECT:        $subj"
		if [ -n "$alt_dns" ]; then
			echo "ALIASES:        ${alt_dns//,/ }"
		fi
		echo "VALID FROM:     $before"
		echo "VALID TIL:      $after"
		echo "SIGNATURE:      $signature"
		echo "PUB_KEY:        $pub_key"
		echo "ISSUER:         $issuer"
	fi
}

# PLAIN list function
plain_list() {
	if [ -n "$crt" ]; then
		echo -e "$crt"
	fi
	if [ -n "$key" ]; then
		echo -e "\n$key"
	fi
	if [ -n "$ca" ]; then
		echo -e "\n$ca"
	fi
	if [ -n "$crt" ]; then
		echo "$subj"
		echo "${alt_dns//,/ }"
		echo "$before"
		echo "$after"
		echo "$signature"
		echo "$pub_key"
		echo "$issuer"
	fi

}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing SSL certificate
crt_raw=$(cat $HESTIA_SSL/certificate.crt)
crt=$(echo "$crt_raw" | sed ':a;N;$!ba;s/\n/\\n/g')
key_raw=$(cat $HESTIA_SSL/certificate.key)
key=$(echo "$key_raw" | sed ':a;N;$!ba;s/\n/\\n/g')

# Parsing SSL certificate details without CA
info=$(openssl x509 -text -in $HESTIA_SSL/certificate.crt)
subj=$(cert_common_name "$HESTIA_SSL/certificate.crt")
before=$(echo "$info" | grep Before: | sed -e "s/.*Before: //")
after=$(echo "$info" | grep "After :" | sed -e "s/.*After : //")
signature=$(echo "$info" | grep "Algorithm:" | head -n1)
signature=$(echo "$signature" | sed -e "s/.*Algorithm: //")
pub_key=$(echo "$info" | grep Public-Key: | cut -f2 -d \( | tr -d \))
issuer=$(echo "$info" | grep Issuer: | sed -e "s/.*Issuer: //")
alt_dns=$(echo "$info" | grep DNS | sed -e 's/DNS:/\n/g' | tr -d ',')
alt_dns=$(echo "$alt_dns" | tr -d ' ' | sed -e "/^$/d")
alt_dns=$(echo "$alt_dns" | sed -e ':a;N;$!ba;s/\n/,/g')

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

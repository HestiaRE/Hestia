#!/bin/bash
# info: list system os
# options: [FORMAT]
#
# example: h-list-sys-info
#
# This function checks available updates for hestia packages.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Retrieve Hestia Control Panel version number
# Anchored: unanchored, VERSION also matches any future *_VERSION key and the value comes
# back as two lines.
HESTIA_VERSION=$(grep '^VERSION=' $HESTIA/conf/hestia.conf | cut -d '=' -f2 | sed "s|'||g")
HESTIA_RELEASE=$(grep '^RELEASE_BRANCH=' $HESTIA/conf/hestia.conf | cut -d '=' -f2 | sed "s|'||g")

# JSON list function
json_list() {
	echo '{'
	json_escape HOSTNAME OS VERSION ARCH HESTIA_VERSION HESTIA_RELEASE UPTIME LOADAVERAGE
	echo '    "sysinfo": {'
	printf '        "HOSTNAME": "%s",\n' "$HOSTNAME"
	printf '        "OS": "%s",\n' "$OS"
	printf '        "VERSION": "%s",\n' "$VERSION"
	printf '        "ARCH": "%s",\n' "$ARCH"
	printf '        "HESTIA": "%s",\n' "$HESTIA_VERSION"
	printf '        "RELEASE": "%s",\n' "$HESTIA_RELEASE"
	printf '        "UPTIME": "%s",\n' "$UPTIME"
	printf '        "LOADAVERAGE": "%s"\n' "$LOADAVERAGE"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "HOSTNAME   OS   VER   ARCH  HESTIA  RELEASE  UPTIME   LA"
	echo "--------   --   ---   ----  ------  -------  ------   --"
	echo "$HOSTNAME $OS $VERSION $ARCH $HESTIA_VERSION $HESTIA_RELEASE $UPTIME $LOADAVERAGE"
}

# PLAIN list function
plain_list() {
	echo -e "$HOSTNAME\t$OS\t$VERSION\t$ARCH\t$HESTIA_VERSION\t$HESTIA_RELEASE\t$UPTIME\t$LOADAVERAGE"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Check hostname
HOSTNAME=$(hostname)

# Check OS/Release
if [ "$(lsb_release -si)" == "Ubuntu" ] && [ -e '/etc/debian_version' ]; then
	OS="Ubuntu"
	VERSION=$(grep DISTRIB_RELEASE /etc/lsb-release | cut -f 2 -d '=')
else
	distro=$(head -n1 /etc/issue | cut -f 1 -d ' ')
	if [ "$distro" = 'Debian' ]; then
		OS="Debian"
		VERSION=$(cat /etc/debian_version)
	else
		OS='UNKNOWN'
		VERSION='UNKNOWN'
	fi
fi

# Check architecture
ARCH=$(arch)

# Check uptime
UPTIME=$(cat /proc/uptime | cut -f 1 -d ' ' | cut -f 1 -d .)
UPTIME="$(echo $UPTIME / 60 | bc)"

# Check LoadAverage
LOADAVERAGE=$(cat /proc/loadavg | cut -f 1-3 -d ' ' | sed 's/ / \/ /g')

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

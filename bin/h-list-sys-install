#!/bin/bash
# info: list HestiaRE installation status
# options: (none)
#
# Read-only status report: version, release source, OS/profile, completed
# install phases ($CONF_DIR/.done.*), and the two answers side by side: what the
# wizard was asked for, and what the box actually carries.

HESTIA="${HESTIA:-/usr/local/hestia}"
[ -f $CONF_DIR/hestia.env ] && . $CONF_DIR/hestia.env 2> /dev/null || true
CONF_DIR="/etc/hestia"
INSTALL_CONF="$CONF_DIR/install.conf"
SOURCE_CONF="$CONF_DIR/source.conf"
VERSION="$(cat "$HESTIA/VERSION" 2> /dev/null || echo dev)"

# shellcheck disable=SC1090
[ -f "$INSTALL_CONF" ] && . "$INSTALL_CONF" 2> /dev/null || true
# shellcheck disable=SC1090
[ -f "$SOURCE_CONF" ] && . "$SOURCE_CONF" 2> /dev/null || true

echo "HestiaRE $VERSION"
echo "Source:   ${HESTIARE_SOURCE:-github}"
echo "Channel:  ${HESTIARE_CHANNEL:-stable}"
echo "OS:       ${INSTALL_OS:-unknown}"
echo "Profile:  ${INSTALL_PROFILE:-unknown}"
echo ""
echo "Completed install phases:"
for s in "$CONF_DIR"/.done.*; do
	[ -f "$s" ] && echo "  + ${s##*/.done.}" || true
done
echo ""
# Two columns, because they are two different statements and were read as one for too long: the recipe is
# the answer given at install time and no update ever rewrites it, while hestia.conf says what is on the
# box now. A component removed afterwards still stands "true" on the left (#945).
# The status key per component comes from the manifest (#944), so this list cannot drift from the
# registry the way a second hand-kept table would. Keys are read with an anchored grep, never sourced:
# a key name is a prefix of another one often enough to matter (DB_SYSTEM in DB_MARIADB_SYSTEM, #983).
echo "Components (chosen at install time -> what the box has now):"
if [ ! -f "$INSTALL_CONF" ]; then
	echo "  (install.conf not found)"
else
	HESTIA_CONF="$CONF_DIR/conf/hestia.conf"
	while IFS='=' read -r _key _val; do
		_id="${_key#COMPONENT_}"
		_val="${_val%\"}"
		_val="${_val#\"}"
		_sk=$(jq -r --arg c "$_id" '.components[$c].status_key // empty' \
			"$HESTIA/share/manifest.json" 2> /dev/null)
		if [ -z "$_sk" ]; then
			# No status key by design: always_installed, or a component that is not state (see the
			# manifest note). Nothing to compare, so only the answer is shown.
			printf '  %-34s %-16s %s\n' "$_id" "${_val:-(empty)}" "-"
			continue
		fi
		_sv=$(sed -n "s/^${_sk}='\([^']*\)'.*/\1/p" "$HESTIA_CONF" 2> /dev/null | head -1)
		printf '  %-34s %-16s %s=%s\n' "$_id" "${_val:-(empty)}" "$_sk" "${_sv:-(empty)}"
	done < <(grep '^COMPONENT_' "$INSTALL_CONF" 2> /dev/null)
fi

#!/bin/bash
# info: list HestiaRE installation status
# options: (none)
#
# Read-only status report: version, OS and profile, completed install phases, and per component what the
# wizard was asked for next to what the box carries now.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

HESTIA="${HESTIA:-/usr/local/hestia}"
CONF_DIR="${CONF_DIR:-/etc/hestia}"
# shellcheck source=/etc/hestia/hestia.env
[ -f "$CONF_DIR/hestia.env" ] && . "$CONF_DIR/hestia.env" 2> /dev/null || true
INSTALL_CONF="$CONF_DIR/install.conf"
VERSION="$(cat "$HESTIA/VERSION" 2> /dev/null || echo dev)"

# shellcheck disable=SC1090
[ -f "$INSTALL_CONF" ] && . "$INSTALL_CONF" 2> /dev/null || true

echo "HestiaRE $VERSION"
echo "OS:       ${INSTALL_OS:-unknown}"
echo "Profile:  ${INSTALL_PROFILE:-unknown}"
echo ""
echo "Completed install phases:"
for s in "$CONF_DIR"/.done.*; do
	[ -f "$s" ] && echo "  + ${s##*/.done.}" || true
done
echo ""
# Two columns: install.conf is the answer at install time and no update rewrites it, hestia.conf is the box now.
# The status key comes from the manifest. Anchored grep, never sourced: DB_SYSTEM is a prefix of DB_MARIADB_SYSTEM.
echo "Components (chosen at install time -> what the box has now):"
if [ ! -f "$INSTALL_CONF" ]; then
	echo "  (install.conf not found)"
else
	HESTIA_CONF="$CONF_DIR/conf/hestia.conf"
	while IFS='=' read -r _key _val; do
		_id="${_key#COMPONENT_}"
		_val="${_val%\"}"
		_val="${_val#\"}"
		_sk=$(jq -r --arg c "$_id" '.components[$c].status_key // empty' \
			"$HESTIA/share/manifest.json" 2> /dev/null)
		if [ -z "$_sk" ]; then
			# No status key by design (always installed, or not state): only the answer is shown.
			printf '  %-34s %-16s %s\n' "$_id" "${_val:-(empty)}" "-"
			continue
		fi
		_sv=$(sed -n "s/^${_sk}='\([^']*\)'.*/\1/p" "$HESTIA_CONF" 2> /dev/null | head -1)
		printf '  %-34s %-16s %s=%s\n' "$_id" "${_val:-(empty)}" "$_sk" "${_sv:-(empty)}"
	done < <(grep '^COMPONENT_' "$INSTALL_CONF" 2> /dev/null)
fi

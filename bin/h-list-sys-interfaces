#!/bin/bash
# info: list system interfaces
# options: [FORMAT]
#
# example: h-list-sys-interfaces
#
# Lists the network interfaces except loopback.

format="${1-shell}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$(echo "$physical_nics" | wc -l)
	i=1
	echo '['
	for interface in $physical_nics; do
		json_escape interface
		printf '    "%s"' "$interface"
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo ']'
}

shell_list() {
	echo "INTERFACE"
	echo "---------"
	for interface in $physical_nics; do
		echo "$interface"
	done
}

plain_list() {
	for interface in $physical_nics; do
		echo "$interface"
	done
}

physical_nics="$(ip -d -j link show | jq -r '.[] | if .link_type == "loopback" then empty else .ifname end')"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list system IPs
# options: [FORMAT]
#
# example: h-list-sys-ips
#
# Lists the IP records.

format="${1-shell}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	ip_count="$(ls $CONF_DIR/ips/ | wc -l)"
	i=1
	while read -r IP; do
		source_conf "$CONF_DIR/ips/$IP"
		json_escape IP OWNER STATUS NAME U_SYS_USERS U_WEB_DOMAINS INTERFACE NETMASK NAT TIME DATE
		printf '    "%s": {\n' "$IP"
		printf '        "OWNER": "%s",\n' "$OWNER"
		printf '        "STATUS": "%s",\n' "$STATUS"
		printf '        "NAME": "%s",\n' "$NAME"
		printf '        "U_SYS_USERS": "%s",\n' "$U_SYS_USERS"
		printf '        "U_WEB_DOMAINS": "%s",\n' "$U_WEB_DOMAINS"
		printf '        "INTERFACE": "%s",\n' "$INTERFACE"
		printf '        "NETMASK": "%s",\n' "$NETMASK"
		printf '        "NAT": "%s",\n' "$NAT"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '        }'
		if [ "$i" -lt "$ip_count" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(ls $CONF_DIR/ips/)
	echo '}'
}

shell_list() {
	echo "IP   MASK   NAT    STATUS   WEB  DATE"
	echo "--   ----   ---    ------   ---  ----"
	while read IP; do
		source_conf "$CONF_DIR/ips/$IP"
		if [ -z "$NAT" ]; then
			NAT='no'
		fi
		echo "$IP $NETMASK $NAT $STATUS $U_WEB_DOMAINS $DATE"
	done < <(ls $CONF_DIR/ips/)
}

plain_list() {
	while read IP; do
		source_conf "$CONF_DIR/ips/$IP"
		echo -ne "$IP\t$OWNER\t$STATUS\t$NAME\t$U_SYS_USERS\t$U_WEB_DOMAINS\t"
		echo -e "$INTERFACE\t$NETMASK\t$NAT\t$TIME\t$DATE"
	done < <(ls $CONF_DIR/ips/)
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

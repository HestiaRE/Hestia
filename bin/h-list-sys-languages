#!/bin/bash
# info: list system languages
# options: [FORMAT]
#
# example: h-list-sys-languages json
#
# Lists the panel languages as ISO codes.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$(echo "$languages" | wc -l)
	i=1
	echo '['
	echo -e "\t\"en\","
	for lang in $languages; do
		json_escape lang
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$lang"
		else
			printf '\t"%s"\n' "$lang"
		fi
		((++i))
	done
	echo ']'
}

shell_list() {
	echo "LANGUAGE"
	echo "--------"
	echo "en"
	for lang in $languages; do
		echo "$lang"
	done
}

plain_list() {
	echo "en"
	for lang in $languages; do
		echo "$lang"
	done
}

languages=$(ls -d $HESTIA/web/locale/*/ | awk -F'/' '{print $(NF-1)}')

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

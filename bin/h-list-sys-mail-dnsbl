#!/bin/bash
# info: list dnsbl hosts checked by exim
# options: [FORMAT]
#
# example: h-list-sys-mail-dnsbl json
#
# This function lists the DNSBL servers exim checks incoming mail against.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"

# The file exim4.conf.template reads per message; there is no shadow copy.
DNSBL_CONF="/etc/exim4/dnsbl.conf"

# Blank lines and comments are not entries; exim would treat a stray one as a lookup domain.
dnsbl_hosts() {
	[ -f "$DNSBL_CONF" ] || return 0
	grep -vE '^\s*(#|$)' "$DNSBL_CONF"
}

json_list() {
	local host first=1
	echo '{'
	while read -r host; do
		[ -z "$host" ] && continue
		[ "$first" -eq 1 ] || echo ','
		first=0
		json_escape host
		echo -n "    \"$host\": {
        \"HOST\": \"$host\"
    }"
	done < <(dnsbl_hosts)
	[ "$first" -eq 1 ] || echo ''
	echo '}'
}

shell_list() {
	echo "HOST"
	echo "----"
	dnsbl_hosts
}

plain_list() {
	dnsbl_hosts
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

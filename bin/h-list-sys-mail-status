#!/bin/bash
# info: list mail status
# options:
#
# example: h-list-sys-mail-status
#
# This function lists mail server status

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ -z "$MAIL_SYSTEM" ]; then
	exit
fi

echo "Exim queue status"
exim -bp
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

if ! eximstats /var/log/exim4/mainlog 2> /dev/null; then
	echo "[Exim4] No valid log lines read"
	exit 0
fi

exit 0

#!/bin/bash
# info: list virtual memory info
# options:
#
# example: h-list-sys-memory-status
#
# Shows memory, swap and RAM modules.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

free -t -m
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

vmstat -S m -s
echo -en "\n---------------------------------------------"
echo -en "---------------------------------------------\n\n"

dmidecode -t 17 2> /dev/null

exit

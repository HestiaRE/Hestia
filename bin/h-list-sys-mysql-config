#!/bin/bash
# info: list mysql config parameters
# options: [FORMAT]
#
# example: h-list-sys-mysql-config
#
# This function for obtaining the list of mysql config parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	str=$(echo "$config" | egrep "$keys" \
		| sed -e "s/[ ]*=/=/" -e "s/=[ ]*/=\'/" -e "s/$/'/")
	parse_object_kv_list "$str"
	json_escape max_user_connections max_connections wait_timeout interactive_timeout max_allowed_packet config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "max_user_connections": "%s",\n' "$max_user_connections"
	printf '        "max_connections": "%s",\n' "$max_connections"
	printf '        "wait_timeout": "%s",\n' "$wait_timeout"
	printf '        "interactive_timeout": "%s",\n' "$interactive_timeout"
	printf '        "max_allowed_packet": "%s",\n' "$max_allowed_packet"
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "$config" | egrep "$keys" | tr '=' ' '
	echo "config_path $config_path"
}

# PLAIN list function
plain_list() {
	echo "$config" | egrep "$keys" | tr '=' ' '
	echo "config_path $config_path"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config path
# The file h-add-sys-mariadb writes. A search found none or several, and an empty path made cat read stdin.
config_path=/etc/mysql/my.cnf
[ -f "$config_path" ] || check_result "$E_NOTEXIST" "$config_path not found"

# Defining keys
keys="max_user_connections|max_connections|wait_timeout|interactive_timeout"
keys="${keys}|max_allowed_packet"

# Reading config
config=$(grep -v "^;" "$config_path")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

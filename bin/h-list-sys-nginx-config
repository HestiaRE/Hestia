#!/bin/bash
# info: list nginx config parameters
# options: [FORMAT]
#
# example: h-list-sys-nginx-config
#
# The tunable directives of /etc/nginx/nginx.conf, as the server editor reads them.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	parse_object_kv_list "$(directives | awk '{print $1"="$2}')"
	json_escape worker_processes worker_connections send_timeout proxy_connect_timeout proxy_send_timeout proxy_read_timeout client_max_body_size gzip gzip_comp_level charset config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "worker_processes": "%s",\n' "$worker_processes"
	printf '        "worker_connections": "%s",\n' "$worker_connections"
	printf '        "send_timeout": "%s",\n' "$send_timeout"
	printf '        "proxy_connect_timeout": "%s",\n' "$proxy_connect_timeout"
	printf '        "proxy_send_timeout": "%s",\n' "$proxy_send_timeout"
	printf '        "proxy_read_timeout": "%s",\n' "$proxy_read_timeout"
	printf '        "client_max_body_size": "%s",\n' "$client_max_body_size"
	printf '        "gzip": "%s",\n' "$gzip"
	printf '        "gzip_comp_level": "%s",\n' "$gzip_comp_level"
	printf '        "charset": "%s",\n' "$charset"
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

shell_list() {
	directives
	echo "config_path    $config_path"
}

plain_list() {
	directives
	echo "config_path $config_path"
}

config_path='/etc/nginx/nginx.conf'

keys="worker_processes worker_connections send_timeout proxy_connect_timeout proxy_send_timeout proxy_read_timeout"
keys="$keys client_max_body_size gzip gzip_comp_level charset"

# The directive itself, never a comment mentioning one: a key line the strict parser cannot read breaks the editor.
directives() {
	awk -v keys="$keys" 'BEGIN { split(keys, k, " "); for (i in k) want[k[i]] = 1 }
		{ sub(/^[ \t]+/, ""); sub(/;.*/, "") } want[$1] { print }' "$config_path"
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list postgresql config parameters
# options: [FORMAT]
#
# example: h-list-sys-pgsql-config

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	json_escape pg_hba_path config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "pg_hba_path": "%s",\n' "$pg_hba_path"
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

shell_list() {
	echo "config_path:    $config_path"
	echo "pg_hba_path:    $pg_hba_path"
}

plain_list() {
	echo -e "$config_path\t$pg_hba_path"
}

config_path=$(find /etc/postgresql /var/lib/pgsql/data -name \
	postgresql.conf 2> /dev/null)
pg_hba_path=$(find /etc/postgresql /var/lib/pgsql/data -name \
	pg_hba.conf 2> /dev/null)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

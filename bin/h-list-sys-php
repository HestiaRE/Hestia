#!/bin/bash
# info: listing available PHP versions installed
# options: [FORMAT]
#
# example: h-list-sys-php
#
# List /etc/php/* version check if folder fpm is available

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	i=1
	objects=$(echo "${versions[@]}" | wc -w)
	echo '['
	for version in "${versions[@]}"; do
		json_escape version
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$version"
		else
			printf '\t"%s"\n' "$version"
		fi
		((++i))
	done
	echo "]"
}

# SHELL list function
shell_list() {
	echo "VERSION"
	echo "--------"
	for version in "${versions[@]}"; do
		echo "$version"
	done
}

# PLAIN list function
plain_list() {
	for version in "${versions[@]}"; do
		echo "$version"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

declare -a versions
# List through /etc/php. Skip "hestia": the isolated panel FPM pool (unit hestia-php),
# not a customer PHP version - consumers build php<v>-fpm, so it yields a bogus
# "phphestia-fpm" that breaks h-restart-web-backend + the #120 switch health gate.
if [ -n "$WEB_BACKEND" ]; then
	for version in /etc/php/*/fpm; do
		[ -d "$version" ] || continue
		ver=$(echo "$version" | awk -F"/" '{ print $4 }')
		[ "$ver" = "hestia" ] && continue
		versions+=("$ver")
	done
else
	# Fix for modphp
	for version in /etc/php/*/cli; do
		[ -d "$version" ] || continue
		ver=$(echo "$version" | awk -F"/" '{ print $4 }')
		[ "$ver" = "hestia" ] && continue
		versions+=("$ver")
	done
fi
# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

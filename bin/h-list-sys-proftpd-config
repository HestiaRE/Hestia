#!/bin/bash
# info: list proftpd config parameters
# options: [FORMAT]
#
# example: h-list-sys-proftpd-config

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	json_escape config_path
	echo '{'
	echo '    "CONFIG": {'
	printf '        "config_path": "%s"\n' "$config_path"
	echo '        }'
	echo '}'
}

shell_list() {
	echo "config_path:    $config_path"
}

plain_list() {
	echo "$config_path"
}

config_path=$(find /etc/proftpd* -name proftpd.conf 2> /dev/null)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list system shells
# options: [FORMAT]
#
# example: h-list-sys-shells
#
# Lists the shells the panel offers.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	sh_counter=$(echo "$shells" | wc -l)
	i=1
	echo '['
	for shell in $shells; do
		json_escape shell
		if [ "$i" -lt "$sh_counter" ]; then
			printf '\t"%s",\n' "$shell"
		else
			printf '\t"%s"\n' "$shell"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "SHELL"
	echo "-----"
	for shell in $shells; do
		echo "$shell"
	done
}

plain_list() {
	for shell in $shells; do
		echo "$shell"
	done
}

# The allowlist within /etc/shells, the panel's single shell source.
shells=$(list_allowed_shells)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

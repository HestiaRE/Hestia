#!/bin/bash
# info: list sshd port
# options: [FORMAT]
#
# example: h-list-sys-sshd-port
#
# This function for obtainings the port of sshd listens to

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh

json_list() {
	sh_counter=$(echo "$ports" | wc -l)
	i=1
	echo '['
	for port in $ports; do
		json_escape port
		if [ "$i" -lt "$sh_counter" ]; then
			printf '\t"%s",\n' "$port"
		else
			printf '\t"%s"\n' "$port"
		fi
		((++i))
	done
	echo "]"
}

# SHELL list function
shell_list() {
	echo "PORT"
	echo "-----"
	for port in $ports; do
		echo "$port"
	done
}

# PLAIN list function
plain_list() {
	for port in $ports; do
		echo "$port"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

ports=$(sshd -T | grep '^port' | cut -d ' ' -f2)

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

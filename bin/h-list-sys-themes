#!/bin/bash
# info: list system themes
# options: [FORMAT]
#
# example: h-list-sys-themes
#
# Lists the panel themes, shipped and custom.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

available_themes=()

get_themes() {
	if [ -d "$HESTIA_THEMES" ]; then
		for file in "$HESTIA_THEMES"/*.css; do
			[ -f "$file" ] || continue
			filename=$(basename "$file" .css)
			available_themes+=("${filename%.*}")
		done
	fi

	if [ -d "$HESTIA_THEMES_CUSTOM" ] && [ "$(ls -A "$HESTIA_THEMES_CUSTOM")" ]; then
		for file in "$HESTIA_THEMES_CUSTOM"/*.css; do
			[ -f "$file" ] || continue
			filename=$(basename "$file" .css)
			available_themes+=("${filename%.*}")
		done
	fi

	IFS=$'\n' available_themes=($(sort <<< "${available_themes[*]}"))
	unset IFS

	theme_count="${#available_themes[@]}"
}

json_list() {
	i=1
	echo '['
	for theme in "${available_themes[@]}"; do
		json_escape theme
		if [ "$i" -lt "$theme_count" ]; then
			printf '\t"%s",\n' "$theme"
		else
			printf '\t"%s"\n' "$theme"
		fi
		((++i))
	done
	echo ']'
}

shell_list() {
	echo "THEME"
	echo "-----"
	for theme in "${available_themes[@]}"; do
		echo "$theme"
	done
}

plain_list() {
	for theme in "${available_themes[@]}"; do
		echo "$theme"
	done
}

get_themes

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

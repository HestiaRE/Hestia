#!/bin/bash
# info: list the update entries this box would run
# options: [FORMAT] [TARGET]
#
# example: h-list-sys-updates plain
#
# Derives the list from the update manifests in the tree and the status of this box. It reads both and
# writes neither: the same derivation feeds the smoke's manifest guard and, in a run, update.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

format=${1-shell}
target=${2-}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/update.sh
source $HESTIA/include/update.sh

# The tree is the target: a run unpacks the release before deriving anything.
if [ -z "$target" ]; then
	target=$(cat "$HESTIA/VERSION" 2> /dev/null)
	[ -n "$target" ] || check_result "$E_NOTEXIST" "no VERSION in $HESTIA"
fi

# PLAIN list function
plain_list() {
	jq -r '.eintraege[] | [.identitaet, .aktion.typ, (if .umkehrbar then "reversible" else "final" end),
		.beschreibung] | @tsv' <<< "$plan"
}

# SHELL list function
shell_list() {
	printf 'ENTRY\tACTION\tROLLBACK\tDESCRIPTION\n'
	printf -- '-----\t------\t--------\t-----------\n'
	plain_list
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

plan=$(upd_plan "$target") || check_result "$E_INVALID" "the update manifests in this tree are not sound"

# Listing data
case $format in
	json) echo "$plan" ;;
	plain) plain_list ;;
	shell)
		jq -r '"from " + .version_von + " to " + .version_bis + ": " + (.anzahl | tostring) + " entry(s), "
			+ (.unumkehrbar | length | tostring) + " past the point of no return"
			+ (if (.unumkehrbar | length) > 0 then " (" + (.unumkehrbar | join(", ")) + ")" else "" end)' <<< "$plan"
		echo
		shell_list | column -t -s $'\t'
		;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

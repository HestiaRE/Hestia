#!/bin/bash
# info: list the update entries this box would run
# options: [FORMAT] [TARGET]
#
# example: h-list-sys-updates plain
#
# Derived from the manifests in the tree and the status of this box, read-only. The same derivation is
# the smoke's pending check and, in a run, update.conf.

format=${1-shell}
target=${2-}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/update.sh
source $HESTIA/include/update.sh

# The tree is the target: a run unpacks the release before deriving anything.
if [ -z "$target" ]; then
	target=$(cat "$HESTIA/VERSION" 2> /dev/null)
	[ -n "$target" ] || check_result "$E_NOTEXIST" "no VERSION in $HESTIA"
fi

plain_list() {
	jq -r '.entries[] | [.identity, .action.type, (if .reversible then "reversible" else "final" end),
		.description] | @tsv' <<< "$plan"
}

shell_list() {
	printf 'ENTRY\tACTION\tROLLBACK\tDESCRIPTION\n'
	printf -- '-----\t------\t--------\t-----------\n'
	plain_list
}

plan=$(upd_plan "$target") || check_result "$E_INVALID" "the update manifests in this tree are not sound"

case $format in
	json) echo "$plan" ;;
	plain) plain_list ;;
	shell)
		jq -r '"from " + .version_from + " to " + .version_to + ": " + (.count | tostring) + " entry(s), "
			+ (.irreversible | length | tostring) + " past the point of no return"
			+ (if (.irreversible | length) > 0 then " (" + (.irreversible | join(", ")) + ")" else "" end)' <<< "$plan"
		echo
		shell_list | column -t -s $'\t'
		;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

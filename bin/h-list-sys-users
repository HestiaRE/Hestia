#!/bin/bash
# info: list system users
# options: [FORMAT]
#
# example: h-list-sys-users
#
# Lists the account names.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$("$BIN/h-list-users" 'list' | wc -w)
	i=1
	echo '['
	while read -r user; do
		json_escape user
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$user"
		else
			printf '\t"%s"\n' "$user"
		fi
		((++i))
	done < <("$BIN/h-list-users" 'list')
	echo "]"
}

shell_list() {
	echo "USER"
	echo "----"
	while read user; do
		echo "$user"
	done < <("$BIN/h-list-users" 'list')
}

plain_list() {
	while read user; do
		echo "$user"
	done < <("$BIN/h-list-users" 'list')
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

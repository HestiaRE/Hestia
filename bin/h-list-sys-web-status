#!/bin/bash
# info: list web status
# options:
#
# example: h-list-sys-web-status
#
# This function lists web server status

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
#format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking web system
if [ -z "$WEB_SYSTEM" ]; then
	exit
fi

# Displaying proxy status
if [ "$PROXY_SYSTEM" = 'nginx' ]; then
	echo "<h2>$PROXY_SYSTEM STATUS</h2>" | tr '[:lower:]' '[:upper:]'
	wget -T 5 -t 1 -qO- http://localhost:8084/
	echo "<br><br><br>"
fi

# Displaying web server status
echo "<h2>$WEB_SYSTEM STATUS</h2>" | tr '[:lower:]' '[:upper:]'
if [ "$WEB_SYSTEM" != 'nginx' ]; then
	# Bounded: a wedged server would hold the admin page, its PHP worker and this sudo for wget's 900 s.
	wget -T 5 -t 1 -qO- http://localhost:8081/server-status/ \
		| grep -Ev "html|DOCTYPE|h1>|title|head"
else
	wget -T 5 -t 1 -qO- http://localhost:8084/
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

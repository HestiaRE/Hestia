#!/bin/bash
# info: list web status
# options:
#
# example: h-list-sys-web-status
#
# The status pages of the web server and the nginx proxy, as HTML for the panel. mod_status escapes request lines itself.


# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ -z "$WEB_SYSTEM" ]; then
	exit
fi

if [ "$PROXY_SYSTEM" = 'nginx' ]; then
	echo "<h2>$PROXY_SYSTEM STATUS</h2>" | tr '[:lower:]' '[:upper:]'
	wget -T 5 -t 1 -qO- http://localhost:8084/
	echo "<br><br><br>"
fi

echo "<h2>$WEB_SYSTEM STATUS</h2>" | tr '[:lower:]' '[:upper:]'
if [ "$WEB_SYSTEM" != 'nginx' ]; then
	# Bounded: a wedged server would otherwise hold the admin page, its PHP worker and this sudo.
	wget -T 5 -t 1 -qO- http://localhost:8081/server-status/ \
		| grep -Ev "html|DOCTYPE|h1>|title|head"
else
	wget -T 5 -t 1 -qO- http://localhost:8084/
fi

exit

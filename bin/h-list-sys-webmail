#!/bin/bash
# info: listing available webmail clients
# options: [FORMAT]
# labels: hestia mail
#
# example: h-list-sys-webmail
#
# List available webmail clients

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# Known-list order, not the key's: callers take the first as the default and the token writers append.
# A token outside the known list has no template, so it is not offered.
clients=$(for c in $WEBMAIL_KNOWN_CLIENTS; do case ",$WEBMAIL_SYSTEM," in *",$c,"*) echo "$c" ;; esac done)

json_list() {
	i=1
	objects=$(printf '%s\n' "$clients" | grep -c .)
	echo '['
	for client in $clients; do
		json_escape client
		if [ "$i" -ne "$objects" ]; then
			printf '\t"%s",\n' "$client"
		else
			printf '\t"%s"\n' "$client"
		fi
		((++i))
	done
	echo ']'
}

shell_list() {
	echo "Webmail Client"
	echo "--------"
	for client in $clients; do
		echo "$client"
	done
}

plain_list() {
	for client in $clients; do
		echo "$client"
	done
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

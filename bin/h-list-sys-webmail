#!/bin/bash
# info: listing available webmail clients
# options: [FORMAT]
# labels: hestia mail
#
# example: h-list-sys-webmail
#
# List available webmail clients

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# The installed clients in the order of WEBMAIL_KNOWN_CLIENTS, never in the order of the key: the panel's
# select and h-add-mail-domain-webmail take the first entry as the default, and the token writers append.
# A token outside the known list is not offered (it has no template either).
clients=$(for c in $WEBMAIL_KNOWN_CLIENTS; do case ",$WEBMAIL_SYSTEM," in *",$c,"*) echo "$c" ;; esac done)

# JSON list function
json_list() {
	i=1
	objects=$(printf '%s\n' "$clients" | grep -c .)
	echo '['
	for client in $clients; do
		json_escape client
		if [ "$i" -ne "$objects" ]; then
			printf '\t"%s",\n' "$client"
		else
			printf '\t"%s"\n' "$client"
		fi
		((++i))
	done
	echo ']'
}

# SHELL list function
shell_list() {
	echo "Webmail Client"
	echo "--------"
	for client in $clients; do
		echo "$client"
	done
}

# PLAIN list function
plain_list() {
	for client in $clients; do
		echo "$client"
	done
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

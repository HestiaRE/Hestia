#!/bin/bash
# info: list user parameters
# options: USER [FORMAT]
#
# example: h-list-user admin
#
# This function to obtain user parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# JSON list function
json_list() {
	json_escape USER NAME PACKAGE DOCKER_IP DOCKER_LIMIT WEB_TEMPLATE BACKEND_TEMPLATE PROXY_TEMPLATE WEB_DOMAINS WEB_ALIASES MAIL_DOMAINS MAIL_ACCOUNTS DATABASES CRON_JOBS DISK_QUOTA BANDWIDTH HOME SHELL BACKUPS CONTACT CRON_REPORTS RKEY TWOFA QRCODE ROLE SUSPENDED SUSPENDED_USERS SUSPENDED_WEB SUSPENDED_MAIL SUSPENDED_DB SUSPENDED_CRON IP_AVAIL IP_OWNED U_USERS U_DISK U_DISK_DIRS U_DISK_WEB U_DISK_MAIL U_DISK_DB U_BANDWIDTH U_WEB_DOMAINS U_WEB_SSL U_WEB_ALIASES U_MAIL_DOMAINS U_MAIL_DKIM U_MAIL_ACCOUNTS U_DATABASES U_CRON_JOBS U_BACKUPS BACKUPS_MODE LANGUAGE THEME NOTIFICATIONS PREF_UI_SORT FILE_MANAGER LOGIN_DISABLED LOGIN_USE_IPLIST LOGIN_ALLOW_IPS PHPCLI TIME DATE
	echo '{'
	printf '    "%s": {\n' "$USER"
	printf '        "NAME": "%s",\n' "$NAME"
	printf '        "PACKAGE": "%s",\n' "$PACKAGE"
	printf '        "DOCKER_IP": "%s",\n' "$DOCKER_IP"
	printf '        "DOCKER_LIMIT": "%s",\n' "$DOCKER_LIMIT"
	printf '        "WEB_TEMPLATE": "%s",\n' "$WEB_TEMPLATE"
	printf '        "BACKEND_TEMPLATE": "%s",\n' "$BACKEND_TEMPLATE"
	printf '        "PROXY_TEMPLATE": "%s",\n' "$PROXY_TEMPLATE"
	printf '        "WEB_DOMAINS": "%s",\n' "$WEB_DOMAINS"
	printf '        "WEB_ALIASES": "%s",\n' "$WEB_ALIASES"
	printf '        "MAIL_DOMAINS": "%s",\n' "$MAIL_DOMAINS"
	printf '        "MAIL_ACCOUNTS": "%s",\n' "$MAIL_ACCOUNTS"
	printf '        "DATABASES": "%s",\n' "$DATABASES"
	printf '        "CRON_JOBS": "%s",\n' "$CRON_JOBS"
	printf '        "DISK_QUOTA": "%s",\n' "$DISK_QUOTA"
	printf '        "BANDWIDTH": "%s",\n' "$BANDWIDTH"
	printf '        "HOME": "%s",\n' "$HOME"
	printf '        "SHELL": "%s",\n' "$SHELL"
	printf '        "BACKUPS": "%s",\n' "$BACKUPS"
	printf '        "CONTACT": "%s",\n' "$CONTACT"
	printf '        "CRON_REPORTS": "%s",\n' "$CRON_REPORTS"
	printf '        "RKEY": "%s",\n' "$RKEY"
	printf '        "TWOFA": "%s",\n' "$TWOFA"
	printf '        "QRCODE": "%s",\n' "$QRCODE"
	printf '        "ROLE": "%s",\n' "$ROLE"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "SUSPENDED_USERS": "%s",\n' "$SUSPENDED_USERS"
	printf '        "SUSPENDED_WEB": "%s",\n' "$SUSPENDED_WEB"
	printf '        "SUSPENDED_MAIL": "%s",\n' "$SUSPENDED_MAIL"
	printf '        "SUSPENDED_DB": "%s",\n' "$SUSPENDED_DB"
	printf '        "SUSPENDED_CRON": "%s",\n' "$SUSPENDED_CRON"
	printf '        "IP_AVAIL": "%s",\n' "$IP_AVAIL"
	printf '        "IP_OWNED": "%s",\n' "$IP_OWNED"
	printf '        "U_USERS": "%s",\n' "$U_USERS"
	printf '        "U_DISK": "%s",\n' "$U_DISK"
	printf '        "U_DISK_DIRS": "%s",\n' "$U_DISK_DIRS"
	printf '        "U_DISK_WEB": "%s",\n' "$U_DISK_WEB"
	printf '        "U_DISK_MAIL": "%s",\n' "$U_DISK_MAIL"
	printf '        "U_DISK_DB": "%s",\n' "$U_DISK_DB"
	printf '        "U_BANDWIDTH": "%s",\n' "$U_BANDWIDTH"
	printf '        "U_WEB_DOMAINS": "%s",\n' "$U_WEB_DOMAINS"
	printf '        "U_WEB_SSL": "%s",\n' "$U_WEB_SSL"
	printf '        "U_WEB_ALIASES": "%s",\n' "$U_WEB_ALIASES"
	printf '        "U_MAIL_DOMAINS": "%s",\n' "$U_MAIL_DOMAINS"
	printf '        "U_MAIL_DKIM": "%s",\n' "$U_MAIL_DKIM"
	printf '        "U_MAIL_ACCOUNTS": "%s",\n' "$U_MAIL_ACCOUNTS"
	printf '        "U_DATABASES": "%s",\n' "$U_DATABASES"
	printf '        "U_CRON_JOBS": "%s",\n' "$U_CRON_JOBS"
	printf '        "U_BACKUPS": "%s",\n' "$U_BACKUPS"
	printf '        "BACKUPS_MODE": "%s",\n' "${BACKUPS_MODE:-full}"
	printf '        "LANGUAGE": "%s",\n' "$LANGUAGE"
	printf '        "THEME": "%s",\n' "$THEME"
	printf '        "NOTIFICATIONS": "%s",\n' "$NOTIFICATIONS"
	printf '        "PREF_UI_SORT": "%s",\n' "$PREF_UI_SORT"
	printf '        "FILE_MANAGER": "%s",\n' "$FILE_MANAGER"
	printf '        "LOGIN_DISABLED": "%s",\n' "$LOGIN_DISABLED"
	printf '        "LOGIN_USE_IPLIST": "%s",\n' "$LOGIN_USE_IPLIST"
	printf '        "LOGIN_ALLOW_IPS": "%s",\n' "$LOGIN_ALLOW_IPS"
	printf '        "PHPCLI": "%s",\n' "$PHPCLI"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '        }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "USERNAME:      $USER"
	echo "FULL NAME:     $NAME"
	echo "EMAIL:         $CONTACT"
	echo "LANGUAGE:      $LANGUAGE"
	echo "THEME:         $THEME"
	echo "SUSPENDED:     $SUSPENDED"
	echo "PACKAGE:       $PACKAGE"
	echo "SHELL:         $SHELL"
	echo "WEB DOMAINS:   $U_WEB_DOMAINS/$WEB_DOMAINS"
	echo "WEB ALIASES:   $U_WEB_ALIASES/$WEB_ALIASES"
	echo "MAIL DOMAINS:  $U_MAIL_DOMAINS/$MAIL_DOMAINS"
	echo "MAIL ACCOUNTS: $U_MAIL_ACCOUNTS/$MAIL_ACCOUNTS"
	echo "BACKUPS:       $U_BACKUPS/$BACKUPS"
	echo "DATABASES:     $U_DATABASES/$DATABASES"
	echo "CRON_JOBS:     $U_CRON_JOBS/$CRON_JOBS"
	echo "DISK:          $U_DISK/$DISK_QUOTA"
	echo "BANDWIDTH:     $U_BANDWIDTH/$BANDWIDTH"
	echo "IP ADDRESSES   $IP_AVAIL/$IP_OWNED"
	echo "TIME:          $TIME"
	echo "DATE:          $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "$USER\t$NAME\t$PACKAGE\t$WEB_TEMPLATE\t"
	echo -ne "$BACKEND_TEMPLATE\t$PROXY_TEMPLATE\t"
	echo -ne "$WEB_DOMAINS\t$WEB_ALIASES\t"
	echo -ne "$MAIL_DOMAINS\t$MAIL_ACCOUNTS\t$DATABASES\t$CRON_JOBS\t"
	echo -ne "$DISK_QUOTA\t$BANDWIDTH\t$HOME\t$SHELL\t"
	echo -ne "$BACKUPS\t$CONTACT\t$CRON_REPORTS\t$SUSPENDED\t"
	echo -ne "$SUSPENDED_USERS\t$SUSPENDED_WEB\t"
	echo -ne "$SUSPENDED_MAIL\t$SUSPENDED_DB\t$SUSPENDED_CRON\t"
	echo -ne "$IP_AVAIL\t$IP_OWNED\t$U_USERS\t$U_DISK\t$U_DISK_DIRS\t"
	echo -ne "$U_DISK_WEB\t$U_DISK_MAIL\t$U_DISK_DB\t$U_BANDWIDTH\t"
	echo -ne "$U_WEB_DOMAINS\t$U_WEB_SSL\t$U_WEB_ALIASES\t"
	echo -ne "$U_MAIL_DOMAINS\t"
	echo -ne "$U_MAIL_DKIM\t$U_MAIL_ACCOUNTS\t$U_DATABASES\t"
	echo -e "$U_CRON_JOBS\t$U_BACKUPS\t$LANGUAGE\t$THEME\t$TIME\t$DATE"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining config
USER=$user
HOME=$HOMEDIR/$user
source_conf "$CONF_DIR/users/$user/user.conf"
U_USERS=$(awk -F"'" '/^U_USERS=/ {print $2}' "$CONF_DIR/users/$ROOT_USER/user.conf")
SUSPENDED_USERS=$(awk -F"'" '/^SUSPENDED_USERS=/ {print $2}' "$CONF_DIR/users/$ROOT_USER/user.conf")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

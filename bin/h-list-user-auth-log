#!/bin/bash
# info: list user log
# options: USER [FORMAT]
#
# Lists a user's login history.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(echo "$logs" | wc -l)
	echo "{"
	for str in $logs; do
		DATE=$(echo "$str" | cut -f 2 -d \')
		TIME=$(echo "$str" | cut -f 4 -d \')
		IP=$(echo "$str" | cut -f 6 -d \')
		ACTION=$(echo "$str" | cut -f 8 -d \')
		STATUS=$(echo "$str" | cut -f 10 -d \')
		USER_AGENT=$(echo "$str" | cut -f 12 -d \')
		SESSION=$(echo "$str" | cut -f 14 -d \')
		ACTIVE=$(echo "$str" | cut -f 16 -d \')
		json_escape i DATE TIME IP ACTION STATUS USER_AGENT SESSION ACTIVE
		printf '    "%s": {\n' "$i"
		printf '            "DATE": "%s",\n' "$DATE"
		printf '            "TIME": "%s",\n' "$TIME"
		printf '            "IP": "%s",\n' "$IP"
		printf '            "ACTION": "%s",\n' "$ACTION"
		printf '            "STATUS": "%s",\n' "$STATUS"
		printf '            "USER_AGENT": "%s",\n' "$USER_AGENT"
		printf '            "SESSION": "%s",\n' "$SESSION"
		printf '            "ACTIVE": "%s"\n' "$ACTIVE"
		printf '        }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "DATE~TIME~IP~ACTION~STATUS~USER_AGENT~SESSION~ACTIVE"
	echo "----~----~--~------~------~----------~-------~------"
	for str in $logs; do
		DATE=$(echo "$str" | cut -f 2 -d \')
		TIME=$(echo "$str" | cut -f 4 -d \')
		IP=$(echo "$str" | cut -f 6 -d \')
		ACTION=$(echo "$str" | cut -f 8 -d \')
		STATUS=$(echo "$str" | cut -f 10 -d \')
		USER_AGENT=$(echo "$str" | cut -f 12 -d \')
		SESSION=$(echo "$str" | cut -f 14 -d \')
		ACTIVE=$(echo "$str" | cut -f 16 -d \')
		echo "$DATE~$TIME~$IP~$ACTION~$STATUS~$USER_AGENT~$SESSION~$ACTIVE"
	done
}

plain_list() {
	IFS=$'\n'
	for str in $logs; do
		DATE=$(echo "$str" | cut -f 2 -d \')
		TIME=$(echo "$str" | cut -f 4 -d \')
		IP=$(echo "$str" | cut -f 6 -d \')
		ACTION=$(echo "$str" | cut -f 8 -d \')
		STATUS=$(echo "$str" | cut -f 10 -d \')
		USER_AGENT=$(echo "$str" | cut -f 12 -d \')
		SESSION=$(echo "$str" | cut -f 14 -d \')
		ACTIVE=$(echo "$str" | cut -f 16 -d \')
		echo -e "$DATE\t$TIME\t$IP\t$ACTION\t$STATUS\t$USER_AGENT\t$SESSION\t$ACTIVE"
	done
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

logs=$(tail -n 10 $USER_DATA/auth.log 2> /dev/null)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '~' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

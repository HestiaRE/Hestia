#!/bin/bash
# info: list user backup
# options: USER BACKUP [FORMAT]
#
# example: h-list-user-backup admin admin.2019-05-19_03-31-30.tar
#
# Lists the parameters of one backup archive (json, shell or plain).

user=$1
backup=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

fields="\$BACKUP \$TYPE \$SIZE \$WEB \$DB \$MAIL \$CRON \$UDIR"
fields="$fields \$MAP \$MODE \$BASE \$RUNTIME \$TIME \$DATE"

json_list() {
	echo '{'
	json_escape BACKUP TYPE SIZE WEB MAIL DB CRON UDIR MAP MODE BASE RUNTIME TIME DATE
	printf '    "%s": {\n' "$BACKUP"
	printf '        "TYPE": "%s",\n' "$TYPE"
	printf '        "SIZE": "%s",\n' "$SIZE"
	printf '        "WEB": "%s",\n' "$WEB"
	printf '        "MAIL": "%s",\n' "$MAIL"
	printf '        "DB": "%s",\n' "$DB"
	printf '        "CRON": "%s",\n' "$CRON"
	printf '        "UDIR": "%s",\n' "$UDIR"
	printf '        "MAP": "%s",\n' "$MAP"
	printf '        "MODE": "%s",\n' "${MODE:-full}"
	printf '        "BASE": "%s",\n' "$BASE"
	printf '        "RUNTIME": "%s",\n' "$RUNTIME"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "BACKUP:         $BACKUP"
	echo "TYPE:           $TYPE"
	echo "SIZE:           $SIZE mb"
	echo "MAP:            ${MAP:-0} entries"
	echo "MODE:           ${MODE:-full}${BASE:+ against $BASE}"
	echo "RUNTIME:        $RUNTIME min"
	echo "WEB:            ${WEB//,/ }"
	echo "MAIL:           ${MAIL//,/ }"
	echo "DB:             ${DB//,/ }"
	echo "CRON:           $CRON"
	echo "UDIR:           ${UDIR//,/ }"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

plain_list() {
	echo -ne "$BACKUP\t$TYPE\t$SIZE\t$WEB\t$MAIL\t$DB\t$CRON\t"
	echo -e "$UDIR\t$MAP\t${MODE:-full}\t$BASE\t$RUNTIME\t$TIME\t$DATE"
}

check_args '2' "$#" 'USER BACKUP [FORMAT]'
is_format_valid 'user' 'backup'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'backup' 'BACKUP' "$backup"

parse_object_kv_list "$(grep -F "BACKUP='$backup'" $USER_DATA/backup.conf)"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

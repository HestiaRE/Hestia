#!/bin/bash
# info: list backup exclusions
# options: USER [FORMAT]
#
# example: h-list-user-backup-exclusions admin
#
# Lists the backup exclusions of a user.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	set -f
	i=1
	echo '{'
	echo '    "WEB": {'
	objects=$(echo "${WEB//,/ }" | wc -w)
	for object in $(echo "${WEB//,/ }"); do
		j=1
		object_keys=$(echo ${object//:/ } | wc -w)
		for key in $(echo "${object/:/ }"); do
			json_escape key
			if [ "$j" -eq 1 ]; then
				echo -n "        \"${key}\": "
				if [ "$object_keys" -eq 1 ]; then
					echo -n '""'
				fi
			else
				echo -n "\"${key//:/,}\""
			fi
			((j++))
		done
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '    },'
	i=1
	echo '    "MAIL": {'
	objects=$(echo "${MAIL//,/ }" | wc -w)
	for object in $(echo "${MAIL//,/ }"); do
		j=1
		object_keys=$(echo ${object//:/ } | wc -w)
		for key in $(echo "${object/:/ }"); do
			json_escape key
			if [ "$j" -eq 1 ]; then
				echo -n "        \"$key\": "
				if [ "$object_keys" -eq 1 ]; then
					echo -n '""'
				fi
			else
				echo -n "\"${key//:/,}\""
			fi
			((j++))
		done
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '    },'
	i=1
	echo '    "DB": {'
	objects=$(echo "${DB//,/ }" | wc -w)
	for object in $(echo "${DB//,/ }"); do
		j=1
		object_keys=$(echo ${object//:/ } | wc -w)
		for key in $(echo "${object/:/ }"); do
			json_escape key
			if [ "$j" -eq 1 ]; then
				echo -n "        \"$key\": "
				if [ "$object_keys" -eq 1 ]; then
					echo -n '""'
				fi
			else
				echo -n "\"${key//:/,}\""
			fi
			((j++))
		done
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '    },'
	i=1
	echo '    "CRON": {'
	objects=$(echo "${CRON//,/ }" | wc -w)
	for object in $(echo "${CRON//,/ }"); do
		j=1
		object_keys=$(echo ${object//:/ } | wc -w)
		for key in $(echo "${object/:/ }"); do
			json_escape key
			if [ "$j" -eq 1 ]; then
				echo -n "        \"$key\": "
				if [ "$object_keys" -eq 1 ]; then
					echo -n '""'
				fi
			else
				echo -n "\"${key//:/,}\""
			fi
			((j++))
		done
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '    },'
	i=1
	echo '    "USER": {'
	objects=$(echo "${USER//,/ }" | wc -w)
	for object in $(echo "${USER//,/ }"); do
		j=1
		object_keys=$(echo ${object//:/ } | wc -w)
		for key in $(echo "${object/:/ }"); do
			json_escape key
			if [ "$j" -eq 1 ]; then
				echo -n "        \"$key\": "
				if [ "$object_keys" -eq 1 ]; then
					echo -n '""'
				fi
			else
				echo -n "\"${key//:/,}\""
			fi
			((j++))
		done
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '    }'
	echo '}'

}

shell_list() {
	echo "WEB:            $WEB"
	echo "MAIL:           $MAIL"
	echo "DB:             $DB"
	echo "CRON:           $CRON"
	echo "USER DIRS:      $USER"
}

plain_list() {
	echo "$WEB\t$MAIL\t$DB\t$CRON\t$USER"
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

WEB=''
MAIL=''
DB=''
CRON=''
USER=''

if [ -e "$USER_DATA/backup-excludes.conf" ]; then
	source_conf "$USER_DATA/backup-excludes.conf"
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

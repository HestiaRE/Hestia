#!/bin/bash
# info: list user backups
# options: USER [FORMAT]
#
# example: h-list-user-backups admin
#
# List the backup records of USER, with whether a copy is on this box.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh

# parse_object_kv_list overwrites BACKUP, which the resolver reads as the directory: swapped back around the call.
local_of() {
	local _n="$1" _keep="$BACKUP"
	BACKUP="$backup_root"
	if backup_archive_path "$user" "$_n"; then LOCAL='yes'; else LOCAL='no'; fi
	BACKUP="$_keep"
}
source_conf "$HESTIA/conf/hestia.conf"
# Taken after source_conf: main.sh only seeds a constant, which is wrong where the operator configured another.
backup_root="$BACKUP"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep BACKUP $USER_DATA/backup.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		# LOCAL says what this box knows: a copy is here or not. Whether a remote holds it is not asked.
		local_of "$BACKUP"
		json_escape BACKUP TYPE SIZE WEB MAIL DB CRON UDIR MAP MODE BASE LOCAL RUNTIME TIME DATE
		printf '    "%s": {\n' "$BACKUP"
		printf '        "TYPE": "%s",\n' "$TYPE"
		printf '        "SIZE": "%s",\n' "$SIZE"
		printf '        "WEB": "%s",\n' "$WEB"
		printf '        "MAIL": "%s",\n' "$MAIL"
		printf '        "DB": "%s",\n' "$DB"
		printf '        "CRON": "%s",\n' "$CRON"
		printf '        "UDIR": "%s",\n' "$UDIR"
		printf '        "MAP": "%s",\n' "$MAP"
		printf '        "MODE": "%s",\n' "${MODE:-full}"
		printf '        "BASE": "%s",\n' "$BASE"
		printf '        "LOCAL": "%s",\n' "$LOCAL"
		printf '        "RUNTIME": "%s",\n' "$RUNTIME"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/backup.conf)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "BACKUP   TYPE   SIZE  LOCAL  TIME  DATE"
	echo "------   ----   ---   -----  ----  ----"
	while read -r str; do
		parse_object_kv_list "$str"
		local_of "$BACKUP"
		echo "$BACKUP $TYPE $SIZE $LOCAL $RUNTIME $DATE"
	done < <(cat $USER_DATA/backup.conf)
}

plain_list() {
	IFS=$'\n'
	while read -r str; do
		parse_object_kv_list "$str"
		local_of "$BACKUP"
		echo -ne "$BACKUP\t$TYPE\t$SIZE\t$WEB\t$MAIL\t$CRON\t$UDIR\t$MAP\t${MODE:-full}\t$BASE\t$LOCAL\t"
		echo -e "$RUNTIME\t$TIME\t$DATE"
	done < <(cat $USER_DATA/backup.conf)
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

conf=$USER_DATA/backup.conf
if [ ! -e "$conf" ]; then
	touch $conf
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

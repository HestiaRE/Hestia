#!/bin/bash
# info: list the restic snapshots of a user
# options: USER [FORMAT]
#
# example: h-list-user-backups-restic admin json
#
# Lists the restic snapshots of a user.

user=$1
format=${2-plain}
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

is_restic_repo_configured

function json_list() {
	restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json snapshots
}

function plain_list() {
	restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf snapshots
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

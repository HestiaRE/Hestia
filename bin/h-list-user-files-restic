#!/bin/bash
# info: list the files of a folder inside a restic snapshot
# options: USER SNAPSHOT FOLDER
#
# example: h-backup-user admin yes
#
# This function is used for backing up user with all its domains and databases.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
folder=$3
# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SNAPSHOT FOLDER'
is_format_valid 'user'
# Both come from the panel and are restic arguments, so neither may read as an option.
is_object_format_valid "$snapshot" 'snapshot'
case "$folder" in
	"$HOMEDIR/$user" | "$HOMEDIR/$user"/*) ;;
	*) check_result "$E_FORBIDEN" "$folder is outside $HOMEDIR/$user" ;;
esac
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

is_restic_repo_configured

restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf --json ls "$snapshot" "$folder"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

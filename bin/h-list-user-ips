#!/bin/bash
# info: list user IPs
# options: USER [FORMAT]
#
# example: h-list-user-ips admin
#
# Lists the IPs a user may use: their own and the admin's shared ones.

user="$1"
format="${2-shell}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	echo '{'
	ip_count="$(echo "$ips" | wc -l)"
	i=1
	for IP in $ips; do
		source_conf "$CONF_DIR/ips/$IP"
		json_escape IP OWNER STATUS NAME NAT
		printf '    "%s": {\n' "$IP"
		printf '        "OWNER": "%s",\n' "$OWNER"
		printf '        "STATUS": "%s",\n' "$STATUS"
		printf '        "NAME": "%s",\n' "$NAME"
		printf '        "NAT": "%s"\n' "$NAT"
		printf '        }'
		if [ "$i" -lt "$ip_count" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '}'
}

shell_list() {
	echo "IP  NAT  OWNER   STATUS   NAME"
	echo "--  ---  -----   ------   ---"
	for IP in $ips; do
		source_conf "$CONF_DIR/ips/$IP"
		if [ -z "$NAT" ]; then
			NAT='no'
		fi
		if [ -z "$NAME" ]; then
			NAME='no'
		fi
		echo "$IP $NAT $OWNER $STATUS $NAME"
	done
}

plain_list() {
	for IP in $ips; do
		source_conf "$CONF_DIR/ips/$IP"
		echo -e "$IP\t$OWNER\t$STATUS\t$NAME\t$NAT"
	done
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

owner="$ROOT_USER"
# The path prefix is stripped, not cut at a field number: the data/ depth differs from upstream.
owner_ips="$(grep -F -A 1 -H "OWNER='$owner'" $CONF_DIR/ips/*)"
owner_ips="$(echo "$owner_ips" | grep "STATUS='shared'")"
owner_ips="$(echo "$owner_ips" | sed "s|-STATUS=.*||; s|^$CONF_DIR/ips/||")"
user_ips="$(grep -F -H "OWNER='$user'" $CONF_DIR/ips/*)"
user_ips="$(echo "$user_ips" | sed "s|:OWNER=.*||; s|^$CONF_DIR/ips/||")"
ips="$(echo -e "$user_ips\n$owner_ips" | sort -u | sed "/^$/d")"
fields='$IP $OWNER $STATUS $NAME $NAT'

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list user log
# options: USER [FORMAT]
#
# example: h-list-user-log
#
# Lists the latest entries of a user's history, or of the system activity log for the name system.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(echo "$logs" | wc -l)
	echo "{"
	for str in $logs; do
		ID=$(echo "$str" | cut -f 2 -d \')
		DATE=$(echo "$str" | cut -f 4 -d \')
		TIME=$(echo "$str" | cut -f 6 -d \')
		LEVEL=$(echo "$str" | cut -f 8 -d \')
		CATEGORY=$(echo "$str" | cut -f 10 -d \')
		MESSAGE=$(echo "$str" | cut -f 12 -d \')
		json_escape ID DATE TIME LEVEL CATEGORY MESSAGE
		printf '    "%s": {\n' "$ID"
		printf '        "DATE": "%s",\n' "$DATE"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "LEVEL": "%s",\n' "$LEVEL"
		printf '        "CATEGORY": "%s",\n' "$CATEGORY"
		printf '        "MESSAGE": "%s"\n' "$MESSAGE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "ID~DATE~TIME~LEVEL~CATEGORY~MESSAGE"
	echo "----~----~----~-----~--------~-------"
	for str in $logs; do
		ID=$(echo "$str" | cut -f 2 -d \')
		DATE=$(echo "$str" | cut -f 4 -d \')
		TIME=$(echo "$str" | cut -f 6 -d \')
		LEVEL=$(echo "$str" | cut -f 8 -d \')
		CATEGORY=$(echo "$str" | cut -f 10 -d \')
		MESSAGE=$(echo "$str" | cut -f 12 -d \')
		echo "$ID~$DATE~$TIME~$LEVEL~$CATEGORY~$MESSAGE"
	done
}

plain_list() {
	IFS=$'\n'
	for str in $logs; do
		ID=$(echo "$str" | cut -f 2 -d \')
		DATE=$(echo "$str" | cut -f 4 -d \')
		TIME=$(echo "$str" | cut -f 6 -d \')
		LEVEL=$(echo "$str" | cut -f 8 -d \')
		CATEGORY=$(echo "$str" | cut -f 10 -d \')
		MESSAGE=$(echo "$str" | cut -f 12 -d \')
		echo -e "$ID\t$DATE\t$TIME\t$LEVEL\t$CATEGORY\t$MESSAGE"
	done
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
if [ "$user" != "system" ]; then
	is_object_valid 'user' 'USER' "$user"
fi

if [ "$user" = "system" ]; then
	log_file="$HESTIA/log/activity.log"
else
	log_file="$USER_DATA/history.log"
fi
logs=$(tail -n 300 $log_file 2> /dev/null)

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t -s '~' ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list user notifications
# options: USER [FORMAT]
#
# example: h-list-user-notifications admin
#
# This function for getting the notifications list

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep NID $USER_DATA/notifications.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		if [ "$PRIORITY" = '' ]; then
			PRIORITY='0'
		fi
		TOPIC=$(record_value_decode "$TOPIC")
		NOTICE=$(record_value_decode "$NOTICE")
		json_escape NID TOPIC NOTICE TYPE ACK PRIORITY TIME DATE
		printf '    "%s": {\n' "$NID"
		printf '        "TOPIC": "%s",\n' "$TOPIC"
		printf '        "NOTICE": "%s",\n' "$NOTICE"
		printf '        "TYPE": "%s",\n' "$TYPE"
		printf '        "ACK": "%s",\n' "$ACK"
		printf '        "PRIORITY": "%s",\n' "$PRIORITY"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/notifications.conf)
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		record_value_decode "$TOPIC"
		echo
		record_value_decode "$NOTICE"
		echo
		echo "$DATE $TIME"
		echo "--"
		echo
	done < <(cat $USER_DATA/notifications.conf)
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		TOPIC=$(record_value_decode "$TOPIC")
		NOTICE=$(record_value_decode "$NOTICE")
		echo -e "$NID\t$TOPIC\t$NOTICE\t$TIME\t$DATE"
	done < <(cat $USER_DATA/notifications.conf)
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking args
check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

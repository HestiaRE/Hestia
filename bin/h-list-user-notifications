#!/bin/bash
# info: list user notifications
# options: USER [FORMAT]
#
# example: h-list-user-notifications admin
#
# Lists a user's notifications.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep NID $USER_DATA/notifications.conf | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		if [ "$PRIORITY" = '' ]; then
			PRIORITY='0'
		fi
		TOPIC=$(record_value_decode "$TOPIC")
		NOTICE=$(record_value_decode "$NOTICE")
		json_escape NID TOPIC NOTICE TYPE ACK PRIORITY TIME DATE
		printf '    "%s": {\n' "$NID"
		printf '        "TOPIC": "%s",\n' "$TOPIC"
		printf '        "NOTICE": "%s",\n' "$NOTICE"
		printf '        "TYPE": "%s",\n' "$TYPE"
		printf '        "ACK": "%s",\n' "$ACK"
		printf '        "PRIORITY": "%s",\n' "$PRIORITY"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat $USER_DATA/notifications.conf)
	echo '}'
}

shell_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		record_value_decode "$TOPIC"
		echo
		record_value_decode "$NOTICE"
		echo
		echo "$DATE $TIME"
		echo "--"
		echo
	done < <(cat $USER_DATA/notifications.conf)
}

plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		TOPIC=$(record_value_decode "$TOPIC")
		NOTICE=$(record_value_decode "$NOTICE")
		printf '%s\t%s\t%s\t%s\t%s\n' "$NID" "$TOPIC" "$NOTICE" "$TIME" "$DATE"
	done < <(cat $USER_DATA/notifications.conf)
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

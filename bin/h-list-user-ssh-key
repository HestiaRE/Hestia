#!/bin/bash
# info: list ssh keys
# options: USER [FORMAT]
#
# Lists $user/.ssh/authorized_keys

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

format=${2-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(echo "$keys" | wc -l)
	echo "{"
	for str in $keys; do
		KEY=$(echo $str | awk '{print $2}')
		ID=$(echo $str | awk '{print $(NF-1)}')
		json_escape ID KEY
		printf '    "%s": {\n' "$KEY"
		printf '        "ID": "%s",\n' "$ID"
		printf '        "KEY": "%s"\n' "$KEY"
		printf '        }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		fi
		((i++))
	done
	echo "}"
}

shell_list() {
	IFS=$'\n'
	echo "ID~KEY"
	echo "----~----~---"
	for str in $keys; do
		KEY=$(echo $str | awk '{print $2}')
		ID=$(echo $str | awk '{print $(NF-1)}')
		echo "$ID~$KEY"
	done
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	for str in $keys; do
		KEY=$(echo $str | awk '{print $2}')
		ID=$(echo $str | awk '{print $(NF-1)}')
		echo -e "$ID\t$KEY"
	done
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

AUTHKEY_FILE=$(authkeys_file)
path_within "$AUTHKEY_FILE" "$HOMEDIR/$user/.ssh" || check_result "$E_FORBIDEN" "Invalid authorized keys path"

#check if file exsists
if [ ! -f "$AUTHKEY_FILE" ]; then
	exit
fi

first_loop=1
while IFS= read -r l || [ -n "$l" ]; do
	sshkey=$([[ -n $l && ${l###} = $l ]] && ssh-keygen -l -f - <<< "$l" 2> /dev/null)
	if [ -n "$sshkey" ]; then
		(($first_loop)) && keys="$sshkey" || keys="$keys"$'\n'"$sshkey"
		unset first_loop
	fi
done < <(authkeys_read)

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging

exit

#!/bin/bash
# info: list overall user stats
# options: [FORMAT]
#
# Lists the monthly usage totals of all users.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep DATE "$CONF_DIR/users/$ROOT_USER/overall_stats.log" | wc -l)
	echo "{"
	while read -r str; do
		parse_object_kv_list "$str"
		json_escape DATE TIME PACKAGE IP_OWNED DISK_QUOTA U_DISK U_DISK_DIRS U_DISK_WEB U_DISK_MAIL U_DISK_DB BANDWIDTH U_BANDWIDTH U_WEB_DOMAINS U_WEB_SSL U_WEB_ALIASES U_MAIL_DOMAINS U_MAIL_DKIM U_MAIL_ACCOUNTS U_DATABASES U_CRON_JOBS U_BACKUPS U_USERS
		printf '    "%s": {\n' "$DATE"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "PACKAGE": "%s",\n' "$PACKAGE"
		printf '        "IP_OWNED": "%s",\n' "$IP_OWNED"
		printf '        "DISK_QUOTA": "%s",\n' "$DISK_QUOTA"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "U_DISK_DIRS": "%s",\n' "$U_DISK_DIRS"
		printf '        "U_DISK_WEB": "%s",\n' "$U_DISK_WEB"
		printf '        "U_DISK_MAIL": "%s",\n' "$U_DISK_MAIL"
		printf '        "U_DISK_DB": "%s",\n' "$U_DISK_DB"
		printf '        "BANDWIDTH": "%s",\n' "$BANDWIDTH"
		printf '        "U_BANDWIDTH": "%s",\n' "$U_BANDWIDTH"
		printf '        "U_WEB_DOMAINS": "%s",\n' "$U_WEB_DOMAINS"
		printf '        "U_WEB_SSL": "%s",\n' "$U_WEB_SSL"
		printf '        "U_WEB_ALIASES": "%s",\n' "$U_WEB_ALIASES"
		printf '        "U_MAIL_DOMAINS": "%s",\n' "$U_MAIL_DOMAINS"
		printf '        "U_MAIL_DKIM": "%s",\n' "$U_MAIL_DKIM"
		printf '        "U_MAIL_ACCOUNTS": "%s",\n' "$U_MAIL_ACCOUNTS"
		printf '        "U_DATABASES": "%s",\n' "$U_DATABASES"
		printf '        "U_CRON_JOBS": "%s",\n' "$U_CRON_JOBS"
		printf '        "U_BACKUPS": "%s",\n' "$U_BACKUPS"
		printf '        "U_USERS": "%s"\n' "$U_USERS"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done < <(cat "$CONF_DIR/users/$ROOT_USER/overall_stats.log")
	echo '}'
}

shell_list() {
	IFS=$'\n'
	echo "DATE   USER   WEB   MAIL   DB   BACKUPS   IP   DISK   BW"
	echo "----   ----   ---   ---   ----   --   -------   --   ----   --"
	while read str; do
		parse_object_kv_list "$str"
		if [ -z "$U_USERS" ]; then
			U_USERS=1
		fi
		echo -n "$DATE $U_USERS $U_WEB_DOMAINS "
		echo -n "$U_MAIL_DOMAINS $U_DATABASES $U_BACKUPS $IP_OWNED "
		echo "$U_DISK $U_BANDWIDTH"
	done < <(cat "$CONF_DIR/users/$ROOT_USER/overall_stats.log")
}

plain_list() {
	IFS=$'\n'
	while read str; do
		parse_object_kv_list "$str"
		echo -ne "$DATE\t$TIME\t$PACKAGE\t$IP_OWNED\t$DISK_QUOTA\t$U_DISK\t"
		echo -ne "$U_DISK_DIRS\t$U_DISK_WEB\t$U_DISK_MAIL\t$U_DISK_DB\t"
		echo -ne "$BANDWIDTH\t$U_BANDWIDTH\t$U_WEB_DOMAINS\t$U_WEB_SSL\t"
		echo -ne "$U_WEB_ALIASES\t"
		echo -ne "$U_MAIL_DOMAINS\t$U_MAIL_DKIM\t$U_MAIL_ACCOUNTS\t"
		echo -e "$U_DATABASES\t$U_CRON_JOBS\t$U_BACKUPS\t$U_USERS"
	done < <(cat "$CONF_DIR/users/$ROOT_USER/overall_stats.log")
}

check_args '0' "$#" '[FORMAT]'

$BIN/h-update-user-stats

conf="$CONF_DIR/users/$ROOT_USER/overall_stats.log"
if [ ! -e "$conf" ]; then
	touch $conf
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

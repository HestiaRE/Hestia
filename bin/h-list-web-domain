#!/bin/bash
# info: list web domain parameters
# options: USER DOMAIN [FORMAT]
#
# example: h-list-web-domain admin example.com
#
# This function to obtain web domain parameters.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
format=${3-shell}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	echo '{'
	json_escape DOMAIN IP IP6 DOCROOT U_DISK U_BANDWIDTH TPL ALIAS STATS STATS_USER SSL SSL_FORCE SSL_HSTS SSL_HOME HTTP3 DOCKER DOCKER_PORT DOCKER_OCTET LETSENCRYPT WP FTP_USER FTP_PATH AUTH_USER BACKEND PHP_VERSION PROXY PROXY_EXT FASTCGI_CACHE FASTCGI_DURATION PROXY_CACHE PROXY_CACHE_DURATION REDIRECT REDIRECT_CODE CUSTOM_DOCROOT BOTLIMIT CROWDSEC OFFLINE ALLOW_USERS SUSPENDED TIME DATE
	printf '    "%s": {\n' "$DOMAIN"
	printf '        "IP": "%s",\n' "$IP"
	printf '        "IP6": "%s",\n' "$IP6"
	printf '        "DOCUMENT_ROOT": "%s",\n' "$DOCROOT"
	printf '        "U_DISK": "%s",\n' "$U_DISK"
	printf '        "U_BANDWIDTH": "%s",\n' "$U_BANDWIDTH"
	printf '        "TPL": "%s",\n' "$TPL"
	printf '        "ALIAS": "%s",\n' "$ALIAS"
	printf '        "STATS": "%s",\n' "$STATS"
	printf '        "STATS_USER": "%s",\n' "$STATS_USER"
	printf '        "SSL": "%s",\n' "$SSL"
	printf '        "SSL_FORCE": "%s",\n' "$SSL_FORCE"
	printf '        "SSL_HSTS": "%s",\n' "$SSL_HSTS"
	printf '        "SSL_HOME": "%s",\n' "$SSL_HOME"
	printf '        "HTTP3": "%s",\n' "$HTTP3"
	printf '        "DOCKER": "%s",\n' "$DOCKER"
	printf '        "DOCKER_PORT": "%s",\n' "$DOCKER_PORT"
	printf '        "DOCKER_OCTET": "%s",\n' "$DOCKER_OCTET"
	printf '        "LETSENCRYPT": "%s",\n' "$LETSENCRYPT"
	printf '        "WP": "%s",\n' "$WP"
	printf '        "FTP_USER": "%s",\n' "$FTP_USER"
	printf '        "FTP_PATH": "%s",\n' "$FTP_PATH"
	printf '        "AUTH_USER": "%s",\n' "$AUTH_USER"
	printf '        "BACKEND": "%s",\n' "$BACKEND"
	printf '        "PHP_VERSION": "%s",\n' "$PHP_VERSION"
	printf '        "PROXY": "%s",\n' "$PROXY"
	printf '        "PROXY_EXT": "%s",\n' "$PROXY_EXT"
	printf '        "FASTCGI_CACHE": "%s",\n' "$FASTCGI_CACHE"
	printf '        "FASTCGI_DURATION": "%s",\n' "$FASTCGI_DURATION"
	printf '        "PROXY_CACHE": "%s",\n' "$PROXY_CACHE"
	printf '        "PROXY_CACHE_DURATION": "%s",\n' "$PROXY_CACHE_DURATION"
	printf '        "REDIRECT": "%s",\n' "$REDIRECT"
	printf '        "REDIRECT_CODE": "%s",\n' "$REDIRECT_CODE"
	printf '        "CUSTOM_DOCROOT": "%s",\n' "$CUSTOM_DOCROOT"
	printf '        "BOTLIMIT": "%s",\n' "$BOTLIMIT"
	printf '        "CROWDSEC": "%s",\n' "$CROWDSEC"
	printf '        "OFFLINE": "%s",\n' "$OFFLINE"
	printf '        "ALLOW_USERS": "%s",\n' "$ALLOW_USERS"
	printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
	printf '        "TIME": "%s",\n' "$TIME"
	printf '        "DATE": "%s"\n' "$DATE"
	echo '    }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "DOMAIN:           $DOMAIN"
	echo "ALIAS:            ${ALIAS//,/ }"
	echo "IP:               $IP"
	echo "DOCUMENT_ROOT:    $DOCROOT"
	if [ -n "$IP6" ]; then
		echo "IP6:              $IP6"
	fi
	if [ -n "$SSL" ] && [ "$SSL" != 'no' ]; then
		echo "SSL:              $SSL / $SSL_HOME"
		if [ -n "$LETSENCRYPT" ] && [ "$LETSENCRYPT" != 'no' ]; then
			echo "LETSENCRYPT:      $LETSENCRYPT"
		fi
		if [ -n "$SSL_FORCE" ]; then
			echo "SSL_FORCE:        $SSL_FORCE"
		fi
		if [ -n "$SSL_HSTS" ]; then
			echo "SSL_HSTS:         $SSL_HSTS"
		fi
	fi
	if [ -n "$HTTP3" ]; then
		echo "HTTP3:            $HTTP3"
	fi
	if [ -n "$DOCKER" ]; then
		echo "DOCKER:           $DOCKER -> .$DOCKER_OCTET:$DOCKER_PORT"
	fi
	if [ -n "$WP" ]; then
		echo "WORDPRESS:        managed"
	fi
	echo "TEMPLATE:         $TPL"
	if [ -n "$WEB_BACKEND" ]; then
		echo "BACKEND:          $BACKEND"
		echo "PHP_VERSION:      $PHP_VERSION"
	fi
	if [ -n "$PROXY_SYSTEM" ]; then
		echo "PROXY:            $PROXY"
		echo "PROXY EXT:        ${PROXY_EXT//,/ }"
	fi
	if [ -n "$STATS" ]; then
		echo "STATS:            $STATS"
	fi
	if [ "$FASTCGI_CACHE" = "yes" ]; then
		echo "FASTCGI_CACHE:    $FASTCGI_CACHE"
		echo "FASTCGI_DURATION: $FASTCGI_DURATION"
	fi
	if [ "$PROXY_CACHE" = "yes" ]; then
		echo "PROXY_CACHE:      $PROXY_CACHE"
		echo "PROXY_CACHE_DURATION: $PROXY_CACHE_DURATION"
	fi
	if [ "$OFFLINE" = "yes" ]; then
		echo "OFFLINE:          $OFFLINE"
	fi
	if [ "$ALLOW_USERS" = "yes" ]; then
		echo "ALLOW_USERS:      $ALLOW_USERS"
	fi
	if [ -n "$REDIRECT" ]; then
		echo "REDIRECT:         $REDIRECT"
		echo "REDIRECT_CODE:    $REDIRECT_CODE"
	fi
	if [ -n "$CUSTOM_DOCROOT" ]; then
		echo "CUSTOM_DOCROOT:   $CUSTOM_DOCROOT"
	fi
	if [ -n "$STATS_USER" ]; then
		echo "STATS_USER:       $STATS_USER"
	fi
	if [ -n "$FTP_USER" ]; then
		echo "FTP_USER:         ${FTP_USER//,/, }"
	fi
	if [ -n "$FTP_PATH" ]; then
		echo "FTP_PATH:         ${FTP_PATH}"
	fi
	if [ -n "$AUTH_USER" ]; then
		echo "HTTP_AUTH:        $AUTH_USER"
	fi
	echo "DISK:             $U_DISK"
	echo "BW:               $U_BANDWIDTH"
	if [ -n "$BOTLIMIT" ]; then
		echo "BOTLIMIT:         $BOTLIMIT"
	fi
	if [ -n "$CROWDSEC" ]; then
		echo "CROWDSEC:         $CROWDSEC"
	fi
	echo "SUSPENDED:        $SUSPENDED"
	echo "TIME:             $TIME"
	echo "DATE:             $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "$DOMAIN\t$IP\t$IP6\t$DOCROOT\t$U_DISK\t$U_BANDWIDTH\t$TPL\t"
	echo -ne "$ALIAS\t$STATS\t$STATS_USER\t$SSL\t$SSL_FORCE\t$SSL_HSTS\t$SSL_HOME\t,$LETSENCRYPT"
	echo -ne "$FTP_USER\t$FTP_PATH\t$AUTH_USER\t$BACKEND\t$PROXY\t"
	echo -e "$PROXY_EXT\t$SUSPENDED\t$TIME\t$DATE"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing domain
parse_object_kv_list "$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)"

if [ -n "$CUSTOM_DOCROOT" ]; then
	DOCROOT="$CUSTOM_DOCROOT"
else
	DOCROOT="$HOMEDIR/$user/web/$DOMAIN/public_html/"
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

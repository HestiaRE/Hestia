#!/bin/bash
# info: list web domain error log
# options: USER DOMAIN [LINES] [FORMAT]
#
# example: h-list-web-domain-errorlog admin acme.com
#
# Lists the raw error log of a web domain.

user=$1
domain=$2
ttl=${3-70}
format=${4-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	i=1
	objects=$(echo "$lines" | wc -l)
	echo '['
	for str in $lines; do
		# json_escape, not a sed: a backslash in a log line must not break the JSON.
		json_escape str
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$str"
		else
			printf '\t"%s"\n' "$str"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "$lines"
}

plain_list() {
	echo "$lines"
}

check_args '2' "$#" 'USER DOMAIN [LINES] [FORMAT]'
is_format_valid 'user' 'domain' 'ttl'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

if [ "$ttl" -gt '3000' ]; then
	read_cmd="cat"
else
	read_cmd="tail -n $ttl"
fi

lines=$($read_cmd /var/log/$WEB_SYSTEM/domains/$domain.error.log)
IFS=$'\n'

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

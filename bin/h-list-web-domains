#!/bin/bash
# info: list web domains
# options: USER [FORMAT]
#
# example: h-list-web-domains alice
#
# Lists all web domains of a user.

user=$1
format=${2-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# Rows that carry a DOMAIN key, wherever it stands, each from empty: a blank line repeated the last domain,
# a missing key inherited its value.
rows() {
	grep -E "(^| )DOMAIN='" "$USER_DATA/web.conf"
}

parse_row() {
	DOMAIN='' IP='' IP6='' CUSTOM_DOCROOT='' U_DISK='' U_BANDWIDTH='' TPL='' ALIAS='' STATS='' STATS_USER='' SSL=''
	HTTP3='' DOCKER='' DOCKER_PORT='' DOCKER_OCTET='' LETSENCRYPT='' WP='' FTP_USER='' FTP_PATH='' AUTH_USER=''
	BACKEND='' PHP_VERSION='' PROXY='' PROXY_EXT='' SUSPENDED='' TIME='' DATE=''
	object_row_load "$1"
}

json_list() {
	IFS=$'\n'
	parse_object_kv_rows < <(rows)
	i=1
	objects=$(rows | wc -l)
	echo "{"
	for row in "${!OBJECT_ROWS[@]}"; do
		parse_row "$row"
		if [ -n "$CUSTOM_DOCROOT" ]; then
			DOCROOT="$CUSTOM_DOCROOT"
		else
			DOCROOT="$HOMEDIR/$user/web/$DOMAIN/public_html/"
		fi
		json_escape DOMAIN IP IP6 DOCROOT U_DISK U_BANDWIDTH TPL ALIAS STATS STATS_USER SSL HTTP3 DOCKER DOCKER_PORT DOCKER_OCTET LETSENCRYPT WP FTP_USER FTP_PATH AUTH_USER BACKEND PHP_VERSION PROXY PROXY_EXT SUSPENDED TIME DATE
		printf '    "%s": {\n' "$DOMAIN"
		printf '        "IP": "%s",\n' "$IP"
		printf '        "IP6": "%s",\n' "$IP6"
		printf '        "DOCUMENT_ROOT": "%s",\n' "$DOCROOT"
		printf '        "U_DISK": "%s",\n' "$U_DISK"
		printf '        "U_BANDWIDTH": "%s",\n' "$U_BANDWIDTH"
		printf '        "TPL": "%s",\n' "$TPL"
		printf '        "ALIAS": "%s",\n' "$ALIAS"
		printf '        "STATS": "%s",\n' "$STATS"
		printf '        "STATS_USER": "%s",\n' "$STATS_USER"
		printf '        "SSL": "%s",\n' "$SSL"
		printf '        "HTTP3": "%s",\n' "$HTTP3"
		printf '        "DOCKER": "%s",\n' "$DOCKER"
		printf '        "DOCKER_PORT": "%s",\n' "$DOCKER_PORT"
		printf '        "DOCKER_OCTET": "%s",\n' "$DOCKER_OCTET"
		printf '        "LETSENCRYPT": "%s",\n' "$LETSENCRYPT"
		printf '        "WP": "%s",\n' "$WP"
		printf '        "FTP_USER": "%s",\n' "$FTP_USER"
		printf '        "FTP_PATH": "%s",\n' "$FTP_PATH"
		printf '        "AUTH_USER": "%s",\n' "$AUTH_USER"
		printf '        "BACKEND": "%s",\n' "$BACKEND"
		printf '        "PHP_VERSION": "%s",\n' "$PHP_VERSION"
		printf '        "PROXY": "%s",\n' "$PROXY"
		printf '        "PROXY_EXT": "%s",\n' "$PROXY_EXT"
		printf '        "SUSPENDED": "%s",\n' "$SUSPENDED"
		printf '        "TIME": "%s",\n' "$TIME"
		printf '        "DATE": "%s"\n' "$DATE"
		printf '    }'
		if [ "$i" -lt "$objects" ]; then
			echo ','
		else
			echo
		fi
		((i++))
	done
	echo '}'
}

shell_list() {
	IFS=$'\n'
	parse_object_kv_rows < <(rows)
	echo "DOMAIN   IP   TPL   SSL   DISK   BW   SPND   DATE"
	echo "------   --   ---   ---   ----   --   ----   -----"
	for row in "${!OBJECT_ROWS[@]}"; do
		parse_row "$row"
		echo "$DOMAIN $IP $TPL $SSL $U_DISK $U_BANDWIDTH $SUSPENDED $DATE"
	done
}

plain_list() {
	IFS=$'\n'
	parse_object_kv_rows < <(rows)
	for row in "${!OBJECT_ROWS[@]}"; do
		parse_row "$row"
		if [ ! -z "$CUSTOM_DOCROOT" ]; then
			DOCROOT="$CUSTOM_DOCROOT"
		else
			DOCROOT="$HOMEDIR/$user/web/$DOMAIN/public_html/"
		fi
		echo -ne "$DOMAIN\t$IP\t$IP6\t$DOCROOT\t$U_DISK\t$U_BANDWIDTH\t$TPL\t"
		echo -ne "$ALIAS\t$STATS\t$STATS_USER\t$SSL\t$LETSENCRYPT\t"
		echo -ne "$FTP_USER\t$FTP_PATH\t$AUTH_USER\t$BACKEND\t$PROXY\t"
		echo -e "$PROXY_EXT\t$SUSPENDED\t$TIME\t$DATE"
	done
}

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

unset docroot

exit

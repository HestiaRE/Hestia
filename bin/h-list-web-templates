#!/bin/bash
# info: list web templates
# options: [FORMAT]
#
# example: h-list-web-templates
#
# Lists the web templates a domain can choose.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$(echo "$templates" | wc -w)
	i=1
	echo '['
	for template in $templates; do
		json_escape template
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$template"
		else
			printf '\t"%s"\n' "$template"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "TEMPLATE"
	echo "--------"
	for template in $templates; do
		echo "$template"
	done
}

plain_list() {
	for template in $templates; do
		echo "$template"
	done
}

# A model whose vhost template lives in share/ (apache) offers no choice: the list is empty.
templates=''
if [ -z "$PROXY_SYSTEM" ] && [ -d "$WEBTPL/$WEB_SYSTEM" ]; then
	for tpl_file in "$WEBTPL/$WEB_SYSTEM"/*.tpl; do
		[ -e "$tpl_file" ] || continue
		tpl_name=$(basename "$tpl_file" .tpl)
		templates="${templates:+$templates$'\n'}$tpl_name"
	done
	templates=$(printf '%s\n' "$templates" | sort -V)
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

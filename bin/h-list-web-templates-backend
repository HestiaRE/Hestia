#!/bin/bash
# info: listing backend templates
# options: [FORMAT]
#
# example: h-list-web-templates-backend
#
# Lists the PHP-FPM pool profiles.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	i=1
	objects=$(echo "$templates" | wc -w)
	echo '['
	for template in $templates; do
		json_escape template
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$template"
		else
			printf '\t"%s"\n' "$template"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "TEMPLATE"
	echo "--------"
	for template in $templates; do
		echo "$template"
	done
}

plain_list() {
	for template in $templates; do
		echo "$template"
	done
}

if [ -n "$WEB_BACKEND" ]; then
	templates=$(ls -t $PHPTPL \
		| cut -f1 -d . \
		| grep -v proxy_ip \
		| sort -u)
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

#!/bin/bash
# info: list docker proxy templates
# options: [FORMAT]
#
# example: h-list-web-templates-docker
#
# Lists the templates a docker domain can pick, for this box's front system as the renderer does.

format=${1-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	objects=$(echo "$templates" | wc -w)
	i=1
	echo '['
	for template in $templates; do
		json_escape template
		if [ "$i" -lt "$objects" ]; then
			printf '\t"%s",\n' "$template"
		else
			printf '\t"%s"\n' "$template"
		fi
		((++i))
	done
	echo "]"
}

shell_list() {
	echo "TEMPLATE"
	echo "--------"
	for template in $templates; do
		echo "$template"
	done
}

plain_list() {
	for template in $templates; do
		echo "$template"
	done
}

templates=''
docker_front="${PROXY_SYSTEM:-$WEB_SYSTEM}"
if [ -n "$docker_front" ] && [ -d "$WEBTPL/docker/$docker_front" ]; then
	declare -a tpl_names=()
	for tpl_file in "$WEBTPL/docker/$docker_front"/*.tpl; do
		[ -e "$tpl_file" ] || continue
		tpl_names+=("$(basename "$tpl_file" .tpl)")
	done
	[ ${#tpl_names[@]} -eq 0 ] || templates=$(printf '%s\n' "${tpl_names[@]}" | sort -V)
fi

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

exit

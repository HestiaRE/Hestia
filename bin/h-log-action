#!/bin/bash
# info: adds action event to user or system log
# options: USER LEVEL CATEGORY DETAILS

# Writes one event to the history of USER, or to the system log for USER system. LEVEL is Info, Warning or Error.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

user=$1
event_level=$2
export event_category=$3
event_details=$4

is_common_format_valid "$event_level" "event level"

if [ "$event_level" != "Info" ] && [ "$event_level" != "Warning" ] && [ "$event_level" != "Error" ]; then
	echo "Error: Invalid event type specified."
	exit 1
fi

if [ "$user" = "system" ] || [ "$user" = "System" ]; then
	user="system"
fi

check_args '4' "$#" 'USER LEVEL CATEGORY DETAILS'
if [ "$user" != "system" ]; then
	is_format_valid 'user'
	is_object_valid 'user' 'USER' "$user"
fi

log_history "$event_details" '' "$user"

exit

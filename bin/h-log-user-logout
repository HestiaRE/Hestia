#!/bin/bash
# info: Log User logout event
# options: USER SESSION_ID
# labels: internal
# caller: the panel logout

user=$1
session_id=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER SESSION_ID'
is_format_valid 'user'
is_common_format_valid "$session_id" "Session ID"
is_object_valid 'user' 'USER' "$user"

if [ ! -f "$USER_DATA/auth.log" ]; then
	touch "$USER_DATA/auth.log"
fi

sed -i "s/SESSION='$session_id' ACTIVE='yes'/SESSION='$session_id' ACTIVE='no'/g" "$USER_DATA/auth.log"

exit

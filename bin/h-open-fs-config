#!/bin/bash
# info: open config
# options: CONFIG
# labels: internal
# caller: the panel server config editor
#
# example: h-open-fs-config /etc/mysql/my.cnf
#
# This function opens/reads config files on the file system

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
src_file=$1

# Checking arguments
if [ -z "$src_file" ]; then
	echo "Usage: h-open-fs-config CONFIG"
	exit 1
fi

# Checking root permissions
if [ "$(id -u)" != '0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Checking file on fs
if [ ! -e "$src_file" ]; then
	echo "Error: $src_file file doesn't exist"
	exit 3
fi

# Checking path
if [ -n "$src_file" ]; then
	rpath=$(readlink -f "$src_file")
	services="nginx|apache|httpd|php|ftp|exim|dovecot"
	services="$services|clam|mysql|postgresql|pgsql|cron|ssh|fail2ban|iptables"
	services="$services|my.cnf|hestia"
	spath=$(echo "$rpath" | egrep "$services")
	if [ -z "$spath" ]; then
		echo "Error: invalid source path $src_file"
		exit 2
	fi
	spath=$(echo "$rpath" | egrep "/etc|/var/lib|/var/spool/cron/")
	if [ -z "$spath" ]; then
		echo "Error: invalid source path $src_file"
		exit 2
	fi
fi

# Reading conf
cat "$src_file" 2> /dev/null
if [ $? -ne 0 ]; then
	echo "Error: file $src_file was not opened"
	exit 3
fi

"$HESTIA/bin/h-log-action" "system" "Info" "System" "Configuration file opened (File: $src_file)."

# Exiting
exit

#!/bin/bash
# info: open config
# options: CONFIG [FORMAT]
# labels: internal
# caller: the panel server config editor
#
# example: h-open-fs-config nginx json
#
# Prints a file the server config editor offers. CONFIG is its key (nginx, dovecot-3, php-8.3, see sys_config_path)
# or its path; anything else is refused with rc 2. FORMAT json answers {"path", "content"} for the panel.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

config=$1
format=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CONFIG [FORMAT]'

if [ "$(id -u)" != '0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

case "$format" in '' | plain | json) ;; *) check_result "$E_INVALID" "invalid format $format" ;; esac

# A path counts only as the whole canonical string of an offered file: no prefix, no keyword, no pattern.
if [[ "$config" == /* ]]; then
	sys_config_preload
	if ! path=$(sys_config_offered "$config"); then
		none=''
		for key in $(sys_config_keys); do sys_config_path "$key" > /dev/null || none="$none $key"; done
		echo "Error: $config is not a file the config editor offers${none:+ (no file here for:$none)}"
		exit 2
	fi
else
	path=$(sys_config_path "$config")
	case $? in
		0) ;;
		1)
			echo "Error: $config is not offered by the config editor"
			exit 2
			;;
		*)
			echo "Error: $config has no config file on this server, the component is missing"
			exit 2
			;;
	esac
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -e "$path" ]; then
	# Offered but not yet created (fail2ban's jail.local): empty, the first save makes it.
	[ "$format" != json ] || jq -n --arg path "$path" '{path: $path, content: ""}'
elif [ "$format" = json ]; then
	jq -n --arg path "$path" --rawfile content "$path" '{path: $path, content: $content}' 2> /dev/null
else
	cat -- "$path" 2> /dev/null
fi
if [ $? -ne 0 ]; then
	echo "Error: file $path was not opened"
	exit 3
fi

"$HESTIA/bin/h-log-action" "system" "Info" "System" "Configuration file opened (File: $path)."

exit

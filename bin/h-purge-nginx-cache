#!/bin/bash
# info: Purge nginx cache
# options: USER DOMAIN [RESTART]
#
# example: h-purge-nginx-cache user domain.tld
#
# Purges the FastCGI and proxy cache of a domain.

user=$1
domain=$2
restart=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_object_valid 'web' 'DOMAIN' "$domain" "$FASTCGI_CACHE"

conf=$(grep -F "DOMAIN='$domain'" "$USER_DATA/web.conf")
parse_object_kv_list "$conf"

if [ -d "/var/cache/nginx/micro/$domain" ]; then
	rm -rf /var/cache/nginx/micro/$domain/*
fi

if [ -d "/var/cache/nginx/$domain" ]; then
	rm -rf /var/cache/nginx/$domain/*
fi

if [ "$restart" != "no" ]; then
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null

	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null

fi

$BIN/h-log-action "$user" "Info" "Web" "Cache purged (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

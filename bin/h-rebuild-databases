#!/bin/bash
# info: rebuild databases
# options: USER
#
# example: h-rebuild-databases admin
#
# Recreates all databases of USER and recounts the user's database totals.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"

U_DATABASES=0
SUSPENDED_DB=0
U_DISK_DB=0

for database in $(search_objects 'db' 'SUSPENDED' "*" 'DB'); do

	get_database_values
	# Before the rebuild: connecting reads the host line, whose SUSPENDED overwrites the record's.
	db_suspended="$SUSPENDED"
	U_DISK_DB=$((U_DISK_DB + U_DISK))

	case $TYPE in
		mysql) rebuild_mysql_database ;;
		pgsql) rebuild_pgsql_database ;;
	esac

	U_DATABASES=$((U_DATABASES + 1))
	if [ "$db_suspended" = 'yes' ]; then
		SUSPENDED_DB=$((SUSPENDED_DB + 1))
	fi
done

update_user_value "$user" '$SUSPENDED_DB' "$SUSPENDED_DB"
update_user_value "$user" '$U_DATABASES' "$U_DATABASES"
update_user_value "$user" '$U_DISK_DB' "$U_DISK_DB"

$BIN/h-log-action "system" "Info" "System" "Rebuilt databases (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit

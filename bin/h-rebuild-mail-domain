#!/bin/bash
# info: rebuild mail domain
# options: USER DOMAIN
#
# example: h-rebuild-mail-domain user domain.tld
#
# This function rebuilds configuration files for a single domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=${3-yes}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Define mail user
if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	export MAIL_USER="Debian-exim"
else
	export MAIL_USER="exim"
fi

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
check_user=$(is_object_unsuspended 'user' 'USER' "$user")
if [ -n "$check_user" ]; then
	exit
fi
is_object_valid 'mail' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Rebuild mail domain configuration
rebuild_mail_domain_conf

# Rebuild webmail configuration. 'mail', not 'web': the WEBMAIL key lives on the mail record -
# reading the web object always returned '' and made this whole block dead code. Skipped while
# suspended (add would refuse with E_SUSPENDED); unsuspend re-renders from the record instead.
# front-based (#193): a mailfront box has an empty WEB_SYSTEM but still renders webmail
if [ -n "$(webmail_front)" ] || [ -n "$PROXY_SYSTEM" ]; then
	if [ -n "$IMAP_SYSTEM" ] && [ "$(get_object_value 'mail' 'DOMAIN' "$domain" '$SUSPENDED')" != 'yes' ]; then
		WEBMAIL=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
		if [ -n "$WEBMAIL" ]; then
			$BIN/h-delete-mail-domain-webmail "$user" "$domain" "$restart" 'yes'
			$BIN/h-add-mail-domain-webmail "$user" "$domain" "$WEBMAIL" "$restart" 'yes'
		fi
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Update disk usage statistics
$BIN/h-update-user-disk "$user"
$BIN/h-update-user-counters "$user"

# Logging
$BIN/h-log-action "system" "Info" "System" "Rebuilt mail domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: rebuild mail domains
# options: USER
#
# example: h-rebuild-mail-domains admin
#
# This function rebuilds EXIM configuration files for all mail domains.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

# Define mail user
if [ "$MAIL_SYSTEM" = 'exim4' ]; then
	export MAIL_USER="Debian-exim"
else
	export MAIL_USER="exim"
fi

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
check_user=$(is_object_unsuspended 'user' 'USER' "$user")
if [ -n "$check_user" ]; then
	exit
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Starting loop. Each domain is its own process, so one that fails does not take the loop with it -
# but its exit status used to be dropped here, and the run reported success while a domain had not
# been rebuilt at all (a DKIM record whose key is gone is how a live box drifts into that). Every
# domain is still attempted; the run just stops claiming to have succeeded.
rebuild_failed=''
for domain in $(search_objects 'mail' 'SUSPENDED' "*" 'DOMAIN'); do
	if ! $BIN/h-rebuild-mail-domain "$user" "$domain" "no"; then
		rebuild_failed="$rebuild_failed $domain"
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/h-log-action "system" "Info" "System" "Rebuilt mail domains (User: $user)."

if [ -n "$rebuild_failed" ]; then
	check_result "$E_PARSING" "mail domains not rebuilt for $user:$rebuild_failed"
fi

log_event "$OK" "$ARGUMENTS"

exit

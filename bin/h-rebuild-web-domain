#!/bin/bash
# info: rebuild web domain
# options: USER DOMAIN [RESTART]
#
# example: h-rebuild-web-domain user domain.tld
#
# This function rebuilds web configuration files.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=$3

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
check_user=$(is_object_unsuspended 'user' 'USER' "$user")
if [ -n "$check_user" ]; then
	exit
fi
is_object_valid 'web' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Deleting old web configs
if [ -e "/etc/$WEB_SYSTEM/conf.d/hestia.conf" ]; then
	sed -i "/.*\/$user\/conf\/web\//d" /etc/$WEB_SYSTEM/conf.d/hestia.conf
fi

if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf" ]; then
	rm -f $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf
	conf_link_drop "/etc/$WEB_SYSTEM/conf.d/domains/$domain.conf" "$user"
fi
if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf" ]; then
	rm $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf
	conf_link_drop "/etc/$WEB_SYSTEM/conf.d/domains/$domain.ssl.conf" "$user"
fi

# Deleting old proxy configs
if [ -n "$PROXY_SYSTEM" ]; then
	if [ -e "/etc/$PROXY_SYSTEM/conf.d/hestia.conf" ]; then
		sed -i "/.*\/$user\/conf\/web\//d" /etc/$PROXY_SYSTEM/conf.d/hestia.conf
	fi

	if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf" ]; then
		rm -f $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf
		conf_link_drop "/etc/$PROXY_SYSTEM/conf.d/domains/$domain.conf" "$user"
	fi

	if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf" ]; then
		rm -f $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf
		conf_link_drop "/etc/$PROXY_SYSTEM/conf.d/domains/$domain.ssl.conf" "$user"
	fi
fi

# Deleting backend configs
if [ -n "$WEB_BACKEND" ]; then
	template=$(get_object_value 'web' 'DOMAIN' "$domain" '$BACKEND')
	if [ -z "$template" ]; then
		template="default"
		update_object_value 'web' 'DOMAIN' "$domain" '$BACKEND' 'default'
	fi
	prepare_web_backend
	delete_web_backend
	$BIN/h-add-web-domain-backend $user $domain $template $restart
fi

rebuild_web_domain_conf

# Balance line, not exit code (see h-rebuild-web-domains)
if [ "${web_config_skipped:-0}" -gt 0 ]; then
	echo "Warning: $web_config_skipped vhost config(s) skipped over an unusable record (see errors above)."
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating user counters
$BIN/h-update-user-counters "$user"

# Restarting web server
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging
$BIN/h-log-action "system" "Info" "System" "Rebuilt web domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

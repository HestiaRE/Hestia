#!/bin/bash
# info: rebuild web domains
# options: USER [RESTART]
#
# example: h-rebuild-web-domains
#
# Renders the vhost, proxy and backend configuration of all web domains of a user from their records.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"
web_lock_acquire || exit 1

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
check_user=$(is_object_unsuspended 'user' 'USER' "$user")
if [ -n "$check_user" ]; then
	exit
fi

if [ -e "/etc/$WEB_SYSTEM/conf.d/hestia.conf" ]; then
	sed -i "/.*\/$user\/conf\/web\//d" /etc/$WEB_SYSTEM/conf.d/hestia.conf
fi

if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf" ]; then
	rm -f $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.conf
	rm -f /etc/$WEB_SYSTEM/conf.d/domains/$domain.conf
fi
if [ -e "$HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf" ]; then
	rm $HOMEDIR/$user/conf/web/$domain/$WEB_SYSTEM.ssl.conf
	rm -f /etc/$WEB_SYSTEM/conf.d/domains/$domain.ssl.conf
fi

if [ -n "$PROXY_SYSTEM" ]; then
	if [ -e "/etc/$PROXY_SYSTEM/conf.d/hestia.conf" ]; then
		sed -i "/.*\/$user\/conf\/web\//d" /etc/$PROXY_SYSTEM/conf.d/hestia.conf
	fi

	if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf" ]; then
		rm -f $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.conf
		rm -f /etc/$PROXY_SYSTEM/conf.d/domains/$domain.conf
	fi

	if [ -e "$HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf" ]; then
		rm -f $HOMEDIR/$user/conf/web/$domain/$PROXY_SYSTEM.ssl.conf
		rm -f /etc/$PROXY_SYSTEM/conf.d/domains/$domain.ssl.conf
	fi
fi

# Through h-list-sys-php, which skips the panel pool: a bare /etc/php/* glob seeds a www-data pool into it.
for v_php in $($BIN/h-list-sys-php plain); do
	[ -d "/etc/php/${v_php}/fpm/pool.d/" ] || continue
	if [ ! -f "/etc/php/${v_php}/fpm/pool.d/dummy.conf" ]; then
		cp -f "$HESTIA/share/php-fpm/dummy.conf" "/etc/php/${v_php}/fpm/pool.d/"
		sed -i "s/%backend_version%/${v_php}/g" "/etc/php/${v_php}/fpm/pool.d/dummy.conf"
	fi
done

# A record without PHP_VERSION gets the version its pool runs, and its BACKEND the plain pool profile;
# before the pools below are deleted and rebuilt.
if [ -n "$WEB_BACKEND" ]; then
	for domain in $($BIN/h-list-web-domains $user plain | cut -f 1); do
		[ -n "$(get_object_value 'web' 'DOMAIN' "$domain" '$PHP_VERSION')" ] && continue
		derived=$(web_domain_pool_version "$domain" "$user")
		[ -z "$derived" ] && derived=$(multiphp_default_version)
		add_object_key 'web' 'DOMAIN' "$domain" 'PHP_VERSION' 'BACKEND'
		case "$(get_object_value 'web' 'DOMAIN' "$domain" '$BACKEND')" in
			no-php) derived='none' ;;&
			no-php | *PHP-[0-9]*_[0-9]*) update_object_value 'web' 'DOMAIN' "$domain" '$BACKEND' 'default' ;;
		esac
		update_object_value 'web' 'DOMAIN' "$domain" '$PHP_VERSION' "$derived"
	done
fi

if [ -n "$WEB_BACKEND" ]; then
	for domain in $($BIN/h-list-web-domains $user plain | cut -f 1); do
		get_domain_values 'web'
		prepare_web_backend
		delete_web_backend
	done
fi

for domain in $($BIN/h-list-web-domains $user plain | cut -f 1); do
	if [ -n "$WEB_BACKEND" ]; then
		template=$(get_object_value 'web' 'DOMAIN' "$domain" '$BACKEND')
		if [ -z "$template" ]; then
			template="default"
			update_object_value 'web' 'DOMAIN' "$domain" '$BACKEND' 'default'
		fi
		$BIN/h-add-web-domain-backend "$user" "$domain" "$template" "$restart"
	fi
	rebuild_web_domain_conf
done

# Balance line, not exit code: web-model.sh treats a nonzero rebuild as switch failure, and one broken
# record must not veto a model switch.
if [ "${web_config_skipped:-0}" -gt 0 ]; then
	echo "Warning: $web_config_skipped vhost config(s) skipped over an unusable record (see errors above)."
fi

$BIN/h-update-user-counters "$user"

if [ "$restart" = "yes" ]; then
	$BIN/h-restart-web "$restart"
	check_result $? "Web restart failed" > /dev/null

	$BIN/h-restart-proxy "$restart"
	check_result $? "Proxy restart failed" > /dev/null
fi

$BIN/h-log-action "system" "Info" "System" "Rebuilt web domains (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit

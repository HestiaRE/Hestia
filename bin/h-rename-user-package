#!/bin/bash
# info: change package name
# options: OLD_NAME NEW_NAME [mode]
#
# example: h-rename-user-package package package2
#
# Renames a package and repoints its users; default and system keep their names.

old_name=$1
new_name=$2
mode=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ -z "$old_name" ]; then
	echo "ERROR: Current package name not specified."
	exit "$E_ARGS"
fi
if [ -z "$new_name" ]; then
	echo "ERROR: New package name not specified."
	exit "$E_ARGS"
fi

is_object_format_valid "$old_name" "Package"
is_package_valid "$old_name"
is_package_builtin "$old_name" renamed
is_object_format_valid "$new_name" "New package"
pkg_dir="$CONF_DIR/packages"
if [ -e "$pkg_dir/$new_name.pkg" ]; then
	check_result "$E_NOTEXIST" "package $new_name exist"
fi

mv "$pkg_dir/$old_name.pkg" "$pkg_dir/$new_name.pkg"
# A trigger the new name already had belongs to a package that is gone.
rm -f "$pkg_dir/$new_name.sh"
if [ -e "$pkg_dir/$old_name.sh" ]; then
	mv "$pkg_dir/$old_name.sh" "$pkg_dir/$new_name.sh"
fi

# Only the name changes, so only the name is rewritten: a limit check here could strand a user on
# a package that no longer exists.
failed=''
for pkg_user in $(package_users "$old_name"); do
	update_user_value "$pkg_user" '$PACKAGE' "$new_name" || failed="$failed $pkg_user"
done
[ -z "$failed" ] || check_result "$E_UPDATE" "package renamed, but these users still name $old_name:$failed"
if [ "$mode" = "yes" ]; then
	echo "Successfully renamed package $old_name to $new_name."
fi

$BIN/h-log-action "system" "Info" "System" "Package renamed (Value: $new_name, Previous: $old_name)."
log_event "$OK" "$ARGUMENTS"

exit

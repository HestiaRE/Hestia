#!/bin/bash
# info: repair system configuration
# options: MODE
#
# example: h-repair-sys-config repair
#
# Adds missing keys to hestia.conf with their defaults and repairs the system cron entries.

mode=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# Both repair functions live here; main.sh does not pull it in.
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh

check_args '1' "$#" 'MODE'

case "$mode" in
	repair)
		source_conf "$HESTIA/conf/hestia.conf"
		# Both repairs run, then the count decides: a failed crontab must not hide behind a green config.
		repair_failed=0
		syshealth_repair_system_config || repair_failed=$((repair_failed + syshealth_repair_failed))
		# Its own repair: a gone crontab stops every queue, a gone cron.d entry stops this repair, and nothing else notices.
		syshealth_repair_system_cron || repair_failed=$((repair_failed + 1))
		if [ "$repair_failed" -ne 0 ]; then
			check_result "$E_UPDATE" "$repair_failed config repair(s) failed - see the lines above"
		fi
		;;
	*)
		check_result "$E_INVALID" "unknown mode '$mode', expected: repair"
		;;
esac

$BIN/h-log-action "system" "Info" "System" "Executed $mode operation on system configuration."
log_event "$OK" "$ARGUMENTS"

#!/bin/bash
# info: repair system configuration
# options: MODE
#
# example: h-repair-sys-config repair
#
# Adds missing keys to hestia.conf with their defaults. The former `restore` mode copied a
# conf/defaults/hestia.conf that nothing ever wrote, so it aborted on every box (#930).

mode=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# Both functions below live here and main.sh does not pull it in. Without this the command answered
# "syshealth_repair_system_config: command not found" and then logged the repair as executed - the
# only caller of these functions that was missing the line every other one has.
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh

#----------------------------------------------------------#
#                        Action                            #
#----------------------------------------------------------#

case "$mode" in
	repair)
		# load config file
		source_conf "$HESTIA/conf/hestia.conf"
		# The count is the verdict: a failed sub-command must not end in "Executed repair" (#929).
		if ! syshealth_repair_system_config; then
			check_result "$E_UPDATE" "$syshealth_repair_failed config repair(s) failed - see the lines above"
		fi
		;;
	*)
		# Anything else did nothing and still logged "Executed  operation on system configuration".
		check_result "$E_INVALID" "unknown mode '$mode', expected: repair"
		;;
esac

#----------------------------------------------------------#
#                        Hestia                            #
#----------------------------------------------------------#

$BIN/h-log-action "system" "Info" "System" "Executed $mode operation on system configuration."
log_event "$OK" "$ARGUMENTS"

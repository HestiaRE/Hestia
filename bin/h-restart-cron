#!/bin/bash
# info: restart cron service
# options: [RESTART]
#
# example: h-restart-cron
#
# RESTART: yes restarts cron now, scheduled queues it, no does nothing; empty follows SCHEDULED_RESTART.

restart=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

send_email_report() {
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf")
	email=$(echo "$email" | cut -f 2 -d "'")
	tmpfile=$(mktemp)
	subj="$(hostname): $CRON_SYSTEM restart failed"
	systemctl status "$CRON_SYSTEM" >> $tmpfile 2>&1
	service "$CRON_SYSTEM" restart >> $tmpfile 2>&1
	cat $tmpfile | $SENDMAIL -s "$subj" $email
	rm -f $tmpfile
}

is_format_valid 'restart'

if [ -z "$CRON_SYSTEM" ]; then
	exit
fi

if [ "$1" = 'scheduled' ] || [ -z "$1" ] && [ "$SCHEDULED_RESTART" = 'yes' ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT now" >> $CONF_DIR/queue/restart.pipe
	exit
fi

if [ "$1" = "no" ] || [ -z "$1" ]; then
	exit
fi

$BIN/h-restart-service $CRON_SYSTEM > /dev/null 2>&1
if [ $? -ne 0 ]; then
	send_email_report
	check_result "$E_RESTART" "$CRON_SYSTEM restart failed"
fi

if [ -e "$CONF_DIR/queue/restart.pipe" ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
fi

exit

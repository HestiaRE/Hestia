#!/bin/bash
# info: restart mail service
# options: [RESTART]
#
# example: h-restart-mail
#
# Reloads dovecot and exim; RESTART no skips, scheduled queues it under SCHEDULED_RESTART.

# Assigned before the format check, which would otherwise validate an unset variable.
restart=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

send_email_report() {
	local mail_service="$1"
	journalctl --no-pager --reverse --since=-1m --unit "$mail_service" >> "$tmpfile" 2>&1
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf")
	email=$(echo "$email" | cut -f 2 -d "'")
	subj="$(hostname): $mail_service restart failed"
	cat "$tmpfile" | $SENDMAIL -s "$subj" $email
	[[ -f "$tmpfile" ]] && rm -f $tmpfile
}

is_format_valid 'restart'

if [ -z "$MAIL_SYSTEM" ]; then
	exit
fi

if [ "$1" = "no" ]; then
	exit
fi

if [ "$1" = 'scheduled' ] || [ -z "$1" ] && [ "$SCHEDULED_RESTART" = 'yes' ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT now" >> $CONF_DIR/queue/restart.pipe
	exit
fi

tmpfile=$(mktemp)
if [ -n "$IMAP_SYSTEM" ]; then
	$BIN/h-restart-service "$IMAP_SYSTEM" "$1" >> $tmpfile 2>&1
	if [ $? -ne 0 ]; then
		send_email_report "$IMAP_SYSTEM"
		check_result "$E_RESTART" "$IMAP_SYSTEM restart failed"
	fi
fi

$BIN/h-restart-service "$MAIL_SYSTEM" "$1" >> $tmpfile 2>&1
if [ $? -ne 0 ]; then
	send_email_report "$MAIL_SYSTEM"
	check_result "$E_RESTART" "$MAIL_SYSTEM restart failed"
fi

if [ -e "$CONF_DIR/queue/restart.pipe" ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
fi

[[ -f "$tmpfile" ]] && rm -f $tmpfile
exit

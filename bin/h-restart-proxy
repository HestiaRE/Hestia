#!/bin/bash
# info: restart proxy server
# options: [RESTART]
#
# example: h-restart-proxy
#
# Reloads the nginx in front of apache2; RESTART no skips, updatessl queues it, scheduled too under SCHEDULED_RESTART.

# Assigned before the format check, which would otherwise validate an unset variable.
restart=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

date=$(date +"%Y-%m-%d %H:%M:%S")

send_email_report() {
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf")
	email=$(echo "$email" | cut -f 2 -d "'")
	tmpfile=$(mktemp)
	subj="$(hostname): $PROXY_SYSTEM restart failed"
	nginx -t >> $tmpfile 2>&1

	if [ "$1" == "DO_RESTART" ]; then
		service "$PROXY_SYSTEM" restart >> $tmpfile 2>&1
	fi
	cat "$tmpfile" | $SENDMAIL -s "$subj" "$email"
	if [ "$DEBUG_MODE" = "true" ]; then
		echo "[ $date | $PROXY_SYSTEM | PROXY ]" >> /var/log/hestia/debug.log 2>&1
		cat "$tmpfile" >> /var/log/hestia/debug.log 2>&1
	fi
	rm -f $tmpfile
}

is_format_valid 'restart'

# A web-model switch restarts on its own; a reload under its lock would load a half-flipped config.
if web_freeze_held; then exit 0; fi

if [ -z "$PROXY_SYSTEM" ]; then
	exit
fi

if [ "$1" = "no" ]; then
	exit
fi

if [ "$1" = 'scheduled' ] || [ -z "$1" ] && [ "$SCHEDULED_RESTART" = 'yes' ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT now" >> $CONF_DIR/queue/restart.pipe
	exit
fi

if [ "$1" = "updatessl" ]; then
	sed -i "/\/$SCRIPT ssl/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT ssl" >> $CONF_DIR/queue/restart.pipe
	exit
fi

# A reload of a broken config succeeds and keeps the old one, so test first.
if [ "$DEBUG_MODE" = "true" ]; then
	echo "[ $date | $PROXY_SYSTEM ]" >> /var/log/hestia/debug.log 2>&1
	service $PROXY_SYSTEM configtest >> /var/log/hestia/debug.log 2>&1
else
	service $PROXY_SYSTEM configtest > /dev/null 2>&1
fi
if [ $? -ne 0 ]; then
	send_email_report
	check_result "$E_RESTART" "$PROXY_SYSTEM restart failed"
fi

if [ "$1" = "ssl" ]; then
	restart="ssl"
fi
$BIN/h-restart-service "$PROXY_SYSTEM" "$restart" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	send_email_report "DO_RESTART"
	check_result "$E_RESTART" "$PROXY_SYSTEM restart failed"
fi

if [ -e "$CONF_DIR/queue/restart.pipe" ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	sed -i "/\/$SCRIPT ssl/d" $CONF_DIR/queue/restart.pipe
fi

exit

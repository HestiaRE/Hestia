#!/bin/bash
# info: restart service
# options: SERVICE [RESTART]
#
# example: h-restart-service apache2
#
# This function restarts system service.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
service=$1
restart=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'SERVICE [RESTART]'
is_format_valid 'service' 'restart'

# Defer ONLY web/proxy restarts while a web-model switch holds the freeze (#120) -
# FM and others reload through here, bypassing h-restart-web; non-web services (mail,
# firewall, db) must not be affected by a web-model switch.
if web_freeze_held && { [ "$service" = "nginx" ] || [ "$service" = "apache2" ]; }; then
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

log="/dev/null"
if [ "$DEBUG_MODE" = "true" ]; then

	log="/var/log/hestia/debug.log"
fi

# Multi-instance service restart request handling
if [ "$service" = "php-fpm" ]; then
	service_list=''
	# Get installed php versions
	php_versions=$($BIN/h-list-sys-php plain)
	# Substitute php-fpm service name formats
	for version in $php_versions; do
		service_list="${service_list} php${version}-fpm"
	done
elif [ "$service" = "hestia" ]; then
	# "hestia" is the legacy single-service name from the hestia-nginx era; the
	# HestiaRE panel is Caddy (webserver, :8083) + hestia-php (FPM). There is no
	# hestia.service, so map it to the real pair (callers: h-change-sys-port,
	# h-update-host-certificate).
	service_list="caddy hestia-php"
else
	service_list="$service"
fi

for service in $service_list; do
	# The firewall is not a systemd unit for us - it is our own ruleset, and the service NAME follows
	# FIREWALL_SYSTEM. Matching a hardcoded "iptables" here broke the moment that value became
	# "nftables": the panel's firewall row fell through to systemctl and restarted the DISTRO
	# nftables unit, which tore our table down and loaded /etc/nftables.conf instead.
	if [ -n "$FIREWALL_SYSTEM" ] && [ "$service" = "$FIREWALL_SYSTEM" ]; then
		# No stop first: the render swaps the table atomically, and a stop before a failed render left the box open.
		$BIN/h-update-firewall
	elif [ "$restart" = "ssl" ] && [ "$service" = "nginx" ]; then
		service $service upgrade >> $log 2>&1
	elif [ -z "$restart" -o "$restart" = "no" ] && [ \
		"$service" = "nginx" -o \
		"$service" = "apache2" -o \
		"$service" = "exim4" -o \
		"$service" = "dovecot" -o \
		"$service" = "php5.6-fpm" -o \
		"$service" = "php7.0-fpm" -o \
		"$service" = "php7.1-fpm" -o \
		"$service" = "php7.2-fpm" -o \
		"$service" = "php7.3-fpm" -o \
		"$service" = "php7.4-fpm" -o \
		"$service" = "php8.0-fpm" -o \
		"$service" = "php8.1-fpm" -o \
		"$service" = "php8.2-fpm" -o \
		"$service" = "php8.3-fpm" -o \
		"$service" = "php8.4-fpm" -o \
		"$service" = "php8.5-fpm" -o \
		"$service" = "proftpd" -o \
		"$service" = "ssh" -o \
		"$service" = "fail2ban" ]; then
		systemctl reload-or-restart "$service" >> $log 2>&1
	else
		systemctl reset-failed "$service" >> $log 2>&1
		systemctl restart "$service" >> $log 2>&1
	fi

	# Check the result of the service restart and report whether it failed.
	if [ $? -ne 0 ]; then
		check_result "$E_RESTART" "ERROR: Restart of $service failed."
		$BIN/h-log-action "system" "Error" "System" "Service failed to restart (Name: $service)."
	else
		$BIN/h-log-action "system" "Info" "System" "Service restarted (Name: $service)."
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

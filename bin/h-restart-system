#!/bin/bash
# info: restart operating system
# options: RESTART [DELAY]
#
# example: h-restart-system yes
#
# Reboots the server, after DELAY seconds when given.

restart=$1
delay=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'RESTART [DELAY]'
is_format_valid 'restart'
# No -n guard: is_format_valid skips an empty value itself.
is_format_valid 'delay'

if [ "$restart" = 'yes' ]; then
	$BIN/h-log-action "system" "Warning" "System" "System restart initiated."
	if [ "$delay" ]; then
		echo "The server will restart in $delay seconds..."
		sleep "$delay"
	fi
	/sbin/reboot
fi

exit

#!/bin/bash
# info: restart web server
# options: [RESTART]
#
# example: h-restart-web
#
# This function reloads web server configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Assigned here, not further down: the verification block below validates it, and validating a variable
# that is not set yet checks nothing at all.
restart=$1

date=$(date +"%Y-%m-%d %H:%M:%S")

send_email_report() {
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf")
	email=$(echo "$email" | cut -f 2 -d "'")
	tmpfile=$(mktemp)
	subj="$(hostname): $WEB_SYSTEM restart failed"
	if [ "$WEB_SYSTEM" = "apache2" ]; then
		apache2ctl configtest >> "$tmpfile" 2>&1
	else
		service $WEB_SYSTEM configtest >> "$tmpfile" 2>&1
	fi
	if [ "$1" == "DO_RESTART" ]; then
		service "$WEB_SYSTEM" restart >> "$tmpfile" 2>&1
	fi
	cat "$tmpfile" | $SENDMAIL -s "$subj" "$email"
	if [ "$DEBUG_MODE" = "true" ]; then
		echo "[ $date | $WEB_SYSTEM | WEB ]" >> /var/log/hestia/debug.log 2>&1
		cat $tmpfile >> /var/log/hestia/debug.log 2>&1
	fi
	rm -f $tmpfile
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_format_valid 'restart'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defer while a web-model switch holds the freeze (#120): it does its own controlled
# restart as the lock owner; an outside reload here would load a half-flipped config.
if web_freeze_held; then exit 0; fi

# mailfront: no customer web, but the webmail front still needs its reload
# cycle - reuse the whole body with the front as the effective system (#193).
# Safe ONLY because WEB_SYSTEM is not exported here and every child command
# re-reads hestia.conf itself; an export would forward the lie to all of them.
[ -z "$WEB_SYSTEM" ] && WEB_SYSTEM=$(webmail_front)

# Exit
if [ -z "$WEB_SYSTEM" ]; then
	exit
fi

if [ "$1" = "no" ]; then
	exit
fi

# Schedule restart
if [ "$1" = 'scheduled' ] || [ -z "$1" ] && [ "$SCHEDULED_RESTART" = 'yes' ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT now" >> $CONF_DIR/queue/restart.pipe
	exit
fi

if [ "$1" = "updatessl" ]; then
	sed -i "/\/$SCRIPT ssl/d" $CONF_DIR/queue/restart.pipe
	echo "$BIN/$SCRIPT ssl" >> $CONF_DIR/queue/restart.pipe
	exit
fi

if [ $WEB_SYSTEM = 'nginx' ]; then
	if [ "$1" = "ssl" ]; then
		restart="ssl"
	fi
	if [ "$DEBUG_MODE" = "true" ]; then
		echo "[  $date | $WEB_SYSTEM | WEB ]" >> /var/log/hestia/debug.log 2>&1
		service $WEB_SYSTEM configtest >> /var/log/hestia/debug.log 2>&1
	else
		service $WEB_SYSTEM configtest > /dev/null 2>&1
	fi
	if [ $? -ne 0 ]; then
		send_email_report
		check_result "$E_RESTART" "$WEB_SYSTEM restart failed"
	fi
elif [ $WEB_SYSTEM = 'apache2' ]; then
	if [ "$DEBUG_MODE" = "true" ]; then
		echo "[  $date | $WEB_SYSTEM | WEB ]" >> /var/log/hestia/debug.log 2>&1
		apache2ctl configtest >> /var/log/hestia/debug.log 2>&1
	else
		apache2ctl configtest > /dev/null 2>&1
	fi
	if [ $? -ne 0 ]; then
		send_email_report
		check_result "$E_RESTART" "$WEB_SYSTEM restart failed"
	fi
fi

$BIN/h-restart-service "$WEB_SYSTEM" "$restart"

if [ $? -ne 0 ]; then
	send_email_report "DO_RESTART"
	check_result "$E_RESTART" "$WEB_SYSTEM restart failed"
fi

# Update restart queue
if [ -e "$CONF_DIR/queue/restart.pipe" ]; then
	sed -i "/\/$SCRIPT now/d" $CONF_DIR/queue/restart.pipe
	sed -i "/\/$SCRIPT ssl/d" $CONF_DIR/queue/restart.pipe
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

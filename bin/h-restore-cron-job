#!/bin/bash
# info: restore single cron job
# options: USER BACKUP CRON [NOTIFY]
#
# example: h-restore-cron-job USER BACKUP CRON [NOTIFY]
#
# Restores cron jobs from a backup archive through h-restore-user.

user=$1
backup=$2
cronjob=$3
notify=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER BACKUP CRON [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'backup'

$BIN/h-restore-user "$user" "$backup" 'no' 'no' 'no' 'no' "$cronjob" 'no' "$notify"

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: restore the cron jobs of a backup archive
# options: USER BACKUP CRON [NOTIFY]
#
# example: h-restore-cron-job admin admin.2026-10-08_05-10-01.tar yes
#
# Through h-restore-user. CRON is a switch, not a job id: anything but no replaces the whole job list.

user=$1
backup=$2
cronjob=$3
notify=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER BACKUP CRON [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'backup'

$BIN/h-restore-user "$user" "$backup" 'no' 'no' 'no' 'no' "$cronjob" 'no' "$notify"
# The inner run has already said why; passed on so the caller sees the failure.
check_result $? "restore of $backup failed" > /dev/null

log_event "$OK" "$ARGUMENTS"

exit

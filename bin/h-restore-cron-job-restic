#!/bin/bash
# info: restore cron jobs from a restic snapshot
# options: USER SNAPSHOT [NOTIFY]
#
# example: h-restore-cron-job-restic user snapshot
#
# Replaces the user's cron jobs with the ones in a restic snapshot.

user=$1
snapshot=$2
notify=${3-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER SNAPSHOT [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

is_restic_repo_configured

tmpdir=$(mktemp -p /home/$user/tmp/ -d)
trap 'rm -rf "$tmpdir"' EXIT

meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
# Judge the read, not the size: an empty cron.conf is the valid record of a user without jobs.
if ! restic_meta_cat "$meta_pkg" cron/cron.conf > "$tmpdir/cron.conf"; then
	check_result "$E_PARSING" "$meta_pkg has no readable cron/cron.conf"
fi

cp "$tmpdir/cron.conf" "$USER_DATA/cron.conf"

sync_cron_jobs

$BIN/h-restart-cron
check_result $? "CRON restart failed"

rm -fr "$tmpdir"

$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-cron-job-restic '$user' '$snapshot'/d" $CONF_DIR/queue/backup.pipe

$BIN/h-log-action "system" "Info" "Backup" "Cron jobs successfully restored (User: $user, Snapshot: $snapshot)."
$BIN/h-log-action "$user" "Info" "Backup" "Cron jobs  successfully restored (User: $user, Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit

#!/bin/bash
# info: restore Database
# options: USER SNAPSHOT DATABASE [NOTIFY]
#
# example: h-restore-database-restic user snapshot user_database
# example: h-restore-database-restic user snapshot 'user_database,user_database2'
# example: h-restore-database-restic user snapshot '*'
#
# Restores databases from the raw dumps of a restic snapshot.

user=$1
snapshot=$2
database=$3
notify=${4-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER SNAPSHOT DATABASE [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

is_restic_repo_configured

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT

# The metadata is the package beside the repository, not part of the snapshot.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
restic_meta_cat "$meta_pkg" backup.conf > "$tmpdir/backup.conf"
if [ ! -s "$tmpdir/backup.conf" ]; then
	check_result "$E_PARSING" "$meta_pkg carries no backup.conf - the snapshot cannot be described"
fi

parse_object_kv_list "$(cat "$tmpdir/backup.conf")"

# IFS is restored right after the splits, so the loop iterates the arrays instead of a word-split $DB.
OLD_IFS="$IFS"
IFS=','
read -r -a databases_array <<< "$database"
read -r -a databases <<< "$DB"
IFS="$OLD_IFS"
requested=",$(
	IFS=','
	echo "${databases_array[*]}"
),"

for db in "${databases[@]}"; do
	if [[ "$database" = '*' || "$requested" == *",${db},"* ]]; then
		check_config=$(grep -F "DB='$db'" $USER_DATA/db.conf)
		if [ -z "$check_config" ]; then
			restic_meta_cat "$meta_pkg" "db/$db/hestia/db.conf" > "$tmpdir/db.conf"
			if [ ! -s "$tmpdir/db.conf" ]; then
				check_result "$E_PARSING" "$meta_pkg carries no record for database $db"
			fi
			# The archived line is the record and only the named fields move: a hand-built list drops unknown keys.
			archived_record=$(head -n1 "$tmpdir/db.conf")
			if ! record_line_valid "$archived_record"; then
				check_result "$E_PARSING" "$db db record is not a KEY='VALUE' line - refusing to restore it"
			fi
			restore_parse_record prev_db_keys "$archived_record"
			# Clearing it below would drop another customer's live database of the same name.
			db_names_free "$db" "$DBUSER" "$TYPE" "$user" \
				|| check_result "$E_EXISTS" "database $db belongs to another customer - refusing to restore it"
			# @todo add support for renaming user
			str="$archived_record"
			record_set_field str SUSPENDED 'no'
			record_set_field str TIME "$(date +%T)"
			record_set_field str DATE "$(date +%F)"
			restored_keys=" $(record_keys "$str" | tr '\n' ' ') "
			for _k in $(record_keys "$archived_record"); do
				case "$restored_keys" in
					*" $_k "*) : ;;
					*) echo "Warning!: $db db record lost key $_k during restore" ;;
				esac
			done
			record_zero_counters str U_DISK
			echo "$str" >> $USER_DATA/db.conf
			dbhost_count_record "$TYPE" "$HOST"
		else
			parse_object_kv_list "$(grep -F "DB='$db'" $USER_DATA/db.conf)"
		fi

		restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" dump "$snapshot" \
			"$(restic_dump_dir "$user")/$db.$TYPE.sql" > "$tmpdir/$db.$TYPE.sql"
		if [ "$?" -ne 0 ] || [ ! -s "$tmpdir/$db.$TYPE.sql" ]; then
			check_result "$E_NOTEXIST" "snapshot $snapshot carries no dump for $db"
		fi

		echo "- Restore database: $db (Type: $TYPE)"
		database_dump="$tmpdir/$db.$TYPE.sql"
		# $db, not $database: the argument may be a comma list.
		import_rc=0
		case $TYPE in
			mysql)
				delete_mysql_database "$db"
				rebuild_mysql_database
				import_mysql_database $database_dump || import_rc=$?
				;;
			pgsql)
				delete_pgsql_database "$db"
				rebuild_pgsql_database
				import_pgsql_database $database_dump || import_rc=$?
				;;
		esac
		# The client's output goes to /dev/null, so its exit code is the only signal. Aborts instead of collecting
		# failures like h-restore-user: a missing dump already aborts, one policy per command.
		[ "$import_rc" -eq 0 ] || check_result "$E_DB" \
			"the dump for $db was rejected (client exit $import_rc) - $db is empty, anything after it in the list was not restored"
	fi
done

rm -fr $tmpdir
$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-database-restic '$user' '$snapshot' '$database' /d" $CONF_DIR/queue/backup.pipe

$BIN/h-log-action "system" "Info" "Backup" "Database successfully restored (User: $user, Snapshot: $snapshot, Database: $database)."
$BIN/h-log-action "$user" "Info" "Backup" "Database successfully restored (User: $user, Snapshot: $snapshot, Database: $database)."
log_event "$OK" "$ARGUMENTS"
exit

#!/bin/bash
# info: restore a file or folder from a restic snapshot
# options: USER SNAPSHOT PATH [NOTIFY]
#
# example: h-restore-file-restic user latest /home/user/web/example.com
#
# Restores one path out of a snapshot, bounded to the customer's home.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
file=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT PATH [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

is_restic_repo_configured

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The command restores as root: a path outside the customer's home would write anywhere. A prefix
# test is text, and /home/alfa/../bravo passes it - so the components are refused first, and the
# boundary holds on its own instead of leaning on what restic happens to match.
case "$file" in
	*/../* | */.. | ../* | ..) check_result "$E_FORBIDEN" "$file contains a .. component" ;;
esac
case "$file" in
	"$HOMEDIR/$user" | "$HOMEDIR/$user"/*) ;;
	*) check_result "$E_FORBIDEN" "$file is outside $HOMEDIR/$user" ;;
esac
case "$file" in
	"$(restic_dump_dir "$user")" | "$(restic_dump_dir "$user")"/*)
		check_result "$E_FORBIDEN" "$file is the raw dump stage, restore the database instead"
		;;
esac
if [ -z "$(restic_pkg_for_snapshot "$user" "$snapshot")" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi

restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" \
	--include "$file" --target /
if [ "$?" -ne 0 ]; then
	check_result "$E_NOTEXIST" "$file is not in snapshot $snapshot"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Update user counters
$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-file-restic '$user' '$snapshot' '$file' /d" $CONF_DIR/queue/backup.pipe

# Logging
$BIN/h-log-action "system" "Info" "Backup" "File successfully restored (User: $user, Snapshot: $snapshot, File: $file)."
$BIN/h-log-action "$user" "Info" "Backup" "File successfully restored (User: $user, Snapshot: $snapshot, File: $file)."
log_event "$OK" "$ARGUMENTS"
exit

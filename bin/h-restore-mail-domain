#!/bin/bash
# info: restore single mail domain
# options: USER BACKUP DOMAIN [NOTIFY]
#
# example: h-restore-mail-domain USER BACKUP DOMAIN [NOTIFY]
#
# Restores one mail domain from a backup archive through h-restore-user.

user=$1
backup=$2
domain=$3
notify=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER BACKUP DOMAIN [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'backup'

$BIN/h-restore-user "$user" "$backup" 'no' 'no' "$domain" 'no' 'no' 'no' "$notify"
# The inner run has already said why; passed on so the caller sees the failure.
check_result $? "restore of $backup failed" > /dev/null

log_event "$OK" "$ARGUMENTS"

exit

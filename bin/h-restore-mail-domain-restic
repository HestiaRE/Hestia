#!/bin/bash
# info: restore WEB domain
# options: USER SNAPSHOT DOMAIN [NOTIFY]
#
# example: h-restore-mail-domain-restic user snapshot domain.com
# example: h-restore-mail-domain-restic user snapshot 'domain.com,domain2.com'
# example: h-restore-mail-domain-restic user snapshot '*'

#
# Restores mail domains from a restic snapshot.

user=$1
snapshot=$2
mail=$3
notify=${4-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

# This run's own queue line, for the abort path (see queue_drop_job).
QUEUE_JOB="h-restore-mail-domain-restic '$user' '$snapshot' '$mail'"

args_usage='USER SNAPSHOT DOMAIN [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
subj="$user → restore failed"
email=$(get_user_value '$CONTACT')

is_restic_repo_configured

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT

# The metadata is the package beside the repository, not part of the snapshot.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
restic_meta_cat "$meta_pkg" backup.conf > "$tmpdir/backup.conf"
if [ ! -s "$tmpdir/backup.conf" ]; then
	check_result "$E_PARSING" "$meta_pkg carries no backup.conf - the snapshot cannot be described"
fi

domains=""
parse_object_kv_list "$(cat "$tmpdir/backup.conf")"
# Both values are comma lists: with the default IFS the list stays one element. IFS is restored right away.
OLD_IFS="$IFS"
IFS=','
read -r -a domains_array <<< "$mail"
read -r -a domains <<< "$MAIL"
IFS="$OLD_IFS"
requested=",$(
	IFS=','
	echo "${domains_array[*]}"
),"

exim_user="exim"
check_exim_username=$(grep -c '^Debian-exim:' /etc/passwd)
if [ "$check_exim_username" -eq 1 ]; then
	exim_user="Debian-exim"
fi

for domain in "${domains[@]}"; do
	if [[ "$mail" = '*' || "$requested" == *",${domain},"* ]]; then
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'mail' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
		fi

		restic_meta_unpack "$meta_pkg" "$tmpdir" "./mail/$domain"
		if [ ! -s "$tmpdir/mail/$domain/hestia/mail.conf" ]; then
			check_result "$E_NOTEXIST" "$meta_pkg carries no record for mail domain $domain"
		fi

		if [ -z "$check_config" ]; then
			archived_record=$(head -n1 "$tmpdir/mail/$domain/hestia/mail.conf")
			record_line_valid "$archived_record" \
				|| check_result "$E_PARSING" "$domain mail record is not a KEY='VALUE' line - refusing to restore it"
			record_zero_counters archived_record U_DISK
			echo "$archived_record" >> $USER_DATA/mail.conf
		fi

		if [ -e "$tmpdir/mail/$domain/hestia/$domain.pem" ]; then
			cp -f $tmpdir/mail/$domain/hestia/$domain.pem $USER_DATA/mail/
			cp -f $tmpdir/mail/$domain/hestia/$domain.pub $USER_DATA/mail/
		fi

		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf | grep -o "SSL='yes'")
		if [ -n "$check_config" ]; then
			if [ ! -e "$CONF_DIR/users/$user/ssl/" ]; then
				mkdir -p $CONF_DIR/users/$user/ssl/
			fi

			if [ ! -e "$HOMEDIR/$user/conf/mail/$domain/ssl/" ]; then
				mkdir -p $HOMEDIR/$user/conf/mail/$domain/ssl/
			fi

			if [ -f $tmpdir/mail/$domain/hestia/ssl/$domain.crt ]; then
				cp -f $tmpdir/mail/$domain/hestia/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/hestia/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/hestia/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/hestia/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/hestia/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi
			elif [ -f "$tmpdir/mail/$domain/conf/ssl/$domain.crt" ]; then
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/conf/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/conf/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi

			fi

			chmod 660 $USER_DATA/ssl/mail.$domain.*

			cp -f $USER_DATA/ssl/mail.$domain.crt $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt
			cp -f $USER_DATA/ssl/mail.$domain.key $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key
			cp -f $USER_DATA/ssl/mail.$domain.pem $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem
			if [ -e "$USER_DATA/ssl/mail.$domain.ca" ]; then
				cp -f $USER_DATA/ssl/mail.$domain.ca $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.ca
			fi

			if [ ! -d /etc/dovecot/conf.d/domains ]; then
				mkdir /etc/dovecot/conf.d/domains
			fi

			if [ -f /etc/dovecot/conf.d/domains/$domain.conf ]; then
				rm -f /etc/dovecot/conf.d/domains/$domain.conf
			fi

			dovecot_version="$(dovecot --version | cut -f -2 -d .)"
			if [[ "$dovecot_version" = "2.4" ]]; then
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_server_cert_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_server_key_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			else
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_cert = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_key = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			fi

			if [ ! -d $MAIL_SNI_DIR ]; then
				mkdir $MAIL_SNI_DIR
			fi

			find $MAIL_SNI_DIR -xtype l -delete

			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem $MAIL_SNI_DIR/mail.$domain.crt
			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key $MAIL_SNI_DIR/mail.$domain.key

			mail_ssl_modes "$user" "$domain"
		fi

		if [ -f "$tmpdir/mail/$domain/hestia/$domain.conf" ]; then
			restore_records_filter "$tmpdir/mail/$domain/hestia/$domain.conf" "$USER_DATA/mail/$domain.conf" mail_accounts
		fi

		# The autoreply text is content nothing regenerates: restore both the record-side copy and the one exim reads.
		if compgen -G "$tmpdir/mail/$domain/hestia/*@$domain.msg" > /dev/null; then
			cp -f $tmpdir/mail/$domain/hestia/*@$domain.msg $USER_DATA/mail/
			chmod 660 $USER_DATA/mail/*@$domain.msg
		fi
		if compgen -G "$tmpdir/mail/$domain/conf/autoreply.*.msg" > /dev/null; then
			mkdir -p $HOMEDIR/$user/conf/mail/$domain
			cp -f $tmpdir/mail/$domain/conf/autoreply.*.msg $HOMEDIR/$user/conf/mail/$domain/
			chown $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/autoreply.*.msg
			chmod 660 $HOMEDIR/$user/conf/mail/$domain/autoreply.*.msg
		fi

		domain_idn=$domain
		format_domain_idn

		if [ ! -d "$HOMEDIR/$user/mail/$domain_idn" ]; then
			mkdir $HOMEDIR/$user/mail/$domain_idn
		fi

		chmod u+w "$HOMEDIR/$user/mail/$domain_idn"
		chown $user:$user "$HOMEDIR/$user/mail/$domain_idn"

		restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" --include /home/$user/mail/$domain_idn --target /
		if [ "$?" -ne 0 ]; then
			check_result "$E_NOTEXIST" "Unable to download user data"
		fi

		if [ -d "$HOMEDIR/$user/conf/mail/$domain" ]; then
			find $HOMEDIR/$user/conf/mail/$domain -user root \
				-exec chown $exim_user {} \;
		fi

		$BIN/h-rebuild-mail-domain "$user" "$domain"
	fi
done
rm -fr $tmpdir

$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-mail-domain-restic '$user' '$snapshot' '$mail' /d" $CONF_DIR/queue/backup.pipe

$BIN/h-log-action "system" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $mail)."
$BIN/h-log-action "$user" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $mail)."
log_event "$OK" "$ARGUMENTS"
exit

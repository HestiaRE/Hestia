#!/bin/bash
# info: restore selected components of a server backup
# options: ARCHIVE COMPONENT[,COMPONENT...] [CONSENT]
#
# example: h-restore-server server.2026-08-19_18-00-00.tar webmail
# example: h-restore-server server.2026-08-19_18-00-00.tar webmail,packages all
#
# Restores named components of a server backup. There is no whole-archive verb: each component is named and
# consented to before the first write, by answering or via CONSENT; without a terminal nothing is written.
# ARCHIVE is a basename resolved inside the backup folder: this reads as root, a path would reach any file.

archive=$1
components=$2
consent=$3

# A member name comes out of the archive and is looked up as a directory or database identifier: plain ASCII basename.
# Not is_object_format_valid: it exits where a crafted member must only be skipped, and is locale dependent.
member_name_ok() {
	case "$1" in
		'' | .* | *[!A-Za-z0-9._-]*) return 1 ;;
	esac
	return 0
}

# db_replace DB DUMP: make DB hold exactly what DUMP holds. Drop and recreate: --add-drop-table only replaces
# the tables the dump carries, so a table the archive predates would survive.
db_replace() {
	mysql -e "DROP DATABASE IF EXISTS \`$1\`; CREATE DATABASE \`$1\`" 2> /dev/null || return 1
	backup_decompress "$2" | mysql "$1" 2> /dev/null
}

# note WHAT: remember what did not come back, for the closing line and the exit status.
note() {
	echo "Warning!: $1"
	problems="$problems
  - $1"
}

# What restoring COMPONENT would replace on this host, for the consent question.
component_targets() {
	local _item _out=''
	while IFS= read -r _item; do
		case "$_item" in
			dir:*) _out="$_out, ${_item#dir:}" ;;
			db:mysql:*) _out="$_out, database ${_item##*:}" ;;
		esac
	done < <(tr ' ' '\n' <<< "$1")
	printf '%s' "${_out#, }"
}

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'ARCHIVE COMPONENT[,COMPONENT...] [CONSENT]'
is_object_format_valid "$archive" 'backup'

if [ ! -f "$BACKUP/$archive" ]; then
	check_result "$E_NOTEXIST" "$archive doesn't exist in '$BACKUP'"
fi
archive_real=$(realpath -e -- "$BACKUP/$archive" 2> /dev/null)
backup_real=$(realpath -e -- "$BACKUP" 2> /dev/null)
if [ -z "$archive_real" ] || [ -z "$backup_real" ] || [ "${archive_real%/*}" != "$backup_real" ]; then
	check_result "$E_INVALID" "$archive does not resolve to a file inside '$BACKUP'"
fi

in_archive=$(tar -tf "$BACKUP/$archive" 2> /dev/null | sed -n 's|^\./server/\([^/]*\)/.*|\1|p' | sort -u)
if [ -z "$in_archive" ]; then
	check_result "$E_PARSING" "$archive holds no server components"
fi

selected=''
IFS=, read -ra _c_list <<< "$components"
for c in "${_c_list[@]}"; do
	[ -n "$c" ] || continue
	is_object_format_valid "$c" 'component'
	if ! grep -qxF "$c" <<< "$in_archive"; then
		check_result "$E_NOTEXIST" "$archive holds no component $c - it has: $(tr '\n' ' ' <<< "$in_archive")"
	fi
	selected="$selected$c"$'\n'
done
if [ -z "$selected" ]; then
	check_result "$E_INVALID" "name at least one component - a server backup is never restored whole"
fi

# Naming a component says which live state to replace, not that replacing it is intended (webmail carries every
# mailbox's identities and settings), so every component is asked before the first write, naming what would be lost.
if ! restore_consent_parse "$consent" "all $(tr '\n' ' ' <<< "$in_archive")"; then
	check_result "$E_INVALID" "consent must be a comma list of components, or 'all'"
fi

declare -A items=()
approved=''
# A plain `for`, not `while read` over a process substitution: stdin becomes the fifo and the question is never asked.
for component in $selected; do
	# Once per component: server_component_items asks the database engine what exists.
	items[$component]=$(server_component_items "$component")
	# The database clause only where one applies, so the warnings that do apply are not skimmed.
	dbnote=''
	case "${items[$component]}" in *db:*) dbnote=' (databases are dropped and recreated)' ;; esac
	if restore_consent_ask "$component" \
		"$component replaces the live $(component_targets "${items[$component]}") on this box$dbnote. Replace?"; then
		approved="$approved$component"$'\n'
	else
		echo "Skipped $component: no consent given"
	fi
done

if [ -z "$approved" ]; then
	check_result "$E_INVALID" "no component was consented to - nothing has been written"
fi

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT
chmod 700 "$tmpdir"

problems=''
echo "-- SERVER RESTORE --"
while IFS= read -r component; do
	[ -n "$component" ] || continue
	# By exact member: the name came out of the archive, so it is never a wildcard.
	tar -xf "$BACKUP/$archive" -C "$tmpdir" --no-wildcards "./server/$component" 2> /dev/null
	# Counted, because a loop that recognises nothing otherwise looks like a clean run.
	seen=0
	for part in "$tmpdir/server/$component"/*; do
		[ -e "$part" ] || continue
		# Both codecs are read: the archive may come from a zstd box.
		case "$part" in
			*.mysql.sql.gz | *.mysql.sql.zst)
				seen=$((seen + 1))
				db=$(basename "$part")
				db="${db%.mysql.sql.*}"
				if ! member_name_ok "$db"; then
					note "$component: $db is not a database member name - skipped, $db untouched"
					continue
				fi
				if [ -z "$DB_SYSTEM" ] || ! command -v mysql > /dev/null 2>&1; then
					note "$component: no database engine on this host - $db not restored"
					continue
				fi
				# The dump must be whole before the target is dropped; the codec's exit status is not the dump's.
				if ! backup_dump_complete "$part"; then
					note "$component: the dump of $db is truncated - $db left untouched"
					continue
				fi
				# A complete dump can still fail to load after the drop, so copy the live state first. A broken
				# database may not copy: that does not block the restore, but the missing way back is said.
				rollback="$tmpdir/rollback.$db.sql.$(backup_codec_suffix)"
				if ! { mysqldump --add-drop-table --routines --triggers --single-transaction "$db" 2> /dev/null \
					| backup_compress > "$rollback" && backup_dump_complete "$rollback"; }; then
					rollback=''
					echo "Warning!: $component: no rollback copy of $db could be taken - a failed load cannot be undone"
				fi
				if db_replace "$db" "$part"; then
					echo "$(date '+%F %T') $component: database $db"
				elif [ -n "$rollback" ] && db_replace "$db" "$rollback"; then
					note "$component: database $db did not load - rolled back to the state before this run"
				else
					note "$component: database $db did not load and could not be rolled back - it is now INCOMPLETE, not what it was"
				fi
				;;
			*.sqlite.gz | *.sqlite.zst)
				seen=$((seen + 1))
				name=$(basename "$part")
				name="${name%.sqlite.*}"
				if ! member_name_ok "$name"; then
					note "$component: $name is not a sqlite member name - skipped"
					continue
				fi
				mapfile -t places < <(tr ' ' '\n' <<< "${items[$component]}" | sed -n "s|^sqlite:\(.*/$name\)$|\1|p")
				if [ "${#places[@]}" -ne 1 ]; then
					note "$component: ${#places[@]} places on this host for the sqlite file $name - not restored"
					continue
				fi
				dest="${places[0]}"
				# Verified before the live file is touched, so there is nothing to roll back.
				backup_decompress "$part" > "$dest.restore" 2> /dev/null
				sqlite_ok "$dest.restore"
				case $? in
					0) ;;
					2)
						# Refuse: the backup side may go on without the client, but here an unchecked file would replace
						# a working store, and the missing client is one apt away.
						note "$component: sqlite3 is missing, so $name cannot be checked before it replaces a live store - install sqlite3 and run this again"
						rm -f "$dest.restore"
						continue
						;;
					*)
						note "$component: the archived $name is not a whole sqlite database - $name left untouched"
						rm -f "$dest.restore"
						continue
						;;
				esac
				# The owner is the webmail's, not root's, and the live file is the one that knows it.
				if [ -f "$dest" ]; then
					chown --reference="$dest" "$dest.restore" 2> /dev/null
					chmod --reference="$dest" "$dest.restore" 2> /dev/null
				else
					chown --reference="$(dirname "$dest")" "$dest.restore" 2> /dev/null
					chmod 640 "$dest.restore" 2> /dev/null
				fi
				# One rename, so no half replaced file is ever seen; stale wal/shm belong to the old database.
				if mv -f "$dest.restore" "$dest" 2> /dev/null; then
					rm -f "$dest-wal" "$dest-shm"
					echo "$(date '+%F %T') $component: $dest"
				else
					note "$component: $dest could not be replaced"
					rm -f "$dest.restore"
				fi
				;;
			*.tar.gz | *.tar.zst)
				seen=$((seen + 1))
				# This host's item list picks the destination: paths named by the archive would be a write primitive.
				name=$(basename "$part")
				name="${name%.tar.*}"
				if ! member_name_ok "$name"; then
					note "$component: $name is not a component member name - skipped"
					continue
				fi
				mapfile -t places < <(tr ' ' '\n' <<< "${items[$component]}" | sed -n "s|^dir:\(.*/$name\)$|\1|p")
				if [ "${#places[@]}" -eq 0 ]; then
					note "$component: no place on this host for $name - not restored"
					continue
				fi
				# Refuse rather than pick: unpacking into the wrong one of two same-named dirs is silent.
				if [ "${#places[@]}" -gt 1 ]; then
					note "$component: $name matches ${#places[@]} places on this host - not restored"
					continue
				fi
				dest="${places[0]}"
				backup_decompress "$part" | tar -xf - -C "$(dirname "$dest")" \
					&& echo "$(date '+%F %T') $component: $dest" \
					|| note "$component: $dest was not unpacked and may be incomplete"
				;;
		esac
	done
	[ "$seen" -gt 0 ] || note "$component: the archive holds nothing under this component that this host can read"
done < <(printf '%s\n' "$approved")

$BIN/h-log-action "system" "Info" "Backup" "Server components restored from $archive: $(tr '\n' ' ' <<< "$approved")."

# What did not come back is repeated once and carried into the exit status, so a caller sees the warnings.
if [ -n "$problems" ]; then
	echo
	echo "Not everything came back:$problems"
	log_event "$E_PARSING" "$ARGUMENTS"
	exit "$E_PARSING"
fi

log_event "$OK" "$ARGUMENTS"

exit

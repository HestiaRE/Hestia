#!/bin/bash
# info: restore user
# options: USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY] [CONSENT]
#
# example: h-restore-user admin 2019-04-22_01-00-00.tar
# example: h-restore-user admin 2019-04-22_01-00-00.tar '' '' '' '' '' '' no all,php-fallback
#
# Restores a customer from a backup archive found in the backup folder.
#
# CONSENT is a comma list (all, web, mail, db, cron, udir, php-fallback) naming the sections this run may write;
# needed only where nobody can be asked: a terminal is prompted and a selector naming objects is itself consent.

user=$1
backup=$2
web=$3
dns=$4
mail=$5
db=$6
cron=$7
udir=$8
notify=${9-no}
consent=${10}

if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/docker.sh
source $HESTIA/include/docker.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY] [CONSENT]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user' 'backup'

if [[ ! -d "$BACKUP" ]]; then
	mkdir -p "$BACKUP"
fi
# 711, not 755: customer names and run dates are not for local users to enumerate.
if [ $(stat -c %a "$BACKUP") != 711 ]; then
	chmod 711 "$BACKUP"
fi

backup_archive_path "$user" "$backup"
case $? in
	2) check_result "$E_INVALID" "$backup does not resolve to a file inside '${BACKUP}'" ;;
	1)
		# A chain decided by content: the next transport is skipped only once the file is actually here.
		for remote_type in sftp ftp rclone; do
			# Comma-bounded, not =~: ftp is a substring of sftp (same form as backup_db_type_supported).
			[[ ",$BACKUP_SYSTEM," == *",$remote_type,"* ]] || continue
			${remote_type}_download "$backup"
			backup_archive_path "$user" "$backup" && break
		done
		;;
esac

if ! backup_archive_path "$user" "$backup"; then
	check_result "$E_NOTEXIST" "backup file $backup doesn't exist in '$BACKUP/$user' or '${BACKUP}'"
fi
# Into plain variables now: the resolver globals are overwritten by the base lookup below.
backup_path="$BACKUP_ARCHIVE"
backup_at="$BACKUP_ARCHIVE_DIR"

check_user=$(is_object_valid 'user' 'USER' "$user")
if [ -z "$check_user" ]; then
	is_object_unsuspended 'user' 'USER' "$user"
	subj="$user → restore failed"
	email=$(get_user_value '$CONTACT')
else
	create_user="yes"
	# A new account gets the rules h-add-user applies, the backup is no proof of them.
	FROM_V_ADD_USER=true is_user_format_valid "$user" 'user'
	is_login_name_reserved "$user"
	email=$(grep CONTACT "$CONF_DIR/users/$ROOT_USER/user.conf" | cut -f2 -d \')
	! db_namespace_taken "$user" \
		|| check_result "$E_EXISTS" "user $user is not available: another account holds database names starting with ${user}_"
fi

disk_usage=$(df $BACKUP | tail -n1 | tr ' ' '\n' | grep % | cut -f 1 -d %)
if [ "$disk_usage" -ge "$BACKUP_DISK_LIMIT" ]; then
	echo "Error: Not enough disk space" | $SENDMAIL -s "$subj" $email $notify
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_DISK" "Not enough disk space"
fi

la=$(cat /proc/loadavg | cut -f 1 -d ' ' | cut -f 1 -d '.')
i=0
while [ "$la" -ge "$BACKUP_LA_LIMIT" ]; do
	echo -e "$(date "+%F %T") Load Average $la"
	sleep 60
	if [ "$i" -ge "15" ]; then
		la_error="LoadAverage $la is above threshold"
		echo "Error: $la_error" | $SENDMAIL -s "$subj" $email $notify
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_LA" "$la_error"
	fi
	la=$(cat /proc/loadavg | cut -f 1 -d ' ' | cut -f 1 -d '.')
	((++i))
done

if [ -z "$BACKUP_TEMP" ]; then
	BACKUP_TEMP=$BACKUP
fi

tmpdir=$(mktemp -p $BACKUP_TEMP -d) || {
	echo "Can't create tmp dir in $BACKUP_TEMP" | $SENDMAIL -s "$subj" $email $notify
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_NOTEXIST" "Can't create tmp dir"
}
# On every exit, one trap owner: later stages add work via flags, never a second `trap ... EXIT` (it replaces silently).
quota_cap_lifted=''
counters_recount=''
restore_cleanup() {
	rm -rf "$tmpdir"
	# An aborted restore must not leave the customer unlimited.
	[ "$quota_cap_lifted" = 'yes' ] && "$BIN/h-update-user-quota" "$user" > /dev/null 2>&1
	# Also after an abort: a later h-delete-user would subtract what was never counted.
	if [ "$counters_recount" = 'yes' ]; then
		[ -e "$USER_DATA/user.conf" ] && "$BIN/h-update-user-counters" "$user" > /dev/null 2>&1
		"$BIN/h-update-user-counters" "$ROOT_USER" > /dev/null 2>&1
		"$BIN/h-update-sys-ip-counters" > /dev/null 2>&1
	fi
}
trap restore_cleanup EXIT

# Collected and reported at the end: one broken object must not abandon the rest nor pass as a success.
restore_failures=''

# Fixed text: a queued BACKUP for the same customer must not go with this line.
QUEUE_JOB="h-restore-user '$user' '$backup'"

# Read the archive once before anything is written: answers arriving during a run come after the write they were about.
if ! backup_probe "$backup_path" "$tmpdir/.probe"; then
	rm -rf "$tmpdir"
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_PARSING" "$backup cannot be read as a backup archive"
fi
backup_mode="$PROBE_MODE"
backup_report | tee -a "$tmpdir/restore.log"
if [ "$backup_at" = 'root' ]; then
	echo "   found at the hand-off location $BACKUP, not the customer folder" | tee -a "$tmpdir/restore.log"
fi

# Diff base checked now: discovering it at the third member means two are already written.
backup_diff_probe "$backup_path" "$tmpdir/.diff"
if [ -n "$DIFF_BASE" ]; then
	echo "   differential archive, base $DIFF_BASE" | tee -a "$tmpdir/restore.log"
	# The base follows the same chain as the archive: a diff whose base only a remote holds must restore without help.
	if ! backup_archive_path "$user" "$DIFF_BASE"; then
		for remote_type in sftp ftp rclone; do
			[[ ",$BACKUP_SYSTEM," == *",$remote_type,"* ]] || continue
			${remote_type}_download "$DIFF_BASE"
			backup_archive_path "$user" "$DIFF_BASE" && break
		done
	fi
	if ! backup_archive_path "$user" "$DIFF_BASE"; then
		rm -rf "$tmpdir"
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		# The refusal claims only what was searched: the remote clause appears only if a remote was configured.
		base_missing="$backup is differential and its base $DIFF_BASE is neither in $BACKUP/$user nor $BACKUP"
		case ",$BACKUP_SYSTEM," in
			*,ftp,* | *,sftp,* | *,rclone,*) base_missing="$base_missing, and no configured remote target has it" ;;
		esac
		check_result "$E_NOTEXIST" "$base_missing"
	fi
	base_path="$BACKUP_ARCHIVE"
	if ! tar -tf "$base_path" 2> /dev/null | grep -qxF "./$BACKUP_CONTAINER/backup.map"; then
		rm -rf "$tmpdir"
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_PARSING" "base $DIFF_BASE carries no content map - it cannot serve as one"
	fi
	# MAPHASH is built against the local mirror and read against the base's map: a same-named archive fails here.
	base_maphash=$(sed -n "s/.*MAPHASH='\([^']*\)'.*/\1/p" "$tmpdir/.diff/backup.base")
	base_maphash_live=$(tar -xOf "$base_path" "./$BACKUP_CONTAINER/backup.map" 2> /dev/null \
		| sha256sum | cut -d' ' -f1)
	if [ -z "$base_maphash" ] || [ "$base_maphash" != "$base_maphash_live" ]; then
		rm -rf "$tmpdir"
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_PARSING" "base $DIFF_BASE is not the archive this diff was built against (map hash mismatch)"
	fi
fi
# Outer guard: a garbled backup.base would skip the diff branch and unpack diff members as whole, a tree that looks
# complete.
if [ -z "$DIFF_BASE" ] && grep -qv '=full$' "$tmpdir/.diff/backup.members" 2> /dev/null; then
	rm -rf "$tmpdir"
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_PARSING" "$backup marks differential members but names no readable base - refusing a restore that would only look complete"
fi

# Refused before the first write: a second container shape would constrain every path join in this file.
if [ "$PROBE_VESTA" = 'yes' ]; then
	rm -rf "$tmpdir"
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_PARSING" "$backup is a Vesta archive - HestiaRE restores HestiaCP and HestiaRE archives only"
fi

# Plan, then consent, then write: a gate inside a section leaves half an account behind. The web list is derived once.
backup_domains=$(tar -tf "$backup_path" | grep "^./web")
# Both spellings: a diff payload is domain_data.diff.tar.*, older archives use the whole-member name.
if [ "$backup_mode" = "zstd" ]; then
	backup_domains=$(echo "$backup_domains" | grep -E 'domain_data(\.diff)?\.tar\.zst')
else
	backup_domains=$(echo "$backup_domains" | grep -E 'domain_data(\.diff)?\.tar\.gz')
fi
backup_domains=$(echo "$backup_domains" | cut -f 3 -d /)
if [ -z "$web" ] || [ "$web" = '*' ]; then
	domains="$backup_domains"
else
	echo "$web" | tr ',' '\n' > $tmpdir/selected.txt
	domains=$(echo "$backup_domains" | grep -E -x -f $tmpdir/selected.txt)
fi

# The queue cleanup at the end matches the customer name, not the line: two queued jobs for one customer both go.
if ! restore_consent_parse "$consent"; then
	rm -rf "$tmpdir"
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_INVALID" "unknown consent token in '$consent' - allowed: ${RESTORE_CONSENT_TOKENS// /, }"
fi
# No env channel for consent (GHSA-2xw3): a second control channel reopens what the argument closed. The rule also lives
# in include/backup.sh and bin/h-backup-user. The restic commands keep the environment, having no consent argument.

restore_refused=''
# Per section: off, selected (which is the consent) or asked. One list, read twice: a section added to only one
# reader would make a named run look like a full one.
restore_sections='web:WEB_SYSTEM:PROBE_WEB mail:MAIL_SYSTEM:PROBE_MAIL db:DB_SYSTEM:PROBE_DB
cron:CRON_SYSTEM:PROBE_CRON udir::PROBE_UDIR'
for _sec in $restore_sections; do
	_name="${_sec%%:*}"
	_rest="${_sec#*:}"
	_sys="${_rest%%:*}"
	_objs="${_rest#*:}"
	_sel="${!_name}"
	[ "$_sel" = 'no' ] && continue
	[ -z "$_sys" ] || [ -n "${!_sys}" ] || continue
	[ -n "${!_objs}" ] && [ "${!_objs}" != 'no' ] || continue
	restore_consent_selector "$_sel" && continue
	restore_consent_ask "$_name" "Restore the $_name section of $backup into $user?" \
		|| restore_refused="$restore_refused $_name"
done

# Consent like the others: a missing version lands on the system default, which changes what the customer runs.
php_missing=''
if [ "$web" != 'no' ] && [ -n "$WEB_SYSTEM" ] && [ -n "$domains" ]; then
	# Called plainly, NOT in a substitution: in a subshell the register below never reaches here.
	backup_php_missing "$domains"
	php_missing="$BACKUP_PHP_MISSING"
	# A record the probe did not extract means the question was never asked: refuse, do not read it as 'nothing
	# missing'.
	if [ -n "$BACKUP_PHP_UNREADABLE" ]; then
		rm -rf "$tmpdir"
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_PARSING" "no archived web record for:$BACKUP_PHP_UNREADABLE - cannot tell which PHP version they need"
	fi
	if [ -n "$php_missing" ]; then
		restore_consent_ask 'php-fallback' \
			"PHP $php_missing is not installed here. Move those domains to the default ($(multiphp_default_version))?" \
			|| restore_refused="$restore_refused php-fallback"
	fi
fi
# Assigned in both directions: it is also the internal flag read later, and a miss must not let the environment answer.
if restore_consent_has 'php-fallback'; then
	RESTORE_PHP_FALLBACK='yes'
else
	RESTORE_PHP_FALLBACK=''
fi

# A section like the others, as it writes into the home. Whole-archive runs only: wrappers naming objects must not
# stop on a stray DNS zone.
LEFTOVERS_PATTERNS=''
leftovers_partial=''
for _sec in $restore_sections; do
	_name="${_sec%%:*}"
	restore_consent_selector "${!_name}" && leftovers_partial='yes'
done
[ -n "$leftovers_partial" ] || backup_leftovers_plan
if [ -n "$LEFTOVERS_PATTERNS" ]; then
	restore_consent_ask 'leftovers' \
		"Carry what this host cannot restore into $HOMEDIR/$user/leftovers/?" \
		|| restore_refused="$restore_refused leftovers"
fi

if [ -n "$restore_refused" ]; then
	rm -rf "$tmpdir"
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	# The tokens actually refused: 'all' covers the sections and deliberately not php-fallback.
	restore_suggest=$(tr ' ' ',' <<< "${restore_refused# }")
	check_result "$E_INVALID" "no consent for:$restore_refused - nothing was written. Give '$restore_suggest' as the LAST argument (the tenth, after NOTIFY; an environment prefix is ignored on purpose), select the objects to restore, or answer the prompt on a terminal. 'all' stands for the sections and deliberately not for php-fallback, which moves a customer's domains onto another PHP version."
fi
counters_recount='yes'

if [ "$create_user" = 'yes' ]; then

	getent passwd "$user" > /dev/null 2>&1
	if [ "$?" == 0 ]; then
		check_result "$E_EXISTS" "User already exists"
	fi

	echo "-- USER --" | tee $tmpdir/restore.log
	echo -e "$(date "+%F %T") $user" | tee -a $tmpdir/restore.log

	tar xf "$backup_path" -C "$tmpdir" --no-wildcards "./$BACKUP_CONTAINER" 2> /dev/null
	if [ "$?" -ne 0 ]; then
		rm -rf $tmpdir
		echo "Can't unpack user container" | $SENDMAIL -s "$subj" $email $notify
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_PARSING" "Can't unpack user container"
	fi

	mkdir $USER_DATA
	# Filtered, not copied: the archive is hostile input. Dropped keys go to restore.log too, a queued run has no terminal.
	copy_record_filtered "$tmpdir/$BACKUP_CONTAINER/user.conf" "$USER_DATA/user.conf" user \
		2> >(tee -a "$tmpdir/restore.log" >&2) \
		|| check_result "$E_PARSING" "the archived user.conf of $user carries no usable keys"
	# A language this panel does not offer becomes en; rc 2 (an unusable list) leaves the value alone.
	_lang=$(grep -m1 "^LANGUAGE=" "$USER_DATA/user.conf" | cut -d "'" -f 2)
	if [ -n "$_lang" ]; then
		language_offered "$_lang"
		if [ $? -eq 1 ]; then
			update_user_value "$user" '$LANGUAGE' 'en'
			echo "Note: the archived language '$_lang' is not offered here, $user uses en" | tee -a $tmpdir/restore.log
		fi
	fi
	cp -r $tmpdir/$BACKUP_CONTAINER/ssl $USER_DATA/ > /dev/null 2>&1

	# Everything else the container holds, minus archive metadata and the parts handled separately.
	# A superset on purpose: this is the side that takes in foreign archives.
	for _entry in "$tmpdir/$BACKUP_CONTAINER"/*; do
		[ -e "$_entry" ] || continue
		_name=$(basename "$_entry")
		[[ " $BACKUP_USER_DATA_CORE $BACKUP_CONTAINER_META user.conf ssl packages " == *" $_name "* ]] && continue
		# Out of the archive and joined onto a path we write to: a plain basename or nothing.
		case "$_name" in '' | .* | */* | *[!A-Za-z0-9._-]*) continue ;; esac
		# Whatever later runs through source_conf is filtered by its key set: a poisoned exclusion list could blank
		# MAIL_SYSTEM and skip the mail section of every future backup while the run stays green.
		# Notices render as HTML in the bell: a foreign one never passed the sanitizer.
		[ "$_name" = "notifications.conf" ] && continue
		# Read back as records; a line outside the grammar would set whatever its keys name.
		if [ "$_name" = "stats.log" ]; then
			while IFS= read -r _line || [ -n "$_line" ]; do
				record_line_valid "$_line" && printf '%s\n' "$_line"
			done < "$_entry" > "$USER_DATA/$_name"
			continue
		fi
		if [ "$_name" = "backup-excludes.conf" ]; then
			copy_record_filtered "$_entry" "$USER_DATA/$_name" backup_excludes 2> >(tee -a "$tmpdir/restore.log" >&2) \
				|| echo "Warning!: the archived $_name carries no usable keys and was skipped" | tee -a $tmpdir/restore.log
			continue
		fi
		cp -r "$_entry" "$USER_DATA/" \
			|| echo "Warning!: $_name from the archive could not be written to the data directory" | tee -a $tmpdir/restore.log
	done

	# The hosting package, ADD ONLY: one of that name already here is kept as is, the admin owns the target definition.
	# Without it a custom package missing on the target leaves the user pointing at a .pkg that is not there.
	if [ -d "$tmpdir/$BACKUP_CONTAINER/packages" ]; then
		for _pkg in "$tmpdir/$BACKUP_CONTAINER/packages/"*; do
			[ -e "$_pkg" ] || continue
			_dest="$CONF_DIR/packages/$(basename "$_pkg")"
			if [ -e "$_dest" ]; then
				echo "$(date "+%F %T") package $(basename "$_pkg") exists on target, kept unchanged" >> $tmpdir/restore.log 2> /dev/null || true
			else
				copy_record_filtered "$_pkg" "$_dest" package 2> >(tee -a "$tmpdir/restore.log" >&2) \
					|| echo "Warning!: the archived package $(basename "$_pkg") carries no usable keys and was skipped" | tee -a $tmpdir/restore.log
			fi
		done
	fi

	# Creates the account with a fresh uid before anything is unpacked, so tar resolves the archived owner onto it,
	# and puts the project id on the fresh home so everything unpacked below inherits it.
	rebuild_user_conf || check_result "$E_INVALID" "account $user could not be created"
fi

if quota_is_active && quota_home_fs; then
	# XFS enforces against root: a restore into a full home would die mid-run. The flag routes the reapply through the
	# EXIT trap.
	setquota -P "$(id -u "$user" 2> /dev/null)" 0 0 0 0 "$QUOTA_MNT" 2> /dev/null
	quota_cap_lifted='yes'
else
	# The package field travels in the backup, the capability does not: name the loss.
	_dq=$(get_user_value '$DISK_QUOTA')
	if [ -n "$_dq" ] && [ "$_dq" != 'unlimited' ]; then
		echo "NOTE: the package carries DISK_QUOTA=${_dq}MB but this box does not enforce it (PROJECT_QUOTA=${PROJECT_QUOTA:-unset})" | tee -a $tmpdir/restore.log
	fi
fi

# What this host cannot restore is handed over, timestamped so a second restore does not overwrite the first.
echo -e "\n-- LEFTOVERS --" | tee -a $tmpdir/restore.log
if [ -n "$leftovers_partial" ]; then
	# Not the sentence for an empty archive: this run named objects, the rest may hold things this host cannot restore.
	echo "$(date '+%F %T') skipped - this run restored named objects only" | tee -a $tmpdir/restore.log
elif [ -z "$LEFTOVERS_PATTERNS" ]; then
	# Printed, never silent: 'nothing to hand over' and 'the export never ran' must look different.
	echo "$(date '+%F %T') nothing to hand over - this host can restore everything in the archive" \
		| tee -a $tmpdir/restore.log
else
	leftovers_dir="$HOMEDIR/$user/leftovers/$(date '+%F_%H-%M-%S')"
	backup_leftovers_export "$backup_path" "$leftovers_dir" "$user"
	# What landed, not what was planned: they differ exactly when something went wrong.
	[ -n "$LEFTOVERS_DONE" ] \
		&& echo "$LEFTOVERS_DONE" | sed '/^$/d;s|^|'"$(date '+%F %T')"' |' | tee -a $tmpdir/restore.log
	if [ -n "$LEFTOVERS_FAILED" ]; then
		echo "$LEFTOVERS_FAILED" | sed '/^$/d;s|^|'"$(date '+%F %T')"' NOT handed over: |' | tee -a $tmpdir/restore.log
		restore_failures="$restore_failures$(printf '\n  not handed over:%s' "$(tr '\n' ';' <<< "$LEFTOVERS_FAILED" | sed 's/;$//;s/;/, /g')")"
	fi
	[ -n "$LEFTOVERS_DONE" ] && echo "$(date '+%F %T') -> $leftovers_dir" | tee -a $tmpdir/restore.log
	# Handing objects over is the friendly half; the status must carry the rest, or a queue reads missing databases as
	# success.
	while IFS= read -r _degraded; do
		[ -n "$_degraded" ] || continue
		restore_failures="$restore_failures$(printf '\n  %s - handed over instead of restored' "$_degraded")"
	done <<< "$LEFTOVERS_DEGRADED"
fi

chown "$user" "$tmpdir"
tar xf "$backup_path" -C $tmpdir ./pam
if [ "$?" -ne 0 ]; then
	rm -rf $tmpdir
	echo "Can't unpack PAM container" | $SENDMAIL -s "$subj" $email $notify
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_PARSING" "Can't unpack PAM container"
fi
if ! restore_passwd_read "$tmpdir/pam/passwd"; then
	echo "The archived passwd entry is not a valid account" | $SENDMAIL -s "$subj" $email $notify
	queue_drop_job "$CONF_DIR/queue/backup.pipe"
	check_result "$E_PARSING" "the archived passwd entry is not a valid account"
fi
new_uid=$(awk -F : -v u="$user" '$1 == u {print $3; exit}' /etc/passwd)

if [ "$web" != 'no' ] && [ -n "$WEB_SYSTEM" ]; then
	echo -e "\n-- WEB --" | tee -a $tmpdir/restore.log

	# The list comes from archive member paths, not a validator: a member with a space would split in two.
	# Read on fd 3 so a command in the body cannot consume the rest of the list.
	while IFS= read -r -u 3 domain; do
		[ -n "$domain" ] || continue
		echo -e "$(date "+%F %T") $domain" | tee -a $tmpdir/restore.log

		# Derived from the record that set them, not a list: a list never learned CROWDSEC and BOTLIMIT and leaked them
		# on.
		restore_forget_record prev_web_keys
		# Not record keys, so not covered above: what this loop derives per domain.
		unset -v restore_web_effect restore_proxy_effect old_ip check_ip

		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'web' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
		fi

		tar xf "$backup_path" -C $tmpdir ./web/$domain
		if [ "$?" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain web container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			queue_drop_job "$CONF_DIR/queue/backup.pipe"
			check_result "$E_PARSING" "$error"
		fi

		if [ -z "$check_config" ]; then
			# The archived line is the record, read once, gated, edited in place; quoted at the call, or it word-splits
			# and globs.
			archived_record=$(head -n1 "$tmpdir/web/$domain/$BACKUP_CONTAINER/web.conf")
			if ! record_line_valid "$archived_record"; then
				rm -rf $tmpdir
				error="$domain web record is not a KEY='VALUE' line - refusing to restore it"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
			restore_parse_record prev_web_keys "$archived_record"

			# The list is archive content: filtered in the shell, never spliced into a sed program.
			IFS=, read -ra _dom_alias_list <<< "$ALIAS"
			ALIAS=''
			for dom_alias in "${_dom_alias_list[@]}"; do
				[ -n "$dom_alias" ] || continue
				check_new=$(is_domain_new 'web' "$dom_alias")
				[ -n "$check_new" ] && continue
				ALIAS="${ALIAS:+$ALIAS,}$dom_alias"
			done

			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				local_ip=''
				get_user_ip $user
				old_ip=$IP
				IP=$ip
			fi
			# A foreign box's v6 must not survive verbatim (it would listen on a missing address): remap to ours, else
			# drop.
			if [ -n "$IP6" ] && [ ! -e "$CONF_DIR/ips/$IP6" ]; then
				if get_user_ip6; then
					IP6="$ip6"
				else
					IP6=''
				fi
			fi

			# Templates through the legacy mapping: an archive can carry values this model has no file for.
			read -r TPL restore_web_effect <<< "$(accept_web_template 'web' "$TPL")"
			read -r PROXY restore_proxy_effect <<< "$(accept_web_template 'proxy' "$PROXY")"
			# BACKEND in the archive is the HestiaCP-compat PHP-<ver>; prefer the native fields, else derive the version
			# from it.
			if [ -n "$WEB_BACKEND" ]; then
				if [ -z "$PHP_VERSION" ]; then
					if [[ "$BACKEND" =~ PHP-([0-9]+)_([0-9]+) ]]; then
						PHP_VERSION="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
					elif [ "$BACKEND" = 'no-php' ]; then
						PHP_VERSION='none'
					else
						PHP_VERSION=$(multiphp_default_version)
					fi
				fi
				# Valid profiles are the shipped pool templates (custom ones included); default otherwise
				if [[ "$PHP_PROFILE" =~ ^[a-zA-Z0-9_-]+$ ]] && [ -f "$PHPTPL/$PHP_PROFILE.tpl" ]; then BACKEND="$PHP_PROFILE"; else BACKEND='default'; fi
				# Preflight approved a fallback for a version this host lacks
				if [ "$RESTORE_PHP_FALLBACK" = 'yes' ] && [ "$PHP_VERSION" != 'none' ]; then
					case " $($BIN/h-list-sys-php plain | tr '\n' ' ') " in
						*" $PHP_VERSION "*) : ;;
						*) PHP_VERSION=$(multiphp_default_version) ;;
					esac
				fi
			else
				read -r BACKEND _ <<< "$(accept_web_template 'backend' "$BACKEND")"
			fi

			if [ -n "$CUSTOM_DOCROOT" ]; then
				CUSTOM_DOCROOT=${CUSTOM_DOCROOT//"/home/$old_user/web/"/"/home/$user/web/"}
			fi
			if [ -n "$CUSTOM_PHPROOT" ]; then
				CUSTOM_PHPROOT=${CUSTOM_PHPROOT//"/home/$old_user/web/"/"/home/$user/web/"}
			fi

			# Per entry and anchored at the front: one `sed s/<old>_//` over the colon list replaced only the first
			# occurrence.
			if [ -n "$FTP_USER" ]; then
				IFS=':' read -r -a _ftp_list <<< "$FTP_USER"
				FTP_USER=''
				for _f in "${_ftp_list[@]}"; do
					[ -n "$_f" ] || continue
					FTP_USER="${FTP_USER:+$FTP_USER:}${user}_${_f#"${old_user}_"}"
				done
			fi

			if [ "$SSL" = 'yes' ]; then

				# Globs, not parsing ls (archive-controlled names), and no $domain in a grep -E pattern: its dots are
				# wildcards.
				if [ -f "$tmpdir/web/$domain/$BACKUP_CONTAINER/$domain.crt" ]; then
					for crt in "$tmpdir/web/$domain/$BACKUP_CONTAINER/$domain."{crt,key,ca,pem}; do
						[ -f "$crt" ] || continue
						cp -f "$crt" "$USER_DATA/ssl/"
					done
				elif [ -f "$tmpdir/web/$domain/conf/ssl.$domain.crt" ]; then
					for crt in "$tmpdir/web/$domain/conf/ssl.$domain."{crt,key,ca,pem}; do
						[ -f "$crt" ] || continue
						cp -f "$crt" "$USER_DATA/ssl/$(basename "$crt" | sed -e "s/^ssl\.//")"
					done
				fi
			fi

			# A mapped -http3 template becomes the http3 switch; whether a quic listen renders is reconciled at rebuild.
			if [ "$restore_web_effect" = 'http3' ] || [ "$restore_proxy_effect" = 'http3' ]; then
				HTTP3='yes'
			fi

			# The archived record is the base and only the fields below are rewritten, so keys this code never heard of
			# survive.
			str="$archived_record"
			record_set_field str DOMAIN "$domain"
			record_set_field str IP "$IP"
			record_set_field str IP6 "$IP6"
			record_set_field str ALIAS "$ALIAS"
			record_set_field str TPL "$TPL"
			record_set_field str PROXY "$PROXY"
			# An empty PROXY_EXT from a proxy-less source empties the static-offload location here. Only with the marker
			# present: without it (HestiaCP) empty is unknown, not proxy-less, and could be the customer's own setting.
			if [ -n "$PROXY_SYSTEM" ] && [ -z "$PROXY_EXT" ] \
				&& [ -n "$PROBE_WEB_SYSTEM" ] && [ -z "$PROBE_PROXY_SYSTEM" ]; then
				PROXY_EXT=$(default_proxy_ext)
			fi
			record_set_field str PROXY_EXT "$PROXY_EXT"
			record_set_field str HTTP3 "$HTTP3"
			record_set_field str BACKEND "$BACKEND"
			record_set_field str PHP_VERSION "$PHP_VERSION"
			record_set_field str FTP_USER "$FTP_USER"
			record_set_field str CUSTOM_DOCROOT "$CUSTOM_DOCROOT"
			record_set_field str CUSTOM_PHPROOT "$CUSTOM_PHPROOT"
			record_set_field str U_BANDWIDTH '0'
			# SUSPENDED is not rewritten: vhost writers use prepare_web_domain_values, so 'yes' is served locked.
			# SUSPENDED_WEB is recounted at the end of the run.
			record_set_field str TIME "$(date +%T)"
			record_set_field str DATE "$(date +%F)"
			# PHP_PROFILE exists only inside the archive; live records carry it as BACKEND.
			record_del_field str PHP_PROFILE

			# Derived from the archived record, so the reference set cannot shrink to nothing; a dropped key is said,
			# not repaired empty.
			restored_keys=" $(record_keys "$str" | tr '\n' ' ')"
			for _k in $(record_keys "$archived_record"); do
				case "$_k" in PHP_PROFILE) continue ;; esac
				case "$restored_keys" in
					*" $_k "*) : ;;
					*) echo "Warning!: $domain web record lost key $_k during restore" | tee -a $tmpdir/restore.log ;;
				esac
			done
			record_zero_counters str U_DISK U_BANDWIDTH
			echo "$str" >> $USER_DATA/web.conf

			# A cache template is a switch now: carry the intent over, or the customer loses their cache.
			if [ "$restore_proxy_effect" = 'cache' ] && [ "$PROXY_SYSTEM" = 'nginx' ]; then
				$BIN/h-add-web-domain-cache "$user" "$domain" > /dev/null 2>&1
			fi

			if [ -n "$WEB_BACKEND" ]; then
				$BIN/h-add-web-domain-backend $user $domain $BACKEND
			fi
		fi

		if [ ! -d "$HOMEDIR/$user/conf/web/$domain/" ]; then
			mkdir -p $HOMEDIR/$user/conf/web/$domain/
		fi
		for file in "$tmpdir/web/$domain/conf"/*; do
			[ -e "$file" ] || continue
			if [[ "$file" == *.ca ]] || [[ "$file" == *.crt ]] || [[ "$file" == *.key ]] || [[ "$file" == *.pem ]] || [[ "$file" == *.conf ]]; then
				continue
			fi
			if grep "fastcgi_pass" "$file"; then
				# Do not allow to run php under a different user
				continue
			fi
			filename=$(basename "$file")
			cp -f "$file" "$HOMEDIR/$user/conf/web/$domain/$filename"
		done

		# The rebuild reconciles the http3 quic fragment from the HTTP3 field through the gate.
		rebuild_web_domain_conf

		# As the customer: the domain directory is theirs, root would follow whatever they put there.
		# From /: find returns to its start directory and the customer cannot enter root's.
		if [ -d "$HOMEDIR/$user/web/$domain/public_html" ]; then
			(cd / && user_exec find "$HOMEDIR/$user/web/$domain/public_html" -mindepth 1 -maxdepth 1 ! -name '.*' \
				-exec rm -rf {} +)
		fi
		chmod u+w "$HOMEDIR/$user/web/$domain"
		[[ -d $HOMEDIR/$user/web/$domain/stats ]] && chmod u+w "$HOMEDIR/$user/web/$domain/stats"

		# Two passes for a difference: the base filtered to what both maps agree on, then the diff over it. No
		# --unlink-first (fails on non-empty dirs): tar already unlinks and recreates, only --overwrite writes through a
		# shared inode.
		web_whole="domain_data.tar.zst"
		[ "$backup_mode" = "zstd" ] || web_whole="domain_data.tar.gz"
		# The domain got here because the listing showed a payload: neither spelling on disk means the archive is
		# incomplete.
		if ! web_member=$(backup_payload_path "$tmpdir/web/$domain" "$web_whole"); then
			rm -rf $tmpdir
			error="$domain carries no $web_whole in $backup - the archive is incomplete"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			queue_drop_job "$CONF_DIR/queue/backup.pipe"
			check_result "$E_NOTEXIST" "$error"
		fi
		if [ -n "$DIFF_BASE" ] && backup_member_needs_base "$tmpdir/.diff/backup.members" "web/$domain"; then
			# The base's member is a whole one whatever this archive calls its diff.
			web_base=$(backup_diff_stage_base "$base_path" "web/$domain" "$web_whole" "$tmpdir/.diff")
			if [ -z "$web_base" ]; then
				rm -rf $tmpdir
				error="$domain is differential and its base member is missing from $DIFF_BASE"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_NOTEXIST" "$error"
			fi
			backup_diff_keep_list "$base_path" "$tmpdir/.diff/backup.map" "web/$domain" \
				"$web_member" "$tmpdir/.diff/keep.web.nul"
			chmod 644 "$tmpdir/.diff/keep.web.nul" 2> /dev/null
			if [ -s "$tmpdir/.diff/keep.web.nul" ]; then
				# --no-recursion BEFORE -T (positional): otherwise every listed directory unpacks recursively and brings
				# deleted files back.
				tar_codec=()
				[ "$backup_mode" = "zstd" ] && tar_codec=(-I pzstd)
				user_exec tar "${tar_codec[@]}" -xpf "$web_base" \
					-C "$HOMEDIR/$user/web/$domain/" \
					--anchored --exclude='logs/*' --no-recursion \
					--null -T "$tmpdir/.diff/keep.web.nul"
			fi
		fi

		if [ "$backup_mode" = "zstd" ]; then
			user_exec tar -I pzstd -xpf "$web_member" \
				-C "$HOMEDIR/$user/web/$domain/" \
				--anchored \
				--exclude='logs/*'
		else
			user_exec tar -xzpf "$web_member" \
				-C "$HOMEDIR/$user/web/$domain/" \
				--anchored \
				--exclude='logs/*'
		fi

		if [ "$?" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain data tarball"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			queue_drop_job "$CONF_DIR/queue/backup.pipe"
			check_result "$E_PARSING" "$error"
		fi

		if [ "$old_uid" -ne "$new_uid" ]; then
			find $HOMEDIR/$user/web/$domain/ -user $old_uid \
				-exec chown -h $user:$user {} \;
		fi

		# Second rebuild so ftp users keep working.
		rebuild_web_domain_conf
	done 3< <(printf '%s\n' "$domains")

	# Deleting by name is right here: it drops any older entry for the customer before adding one.
	remove_user_queue_jobs "$CONF_DIR/queue/traffic.pipe" "$user"
	echo "$BIN/h-update-web-domains-traff $user" >> $CONF_DIR/queue/traffic.pipe

	$BIN/h-restart-web
	check_result $? "Web restart failed"
	if [ -n "$PROXY_SYSTEM" ]; then
		$BIN/h-restart-proxy
		check_result $? "Proxy restart failed"
	fi
fi

# No DNS restore: the subsystem is gone. The [DNS] argument is still accepted for backup compatibility;
# dns/ containers inside the archive are ignored.

if [ "$mail" != 'no' ] && [ -n "$MAIL_SYSTEM" ]; then
	echo -e "\n-- MAIL --" | tee -a $tmpdir/restore.log

	backup_domains=$(tar -tf "$backup_path" | grep "^./mail")
	backup_domains=$(echo "$backup_domains" | grep "mail.conf$")
	backup_domains=$(echo "$backup_domains" | cut -f 3 -d /)
	if [ -z "$mail" ] || [ "$mail" = '*' ]; then
		domains="$backup_domains"
	else
		echo "$mail" | tr ',' '\n' > $tmpdir/selected.txt
		domains=$(echo "$backup_domains" | grep -E -x -f $tmpdir/selected.txt)
	fi

	exim_user="exim"
	check_exim_username=$(grep -c '^Debian-exim:' /etc/passwd)
	if [ "$check_exim_username" -eq 1 ]; then
		exim_user="Debian-exim"
	fi

	# Same reasoning as the web loop above: the list is read on fd 3.
	while IFS= read -r -u 3 domain; do
		[ -n "$domain" ] || continue
		echo -e "$(date "+%F %T") $domain" | tee -a $tmpdir/restore.log

		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'mail' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
		fi

		tar xf "$backup_path" -C $tmpdir ./mail/$domain

		if [ "$?" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain mail container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			queue_drop_job "$CONF_DIR/queue/backup.pipe"
			check_result "$E_PARSING" "$error"
		fi

		# The archived line is appended verbatim, which keeps every field; the gate is the only addition. No remaps:
		# rebuild_mail_domain_conf honours SUSPENDED and the mail timestamps stay the archived ones.
		if [ -z "$check_config" ]; then
			archived_record=$(head -n1 "$tmpdir/mail/$domain/$BACKUP_CONTAINER/mail.conf")
			if ! record_line_valid "$archived_record"; then
				rm -rf $tmpdir
				error="$domain mail record is not a KEY='VALUE' line - refusing to restore it"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
			# An export translated for readers who do not speak our vocabulary; we do, so it goes back.
			if [ -n "$PROBE_EXPORT_MAP" ]; then
				_orig=$(awk -F'\t' -v d="$domain" '$1 == "mail" && $2 == d && $3 == "WEBMAIL" {print $4}' \
					"$PROBE_EXPORT_MAP")
				[ -n "$_orig" ] && record_set_field archived_record WEBMAIL "$_orig"
			fi
			record_zero_counters archived_record U_DISK
			echo "$archived_record" >> $USER_DATA/mail.conf
		fi

		if [ -e "$tmpdir/mail/$domain/$BACKUP_CONTAINER/$domain.pem" ]; then
			cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/$domain.pem $USER_DATA/mail/
			cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/$domain.pub $USER_DATA/mail/
		fi

		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf | grep -o "SSL='yes'")
		if [ -n "$check_config" ]; then
			if [ ! -e "$CONF_DIR/users/$user/ssl/" ]; then
				mkdir -p $CONF_DIR/users/$user/ssl/
			fi

			if [ ! -e "$HOMEDIR/$user/conf/mail/$domain/ssl/" ]; then
				mkdir -p $HOMEDIR/$user/conf/mail/$domain/ssl/
			fi

			if [ -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.crt ]; then
				cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi
			elif [ -f "$tmpdir/mail/$domain/conf/ssl/$domain.crt" ]; then
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/conf/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/conf/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi

			fi

			chmod 660 $USER_DATA/ssl/mail.$domain.*

			cp -f $USER_DATA/ssl/mail.$domain.crt $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt
			cp -f $USER_DATA/ssl/mail.$domain.key $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key
			cp -f $USER_DATA/ssl/mail.$domain.pem $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem
			if [ -e "$USER_DATA/ssl/mail.$domain.ca" ]; then
				cp -f $USER_DATA/ssl/mail.$domain.ca $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.ca
			fi

			if [ ! -d /etc/dovecot/conf.d/domains ]; then
				mkdir /etc/dovecot/conf.d/domains
			fi

			if [ -f /etc/dovecot/conf.d/domains/$domain.conf ]; then
				rm -f /etc/dovecot/conf.d/domains/$domain.conf
			fi

			dovecot_version="$(dovecot --version | cut -f -2 -d .)"
			if [[ "$dovecot_version" = "2.4" ]]; then
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_server_cert_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_server_key_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			else
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_cert = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_key = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			fi

			if [ ! -d $MAIL_SNI_DIR ]; then
				mkdir $MAIL_SNI_DIR
			fi

			find $MAIL_SNI_DIR -xtype l -delete

			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem $MAIL_SNI_DIR/mail.$domain.crt
			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key $MAIL_SNI_DIR/mail.$domain.key

			mail_ssl_modes "$user" "$domain"
		fi

		if [ -f "$tmpdir/mail/$domain/$BACKUP_CONTAINER/$domain.conf" ]; then
			restore_records_filter "$tmpdir/mail/$domain/$BACKUP_CONTAINER/$domain.conf" "$USER_DATA/mail/$domain.conf" \
				mail_accounts 2> >(tee -a "$tmpdir/restore.log" >&2)
		fi

		# The autoreply text is content nothing can recreate: restore both the record-side copy and the one exim reads,
		# or the account comes back with AUTOREPLY='yes' and no text.
		if compgen -G "$tmpdir/mail/$domain/$BACKUP_CONTAINER/*@$domain.msg" > /dev/null; then
			cp -f $tmpdir/mail/$domain/$BACKUP_CONTAINER/*@$domain.msg $USER_DATA/mail/
			chmod 660 $USER_DATA/mail/*@$domain.msg
		fi
		if compgen -G "$tmpdir/mail/$domain/conf/autoreply.*.msg" > /dev/null; then
			mkdir -p $HOMEDIR/$user/conf/mail/$domain
			cp -f $tmpdir/mail/$domain/conf/autoreply.*.msg $HOMEDIR/$user/conf/mail/$domain/
			chown $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/autoreply.*.msg
			chmod 660 $HOMEDIR/$user/conf/mail/$domain/autoreply.*.msg
		fi

		domain_idn=$domain
		format_domain_idn

		if [ ! -d "$HOMEDIR/$user/mail/$domain_idn" ]; then
			mkdir $HOMEDIR/$user/mail/$domain_idn
		fi

		chmod u+w "$HOMEDIR/$user/mail/$domain_idn"
		chown $user:$user "$HOMEDIR/$user/mail/$domain_idn"

		# Same two passes as web, through the extractor that drops privileges. Mail has no equivalent of the public_html
		# wipe, so a deletion does not take effect: the restore adds to the mailbox, as from a full archive.
		mail_whole="accounts.tar.zst"
		[ "$backup_mode" = 'zstd' ] || mail_whole="accounts.tar.gz"
		# No refusal, unlike web: a mail domain without accounts legitimately has no payload, and every use is guarded
		# by [ -e ].
		mail_member=$(backup_payload_path "$tmpdir/mail/$domain" "$mail_whole") || mail_member="$tmpdir/mail/$domain/$mail_whole"
		if [ -n "$DIFF_BASE" ] && [ -e "$mail_member" ] \
			&& backup_member_needs_base "$tmpdir/.diff/backup.members" "mail/$domain"; then
			# The base's member is a whole one whatever this archive calls its diff.
			mail_base=$(backup_diff_stage_base "$base_path" "mail/$domain" "$mail_whole" "$tmpdir/.diff")
			if [ -z "$mail_base" ]; then
				rm -rf $tmpdir
				error="$domain is differential and its base member is missing from $DIFF_BASE"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_NOTEXIST" "$error"
			fi
			backup_diff_keep_list "$base_path" "$tmpdir/.diff/backup.map" "mail/$domain" \
				"$mail_member" "$tmpdir/.diff/keep.mail.nul"
			chmod 644 "$tmpdir/.diff/keep.mail.nul" 2> /dev/null
			if [ -s "$tmpdir/.diff/keep.mail.nul" ]; then
				$BIN/h-extract-fs-archive "$user" "$mail_base" "$HOMEDIR/$user/mail/$domain_idn/" \
					'' '' '' "$tmpdir/.diff/keep.mail.nul"
			fi
		fi

		if [ -e "$mail_member" ]; then
			$BIN/h-extract-fs-archive "$user" "$mail_member" "$HOMEDIR/$user/mail/$domain_idn/"
			if [ "$?" -ne 0 ]; then
				rm -rf $tmpdir
				error="Can't unpack $domain mail account container"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi

			# The owner has to be user:mail, not user:user.
			find $HOMEDIR/$user/mail/$domain_idn -user $user \
				-exec chown -h $user:mail {} \;
		fi
		if [ -d "$HOMEDIR/$user/conf/mail/$domain" ]; then
			find $HOMEDIR/$user/conf/mail/$domain -user root \
				-exec chown $exim_user {} \;
		fi

		# Collected, not aborted: the other domains are still worth restoring, but the run is not a success.
		$BIN/h-rebuild-mail-domain "$user" "$domain" 2>&1 | tee -a "$tmpdir/restore.log"
		if [ "${PIPESTATUS[0]}" -ne 0 ]; then
			restore_failures="$restore_failures$(printf '\n  mail domain %s was not rebuilt' "$domain")"
		fi

	done 3< <(printf '%s\n' "$domains")

	$BIN/h-restart-web
	check_result $? "Web restart failed"
	if [ -n "$PROXY_SYSTEM" ]; then
		$BIN/h-restart-proxy
		check_result $? "Proxy restart failed"
	fi
fi

if [ "$db" != 'no' ] && [ -n "$DB_SYSTEM" ]; then
	echo -e "\n-- DB --" | tee -a $tmpdir/restore.log

	backup_databases=$(tar -tf "$backup_path" | grep "^./db")
	backup_databases=$(echo "$backup_databases" | grep db.conf)
	backup_databases=$(echo "$backup_databases" | cut -f 3 -d / | sort -u)
	if [ -z "$db" ] || [ "$db" = '*' ]; then
		databases="$backup_databases"
	else
		echo "$db" | tr ',' '\n' > $tmpdir/selected.txt
		databases=$(echo "$backup_databases" | grep -E -x -f $tmpdir/selected.txt)
	fi

	# Shared users: a slot whose user is not here yet waits for the database holding the password, and this run's
	# databases do not count as keeping a user's live password.
	REBUILD_DB_DEFER='yes'
	REBUILD_DB_DEFERRED=''
	REBUILD_DB_RUN_SET=''
	while IFS= read -r database; do
		[ -n "$database" ] && REBUILD_DB_RUN_SET="$REBUILD_DB_RUN_SET ${user}_${database#"${old_user}_"}"
	done <<< "$databases"

	# Same reasoning as the web loop.
	while IFS= read -r -u 3 database; do
		[ -n "$database" ] || continue
		echo -e "$(date "+%F %T") $database" | tee -a $tmpdir/restore.log

		# Decide the engine before anything is unpacked: the import below has no default branch, and dying mid-run
		# leaves the rest of the archive unrestored. Named as a failure and skipped, so the run goes on and still ends
		# non-zero.
		db_type=$(backup_db_type "$database")
		if ! backup_db_type_supported "$db_type"; then
			if [ -n "$db_type" ]; then
				db_why="this host does not run $db_type"
			else
				db_why="its record names no engine at all"
			fi
			echo "Warning!: $database skipped - $db_why" | tee -a $tmpdir/restore.log
			restore_failures="$restore_failures$(printf '\n  database %s (%s)' "$database" "$db_why")"
			continue
		fi

		# Derived from the record that set the keys: a hand list misses new keys, and a stale MD5 hid the 'no password'
		# warning.
		restore_forget_record prev_db_keys

		# Existence is checked against the name the record will carry, not the archived one: under another customer name
		# the exists-branch would be unreachable and a second restore would append everything again. Computed once: a
		# second derivation (`sed s/<old>_//` strips the first occurrence anywhere) disagrees on foo_<old>_shop.
		target_db="${user}_${database#"${old_user}_"}"
		check_config=$(grep -F "DB='$target_db'" $USER_DATA/db.conf)

		tar xf "$backup_path" -C $tmpdir ./db/$database
		if [ "$?" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $database database container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			queue_drop_job "$CONF_DIR/queue/backup.pipe"
			check_result "$E_PARSING" "$error"
		fi

		if [ -z "$check_config" ]; then
			# Same shape as web: the archived line is the record, only the named fields move.
			archived_record=$(head -n1 "$tmpdir/db/$database/$BACKUP_CONTAINER/db.conf")
			if ! record_line_valid "$archived_record"; then
				rm -rf $tmpdir
				error="$database db record is not a KEY='VALUE' line - refusing to restore it"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
			restore_parse_record prev_db_keys "$archived_record"

			# mysql judges this in the rebuild: a slot on a shared user has no hash of its own by design.
			if [ -z "$MD5" ] && [ "$TYPE" != 'mysql' ]; then
				echo "Warning!: Database ${DB} backup does not contain a password for user ${DBUSER}."
				echo "- Please use the web interface to set a password after the restore process finishes."
			fi

			# The same name the existence check used, not a second derivation of it.
			DB="$target_db"
			DBUSER="${user}_${DBUSER#"${old_user}_"}"
			# Another customer's database, or a pgsql name in their name space: clearing it below would drop it live.
			if ! db_names_free "$DB" "$DBUSER" "$TYPE" "$user"; then
				echo "Warning!: $target_db skipped - the name belongs to another customer" | tee -a $tmpdir/restore.log
				restore_failures="$restore_failures$(printf '\n  database %s (the name belongs to another customer)' "$target_db")"
				continue
			fi
			# Another customer's user: the rebuild would hand it this archive's password and grants.
			if db_user_foreign "$DBUSER" "$user"; then
				echo "Warning!: $target_db skipped - its user $DBUSER belongs to another customer" | tee -a $tmpdir/restore.log
				restore_failures="$restore_failures$(printf '\n  database %s (its user %s belongs to another customer)' "$target_db" "$DBUSER")"
				continue
			fi
			str="$archived_record"
			# The second slot comes back without a user that is not this customer's; the database itself still does.
			if [ -n "${DBUSER_SECOND:-}" ]; then
				DBUSER_SECOND="${user}_${DBUSER_SECOND#"${old_user}_"}"
				if db_user_foreign "$DBUSER_SECOND" "$user"; then
					echo "Warning!: $target_db comes back without its second user $DBUSER_SECOND - it belongs to another customer" | tee -a $tmpdir/restore.log
					restore_failures="$restore_failures$(printf '\n  database %s (its second user %s belongs to another customer, left out)' "$target_db" "$DBUSER_SECOND")"
					DBUSER_SECOND='' MD5_SECOND='' DBUSER_SECOND_RO=''
				fi
				record_set_field str DBUSER_SECOND "$DBUSER_SECOND"
				record_set_field str MD5_SECOND "$MD5_SECOND"
				record_set_field str DBUSER_SECOND_RO "$DBUSER_SECOND_RO"
			fi
			record_set_field str DB "$DB"
			record_set_field str DBUSER "$DBUSER"
			record_set_field str SUSPENDED 'no'
			record_set_field str TIME "$(date +%T)"
			record_set_field str DATE "$(date +%F)"
			for _k in $(record_keys "$archived_record"); do
				case " $(record_keys "$str" | tr '\n' ' ') " in
					*" $_k "*) : ;;
					*) echo "Warning!: $database db record lost key $_k during restore" | tee -a $tmpdir/restore.log ;;
				esac
			done
			record_zero_counters str U_DISK
			echo "$str" >> $USER_DATA/db.conf
			dbhost_count_record "$TYPE" "$HOST"
		else
			restore_parse_record prev_db_keys "$(grep -F "DB='$target_db'" $USER_DATA/db.conf)"
		fi

		if [ $backup_mode = 'zstd' ]; then
			# -q: pzstd reports every file's size on stderr, which reads like an error here.
			pzstd -q -d $tmpdir/db/$database/$database.*.sql.zst
		else
			gzip -d $tmpdir/db/$database/$database.*.sql.gz
		fi

		database_dump="$tmpdir/db/$database/$database.$TYPE.sql"
		# Reset per database, or the report names every database after the first one that lacked one.
		REBUILD_DB_UNUSABLE=''
		# Clear the name this customer will own, never the archived one: under a different customer name that one is
		# somebody else's live database.
		drop_rc=0
		case $TYPE in
			mysql)
				delete_mysql_database "$target_db" || drop_rc=$?
				;;
			pgsql)
				delete_pgsql_database "$target_db" || drop_rc=$?
				;;
		esac
		# Refused means the target was not emptied and importing would merge into it: named as a part that did not come
		# back. Branched rather than `continue`d: the loop body keeps one way out, so anything appended at its end runs
		# for every database.
		if [ "$drop_rc" -ne 0 ]; then
			# 1 is the ownership guard, 2 a DROP the server refused (an open session, say).
			if [ "$drop_rc" -eq 2 ]; then
				drop_why="the server refused to drop the existing database"
			else
				drop_why="it is not a database of $user"
			fi
			echo "Warning!: $target_db was not restored - $drop_why" | tee -a $tmpdir/restore.log
			restore_failures="$restore_failures$(printf '\n  database %s (refused: %s)' "$target_db" "$drop_why")"
		else
			import_rc=0
			case $TYPE in
				mysql)
					rebuild_mysql_database
					import_mysql_database $database_dump || import_rc=$?
					;;
				pgsql)
					rebuild_pgsql_database
					import_pgsql_database $database_dump || import_rc=$?
					;;
			esac
			# The client writes its output to /dev/null, so the exit code is the only signal; unchecked, a rejected dump
			# counted as restored.
			if [ "$import_rc" -ne 0 ]; then
				echo "Warning!: $target_db - the dump was not imported" | tee -a $tmpdir/restore.log
				restore_failures="$restore_failures$(printf '\n  database %s (the dump was rejected - the database is empty or incomplete)' "$target_db")"
			fi
			# Rows back but nothing able to connect is a degraded result, not a log line. Only the fresh-host case
			# reaches here; where a password was kept it stays a warning.
			if [ -n "$REBUILD_DB_UNUSABLE" ]; then
				restore_failures="$restore_failures$(printf '\n  database %s (restored without a password - set one before the application can connect)' "$target_db")"
			fi
		fi
	done 3< <(printf '%s\n' "$databases")

	# The waiting slots, now that every database of the run has created what it holds.
	REBUILD_DB_DEFER=''
	for deferred in $REBUILD_DB_DEFERRED; do
		target_db="${deferred%:*}"
		restore_forget_record prev_db_keys
		restore_parse_record prev_db_keys "$(grep -F "DB='$target_db'" $USER_DATA/db.conf)"
		REBUILD_DB_UNUSABLE=''
		rebuild_mysql_database_user "${deferred##*:}"
		slot_user="$DBUSER"
		[ "${deferred##*:}" != 2 ] || slot_user="$DBUSER_SECOND"
		if [ -n "$REBUILD_DB_UNUSABLE" ]; then
			restore_failures="$restore_failures$(printf '\n  database %s (its user %s came with no password, neither in this backup nor on this host)' "$target_db" "$slot_user")"
		fi
	done
	REBUILD_DB_RUN_SET=''
fi

if [ "$cron" != 'no' ] && [ -n "$CRON_SYSTEM" ]; then
	echo -e "\n-- CRON --" | tee -a $tmpdir/restore.log

	tar xf "$backup_path" -C $tmpdir ./cron
	if [ "$?" -ne 0 ]; then
		rm -rf $tmpdir
		error="Can't unpack cron container"
		echo "$error" | $SENDMAIL -s "$subj" $email $notify
		queue_drop_job "$CONF_DIR/queue/backup.pipe"
		check_result "$E_PARSING" "$error"
	fi

	sed -i 's/\r//g' $tmpdir/cron/cron.conf
	jobs=$(wc -l $tmpdir/cron/cron.conf | cut -f 1 -d' ')
	if [ "$jobs" -eq 1 ]; then
		echo -e "$(date "+%F %T") $jobs cron job" | tee -a $tmpdir/restore.log
	else
		echo -e "$(date "+%F %T") $jobs cron jobs" | tee -a $tmpdir/restore.log
	fi
	# HestiaCP before 1.9 kept its system jobs here; named, never rewritten, a rewrite would arm them twice.
	for job in $(sed -n "s|^JOB='\([0-9]*\)'.*/usr/local/hestia/bin/v-.*|\1|p" "$tmpdir/cron/cron.conf"); do
		echo "$(date "+%F %T") cron job $job calls a HestiaCP command that does not exist here" | tee -a $tmpdir/restore.log
	done

	restore_records_filter "$tmpdir/cron/cron.conf" "$USER_DATA/cron.conf" cron 2> >(tee -a "$tmpdir/restore.log" >&2) \
		|| echo "Warning!: the archived cron.conf could not be read, no jobs restored" | tee -a $tmpdir/restore.log

	sync_cron_jobs

	$BIN/h-restart-cron
	check_result $? "CRON restart failed"
fi

if [ "$udir" != 'no' ]; then
	echo -e "\n-- USER FILES --" | tee -a $tmpdir/restore.log

	if [ -n "$(tar -tf "$backup_path" | grep './user_dir')" ]; then

		# Names come from the directory the container unpacked into, not from `tar -t`: that ESCAPES a backslash or tab,
		# and the per-entry extraction then asked for a missing file and took the whole section down. One pass instead
		# of one per entry.
		tar xf "$backup_path" -C "$tmpdir" --no-wildcards "./user_dir" 2> /dev/null
		backup_dirs=$(cd "$tmpdir/user_dir" 2> /dev/null \
			&& find . -maxdepth 1 -type f \( -name '*.tar.zst' -o -name '*.tar.gz' \) -printf '%f\n' \
			| sed -e 's/\.tar\.zst$//' -e 's/\.tar\.gz$//' | sort)
		if [ -z "$udir" ] || [ "$udir" = '*' ]; then
			user_dirs="$backup_dirs"
		else
			echo "$udir" | tr ',' '\n' > $tmpdir/selected.txt
			user_dirs=$(echo "$backup_dirs" | grep -E -x -f $tmpdir/selected.txt)
		fi

		# A top-level home directory can be named anything, spaces included: the value is not even archive-shaped.
		while IFS= read -r -u 3 user_dir; do
			[ -n "$user_dir" ] || continue
			echo -e "$(date "+%F %T") $user_dir" | tee -a $tmpdir/restore.log
			if [ $backup_mode = 'zstd' ]; then
				udir_container="$tmpdir/user_dir/$user_dir.tar.zst"
			else
				udir_container="$tmpdir/user_dir/$user_dir.tar.gz"
			fi
			# One unreadable entry is named and the loop goes on. Nothing was written for it, so 'skipped' is the whole
			# truth; the two exits below are not.
			if [ ! -f "$udir_container" ]; then
				echo "Warning!: no container for home entry $user_dir - skipped" | tee -a $tmpdir/restore.log
				restore_failures="$restore_failures$(printf '\n  home entry %s (no container in the archive)' "$user_dir")"
				continue
			fi

			# The companion home belongs to the companion: the customer has no write bit in it and a non-root tar cannot
			# restore those owners. Root unpacks it with the daemon stopped, as restoring under a live rootless daemon
			# leaves it half-written.
			if [ "$user_dir" = '.companion' ]; then
				# A half-stopped daemon is exactly the state this branch exists to avoid.
				if ! companion_stop "$user"; then
					rm -rf $tmpdir
					error="Can't stop the docker companion of $user - restore would unpack over a live daemon"
					echo "$error" | $SENDMAIL -s "$subj" $email $notify
					queue_drop_job "$CONF_DIR/queue/backup.pipe"
					check_result "$E_PARSING" "$error"
				fi
				if [ $backup_mode = 'zstd' ]; then
					tar -I pzstd -xpf "$udir_container" -C "$HOMEDIR/$user"
				else
					tar -xpzf "$udir_container" -C "$HOMEDIR/$user"
				fi
				# Failing can mean tar stopped part way, so the entry is neither reliably restored nor untouched.
				# Nothing is removed (over an existing home that deletes data the archive only meant to add to), and
				# 'skipped' would claim more than is known.
				if [ "$?" -ne 0 ]; then
					echo "Warning!: unpacking home entry $user_dir failed - whatever it wrote is left as it is" | tee -a $tmpdir/restore.log
					restore_failures="$restore_failures$(printf '\n  home entry %s (unpacking failed, anything written is left as it is)' "$user_dir")"
				fi
				continue
			fi

			chown "$user" "$tmpdir/user_dir"
			chown "$user" "$HOMEDIR/$user"
			[ -e "$HOMEDIR/$user/$user_dir" ] && chown -h "$user" "$HOMEDIR/$user/$user_dir"
			$BIN/h-extract-fs-archive "$user" "$udir_container" "$HOMEDIR/$user"
			cmdstatus="$?"
			# Home stays user-owned: the pam_namespace jail needs no root flip.
			chown "$user:$user" "$HOMEDIR/$user"
			if [ "$cmdstatus" -ne 0 ]; then
				echo "Warning!: unpacking home entry $user_dir failed - whatever it wrote is left as it is" | tee -a $tmpdir/restore.log
				restore_failures="$restore_failures$(printf '\n  home entry %s (unpacking failed, anything written is left as it is)' "$user_dir")"
				continue
			fi

			# Quoted: $user_dir comes out of the archive, and unquoted a name with a space split into two paths.
			if [ "$old_uid" -ne "$new_uid" ]; then
				find "$HOMEDIR/$user/$user_dir" -user "$old_uid" \
					-exec chown -h "$user:$user" {} \;
			fi
		done 3< <(printf '%s\n' "$user_dirs")
	fi
fi

home_dir_own "$HOMEDIR/$user/tmp" "$user:$user" 700 \
	|| echo "Warning: $HOMEDIR/$user/tmp is not a directory, left as it is" | tee -a $tmpdir/restore.log

rm -f $HOMEDIR/$user/.ssh/hst-filemanager-key

# Re-enable Docker if the archive carried a companion home. The companion account is not in the archive and its uid
# follows the customer's, which was just reallocated, so it is recreated with fresh subordinate ranges; images are
# pulled. The grant is DOCKER_IP in the record; a directory in the home is the customer's to create.
if [ -d "$HOMEDIR/$user/.companion" ] && [ -n "$(get_user_value '$DOCKER_IP')" ] && [ -x "$BIN/h-add-user-docker" ]; then
	echo -e "$(date "+%F %T") docker companion" | tee -a $tmpdir/restore.log

	# Re-own BEFORE enabling: the unpacked tree still belongs to the archived companion uid and the rootless setup fails
	# against a home it cannot write. Both uids follow from the customer uid, so no metadata is needed.
	old_companion=$((old_uid - 1000))
	new_companion=$((new_uid - 1000))
	if [ "$old_companion" -ne "$new_companion" ]; then
		find "$HOMEDIR/$user/.companion" -uid "$old_companion" \
			-exec chown -h "$new_companion" {} \;
	fi

	# The archived /24 is kept when free, else h-add-user-docker allocates a new one: that has to be said, or an
	# application with hardcoded addresses finds out by breaking.
	docker_ip_archived=$(get_user_value '$DOCKER_IP')
	# tee, and the status from PIPESTATUS: through a pipe `if !` would read tee's.
	"$BIN/h-add-user-docker" "$user" 2>&1 | tee -a $tmpdir/restore.log
	if [ "${PIPESTATUS[0]}" -ne 0 ]; then
		echo "Warning!: could not re-enable Docker for $user - see the log above." | tee -a $tmpdir/restore.log
		# The customer had docker and does not have it here: the same kind of loss as a section this box cannot take.
		restore_failures="$restore_failures$(printf '\n  docker for %s (could not be re-enabled on this host)' "$user")"
	else
		docker_ip_now=$(get_user_value '$DOCKER_IP')
		if [ -n "$docker_ip_archived" ] && [ "$docker_ip_archived" != "$docker_ip_now" ]; then
			echo "Warning!: the docker subnet moved from ${docker_ip_archived%.*}.0/24 to ${docker_ip_now%.*}.0/24 - an application with a hardcoded address needs its configuration updated" \
				| tee -a $tmpdir/restore.log
		fi
	fi
fi

if [ -n "$restore_failures" ]; then
	subj="$user → restore finished with failures"
	echo "The following parts did not come back:$restore_failures" | tee -a $tmpdir/restore.log
else
	subj="$user → restore has been completed"
fi
cat $tmpdir/restore.log | $SENDMAIL -s "$subj" $email $notify

$BIN/h-add-user-notification "$user" "Backup restored successfully" "<p><span class='u-text-bold'>Archive:</span> <code>$backup</code></p>"

rm -rf $tmpdir

sed -i "/h-restore-user $user /d" $CONF_DIR/queue/backup.pipe

# Adopt the archive restored from, or it stays unlisted and rotatable. Last, because the restore may create the account.
# -qF: the archive name carries dots, which as a regex match any character.
if ! grep -qF "BACKUP='$backup'" "$USER_DATA/backup.conf" 2> /dev/null; then
	if ! $BIN/h-add-user-backup "$user" "$backup"; then
		# Never fatal, the restore is done either way. Said out loud because the archive stays unlisted and, in the
		# customer folder, rotatable until someone adopts it.
		echo "Warning: $backup could not be adopted - it stays unlisted and, in $BACKUP/$user, rotatable"
	fi
fi

# A restore creates domains without the add commands (rebuild-based), so it must close the jail lifecycle itself.
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
declare -F fail2ban_regate_web_apply > /dev/null 2>&1 || source "$HESTIA/include/fail2ban.sh"
fail2ban_regate_web_apply

$BIN/h-log-action "system" "Info" "Backup" "Restored backup contents (User: $user, Archive: $backup)."
$BIN/h-log-action "$user" "Info" "Backup" "Restored backup contents (Archive: $backup)."

# A run that lost a part is not a successful run, whatever the individual steps printed.
if [ -n "$restore_failures" ]; then
	check_result "$E_PARSING" "restore of $user finished with failures:$restore_failures"
fi

log_event "$OK" "$ARGUMENTS"

exit

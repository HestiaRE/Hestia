#!/bin/bash
# info: restore user via Restic
# options: USER SNAPSHOT KEY [NOTIFY]
#
# example: h-restore-user-full-restic user snapshot key
#
# Full user restore from a non existing user

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
key=${3}
notify=${4-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT KEY [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user'

is_restic_repo_configured

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

check_user=$(is_object_valid 'user' 'USER' "$user")

if [ -n "$check_user" ]; then
	if [ -z "$key" ]; then
		check_result "$E_PASSWORD" "Invalid Restic encryption key"
	fi
	$BIN/h-add-user "$user" "$key" 'info@hestiacp.com'

	echo "$key" > $USER_DATA/restic.conf

	restic --repo "$REPO$user" --password-file $USER_DATA/restic.conf snapshots
	if [ "$?" -ne 0 ]; then
		check_result "$E_PASSWORD" "Invalid Restic repository / encryption key"
	fi
fi

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT

# The metadata travels as the package beside the repository since stage 2a, not inside the snapshot.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
restic_meta_cat "$meta_pkg" backup.conf > "$tmpdir/backup.conf"
if [ ! -s "$tmpdir/backup.conf" ]; then
	check_result "$E_PARSING" "$meta_pkg carries no backup.conf - the snapshot cannot be described"
fi
restic_meta_unpack "$meta_pkg" "$tmpdir" ./hestia ./pam

# Filtered, not copied: the archive is hostile input (#807).
copy_record_filtered "$tmpdir/hestia/user.conf" "$USER_DATA/user.conf" user \
	|| check_result "$E_PARSING" "the archived user.conf of $user carries no usable keys"
cp -r "$tmpdir/hestia/ssl" "$USER_DATA/" > /dev/null 2>&1
# Filtered like user.conf: it runs through source_conf later, and an absent one is normal (#807).
if [ -f "$tmpdir/hestia/backup-excludes.conf" ]; then
	copy_record_filtered "$tmpdir/hestia/backup-excludes.conf" \
		"$USER_DATA/backup-excludes.conf" backup_excludes \
		|| echo "Warning: the archived backup-excludes.conf carries no usable keys and was skipped"
fi

# Without it every chown below matches nothing and the home stays owned by the old uid.
if ! restore_passwd_read "$tmpdir/pam/passwd"; then
	check_result "$E_PARSING" "$meta_pkg carries no valid pam/passwd entry, the old owner cannot be read"
fi
# Rebuilding user
rebuild_user_conf

# Restore web domains
# A failed part does not stop the rest, but the run must not end as a success.
failed=''
# A section this host does not run is skipped, as in h-restore-user: not a failed part.
if [ -n "$WEB_SYSTEM" ]; then
	echo "[ * ] Restore Web domains"
	$BIN/h-restore-web-domain-restic "$user" "$snapshot" '*' 'no' 'yes' || failed="$failed web"
fi
if [ -n "$MAIL_SYSTEM" ]; then
	echo "[ * ] Restore Mail domains"
	$BIN/h-restore-mail-domain-restic "$user" "$snapshot" '*' || failed="$failed mail"
fi
if [ -n "$DB_SYSTEM" ]; then
	echo "[ * ] Restore Databases"
	$BIN/h-restore-database-restic "$user" "$snapshot" '*' || failed="$failed db"
fi
echo "[ * ] Restore Cronjobs"
$BIN/h-restore-cron-job-restic "$user" "$snapshot" || failed="$failed cron"
echo "[ * ] Restore user files"
# The stage is root-owned raw dumps: the database restore takes them from the snapshot itself.
restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" \
	--exclude "/home/$user/web/" --exclude "/home/$user/conf" --exclude "/home/$user/mail" \
	--exclude "$(restic_dump_dir "$user")" --target /
if [ "$?" -ne 0 ]; then
	check_result "$E_NOTEXIST" "Unable to download user folders"
fi

find $HOMEDIR/$user/ -user $old_uid \
	-exec chown -h "$user":"$user" {} \;

find $HOMEDIR/$user/ -group $old_uid \
	-exec chown -h "$user":"$user" {} \;

# Rebuilding user
rebuild_user_conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Update user counters
$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-user-full-restic '$user' /d" $CONF_DIR/queue/backup.pipe

if [ -n "$failed" ]; then
	$BIN/h-log-action "system" "Warning" "Backup" "Restore incomplete, failed:$failed (User: $user, Snapshot: $snapshot)."
	check_result "$E_BACKUP" "restore of $user from $snapshot incomplete, failed:$failed"
fi

# Logging
$BIN/h-log-action "system" "Info" "Backup" "User successfully restored from scratch (User: $user, Snapshot: $snapshot)."
$BIN/h-log-action "$user" "Info" "Backup" "User successfully restored from scratch (User: $user, Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit

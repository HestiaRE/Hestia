#!/bin/bash
# info: restore user from a restic snapshot
# options: USER SNAPSHOT [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]
#
# example: h-restore-user-restic user latest
#
# Restores a customer from a restic snapshot and its metadata package.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
# An OMITTED selector means everything, an explicitly empty one means nothing - hence `-` and not
# `:-`, so a caller can still skip a section by passing ''. Without the defaults, `h-restore-user-restic
# user snapshot` matched no object at all and reported success (upstream #5709).
# The `*` is literal: the right-hand side of an assignment is not glob-expanded.
web=${3-*}
dns=$4 # no DNS subsystem here; the slot stays for signature parity
mail=${5-*}
db=${6-*}
cron=${7-yes}
udir=${8-yes}
notify=${9-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

is_restic_repo_configured

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

tmpdir=$(mktemp -p /home/$user/tmp/ -d)
trap 'rm -rf "$tmpdir"' EXIT

# The metadata travels as the package beside the repository since stage 2a, not inside the snapshot.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
restic_meta_cat "$meta_pkg" backup.conf > "$tmpdir/backup.conf"
if [ ! -s "$tmpdir/backup.conf" ]; then
	check_result "$E_PARSING" "$meta_pkg carries no backup.conf - the snapshot cannot be described"
fi

# Restore web domains
echo "[ * ] Restore Web domains"
$BIN/h-restore-web-domain-restic "$user" "$snapshot" "$web" 'no'
echo "[ * ] Restore Mail domains"
$BIN/h-restore-mail-domain-restic "$user" "$snapshot" "$mail"
echo "[ * ] Restore Databases"
$BIN/h-restore-database-restic "$user" "$snapshot" "$db"
if [ -n "$cron" ]; then
	echo "[ * ] Restore Cronjobs"
	$BIN/h-restore-cron-job-restic "$user" "$snapshot"
fi
if [ "$udir" = "yes" ]; then
	echo "[ * ] Restore user files"
	# The stage is root-owned raw dumps: the database restore takes them from the snapshot itself.
	restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" \
		--exclude "/home/$user/web/" --exclude "/home/$user/conf" --exclude "/home/$user/mail" \
		--exclude "$(restic_dump_dir "$user")" --target /
	if [ "$?" -ne 0 ]; then
		check_result "$E_NOTEXIST" "Unable to download user folders"
	fi
fi

# Rebuilding user
rebuild_user_conf

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Update user counters
$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-user-restic '$user' '$snapshot' /d" $CONF_DIR/queue/backup.pipe

# Logging
$BIN/h-log-action "system" "Info" "Backup" "User successfully restored (User: $user, Snapshot: $snapshot)."
$BIN/h-log-action "$user" "Info" "Backup" "User successfully restored (User: $user, Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit

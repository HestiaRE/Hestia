#!/bin/bash
# info: restore single web domain
# options: USER BACKUP DOMAIN [NOTIFY]
#
# example: h-restore-web-domain USER BACKUP DOMAIN [NOTIFY]
#
# Restores one web domain from a backup archive through h-restore-user.

user=$1
backup=$2
domain=$3
notify=$4

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

args_usage='USER BACKUP DOMAIN [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'backup'

$BIN/h-restore-user "$user" "$backup" "$domain" 'no' 'no' 'no' 'no' 'no' "$notify"

log_event "$OK" "$ARGUMENTS"

exit

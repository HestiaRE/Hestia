#!/bin/bash
# info: restore WEB domain
# options: USER SNAPSHOT DOMAIN [NOTIFY] [NEW_USER]
#
# example: h-restore-web-domain-restic user snapshot domain.com
# example: h-restore-web-domain-restic user snapshot 'domain.com,domain2.com'
# example: h-restore-web-domain-restic user snapshot '*'
#
# Restores web domains from a restic snapshot.

user=$1
snapshot=$2
web=$3
notify=${4-no}
new_user=${5-no}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/backup.sh
source $HESTIA/include/backup.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/rebuild.sh
source $HESTIA/include/rebuild.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

# This run's own queue line, for the abort path (see queue_drop_job).
QUEUE_JOB="h-restore-web-domain-restic '$user' '$snapshot' '$web'"

args_usage='USER SNAPSHOT DOMAIN [NOTIFY] [NEW_USER]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
subj="$user → restore failed"
email=$(get_user_value '$CONTACT')

is_restic_repo_configured

tmpdir=$(mktemp -p "${BACKUP_TEMP:-$BACKUP}" -d) || check_result "$E_NOTEXIST" "Can't create tmp dir"
trap 'rm -rf "$tmpdir"' EXIT

# The metadata is the package beside the repository, not part of the snapshot.
meta_pkg=$(restic_pkg_for_snapshot "$user" "$snapshot")
if [ -z "$meta_pkg" ]; then
	check_result "$E_NOTEXIST" "no metadata package for snapshot $snapshot of $user - look for $BACKUP/$user/*.meta.tgz"
fi
restic_meta_cat "$meta_pkg" backup.conf > "$tmpdir/backup.conf"
if [ ! -s "$tmpdir/backup.conf" ]; then
	check_result "$E_PARSING" "$meta_pkg carries no backup.conf - the snapshot cannot be described"
fi
restic_meta_cat "$meta_pkg" pam/passwd > "$tmpdir/passwd"
# Without it every chown below matches nothing and the restored files keep the archived owner.
if ! restore_passwd_read "$tmpdir/passwd"; then
	check_result "$E_PARSING" "$meta_pkg carries no valid pam/passwd entry, the old owner cannot be read"
fi

domains=""
parse_object_kv_list "$(cat $tmpdir/backup.conf)"
# IFS is restored right away so later word splits are not collapsed; iterate the array, "$domains" is only element 0.
OLD_IFS="$IFS"
IFS=','
read -r -a domains_array <<< "$web"
read -r -a domains <<< "$WEB"
IFS="$OLD_IFS"
requested=",$(
	IFS=','
	echo "${domains_array[*]}"
),"
for domain in "${domains[@]}"; do
	if [[ "$web" = '*' || "$requested" == *",${domain},"* ]]; then
		unset -v DOMAIN IP IP6 ALIAS TPL SSL SSL_FORCE SSL_HSTS HTTP3 DOCKER DOCKER_PORT DOCKER_OCTET LETSENCRYPT FTP_USER FTP_MD5 FTP_PATH BACKEND PHP_VERSION PHP_PROFILE PROXY PROXY_EXT PROXY_CACHE PROXY_CACHE_DURATION FASTCGI_CACHE FASTCGI_DURATION REDIRECT REDIRECT_CODE STATS STATS_USER STATS_CRYPT U_DISK OFFLINE CUSTOM_DOCROOT CUSTOM_PHPROOT restore_web_effect restore_proxy_effect

		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'web' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				queue_drop_job "$CONF_DIR/queue/backup.pipe"
				check_result "$E_PARSING" "$error"
			fi
		fi
		restic_meta_unpack "$meta_pkg" "$tmpdir" "./web/$domain"
		if [ ! -s "$tmpdir/web/$domain/hestia/web.conf" ]; then
			check_result "$E_NOTEXIST" "$meta_pkg carries no record for web domain $domain"
		fi

		if [ -z "$check_config" ]; then
			# The archived line is the record, edited in place: a hand-listed field set drops unknown keys.
			archived_record=$(head -n1 "$tmpdir/web/$domain/hestia/web.conf")
			if ! record_line_valid "$archived_record"; then
				check_result "$E_PARSING" "$domain web record is not a KEY='VALUE' line - refusing to restore it"
			fi
			restore_parse_record prev_web_keys "$archived_record"

			# The list is archive content: filtered in the shell, never spliced into a sed program.
			IFS=, read -ra _dom_alias_list <<< "$ALIAS"
			ALIAS=''
			for dom_alias in "${_dom_alias_list[@]}"; do
				[ -n "$dom_alias" ] || continue
				if ! restore_quiet is_alias_format_valid "$dom_alias"; then
					echo "Warning: $domain alias $dom_alias is not an alias name, dropped"
					continue
				fi
				check_new=$(is_domain_new 'web' "$dom_alias")
				[ -n "$check_new" ] && continue
				ALIAS="${ALIAS:+$ALIAS,}$dom_alias"
			done

			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				local_ip=''
				get_user_ip $user
				old_ip=$IP
				IP=$ip
			fi
			if [ -n "$IP6" ] && [ ! -e "$CONF_DIR/ips/$IP6" ]; then
				if get_user_ip6; then
					IP6="$ip6"
				else
					IP6=''
				fi
			fi

			# Templates through the legacy mapping (see h-restore-user)
			read -r TPL restore_web_effect <<< "$(accept_web_template 'web' "$TPL")"
			read -r PROXY restore_proxy_effect <<< "$(accept_web_template 'proxy' "$PROXY")"
			# Native PHP_VERSION/PHP_PROFILE win; else derive from the compat BACKEND (see h-restore-user)
			if [ -n "$WEB_BACKEND" ]; then
				if [ -z "$PHP_VERSION" ]; then
					if [[ "$BACKEND" =~ PHP-([0-9]+)_([0-9]+) ]]; then
						PHP_VERSION="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
					elif [ "$BACKEND" = 'no-php' ]; then
						PHP_VERSION='none'
					else
						PHP_VERSION=$(multiphp_default_version)
					fi
				fi
				# Valid profiles are the shipped pool templates (custom ones included); default otherwise
				if [[ "$PHP_PROFILE" =~ ^[a-zA-Z0-9_-]+$ ]] && [ -f "$PHPTPL/$PHP_PROFILE.tpl" ]; then BACKEND="$PHP_PROFILE"; else BACKEND='default'; fi
				# Abort when this host lacks the archived version, unless the fallback to the default was requested.
				if [ "$PHP_VERSION" != 'none' ] && ! restore_php_installed "$PHP_VERSION"; then
					if [ "$RESTORE_PHP_FALLBACK" = 'yes' ]; then
						echo "Warning: archived PHP version $PHP_VERSION not installed, using the system default ($(multiphp_default_version))."
						PHP_VERSION=$(multiphp_default_version)
					else
						check_result "$E_NOTEXIST" "archived PHP version $PHP_VERSION not installed (install it, or re-run with RESTORE_PHP_FALLBACK=yes)"
					fi
				fi
			else
				read -r BACKEND _ <<< "$(accept_web_template 'backend' "$BACKEND")"
			fi

			if [ -n "$CUSTOM_DOCROOT" ]; then
				CUSTOM_DOCROOT=${CUSTOM_DOCROOT//"/home/$old_user/web/"/"/home/$user/web/"}
			fi
			if [ -n "$CUSTOM_PHPROOT" ]; then
				CUSTOM_PHPROOT=${CUSTOM_PHPROOT//"/home/$old_user/web/"/"/home/$user/web/"}
			fi

			# Per entry and anchored, as in h-restore-user: the field is a colon list.
			if [ -n "$FTP_USER" ]; then
				IFS=':' read -r -a _ftp_list <<< "$FTP_USER"
				FTP_USER=''
				for _f in "${_ftp_list[@]}"; do
					[ -n "$_f" ] || continue
					FTP_USER="${FTP_USER:+$FTP_USER:}${user}_${_f#"${old_user}_"}"
				done
			fi
			if [ "$SSL" = 'yes' ]; then

				if [ -f "$tmpdir/web/$domain/hestia/$domain.crt" ]; then
					cp -f "$tmpdir/web/$domain/hestia/$domain.crt" "$USER_DATA/ssl/"
					if [ -f "$tmpdir/web/$domain/hestia/$domain.ca" ]; then
						cp -f "$tmpdir/web/$domain/hestia/$domain.ca" "$USER_DATA/ssl/"
					fi
					if [ -f "$tmpdir/web/$domain/hestia/$domain.pem" ]; then
						cp -f "$tmpdir/web/$domain/hestia/$domain.pem" "$USER_DATA/ssl/"
					fi
					if [ -f "$tmpdir/web/$domain/hestia/$domain.key" ]; then
						cp -f "$tmpdir/web/$domain/hestia/$domain.key" "$USER_DATA/ssl/"
					fi
				fi
			fi

			# A mapped -http3 template becomes the http3 switch; capability is reconciled at rebuild
			if [ "$restore_web_effect" = 'http3' ] || [ "$restore_proxy_effect" = 'http3' ]; then
				HTTP3='yes'
			fi

			# The archived record is the base and only the fields below are rewritten, so unknown keys survive.
			str="$archived_record"
			record_set_field str DOMAIN "$domain"
			record_set_field str IP "$IP"
			record_set_field str IP6 "$IP6"
			record_set_field str ALIAS "$ALIAS"
			record_set_field str TPL "$TPL"
			record_set_field str PROXY "$PROXY"
			record_set_field str HTTP3 "$HTTP3"
			record_set_field str BACKEND "$BACKEND"
			record_set_field str PHP_VERSION "$PHP_VERSION"
			record_set_field str FTP_USER "$FTP_USER"
			record_set_field str CUSTOM_DOCROOT "$CUSTOM_DOCROOT"
			record_set_field str CUSTOM_PHPROOT "$CUSTOM_PHPROOT"
			record_set_field str U_BANDWIDTH '0'
			# SUSPENDED stays as archived: vhost writers use prepare_web_domain_values, so 'yes' is served locked.
			record_set_field str TIME "$(date +%T)"
			record_set_field str DATE "$(date +%F)"
			# PHP_PROFILE exists only inside the package; live records carry it as BACKEND.
			record_del_field str PHP_PROFILE

			# Derived from the archived record, so the reference set cannot shrink to nothing.
			restored_keys=" $(record_keys "$str" | tr '\n' ' ') "
			for _k in $(record_keys "$archived_record"); do
				case "$_k" in PHP_PROFILE) continue ;; esac
				case "$restored_keys" in
					*" $_k "*) : ;;
					*) echo "Warning!: $domain web record lost key $_k during restore" ;;
				esac
			done
			# Not in a pipe: the check edits str and the parsed fields in this shell.
			restore_web_fields_check str > "$tmpdir/web-fields.msg"
			while IFS= read -r _m; do
				echo "Warning: $domain $_m"
			done < "$tmpdir/web-fields.msg"
			record_zero_counters str U_DISK U_BANDWIDTH
			echo "$str" >> $USER_DATA/web.conf

			if [ "$restore_proxy_effect" = 'cache' ] && [ "$PROXY_SYSTEM" = 'nginx' ]; then
				$BIN/h-add-web-domain-cache "$user" "$domain" > /dev/null 2>&1
			fi

			if [ -n "$WEB_BACKEND" ]; then
				$BIN/h-add-web-domain-backend $user $domain $BACKEND
			fi

		fi

		if [ ! -d "$HOMEDIR/$user/conf/web/$domain/" ]; then
			mkdir -p $HOMEDIR/$user/conf/web/$domain/
		fi
		for file in "$tmpdir/web/$domain/conf"/*; do
			[ -e "$file" ] || continue
			if [[ "$file" == *.ca ]] || [[ "$file" == *.crt ]] || [[ "$file" == *.key ]] || [[ "$file" == *.pem ]] || [[ "$file" == *.conf ]]; then
				continue
			fi
			if grep "fastcgi_pass" "$file"; then
				# Do not allow to run php under a different user
				continue
			fi
			filename=$(basename "$file")
			cp -f "$file" "$HOMEDIR/$user/conf/web/$domain/$filename"
		done

		rebuild_web_domain_conf

		# As the customer, from /: same wipe as h-restore-user.
		if [ -d "$HOMEDIR/$user/web/$domain/public_html" ]; then
			(cd / && user_exec find "$HOMEDIR/$user/web/$domain/public_html" -mindepth 1 -maxdepth 1 ! -name '.*' \
				-exec rm -rf {} +)
		fi

		[[ -d $HOMEDIR/$user/web/$domain/stats ]] && chmod u+w "$HOMEDIR/$user/web/$domain/stats"

		# restic will not write over an existing symlink, and the rebuild just created the log links.
		find "$HOMEDIR/$user/web/$domain/logs" -maxdepth 1 -type l -delete 2> /dev/null
		restic --repo "$REPO$user" --password-file "$USER_DATA/restic.conf" restore "$snapshot" \
			--include "/home/$user/web/$domain" --target /
		if [ "$?" -ne 0 ]; then
			check_result "$E_NOTEXIST" "Unable to download user data"
		fi
		# The links return only if the snapshot carries them; the rebuild is the one owner of recreating them.
		if [ ! -L "$HOMEDIR/$user/web/$domain/logs/$domain.log" ] \
			|| [ ! -L "$HOMEDIR/$user/web/$domain/logs/$domain.error.log" ]; then
			rebuild_web_domain_conf
		fi
		if [ "$new_user" = "yes" ]; then
			echo "[ * ] Fix permissions"
			chown --no-dereference $user:$user \
				$HOMEDIR/$user/ \
				$HOMEDIR/$user/web/ \
				$HOMEDIR/$user/web/$domain \
				$HOMEDIR/$user/web/$domain/private \
				$HOMEDIR/$user/web/$domain/cgi-bin \
				$HOMEDIR/$user/web/$domain/public_*html \
				$HOMEDIR/$user/web/$domain/logs \
				$HOMEDIR/$user/web/$domain/stats

			chown -R $user:$user $HOMEDIR/$user/web/$domain/document_errors
			web_domain_logs "$domain" | while IFS= read -r f; do chown root:"$user" "$f"; done
		fi
		# Second rebuild so ftp users keep working; it also reconciles the http3 quic fragment from the HTTP3 field.
		rebuild_web_domain_conf

	fi
done
if [ "$new_user" = "yes" ]; then
	rebuild_user_conf
fi
rm -fr $tmpdir

# Rebuilt vhosts are not served until the servers reload.
$BIN/h-restart-web
check_result $? "Web restart failed"
if [ -n "$PROXY_SYSTEM" ]; then
	$BIN/h-restart-proxy
	check_result $? "Proxy restart failed"
fi

$BIN/h-update-user-counters $user
$BIN/h-update-user-counters "$ROOT_USER"
$BIN/h-update-sys-ip-counters

sed -i "/h-restore-web-domain-restic '$user' '$snapshot' '$web' /d" $CONF_DIR/queue/backup.pipe

$BIN/h-log-action "system" "Info" "Backup" "Web domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $web)."
$BIN/h-log-action "$user" "Info" "Backup" "Web domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $web)."
log_event "$OK" "$ARGUMENTS"
exit

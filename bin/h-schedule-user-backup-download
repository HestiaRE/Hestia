#!/bin/bash
# info: Schedule a backup
# options: USER BACKUP
#
# example: h-schedule-user-backup-download admin 2019-04-22_01-00-00.tar
#
# Queues the download of an existing backup archive into the customer's backup folder.

user=$1
backup=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER BACKUP'
is_format_valid 'user' 'backup'
is_object_valid 'user' 'USER' "$user"
# The record is the ownership: another customer's archive must not be fetched into this customer-readable folder.
if ! grep -qF "BACKUP='$backup'" "$USER_DATA/backup.conf" 2> /dev/null; then
	check_result "$E_NOTEXIST" "no record of $backup for $user"
fi

echo "$BIN/h-download-backup $user $backup 2>&1" >> $CONF_DIR/queue/backup.pipe

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: search for available commands
# options: ARG1 [ARG...]
#
# example: h-search-command web
#
# This function searches for available Hestia Control Panel commands
# and returns results based on the specified criteria.
# Originally developed for VestaCP by Federico Krum
# <https://github.com/FastDigitalOceanDroplets/VestaCP/blob/master/files/h-search-command>

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#
if [ $# -eq 0 ]; then
	echo "ERROR: No search arguments specified."
	echo "Usage: h-search-command ARG1 [ARG2] [ARG...]"
	exit 1
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# h-* only: the v-* aliases listed every command twice. Internal ones are machinery, not operator tools.
commands=$(
	for f in "$BIN"/h-* "$SBIN"/h-*; do
		[ -e "$f" ] || continue
		grep -qm1 '^# labels:.*\binternal\b' "$f" && continue
		basename "$f"
	done | sort
)
TotalItems=$(echo "$commands" | grep -c .)
SearchResults="$commands"

for i in "$@"; do
	SearchResults=$(echo "$SearchResults" | grep -- "$i")
done
FoundItems=$(echo "$SearchResults" | grep -c .)

if [ -z "$SearchResults" ]; then
	echo "No available commands were found matching the specified criteria."
	echo "There are a total of $TotalItems commands available."
else
	echo "Command Search Results"
	echo "================================="
	echo "$SearchResults"
	echo "================================="
	echo "Found $FoundItems matching items in $TotalItems commands."
fi
exit

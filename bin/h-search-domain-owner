#!/bin/bash
# info: search domain owner
# options: DOMAIN [TYPE]
#
# example: h-search-domain-owner acme.com
#
# Prints the user who holds DOMAIN as a web or mail domain; TYPE narrows it to one.

domain=$1
type=${2-any}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'DOMAIN [TYPE]'

is_format_valid 'domain'

case $type in
	web) conf="$CONF_DIR/users/*/web.conf" ;;
	mail) conf="$CONF_DIR/users/*/mail.conf" ;;
	*) conf="$CONF_DIR/users/*/*.conf" ;;
esac

# The user from the path, not a fixed cut field: the field position moves with CONF_DIR.
owner=$(grep -HF "DOMAIN='$domain'" $conf | head -n 1 | sed -e "s|^$CONF_DIR/users/||" -e "s|/.*||")
if [ -z "$owner" ]; then
	exit "$E_NOTEXIST"
fi

echo "$owner"

exit

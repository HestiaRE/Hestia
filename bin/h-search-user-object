#!/bin/bash
# info: search objects
# options: USER OBJECT [FORMAT]
#
# example: h-search-user-object admin example.com json
#
# Searches a user's web, mail, database and cron records for a term.

user=$1
object=$2
format=${3-shell}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

json_list_search() {
	echo '{'
	fileds_count=$(echo $fields | wc -w)
	while read -r line; do
		parse_object_kv_list_non_eval "$line"
		if [ -n "$list_data" ]; then
			echo -e '        },'
		fi
		i=1
		IFS=' '
		for field in $fields; do
			fname=${field#\$}
			value=${!fname}
			# %quote% is the storage encoding for ' and is decoded here; escaping " is json_escape's job.
			value=$(record_value_decode "$value")
			if [ $i -eq 1 ]; then
				((++i))
				json_escape value
				printf '\t"%s": {\n' "$value"
			else
				if [ $i -lt "$fileds_count" ]; then
					((++i))
					json_escape field value
					printf '\t\t"%s": "%s",\n' "${field//$/}" "${value//,/, }"
				else
					json_escape field value
					printf '\t\t"%s": "%s"\n' "${field//$/}" "${value//,/, }"
					list_data=1
				fi
			fi
		done
	done < $conf
	if [ -n "$list_data" ]; then
		echo -e '        }'
	fi
	echo -e '}'
}

shell_list_search() {
	if [ -z "$nohead" ]; then
		echo "${fields//$/}"
		for a in $fields; do
			echo -e "------ \c"
		done
		echo
	fi
	while read line; do
		parse_object_kv_list_non_eval "$line"
		out="$fields"
		for field in $(grep -oE '\$[A-Za-z_][A-Za-z0-9_]*' <<< "$fields"); do
			fname=${field#\$}
			out=${out//$field/${!fname}}
		done
		printf '%s\n' "$(record_value_decode "$out")"
	done < $conf
}

check_args '2' "$#" 'USER OBJECT [FORMAT]'
is_format_valid 'user' 'object'
is_object_valid 'user' 'USER' "$user"

conf=$(mktemp)
i=0
OLD_IFS=$IFS
IFS=$'\n'

search=$(grep -H -F -e "$object" -- \
	$CONF_DIR/users/$user/web.conf \
	$CONF_DIR/users/$user/mail.conf \
	$CONF_DIR/users/$user/mail/*.conf \
	$CONF_DIR/users/$user/db.conf \
	$CONF_DIR/users/$user/cron.conf 2> /dev/null)

for row in $search; do
	key=''
	result=''
	dom_alias=''
	suspended=''
	object_link=''
	object_parent=''
	object_time=''
	object_date=''
	# The parser sets only the keys a row carries, so a row must not inherit the previous one's.
	unset DOMAIN ALIAS ACCOUNT DB CMD JOB SUSPENDED TIME DATE

	# path:record, and the record holds colons of its own (TIME, IPv6, URLs).
	type=$(echo "${row%%:*}" | sed "s|^$CONF_DIR/users/$user/||; s|/.*||")
	data="${row#*:}"
	# Without eval: a quote-breaking value in a record would run as root.
	parse_object_kv_list_non_eval "$data"

	if [ "$type" = 'web.conf' ]; then
		if [ -n "$(echo $DOMAIN | grep -F -e "$object")" ]; then
			check_alias="$(echo $ALIAS | tr ',' '\n' | grep -F -e "$object")"
			if [ -n "$check_alias" ]; then
				dom_alias=$(echo $check_alias | tr ' ' ',')
			fi
			key="DOMAIN"
			result="$DOMAIN"
			suspended=$SUSPENDED
			object_time=$TIME
			object_date=$DATE
			((i++))
		else
			check_alias="$(echo $ALIAS | tr ',' '\n' | grep -F -e "$object")"
			if [ -n "$check_alias" ]; then
				key="DOMAIN"
				result="$DOMAIN"
				object_parent="$DOMAIN"
				dom_alias=$(echo $check_alias | tr ' ' ',')
				suspended=$SUSPENDED
				object_time=$TIME
				object_date=$DATE
				((i++))
			fi
		fi
	fi

	if [ "$type" = 'mail.conf' ]; then
		if [ -n "$(echo $DOMAIN | grep -F -e "$object")" ]; then
			key="DOMAIN"
			result="$DOMAIN"
			suspended=$SUSPENDED
			object_time=$TIME
			object_date=$DATE
			((i++))
		fi
	fi

	if [ "$type" = 'mail' ]; then
		type='mail'
		if [ -n "$(echo $ACCOUNT | grep -F -e "$object")" ]; then
			key="ACCOUNT"
			dom="$(echo $row | cut -f 1 -d : | sed "s|.*/||; s|\.conf$||")"
			result="$ACCOUNT@$dom"
			suspended=$SUSPENDED
			object_link=$ACCOUNT
			object_parent=$dom
			object_time=$TIME
			object_date=$DATE
			((i++))
		fi
	fi

	if [ "$type" = 'db.conf' ]; then
		if [ -n "$(echo $DB | grep -F -e "$object")" ]; then
			key="DATABASE"
			result="$DB"
			suspended=$SUSPENDED
			object_time=$TIME
			object_date=$DATE
			((i++))
		fi
	fi

	if [ "$type" = 'cron.conf' ]; then
		if [ -n "$(echo $CMD | grep -F -e "$object")" ]; then
			key="JOB"
			result="$CMD"
			suspended=$SUSPENDED
			object_link=$JOB
			object_parent=$JOB
			object_time=$TIME
			object_date=$DATE
			((i++))
		fi
	fi

	if [ -n "$result" ]; then
		type=$(echo $type | cut -f1 -d \.)
		str="ID='$i' USER='$user' TYPE='$type' KEY='$key'"
		str="$str RESULT='$result' ALIAS='$dom_alias'"
		str="$str LINK='$object_link' PARENT='$object_parent'"
		str="$str SUSPENDED='$suspended' TIME='$object_time'"
		str="$str DATE='$object_date'"
		echo $str >> $conf
	fi
done

IFS=$OLD_IFS

fields='$ID $USER $TYPE $KEY $RESULT $ALIAS $LINK $PARENT $SUSPENDED $TIME'
fields="$fields \$DATE"

case $format in
	json) json_list_search ;;
	plain)
		nohead=1
		shell_list_search
		;;
	shell)
		fields='$USER~$TYPE~$KEY~$RESULT~$ALIAS'
		shell_list_search | column -t -s '~'
		;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

rm $conf

exit

#!/bin/bash
# info: start service
# options: SERVICE
#
# example: h-start-service mysql
#
# Starts a unit, every customer PHP-FPM for php-fpm, or reapplies the firewall.

service=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'SERVICE'
is_format_valid 'service'

if [ "$service" = "php-fpm" ]; then
	for php_ver in $(multiphp_versions); do
		service_list="${service_list} php${php_ver}-fpm"
	done
else
	service_list="$service"
fi

for service in $service_list; do
	# Compared to FIREWALL_SYSTEM, never a literal: systemctl on the distro nftables unit tears our ruleset down.
	if [ -n "$FIREWALL_SYSTEM" ] && [ "$service" = "$FIREWALL_SYSTEM" ]; then
		$BIN/h-update-firewall
		result=$?
	else
		systemctl start "$service"
		result=$?
		if [ "$result" -ne 0 ]; then
			$BIN/h-log-action "system" "Error" "System" "Service failed to start (Name: $service)."
		else
			$BIN/h-log-action "system" "Info" "System" "Service started (Name: $service)."
		fi
	fi
	check_result "$result" "ERROR: $service start failed" "$E_RESTART"
done

log_event "$OK" "$ARGUMENTS"

exit

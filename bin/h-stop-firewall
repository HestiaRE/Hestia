#!/bin/bash
# info: stop system firewall
# options: NONE
#
# example: h-stop-firewall
#
# Drops the HestiaRE nft table and stands down the boot unit that would load it again.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source $HESTIA/include/firewall.sh
source_conf "$HESTIA/conf/hestia.conf"

fw_table_destroy

# A box mid-migration may still carry the old iptables ruleset, which would keep being evaluated.
fw_legacy_teardown

fw_persist_disable

exit

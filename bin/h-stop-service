#!/bin/bash
# info: stop service
# options: SERVICE
#
# example: h-stop-service apache2
#
# This function stops system service.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
service=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'SERVICE'
is_format_valid 'service'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$service" = "php-fpm" ]; then
	for php_ver in $(multiphp_versions); do
		service_list="${service_list} php${php_ver}-fpm"
	done
else
	service_list="$service"
fi

for service in $service_list; do
	# The firewall is not a systemd unit for us - it is our own ruleset, and the service NAME follows
	# FIREWALL_SYSTEM. Matching a hardcoded "iptables" here broke the moment that value became
	# "nftables": the panel's firewall row fell through to systemctl and restarted the DISTRO
	# nftables unit, which tore our table down and loaded /etc/nftables.conf instead.
	if [ -n "$FIREWALL_SYSTEM" ] && [ "$service" = "$FIREWALL_SYSTEM" ]; then
		$BIN/h-stop-firewall
		result=$?
	else
		systemctl stop "$service"
		result=$?
		if [ "$result" -ne 0 ]; then
			$BIN/h-log-action "system" "Error" "System" "Service failed to stop (Name: $service)."
		else
			$BIN/h-log-action "system" "Info" "System" "Service stopped (Name: $service)."
		fi
	fi
	check_result "$result" "ERROR: $service stop failed" "$E_RESTART"

done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

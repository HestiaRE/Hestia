#!/bin/bash
# info: suspend cron job
# options: USER JOB [RESTART]
#
# example: h-suspend-cron-job admin 5 yes
#
# The job stays in cron.conf but leaves the crontab until it is unsuspended.

user=$1
job=$2
restart=$3

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER JOB [RESTART]'
is_format_valid 'user' 'job' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'cron' 'JOB' "$job"
is_object_unsuspended 'cron' 'JOB' "$job"

update_object_value 'cron' 'JOB' "$job" '$SUSPENDED' 'yes'
increase_user_value "$user" '$SUSPENDED_CRON'

sync_cron_jobs

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

$BIN/h-log-action "system" "Info" "Cron Jobs" "Cron job suspended (Job: $job)."
log_event "$OK" "$ARGUMENTS"

exit

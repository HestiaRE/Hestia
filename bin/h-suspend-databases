#!/bin/bash
# info: suspend databases
# options: USER
#
# example: h-suspend-databases admin
#
# Suspends all databases of USER.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"

failed=''
for database in $(search_objects 'db' 'SUSPENDED' "no" 'DB'); do
	$BIN/h-suspend-database "$user" "$database" || failed="$failed $database"
done
[ -z "$failed" ] || check_result "$E_DB" "not suspended:$failed"

log_event "$OK" "$ARGUMENTS"

exit

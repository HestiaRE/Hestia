#!/bin/bash
# info: suspend web/mail domain
# options: USER DOMAIN [RESTART]
#
# example: h-suspend-domain admin example.com
#
# Suspends the web and the mail domain of that name, whichever are active.

user=$1
domain=$2
restart="${3-yes}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

if [ -n "$WEB_SYSTEM" ]; then
	str=$(grep -F "DOMAIN='$domain'" "$USER_DATA/web.conf" | grep "SUSPENDED='no")
	if [ -n "$str" ]; then
		domain_found='yes'
		$BIN/h-suspend-web-domain "$user" "$domain" "no"
		check_result $? "can't suspend web" > /dev/null
	fi
fi

if [ -n "$MAIL_SYSTEM" ]; then
	str=$(grep -F "DOMAIN='$domain'" "$USER_DATA/mail.conf" | grep "SUSPENDED='no")
	if [ -n "$str" ]; then
		domain_found='yes'
		$BIN/h-suspend-mail-domain "$user" "$domain" "no"
		check_result $? "can't suspend mail" > /dev/null
	fi
fi

if [ -z "$domain_found" ]; then
	echo "Error: domain $domain doesn't exist"
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi

$BIN/h-restart-web "$restart"
check_result $? "can't restart web" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "can't restart proxy" > /dev/null

exit

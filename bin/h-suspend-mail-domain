#!/bin/bash
# info: suspend mail domain
# options: USER DOMAIN
#
# example: h-suspend-mail-domain admin domain.com
#
# Stops delivery and login for the domain and takes its webmail down; the accounts keep their own state.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	# The link carries the punycode name; a unicode-named one can only be a stray, so it goes as well.
	rm -f "/etc/$MAIL_SYSTEM/domains/$domain_idn" "/etc/$MAIL_SYSTEM/domains/$domain"
fi

# Keep the client choice: delete-webmail empties WEBMAIL, and empty means the next rebuild picks the default.
webmail_choice=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
$BIN/h-delete-mail-domain-webmail $user $domain 'yes'
if [ -n "$webmail_choice" ]; then
	update_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL' "$webmail_choice"
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$SUSPENDED' 'yes'
increase_user_value "$user" '$SUSPENDED_MAIL'

$BIN/h-log-action "system" "Info" "Mail" "Suspended mail domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

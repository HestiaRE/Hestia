#!/bin/bash
# info: suspend mail domain
# options: USER DOMAIN
#
# example: h-suspend-mail-domain admin domain.com
#
# This function suspends mail domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Deleting symbolic link
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f /etc/$MAIL_SYSTEM/domains/$domain
fi

# Removing webmail configuration - but round-trip the customer's client choice: delete-webmail
# wipes the record to '' (its "turned off" semantics), and '' means "unset, next rebuild gets the
# default" - so without the re-store, suspend+unsuspend silently swapped the chosen client.
webmail_choice=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
$BIN/h-delete-mail-domain-webmail $user $domain 'yes'
if [ -n "$webmail_choice" ]; then
	update_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL' "$webmail_choice"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating config
update_object_value 'mail' 'DOMAIN' "$domain" '$SUSPENDED' 'yes'
sed -i "s/SUSPENDED='no'/SUSPENDED='yes'/g" "$USER_DATA/mail/$domain.conf"
increase_user_value "$user" '$SUSPENDED_MAIL'

# Logging
$BIN/h-log-action "system" "Info" "Mail" "Suspended mail domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: suspend user
# options: USER [RESTART]
#
# example: h-suspend-user alice yes
#
# This function suspends a certain user and all his objects.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
restart=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Do not restrict access to SFTP/FTP/SSH if POLICY_USER_VIEW_SUSPENDED is set to yes.
# Tested against the PERMISSIVE literal, so anything else falls to the restricting side: the key has no
# values list, the panel already reads it as `!== "yes"`, and `= 'no'` let a third value skip the branch
# entirely - leaving a suspended account unlocked (upstream #5711, which fixed only the unsuspend half).
if [ -z "$POLICY_USER_VIEW_SUSPENDED" ] || [ "$POLICY_USER_VIEW_SUSPENDED" != 'yes' ]; then
	# Adding '!' in front of the password
	/usr/sbin/usermod --lock "$user"

	# Suspending ftp accounts
	for ftp in $(grep "^${user}_" /etc/passwd | cut -f 1 -d :); do
		/usr/sbin/usermod --lock "$ftp" 2> /dev/null
	done

	# The file manager runs as the customer via an FPM pool, so it does NOT hang on
	# the Unix password — usermod --lock above stops SFTP/FTP/SSH but not the FM.
	# Tear the listener down too so a suspended customer loses FM access, keeping the
	# saved FILE_MANAGER flag so unsuspend restores it. Gated by the SAME
	# POLICY_USER_VIEW_SUSPENDED check, so 'view suspended' keeps FM open like SFTP.
	if [ -n "$FILE_MANAGER_PORT" ] && grep -q "^FILE_MANAGER='yes'" "$CONF_DIR/users/$user/user.conf" 2> /dev/null; then
		$BIN/h-delete-user-filemanager "$user" no keep > /dev/null 2>&1 || true
	fi
fi

# Suspending web domains
if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-web-domains "$user" "no"
fi

# Suspending mail domains
if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-mail-domains "$user" "no"
fi

# Suspending datbabases
if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-databases "$user"
fi

# Suspending cron jobs
if [ -n "$CRON_SYSTEM" ] && [ "$CRON_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-cron-jobs "$user" "no"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restarting system services
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

# Changing suspend value
update_user_value "$user" '$SUSPENDED' 'yes'
increase_user_value "$ROOT_USER" '$SUSPENDED_USERS'

# Logging
$BIN/h-log-action "system" "Info" "Users" "Suspended user account (Name: $user)."
log_event "$OK" "$ARGUMENTS"

exit

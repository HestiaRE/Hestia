#!/bin/bash
# info: suspend user
# options: USER [RESTART]
#
# example: h-suspend-user alice yes
#
# Suspends a user and all their objects.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/docker.sh
source $HESTIA/include/docker.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

# Only the permissive literal keeps the account open; anything else locks it.
if [ -z "$POLICY_USER_VIEW_SUSPENDED" ] || [ "$POLICY_USER_VIEW_SUSPENDED" != 'yes' ]; then
	# The lock stops passwords only; the expiry is what sshd and PAM refuse a key login on.
	/usr/sbin/usermod --lock --expiredate 1 "$user"

	while IFS= read -r ftp; do
		/usr/sbin/usermod --lock --expiredate 1 "$ftp" 2> /dev/null
	done < <(user_ftp_accounts)

	# The file manager runs as the customer in an FPM pool and ignores the lock, so its listener goes too.
	# FILE_MANAGER stays 'yes' for the unsuspend, and the same policy gate keeps it open like SFTP.
	if [ -n "$FILE_MANAGER_PORT" ] && grep -q "^FILE_MANAGER='yes'" "$CONF_DIR/users/$user/user.conf" 2> /dev/null; then
		$BIN/h-delete-user-filemanager "$user" no keep > /dev/null 2>&1 || true
	fi
fi

# Containers are a service like the vhosts, so they stop whatever the policy; linger off keeps a reboot
# from starting them again.
if getent passwd "$(companion_name "$user")" > /dev/null 2>&1; then
	companion_disable_linger "$user"
	companion_stop "$user" || echo "Warning: the docker companion of $user did not stop completely" >&2
fi

if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-web-domains "$user" "no"
fi

if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-mail-domains "$user" "no"
fi

if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-databases "$user"
fi

if [ -n "$CRON_SYSTEM" ] && [ "$CRON_SYSTEM" != 'no' ]; then
	$BIN/h-suspend-cron-jobs "$user" "no"
fi

# Before the restarts: a failing one must not leave the objects suspended under an active record.
update_user_value "$user" '$SUSPENDED' 'yes'
increase_user_value "$ROOT_USER" '$SUSPENDED_USERS'
$BIN/h-log-action "system" "Info" "Users" "Suspended user account (Name: $user)."

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed"

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed"

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed"

log_event "$OK" "$ARGUMENTS"

exit

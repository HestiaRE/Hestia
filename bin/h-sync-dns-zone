#!/bin/bash
# info: write one section of a DNS zone to its provider
# options: USER ZONE SECTION OBJECT [PLAN] [FORMAT] [CONFIRM] [MOVE] [RECORD] [TYPE]
#
# example: h-sync-dns-zone admin example.com web example.com
# example: h-sync-dns-zone admin example.com web example.com 3f2a9c0e1b7d4a65
# example: h-sync-dns-zone admin example.com web example.com preview shell cname,include
# example: h-sync-dns-zone admin example.com mail example.com preview shell normalize '' @ TXT
#
# Without PLAN (or with "preview") the writes that bring the section's rows in line with what HestiaRE derives,
# and their PLAN id. With that id the writes go out, provided the zone still yields the same plan, and the zone is
# read again: only an empty plan afterwards counts as done. Records no row of the section consumed are never named,
# and nothing is written to a zone the public name servers do not point at. Every write is logged before it goes
# out, with the stored value of each record it removes, in /var/log/hestia/dns-sync.log. The records a write added
# are noted in the user's zones store; SECTION orphan removes those of OBJECT no row derives any longer. CONFIRM
# allows what is never done unasked, in the preview and the write alike: cname replaces a CNAME by the section's
# records or by an added one, include switches the www include off so that www can differ from the apex, follow
# switches it on again, normalize puts the SPF record back to "v=spf1 a mx ~all". MOVE (OLD=NEW, comma separated)
# limits the writes to the records that carry an OLD address, as h-sync-dns hands it on. RECORD TYPE limits them to
# that one row.

user=$1
zone=$2
section=$3
object=$4
plan=${5:-preview}
format=${6-shell}
confirm=${7-}
move=${8-}
record=${9,,}
rtype=${10^^}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# shellcheck source=/usr/local/hestia/include/ip.sh
source "$HESTIA/include/ip.sh"
# shellcheck source=/usr/local/hestia/include/dns.sh
source "$HESTIA/include/dns.sh"
# shellcheck source=/usr/local/hestia/include/dns-provider.sh
source "$HESTIA/include/dns-provider.sh"
source_conf "$HESTIA/conf/hestia.conf"

json_list() {
	jq -R -n --arg plan "$id" '{PLAN: $plan, OPS: [inputs | select(length > 0) | split("\t")
		| {OP: .[0], NAME: .[1], TYPE: .[2], PRIORITY: .[3], TTL: .[4], VALUE: .[5], NOTE: (.[6] // ""),
		CONFIRM: (.[7] // "")}]}' <<< "$DNSP_PLAN"
}

shell_list() {
	printf 'OP\tNAME\tTYPE\tPRIORITY\tVALUE\tCONFIRM\tNOTE\n'
	printf -- '--\t----\t----\t--------\t-----\t-------\t----\n'
	# A DKIM key is longer than any terminal line.
	awk -F '\t' 'BEGIN { OFS = FS } { if (length($6) > 64) $6 = substr($6, 1, 61) "..."
		print $1, $2, $3, $4, $6, $8, $7 }' <<< "$DNSP_PLAN"
}

# check_failed RC: dnsp_check_zone's failure as the command's.
# sync_log OP...: one line of what went to the provider, before it went, with each rem's stored value: the removed
# records exist nowhere else afterwards.
sync_log() {
	(
		umask 077
		IFS=$'\t'
		line="$*"
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$zone" "$section" "$object" "$DNSP_ACCOUNT" "$id" \
			"${line//$'\n'/ }" >> "$SYNC_LOG"
	)
}

# row_only: the plan of the row RECORD TYPE alone. The include goes with www, and every www address with it; a CNAME
# or ALIAS goes only along with a write of the row that replaces it. A www mirrored by the include takes the apex write.
row_only() {
	local follows=''
	[ -n "$record" ] || return 0
	# A www that answers through the include changes only with the apex: its row takes the apex write along.
	if [ "$record" = 'www' ] && awk -F '\t' -v t="$rtype" '$1 == "www" && $2 == t && $6 == "include" { f = 1 }
		END { exit !f }' <<< "$DNSP_ACTUAL"; then
		follows=1
	fi
	DNSP_PLAN=$(awk -F '\t' -v r="$record" -v t="$rtype" -v fw="$follows" 'BEGIN { OFS = FS }
		{ l[NR] = $0; op[NR] = $1; rr[NR] = $2; tt[NR] = $3 }
		$1 == "include" { inc = 1 } END { for (i = 1; i <= NR; i++) {
			cn[i] = rr[i] == r && op[i] == "rem" && (tt[i] == "CNAME" || tt[i] == "ALIAS")
			own[i] = rr[i] == r && (tt[i] == t || tt[i] == "" || (inc && (tt[i] == "A" || tt[i] == "AAAA")))
			apex[i] = fw && rr[i] == "@" && tt[i] == t && op[i] != "skip"
			if (own[i] && op[i] != "skip") any = 1 }
		for (i = 1; i <= NR; i++) {
			if (own[i] || (any && cn[i])) print l[i]
			else if (apex[i] && !any) {
				n = split(l[i], f, "\t")
				if (f[7] == "") f[7] = "the apex, www follows it"
				out = f[1]; for (j = 2; j <= (n < 7 ? 7 : n); j++) out = out OFS f[j]; print out
			}
		} }' <<< "$DNSP_PLAN")
}

check_failed() {
	case $1 in
		3) check_result "$E_NOTEXIST" "no provider account holds zone $zone" ;;
		1) check_result "$E_FORBIDEN" "the provider refused the key of account $DNSP_ACCOUNT: $DNSP_ERROR" ;;
		*) check_result "$E_CONNECT" "zone $zone could not be read from account $DNSP_ACCOUNT: ${DNSP_ERROR:-compare failed}" ;;
	esac
}

check_args '4' "$#" 'USER ZONE SECTION OBJECT [PLAN] [FORMAT] [CONFIRM] [MOVE] [RECORD] [TYPE]'
is_format_valid 'user'
is_domain_format_valid "$zone"
is_object_valid 'user' 'USER' "$user"
case $section in
	web | sub | alias | mail | server | orphan) ;;
	*) check_result "$E_INVALID" "invalid section: $section" ;;
esac
[[ "$plan" =~ ^(preview|[0123456789abcdef]{16})$ ]] || check_result "$E_INVALID" "invalid plan: $plan"
[[ "$confirm" =~ ^((cname|include|follow|normalize)(,(cname|include|follow|normalize))*)?$ ]] \
	|| check_result "$E_INVALID" "invalid confirmation: $confirm"
[[ "$move" =~ ^([0-9a-fA-F.:]+=[0-9a-fA-F.:]+(,[0-9a-fA-F.:]+=[0-9a-fA-F.:]+)*)?$ ]] \
	|| check_result "$E_INVALID" "invalid move: $move"
[ -n "$move" ] && [ "$section" = 'orphan' ] && check_result "$E_INVALID" "a move has no orphans to remove"
if [ -n "$record$rtype" ]; then
	[[ "$record" =~ ^(@|[a-z0-9_*]([a-z0-9_.*-]*[a-z0-9_])?)$ ]] || check_result "$E_INVALID" "invalid record: $9"
	[[ "$rtype" =~ ^[A-Z]{1,10}$ ]] || check_result "$E_INVALID" "invalid type: ${10-}"
fi
case $format in
	json | plain | shell) ;;
	*) check_result "$E_INVALID" "invalid format: $format" ;;
esac

zone=$(dns_ascii "$zone")
object=${object,,}
what="$section $object${record:+, Record: $record $rtype}"
SYNC_LOG=/var/log/hestia/dns-sync.log
if [ "$plan" != 'preview' ]; then
	# One write per zone at a time: a second click with the same id waits, reads the written zone and no longer
	# matches its plan.
	dnsp_cache_dir
	exec {lockfd}>> "$DNSP_CACHE/sync-$zone.lock"
	flock "$lockfd"
fi
dnsp_zones_fresh
dns_load
if [ "$section" != 'orphan' ]; then
	dns_zone_rows "$zone" | dns_sections | awk -F '\t' -v u="$user" -v s="$section" -v o="$object" \
		'$5 == u && $3 == s && tolower($4) == o { f = 1 } END { exit !f }' \
		|| check_result "$E_NOTEXIST" "$user has no $section section $object in zone $zone"
	if [ -n "$record" ]; then
		dns_zone_rows "$zone" | dns_sections | awk -F '\t' -v u="$user" -v s="$section" -v o="$object" -v r="$record" \
			-v t="$rtype" '$5 == u && $3 == s && tolower($4) == o && $6 == r && $7 == t { f = 1 } END { exit !f }' \
			|| check_result "$E_NOTEXIST" "the $section section $object derives no $rtype row at $record"
	fi
fi

dnsp_check_zone "$zone" "$section" "$object" "$user" "$confirm" "$move" || check_failed $?
row_only
if [ "$section" = 'orphan' ] && [ -z "$DNSP_PLAN" ]; then
	check_result "$E_NOTEXIST" "zone $zone holds no orphaned record of $user for $object"
fi
id=$(sha256sum <<< "$DNSP_PLAN" | cut -c 1-16)

if [ "$plan" = 'preview' ]; then
	case $format in
		json) json_list ;;
		plain) echo "$DNSP_PLAN" ;;
		shell)
			[ -n "$DNSP_PLAN" ] && shell_list | column -t -s $'\t'
			echo "PLAN: $id"
			;;
	esac
	exit
fi

[ "$plan" = "$id" ] || check_result "$E_EXISTS" "zone $zone changed since the preview, nothing written: preview again"
IFS=$'\t' read -r dstate dns_provider dns_public <<< "$(awk -F '\t' '$1 == "delegation" { print $9 "\t" $8 "\t" $10 }' \
	<<< "$DNSP_CHECK")"
case $dstate in
	ok) ;;
	unchecked) check_result "$E_CONNECT" "public DNS did not answer for the name servers of zone $zone, nothing written" ;;
	*)
		msg="zone $zone: the public name servers (${dns_public:-none}) are not those of account $DNSP_ACCOUNT"
		check_result "$E_FORBIDEN" "$msg (${dns_provider:-none}), nothing written"
		;;
esac
writes=$(awk -F '\t' '$1 == "add" || $1 == "rem"' <<< "$DNSP_PLAN")
main=$(awk -F '\t' '$1 == "main" { print $6 "\t" $5; exit }' <<< "$DNSP_PLAN")
include=$(awk -F '\t' '$1 == "include" { print $6; exit }' <<< "$DNSP_PLAN")
n=$(awk -F '\t' '$1 == "add" || $1 == "rem" || $1 == "main" || $1 == "include" { n++ } END { print n + 0 }' <<< "$DNSP_PLAN")
[ -n "$writes$main$include" ] || {
	echo "nothing to write"
	exit
}

skips=$(awk -F '\t' '$1 == "skip" { print $2 "\t" $3 }' <<< "$DNSP_PLAN" | sort -u)
while IFS= read -r line; do
	[ -n "$line" ] && sync_log "$line"
done <<< "$(awk -F '\t' 'BEGIN { OFS = FS } $1 != "skip" { print $1, $2, $3, $4, $5, $6 }' <<< "$DNSP_PLAN")"

# Before the records: while www follows the apex, the provider drops an own www record equal to the apex silently.
if [ -n "$include" ]; then
	on=false
	[ "$include" = 'on' ] && on=true
	dnsp_call include "$zone" "$DNSP_REF" "$on" > /dev/null
	rc=$?
	if [ "$rc" != 0 ]; then
		dnsp_state_set "$DNSP_ACCOUNT" "$(dnsp_state_of "$rc")" "$DNSP_ERROR"
		sync_log "result" "www include refused, nothing else written: $DNSP_ERROR"
		[ "$rc" = 1 ] && check_result "$E_FORBIDEN" "the provider refused the key of account $DNSP_ACCOUNT: $DNSP_ERROR"
		check_result "$E_CONNECT" "the provider did not switch the www include of zone $zone $include: $DNSP_ERROR"
	fi
fi
tmp=$(mktemp) || check_result "$E_DISK" "cannot create a temp file"
printf '%s\n' "$writes" > "$tmp"
if [ -n "$writes" ]; then
	dnsp_call change "$zone" "$DNSP_REF" "$tmp" > /dev/null
	rc=$?
	if [ "$rc" != 0 ]; then
		rm -f "$tmp"
		err=$DNSP_ERROR
		dnsp_state_set "$DNSP_ACCOUNT" "$(dnsp_state_of "$rc")" "$err"
		# Nothing of www went out, so switching the include back on restores what was there.
		note=''
		if [ "$include" = 'on' ]; then
			note=' (the www include is on, www follows the apex beside what was to be removed)'
		elif [ -n "$include" ]; then
			note=' (the www include went off and is on again)'
			dnsp_call include "$zone" "$DNSP_REF" true > /dev/null \
				|| note=' (the www include went off and stays off: www does not resolve until the next sync)'
		fi
		sync_log "result" "records refused$note: $err"
		[ "$rc" = 1 ] && check_result "$E_FORBIDEN" "the provider refused the key of account $DNSP_ACCOUNT$note: $err"
		check_result "$E_CONNECT" "the provider did not take the records of zone $zone$note: $err"
	fi
	# A merged or moved SPF record carries terms HestiaRE did not write, so it is never noted as an orphan to be; an
	# added record is noted as such already, and forgetting it leaves it foreign.
	while IFS=$'\t' read -r rel type value; do
		[ -n "$value" ] && dns_written_add "$user" "$zone" "$section" "$object" "$rel" "$type" "$value"
	done <<< "$(awk -F '\t' 'BEGIN { OFS = FS } $1 == "add" && $7 != "merged into the existing record" &&
		$7 != "the new address beside the old one" && $7 != "the old address kept beside a and mx" &&
		$7 !~ /^an added record/ {
		print $2, $3, ($4 != "" ? $4 " " : "") $6 }' <<< "$writes")"
fi
rm -f "$tmp"
if [ -n "$main" ]; then
	IFS=$'\t' read -r addr ttl <<< "$main"
	dnsp_call main "$zone" "$DNSP_REF" "$addr" "$ttl" > /dev/null
	rc=$?
	if [ "$rc" != 0 ]; then
		dnsp_state_set "$DNSP_ACCOUNT" "$(dnsp_state_of "$rc")" "$DNSP_ERROR"
		sync_log "result" "main IP refused${writes:+ (the records went out)}: $DNSP_ERROR"
		[ "$rc" = 1 ] && check_result "$E_FORBIDEN" "the provider refused the key of account $DNSP_ACCOUNT: $DNSP_ERROR"
		check_result "$E_CONNECT" "the provider did not take the main IP of zone $zone${writes:+ (the records went out)}: $DNSP_ERROR"
	fi
fi

dnsp_check_zone "$zone" "$section" "$object" "$user" "$confirm" "$move" || {
	rc=$?
	sync_log "result" "written, but the zone could not be read back"
	check_failed "$rc"
}
row_only
# What the provider no longer holds is forgotten, whoever's record it was: removed here, or by hand there.
while IFS=$'\t' read -r owner rel type value; do
	[ -n "$owner" ] && dns_written_drop "$owner" "$zone" "$rel" "$type" "$value"
done <<< "$(dnsp_written_gone "$zone")"
# A skip is no proof of a write: a lookup that did not answer turns rows into skips. So the delegation has to be
# ok again, and only the rows that were skips before the write may be skips now.
dstate=$(awk -F '\t' '$1 == "delegation" { print $9 }' <<< "$DNSP_CHECK")
if [ "$dstate" != 'ok' ]; then
	sync_log "result" "written, read back not verified: delegation ${dstate:-missing}"
	"$BIN/h-log-action" "system" "Error" "DNS" "DNS zone write not verified (Zone: $zone, Section: $what)."
	check_result "$E_CONNECT" "zone $zone written, the read-back is not verified: delegation ${dstate:-missing}"
fi
left=$(awk -F '\t' -v s="$skips" 'BEGIN { n = split(s, l, "\n"); for (i = 1; i <= n; i++) if (l[i] != "") k[l[i]] = 1 }
	$1 != "skip" || !(($2 "\t" $3) in k)' <<< "$DNSP_PLAN")
if [ -n "$left" ]; then
	sync_log "result" "not in line after the write"
	"$BIN/h-log-action" "system" "Error" "DNS" "DNS zone write not in line (Zone: $zone, Section: $what)."
	todo=$(awk -F '\t' '{ printf "%s%s %s %s %s", (NR > 1 ? "; " : ""), $1, $2, $3, $6 }' <<< "$left")
	check_result "$E_CONNECT" "zone $zone is not in line after the write, still to do: $todo"
fi

sync_log "result" "in line, $n change(s)"
echo "zone $zone: $section $object${record:+ $record $rtype} in line, $n change(s) written"
"$BIN/h-log-action" "system" "Info" "DNS" "DNS zone written (Zone: $zone, Section: $what, Changes: $n)."
log_event "$OK" "$ARGUMENTS"

exit

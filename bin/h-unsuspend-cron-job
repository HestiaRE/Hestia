#!/bin/bash
# info: unsuspend cron job
# options: USER JOB [RESTART]
#
# example: h-unsuspend-cron-job admin 7 yes
#
# Puts a suspended job back into the user's crontab.

user=$1
job=$2
restart="${3-yes}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER JOB [RESTART]'
is_format_valid 'user' 'job' 'restart'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'cron' 'JOB' "$job"
is_object_suspended 'cron' 'JOB' "$job"

update_object_value 'cron' 'JOB' "$job" '$SUSPENDED' 'no'
decrease_user_value "$user" '$SUSPENDED_CRON'

sync_cron_jobs

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

$BIN/h-log-action "system" "Info" "Cron Jobs" "Unsuspended cron job (User: $user, Job: $job)."
log_event "$OK" "$ARGUMENTS"

exit

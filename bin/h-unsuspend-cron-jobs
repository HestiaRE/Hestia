#!/bin/bash
# info: unsuspend cron jobs
# options: USER [RESTART]
#
# example: h-unsuspend-cron-jobs admin no
#
# Unsuspends every job of the user, as h-unsuspend-user does.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"

for job in $(search_objects 'cron' 'SUSPENDED' 'yes' 'JOB'); do
	$BIN/h-unsuspend-cron-job "$user" "$job" 'no'
done

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

log_event "$OK" "$ARGUMENTS"

exit

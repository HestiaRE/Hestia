#!/bin/bash
# info: unsuspend database server
# options: TYPE HOST
#
# example: h-unsuspend-database-host mysql localhost
#
# Unsuspends a database host, so it takes new databases again.

type=$1
host=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'TYPE HOST'
is_format_valid 'type' 'host'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_type_valid "$DB_SYSTEM" "$type"
is_object_valid "$HESTIA/conf/$type" 'HOST' "$host"
is_object_suspended "$HESTIA/conf/$type" 'HOST' "$host"

update_object_value "$HESTIA/conf/$type" 'HOST' "$host" '$SUSPENDED' 'no'

log_event "$OK" "$ARGUMENTS"

exit

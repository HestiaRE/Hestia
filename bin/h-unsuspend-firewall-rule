#!/bin/bash
# info: unsuspend firewall rule
# options: RULE
#
# example: h-unsuspend-firewall-rule 7
#
# Unsuspends a firewall rule, rendering it into the ruleset again.

rule=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'RULE'
is_format_valid 'rule'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
is_object_valid "$CONF_DIR/firewall/rules" 'RULE' "$rule"
is_object_suspended "$CONF_DIR/firewall/rules" 'RULE' "$rule"

fw_conf_checkpoint "$CONF_DIR/firewall/rules.conf"
update_object_value "$CONF_DIR/firewall/rules" 'RULE' "$rule" '$SUSPENDED' "no"

fw_update_or_rollback || check_result "$E_INVALID" "the ruleset rejected the change, rule unchanged"

$BIN/h-log-action "system" "Info" "Firewall" "Unsuspended firewall rule (Rule: $rule)."
log_event "$OK" "$ARGUMENTS"

exit

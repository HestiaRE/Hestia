#!/bin/bash
# info: unsuspend all mail domain accounts
# options: USER DOMAIN
#
# example: h-unsuspend-mail-accounts admin acme.com
#
# This function unsuspends all mail domain accounts.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_unsuspended 'mail' 'DOMAIN' "$domain"

failed=''
for account in $(search_objects "mail/$domain" 'SUSPENDED' 'yes' 'ACCOUNT'); do
	$BIN/h-unsuspend-mail-account "$user" "$domain" "$account" || failed="$failed $account"
done
[ -z "$failed" ] || check_result "$E_UPDATE" "not unsuspended:$failed"

exit

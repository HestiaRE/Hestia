#!/bin/bash
# info: unsuspend mail domain
# options: USER DOMAIN
#
# example: h-unsuspend-mail-domain user02 acme.com
#
# This function unsuspends mail domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=${3-yes}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_suspended 'mail' 'DOMAIN' "$domain"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Add symbolic link
if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	ln -s $HOMEDIR/$user/conf/mail/$domain /etc/$MAIL_SYSTEM/domains/
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Updating config
update_object_value 'mail' 'DOMAIN' "$domain" '$SUSPENDED' 'no'
sed -i "s/SUSPENDED='yes'/SUSPENDED='no'/g" $USER_DATA/mail/$domain.conf
decrease_user_value "$user" '$SUSPENDED_MAIL'

# Enable webmail access
if [ -n "$IMAP_SYSTEM" ]; then
	if [ -n "$WEBMAIL_SYSTEM" ]; then
		# Restore the domain's own recorded client: re-deriving from WEBMAIL_SYSTEM took the
		# LAST installed token and silently rewrote the customer's choice on every unsuspend.
		webmail=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
		if [ -n "$webmail" ]; then
			$BIN/h-add-mail-domain-webmail "$user" "$domain" "$webmail" "$restart"
		fi
	fi
fi
# Logging
$BIN/h-log-action "system" "Info" "Mail" "Unsuspended mail domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

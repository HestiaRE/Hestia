#!/bin/bash
# info: unsuspend mail domain
# options: USER DOMAIN [RESTART]
#
# example: h-unsuspend-mail-domain user02 acme.com
#
# Delivery, login and webmail of the domain work again.

user=$1
domain=$2
restart=${3-yes}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain' 'restart'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
is_object_suspended 'mail' 'DOMAIN' "$domain"

if [[ "$MAIL_SYSTEM" =~ exim ]]; then
	rm -f "/etc/$MAIL_SYSTEM/domains/$domain"
	ln -sfn "$HOMEDIR/$user/conf/mail/$domain" "/etc/$MAIL_SYSTEM/domains/$domain_idn"
fi

update_object_value 'mail' 'DOMAIN' "$domain" '$SUSPENDED' 'no'
decrease_user_value "$user" '$SUSPENDED_MAIL'

if [ -n "$IMAP_SYSTEM" ]; then
	if [ -n "$WEBMAIL_SYSTEM" ]; then
		# The domain's recorded client, not WEBMAIL_SYSTEM: that lists every installed client, not the choice.
		webmail=$(get_object_value 'mail' 'DOMAIN' "$domain" '$WEBMAIL')
		if [ -n "$webmail" ]; then
			$BIN/h-add-mail-domain-webmail "$user" "$domain" "$webmail" "$restart"
		fi
	fi
fi

$BIN/h-log-action "system" "Info" "Mail" "Unsuspended mail domain (User: $user, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: unsuspend user
# options: USER [RESTART]
#
# example: h-unsuspend-user bob
#
# This function unsuspends user and all his objects.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
restart=$2

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Unconditional: POLICY_USER_VIEW_SUSPENDED governs a running suspension, and after this command there
# is none. Every step is a no-op where the suspend side skipped it (#1055).

# Deleting '!' in front of the password
/usr/sbin/usermod --unlock $user

# Unsuspending ftp accounts
for ftp in $(grep "^${user}_" /etc/passwd | cut -f 1 -d :); do
	/usr/sbin/usermod --unlock $ftp 2> /dev/null
done

# Restore the file manager listener if the user had it enabled and the module is
# installed (mirror of the suspend teardown; the saved FILE_MANAGER='yes' drives
# it). restart='no' — the web/proxy restart below picks the vhost up.
if [ -n "$FILE_MANAGER_PORT" ] && grep -q "^FILE_MANAGER='yes'" "$CONF_DIR/users/$user/user.conf" 2> /dev/null; then
	$BIN/h-add-user-filemanager "$user" no > /dev/null 2>&1 || true
fi

# Changing suspend value
update_user_value "$user" '$SUSPENDED' 'no'
decrease_user_value "$ROOT_USER" '$SUSPENDED_USERS'

# Unsuspending web domains
if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-web-domains "$user" "no"
fi

# Unsuspending mail domains
if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-mail-domains "$user" "no"
fi

# Unsuspending datbabases
if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-databases "$user"
fi

# Unsuspending cron jobs
if [ -n "$CRON_SYSTEM" ] && [ "$CRON_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-cron-jobs "$user" "no"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restarting system services
$BIN/h-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed" > /dev/null

# Logging
$BIN/h-log-action "system" "Info" "Users" "Unsuspended user account (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit

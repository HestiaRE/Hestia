#!/bin/bash
# info: unsuspend user
# options: USER [RESTART]
#
# example: h-unsuspend-user bob
#
# Unsuspends a user and all their objects.

user=$1
restart=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [RESTART]'
is_format_valid 'user' 'restart'
is_object_valid 'user' 'USER' "$user"
if [ "$user" = "$ROOT_USER" ]; then
	exit
fi
# Nothing to undo, and the admin counter must not drop for an account that never raised it.
if [ "$(get_user_value '$SUSPENDED')" != 'yes' ]; then
	exit
fi

# Unconditional: the policy governs a running suspension, and after this there is none. Each step is a no-op
# where the suspend skipped it.

/usr/sbin/usermod --unlock --expiredate '' "$user"

while IFS= read -r ftp; do
	/usr/sbin/usermod --unlock --expiredate '' "$ftp" 2> /dev/null
done < <(user_ftp_accounts)

update_user_value "$user" '$SUSPENDED' 'no'
decrease_user_value "$ROOT_USER" '$SUSPENDED_USERS'

# After SUSPENDED is cleared: for a suspended account the add only remembers the choice.
# The web restart below picks the vhost up.
if [ -n "$FILE_MANAGER_PORT" ] && grep -q "^FILE_MANAGER='yes'" "$CONF_DIR/users/$user/user.conf" 2> /dev/null; then
	$BIN/h-add-user-filemanager "$user" no > /dev/null 2>&1 || true
fi

# The enable is the healing path: it turns linger back on and starts the daemon the suspend stopped.
if [ -n "$(get_user_value '$DOCKER_IP')" ] && [ -x "$BIN/h-add-user-docker" ]; then
	$BIN/h-add-user-docker "$user" > /dev/null 2>&1 || echo "Warning: docker for $user did not come back, re-run h-add-user-docker" >&2
fi

if [ -n "$WEB_SYSTEM" ] && [ "$WEB_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-web-domains "$user" "no"
fi

if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-mail-domains "$user" "no"
fi

if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-databases "$user"
fi

if [ -n "$CRON_SYSTEM" ] && [ "$CRON_SYSTEM" != 'no' ]; then
	$BIN/h-unsuspend-cron-jobs "$user" "no"
fi

$BIN/h-restart-web "$restart"
check_result $? "Web restart failed"

$BIN/h-restart-proxy "$restart"
check_result $? "Proxy restart failed"

$BIN/h-restart-cron "$restart"
check_result $? "Cron restart failed"

$BIN/h-log-action "system" "Info" "Users" "Unsuspended user account (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit

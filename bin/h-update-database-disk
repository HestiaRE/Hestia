#!/bin/bash
# info: update database disk usage
# options: USER DATABASE
#
# example: h-update-database-disk admin admin_wp_db
#
# Recalculates the disk usage of one database and the user's total.

user=$1
database=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/db.sh
source $HESTIA/include/db.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DATABASE'
is_format_valid 'user' 'database'
is_system_enabled "$DB_SYSTEM" 'DB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'db' 'DB' "$database"

get_database_values

# An unreadable size leaves U_DISK as it is: a stale figure is visibly old, an invented one is not.
case $TYPE in
	mysql) get_mysql_disk_usage || check_result "$E_DB" "cannot read the size of $database" ;;
	pgsql) get_pgsql_disk_usage || check_result "$E_DB" "cannot read the size of $database" ;;
esac

update_object_value 'db' 'DB' "$database" '$U_DISK' "$usage"
recalc_user_disk_usage

log_event "$OK" "$ARGUMENTS"

exit

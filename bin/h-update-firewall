#!/bin/bash
# info: update system firewall rules
# options: NONE
#
# example: h-update-firewall
#
# This function updates iptables rules

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# The backend path lives in include/firewall.sh now; only the module probes stay local.
modprobe="/sbin/modprobe"
sysctl="/sbin/sysctl"

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking local IPv4 rules
rules="$CONF_DIR/firewall/rules.conf"

if [ ! -e "$rules" ]; then
	exit
fi

# Checking conntrack module avaiabilty
"$modprobe" nf_conntrack > /dev/null 2>&1
if [ $? -ne 0 ]; then
	"$sysctl" net.netfilter.nf_conntrack_max > /dev/null 2>&1
	if [ $? -ne 0 ]; then
		conntrack='no'
	fi
fi

"$modprobe" nf_conntrack_ftp > /dev/null 2>&1
if [ $? -ne 0 ]; then
	conntrack_ftp='no'
fi

chains="$CONF_DIR/firewall/chains.conf"
banlist="$CONF_DIR/firewall/banlist.conf"

# Checking custom OpenSSH port (or ports)
sshport="$($BIN/h-list-sys-sshd-port plain | sed ':a;N;$!ba;s/\n/,/g')"
if echo "$sshport" | grep -E '^[0-9]+(,[0-9]+)*$' &> /dev/null; then
	sed -i -E "s/(PORT=')[0-9]+(,[0-9]+)*('.*COMMENT='SSH')/\1$sshport\3/" "$rules"
	if [ -f "$chains" ]; then
		sed -i "/CHAIN='SSH'/c\CHAIN='SSH' PORT='$sshport' PROTOCOL='TCP'" "$chains"
	else
		"$BIN/h-add-firewall-chain" 'SSH' "$sshport" 'TCP'
	fi
fi

# Opening the batch
fw_batch_begin

fw_policy INPUT ACCEPT

# Enabling stateful support
if [ "$conntrack" != 'no' ] || grep --quiet container=lxc /proc/1/environ; then
	fw_accept_established
fi

ips="$(ls $CONF_DIR/ips)"
# Handling local traffic
for ip in $ips; do
	fw_accept_source "$ip"
done
# Loopback is accepted by interface so both families are covered; see fw_accept_loopback.
fw_accept_loopback
# ICMPv6 (NDP/PMTUD) must always be accepted or IPv6 breaks under the drop policy; see fw_accept_icmpv6.
fw_accept_icmpv6

# Ungated on WEBMAIL_SYSTEM: gating would leave the port open between installing webmail and the next rebuild.
for wm_port in 8090 8091; do
	fw_restrict_local_port "$wm_port" "$(fw_local_allowed_uids)"
done

# Docker customer /24s: separation between local users, webserver allowed (#566)
fw_restrict_docker_nets

# Whitelist, evaluated before any ban match so it can rescue a locked-out admin
fw_accept_excludes

# An owned chain that RETURNs loopback + RFC1918 FIRST: CrowdSec's own whitelist has failed for those
# before, and a false-positive ban on an internal address would otherwise be enforced box-wide.
if [ -f "$CONF_DIR/firewall/crowdsec.conf" ]; then
	fw_chain_create hestia-crowdsec
	for net in "${FW_KEEP_V4[@]}"; do
		fw_return_source hestia-crowdsec "$net"
	done
	# Same backstop for v6: loopback, link-local (NDP rides on it) and ULA must never be L3-dropped.
	for net6 in "${FW_KEEP_V6[@]}"; do
		fw_return_source6 hestia-crowdsec "$net6"
	done
	fw_chain_tail hestia-crowdsec DROP
	# Both families feed the one chain; the feeder fills both caches.
	fw_set_jump hestia-crowdsec crowdsec-blacklists
	fw_set_jump6 hestia-crowdsec crowdsec6-blacklists
fi

# Rendering the object model
IFS=$'\n'
for line in $(sort -r -n -k 2 -t \' $rules); do
	parse_object_kv_list "$line"
	if [ "$SUSPENDED" = 'no' ]; then
		# Warn but still render: a missing set costs the one rule, not the whole batch.
		if [[ "$IP" =~ ^ipset: ]]; then
			if ! fw_ipset_known "${IP#ipset:}"; then
				log_event $E_NOTEXIST "IPset IP list (${IP#ipset:}) not found"
			fi
		fi

		fw_rule "$ACTION" "$PROTOCOL" "$PORT" "$IP" "$conntrack_ftp"
	fi
done

# Switching chain policy to DROP
fw_policy INPUT DROP

# Jails and bans go in the SAME batch as the base ruleset: under iptables these were three separate applies,
# which is exactly what left a window with the jails detached.
if [ -n "$FIREWALL_EXTENSION" ]; then
	if [ -f "$chains" ]; then
		for chain in $(cat "$chains"); do
			parse_object_kv_list "$chain"
			fw_jail_rebuild "$CHAIN" "$PROTOCOL" "$PORT"
		done
	fi

	# Replayed from banlist.conf, which is the record of truth: the ruleset is rebuilt from scratch.
	if [ -f "$banlist" ]; then
		for ban in $(cat "$banlist"); do
			parse_object_kv_list "$ban"
			fw_ban_emit "$CHAIN" "$IP"
		done
	fi
fi

# Applying the whole ruleset in one transaction
fw_batch_apply || {
	fw_batch_discard
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
}
fw_batch_discard

# Checking custom trigger
if [ -x "$CONF_DIR/firewall/custom.sh" ]; then
	bash "$CONF_DIR/firewall/custom.sh"
fi

# Not housekeeping: iptables is the nft-shim here, so its rules keep being evaluated alongside ours.
fw_legacy_teardown

# Enabling the boot unit that reloads the saved ruleset
fw_persist_enable

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

#!/bin/bash
# info: load the banlist into the jail sets
# options: NONE
# labels: internal
# caller: hestia-nftables.service
#
# example: h-update-firewall-bans
#
# The boot ruleset carries no bans, so this adds every banlist.conf row to its set once the unit has loaded it. A bad
# row is skipped and reported: one block fewer is the harmless direction, and no row may take the firewall down.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh"
# shellcheck source=/usr/local/hestia/include/firewall.sh
source "$HESTIA/include/firewall.sh"
source_conf "$HESTIA/conf/hestia.conf"

# Under the unit stderr is the journal, which reads a leading <N> as the priority.
say() {
	if [ -n "${JOURNAL_STREAM:-}" ]; then
		echo "<$1>firewall: $2" >&2
	else
		echo "firewall: $2" >&2
	fi
}

banlist="$CONF_DIR/firewall/banlist.conf"

# The render replays bans only with fail2ban on, and only then are there jail sets to fill.
[ -n "$FIREWALL_SYSTEM" ] && [ -n "$FIREWALL_EXTENSION" ] || exit 0
if [ ! -s "$banlist" ]; then
	say 6 "banlist.conf is empty, no bans to load"
	exit 0
fi

doc="$(mktemp)"
err="$(mktemp)"
trap 'rm -f "$doc" "$err"' EXIT
total=0
skipped=0
lineno=0
rline=()
rset=()
rip=()
declare -A setname
# Read by pattern, not by parse_object_kv_list: that one aborts the whole run on the first bad row.
while IFS= read -r line || [ -n "$line" ]; do
	lineno=$((lineno + 1))
	[ -n "$line" ] || continue
	total=$((total + 1))
	ip=''
	chain=''
	fam=''
	[[ "$line" =~ (^|[[:space:]])IP=\'([^\']*)\' ]] && ip="${BASH_REMATCH[2]}"
	[[ "$line" =~ (^|[[:space:]])CHAIN=\'([^\']*)\' ]] && chain="${BASH_REMATCH[2]}"
	# Both land in nft grammar, so anything beyond a chain name and an address literal stays out of the batch.
	if [[ "$chain" =~ ^[A-Za-z0-9_-]+$ ]]; then
		if fw_is_addr "$ip"; then
			fam=4
		elif fw_is_addr6_strict "$ip"; then
			fam=6
		fi
	fi
	if [ -z "$fam" ]; then
		say 4 "banlist.conf line $lineno skipped, no chain and address to load: $line"
		skipped=$((skipped + 1))
		continue
	fi
	# Named once per chain and family: a fork per row is what makes thousands of rows slow.
	[ -n "${setname["$chain/$fam"]:-}" ] || setname["$chain/$fam"]="$(fw_ban_set_for "$chain" "$ip")"
	rline+=("$lineno")
	rset+=("${setname["$chain/$fam"]}")
	rip+=("$ip")
done < "$banlist"

# Rows $1 to $1+$2 as one transaction, one statement per set as the render writes it: one per row, v4 and v6
# interleaved, nft rejects once auto-merge folds neighbours.
load_batch() {
	local i t
	local -A e=()
	local -a order=()
	for ((i = $1; i < $1 + $2; i++)); do
		t="${rset[$i]}"
		[ -n "${e[$t]:-}" ] || order+=("$t")
		e[$t]="${e[$t]:+${e[$t]}, }${rip[$i]}"
	done
	for t in "${order[@]}"; do
		echo "add element $FW_FAMILY $FW_TABLE $t { ${e[$t]} }"
	done > "$doc"
	"$FW_NFT" -f "$doc" 2> "$err"
}

# nft refuses a transaction whole for a single bad element, so a refused one is halved until the bad rows stand
# alone: a few dozen calls for one bad row among thousands, where row by row would hold the boot for minutes.
load_rows() {
	local half e
	[ "$2" -gt 0 ] || return 0
	load_batch "$1" "$2" && return 0
	if [ "$2" -eq 1 ]; then
		e="$(head -n1 "$err")"
		say 4 "banlist.conf line ${rline[$1]} skipped, nft refused ${rip[$1]} in ${rset[$1]}: ${e#"$doc":*: }"
		skipped=$((skipped + 1))
		return 0
	fi
	half=$(($2 / 2))
	load_rows "$1" "$half"
	load_rows $(($1 + half)) $(($2 - half))
}

load_rows 0 "${#rip[@]}"

if [ "$skipped" -gt 0 ]; then
	say 4 "loaded $((total - skipped)) of $total bans from banlist.conf, $skipped skipped"
else
	say 6 "loaded $total of $total bans from banlist.conf"
fi
exit 0

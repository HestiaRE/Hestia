#!/bin/bash
# info: update firewall ipset
# options: [REFRESH]
#
# example: h-update-firewall-ipset
#
# This function creates ipset lists and updates the lists if they are expired or ondemand

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

refresh=${1:-no}

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_refresh_ipset_format_valid "$refresh" 'Refresh IP lists (load/yes/no)'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

ipset_hstobject="$CONF_DIR/firewall/ipset"

failed=0
for ipset_name in $(search_objects "$ipset_hstobject" 'SUSPENDED' 'no' 'LISTNAME' 2> /dev/null); do

	ipset_time="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$TIME')"
	ipset_date="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$DATE')"
	ipset_au="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$AUTOUPDATE')"

	# 'load' used to mean "put the cached lists back in the kernel at boot". The ruleset document now
	# carries every set's contents, so there is nothing to reload and nothing to order against.
	if [ "$refresh" = 'load' ]; then
		continue
	fi
	if [ "$ipset_au" = 'no' ]; then
		continue
	fi

	last_updated_ts=$(date -d "$ipset_date $ipset_time" +%s)
	now=$(date +%s)
	hours_since_update=$(((now - last_updated_ts) / (60 * 60)))

	if [[ "$hours_since_update" -lt 24 ]] && [ "$refresh" = 'no' ]; then
		continue
	fi

	$BIN/h-add-firewall-ipset "$ipset_name" '' '' '' 'yes' || failed=$((failed + 1))
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# The timer unit shows this rc, so a run where lists failed must not look healthy.
if [ "${failed:-0}" -gt 0 ]; then
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi
log_event "$OK" "$ARGUMENTS"

exit

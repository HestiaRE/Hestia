#!/bin/bash
# info: update host certificate for hestia
# options: USER HOSTNAME
#
# example: h-update-host-certificate admin example.com
#
# Makes the certificate of HOSTNAME the panel's, which exim, dovecot and proftpd share.

whoami=$(whoami)
if [ "$whoami" != "root" ]; then
	echo "Error: this script must be run as root."
	exit 1
fi

user=$1
hostname=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER HOSTNAME'
is_format_valid 'user'
is_domain_format_valid "$hostname" "hostname"
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
# Mail-only has no web domain for the hostname: h-add-letsencrypt-host leaves the certificate in the user's store.
if [ -z "$WEB_SYSTEM" ] && [ "$(webmail_front)" = 'nginx' ]; then
	src="$CONF_DIR/users/$user/ssl/$hostname"
else
	is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
	is_system_enabled "$WEB_SSL" 'SSL_SUPPORT'
	is_object_valid 'web' 'DOMAIN' "$hostname"
	is_object_unsuspended 'web' 'DOMAIN' "$hostname"
	src="/home/$user/conf/web/$hostname/ssl/$hostname"
fi

if [ ! -f "$src.pem" ] || [ ! -f "$src.key" ]; then
	echo "Error: domain $hostname does not have an SSL certificate."
	exit 1
fi

cp "$src.pem" $HESTIA_SSL/certificate.crt
cp "$src.key" $HESTIA_SSL/certificate.key

# As the installer writes them: exim reads through the mail group, and proftpd's AppArmor profile (Ubuntu 26.04)
# denies root the DAC override, so a key exim owns keeps proftpd from starting.
chown root:mail "$HESTIA_SSL/certificate.crt" "$HESTIA_SSL/certificate.key"
chmod 660 "$HESTIA_SSL/certificate.crt" "$HESTIA_SSL/certificate.key"

if [ -z "$UPDATE_HOSTNAME_SSL" ]; then
	echo "UPDATE_HOSTNAME_SSL='yes'" >> "$HESTIA/conf/hestia.conf"
fi

$BIN/h-restart-mail
$BIN/h-restart-ftp
$BIN/h-restart-service "hestia"

$BIN/h-log-action "system" "Info" "System" "System SSL certificate updated (Host: $hostname)."
log_event "$OK" "$ARGUMENTS"

exit 0

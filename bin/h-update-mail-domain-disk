#!/bin/bash
# info: update mail domain disk usage
# options: USER DOMAIN
#
# example: h-update-mail-domain-disk admin example.com
#
# Recounts the disk usage of the domain's mailboxes.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$MAIL_SYSTEM" 'MAIL_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'mail' 'DOMAIN' "$domain"
if [ -z "$MAIL_SYSTEM" ]; then
	exit
fi

dom_disk=0
for account in $($BIN/h-list-mail-accounts $user $domain plain | cut -f 1); do
	home_dir=$HOMEDIR/$user/mail/$domain_idn/$account
	if [ -e "$home_dir" ]; then
		udisk=$(nice -n 19 du -shm $home_dir | cut -f 1)
	else
		udisk=0
	fi
	update_object_value "mail/$domain" 'ACCOUNT' "$account" '$U_DISK' "$udisk"
	dom_disk=$((dom_disk + udisk))
done

update_object_value 'mail' 'DOMAIN' "$domain" '$U_DISK' "$dom_disk"
recalc_user_disk_usage

log_event "$OK" "$ARGUMENTS"

exit

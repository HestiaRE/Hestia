#!/bin/bash
# info: update mail templates
# options: [RESTART] [SKIP]
#
# example: h-update-mail-templates
#
# Rebuilds every user's mail domains, so the webmail vhosts follow the installed clients, then reloads.

restart=${1:-yes}
skip=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '0' "$#" '[RESTART] [SKIP]'
is_format_valid 'restart'

# Nothing to copy: the webmail templates arrive with the tarball under $HESTIA/share/$WEB_SYSTEM/webmail.
failed=''
if [ -z "$skip" ]; then
	if [ -n "$MAIL_SYSTEM" ]; then
		for user in $("$BIN/h-list-users" list); do
			$BIN/h-rebuild-mail-domains "$user" no || failed="$failed $user"
		done
	fi
fi

if [ "$restart" != "no" ]; then
	$BIN/h-restart-web "$restart"
	check_result $? "restart" > /dev/null 2>&1

	$BIN/h-restart-proxy "$restart"
	check_result $? "restart" > /dev/null 2>&1
fi
$BIN/h-log-action "system" "Info" "Updates" "Default mail domain templates updated."
[ -z "$failed" ] || check_result "$E_PARSING" "mail domains not rebuilt for:$failed"
exit

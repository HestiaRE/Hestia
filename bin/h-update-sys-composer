#!/bin/bash
# info: switch the system composer source (OS package <-> upstream installer)
# options: SOURCE
#
# example: h-update-sys-composer os
# example: h-update-sys-composer upstream
#
# OS package (security backports) or the signed upstream phar (newest, no auto-updates). The new source is verified
# before the old goes, and the old must go: /usr/local/bin shadows /usr/bin. Per-user copies stay.

source_arg=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

UPSTREAM_BIN="/usr/local/bin/composer"

if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: h-update-sys-composer can only be executed by the root user"
	exit 10
fi

check_args '1' "$#" 'SOURCE'
if [ "$source_arg" != 'os' ] && [ "$source_arg" != 'upstream' ]; then
	check_result "$E_INVALID" "SOURCE must be 'os' or 'upstream'"
fi

if [ "$source_arg" = 'os' ]; then
	if dpkg -s composer > /dev/null 2>&1 && [ ! -f "$UPSTREAM_BIN" ]; then
		echo "composer already comes from the OS package"
		composer_status_record
		exit 0
	fi
	# Install before remove: a failed apt run must not leave the box without composer.
	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -qq -y install composer \
		|| check_result "$E_UPDATE" "composer OS package install failed"
	rm -f "$UPSTREAM_BIN"
	new_source="OS package ($(dpkg-query -W -f '${Version}' composer 2> /dev/null))"
else
	if [ -f "$UPSTREAM_BIN" ] && ! dpkg -s composer > /dev/null 2>&1; then
		echo "composer already comes from the upstream installer"
		composer_status_record
		exit 0
	fi
	sig="$(curl -fsS --max-time 30 https://composer.github.io/installer.sig)" \
		|| check_result "$E_CONNECT" "could not fetch the composer installer signature"
	setup_tmp=$(mktemp -t composer-setup.XXXXXX.php)
	if ! wget https://getcomposer.org/installer --timeout=30 --tries=3 --retry-connrefused --quiet -O "$setup_tmp" \
		|| [ "$sig" != "$(php -r "echo hash_file('sha384', '$setup_tmp');")" ]; then
		rm -f "$setup_tmp"
		check_result "$E_INVALID" "composer installer download/signature verification failed"
	fi
	php "$setup_tmp" --quiet --install-dir=/usr/local/bin --filename=composer \
		|| {
			rm -f "$setup_tmp"
			check_result "$E_UPDATE" "composer upstream install failed"
		}
	rm -f "$setup_tmp"
	# Package and phar together is a shadowed state nobody sees. No autoremove: it is not scoped to composer.
	DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -qq -y purge composer > /dev/null 2>&1 || {
		composer_status_record
		check_result "$E_UPDATE" "composer OS package purge failed - the upstream phar is installed and shadows it; fix the apt state and re-run"
	}
	new_source="upstream installer ($("$UPSTREAM_BIN" --no-plugins --version 2> /dev/null | awk '{print $3}'))"
fi

composer_status_record
$BIN/h-log-action "system" "Info" "System" "Composer source switched to $new_source."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: update default key database
# options: [SYSTEM]
#
# example: h-update-sys-defaults
# example: h-update-sys-defaults user
#
# Refreshes the key registries of the records.

system=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/syshealth.sh
source $HESTIA/include/syshealth.sh
source_conf "$HESTIA/conf/hestia.conf"

# Through the dispatcher, the same the repairs use. system is not here: its registry is share/hestia/sys-keys.json
# in the tree, never a file on the box; asked for, it says so.
if [ "$system" = "system" ]; then
	echo "system keys come from share/hestia/sys-keys.json - nothing to write"
elif [ -n "$system" ]; then
	syshealth_refresh_registry "$system"
else
	for _sys in web mail mail_accounts user cron db ip; do
		syshealth_refresh_registry "$_sys"
	done
fi

log_event "$OK" "$ARGUMENTS"

#!/bin/bash
# info: update system IP
# options: NONE
#
# example: h-update-sys-ip
#          # Intended for internal usage
#
# This function scans configured IP in the system and register them with Hestia
# internal database. This call is intended for use on vps servers, where IP is
# set by hypervisor.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
# shellcheck source=/usr/local/hestia/include/web-model.sh
source $HESTIA/include/web-model.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing system IP addresses
nics="$(ip -d -j link show | jq -r '.[] | if .link_type == "loopback" then empty else .ifname end')"

for nic in $nics; do
	nic_type="$(ip -d -j link show "$nic" | jq -r '.[].linkinfo.info_kind')"
	# continue, not break: one bridge or v4-less NIC must not abort the whole scan
	if [ "$nic_type" = "bridge" ]; then
		continue
	fi
	nic_ipv4s="$(ip -4 -d -j addr show "$nic" | jq -r '.[] | select(length > 0) | .addr_info[] | if .scope == "global" then .local else empty end')"
	[ -n "$nic_ipv4s" ] && ips="${ips:+$ips }$nic_ipv4s"
	# v6: global scope, no temporary/deprecated - those rotate and would register endlessly
	nic_ipv6s="$(ip -6 -d -j addr show "$nic" | jq -r '.[] | select(length > 0) | .addr_info[] | if .scope == "global" and .temporary != true and .deprecated != true then .local else empty end')"
	[ -n "$nic_ipv6s" ] && ip6s="${ip6s:+$ip6s }$nic_ipv6s"
done

# Rename detection pairs THE single v4 with THE single v4 record - v6 records must not
# inflate the count
v_ips="$(find "$CONF_DIR/ips/" -maxdepth 1 -type f ! -name '*:*' -printf '%f\n')"
ip_num="$(echo "$ips" | wc -w)"
v_ip_num="$(echo "$v_ips" | wc -w)"

# Checking primary IP change
if [ "$ip_num" -eq "1" ] && [ "$v_ip_num" -eq "1" ]; then
	if [ -n "$v_ips" ] && [ "$ips" != "$v_ips" ]; then
		new_ip="$ips"
		old_ip="$v_ips"
	fi
fi

# Updating configs
if [ -n "$old_ip" ]; then
	mv $CONF_DIR/ips/$old_ip $CONF_DIR/ips/$new_ip

	# Generating timestamp
	new_timestamp

	# Updating IP's values
	ip="$new_ip"
	interface="$(ip -d -j addr show | jq --arg IP "$ip" -r '.[] | if .addr_info[].local == $IP then .ifname else empty end')"
	prefixlen="$(ip -d -j addr show | jq --arg IP "$ip" -r '.[].addr_info[] | if .local == $IP then .prefixlen else empty end')"
	netmask="$(convert_cidr "$prefixlen")"
	update_ip_value '$INTERFACE' "$interface"
	update_ip_value '$NETMASK' "$netmask"
	update_ip_value '$TIME' "$time"
	update_ip_value '$DATE' "$date"

	# Updating PROXY
	if [ -n "$PROXY_SYSTEM" ]; then
		cd /etc/$PROXY_SYSTEM/conf.d
		if [ -e "$old_ip.conf" ]; then
			mv $old_ip.conf $new_ip.conf
			sed -i "s/$old_ip/$new_ip/g" $new_ip.conf
		fi
	fi

	# Updating WEB (front fallback #193: the mailfront ip.conf carries the listeners)
	ws="$WEB_SYSTEM"
	[ -z "$ws" ] && ws=$(webmail_front)
	if [ -n "$ws" ]; then
		cd /etc/$ws/conf.d || check_result "$E_NOTEXIST" "/etc/$ws/conf.d missing"

		if [ -e "$old_ip.conf" ]; then
			mv $old_ip.conf $new_ip.conf
			sed -i "s/$old_ip/$new_ip/g" $new_ip.conf
		fi

		for user in $("$BIN/h-list-users" list); do
			if [ -n "$WEB_SYSTEM" ]; then
				ip_field_replace "$CONF_DIR/users/$user/web.conf" "$old_ip" "$new_ip"
				$BIN/h-rebuild-web-domains "$user" no
			fi
			# webmail vhosts render %ip% too - without this they kept the old
			# listen address on every model, and mailfront has no other rebuild path
			[ -n "$MAIL_SYSTEM" ] && $BIN/h-rebuild-mail-domains "$user" no
		done

		apache_remoteip_refresh

		$BIN/h-restart-proxy
		$BIN/h-restart-web
	fi

	# Updating MAIL
	if [ -n "$IMAP_SYSTEM" ]; then
		for user in $("$BIN/h-list-users" list); do
			$BIN/h-rebuild-mail-domains "$user" no
		done
		$BIN/h-restart-mail
	fi

	# Updating firewall
	if [ -n "$FIREWALL_SYSTEM" ]; then
		for fw_conf in "$CONF_DIR"/firewall/*.conf; do
			[ -e "$fw_conf" ] || continue
			ip_field_replace "$fw_conf" "$old_ip" "$new_ip"
		done
		$BIN/h-update-firewall
	fi
fi

# Adding system IP
for ip in $ips; do
	check_ip="$(ip addr list | grep -w "$ip")"
	if [ ! -e "$CONF_DIR/ips/$ip" ] && [ -n "$check_ip" ]; then
		interface="$(ip -d -j addr show | jq --arg IP "$ip" -r '.[] | if .addr_info[].local == $IP then .ifname else empty end')"
		prefixlen="$(ip -d -j addr show | jq --arg IP "$ip" -r '.[].addr_info[] | if .local == $IP then .prefixlen else empty end')"
		netmask="$(convert_cidr "$prefixlen")"
		$BIN/h-add-sys-ip "$ip" "$netmask" "$interface"
	elif [ -e "/etc/nginx/conf.d/$ip.conf" ]; then
		process_http2_directive "/etc/nginx/conf.d/$ip.conf"
	fi
done

# Adding system v6 (real prefix length from ip -j, never a guessed default)
for ip6 in $ip6s; do
	if [ ! -e "$CONF_DIR/ips/$ip6" ]; then
		interface="$(ip -6 -d -j addr show | jq --arg IP "$ip6" -r '.[] | if .addr_info[].local == $IP then .ifname else empty end')"
		prefixlen="$(ip -6 -d -j addr show | jq --arg IP "$ip6" -r '.[].addr_info[] | if .local == $IP then .prefixlen else empty end' | head -n1)"
		$BIN/h-add-sys-ip "$ip6" "$prefixlen" "$interface"
	fi
done

# NAT: v4 only (a global v6 IS public), and only on a non-empty probe answer - an empty
# one slid past [ ! -e ] on the bare directory and misfiled the NAT.
pub_ipv4="$(curl -fsLm5 --retry 2 --ipv4 https://ip.hestiacp.com/)"
if [ -n "$pub_ipv4" ] && [ ! -e "$CONF_DIR/ips/$pub_ipv4" ]; then
	if [ -z "$(grep -R "$pub_ipv4" $CONF_DIR/ips/)" ]; then
		ip="$(find "$CONF_DIR/ips/" -maxdepth 1 -type f ! -name '*:*' -printf '%T@ %f\n' | sort -rn | head -n1 | cut -d' ' -f2)"
		[ -n "$ip" ] && $BIN/h-change-sys-ip-nat "$ip" "$pub_ipv4"
	fi
fi

# Updating IP usage counters
$BIN/h-update-sys-ip-counters

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

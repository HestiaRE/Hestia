#!/bin/bash
# info: update IP usage counters
# options: [IP] [MODE]
#
# example: h-update-sys-ip-counters
#
# Recounts U_WEB_DOMAINS and U_SYS_USERS of one IP or all; check prints them without writing.

# ip46 for the format dispatch; global $ip aliased for the sourced ip.sh helpers
ip46="$1"
ip="$ip46"
mode="${2-apply}"

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/ip.sh
source $HESTIA/include/ip.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '0' "$#" '[IP] [MODE]'
case "$mode" in
	apply | check) ;;
	*) check_result "$E_INVALID" "invalid mode '$mode' (apply|check)" ;;
esac
# check prints what apply would write, from the same derivation.
if [ "$mode" = 'check' ] && [ -z "$ip" ]; then
	check_result "$E_INVALID" "check mode wants one IP - the caller owns the object list"
fi
if [ -n "$ip" ]; then
	is_format_valid 'ip46'
	if [ "$(ip_family "$ip46")" = 6 ]; then
		ip46=$(ip6_canonical "$ip46") || check_result "$E_INVALID" "cannot canonicalise the v6 address - the panel php backend did not answer"
		ip="$ip46"
	fi
	is_ip_valid
fi

if [ -z "$ip" ]; then
	ip_list="$(ls $CONF_DIR/ips/)"
else
	ip_list="$ip"
fi

for ip in $ip_list; do

	# Both spellings: behind NAT the record holds the public address, and local-only matching counts 0.
	if [ "$(ip_family "$ip")" = 6 ]; then
		# v6 lives in the IP6 field; NAT does not exist for it
		ip_usage="$(grep -H -e "IP6='$ip'" $CONF_DIR/users/*/web.conf)"
	else
		nat=$(grep -o "NAT='[^']*'" "$CONF_DIR/ips/$ip" 2> /dev/null | head -1 | cut -f 2 -d \')
		ip_usage="$(grep -H -e "IP='$ip'" ${nat:+-e "IP='$nat'"} $CONF_DIR/users/*/web.conf)"
	fi
	web_domains="$(echo "$ip_usage" | sed '/^$/d' | wc -l)"
	sys_users="$(echo "$ip_usage" | sed "s|^$CONF_DIR/users/||; s|/web.conf.*||" | sort -u | tr '\n' ',' | sed "s/,$//g")"

	if [ "$mode" = 'check' ]; then
		printf "U_WEB_DOMAINS='%s'\n" "$web_domains"
		printf "U_SYS_USERS='%s'\n" "$sys_users"
		continue
	fi

	update_ip_value '$U_WEB_DOMAINS' "$web_domains"
	update_ip_value '$U_SYS_USERS' "$sys_users"
done

log_event "$OK" "$ARGUMENTS"

exit

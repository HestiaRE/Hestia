#!/bin/bash
# info: update system rrd charts
# options: NONE
# labels: internal
# caller: cron
#
# example: h-update-sys-rrd
#
# Runs every collector whose period is due; cron calls it every five minutes.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

if [ ! -d "$RRD" ]; then
	mkdir -p $RRD
fi

# A period is due once its marker is older than its interval, less ten seconds of cron jitter.
if [ -e "$RRD/daily.rrd" ]; then
	mtime=$(stat -c "%Y" $RRD/daily.rrd)
	ctime=$(date +%s)
	dtime=$((ctime - mtime))
	if [ "$dtime" -gt '290' ]; then
		touch $RRD/daily.rrd
		periods="$periods daily"
	fi
else
	touch $RRD/daily.rrd
	periods="$periods daily"
fi

if [ -e "$RRD/weekly.rrd" ]; then
	mtime=$(stat -c "%Y" $RRD/weekly.rrd)
	ctime=$(date +%s)
	dtime=$((ctime - mtime))
	if [ "$dtime" -gt '3590' ]; then
		touch $RRD/weekly.rrd
		periods="$periods weekly"
	fi
else
	touch $RRD/weekly.rrd
	periods="$periods weekly"
fi

if [ -e "$RRD/monthly.rrd" ]; then
	mtime=$(stat -c "%Y" $RRD/monthly.rrd)
	ctime=$(date +%s)
	dtime=$((ctime - mtime))
	if [ "$dtime" -gt '21590' ]; then
		touch $RRD/monthly.rrd
		periods="$periods monthly"
	fi
else
	touch $RRD/monthly.rrd
	periods="$periods monthly"
fi

if [ -e "$RRD/yearly.rrd" ]; then
	mtime=$(stat -c "%Y" $RRD/yearly.rrd)
	ctime=$(date +%s)
	dtime=$((ctime - mtime))
	if [ "$dtime" -gt '43190' ]; then
		touch $RRD/yearly.rrd
		periods="$periods yearly"
	fi
else
	touch $RRD/yearly.rrd
	periods="$periods yearly"
fi

for period in $periods; do

	$BIN/h-update-sys-rrd-la "$period" > /dev/null 2>&1
	$BIN/h-update-sys-rrd-net "$period" > /dev/null 2>&1
	$BIN/h-update-sys-rrd-mem "$period" > /dev/null 2>&1
	$BIN/h-update-sys-rrd-ssh "$period" > /dev/null 2>&1

	if [ -n "$WEB_SYSTEM" ]; then
		$BIN/h-update-sys-rrd-$WEB_SYSTEM "$period" > /dev/null 2>&1
	fi

	if [ -n "$PROXY_SYSTEM" ]; then
		$BIN/h-update-sys-rrd-$PROXY_SYSTEM "$period" > /dev/null 2>&1
	fi

	if [ -n "$MAIL_SYSTEM" ] && [ "$MAIL_SYSTEM" != 'no' ]; then
		$BIN/h-update-sys-rrd-mail "$period" > /dev/null 2>&1
	fi

	if [ -n "$FTP_SYSTEM" ] && [ "$FTP_SYSTEM" != 'no' ]; then
		$BIN/h-update-sys-rrd-ftp "$period" > /dev/null 2>&1
	fi

	if [ -n "$DB_SYSTEM" ] && [ "$DB_SYSTEM" != 'no' ]; then
		IFS=, read -ra _type_list <<< "$DB_SYSTEM"
		for type in "${_type_list[@]}"; do
			[ -n "$type" ] || continue
			case $type in
				mysql) $BIN/h-update-sys-rrd-mysql "$period" > /dev/null 2>&1 ;;
				pgsql) $BIN/h-update-sys-rrd-pgsql "$period" > /dev/null 2>&1 ;;
			esac
		done
	fi
done

exit

#!/bin/bash
# info: update ftp rrd
# options: [PERIOD]
# labels: internal
# caller: h-update-sys-rrd
#
# example: h-update-sys-rrd-ftp
#
# Samples the FTP connections into its rrd on the daily run and draws the graph for PERIOD.

period=${1-daily}

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

case $period in
	daily)
		start='-1d'
		end='now'
		grid='MINUTE:30:HOUR:1:HOUR:4:0:%H:%M'
		;;
	weekly)
		start='-7d'
		end='now'
		grid='HOUR:8:DAY:1:DAY:1:0:%a %d'
		;;
	monthly)
		start='-1m'
		end='now'
		grid='WEEK:1:WEEK:1:WEEK:1:0:%b %d'
		;;
	yearly)
		start='-1y'
		end='now'
		grid='MONTH:1:YEAR:1:MONTH:2:2419200:%b'
		;;
	*) exit "$E_RRD" ;;
esac

if [ ! -d "$RRD/ftp" ]; then
	mkdir $RRD/ftp
fi

if [ ! -e "$RRD/ftp/ftp.rrd" ]; then
	rrdtool create $RRD/ftp/ftp.rrd --step $RRD_STEP \
		DS:A:GAUGE:600:U:U \
		RRA:AVERAGE:0.5:1:600 \
		RRA:AVERAGE:0.5:6:700 \
		RRA:AVERAGE:0.5:24:775 \
		RRA:AVERAGE:0.5:288:797 \
		RRA:MAX:0.5:1:600 \
		RRA:MAX:0.5:6:700 \
		RRA:MAX:0.5:24:775 \
		RRA:MAX:0.5:288:797
fi

if [ "$period" = 'daily' ]; then
	a=0
	a=$(ps aux | grep "$FTP_SYSTEM" | grep -v grep | grep -v nobody \
		| grep -v root | wc -l)
	if [ "$FTP_SYSTEM" = 'proftpd' ]; then
		# The proftpd master is in the list as well.
		a=$((a - 1))
	fi
	rrdtool update $RRD/ftp/ftp.rrd N:$a
fi

rrdtool graph $RRD/ftp/$period-ftp.png \
	--imgformat PNG \
	--height="150" \
	--width="670" \
	--start "$start" \
	--end "$end" \
	--vertical-label "Connections" \
	--x-grid "$grid" \
	-c "BACK#ffffff" \
	-c "SHADEA#ffffff" \
	-c "SHADEB#ffffff" \
	-c "FONT#555555" \
	-c "CANVAS#302c2d" \
	-c "GRID#666666" \
	-c "MGRID#AAAAAA" \
	-c "FRAME#302c2d" \
	-c "ARROW#FFFFFF" \
	DEF:a=$RRD/ftp/ftp.rrd:A:AVERAGE \
	COMMENT:'\r' \
	LINE1:a#fefda0:"Users " \
	GPRINT:a:'LAST:Current\:''%8.0lf' \
	GPRINT:a:'MIN:Min\:''%8.0lf' \
	GPRINT:a:'MAX:Max\:''%8.0lf\j' &> /dev/null
result=$?

if [ "$result" -ne 0 ]; then
	exit "$E_RRD"
fi

exit

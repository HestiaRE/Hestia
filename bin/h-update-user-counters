#!/bin/bash
# info: update user usage counters
# options: [USER] [MODE]
#
# example: h-update-user-counters admin
#
# Recounts the usage counters of one user or of all; check prints them without writing.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

user=$1
mode=${2-apply}

# One list for the write loop and the check output, so a counter is written and verified, or visibly missing.
# h-check-sys-smoke asks this command instead of counting itself. An array: the loop runs with IFS=$'\n'.
COUNTER_KEYS=(
	SUSPENDED_USERS SUSPENDED_WEB SUSPENDED_MAIL SUSPENDED_DB SUSPENDED_CRON
	IP_AVAIL IP_OWNED U_USERS U_DISK U_DISK_DIRS U_DISK_WEB U_DISK_MAIL U_DISK_DB U_BANDWIDTH
	U_WEB_DOMAINS U_WEB_SSL U_WEB_ALIASES U_MAIL_DOMAINS U_MAIL_DKIM U_MAIL_ACCOUNTS
	U_DATABASES U_CRON_JOBS U_BACKUPS
)

check_args '0' "$#" '[USER] [MODE]'
case "$mode" in
	apply | check) ;;
	*) check_result "$E_INVALID" "invalid mode: $mode, expected: apply | check" ;;
esac
if [ -n "$user" ]; then
	is_format_valid 'user'
	is_object_valid 'user' 'USER' "$user"
fi

if [ -z "$user" ]; then
	user_list="$("$BIN/h-list-users" list)"
else
	user_list="$user"
fi

for user in $user_list; do
	USER_DATA=$CONF_DIR/users/$user
	SUSPENDED_USERS=0
	SUSPENDED_WEB=0
	SUSPENDED_MAIL=0
	SUSPENDED_DB=0
	SUSPENDED_CRON=0
	IP_AVAIL=0
	IP_OWNED=0
	U_USERS=0
	U_DISK=0
	U_DISK_DIRS=$(get_user_value '$U_DISK_DIRS')
	[[ "$U_DISK_DIRS" =~ ^[0-9]+$ ]] || U_DISK_DIRS=0
	DISK=$U_DISK_DIRS
	U_DISK_WEB=0
	U_DISK_MAIL=0
	U_DISK_DB=0
	BANDWIDTH=0
	U_BANDWIDTH=0
	U_WEB_DOMAINS=0
	U_WEB_SSL=0
	U_WEB_ALIASES=0
	U_MAIL_DOMAINS=0
	U_MAIL_DKIM=0
	U_MAIL_ACCOUNTS=0
	U_DATABASES=0
	U_CRON_JOBS=0
	U_BACKUPS=0

	IFS=$'\n'

	if [ "$user" = "$ROOT_USER" ]; then
		spnd=$(grep "SUSPENDED='yes'" $CONF_DIR/users/*/user.conf | wc -l)
		SUSPENDED_USERS=$spnd
		U_USERS=$("$BIN/h-list-users" list | wc -l)
	fi

	ips=$(ls $CONF_DIR/ips)
	for ip in $ips; do
		source $CONF_DIR/ips/$ip
		if [ "$OWNER" = "$user" ]; then
			IP_OWNED=$((IP_OWNED + 1))
			IP_AVAIL=$((IP_AVAIL + 1))
		fi
		if [ "$OWNER" = "$ROOT_USER" ] && [ "$STATUS" = 'shared' ]; then
			IP_AVAIL=$((IP_AVAIL + 1))
		fi
	done
	if [ "$user" = "$ROOT_USER" ]; then
		IP_AVAIL=$(ls $CONF_DIR/ips | wc -l)
	fi

	U_WEB_DOMAINS=0
	if [ -f $USER_DATA/web.conf ]; then
		for domain_str in $(cat $USER_DATA/web.conf); do
			parse_object_kv_list "$domain_str"
			U_DISK_WEB=$((U_DISK_WEB + U_DISK))
			U_WEB_DOMAINS=$((U_WEB_DOMAINS + 1))

			if [ "$SSL" = 'yes' ]; then
				U_WEB_SSL=$((U_WEB_SSL + 1))
			fi
			if [ "$SUSPENDED" = 'yes' ]; then
				SUSPENDED_WEB=$((SUSPENDED_WEB + 1))
			fi
			if [ -n "$ALIAS" ]; then
				aliases=$(echo "$ALIAS" | tr ',' '\n' | wc -l)
				U_WEB_ALIASES=$((U_WEB_ALIASES + aliases))
			fi
			BANDWIDTH=$((BANDWIDTH + U_BANDWIDTH))
		done
		DISK=$((DISK + U_DISK_WEB))
	fi

	if [ -f $USER_DATA/mail.conf ]; then
		for domain_str in $(cat $USER_DATA/mail.conf); do
			parse_object_kv_list "$domain_str"
			U_DISK_MAIL=$((U_DISK_MAIL + U_DISK))
			U_MAIL_DOMAINS=$((U_MAIL_DOMAINS + 1))
			accounts=$(wc -l $USER_DATA/mail/$DOMAIN.conf | cut -f 1 -d ' ')
			U_MAIL_ACCOUNTS=$((U_MAIL_ACCOUNTS + accounts))
			if [ "$DKIM" = 'yes' ]; then
				U_MAIL_DKIM=$((U_MAIL_DKIM + 1))
			fi
			if [ "$SUSPENDED" = 'yes' ]; then
				SUSPENDED_MAIL=$((SUSPENDED_MAIL + 1))
			fi
			[ "$mode" = 'check' ] || update_object_value 'mail' 'DOMAIN' "$DOMAIN" '$ACCOUNTS' "$accounts"
		done
		DISK=$((DISK + U_DISK_MAIL))
	fi

	if [ -f $USER_DATA/db.conf ]; then
		for db_str in $(cat $USER_DATA/db.conf); do
			parse_object_kv_list "$db_str"
			U_DISK_DB=$((U_DISK_DB + U_DISK))
			U_DATABASES=$((U_DATABASES + 1))
			if [ "$SUSPENDED" = 'yes' ]; then
				SUSPENDED_DB=$((SUSPENDED_DB + 1))
			fi
		done
		DISK=$((DISK + U_DISK_DB))
	fi

	if [ -f $USER_DATA/cron.conf ]; then
		for cron_str in $(cat $USER_DATA/cron.conf); do
			parse_object_kv_list "$cron_str"
			U_CRON_JOBS=$((U_CRON_JOBS + 1))
			if [ "$SUSPENDED" = 'yes' ]; then
				SUSPENDED_CRON=$((SUSPENDED_CRON + 1))
			fi
		done
	fi

	if [ -f $USER_DATA/backup.conf ]; then
		for backup_str in $(cat $USER_DATA/backup.conf); do
			U_BACKUPS=$((U_BACKUPS + 1))
		done
	fi

	U_DISK=$DISK
	U_BANDWIDTH=$BANDWIDTH
	if [ "$mode" = 'check' ]; then
		# What the counters would become, record untouched: the smoke guard reads this.
		for _k in "${COUNTER_KEYS[@]}"; do printf "%s='%s'\n" "$_k" "${!_k}"; done
		continue
	fi
	for _k in "${COUNTER_KEYS[@]}"; do
		update_user_value "$user" "\$$_k" "${!_k}"
	done
done

# A check run only reads, so it is no event.
[ "$mode" = 'check' ] || log_event "$OK" "$ARGUMENTS"

exit

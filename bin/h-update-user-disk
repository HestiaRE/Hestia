#!/bin/bash
# info: update user disk usage
# options: USER
#
# example: h-update-user-disk admin
#
# Recounts the disk use of a user's home outside web, mail and conf.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

OLDIFS=$IFS
IFS=$(echo -en "\n\b")

disk_usage='0'
# The Docker image store counts here, unlike in h-backup-user: this is what the customer occupies, the
# archive leaves out what is pulled again. .dumps is the restic stage, not customer data.
disk_usage=$(du -shm $HOMEDIR/$user --exclude $HOMEDIR/$user/web --exclude $HOMEDIR/$user/mail --exclude $HOMEDIR/$user/conf --exclude $HOMEDIR/$user/.dumps | cut -f 1)

IFS=$OLDIFS

update_user_value "$user" '$U_DISK_DIRS' "$disk_usage"

recalc_user_disk_usage

log_event "$OK" "$ARGUMENTS"

exit

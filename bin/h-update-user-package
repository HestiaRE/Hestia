#!/bin/bash
# info: update user package
# options: PACKAGE
#
# example: h-update-user-package default
#
# Applies a package's current values to every user on it.

package=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'PACKAGE'
is_format_valid 'package'
is_package_valid

failed=''
for pkg_user in $(package_users "$package"); do
	"$BIN/h-change-user-package" "$pkg_user" "$package" 'yes' || failed="$failed $pkg_user"
done

[ -z "$failed" ] || check_result "$E_UPDATE" "package $package not applied to:$failed"

log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: update user package
# options: PACKAGE
#
# example: h-update-user-package default
#
# This function propagates package to connected users.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'PACKAGE'
is_format_valid 'package'
is_package_valid

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#
failed=''
for pkg_user in $(package_users "$package"); do
	"$BIN/h-change-user-package" "$pkg_user" "$package" 'yes' || failed="$failed $pkg_user"
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

[ -z "$failed" ] || check_result "$E_UPDATE" "package $package not applied to:$failed"

# Logging
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: replace a weak password hash with the system default
# options: USER PASSWORD
# labels: internal
# caller: the panel login
#
# example: h-update-user-password-hash admin /tmp/hst-sec-XXXX
#
# A DES or MD5 hash, as an old restored archive brings it, is hashed anew from the password, given as a file. Any other
# hash, or a password that does not match, leaves the account as it is.

user=$1
password=$2
HIDE=2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER PASSWORD'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_password_valid
[ -n "$password" ] || check_result "$E_INVALID" "empty password"

# A locked hash starts with '!' and matches neither form: the suspension owns it.
shadow=$(awk -F : -v u="$user" '$1 == u {print $2; exit}' /etc/shadow)
if [[ "$shadow" =~ ^\$1\$([^\$]+)\$ ]]; then
	method='md5'
	salt=${BASH_REMATCH[1]}
elif [[ "$shadow" =~ ^[./A-Za-z0-9]{13}$ ]]; then
	method='des'
	salt=${shadow:0:2}
	# DES reads 8 bytes: a longer word matches too, and hashing it whole would lock out the real password.
	[ "$(printf '%s' "$password" | wc -c)" -le 8 ] || exit 0
else
	exit 0
fi

# Checked here, not trusted from the caller: this command sets the password.
hash=$($BIN/h-generate-password-hash "$method" "$salt" <<< "$password")
if [ -z "$hash" ] || [ "$hash" != "$shadow" ]; then
	check_result "$E_PASSWORD" "password does not match the current hash"
fi

echo "$user:$password" | /usr/sbin/chpasswd
check_result $? "the new hash could not be set"
update_user_value "$user" '$MD5' "$(awk -F : -v u="$user" '$1 == u {print $2; exit}' /etc/shadow)"

$BIN/h-log-action "system" "Info" "Security" "Weak $method password hash replaced at login (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit

#!/bin/bash
# info: update user disk quota
# options: USER
#
# example: h-update-user-quota alice
#
# Applies the package DISK_QUOTA as a project quota hard limit on the home tree
# (project id = uid): every writer counts against the customer, subuids included.

user=$1

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Gated here as well as in the callers, so a new caller inherits it.
quota_is_active || exit 0
quota_home_fs || exit 0

quota_project_assign "$user"

uid=$(id -u "$user" 2> /dev/null)
[ -n "$uid" ] || exit 0
quota=$(get_user_value '$DISK_QUOTA')

# 'unlimited' in the record is setquota's 0. Hard only: without a warning channel a soft window is a late hard limit.
if [ "$quota" = 'unlimited' ] || [ -z "$quota" ]; then
	setquota -P "$uid" 0 0 0 0 "$QUOTA_MNT" 2> /dev/null
elif [[ "$quota" =~ ^[0-9]+$ ]]; then
	setquota -P "$uid" 0 $((quota * 1024)) 0 0 "$QUOTA_MNT" 2> /dev/null
else
	check_result "$E_INVALID" "DISK_QUOTA of $user is not a number"
fi

log_event "$OK" "$ARGUMENTS"

exit

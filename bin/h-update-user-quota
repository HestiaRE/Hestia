#!/bin/bash
# info: update user disk quota
# options: USER
#
# example: h-update-user-quota alice
#
# Applies the package DISK_QUOTA as a project quota hard limit on the home tree
# (project id = uid): every writer counts against the customer, subuids included.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# gated here, not only in the callers: a fifth caller must inherit the safety
quota_is_active || exit 0
quota_home_fs || exit 0

quota_project_assign "$user"

uid=$(id -u "$user" 2> /dev/null)
[ -n "$uid" ] || exit 0
quota=$(get_user_value '$DISK_QUOTA')

# record sentinel stays 'unlimited', 0 is setquota's "no limit"; hard only -
# a soft window without a warning channel is just a delayed hard limit
if [ "$quota" = 'unlimited' ] || [ -z "$quota" ]; then
	setquota -P "$uid" 0 0 0 0 "$QUOTA_MNT" 2> /dev/null
elif [[ "$quota" =~ ^[0-9]+$ ]]; then
	setquota -P "$uid" 0 $((quota * 1024)) 0 0 "$QUOTA_MNT" 2> /dev/null
else
	check_result "$E_INVALID" "DISK_QUOTA of $user is not a number"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit

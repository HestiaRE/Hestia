#!/bin/bash
# info: update disk usage for domain
# options: USER DOMAIN
#
# example: h-update-web-domain-disk alice wonderland.com
#
# Recalculates the disk usage of a web domain.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

home_dir="$HOMEDIR/$user/web/$domain/"

if [ -e "$home_dir" ]; then
	disk_usage=$(nice -n 19 du -shm $home_dir | cut -f 1)
fi

update_object_value 'web' 'DOMAIN' "$domain" '$U_DISK' "$disk_usage"
recalc_user_disk_usage

log_event "$OK" "$ARGUMENTS"

exit

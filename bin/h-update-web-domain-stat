#!/bin/bash
# info: update domain statistics
# options: USER DOMAIN
#
# example: h-update-web-domain-stat alice acme.com
#
# Builds the stats of one web domain.

user=$1
domain=$2

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/domain.sh
source $HESTIA/include/domain.sh
source_conf "$HESTIA/conf/hestia.conf"

format_domain
format_domain_idn

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_object_value_exist 'web' 'DOMAIN' "$domain" '$STATS'

get_domain_values 'web'

config="$HOMEDIR/$user/conf/web/$domain/$STATS.conf"
if [ ! -e "$config" ]; then
	check_result "$E_NOTEXIST" "$config doesn't exist"
fi

dir="$HOMEDIR/$user/web/$domain/stats"
if [ ! -e "$dir" ] && [ ! -L "$dir" ]; then
	mkdir "$dir"
	chown -h "$user:$user" "$dir"
fi

build_awstats() {
	if [ -d "/etc/sysconfig" ]; then
		awstats="/usr/share/awstats/wwwroot/cgi-bin/awstats.pl"
		wwwroot="/usr/share/awstats/wwwroot"
		if [ ! -e "$awstats" ]; then
			awstats="/var/www/awstats/awstats.pl"
			wwwroot="/var/www/awstats"
		fi
	else
		awstats="/usr/lib/cgi-bin/awstats.pl"
		wwwroot="/usr/share/awstats"
	fi
	opts="-config=$domain_idn -staticlinks -update -output"
	month=$(date "+%Y-%m")
	output='alldomains allhosts lasthosts unknownip allrobots lastrobots
        urldetail urlentry urlexit osdetail browserdetail unknownbrowser
        unknownos refererse refererpages keyphrases keywords errors404'

	# The folder is the customer's: everything below runs as the customer, awstats with its data files too.
	user_exec mkdir -p "$dir/$month"
	[ -e "$dir/logo.svg" ] || user_exec cp "$HESTIA/web/images/logo.svg" "$dir/"
	[ -e "$dir/icon" ] || user_exec cp -r "$wwwroot/icon" "$dir/"

	user_exec $awstats $opts | sed "s%awstats.$domain.%%g" | user_exec tee "$dir/$month/index.html" > /dev/null
	for format in $output; do
		user_exec $awstats $opts=$format \
			| sed "s%awstats.$domain.%%g" | user_exec tee "$dir/$month/$format.html" > /dev/null
	done

	sed "s/%month%/$month/g" < $SHARETPL/awstats/index.tpl | user_exec tee "$dir/index.html" > /dev/null

	months=$(find $dir -type d | sed -e "s%$dir/%%g" -e "s%$dir%%g" \
		| grep -v icon | sort -r)
	for link in $months; do
		year=$(echo $link | cut -f 1 -d \-)
		month=$(echo $link | cut -f 2 -d \- | sed -e "s/^0//")
		case "$month" in
			1) month='January' ;;
			2) month='February' ;;
			3) month='March' ;;
			4) month='April' ;;
			5) month='May' ;;
			6) month='June' ;;
			7) month='July' ;;
			8) month='August' ;;
			9) month='September' ;;
			10) month='October' ;;
			11) month='November' ;;
			12) month='December' ;;
		esac
		select_m="$select_m<option value=$link>$month $year<\/option>\n"
	done
	sed "s/%select_month%/$select_m/" < $SHARETPL/awstats/nav.tpl | user_exec tee "$dir/nav.html" > /dev/null
}

# The folder is 551 by design; the build opens it for itself and closes it again.
dir_closed=''
if ! user_exec test -w "$dir"; then
	user_exec chmod u+w "$dir"
	dir_closed=yes
fi
case $STATS in
	awstats) build_awstats ;;
esac
if [ -n "$dir_closed" ]; then
	user_exec chmod u-w "$dir"
fi

exit

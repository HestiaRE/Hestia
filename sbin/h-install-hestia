#!/bin/bash
# info: install HestiaRE from a written $CONF_DIR/install.conf
# options: (none)
#
# Non-interactive installer orchestrator. Reads $CONF_DIR/install.conf
# (produced by include/wizard.sh via install.sh) and installs HestiaRE in stages,
# gated by the COMPONENT_* values. Replaces the former `just install` flow.
#
# Pure bash: stages are functions in this file; shared helpers live in
# include/helper.sh; component install logic reuses the existing h-add-sys-*
# commands where they exist. Idempotent via $CONF_DIR/.done.* sentinels, each carrying the
# fingerprint of the install.conf it ran with - re-answering the wizard re-runs the stages.

set -eo pipefail

# The admin's base install decides the ambient umask, and it is not the same everywhere: deb13 and
# ub26 ship no UMASK line in login.defs, so every file created by a redirect or mkdir here came out
# group-writable there and 0644/0755 on deb12/ub24. That is not a cosmetic split - cron REFUSES a
# group-writable file in /etc/cron.d, which is how the LE fallback silently never ran. Pin it, so
# what we create does not depend on a setting we do not control. Anything needing other than this
# is chmod'ed explicitly at its own site.
umask 022

# inherited by all sub-commands so debconf uses the Noninteractive frontend
export DEBIAN_FRONTEND=noninteractive

CONF_DIR="/etc/hestia"
INSTALL_CONF="$CONF_DIR/install.conf"
LOG="/var/log/hestia/install.log"
mkdir -p "$(dirname "$LOG")"

# ── Error surfacing ─────────────────────────────────────────────────────────
_on_error() {
	local rc=$1 line=$2
	echo "" >&2
	echo "ERROR: h-install-hestia aborted (exit ${rc}, line ${line})." >&2
	[ -f "$LOG" ] && {
		echo "       Last lines of ${LOG}:" >&2
		tail -n 15 "$LOG" 2> /dev/null | sed 's/^/       | /' >&2 || true
	}
	echo "" >&2
	echo "       Recovery: fix the cause shown above, then re-run the installer." >&2
	echo "       Completed stages are skipped (see $CONF_DIR/.done.*); only the" >&2
	echo "       failed and later stages run again:" >&2
	echo "         h-install-hestia" >&2
	echo "       Details + how to force a stage to re-run: TROUBLESHOOTING.md" >&2
}
trap '_on_error "$?" "$LINENO"' ERR

# ── Thin validation (the env must already be seeded by install.sh) ──────────
[ "$(id -u)" = "0" ] || {
	echo "ERROR: h-install-hestia must be run as root." >&2
	exit 1
}
for _f in "$INSTALL_CONF" $CONF_DIR/hestia.env $CONF_DIR/conf/hestia.conf; do
	[ -f "$_f" ] || {
		echo "ERROR: $_f not found." >&2
		echo "       Run the installer first:  bash install.sh" >&2
		echo "       (or regenerate the recipe: bash /usr/local/hestia/include/wizard.sh)" >&2
		exit 1
	}
done

# ── Sources: env -> core lib -> helper lib -> recipe ────────────────────────
# errexit OFF: these libs expect to be sourced without set -e (a benign non-zero last statement must not abort the installer)
set +e
# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env # sets HESTIA
# shellcheck source=/usr/local/hestia/include/main.sh
source "$HESTIA/include/main.sh" # source_conf hestia.conf, BIN, dirs, error codes, user
# shellcheck source=/usr/local/hestia/include/helper.sh
source "$HESTIA/include/helper.sh" # hestia_apt, load_os_profile, seed_hestia_etc
# shellcheck source=/usr/local/hestia/include/quota.sh
source "$HESTIA/include/quota.sh" # quota_arm (#211)
# shellcheck source=/usr/local/hestia/include/limits.sh
source "$HESTIA/include/limits.sh" # customer_php_limit_apply (#212)
# shellcheck source=/usr/local/hestia/include/fail2ban.sh
source "$HESTIA/include/fail2ban.sh" # fail2ban_apply
# shellcheck source=/usr/local/hestia/include/web-model.sh
source "$HESTIA/include/web-model.sh" # configure_apache2, web_model_keyset, apache_remoteip_* (#120)
# shellcheck source=/etc/hestia/install.conf
source "$INSTALL_CONF" # HESTIA_*, INSTALL_OS/PROFILE, COMPONENT_*, TOOLS_SELECTION
set -e

[ -n "${HESTIA_HOSTNAME:-}" ] && [ -n "${HESTIA_ADMIN:-}" ] && [ -n "${HESTIA_EMAIL:-}" ] || {
	echo "ERROR: install.conf is missing HESTIA_HOSTNAME / HESTIA_ADMIN / HESTIA_EMAIL." >&2
	exit 1
}

# Auto-apt units race us for the dpkg lock on a freshly booted box (#480). Masked for the duration,
# restored on ANY exit path so an aborted install never leaves unattended-upgrades off.
apt_auto_units_mask
trap 'apt_auto_units_restore' EXIT

load_os_profile "$INSTALL_OS"

# ── Install-time variables ──────────────────────────────────────────────────
# Panel/reference PHP = the OS default (#191), derived by the wizard and carried
# in install.conf. A hand-written install.conf may omit it - derive again via the
# shared helper. Empty = hard fail: a hardcoded fallback would pin the panel to a
# version this OS never shipped (in os_single mode there is no Sury to save it).
PHP_VER="${PHP_REFERENCE_VERSION:-}"
[ -n "$PHP_VER" ] || PHP_VER=$(os_default_php)
if [ -z "$PHP_VER" ]; then
	echo "ERROR: no PHP reference version (install.conf PHP_REFERENCE_VERSION empty and apt-cache madison php came back empty)." >&2
	exit 1
fi

# write a config value to hestia.conf
# Write a config value idempotently: replace an existing key (collapsing any duplicates to one) or append.
# Append-only duplicated a key whenever a stage re-ran - an admin restarting the installer after an abort
# mid-stage is the real-world path, exactly how FIREWALL_EXTENSION doubled up after the #520 abort.
wcv() {
	local conf="$HESTIA/conf/hestia.conf" line
	line="$1='$2'"
	if grep -q "^$1=" "$conf" 2> /dev/null; then
		# the replacement inode takes the file's mode and owner, not the installer's umask: the seed sets 660
		# and this mv handed out 644 on every fresh install (#963)
		awk -v k="$1" -v repl="$line" '$0 ~ "^" k "=" { if (!seen) { print repl; seen = 1 } next } { print }' \
			"$conf" > "$conf.tmp" && chmod --reference="$conf" "$conf.tmp" \
			&& { [ "$(stat -c %u:%g "$conf")" = "$(stat -c %u:%g "$conf.tmp")" ] || chown --reference="$conf" "$conf.tmp"; } \
			&& mv -f "$conf.tmp" "$conf"
	else
		printf '%s\n' "$line" >> "$conf"
	fi
}

# truthiness helper for COMPONENT_* values
is_on() { [ "${1:-}" = "true" ] || [ "${1:-}" = "yes" ]; }

# A stage is only "done" for the answers it ran with. The wizard can be re-run - a mistyped screen
# on a tablet is enough - and a marker keyed on the stage name alone then skips work whose
# configuration has since changed. That box had MariaDB selected on the second pass and no
# database at all, and the failure only surfaced two stages later as "MySQL not available".
# Usage: stage_done <name>  ->  0 when the stage ran with THIS install.conf
stage_done() {
	local marker="$CONF_DIR/.done.$1"
	[ -f "$marker" ] || return 1
	[ "$(cat "$marker" 2> /dev/null)" = "$(stage_fingerprint)" ]
}

# Usage: stage_mark <name>
stage_mark() {
	stage_fingerprint > "$CONF_DIR/.done.$1"
}

stage_fingerprint() {
	sha256sum "$CONF_DIR/install.conf" 2> /dev/null | cut -f 1 -d ' '
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: base — APT repos, OS packages, system users, SSH, NTP, /proc
# ════════════════════════════════════════════════════════════════════════════
install_base() {
	stage_done base && {
		echo "[ skip ] base already configured"
		return 0
	}
	echo "[ * ] Configuring APT..."
	[ -f /etc/apt/apt.conf.d/80-retries ] || echo 'APT::Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries
	echo 'Acquire::Languages "none";' > /etc/apt/apt.conf.d/90nolang
	mkdir -p /root/.gnupg && chmod 700 /root/.gnupg

	if [ "${COMPONENT_PHP_MODE:-sury_multi}" = "os_single" ]; then
		# os_single means OS PHP only (#191) - no external PHP repo on the box at all
		echo "[ * ] Skipping Sury PHP repo (os_single)"
	else
		# shared helper so the wizard and this stage emit an identical Sury repo definition
		echo "[ * ] Adding Sury PHP repo..."
		add_sury_repo "$CODENAME" || exit 1
	fi

	# MariaDB repo/keyring lives in h-add-sys-mariadb (owns the full DB lifecycle)

	echo "[ * ] Installing base packages..."
	apt-get -qq update
	# b3sum ships ahead of its consumer: the differential backup map (#712) hashes every byte, and
	# BLAKE3 is the only cryptographic candidate that stays ahead of the compressor without sha_ni.
	# shellcheck disable=SC2086
	hestia_apt -y install \
		acl at b3sum bc bsdmainutils bsdutils ca-certificates \
		cron curl dnsutils e2fslibs e2fsprogs expect flex ftp \
		git gnupg idn2 imagemagick jq nftables \
		lsb-release lsof mc net-tools openssh-server quota \
		rrdtool rsyslog sysstat unzip util-linux vim-common \
		wget whois xxd zip zstd bubblewrap sudo \
		apt-transport-https awstats \
		$BASE_PKGS_EXTRA

	# Must precede every useradd on the box, including the panel's own service account:
	# it caps the auto-assigned range below the deterministic panel-user band (#388).
	echo "[ * ] Reserving the panel UID band in login.defs..."
	login_defs_guard

	echo "[ * ] Creating system users..."
	id hestia &> /dev/null || useradd hestia -c "HestiaRE Panel" --no-create-home -s /sbin/nologin
	getent group hestia-users &> /dev/null || groupadd hestia-users
	usermod -aG hestia-users hestia
	# caddy joins hestia-users in the panel stage (user doesn't exist yet here)

	echo "[ * ] Hardening SSH..."
	if grep -qiE "^#?.*Subsystem.+(sftp )?sftp-server" /etc/ssh/sshd_config; then
		sed -i -E "s/^#?.*Subsystem.+(sftp )?sftp-server/Subsystem sftp internal-sftp/g" /etc/ssh/sshd_config
	fi
	sed -i 's/[#]LoginGraceTime [[:digit:]]m/LoginGraceTime 1m/g' /etc/ssh/sshd_config
	grep -q "^DebianBanner no" /etc/ssh/sshd_config || echo 'DebianBanner no' >> /etc/ssh/sshd_config
	# Seed a commented (inert) AllowUsers directive unless one already exists. The
	# guidance lines must NOT begin with "AllowUsers" (they use "# SSH login ...");
	# manage_sshd_allowusers keys on the bare "#AllowUsers" directive form and would
	# otherwise mistake a "# AllowUsers ..." prose line for the directive.
	if ! grep -qiE '^[[:space:]]*#?AllowUsers([[:space:]]|$)' /etc/ssh/sshd_config; then
		cat >> /etc/ssh/sshd_config << 'EOF'

# SSH login allowlist (managed by HestiaRE; panel users auto-synced). Add your own
# entries (root@IP, emergency), then uncomment the line below — incomplete = lockout.
#AllowUsers
EOF
	fi
	systemctl restart ssh

	echo "[ * ] Configuring NTP..."
	if [ -f /etc/systemd/timesyncd.conf ]; then
		sed -i 's/#NTP=/NTP=pool.ntp.org/' /etc/systemd/timesyncd.conf
		systemctl enable --now systemd-timesyncd
	fi
	grep -q '^/sbin/nologin' /etc/shells || echo "/sbin/nologin" >> /etc/shells
	grep -q '^/usr/sbin/nologin' /etc/shells || echo "/usr/sbin/nologin" >> /etc/shells
	grep -q 'LS_COLORS="$LS_COLORS:di=00;33"' /etc/profile \
		|| echo 'LS_COLORS="$LS_COLORS:di=00;33"' >> /etc/profile
	proc_hardening_apply

	# quota is base, not a module (#211): arm whenever /home supports it; must run
	# before any customer exists (separate-/home paths umount), never aborts
	echo "[ * ] Arming project quota (when the filesystem supports it)..."
	quota_arm

	# DH params in the base stage: nginx and dovecot both fatal without /etc/ssl/dhparam.pem,
	# so it must exist before any TLS service starts. Ship the curated file; regenerate only as a fallback.
	if [ -s "$HESTIA/share/hestia/dhparam.pem" ]; then
		cp -f "$HESTIA/share/hestia/dhparam.pem" /etc/ssl/dhparam.pem
	else
		echo "[ ! ] shipped dhparam.pem missing — generating (this is slow)..."
		openssl dhparam -out /etc/ssl/dhparam.pem 2048
	fi
	chmod 644 /etc/ssl/dhparam.pem
	[ -s /etc/ssl/dhparam.pem ] || {
		echo "ERROR: /etc/ssl/dhparam.pem missing after base stage" >&2
		exit 1
	}

	stage_mark base
	echo "[ OK ] base complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: panel — Caddy + hestia-php.service
# ════════════════════════════════════════════════════════════════════════════
install_panel() {
	stage_done panel && {
		echo "[ skip ] panel already configured"
		return 0
	}
	echo "[ * ] Installing panel packages (Caddy, PHP $PHP_VER FPM)..."
	# gd/bz2/pgsql (phpMyAdmin/Adminer) + intl/exif/sqlite3 (webmail) installed unconditionally
	# so the panel PHP is self-contained; wired into the isolated conf.d by hestia-php-confd.
	# sqlite3 must be IN this list: confd builds the conf.d right below, and the same package
	# arriving later via h-add-web-php never re-runs confd - the no-MariaDB webmail backend
	# then has no driver and the roundcube seed dies (#684).
	local panel_php_pkgs
	panel_php_pkgs="php${PHP_VER}-cli php${PHP_VER}-fpm php${PHP_VER}-mysql php${PHP_VER}-curl \
php${PHP_VER}-zip php${PHP_VER}-gmp php${PHP_VER}-mbstring php${PHP_VER}-opcache php${PHP_VER}-xml \
php${PHP_VER}-gd php${PHP_VER}-bz2 php${PHP_VER}-pgsql php${PHP_VER}-intl php${PHP_VER}-exif php${PHP_VER}-sqlite3"
	# Unconditional, not os_single-only (#857): from 8.5 on NOBODY ships a separate
	# -opcache (it moved into core), so the raw list killed every sury-mode install
	# on a box whose OS default is 8.5. The filter keeps whatever the configured
	# repos can answer, drops tolerated names loudly, and names any other absence.
	# shellcheck disable=SC2086
	if ! panel_php_pkgs=$(filter_installable_php_pkgs "opcache:8.5 exif" $panel_php_pkgs); then
		exit 1
	fi
	case " $panel_php_pkgs " in *" php${PHP_VER}-cli "*) ;; *)
		echo "ERROR: php${PHP_VER}-cli is not installable from the configured repos" >&2
		exit 1
		;;
	esac
	case " $panel_php_pkgs " in *" php${PHP_VER}-fpm "*) ;; *)
		echo "ERROR: php${PHP_VER}-fpm is not installable from the configured repos" >&2
		exit 1
		;;
	esac
	# shellcheck disable=SC2086
	hestia_apt -y install \
		caddy \
		libphp-phpmailer \
		$panel_php_pkgs
	echo "[ * ] Configuring panel PHP-FPM..."
	mkdir -p /etc/php/hestia/fpm/pool.d /etc/php/hestia/cli
	cp -f "$HESTIA/share/panel-php/php-fpm.conf" /etc/php/hestia/fpm/
	cp -f "$HESTIA/share/panel-php/fpm/php.ini" /etc/php/hestia/fpm/php.ini
	cp -f "$HESTIA/share/panel-php/pool.d/panel.conf" /etc/php/hestia/fpm/pool.d/
	cp -f "$HESTIA/share/panel-php/cli/php.ini" /etc/php/hestia/cli/php.ini
	# single source of truth for the panel PHP version (read by the wrappers)
	echo "$PHP_VER" > /etc/php/hestia/php-version
	# build the isolated conf.d before starting (curated extension set)
	"$SBIN/hestia-php-confd" "$PHP_VER"
	# apt hook: restart the panel master when a PHP update replaced its binary (#191)
	cp -f "$HESTIA/share/panel-php/apt-refresh.conf" /etc/apt/apt.conf.d/95hestia-php-refresh
	cp -f "$HESTIA/share/panel-php/hestia-php.service" /etc/systemd/system/
	systemctl daemon-reload
	systemctl enable hestia-php
	systemctl start hestia-php

	# panel cert must exist before caddy starts; LE replaces it later
	echo "[ * ] Generating panel SSL certificate..."
	"$BIN/h-generate-ssl-cert" "$HESTIA_HOSTNAME" '' 'US' 'California' 'San Francisco' 'HestiaRE' 'IT' > /tmp/hst.pem
	local CRT_END KEY_START KEY_END
	CRT_END=$(grep -n "END CERTIFICATE-" /tmp/hst.pem | head -n1 | cut -f1 -d:)
	KEY_START=$(grep -nE "BEGIN (RSA |EC |ENCRYPTED )?PRIVATE KEY" /tmp/hst.pem | head -n1 | cut -f1 -d:)
	KEY_END=$(grep -nE "END (RSA |EC |ENCRYPTED )?PRIVATE KEY" /tmp/hst.pem | head -n1 | cut -f1 -d:)
	if [ -z "$KEY_START" ]; then
		KEY_START=$(grep -n "BEGIN RSA" /tmp/hst.pem | head -n1 | cut -f1 -d:)
		KEY_END=$(grep -n "END RSA" /tmp/hst.pem | head -n1 | cut -f1 -d:)
	fi
	(
		cd "$HESTIA_SSL"
		sed -n "1,${CRT_END}p" /tmp/hst.pem > certificate.crt
		sed -n "${KEY_START},${KEY_END}p" /tmp/hst.pem > certificate.key
	)
	chown root:mail "$HESTIA_SSL/"* 2> /dev/null || true
	chmod 660 "$HESTIA_SSL/"*
	rm -f /tmp/hst.pem

	echo "[ * ] Configuring Caddy..."
	mkdir -p /etc/caddy
	# caddy logs to /var/log/caddy (cannot write /var/log/hestia)
	mkdir -p /var/log/caddy
	chown caddy:caddy /var/log/caddy 2> /dev/null || true
	cp -f "$HESTIA/share/panel-caddy/Caddyfile" /etc/caddy/Caddyfile
	cp -f "$HESTIA/share/panel-caddy/hestia.conf" /etc/caddy/hestia.conf
	# placeholder so `import apps/*.conf` is never an empty glob on first start
	mkdir -p /etc/caddy/apps
	[ -e /etc/caddy/apps/00-placeholder.conf ] \
		|| echo "# app route snippets are written here by h-change-sys-db-alias" \
			> /etc/caddy/apps/00-placeholder.conf
	# caddy user groups: mail (read the shared panel cert), hestia-users (app FPM pools run as caddy)
	usermod -aG mail,hestia-users caddy 2> /dev/null || true
	systemctl enable caddy
	# restart, not start: apt already started caddy with its default Caddyfile
	# during package install, so `start` would be a no-op and our panel config
	# (port 8083) would never load — caddy would keep serving :80 (#162).
	systemctl restart caddy
	stage_mark panel
	echo "[ OK ] panel complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: web — nginx (+ optional apache2), PHP multi-version, web pool
# ════════════════════════════════════════════════════════════════════════════

# configure_apache2 now lives in include/web-model.sh (shared with the model switch, #120)

install_web() {
	stage_done web && {
		echo "[ skip ] web already configured"
		return 0
	}

	# The model decides the install scope, not just who serves: apache-only means no nginx on the
	# box at all. Mail-only gets nginx through the mailfront model (#193): webmail vhosts and
	# ACME termination, but an EMPTY WEB_SYSTEM - so no customer web command passes its guard.
	local web_model
	case "${COMPONENT_WEB_SERVER:-NGINX}" in
		APACHE) web_model="apache" ;;
		BOTH) web_model="both" ;;
		MAILFRONT) web_model="mailfront" ;;
		*) web_model="nginx" ;;
	esac

	local web_pkgs=()
	if web_model_uses_nginx "$web_model"; then web_pkgs+=(nginx); fi
	echo "[ * ] Installing web packages ($(web_model_label "$web_model"), PHP $PHP_VER extensions)..."
	local web_php_pkgs
	web_php_pkgs="php${PHP_VER} php${PHP_VER}-apcu php${PHP_VER}-bz2 php${PHP_VER}-cgi \
php${PHP_VER}-cli php${PHP_VER}-common php${PHP_VER}-gd php${PHP_VER}-imagick php${PHP_VER}-imap \
php${PHP_VER}-intl php${PHP_VER}-ldap php${PHP_VER}-pgsql php${PHP_VER}-pspell \
php${PHP_VER}-readline php${PHP_VER}-xml"
	# Unconditional for the same reason as the panel stage (#857): 8.4+ unbundled
	# imap, 8.5 folded opcache into core - the raw list is only valid for older PHP.
	# shellcheck disable=SC2086
	if ! web_php_pkgs=$(filter_installable_php_pkgs "imap:8.4 opcache:8.5 exif" $web_php_pkgs); then
		exit 1
	fi
	# shellcheck disable=SC2086
	hestia_apt -y install \
		"${web_pkgs[@]}" \
		$web_php_pkgs

	if web_model_uses_nginx "$web_model"; then
		echo "[ * ] Configuring nginx..."
		rm -f /etc/nginx/conf.d/*.conf
		cp -f "$HESTIA/share/nginx/nginx.conf" /etc/nginx/
		cp -f "$HESTIA/share/nginx/status.conf" /etc/nginx/conf.d/
		cp -f "$HESTIA/share/nginx/0rtt-anti-replay.conf" /etc/nginx/conf.d/
		cp -f "$HESTIA/share/nginx/websocket-upgrade.conf" /etc/nginx/conf.d/
		cp -f "$HESTIA/share/nginx/agents.conf" /etc/nginx/conf.d/
		cp -f "$HESTIA/share/nginx/cloudflare.inc" /etc/nginx/conf.d/
		# phpMyAdmin is delivered by Panel-Caddy now, not an nginx alias
		cp -f "$HESTIA/share/nginx/logrotate" /etc/logrotate.d/nginx
		mkdir -p /etc/nginx/conf.d/domains /etc/nginx/conf.d/main \
			/etc/nginx/modules-enabled /var/log/nginx/domains
		# a v6 nameserver counts only bracketed, a link-local one not at all; anchored on the
		# directive so the default list stays nginx.conf's
		local resolver="" ns
		for ns in $(grep -is '^nameserver' /etc/resolv.conf | awk '{print $2}'); do
			case "$ns" in
				fe80:* | *%*) continue ;;
				*:*) resolver="${resolver:+$resolver }[$ns]" ;;
				*) echo "$ns" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
					&& resolver="${resolver:+$resolver }$ns" ;;
			esac
		done
		[ -n "$resolver" ] && sed -i "s|^\(\s*resolver\s\+\).*|\1$resolver valid=300s;|" /etc/nginx/nginx.conf
		# An AAAA answer is a dead upstream where the kernel has no v6.
		if [ ! -e /proc/net/if_inet6 ]; then
			sed -i "s|^\(\s*resolver\s\+.*\);|\1 ipv6=off;|" /etc/nginx/nginx.conf
		fi

		echo "[ * ] Updating Cloudflare IP ranges..."
		local cf_ips
		cf_ips=$(curl -fsLm5 --retry 2 https://api.cloudflare.com/client/v4/ips 2> /dev/null || echo "")
		if [ -n "$cf_ips" ] && [ "$(echo "$cf_ips" | jq -r '.success//""')" = "true" ]; then
			{
				echo "# Cloudflare IP Ranges"
				echo ""
				echo "# IPv4"
				echo "$cf_ips" | jq -r '.result.ipv4_cidrs[]//""' | sort | sed 's/^/set_real_ip_from /;s/$/;/'
				echo ""
				echo "# IPv6"
				echo "$cf_ips" | jq -r '.result.ipv6_cidrs[]//""' | sort | sed 's/^/set_real_ip_from /;s/$/;/'
				echo ""
				echo "real_ip_header CF-Connecting-IP;"
			} > /etc/nginx/conf.d/cloudflare.inc
			echo "  Cloudflare ranges updated"
		fi
		update-rc.d nginx defaults > /dev/null 2>&1
		# restart, not start: replace the distro default site and free :80 before apache2
		systemctl restart nginx
	fi
	# apache backend needs its packages+mods in place before the keyset lands
	case "$web_model" in apache | both) configure_apache2 ;; esac
	# Web bot rate-limiting (Layer B): server-native, always available (independent of CrowdSec).
	# Seed the bot-family conf + render the front's rate-limit config. nginx fronts in nginx-only +
	# both; apache does Layer B only when it is the public front (apache-only, via mod_qos).
	source "$HESTIA/include/botpolicy.sh"
	botpolicy_seed_families
	if [ "$web_model" = "apache" ]; then
		apt_install_optional "apache mod_qos (bot rate limiting)" libapache2-mod-qos || true
		a2enmod qos > /dev/null 2>&1
		mkdir -p /etc/apache2/conf.d
		botpolicy_render_apache
	else
		mkdir -p /etc/nginx/conf.d
		botpolicy_render_nginx
	fi
	# One keyset table (include/web-model.sh), shared with the live model switch
	local kv
	while IFS= read -r kv; do
		wcv "${kv%%=*}" "${kv#*=}"
	done < <(web_model_keyset "$web_model")
	wcv "STATS_SYSTEM" "awstats"
	wcv "WEB_BACKEND" "php-fpm"

	# Multi-PHP: only in sury_multi mode, driven by the wizard's version list.
	# The panel/reference version ($PHP_VER) always goes through the same canonical
	# installer (h-add-web-php) as customer versions, so it gets the full extension
	# set even if the preset did not pre-select it (#196, #272). Deduped so a
	# pre-selected reference version is not installed twice.
	if [ "${COMPONENT_PHP_MODE:-sury_multi}" = "sury_multi" ]; then
		local php_versions="${COMPONENT_PHP_MULTIPHP_VERSIONS:-}"
		case " $php_versions " in
			*" $PHP_VER "*) ;;
			*) php_versions="$PHP_VER $php_versions" ;;
		esac
		echo "[ * ] Installing PHP versions: $php_versions"
		local v
		for v in $php_versions; do
			echo "  php$v..."
			# reference version failure aborts; an extra customer version only warns
			if ! "$BIN/h-add-web-php" "$v" >> "$LOG" 2>&1; then
				if [ "$v" = "$PHP_VER" ]; then
					echo "ERROR: reference PHP $v failed to install — see $LOG" >&2
					exit 1
				fi
				echo "[ ! ] WARNING: PHP $v failed to install — skipping (see $LOG)" >&2
			fi
		done
	else
		echo "[ * ] Skipping multi-PHP (PHP_MODE=${COMPONENT_PHP_MODE:-?})"
	fi

	echo "[ * ] Ensuring PHP $PHP_VER FPM pool..."
	# no shared www pool: each version needs its dummy placeholder pool so php-fpm
	# starts with zero domains. Deploy it here independent of the multi-PHP branch.
	cp -f "$HESTIA/share/php-fpm/dummy.conf" /etc/php/${PHP_VER}/fpm/pool.d/dummy.conf
	sed -i "s/%backend_version%/${PHP_VER}/g" /etc/php/${PHP_VER}/fpm/pool.d/dummy.conf
	update-rc.d php${PHP_VER}-fpm defaults > /dev/null 2>&1
	systemctl start php${PHP_VER}-fpm
	update-alternatives --set php /usr/bin/php${PHP_VER} > /dev/null 2>&1 || true

	# After every version exists: the cap covers the masters together, so a version
	# added later than this loop would otherwise serve outside the slice (#212).
	echo "[ * ] Capping customer PHP CPU..."
	customer_php_limit_apply

	echo "[ * ] Configuring PHP settings (timezone, short_open_tag)..."
	local ZONE pconf
	ZONE=$(timedatectl 2> /dev/null | awk '/Timezone/{print $2}' || true)
	ZONE="${ZONE:-UTC}"
	while IFS= read -r pconf; do
		sed -i "s%;date.timezone =%date.timezone = $ZONE%g" "$pconf"
		sed -i 's%_open_tag = Off%_open_tag = On%g' "$pconf"
	done < <(find /etc/php -name php.ini 2> /dev/null)
	printf '#!/bin/sh\nfind -O3 /home/*/tmp/ -ignore_readdir_race -depth -mindepth 1 -name '"'"'sess_*'"'"' -type f -cmin '"'"'+10080'"'"' -delete > /dev/null 2>&1\nfind -O3 %s/.sessions/ -ignore_readdir_race -depth -mindepth 1 -name '"'"'sess_*'"'"' -type f -cmin '"'"'+10080'"'"' -delete > /dev/null 2>&1\n' \
		"$HESTIA" > /etc/cron.daily/php-session-cleanup
	chmod 755 /etc/cron.daily/php-session-cleanup
	mkdir -p /var/www/html /var/www/document_errors
	cp -rf "$HESTIA/share/web/unassigned/index.html" /var/www/html/
	cp -rf "$HESTIA/share/web/skel/document_errors/"* /var/www/document_errors/
	mkdir -p /etc/logrotate.d/httpd-prerotate
	cp -f "$HESTIA/share/apache2/httpd-prerotate/"* /etc/logrotate.d/httpd-prerotate/ 2> /dev/null || true
	rm -f /etc/cron.d/awstats

	stage_mark web
	echo "[ OK ] web complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: db — MariaDB (+ phpMyAdmin / PostgreSQL / Redis per components)
# ════════════════════════════════════════════════════════════════════════════
install_db() {
	stage_done db && {
		echo "[ skip ] db already configured"
		return 0
	}

	# MariaDB lifecycle lives in h-add-sys-mariadb. Hard-fail: the panel needs a DB.
	if is_on "${COMPONENT_DB_MARIADB:-}"; then
		echo "[ * ] Installing MariaDB..."
		if ! "$BIN/h-add-sys-mariadb" >> "$LOG" 2>&1; then
			echo "ERROR: MariaDB install failed — see $LOG" >&2
			exit 1
		fi
	else
		echo "[ * ] MariaDB not selected — skipping"
	fi

	# PostgreSQL lifecycle in h-add-sys-postgresql. Fail-soft: optional, smoke-verified.
	if is_on "${COMPONENT_DB_POSTGRESQL:-}"; then
		echo "[ * ] Installing PostgreSQL..."
		"$BIN/h-add-sys-postgresql" >> "$LOG" 2>&1 \
			|| echo "[ ! ] PostgreSQL install reported an issue (see $LOG)"
	fi
	# Adminer: vendored web DB UI, the PostgreSQL front-end (phpMyAdmin stays MySQL default)
	if is_on "${COMPONENT_ADDON_ADMINER:-}"; then
		"$BIN/h-add-sys-adminer" >> "$LOG" 2>&1 \
			|| echo "[ ! ] Adminer install reported an issue (see $LOG)"
	fi
	# Redis install/promote in h-add-sys-redis. Fail-soft: a cache must not abort install.
	if is_on "${COMPONENT_DB_REDIS:-}"; then
		echo "[ * ] Installing Redis..."
		"$BIN/h-add-sys-redis" >> "$LOG" 2>&1 \
			|| echo "[ ! ] Redis install reported an issue (see $LOG)"
	fi

	stage_mark db
	echo "[ OK ] db complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: mail — exim4, dovecot, rspamd, webmailer (only if mail block present)
# ════════════════════════════════════════════════════════════════════════════
install_mail() {
	stage_done mail && {
		echo "[ skip ] mail already configured"
		return 0
	}
	echo "[ * ] Installing mail packages (exim4, dovecot)..."
	# sieve packages are not here — the sieve addon installs them when selected
	hestia_apt -y install \
		exim4 exim4-daemon-heavy \
		dovecot-imapd dovecot-pop3d

	echo "[ * ] Configuring Exim4..."
	gpasswd -a "$EXIM_USR" mail > /dev/null 2>&1 || true
	# single template for exim >= 4.95 (all target OSes; pre-4.95 variant removed)
	cp -f "$HESTIA/share/exim/exim4.conf.template" /etc/exim4/
	cp -f "$HESTIA/share/exim/dnsbl.conf" /etc/exim4/
	cp -f "$HESTIA/share/exim/spam-blocks.conf" /etc/exim4/
	cp -f "$HESTIA/share/exim/limit.conf" /etc/exim4/
	cp -f "$HESTIA/share/exim/system.filter" /etc/exim4/
	touch /etc/exim4/white-blocks.conf
	local SRS
	SRS=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32 || true)
	echo "$SRS" > /etc/exim4/srs.conf
	chmod 640 /etc/exim4/srs.conf /etc/exim4/exim4.conf.template
	chown root:"$EXIM_USR" /etc/exim4/srs.conf
	rm -rf /etc/exim4/domains && mkdir -p /etc/exim4/domains
	# SNI lookup dir: filenames are the SNI names, contents are links into the customer's own
	# mail conf. Group mail so exim traverses it, not world-readable so the domain list is not.
	mkdir -p "$MAIL_SNI_DIR" && chown root:mail "$MAIL_SNI_DIR" && chmod 0750 "$MAIL_SNI_DIR"
	rm -f /etc/alternatives/mta
	ln -s /usr/sbin/exim4 /etc/alternatives/mta
	update-rc.d -f sendmail remove > /dev/null 2>&1 || true
	update-rc.d -f postfix remove > /dev/null 2>&1 || true
	update-rc.d exim4 defaults
	systemctl start exim4

	echo "[ * ] Configuring Dovecot..."
	gpasswd -a dovecot mail > /dev/null 2>&1 || true
	mkdir -p /etc/dovecot/conf.d
	local DOVECOT_VER DCDIR
	DOVECOT_VER=$(dovecot --version 2> /dev/null | cut -d. -f1,2 || echo "2.3")
	if [ "$(printf '%s\n2.4' "$DOVECOT_VER" | sort -V | head -1)" = "2.4" ]; then
		DCDIR="$HESTIA/share/dovecot/2.4"
	else
		DCDIR="$HESTIA/share/dovecot/2.3"
	fi
	cp -f "$DCDIR/dovecot.conf" /etc/dovecot/
	# Derived like exim's send-only list: "listen = *, ::" is fatal on an ipv6.disable=1
	# kernel (Failed to start listeners), so the v6 half is dropped where no v6 exists.
	if [ ! -e /proc/net/if_inet6 ]; then
		sed -i 's/^listen = \*, ::$/listen = */' /etc/dovecot/dovecot.conf
	fi
	cp -f "$DCDIR/conf.d/"* /etc/dovecot/conf.d/
	if [ "$DCDIR" = "$HESTIA/share/dovecot/2.3" ]; then
		# our dovecot.conf defines the inbox namespace; the stock file's duplicate
		# prefix would break every login. 2.4 ships its own curated 15-mailboxes.conf.
		rm -f /etc/dovecot/conf.d/15-mailboxes.conf
	fi
	cp -f "$HESTIA/share/dovecot/logrotate" /etc/logrotate.d/dovecot
	chown -R root:root /etc/dovecot*
	touch /var/log/dovecot.log
	chown dovecot:mail /var/log/dovecot.log
	chmod 660 /var/log/dovecot.log
	update-rc.d dovecot defaults
	systemctl start dovecot

	wcv "MAIL_SYSTEM" "exim4"
	wcv "IMAP_SYSTEM" "dovecot"
	# rspamd/sieve are modular addons — their commands write ANTISPAM_SYSTEM/SIEVE_SYSTEM.
	# || true (like proftpd/clamav): a flaky addon install must not abort install_mail
	if is_on "${COMPONENT_ADDON_RSPAMD:-}"; then
		echo "[ * ] Installing & configuring rspamd (with Bayes Redis)..."
		"$BIN/h-add-sys-rspamd" >> "$LOG" 2>&1 || true
	fi
	if is_on "${COMPONENT_ADDON_SIEVE:-}"; then
		echo "[ * ] Installing & configuring sieve..."
		"$BIN/h-add-sys-sieve" >> "$LOG" 2>&1 || true
	fi
	if is_on "${COMPONENT_ADDON_CLAMAV:-}"; then
		echo "[ * ] Installing & configuring ClamAV (mail antivirus)..."
		# || true (like proftpd): a flaky first install (freshclam's blocking initial
		# download timing out under IO load) must not abort install_mail under set -e
		"$BIN/h-add-sys-clamav" >> "$LOG" 2>&1 || true
	fi

	# Webmailer choice: COMPONENT_MAIL_WEBMAILER is a token set (ROUNDCUBE and/or TACHYON;
	# empty = none), not an enum - one gated block per client so a third client is one more block.
	# ${:-} equates an explicitly empty value with an absent key ON PURPOSE: both mean "no
	# webmailer" here, and nothing downstream needs the asked-vs-never-asked distinction.
	local wm_rc=no wm_tx=no
	case ",${COMPONENT_MAIL_WEBMAILER:-}," in *,ROUNDCUBE,*) wm_rc=yes ;; esac
	case ",${COMPONENT_MAIL_WEBMAILER:-}," in *,TACHYON,*) wm_tx=yes ;; esac
	if [ "$wm_rc" = yes ]; then
		# No WEBMAIL_SYSTEM pre-seed (the #573 lesson, previously applied only to the tachyon
		# branch): the command merges the value itself on success. A pre-seeded claim survived
		# a failed run and made the retry skip on the package's stock config (#684).
		wcv "WEBMAIL_ALIAS" "webmail"
		echo "[ * ] Installing Roundcube..."
		"$BIN/h-add-sys-roundcube" >> "$LOG"
	fi
	if [ "$wm_tx" = yes ]; then
		echo "[ * ] Installing Tachyon..."
		# WEBMAIL_SYSTEM only after the command succeeds: setting it first made the panel
		# claim a webmail that a failed download had never unpacked (#573). Non-fatal like
		# the addons above, but loud - the box stays usable, the gap stays visible.
		# Roundcube above is NOT caught: an OS package apt cannot install is a broken box, a
		# network fetch that fails is a gap. Note the else branch also fires when the pin is
		# already installed (h-add-sys-tachyon exits 2 on "equal version"), so it ran on every
		# re-run of this stage. Whether ONE rule should cover every soft path is decided at
		# 1d (#945, E13); this block only names the asymmetry.
		if "$BIN/h-add-sys-tachyon" >> "$LOG" 2>&1; then
			wcv "WEBMAIL_ALIAS" "webmail"
		else
			# install.conf is the operator's choice and stays as chosen; the status key
			# WEBMAIL_SYSTEM, written only on success, says what the box has (#928).
			echo "[ !! ] Tachyon install FAILED - $([ "$wm_rc" = yes ] && echo "Roundcube stays the only webmail" || echo "no webmail configured") (see $LOG)"
		fi
	fi
	if [ "$wm_rc" = no ] && [ "$wm_tx" = no ]; then
		echo "[ * ] No webmailer selected"
	fi

	stage_mark mail
	echo "[ OK ] mail complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: security - nftables, fail2ban (optional), crowdsec (optional)
# ════════════════════════════════════════════════════════════════════════════
install_security() {
	stage_done security && {
		echo "[ skip ] security already configured"
		return 0
	}
	# nftables and nothing else: it IS the backend (include/firewall.sh renders one inet table and shells
	# /usr/sbin/nft), and it used to arrive only as a Recommends of iptables - which Debian's base image
	# happens to satisfy and Ubuntu's does not. iptables and ipset are gone with the old renderer: no code
	# calls either binary any more. fw_legacy_teardown still retires an older box's iptables ruleset, but it
	# is guarded on the binary, so on a fresh install it is simply a no-op. docker.io depends on iptables
	# itself, so the addon still gets it.
	echo "[ * ] Installing security packages (nftables)..."
	hestia_apt -y install nftables
	wcv "FIREWALL_SYSTEM" "nftables"

	if is_on "${COMPONENT_ADDON_FAIL2BAN:-}"; then
		echo "[ * ] Installing & configuring fail2ban..."
		local mail_block='no'
		is_on "${COMPONENT_MAIL_BLOCK_PRESENT:-}" && mail_block='yes'
		hestia_apt -y install fail2ban
		wcv "FIREWALL_EXTENSION" "fail2ban"
		# One implementation of "configured fail2ban", shared with the addon commands. It copies the
		# WHOLE share/fail2ban tree: enumerating the files is what silently left out action.d/hestia.conf
		# and made every jail referencing `action = hestia[...]` unstartable.
		fail2ban_apply "$mail_block" "${COMPONENT_ADDON_PROFTPD:-no}"
	fi

	# crowdsec — nginx-only web protection (#186); skipped on an apache-only model.
	if is_on "${COMPONENT_ADDON_CROWDSEC:-}"; then
		# Re-read hestia.conf first: main.sh sourced it at startup, BEFORE the web stage wrote the
		# model keys, so this shell still holds WEB_SYSTEM/PROXY_SYSTEM empty - which silently made
		# the nginx-front gate below false and skipped CrowdSec on every fresh install. crowdsec_apply
		# reads the same two keys for the public front and the acquisition log path.
		source_conf "$CONF_DIR/conf/hestia.conf"
		cs_pub="$PROXY_SYSTEM"
		[ -z "$cs_pub" ] && cs_pub="$WEB_SYSTEM"
		if [ "$cs_pub" = "nginx" ]; then
			echo "[ * ] Installing CrowdSec..."
			# conffile policy: keep an existing /etc/crowdsec/config.yaml non-interactively (see h-add-sys-crowdsec)
			APT_EXTRA_OPTS='-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold' \
				apt_install_optional "CrowdSec" crowdsec || true
			# move the local API off :8080 (collides with apache2) to :8054
			if [ -f /etc/crowdsec/config.yaml ]; then
				sed -i 's|127.0.0.1:8080|127.0.0.1:8054|g' /etc/crowdsec/config.yaml
				[ -f /etc/crowdsec/local_api_credentials.yaml ] \
					&& sed -i 's|127.0.0.1:8080|127.0.0.1:8054|g' /etc/crowdsec/local_api_credentials.yaml
				systemctl restart crowdsec 2> /dev/null || true
			fi
			# detection + nginx Layer-A/B wiring (collections, bouncer, http glue)
			source "$HESTIA/include/crowdsec.sh"
			crowdsec_apply || echo "[ ! ] CrowdSec wiring reported an issue (non-fatal)"
			# 'mesh' model: arm the mechanism (publish + import timer). Inert until peers are paired,
			# which is a two-admin step done afterwards in the panel or via the pairing commands.
			if [ "${COMPONENT_CROWDSEC_MODE:-}" = "mesh" ]; then
				echo "[ * ] Enabling CrowdSec fleet-mesh..."
				"$BIN/h-add-sys-crowdsec-mesh" > /dev/null 2>&1 || echo "[ ! ] fleet-mesh enable reported an issue (non-fatal)"
			fi
		fi
	fi

	# system IP setup (iptables/ipset rules) runs in the configure stage — the
	# rules live under /etc/hestia now, not in the install tree.

	stage_mark security
	echo "[ OK ] security complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: addons — proftpd / docker / filemanager (per components)
# ════════════════════════════════════════════════════════════════════════════
install_addons() {
	stage_done addons && {
		echo "[ skip ] addons already configured"
		return 0
	}
	if is_on "${COMPONENT_ADDON_PROFTPD:-}"; then
		echo "[ * ] Installing ProFTPD..."
		"$BIN/h-add-sys-proftpd" >> "$LOG" 2>&1 || true
	fi
	if is_on "${COMPONENT_ADDON_DOCKER:-}"; then
		echo "[ * ] Installing Docker (rootless, per-user)..."
		"$BIN/h-add-sys-docker" >> "$LOG" 2>&1 || true
	fi
	if is_on "${COMPONENT_ADDON_FILEMANAGER:-}"; then
		echo "[ * ] Installing File Manager..."
		"$BIN/h-add-sys-filemanager" >> "$LOG" 2>&1 || true
	fi
	if is_on "${COMPONENT_ADDON_RESTIC:-}"; then
		echo "[ * ] Installing restic (incremental backup mode)..."
		"$BIN/h-add-sys-restic" >> "$LOG" 2>&1 || true
	fi
	stage_mark addons
	# stage-level only: each || true above swallows a flaky addon failure, and the closing
	# smoke run recounts every requested addon by artefact and names what is missing
	echo "[ OK ] addons stage finished"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: structure — data dirs, log links, queue pipes
# ════════════════════════════════════════════════════════════════════════════
init_hestia_structure() {
	[ -L /var/log/hestia ] && rm -f /var/log/hestia || true
	mkdir -p /var/log/hestia
	ln -sf /var/log/hestia "$HESTIA/log"
	# templates/ still ships at the install root (tarball). packages/ is instance state now (#663),
	# so it lives under CONF_DIR and is created here, then seeded from share/ below.
	mkdir -p "$HESTIA/conf" "$HESTIA_SSL" \
		"$CONF_DIR/ips" "$CONF_DIR/queue" \
		"$CONF_DIR/users" "$CONF_DIR/firewall" "$CONF_DIR/packages" \
		"$CONF_DIR/hooks" "$HESTIA/.sessions"
	# The LE hook mechanism already exists in h-add-letsencrypt-domain (#4925); create the directory
	# and drop its README so the hooks are discoverable rather than a secret handshake.
	[ -e "$CONF_DIR/hooks/README.md" ] || cp -f "$HESTIA/share/hestia/hooks/README.md" "$CONF_DIR/hooks/README.md"
	# caddy, exim and proftpd all read the panel certificate as non-root, all of them via group mail.
	chown root:mail "$HESTIA_SSL" && chmod 0750 "$HESTIA_SSL"
	touch "$CONF_DIR/queue/backup.pipe" "$CONF_DIR/queue/disk.pipe" \
		"$CONF_DIR/queue/webstats.pipe" "$CONF_DIR/queue/restart.pipe" \
		"$CONF_DIR/queue/traffic.pipe" "$CONF_DIR/queue/daily.pipe" \
		"$HESTIA/log/system.log" "$HESTIA/log/auth.log" \
		"$HESTIA/log/backup.log" "$HESTIA/log/activity.log"
	# Every CONF_DIR data dir, not a subset: firewall/, packages/ and hooks/ were created in the
	# same mkdir above but left to the umask, so they came out 775 on the boxes without a UMASK line.
	chmod 750 "$HESTIA/conf" "$CONF_DIR/users" "$CONF_DIR/ips" "$HESTIA/log" \
		"$CONF_DIR/firewall" "$CONF_DIR/packages" "$CONF_DIR/hooks"
	chmod -R 750 "$CONF_DIR/queue"
	chmod 660 /var/log/hestia/* 2> /dev/null || true
	chmod 770 "$HESTIA/.sessions"
	echo "[ OK ] structure ready"
}

# First global address of NIC $2 in family $1 (-4/-6); temporary and deprecated v6 rotate, so they
# are skipped as in h-update-sys-ip.
nic_global_addr() {
	[ -n "$2" ] || return 0
	# absorbs its own failure: the caller assigns it, and under set -eo pipefail an unknown NIC
	# would abort the installer instead of leaving the address empty
	ip "$1" -d -j addr show "$2" 2> /dev/null \
		| jq -r '.[] | .addr_info[] | if .scope == "global" and .temporary != true and .deprecated != true then .local else empty end' 2> /dev/null \
		| head -n1 || true
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: configure — admin user, SSL, sudoers, firewall, default domain, cron
# ════════════════════════════════════════════════════════════════════════════
configure_hestia() {
	stage_done configure && {
		echo "[ skip ] configure already done"
		return 0
	}
	local mail_present="no"
	is_on "${COMPONENT_MAIL_BLOCK_PRESENT:-}" && mail_present="yes"

	# Generate admin password — never stored in install.conf
	local HESTIA_PASS
	HESTIA_PASS=$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 16)
	printf '%s' "$HESTIA_PASS" > "$CONF_DIR/.admin_pass.tmp"
	chmod 600 "$CONF_DIR/.admin_pass.tmp"

	echo "[ * ] Configuring Hestia Control Panel..."
	mkdir -p /etc/sudoers.d
	# flavor-aware + visudo-validated; shared with the update path
	deploy_hestia_sudoers
	cp -f "$HESTIA/share/hestia/logrotate" /etc/logrotate.d/hestia 2> /dev/null || true

	# committed v-* symlinks ship in the tarball; don't blanket-create (orphans native
	# commands) — just prune dangling ones left by a renamed/removed h-*
	find "$HESTIA/bin" -maxdepth 1 -name 'v-*' -xtype l -delete 2> /dev/null || true

	echo "[ * ] Installing firewall data; seeding hosting packages..."
	# Seed the shipped default/system.pkg into the instance dir (#663). Never clobber an
	# admin-created package that a re-run might find: copy per file only when absent. There used to
	# be a "s/domain.tld/<host>/" pass over the whole directory here - it only ever filled upstream's
	# NS field, which went with bind9 (#619), so it rewrote nothing of ours while ranging over every
	# admin package. Configure re-runs when install.conf changes, so that was reachable.
	for _pkg in "$HESTIA/share/hestia/packages/"*.pkg; do
		[ -e "$_pkg" ] || continue
		_dest="$CONF_DIR/packages/$(basename "$_pkg")"
		[ -e "$_dest" ] || cp -f "$_pkg" "$_dest"
	done
	mkdir -p "$CONF_DIR/firewall"
	cp -f "$HESTIA/share/firewall/rules.conf" "$CONF_DIR/firewall/rules.conf"
	# Strip mail firewall rules when there is no mail block (was: profile != standard)
	if [ "$mail_present" != "yes" ]; then
		sed -i "/COMMENT='SMTP'/d" "$CONF_DIR/firewall/rules.conf" 2> /dev/null || true
		sed -i "/COMMENT='IMAP'/d" "$CONF_DIR/firewall/rules.conf" 2> /dev/null || true
		sed -i "/COMMENT='POP3'/d" "$CONF_DIR/firewall/rules.conf" 2> /dev/null || true
	fi
	# Strip FTP rule unless proftpd was selected
	is_on "${COMPONENT_ADDON_PROFTPD:-}" || sed -i "/COMMENT='FTP'/d" "$CONF_DIR/firewall/rules.conf" 2> /dev/null || true

	echo "[ * ] Setting hostname..."
	"$BIN/h-change-sys-hostname" "$HESTIA_HOSTNAME" > /dev/null 2>&1 || true

	echo "[ * ] Configuring OpenSSL TLS ciphers..."
	local TLS13="TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_256_GCM_SHA384"
	if ! grep -qw "^ssl_conf = ssl_sect$" /etc/ssl/openssl.cnf 2> /dev/null; then
		sed -i '/providers = provider_sect$/a ssl_conf = ssl_sect' /etc/ssl/openssl.cnf
	fi
	if ! grep -qw "^\[ssl_sect\]$" /etc/ssl/openssl.cnf 2> /dev/null; then
		printf '\n[ssl_sect]\nsystem_default = hestia_openssl_sect\n\n[hestia_openssl_sect]\nCiphersuites = %s\nOptions = PrioritizeChaCha\n' \
			"$TLS13" >> /etc/ssl/openssl.cnf
	fi

	# panel cert is generated in the panel stage, DH params in install_base

	echo "[ * ] Enabling SFTP and SSH jails..."
	"$BIN/h-add-sys-sftp-jail" > /dev/null 2>&1 || true
	"$BIN/h-add-sys-ssh-jail" > /dev/null 2>&1 || true

	echo "[ * ] Creating admin user..."
	"$BIN/h-add-user" "$HESTIA_ADMIN" "$HESTIA_PASS" "$HESTIA_EMAIL" "default" "System Administrator"
	"$BIN/h-change-user-shell" "$HESTIA_ADMIN" nologin
	"$BIN/h-change-user-role" "$HESTIA_ADMIN" admin
	"$BIN/h-change-user-language" "$HESTIA_ADMIN" en
	# The policy defaults live in the syshealth repair, one home each. Two were seeded here as well:
	# POLICY_USER_CHANGE_THEME, and POLICY_SYSTEM_PROTECTED_ADMIN - the latter with 'yes' while the
	# repair said 'no', which is exactly the drift a second home produces. Both are gone; the repair
	# now fills an empty value for every key whose default is not empty.

	# DB host registration + phpMyAdmin alias happen inside h-add-sys-mariadb (db stage)

	echo "[ * ] Configuring system IP..."
	"$BIN/h-update-sys-ip" > /dev/null 2>&1 || true
	local DEFAULT_NIC IP PUB_IP _reg_ip
	DEFAULT_NIC="$(ip -d -j route show | jq -r '.[] | if .dst == "default" then .dev else empty end' | head -n1)"
	# A v6-only box has no v4 default route, so NIC and address both come from the -6 twin.
	[ -z "$DEFAULT_NIC" ] && DEFAULT_NIC="$(ip -6 -d -j route show \
		| jq -r '.[] | if .dst == "default" then .dev else empty end' | head -n1)"
	IP="$(nic_global_addr -4 "$DEFAULT_NIC")"
	[ -z "$IP" ] && IP="$(nic_global_addr -6 "$DEFAULT_NIC")"
	# prefer the registered IP object over our detection, v4 first: the default domain and the NAT
	# probe still expect it
	if [ -z "$IP" ] || [ ! -e "$CONF_DIR/ips/$IP" ]; then
		_reg_ip="$(find "$CONF_DIR/ips" -maxdepth 1 -type f ! -name '*:*' -printf '%T@ %f\n' 2> /dev/null \
			| sort -rn | head -n1 | cut -d' ' -f2-)" || _reg_ip=''
		[ -z "$_reg_ip" ] && _reg_ip="$(ls -t "$CONF_DIR/ips/" 2> /dev/null | head -n1)"
		[ -n "$_reg_ip" ] && IP="$_reg_ip"
	fi
	PUB_IP="$(curl -fsLm5 --retry 2 --ipv4 https://ip.hestiacp.com/ 2> /dev/null || echo "")"
	if [ -n "$PUB_IP" ] && [ "$PUB_IP" != "$IP" ]; then
		# NAT: record PUB_IP as the NAT address of the local IP object; the default
		# domain stays on the LOCAL IP (no ips/<public> object exists) with PUB_IP in
		# its NAT field for DNS/display
		[ -e /etc/rc.local ] && sed -i '/exit 0/d' /etc/rc.local || touch /etc/rc.local
		grep -q '^#!' /etc/rc.local || echo '#!/bin/sh' >> /etc/rc.local
		echo "$HESTIA/bin/h-update-sys-ip" >> /etc/rc.local
		echo "exit 0" >> /etc/rc.local
		chmod +x /etc/rc.local
		systemctl enable rc-local > /dev/null 2>&1 || true
		"$BIN/h-change-sys-ip-nat" "$IP" "$PUB_IP" > /dev/null 2>&1 || true
	fi
	"$BIN/h-update-firewall" || true

	# BOTH: apache2 behind nginx must see the real client IP via mod_remoteip (X-Real-IP).
	# Same toggle the model switch uses (include/web-model.sh); it does not reload, so we do.
	if [ "${COMPONENT_WEB_SERVER:-NGINX}" = "BOTH" ]; then
		echo "[ * ] Configuring apache2 remoteip (client IP behind nginx)..."
		apache_remoteip_enable "$IP" "$PUB_IP"
		systemctl restart apache2
	fi

	echo "[ * ] Adding default domain..."
	"$BIN/h-add-web-domain" "$HESTIA_ADMIN" "$HESTIA_HOSTNAME" "$IP" || true

	echo "[ * ] Creating hestia crontab..."
	local MIN HOUR
	MIN=$(tr -dc '012345' < /dev/urandom | head -c 2 || true)
	HOUR=$(tr -dc '1234567' < /dev/urandom | head -c 1 || true)
	mkdir -p /var/spool/cron/crontabs
	{
		echo "MAILTO=\"\""
		echo "CONTENT_TYPE=\"text/plain; charset=utf-8\""
		echo "*/2 * * * * sudo $HESTIA/bin/h-update-sys-queue restart"
		echo "10 00 * * * sudo $HESTIA/bin/h-update-sys-queue daily"
		echo "15 02 * * * sudo $HESTIA/bin/h-update-sys-queue disk"
		echo "10 00 * * * sudo $HESTIA/bin/h-update-sys-queue traffic"
		echo "30 03 * * * sudo $HESTIA/bin/h-update-sys-queue webstats"
		echo "*/5 * * * * sudo $HESTIA/bin/h-update-sys-queue backup"
		echo "10 05 * * * sudo $HESTIA/bin/h-backup-users"
		echo "20 00 * * * sudo $HESTIA/bin/h-update-user-stats"
		echo "*/5 * * * * sudo $HESTIA/bin/h-update-sys-rrd"
		echo "$MIN $HOUR * * * sudo $HESTIA/bin/h-update-letsencrypt-ssl"
	} > /var/spool/cron/crontabs/hestia
	chmod 600 /var/spool/cron/crontabs/hestia
	chown hestia:hestia /var/spool/cron/crontabs/hestia
	# no auto-update cron: HestiaRE updates via the release tarball, not apt/git
	# Not swallowed (#730): a port that silently does not take leaves the firewall open.
	if ! _port_out=$("$BIN/h-change-sys-port" "${HESTIA_PANEL_PORT:-8083}" 2>&1); then
		echo "[ ! ] Panel port ${HESTIA_PANEL_PORT:-8083} NOT applied: ${_port_out:-no output}"
		echo "[ ! ] The panel stays on $(sed -n 's|^[[:space:]]*https\?://:\([0-9]*\).*|\1|p' /etc/caddy/hestia.conf 2> /dev/null | head -n1). Fix the cause, then: h-change-sys-port ${HESTIA_PANEL_PORT:-8083}"
	fi
	"$BIN/h-update-sys-defaults" > /dev/null 2>&1 || true
	# Seed every config key from its single home. The installer writes only the keys it knows about,
	# and the repair holds the default for all of them - measured on a running box, 25 keys were
	# absent, among them most of the POLICY_* set, which the panel then reads as "" and treats as the
	# permissive side. Runs last, when hestia.conf is complete, and repairs rather than overwrites:
	# every value written above is already non-empty and is left alone.
	"$BIN/h-repair-sys-config" repair > /dev/null 2>&1 || true
	[ -f /root/.bashrc ] && grep -q 'hestia.sh' /root/.bashrc \
		|| printf 'if [ "${PATH#*/usr/local/hestia/bin*}" = "$PATH" ]; then\n    . /etc/profile.d/hestia.sh\nfi\n' >> /root/.bashrc

	stage_mark configure
	echo "[ OK ] configure complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: tools — utilities, composer, wp-cli
# ════════════════════════════════════════════════════════════════════════════

# Upstream composer source: signed installer script, sha384 against installer.sig, bounded downloads.
install_composer_upstream() {
	echo "[ * ] Installing composer (upstream installer)..."
	if ! command -v composer > /dev/null 2>&1; then
		local EXPECTED_CHECKSUM ACTUAL_CHECKSUM
		EXPECTED_CHECKSUM="$(curl -fsS --max-time 30 https://composer.github.io/installer.sig)" \
			|| {
				echo "ERROR: could not fetch the composer installer signature"
				exit 1
			}
		wget https://getcomposer.org/installer --timeout=30 --tries=3 --retry-connrefused --quiet -O composer-setup.php \
			|| {
				rm -f composer-setup.php
				echo "ERROR: could not download the composer installer"
				exit 1
			}
		ACTUAL_CHECKSUM="$(php -r "echo hash_file('sha384', 'composer-setup.php');")"
		if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]; then
			rm -f composer-setup.php
			echo "ERROR: Composer installer checksum mismatch" >&2
			exit 1
		fi
		php composer-setup.php --quiet --install-dir=/usr/local/bin --filename=composer
		rm -f composer-setup.php
		echo "  composer installed"
	else
		echo "  composer already present — upgrading"
		composer self-update --quiet 2> /dev/null || true
	fi
}

install_tools() {
	echo "[ * ] Installing always-installed utilities..."
	# From the manifest, not from a second copy here: the same list stood in both places and only
	# this one ever ran, so editing the manifest changed nothing (#333). Empty is loud, not silent.
	local always
	always=$(jq -r '.tools.always_installed // [] | join(" ")' "$HESTIA/share/manifest.json" 2> /dev/null)
	if [ -z "$always" ]; then
		echo "[ ! ] tools.always_installed is empty or unreadable in $HESTIA/share/manifest.json - no admin tools installed"
	else
		echo "[ * ] Admin tools: $always"
		# shellcheck disable=SC2086 # deliberate space-separated package list
		apt_install_optional "admin tools" $always || true
	fi
	if is_on "${COMPONENT_ADDON_UTILITIES:-}" && [ -n "${TOOLS_SELECTION:-}" ]; then
		echo "[ * ] Installing selected utilities: ${TOOLS_SELECTION}"
		# shellcheck disable=SC2086 # TOOLS_SELECTION is a deliberate space-separated package list
		apt_install_optional "selected tools" $TOOLS_SELECTION || true
	fi
	# No default: an absent key means "not chosen", like every other addon gate here (#928).
	if is_on "${COMPONENT_ADDON_COMPOSER:-}"; then
		# os_package default: apt-maintained with automatic security backports; upstream_installer
		# (latest preset / h-update-sys-composer) = newest composer, no auto-updates afterwards
		case "${COMPONENT_ADDON_COMPOSER_SOURCE:-os_package}" in
			upstream_installer) install_composer_upstream ;;
			*)
				echo "[ * ] Installing composer (OS package)..."
				if dpkg -s composer > /dev/null 2>&1; then
					echo "  composer OS package already present"
				else
					hestia_apt -y install composer \
						|| {
							echo "ERROR: composer OS package install failed"
							exit 1
						}
				fi
				;;
		esac
	fi
	echo "[ * ] Installing wp-cli (system-wide, pinned)..."
	# pinned + verified phar; no `wp cli update` - a re-run converges to the manifest pin
	if ! command -v wp > /dev/null 2>&1; then
		fetch_wp_cli_phar /usr/local/bin/wp \
			|| {
				echo "ERROR: could not fetch/verify the pinned wp-cli phar"
				exit 1
			}
		echo "  wp-cli installed"
	else
		echo "  wp-cli already present — re-pinning"
		fetch_wp_cli_phar /usr/local/bin/wp || echo "  WARN: could not refresh wp-cli, keeping the present one"
	fi
	echo "[ OK ] tools complete"
}

# ════════════════════════════════════════════════════════════════════════════
# Stage: finalize — start service, schedule LE cert, summary
# ════════════════════════════════════════════════════════════════════════════
finalize_install() {
	local HESTIA_PASS
	if [ -f "$CONF_DIR/.admin_pass.tmp" ]; then
		HESTIA_PASS=$(cat "$CONF_DIR/.admin_pass.tmp")
		rm -f "$CONF_DIR/.admin_pass.tmp"
	else
		HESTIA_PASS="(not found — use h-change-user-password $HESTIA_ADMIN <newpass>)"
	fi

	# stamp install.conf with install metadata (date + version)
	local _ver
	_ver=$(cat "$HESTIA/VERSION" 2> /dev/null || echo "dev")
	grep -q '^INSTALL_DATE=' "$INSTALL_CONF" 2> /dev/null || echo "INSTALL_DATE=\"$(date +%F)\"" >> "$INSTALL_CONF"
	if grep -q '^INSTALL_VERSION=' "$INSTALL_CONF" 2> /dev/null; then
		sed -i "s|^INSTALL_VERSION=.*|INSTALL_VERSION=\"${_ver}\"|" "$INSTALL_CONF"
	else
		echo "INSTALL_VERSION=\"${_ver}\"" >> "$INSTALL_CONF"
	fi

	echo "[ * ] Restarting panel services (Caddy + hestia-php)..."
	# restart both so configure-stage changes (SSL cert, panel port) take effect
	systemctl restart caddy hestia-php 2> /dev/null || true
	chown hestia:hestia "$HESTIA/.sessions"
	mkdir -p /backup && chmod 711 /backup
	# Now, with the cron only as fallback: @reboot alone meant a box that is never rebooted never got
	# a certificate. The web domain exists and the web server is up by here, so ACME can answer.
	echo "[ * ] Requesting Let's Encrypt host certificate..."
	if "$BIN/h-add-letsencrypt-host" >> "$LOG" 2>&1; then
		echo "[ OK ] Panel certificate issued for $HESTIA_HOSTNAME"
		rm -f /etc/cron.d/hestia-ssl
	else
		echo "[ !! ] Let's Encrypt could not issue yet (public DNS for $HESTIA_HOSTNAME and port 80"
		echo "       have to be reachable). The panel keeps its self-signed certificate; the request"
		echo "       is retried once after the next reboot, or run h-add-letsencrypt-host by hand."
		echo "@reboot root sleep 10 && rm /etc/cron.d/hestia-ssl && PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:' && $HESTIA/bin/h-add-letsencrypt-host" \
			> /etc/cron.d/hestia-ssl
		# cron REFUSES a group- or world-writable file in /etc/cron.d and says so only in its log
		# ("INSECURE MODE"). The installer's umask left it 0664, so this fallback never ran anywhere.
		chmod 644 /etc/cron.d/hestia-ssl
	fi
	echo "[ * ] Building initial RRD graphs..."
	"$BIN/h-update-sys-rrd" > /dev/null 2>&1 || true
	echo "[ * ] Final package upgrade..."
	apt-get -qq update || true
	hestia_apt -y upgrade || true
	local HOST_IP
	# src of the route toward a public address, with the -6 twin for a box that has no v4 route.
	# Each probe absorbs its own failure, or that lookup's exit 2 aborts the installer right here.
	HOST_IP=$(ip route get 8.8.8.8 2> /dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}' | head -n1) || HOST_IP=''
	if [ -z "$HOST_IP" ]; then
		HOST_IP=$(ip -6 route get 2606:4700:4700::1111 2> /dev/null \
			| awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}' | head -n1) || HOST_IP=''
	fi
	[ -n "$HOST_IP" ] || HOST_IP=$(hostname -I | awk '{print $1}')
	# a v6 literal is only a URL with brackets
	case "$HOST_IP" in *:*) HOST_IP="[$HOST_IP]" ;; esac
	echo ""
	echo "========================================================================"
	echo " HestiaRE installation complete!"
	echo "========================================================================"
	echo ""
	echo "  Panel URL:  https://$HESTIA_HOSTNAME:${HESTIA_PANEL_PORT:-8083}"
	echo "  Backup URL: https://$HOST_IP:${HESTIA_PANEL_PORT:-8083}"
	echo ""
	echo "  Username:   $HESTIA_ADMIN"
	echo "  Password:   $HESTIA_PASS"
	echo ""
	echo "  Install log: $LOG"
	echo "  IMPORTANT: Reboot the server to complete the installation."
	echo ""
	# An optional component that did not install must be visible HERE, not only in the log: the whole
	# point of #480 is that install.conf claimed a component was on while the package was absent.
	if [ -n "${HESTIA_INSTALL_WARNINGS:-}" ]; then
		echo "  [ ! ] Some optional packages did not install:"
		printf '%s' "$HESTIA_INSTALL_WARNINGS" | sed '/^$/d; s/^/        /'
		echo "        The matching feature is NOT active. Re-run its h-add-sys-* command once the"
		echo "        system is idle, or install the package and re-run the installer."
		echo ""
	fi
}

# ════════════════════════════════════════════════════════════════════════════
# Orchestration
# ════════════════════════════════════════════════════════════════════════════
echo "========================================================================"
echo " HestiaRE ${VERSION:-dev}"
echo " OS:      ${INSTALL_OS}"
echo " Profile: ${INSTALL_PROFILE}"
echo "========================================================================"
echo ""

# nomail: install the MTA, then configure it send-only (#872). Without a mail block nothing
# used to install exim at all - it only LOOKED right on Debian, whose base image ships
# exim4-daemon-light, while Ubuntu ships no MTA and every notification died in PHP's mail()
# with "sh: /usr/sbin/sendmail: not found" and a return code of 0.
#
# light, not heavy: send-only needs no lookups or authenticators. A box that later gains a
# mail block gets heavy from install_mail, which replaces light - the two conflict, and that
# swap is the accepted cost of the leaner default.
#
# No stage marker on purpose: a re-run must repair a missing MTA, and apt is a no-op when the
# package is already there.
install_exim_sendonly() {
	# Looked at, not asserted: saying "mail goes through a relay" without checking leaves the
	# box in the state the smoke test flags as a FAIL one minute later.
	if ! is_on "${COMPONENT_PANEL_EXIM:-true}"; then
		if [ "${USE_SERVER_SMTP:-}" = 'true' ] && [ -n "${SERVER_SMTP_HOST:-}" ]; then
			echo "[ * ] Local MTA disabled (COMPONENT_PANEL_EXIM) - notification mail goes through ${SERVER_SMTP_HOST}"
		else
			echo "[ ! ] Local MTA disabled (COMPONENT_PANEL_EXIM) and no SMTP relay configured -"
			echo "[ ! ] notification mail is lost until USE_SERVER_SMTP and SERVER_SMTP_HOST are set"
		fi
		return 0
	fi
	echo "[ * ] Installing send-only MTA (exim4-daemon-light)..."
	if ! hestia_apt -y install exim4 exim4-daemon-light; then
		echo "[ ! ] exim4-daemon-light install FAILED - notification mail will not leave this box"
		return 0
	fi
	configure_exim_sendonly
}

# Cron and the panel address their mail to root@<hostname> and to the admin contact. Left alone,
# /etc/aliases decides nothing useful: the base image ships its own root: line pointing at a user
# that does not exist here, and the panel's default contact admin@<hostname> has no target at all -
# both ended up in the queue (measured: 454 relay access denied against a foreign host).
configure_system_aliases() {
	local target='' al=/etc/aliases
	# Only an address outside this host is worth forwarding to; the default contact is
	# admin@<hostname> and would point back at the box.
	case "${HESTIA_EMAIL:-}" in
		'' | *@"${HESTIA_HOSTNAME}") : ;;
		*) target="$HESTIA_EMAIL" ;;
	esac
	touch "$al"
	# Both lines go: an inherited "<admin>: root" together with our "root: <admin>" is a loop, and
	# exim resolves a loop by delivering as root - which never_users then refuses.
	sed -i "/^[[:space:]]*root:/d;/^[[:space:]]*${HESTIA_ADMIN}:/d" "$al"
	# root is always aliased away: exim's never_users refuses a delivery as uid 0, so mail addressed
	# to root has to become some other account before it can land anywhere. Without an outside
	# address that account is the panel admin, whose mbox a human on the box can read.
	echo "root: ${target:-$HESTIA_ADMIN}" >> "$al"
	command -v newaliases > /dev/null 2>&1 && newaliases > /dev/null 2>&1
	if [ -n "$target" ]; then
		echo "[ * ] System mail for root is forwarded to $target"
	else
		echo "[ * ] System mail for root lands in /var/mail/${HESTIA_ADMIN} on this box"
	fi
}

# nomail (#192): exim stays as the outbound-only notification MTA, but Debian's
# default config is local-delivery-only - panel mail to any remote admin address
# was silently undeliverable ("Mailing to remote domains not supported"). internet
# type with loopback-only listeners is exactly send-only: accept from localhost,
# deliver anywhere out.
configure_exim_sendonly() {
	local c=/etc/exim4/update-exim4.conf.conf
	if [ ! -f "$c" ]; then
		echo "[ ! ] $c missing - exim not configured send-only (notification mail will not leave this box)"
		return 0
	fi
	sed -i "s/^dc_eximconfig_configtype=.*/dc_eximconfig_configtype='internet'/" "$c"
	# Loopback list DERIVED from the kernel: a listed ::1 on an ipv6.disable=1 kernel kills
	# the stock-template exim at start (the full hestia template survives either way).
	local lo_ifaces='127.0.0.1'
	[ -e /proc/net/if_inet6 ] && lo_ifaces='127.0.0.1 ; ::1'
	sed -i "s/^dc_local_interfaces=.*/dc_local_interfaces='$lo_ifaces'/" "$c"
	# Set, not inherited: this is what makes root@<hostname> local instead of a DNS lookup that
	# hands the box's own cron mail to whatever host answers for the name.
	sed -i "s/^dc_other_hostnames=.*/dc_other_hostnames='${HESTIA_HOSTNAME}'/" "$c"
	# the success line is a witness in the install log: print it only when the keys
	# really carry the values and the regeneration succeeded - a silent sed miss or
	# a failed update-exim4.conf must not leave a false "configured" behind
	if grep -q "^dc_eximconfig_configtype='internet'" "$c" \
		&& grep -q "^dc_local_interfaces='$lo_ifaces'" "$c" \
		&& update-exim4.conf 2> /dev/null; then
		systemctl restart exim4 2> /dev/null || true
		echo "[ * ] Exim configured send-only (outbound delivery on, loopback listeners)"
	else
		echo "[ ! ] Exim send-only configuration FAILED - check $c and update-exim4.conf"
	fi
}

init_hestia_structure
install_base
install_panel
install_web
install_db
if is_on "${COMPONENT_MAIL_BLOCK_PRESENT:-}"; then
	install_mail
else
	echo "[ * ] Mail block not present — skipping mail stage"
	install_exim_sendonly
fi
configure_system_aliases
install_security
install_addons
configure_hestia
install_tools
finalize_install

# Post-install smoke test — report only, never aborts a completed install (#221). tee'd into the
# log so a transient failure keeps its NAME: a checker that occasionally goes red without saying
# which check is the one everybody learns to ignore.
echo ""
"$BIN/h-check-sys-smoke" 2>&1 | tee -a "$LOG" || echo "[ ! ] Smoke test reported failures — see above (kept in $LOG)."

log_event "$OK" "$ARGUMENTS"
exit 0

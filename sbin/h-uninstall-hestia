#!/bin/bash
# info: uninstall HestiaRE (keeps /home and databases)
# options: [--purge]
# labels: internal
# caller: hestia uninstall
#
# Stops the panel and removes its system config; packages and the tree stay. --purge also removes caddy, the tree,
# $CONF_DIR and the units that run from it. /home and the databases always stay.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

HESTIA="${HESTIA:-/usr/local/hestia}"
CONF_DIR="/etc/hestia"
PURGE=false
[ "${1:-}" = "--purge" ] && PURGE=true

[ "$(id -u)" = "0" ] || {
	echo "ERROR: must run as root." >&2
	exit 1
}

echo "========================================================================"
echo " HestiaRE Uninstall"
echo "========================================================================"
echo ""
echo "This stops HestiaRE services and removes the panel system config."
if [ "$PURGE" = true ]; then
	echo "PURGE: also purges caddy and deletes $HESTIA + $CONF_DIR."
	echo "       Web, mail and FTP services that use the panel certificates fail at their next restart,"
	echo "       and the HestiaRE firewall is gone after the next reboot."
fi
echo "/home user data and databases are ALWAYS kept."
echo ""
read -rp "Proceed? [y/N] " confirm < /dev/tty
case "$confirm" in
	[yY] | [yY][eE][sS]) ;;
	*)
		echo "Aborted."
		exit 1
		;;
esac

echo "[ * ] Stopping services..."
for s in hestia-php caddy; do
	systemctl stop "$s" 2> /dev/null || true
	systemctl disable "$s" 2> /dev/null || true
done

# Inline, not via include/limits.sh: --purge deletes the tree before this could source it.
# Left behind, the slice keeps its static default on customer PHP with nothing to recompute it.
echo "[ * ] Removing the customer PHP cap..."
systemctl disable --now hestia-customer-php-limit.service 2> /dev/null || true
rm -f /etc/systemd/system/hestia-customer-php-limit.service /etc/systemd/system/hestia-customer-php.slice
rm -f /etc/systemd/system/php*-fpm.service.d/hestia-slice.conf
rmdir /etc/systemd/system/php*-fpm.service.d 2> /dev/null || true
systemctl daemon-reload
for s in /etc/php/*/fpm; do
	[ -d "$s" ] || continue
	v=$(basename "$(dirname "$s")")
	[ "$v" = 'hestia' ] && continue
	systemctl try-restart "php$v-fpm" 2> /dev/null || true
done

echo "[ * ] Removing cron, profile and sudoers entries..."
rm -f /var/spool/cron/crontabs/hestia 2> /dev/null || true
rm -f /etc/cron.d/hestia-* 2> /dev/null || true
rm -f /etc/profile.d/hestia.sh 2> /dev/null || true
rm -f /etc/sudoers.d/hestia 2> /dev/null || true
rm -f "$CONF_DIR"/.done.* 2> /dev/null || true
# The installer's block in root's .bashrc sources the profile file removed above, so every root shell would
# complain. Exactly its three lines; keep in step with configure in h-install-hestia.
if [ -f /root/.bashrc ]; then
	tmp=$(mktemp)
	awk -v a='if [ "${PATH#*/usr/local/hestia/bin*}" = "$PATH" ]; then' -v b='    . /etc/profile.d/hestia.sh' '
		{ l[NR] = $0 }
		END {
			for (i = 1; i <= NR; i++) {
				if (l[i] == a && l[i + 1] == b && l[i + 2] == "fi") { i += 2; continue }
				print l[i]
			}
		}' /root/.bashrc > "$tmp" && ! cmp -s "$tmp" /root/.bashrc && cat "$tmp" > /root/.bashrc
	rm -f "$tmp"
fi

if [ "$PURGE" = true ]; then
	echo "[ * ] Purging panel packages and directories..."
	DEBIAN_FRONTEND=noninteractive apt-get -y purge caddy 2> /dev/null || true
	# Every hestia-* unit runs something from the tree removed below; the firewall's own sits in /lib.
	# None has an ExecStop, so stopping leaves the loaded ruleset in place until the reboot.
	for u in /etc/systemd/system/hestia-* /lib/systemd/system/hestia-*; do
		[ -e "$u" ] || continue
		systemctl disable --now "$(basename "$u")" 2> /dev/null || true
		rm -rf "$u"
	done
	rm -f /etc/apt/apt.conf.d/95hestia-php-refresh /etc/logrotate.d/hestia
	systemctl daemon-reload
	rm -rf "$HESTIA" "$CONF_DIR"
	# Both live outside the install root, so the line above does not reach them. The SNI dir
	# holds only symlinks into the customers' own mail conf, which stays.
	rm -rf /etc/ssl/hestia /etc/exim4/ssl
	echo "[ * ] Purged. /home user data and databases left intact."
else
	echo "[ * ] Panel config removed. Packages, $HESTIA and $CONF_DIR left in place."
	echo "      Re-run install.sh to reinstall, or pass --purge to remove everything."
fi
echo ""
echo "Done."

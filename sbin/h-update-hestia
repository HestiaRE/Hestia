#!/bin/bash
# info: work an update plan off, entry by entry
# options: PLAN
# labels: internal
# caller: hestia update
#
# example: h-update-hestia /root/hestiare-update/2026-09-22_15-48-17_v0.20.0_v0.21/update.conf
#
# The executor only; finding, fetching and securing a release is update.sh. The log is evidence, never
# control: each entry's condition decides on every run, so a repeat after an abort converges.

# The ambient umask differs by OS, and cron refuses a group-writable file in /etc/cron.d.
umask 0022

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/update.sh
source "$HESTIA/include/update.sh"

PLAN="${1:-}"
if [ -z "$PLAN" ]; then
	cmd_usage
	check_result "$E_ARGS" "no plan given: 'hestia update' writes the plan and hands it here"
fi
# Absolute, because the log and the marker land next to the plan. The run directory is update.sh's.
case "$PLAN" in
	/*) ;;
	*) check_result "$E_INVALID" "PLAN must be an absolute path - the log and the marker belong next to the backup" ;;
esac
[ -f "$PLAN" ] || check_result "$E_NOTEXIST" "no plan at $PLAN"
RUNDIR=$(dirname "$PLAN")
jq -e '.entries | type == "array"' "$PLAN" > /dev/null 2>&1 \
	|| check_result "$E_PARSING" "$PLAN carries no entry list - derive it with h-list-sys-updates json"

LOG="$RUNDIR/update.log"
# State, not log: the executor and the rollback script both decide by this file's existence.
MARKER="$RUNDIR/point-of-no-return"
# update.sh writes exactly this path next to the backup; keep the two in step.
ROLLBACK="$RUNDIR/rollback.sh"
RUNID=$(date '+%Y-%m-%d %H:%M:%S')

log() { printf '%s %s\n' "$RUNID" "$1" >> "$LOG"; }

count=$(jq -r '.entries | length' "$PLAN")
irreversible=$(jq -r '[.entries[] | select(.reversible != true) | .identity] | join(", ")' "$PLAN")
echo "Plan: $count entry(s) from $(jq -r '.version_from' "$PLAN") to $(jq -r '.version_to' "$PLAN")"
if [ -n "$irreversible" ]; then
	echo "      past the point of no return: $irreversible"
else
	echo "      every entry can be taken back by putting files back"
fi
log "run starts, $count entry(s), plan $PLAN"

failed=""
while read -r entry; do
	[ -n "$entry" ] || continue
	ident=$(jq -r '.identity' <<< "$entry")
	type=$(jq -r '.action.type' <<< "$entry")
	mapfile -t argv < <(upd_argv "$entry" .action)

	# Drawn when reached, not when read: a run that stops before it must stay rollback-able.
	if [ "$(jq -r '.reversible' <<< "$entry")" != true ] && [ ! -f "$MARKER" ]; then
		printf '%s\n' "$RUNID" > "$MARKER"
		echo "--- point of no return: from here nothing is undone by putting files back ---"
		log "marker written before $ident"
	fi

	echo "[ * ] $ident: $(jq -r '.description' <<< "$entry")"
	log "start $ident ($type)"
	upd_action "$type" "${argv[@]}"
	rc=$?
	log "end   $ident rc=$rc"
	if [ "$rc" -ne 0 ]; then
		failed="$ident"
		break
	fi
	# Evidence, not control: an entry whose condition survives its action would come back in every plan.
	if upd_entry_applies "$entry"; then
		echo "[ ! ] $ident ran, but its condition is still true - it does not negate itself"
		log "warn  $ident condition still true after a successful action"
	fi
done < <(jq -c '.entries[]' "$PLAN")

if [ -n "$failed" ]; then
	log "run stops at $failed"
	echo
	echo "h-update-hestia: stopped at $failed (rc $rc). Nothing after it ran."
	if [ -f "$MARKER" ]; then
		echo "  This run is PAST the point of no return, so writing files back is not offered."
		echo "  forward: hestia update    (the plan is derived again, done entries fall out)"
	else
		echo "  back:    bash $ROLLBACK"
		echo "  forward: hestia update    (the plan is derived again, done entries fall out)"
	fi
	echo "  log:     $LOG"
	exit "$E_UPDATE"
fi

# Housekeeping after a finished list: a failed repair is loud and repeatable, not a reason to withhold the version.
if ! "$BIN/h-repair-sys-config" repair > /dev/null 2>&1; then
	echo "[ ! ] h-repair-sys-config repair ended non-zero - run it by hand and read what it says"
	log "warn  repair ended non-zero"
fi
"$BIN/h-update-sys-defaults" > /dev/null 2>&1 || true

# Already right means no write: a needless rewrite moves an mtime that guards read.
tree_version=$(cat "$HESTIA/VERSION" 2> /dev/null)
if [ -z "$tree_version" ]; then
	echo "[ ! ] no VERSION in $HESTIA - the status version stays on the old value"
	log "warn  tree carries no VERSION"
elif [ "$(upd_key_value VERSION)" = "$tree_version" ]; then
	log "status version already $tree_version"
else
	change_sys_value VERSION "$tree_version"
	log "status version set to $tree_version"
fi
[ -z "$(upd_key_value UPDATE_AVAILABLE)" ] || clear_sys_value UPDATE_AVAILABLE
# No stop to match it here: update.sh stopped the panel around the unpacking.
systemctl start caddy hestia-php 2> /dev/null || true

log "run done"
echo
echo "Done: $count entry(s), status version $(cat "$HESTIA/VERSION" 2> /dev/null). Log: $LOG"

exit

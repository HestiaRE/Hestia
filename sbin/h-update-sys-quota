#!/bin/bash
# info: re-derive and arm project quota from the live filesystem
# options: NONE
#
# example: h-update-sys-quota
#
# Re-runs the installer's arming and writes PROJECT_QUOTA from the probe: the way out of none:* once its reason is
# fixed, since the boot unit only re-checks pending. Separate-/home arming umounts and refuses a busy mount loudly.

# shellcheck source=/etc/hestia/hestia.env
source /etc/hestia/hestia.env
# shellcheck source=/usr/local/hestia/include/main.sh
source $HESTIA/include/main.sh
# shellcheck source=/usr/local/hestia/include/quota.sh
source $HESTIA/include/quota.sh
source_conf "$HESTIA/conf/hestia.conf"

quota_arm

# stamp existing customers where the arming just turned enforcement on
source_conf "$HESTIA/conf/hestia.conf"
if [ "${PROJECT_QUOTA%%:*}" = 'active' ]; then
	for user in $("$BIN/h-list-users" list); do
		"$BIN/h-update-user-quota" "$user"
	done
fi

"$BIN/h-log-action" "system" "Info" "System" "Project quota re-armed (state: $(grep -o "^PROJECT_QUOTA='[^']*'" "$HESTIA/conf/hestia.conf"))."
log_event "$OK" "$ARGUMENTS"

exit

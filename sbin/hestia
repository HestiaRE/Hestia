#!/bin/bash
# info: HestiaRE umbrella command
# options: install | configure | update | uninstall | status
#
# The brand command, a deliberate exception to the h-* naming.

HESTIA="${HESTIA:-/usr/local/hestia}"
BIN="$HESTIA/bin"
SBIN="$HESTIA/sbin"
cmd="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
	install) exec "$SBIN/h-install-hestia" "$@" ;;
	configure) exec bash "$HESTIA/include/wizard.sh" "$@" ;;
	update)
		# Asked here, not in update.sh: that one re-executes itself on a handover and is driven by scripts.
		if [ "${1:-}" != "--check" ]; then
			assume_yes=no
			case "${1:-}" in -y | --yes)
				assume_yes=yes
				shift
				;;
			esac
			# --check refuses a test tarball, so that run is asked without naming the target.
			if [ -z "${HESTIA_RELEASE_URL:-}" ]; then
				check=$(bash "$HESTIA/update.sh" --check) || exit 1
				printf '%s\n' "$check"
				# Nothing newer still runs: update.sh finishes pending entries or says so. Matching the "nothing"
				# line of update.sh --check means a reworded one asks rather than updates unasked.
				case "$check" in *"nothing newer than"*) exec bash "$HESTIA/update.sh" "$@" ;; esac
			fi
			if [ "$assume_yes" = no ]; then
				if ! { : < /dev/tty; } 2> /dev/null; then
					echo "hestia update: no terminal to ask on - pass --yes to update unattended" >&2
					exit 1
				fi
				read -rp "Run the update now? [y/N] " answer < /dev/tty
				case "$answer" in
					[yY] | [yY][eE][sS]) ;;
					*)
						echo "Aborted, nothing was touched."
						exit 1
						;;
				esac
			fi
		fi
		exec bash "$HESTIA/update.sh" "$@"
		;;
	uninstall) exec "$SBIN/h-uninstall-hestia" "$@" ;;
	status) exec "$BIN/h-list-sys-install" "$@" ;;
	"" | help | -h | --help)
		cat << 'EOF'
hestia - HestiaRE control

Usage: hestia <command> [args]

  install      run the installer (reads /etc/hestia/install.conf)
  configure    (re)generate /etc/hestia/install.conf via the wizard
  update       update this box to the release it follows        [--check | --yes]
  uninstall    remove HestiaRE panel config (keeps /home + DBs) [--purge]
  status       show installed version, OS, profile and components
EOF
		;;
	*)
		echo "hestia: unknown command '$cmd' (try: hestia help)" >&2
		exit 1
		;;
esac

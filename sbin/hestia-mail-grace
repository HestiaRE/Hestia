#!/bin/bash
# The mail password grace (#1155): fail2ban asks here once per failure, through ignorecommand.
#   hestia-mail-grace mailbox IP MAILBOX   dovecot jail: exit 0 = this mailbox from this network does not count
#   hestia-mail-grace ip IP                exim jail: exit 0 = nothing from this network counts
#   hestia-mail-grace key mailbox|ip IP [MAILBOX]   the state file h-add-mail-account-grace writes
# MAILBOX comes from a log line and this runs as root, so it is only ever hashed, never a path or a word.
# Forked on every failure, so plain bash without includes. /run is tmpfs: a reboot ends every grace.

GRACE_DIR=/run/hestia/mail-grace

# v4 as it is, v6 as its /64, since the devices of one home network share the prefix, not the address.
grace_net() {
	local ip=${1,,} head tail g i
	local -a h=() t=() all=()
	case "$ip" in
		*:*) ;;
		*)
			[[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
			echo "$ip"
			return 0
			;;
	esac
	ip=${ip%%\%*}
	# A mapped address is reported by fail2ban as its v4 form.
	if [[ "$ip" =~ ^::ffff:([0-9]{1,3}(\.[0-9]{1,3}){3})$ ]]; then
		echo "${BASH_REMATCH[1]}"
		return 0
	fi
	[[ "$ip" == *::*::* || "$ip" == *.* ]] && return 1
	if [[ "$ip" == *::* ]]; then
		head=${ip%%::*} tail=${ip#*::}
	else
		head=$ip tail=
	fi
	[ -n "$head" ] && IFS=: read -ra h <<< "$head"
	[ -n "$tail" ] && IFS=: read -ra t <<< "$tail"
	if [[ "$ip" == *::* ]]; then
		[ $((${#h[@]} + ${#t[@]})) -le 7 ] || return 1
	else
		[ ${#h[@]} -eq 8 ] || return 1
	fi
	all=("${h[@]}")
	for ((i = ${#h[@]} + ${#t[@]}; i < 8; i++)); do all+=(0); done
	all+=("${t[@]}")
	for g in "${all[@]}"; do
		[[ "$g" =~ ^[0-9a-f]{1,4}$ ]] || return 1
	done
	printf '%x:%x:%x:%x::/64\n' $((16#${all[0]})) $((16#${all[1]})) $((16#${all[2]})) $((16#${all[3]}))
}

grace_key() {
	local kind="$1" net
	net=$(grace_net "$2") || return 1
	case "$kind" in
		mailbox)
			[ -n "$3" ] || return 1
			echo "m-$(printf '%s|%s' "$net" "${3,,}" | sha256sum | cut -c1-64)"
			;;
		ip) echo "i-$(printf '%s' "$net" | sha256sum | cut -c1-64)" ;;
		*) return 1 ;;
	esac
}

grace_active() {
	local f exp now
	f="$GRACE_DIR/$(grace_key "$@")" || return 1
	[ -f "$f" ] || return 1
	read -r exp _ < "$f"
	printf -v now '%(%s)T' -1
	[[ "$exp" =~ ^[0-9]+$ ]] && [ "$exp" -gt "$now" ]
}

case "$1" in
	mailbox) grace_active mailbox "$2" "$3" ;;
	ip) grace_active ip "$2" ;;
	key) grace_key "$2" "$3" "$4" ;;
	*)
		echo "usage: $0 mailbox IP MAILBOX | ip IP | key mailbox|ip IP [MAILBOX]" >&2
		exit 2
		;;
esac

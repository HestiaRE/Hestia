#!/bin/sh
# Panel PHP CLI: one static path for $HESTIA_PHP, the version in /etc/php/hestia/php-version, the panel's php.ini.
# Not named php: $HESTIA/bin comes last in PATH, so a bare php is the system one.
v=$(cat /etc/php/hestia/php-version 2> /dev/null)
[ -n "$v" ] || v=$(ls -1 /usr/bin/php[0-9].[0-9] 2> /dev/null | sort -V | tail -n1 | sed 's#.*/php##')
ini="/etc/php/hestia/cli/php.ini"
# The panel's own extension set; until hestia-php-confd built it, the compiled scan dir rather than none.
confd="/etc/php/hestia/cli/conf.d"
if [ -d "$confd" ] && [ -n "$(ls -A "$confd" 2> /dev/null)" ]; then
	export PHP_INI_SCAN_DIR="$confd"
fi
if [ -f "$ini" ]; then
	exec "/usr/bin/php${v}" -c "$ini" "$@"
else
	exec "/usr/bin/php${v}" "$@"
fi

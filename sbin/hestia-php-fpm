#!/bin/sh
# Panel PHP-FPM, the ExecStart of hestia-php.service; version file and conf.d rule as in hestia-php.
# exec keeps the PID the unit's Type=notify watches.
# hestia-php.service always passes the fpm config; bare, php-fpm would start a second master on the
# distribution's php-fpm.conf, which carries the customer pools.
if [ "$#" -eq 0 ]; then
	echo "hestia-php-fpm: started by hestia-php.service (systemctl restart hestia-php)" >&2
	exit 64
fi
v=$(cat /etc/php/hestia/php-version 2> /dev/null)
[ -n "$v" ] || v=$(ls -1 /usr/sbin/php-fpm[0-9].[0-9] 2> /dev/null | sort -V | tail -n1 | sed 's#.*/php-fpm##')
# Own php.ini: the customer config disables exec, which the panel needs.
ini="/etc/php/hestia/fpm/php.ini"
confd="/etc/php/hestia/fpm/conf.d"
if [ -d "$confd" ] && [ -n "$(ls -A "$confd" 2> /dev/null)" ]; then
	export PHP_INI_SCAN_DIR="$confd"
fi
if [ -f "$ini" ]; then
	exec "/usr/sbin/php-fpm${v}" -c "$ini" "$@"
else
	exec "/usr/sbin/php-fpm${v}" "$@"
fi

#!/bin/sh
# info: restart hestia-php when its master runs a deleted PHP binary image
# labels: internal
# caller: the apt Post-Invoke hook
#
# The distribution postinst restarts only its own phpX.Y-fpm, and with OS PHP the binary moves on every security
# update. Restarts only when /proc says the running image is gone, so every other apt run is a no-op.

# The rest of the tree gets --help through main.sh, which this command does not load.
# shellcheck source=/usr/local/hestia/include/help.sh
case "$*" in -h | --help) . "${HESTIA:-/usr/local/hestia}/include/help.sh" ;; esac

pid=$(systemctl show -p MainPID --value hestia-php 2> /dev/null)
[ -n "$pid" ] && [ "$pid" != 0 ] || exit 0
exe=$(readlink "/proc/$pid/exe" 2> /dev/null)
case "$exe" in
	*' (deleted)')
		# apt needs rc 0, and a failed restart leaves the panel down: one trace that dates it.
		systemctl restart hestia-php 2> /dev/null \
			|| logger -t hestia-php-refresh "restart failed after a PHP update replaced the master binary - panel likely down"
		;;
esac
exit 0

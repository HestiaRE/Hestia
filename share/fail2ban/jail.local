# No mysqld jail: 3306 is not in the shipped ruleset, so MariaDB is reachable only from loopback and the box
# itself - both of which h-add-firewall-ban refuses to ban. Whoever opens 3306 owns its access control.
#
# The backend is PINNED, not inherited: Ubuntu 24.04's defaults-debian.conf puts `backend = systemd` in
# [DEFAULT], so ours would watch the journal, never read their logpath, and match nothing while looking healthy.
[DEFAULT]
backend = auto

[ssh-iptables]
enabled  = true
filter   = sshd
action   = hestia[name=SSH]
logpath  = /var/log/auth.log
maxretry = 5

# The mail password grace (#1155): a failure the grace covers is not counted. exim by network only, dovecot per mailbox.
[exim-iptables]
enabled  = true
filter   = exim
action   = hestia[name=MAIL]
logpath  = /var/log/exim4/mainlog
ignorecommand = /usr/local/hestia/sbin/hestia-mail-grace ip <ip>

[dovecot-iptables]
enabled  = true
filter   = hestia-dovecot
action   = hestia[name=MAIL]
logpath  = /var/log/dovecot.log
ignorecommand = /usr/local/hestia/sbin/hestia-mail-grace mailbox <ip> <F-USER>

[proftpd-iptables]
enabled  = true
filter   = proftpd
action   = hestia[name=FTP]
logpath  = /var/log/proftpd/proftpd.log
maxretry = 5

[hestia-iptables]
enabled  = true
filter   = hestia
action   = hestia-panel
logpath  = /var/log/hestia/auth.log
maxretry = 5

# enabled is a placeholder: fail2ban_gate_webmail_jails flips each on per WEBMAIL_SYSTEM and creates its log,
# since a jail on a missing file never fires. The real client reaches the log via the webmail vhost headers.
[roundcube-auth]
enabled  = false
filter   = hestia-roundcube
action   = hestia[name=WEB]
logpath  = /var/log/roundcube/userlogins.log
maxretry = 5

[tachyon-auth]
enabled  = false
filter   = hestia-tachyon
action   = hestia[name=WEB]
logpath  = /var/log/tachyon/fail2ban/auth.txt
maxretry = 5

[phpmyadmin-auth]
enabled  = true
filter   = phpmyadmin-syslog
action   = hestia[name=WEB]
logpath  = /var/log/auth.log
maxretry = 5

# Scanners probing customer vhosts for apps that are not installed; logpath is a placeholder, repointed by
# fail2ban_gate_web_jail. Never extended to the rate limiter's 429s - Layer B must not escalate into bans.
#
# Thresholds spelled out, not inherited: this is armed on every domain of every box, so they are a decision.
# 10-in-10 is safe because only botsearch-vocabulary 404s count - eight ordinary ones measured zero.
[web-botsearch]
enabled  = true
filter   = hestia-botsearch
action   = hestia[name=WEBSCAN]
logpath  = /var/log/apache2/domains/*.log
maxretry = 10
findtime = 600
bantime  = 600

# The signature web jails: same log, same placeholder logpath and same WEB chain as web-botsearch.
# Signature/behaviour based, never rate - that is Layer B's job and its 429s must not escalate.
# maxretry >= 2 everywhere so nothing bans on a single hit. The filters say what each one matches.

# "Looking for files that should not be here" - secrets/config/info-leak paths, status-agnostic.
[web-badactor]
enabled  = true
filter   = hestia-badactor
action   = hestia[name=WEBSCAN]
logpath  = /var/log/apache2/domains/*.log
maxretry = 2
findtime = 600
bantime  = 3600

# "Trying to execute code or break out of the directory" - traversal / RCE / appliance-exploit payloads.
[web-exploit]
enabled  = true
filter   = hestia-exploit
action   = hestia[name=WEBSCAN]
logpath  = /var/log/apache2/domains/*.log
maxretry = 2
findtime = 600
bantime  = 3600

# 401 only, counted per source IP AGGREGATED over every vhost - hence the high maxretry, for shared NAT.
[web-authprobe]
enabled  = true
filter   = hestia-authprobe
action   = hestia[name=WEB]
logpath  = /var/log/apache2/domains/*.log
maxretry = 20
findtime = 600
bantime  = 1800

[recidive]
enabled  = true
filter   = recidive
action   = hestia[name=RECIDIVE]
logpath  = /var/log/fail2ban.log
maxretry = 5
findtime = 86400
bantime  = 864000

# No whitelisting here: h-add-firewall-exclude mirrors one list into jail.d/hestia-zz-whitelist.local.

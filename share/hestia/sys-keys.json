  "DB_ADMINER_ALIAS": {
   "class": "system",
   "default": ""
  },
  "DB_MARIADB_SYSTEM": {
   "class": "system",
   "default": "",
   "note": "a local MariaDB package is installed; value = its source in the recipe's own words, os_default or mariadb_repo (the source field of the DB_MARIADB_VERSION options). The recipe's words on purpose, because that field is exactly the source; PHP_SOURCE has its own words for the opposite reason. This ties the value set to the manifest: a source added or renamed there changes these values while installed boxes keep the old one, so in the update manifests (Phase 3, #947) that is a migration entry, never a rename. DB_SYSTEM stays the host register and says nothing about a local package (#978, #980)"
  },
  "DB_MARIADB_VERSION": {
   "class": "system",
   "default": "",
   "note": "the MariaDB pin, e.g. 11.4; the source is DB_MARIADB_SYSTEM (#935)"
  },
  "DB_PMA_ALIAS": {
   "class": "system",
   "default": ""
  },
  "DB_POSTGRESQL_SYSTEM": {
   "class": "system",
   "default": "",
   "note": "a local PostgreSQL package is installed; value = source, os (#979)"
  },
  "DB_SYSTEM": {
   "class": "system",
   "default": "",
   "tokens": true,
   "token_fn": "sys_key_token_set",
   "note": "the panel-side host register: the database types with a registered host (h-add-database-host, any host, local or remote). Never a package statement and never source or version - those are DB_MARIADB_SYSTEM/DB_MARIADB_VERSION and DB_POSTGRESQL_SYSTEM (#980)"
  },

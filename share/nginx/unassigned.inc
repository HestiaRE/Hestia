server {
	listen      directIP:80 default_server;
	server_name _;
	access_log  off;
	error_log   /dev/null;

	# The hostname's ACME answer on mail-only, where no web domain carries it. Keeps step with ACME_APACHE_DIR.
	location ^~ /.well-known/acme-challenge/ {
		alias /var/lib/hestia-acme/host/;
		default_type text/plain;
	}

	location / {
		root /var/www/html;

		location /phpmyadmin/ {
			alias  /var/www/document_errors/;
			return 404;
		}

		location /webmail {
			alias  /var/www/document_errors/;
			return 404;
		}

		location /webmail/ {
			alias  /var/www/document_errors/;
			return 404;
		}

		location /error/ {
			alias /var/www/document_errors/;
		}
	}
}

server {
	listen              directIP:443 default_server ssl;
	server_name         _;
	access_log          off;
	error_log           /dev/null;
	ssl_certificate     /etc/ssl/hestia/certificate.crt;
	ssl_certificate_key /etc/ssl/hestia/certificate.key;
	return              301 http://$host$request_uri;

	location / {
		root /var/www/document_errors/;
	}

	location /error/ {
		alias /var/www/document_errors/;
	}
}
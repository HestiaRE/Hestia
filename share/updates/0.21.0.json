{
  "version": "0.21.0",
  "entries": [
    {
      "id": "cron-update-check",
      "description": "The daily update check calls a command inside bin/, where the sudo grant reaches; the old line was refused and the panel banner never appeared",
      "conditions": [
        { "type": "file_contains", "path": "/var/spool/cron/crontabs/hestia", "value": "sudo bash /usr/local/hestia/update.sh --check" }
      ],
      "action": { "type": "function_call", "function": "cron_update_check_apply" },
      "paths": ["/var/spool/cron/crontabs/hestia"],
      "reversible": false
    },
    {
      "id": "cron-locale",
      "description": "Every nightly job runs under one language, so a translated program message cannot be matched against an English word",
      "conditions": [
        { "type": "file_lacks", "path": "/var/spool/cron/crontabs/hestia", "value": "LC_ALL=C" }
      ],
      "action": { "type": "function_call", "function": "cron_locale_apply" },
      "paths": ["/var/spool/cron/crontabs/hestia"],
      "reversible": false
    },
    {
      "id": "cron-repair-locale",
      "description": "The repair schedule gets the same language pin; it is not operator surface, so it is rewritten whole",
      "conditions": [
        { "type": "file_lacks", "path": "/etc/cron.d/hestia-repair", "value": "LC_ALL=C" }
      ],
      "action": { "type": "function_call", "function": "system_repair_cron_write" },
      "paths": ["/etc/cron.d/hestia-repair"],
      "reversible": false
    },
    {
      "id": "sieve-lmtp",
      "description": "Sieve delivery runs over dovecot's LMTP service now; the package and its config sit outside the tree",
      "conditions": [
        { "type": "key_is", "name": "SIEVE_SYSTEM", "value": "yes" },
        { "type": "path_absent", "path": "/etc/dovecot/conf.d/25-lmtp.conf" }
      ],
      "action": { "type": "function_call", "function": "sieve_lmtp_apply" },
      "paths": ["/etc/dovecot/conf.d/25-lmtp.conf"],
      "reversible": false
    },
    {
      "id": "exim-lmtp-subaddressing",
      "description": "Plus-subaddressing routers and the LMTP transport, patched into a file the operator may have edited",
      "conditions": [
        { "type": "file_patch_pending", "source": "share/updates/patches/0.21.0/exim-lmtp-subaddressing.patch", "target": "/etc/exim4/exim4.conf.template" }
      ],
      "action": { "type": "function_call", "function": "exim_lmtp_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false,
      "after": "0.21.0/sieve-lmtp"
    }
  ]
}

{
  "version": "0.22",
  "entries": [
    {
      "id": "ntpdate-package",
      "description": "ntpdate for the daily clock step; ntpsec-ntpdate is the package that carries it on all four targets",
      "conditions": [
        { "type": "path_absent", "path": "/usr/sbin/ntpdate" }
      ],
      "action": { "type": "package_install", "name": "ntpsec-ntpdate" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "cron-ntpdate",
      "description": "The repair schedule steps the clock daily at 07:00, after the backups that suspend the guest; not operator surface, so it is rewritten whole",
      "conditions": [
        { "type": "file_lacks", "path": "/etc/cron.d/hestia-repair", "value": "ntpdate" }
      ],
      "action": { "type": "function_call", "function": "system_repair_cron_write" },
      "paths": ["/etc/cron.d/hestia-repair"],
      "reversible": false,
      "after": "0.22/ntpdate-package"
    },
    {
      "id": "sieve-redirect-envelope",
      "description": "Sieve redirects send from the mailbox instead of the original sender, whose SPF fails at the target; 90-sieve.conf is not operator surface",
      "conditions": [
        { "type": "key_is", "name": "SIEVE_SYSTEM", "value": "yes" },
        { "type": "file_lacks", "path": "/etc/dovecot/conf.d/90-sieve.conf", "value": "sieve_redirect_envelope_from = orig_recipient" }
      ],
      "action": { "type": "function_call", "function": "sieve_redirect_apply" },
      "paths": ["/etc/dovecot/conf.d/90-sieve.conf"],
      "reversible": false
    },
    {
      "id": "sieve-vacation-recipient",
      "description": "The Sieve vacation answers mail that came in through an alias or catch-all, as exim's autoreply does; both dovecot versions spell the setting with check_recipient",
      "conditions": [
        { "type": "key_is", "name": "SIEVE_SYSTEM", "value": "yes" },
        { "type": "file_lacks", "path": "/etc/dovecot/conf.d/90-sieve.conf", "value": "check_recipient" }
      ],
      "action": { "type": "function_call", "function": "sieve_vacation_apply" },
      "paths": ["/etc/dovecot/conf.d/90-sieve.conf"],
      "reversible": false,
      "after": "0.22/sieve-redirect-envelope"
    },
    {
      "id": "fail2ban-panel-web-ban",
      "description": "The panel login jail bans on 80/443 too, where a panel-proxy domain takes the same login; jail.d/hestia.local is ours, not the admin's jail.local",
      "conditions": [
        { "type": "file_contains", "path": "/etc/fail2ban/jail.d/hestia.local", "value": "hestia[name=HESTIA]" }
      ],
      "action": { "type": "function_call", "function": "fail2ban_panel_action_apply" },
      "paths": ["/etc/fail2ban/jail.d/hestia.local", "/etc/fail2ban/action.d/hestia-panel.conf"],
      "reversible": false
    },
    {
      "id": "exim-autoreply-rfc3834",
      "description": "The exim autoreply skips bounces, list and automated mail and spam, and answers a sender once a week; patched into a file the operator may have edited",
      "conditions": [
        { "type": "file_patch_pending", "source": "share/updates/patches/0.22/exim-autoreply-rfc3834.patch", "target": "/etc/exim4/exim4.conf.template" }
      ],
      "action": { "type": "function_call", "function": "exim_autoreply_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false,
      "after": "0.21/exim-lmtp-subaddressing"
    },
    {
      "id": "exim-spam-header-strip",
      "description": "Incoming X-Spam-* headers are dropped before the rspamd scan, so a sender can no longer keep spam out of the spam folder with their own X-Spam-Status; patched into a file the operator may have edited",
      "conditions": [
        { "type": "file_patch_pending", "source": "share/updates/patches/0.22/exim-spam-header-strip.patch", "target": "/etc/exim4/exim4.conf.template" }
      ],
      "action": { "type": "function_call", "function": "exim_spam_header_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false,
      "after": "0.22/exim-autoreply-rfc3834"
    }
  ]
}

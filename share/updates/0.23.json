{
  "version": "0.23",
  "entries": [
    {
      "id": "mail-ssl-modes",
      "description": "Mail certificate files go from 644 to 640: exim reads them through the mail group, and every domain operation used to reset the keys of all domains on the box",
      "conditions": [
        { "type": "file_mode_wider", "path": "/home/*/conf/mail/*/ssl/*", "value": "640" }
      ],
      "action": { "type": "function_call", "function": "mail_ssl_modes_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "smtp-relay-modes-box",
      "description": "The box-wide SMTP relay file holds the relay password in clear text and was written 644: 640 root:Debian-exim",
      "conditions": [
        { "type": "file_mode_wider", "path": "/etc/exim4/smtp_relay.conf", "value": "640" }
      ],
      "action": { "type": "function_call", "function": "smtp_relay_modes_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "smtp-relay-modes-domain",
      "description": "A per-domain SMTP relay file was 644 until the next mail rebuild: 660 Debian-exim:mail like the rest of conf/mail/<domain>",
      "conditions": [
        { "type": "file_mode_wider", "path": "/home/*/conf/mail/*/smtp_relay.conf", "value": "660" }
      ],
      "action": { "type": "function_call", "function": "smtp_relay_modes_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "php-versions-configure",
      "description": "An OS-PHP install never ran h-add-web-php: distro php.ini with exec() open to customers, the www pool live, no bcmath or soap. bcmath is what only that command installs",
      "conditions": [{ "type": "php_ext_missing", "name": "bcmath" }],
      "action": { "type": "function_call", "function": "php_versions_configure_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "php-modules",
      "description": "redis, igbinary and mcrypt joined the extension set every PHP version gets. After the configure entry, which installs the whole set and would otherwise find bcmath already there",
      "conditions": [{ "type": "php_ext_missing", "name": "redis,igbinary,mcrypt" }],
      "action": { "type": "function_call", "function": "php_modules_apply" },
      "paths": [],
      "reversible": false,
      "after": "0.23/php-versions-configure"
    },
    {
      "id": "php-cli-pcntl",
      "description": "The CLI carried the FPM pcntl_* block, so occ and the Magento indexers could not fork. Only the exact line h-add-web-php wrote; an edited one stays",
      "conditions": [{ "type": "file_contains", "path": "/etc/php/*/cli/php.ini", "value": "disable_functions = pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wifcontinued,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority" }],
      "action": { "type": "function_call", "function": "php_cli_pcntl_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "ioncube-pin",
      "description": "The ionCube loader stays on the version it was installed with: no update path calls h-add-sys-*. Only where the addon is installed",
      "conditions": [
        { "type": "pin_differs", "name": "ioncube", "path": "/usr/local/lib/ioncube/hestia-pin" }
      ],
      "action": { "type": "function_call", "function": "ioncube_pin_apply" },
      "paths": [],
      "reversible": false
    },
    {
      "id": "roundcube-pool-opcache",
      "description": "The Roundcube pool's PHP 8.5 shim shortened the function table in a cache it shares with phpMyAdmin, so whichever app came second answered 500; the pool now runs without OPcache",
      "conditions": [
        { "type": "path_exists", "path": "/etc/php/hestia/fpm/pool.d/roundcube.conf" },
        { "type": "file_differs", "source": "share/panel-php/pool.d/roundcube.conf", "target": "/etc/php/hestia/fpm/pool.d/roundcube.conf" }
      ],
      "action": { "type": "file_copy", "source": "share/panel-php/pool.d/roundcube.conf", "target": "/etc/php/hestia/fpm/pool.d/roundcube.conf", "mode": "644" },
      "paths": ["/etc/php/hestia/fpm/pool.d/roundcube.conf"],
      "reversible": true
    }
  ]
}

    {
      "id": "remove-h-update-web-templates",
      "description": "h-update-web-templates is gone: nothing called it, and it fetched nothing any more",
      "conditions": [
        {
          "type": "path_exists",
          "path": "/usr/local/hestia/bin/h-update-web-templates"
        }
      ],
      "action": {
        "type": "path_delete",
        "path": "/usr/local/hestia/bin/h-update-web-templates"
      },
      "paths": [
        "/usr/local/hestia/bin/h-update-web-templates"
      ],
      "reversible": false
    },
    {
      "id": "remove-share-multiphp-tpl",
      "description": "share/php-fpm/multiphp.tpl is gone: nothing rendered it, the customer pools come from templates/php",
      "conditions": [
        {
          "type": "path_exists",
          "path": "/usr/local/hestia/share/php-fpm/multiphp.tpl"
        }
      ],
      "action": {
        "type": "path_delete",
        "path": "/usr/local/hestia/share/php-fpm/multiphp.tpl"
      },
      "paths": [
        "/usr/local/hestia/share/php-fpm/multiphp.tpl"
      ],
      "reversible": false
    },
    {
      "id": "web-model-snapshot-private",
      "description": "The web-model switch snapshots carry every customer's TLS and DKIM keys and were readable by every local account",
      "conditions": [
        {
          "type": "file_mode_wider",
          "path": "/var/lib/hestia/web-model-switch",
          "value": "700"
        }
      ],
      "action": {
        "type": "function_call",
        "function": "web_model_snap_dir_apply"
      },
      "paths": [],
      "reversible": false
    },
    {
      "id": "filemanager-refresh",
      "description": "The file manager code and listeners were copied once and never refreshed; they follow the tree now, with a catch-all on the private port. Decided by index.php, the app is that one file",
      "conditions": [
        {
          "type": "path_exists",
          "path": "/usr/share/filemanager/fm/index.php"
        },
        {
          "type": "file_differs",
          "source": "share/filemanager/fm/index.php",
          "target": "/usr/share/filemanager/fm/index.php"
        }
      ],
      "action": {
        "type": "function_call",
        "function": "filemanager_refresh_apply"
      },
      "paths": [],
      "reversible": false
    }
  ]
}

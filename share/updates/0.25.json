      "reversible": false
    },
    {
      "id": "remove-suspend-admin-apache2-stpl",
      "description": "The suspend apache2 template holds its SSL block itself now, the separate .stpl is gone",
      "conditions": [
        {
          "type": "path_exists",
          "path": "/usr/local/hestia/share/web/suspend/admin/apache2.stpl"
        }
      ],
      "action": {
        "type": "path_delete",
        "path": "/usr/local/hestia/share/web/suspend/admin/apache2.stpl"

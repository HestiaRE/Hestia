{
  "version": "0.28",
  "entries": [
    {
      "id": "dovecot-login-alias",
      "description": "A mailbox can carry a second login name from /etc/dovecot/login-aliases, which is created empty; dovecot 2.4 only, patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "IMAP_SYSTEM", "value": "dovecot" },
        { "type": "file_contains", "path": "/etc/dovecot/conf.d/auth-passwdfile.conf.ext", "value": "/etc/exim4/domains/%{ user | domain }/passwd" },
        {
          "type": "file_patch_pending",
          "source": "share/updates/patches/0.28/dovecot-login-alias.patch",
          "target": "/etc/dovecot/conf.d/auth-passwdfile.conf.ext"
        }
      ],
      "action": { "type": "function_call", "function": "dovecot_login_alias_apply" },
      "paths": ["/etc/dovecot/conf.d/auth-passwdfile.conf.ext"],
      "reversible": false
    },
    {
      "id": "remove-h-add-user-wp-cli",
      "description": "h-add-user-wp-cli is gone: wp-cli is always installed system-wide and pinned, a per-user copy only shadowed it",
      "conditions": [
        { "type": "path_exists", "path": "/usr/local/hestia/bin/h-add-user-wp-cli" }
      ],
      "action": { "type": "path_delete", "path": "/usr/local/hestia/bin/h-add-user-wp-cli" },
      "paths": ["/usr/local/hestia/bin/h-add-user-wp-cli"],
      "reversible": false
    },
    {
      "id": "remove-h-add-user-composer",
      "description": "h-add-user-composer is gone: composer is always installed system-wide, a per-user copy only shadowed it",
      "conditions": [
        { "type": "path_exists", "path": "/usr/local/hestia/bin/h-add-user-composer" }
      ],
      "action": { "type": "path_delete", "path": "/usr/local/hestia/bin/h-add-user-composer" },
      "paths": ["/usr/local/hestia/bin/h-add-user-composer"],
      "reversible": false
    }
  ]
}

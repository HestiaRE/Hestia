{
  "version": "0.29",
  "entries": [
    {
      "id": "fail2ban-unban-caller",
      "description": "An unban fail2ban runs itself no longer calls fail2ban back and waits out its 60 s timeout, which held every stop and reboot with a ban; loaded by a reload, the bans stay",
      "conditions": [
        { "type": "path_exists", "path": "/etc/fail2ban/action.d/hestia.conf" },
        { "type": "file_differs", "source": "share/fail2ban/action.d/hestia.conf", "target": "/etc/fail2ban/action.d/hestia.conf" }
      ],
      "action": { "type": "function_call", "function": "fail2ban_unban_caller_apply" },
      "paths": ["/etc/fail2ban/action.d/hestia.conf", "/etc/fail2ban/action.d/hestia-panel.conf"],
      "reversible": false
    },
    {
      "id": "firewall-boot-banlist",
      "description": "The boot ruleset no longer carries the bans, CrowdSec decisions and blocklists of the last render; hestia-nftables loads them from banlist.conf and the cache files after the ruleset, so a reboot neither revives a lifted entry nor drops a current one. One render writes both",
      "conditions": [
        { "type": "key_is", "name": "FIREWALL_SYSTEM", "value": "nftables" },
        { "type": "file_lacks", "path": "/lib/systemd/system/hestia-nftables.service", "value": "h-update-firewall-sets" }
      ],
      "action": { "type": "function_call", "function": "firewall_boot_banlist_apply" },
      "paths": ["/etc/hestia/firewall/ruleset.nft", "/etc/hestia/firewall/ruleset.applied.nft", "/lib/systemd/system/hestia-nftables.service"],
      "reversible": false
    },
    {
      "id": "adminer-plugins-token",
      "description": "Adminer's plugin file drops a posted token of the wrong shape, which ended in a PHP Fatal before any login",
      "conditions": [
        { "type": "path_exists", "path": "/usr/share/adminer/adminer-plugins.php" },
        { "type": "file_differs", "source": "share/adminer/adminer-plugins.php", "target": "/usr/share/adminer/adminer-plugins.php" }
      ],
      "action": { "type": "file_copy", "source": "share/adminer/adminer-plugins.php", "target": "/usr/share/adminer/adminer-plugins.php" },
      "paths": ["/usr/share/adminer/adminer-plugins.php"],
      "reversible": true
    }
  ]
}

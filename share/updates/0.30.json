{
  "version": "0.30",
  "entries": [
    {
      "id": "tachyon-pin",
      "description": "Tachyon 4.5.0: fixes in how the message view shows the DKIM result and IMAP keywords",
      "conditions": [
        { "type": "pin_differs", "name": "tachyon", "path": "/var/lib/tachyon/data/VERSION" }
      ],
      "action": { "type": "function_call", "function": "tachyon_pin_apply" },
      "paths": ["/var/lib/tachyon"],
      "reversible": false
    },
    {
      "id": "adminer-core",
      "description": "Adminer 6.3.0 as shipped: it checks the CSRF token again when login data is posted along (skipped since 6.0.1). h-add-sys-adminer stops at an existing install",
      "conditions": [
        { "type": "path_exists", "path": "/usr/share/adminer/index.php" },
        { "type": "file_differs", "source": "share/adminer/adminer.php", "target": "/usr/share/adminer/index.php" }
      ],
      "action": { "type": "file_copy", "source": "share/adminer/adminer.php", "target": "/usr/share/adminer/index.php" },
      "paths": ["/usr/share/adminer/index.php"],
      "reversible": true
    },
    {
      "id": "exim-auth-results",
      "description": "exim drops incoming authentication result and spam/virus verdict headers and adds its own, so webmail shows only the server's verdict; patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "MAIL_SYSTEM", "value": "exim4" },
        { "type": "file_patch_pending", "source": "share/updates/patches/0.30/exim-auth-results.patch", "target": "/etc/exim4/exim4.conf.template" }
      ],
      "action": { "type": "function_call", "function": "exim_auth_results_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false
    }
  ]
}

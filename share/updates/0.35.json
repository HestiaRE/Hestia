{
  "version": "0.35",
  "entries": [
    {
      "id": "exim-sieve-only",
      "description": "exim hands every clean mail to Sieve and no longer answers autoreplies itself: the vacation rules in Sieve answer, and an autoreply still in exim is moved there first. Patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "MAIL_SYSTEM", "value": "exim4" },
        { "type": "key_is", "name": "SIEVE_SYSTEM", "value": "yes" },
        {
          "type": "file_patch_pending",
          "source": "share/updates/patches/0.35/exim-sieve-only.patch",
          "target": "/etc/exim4/exim4.conf.template"
        }
      ],
      "action": { "type": "function_call", "function": "exim_sieve_only_apply" },
      "paths": ["/etc/exim4/exim4.conf.template", "/var/spool/exim4/db"],
      "reversible": false
    },
    {
      "id": "dovecot-quota-status",
      "description": "dovecot answers exim at RCPT whether a mailbox is full",
      "conditions": [
        { "type": "key_is", "name": "IMAP_SYSTEM", "value": "dovecot" },
        { "type": "path_absent", "path": "/etc/dovecot/conf.d/11-quota-status.conf" }
      ],
      "action": { "type": "function_call", "function": "dovecot_quota_status_apply" },
      "paths": ["/etc/dovecot/conf.d"],
      "reversible": false
    },
    {
      "id": "exim-quota-status",
      "description": "A full mailbox is refused in the SMTP session instead of bounced to the sender days later; forward-only accounts are left out. Patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "MAIL_SYSTEM", "value": "exim4" },
        {
          "type": "file_patch_pending",
          "source": "share/updates/patches/0.35/exim-quota-status.patch",
          "target": "/etc/exim4/exim4.conf.template"
        }
      ],
      "action": { "type": "function_call", "function": "exim_quota_status_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false
    },
    {
      "id": "exim-ratelimit-inbound",
      "description": "The per-account send limit counts only authenticated senders and the local relay: inbound mail was keyed on its sending host and refused with 550 once that host passed the limit. Patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "MAIL_SYSTEM", "value": "exim4" },
        {
          "type": "file_patch_pending",
          "source": "share/updates/patches/0.35/exim-ratelimit-inbound.patch",
          "target": "/etc/exim4/exim4.conf.template"
        }
      ],
      "action": { "type": "function_call", "function": "exim_ratelimit_inbound_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false
    },
    {
      "id": "exim-sieve-forward",
      "description": "Forwards move into the mailbox's Sieve script: exim hands a forward-only account's clean mail to Sieve and drops only its spam, and Sieve mail no longer counts against the websites' send limit on dovecot 2.4 (on 2.3, where it comes as the mailbox owner, it gets a bucket of its own per customer). Patched into a file the operator may have edited",
      "conditions": [
        { "type": "key_is", "name": "MAIL_SYSTEM", "value": "exim4" },
        {
          "type": "file_patch_pending",
          "source": "share/updates/patches/0.35/exim-sieve-forward.patch",
          "target": "/etc/exim4/exim4.conf.template"
        }
      ],
      "action": { "type": "function_call", "function": "exim_sieve_forward_apply" },
      "paths": ["/etc/exim4/exim4.conf.template"],
      "reversible": false
    },
    {
      "id": "sieve-max-redirects",
      "description": "A mail may run 8 Sieve redirects instead of 4: the panel's 4 forward targets plus the customer's own filters, since one redirect over the limit stops all of them. Skipped where the line was changed by hand",
      "conditions": [
        { "type": "key_is", "name": "IMAP_SYSTEM", "value": "dovecot" },
        { "type": "file_contains", "path": "/etc/dovecot/conf.d/90-sieve.conf", "value": "#sieve_max_redirects = 4" }
      ],
      "action": { "type": "function_call", "function": "sieve_max_redirects_apply" },
      "paths": ["/etc/dovecot/conf.d/90-sieve.conf"],
      "reversible": false
    },
    {
      "id": "forward-bounces-cron",
      "description": "A daily job deletes the bounces a forward-only mailbox keeps of its failed forwards once they are 7 days old; nobody reads such a mailbox. One line added to the hestia crontab, the rest stays as it is",
      "conditions": [
        { "type": "path_exists", "path": "/var/spool/cron/crontabs/hestia" },
        { "type": "file_lacks", "path": "/var/spool/cron/crontabs/hestia", "value": "h-delete-mail-forward-bounces" }
      ],
      "action": { "type": "function_call", "function": "forward_bounces_cron_apply" },
      "paths": ["/var/spool/cron/crontabs/hestia"],
      "reversible": false
    },
    {
      "id": "fail2ban-pyinotify",
      "description": "fail2ban watches its logs through inotify: polling dropped exim's log for good after a rotation on a quiet box, and with it the exim jail",
      "conditions": [
        { "type": "package_installed", "name": "fail2ban" },
        { "type": "path_absent", "path": "/usr/lib/python3/dist-packages/pyinotify.py" }
      ],
      "action": { "type": "function_call", "function": "fail2ban_pyinotify_apply" },
      "paths": ["/usr/lib/python3/dist-packages"],
      "reversible": false
    }
  ]
}

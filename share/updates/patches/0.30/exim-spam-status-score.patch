--- exim4.conf.template
+++ exim4.conf.template
@@ -301,8 +301,14 @@
  warn   condition      = ${if !eq{$acl_m2}{} {yes}{no}}
         condition      = ${if >{$acl_m2}{$acl_m4} {yes}{no}}
         add_header     = X-Spam-Status: Yes
+        add_header     = X-Spam-Info: $spam_score/${eval:$acl_m4/10}.${eval:$acl_m4%10}
         message        = rspamd detected spam (from $sender_address to $recipients).
 
+  # Spam keeps a bare Yes: the vacation's Sieve test is :is "Yes". Webmail reads the score from the rest.
+ warn   condition      = ${if !eq{$acl_m2}{} {yes}{no}}
+        condition      = ${if >{$acl_m2}{$acl_m4} {no}{yes}}
+        add_header     = X-Spam-Status: No, score=$spam_score required=${eval:$acl_m4/10}.${eval:$acl_m4%10}
+
   # Blacklisted sender: always spam — marked without a scan (.Spam foldering
   # and the subject tag key off the header), refused while reject_spam is on
   deny   message        = Sender address is blacklisted for the recipient domain

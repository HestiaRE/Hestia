--- a/exim4.conf.template
+++ b/exim4.conf.template
@@ -202,6 +202,15 @@
 
   require verify        = sender
 
+  # A full mailbox is refused in the session, never bounced days later to a sender that may be forged. A forward-only
+  # account stores nothing; no answer from dovecot accepts.
+  deny    domains       = +local_domains
+          set acl_m_box = ${lc:${sg{$local_part}{\N\+.*$\N}{}}}
+          condition     = ${lookup{$acl_m_box}lsearch{/etc/exim4/domains/${lookup{$domain}dsearch{/etc/exim4/domains/}}/passwd}{true}{false}}
+          condition     = ${if exists{/etc/exim4/domains/$domain/fwd_only}{${lookup{$acl_m_box}lsearch{/etc/exim4/domains/${lookup{$domain}dsearch{/etc/exim4/domains/}}/fwd_only}{false}{true}}}{true}}
+          condition     = ${if match{${readsocket{/run/dovecot/quota-status}{request=smtpd_access_policy\nrecipient=$acl_m_box@$domain\n\n}{5s}{}{}}}{\N^action=552\N}}
+          message       = 552 5.2.2 Mailbox is full
+
   accept  hosts         = +relay_from_hosts
           control       = submission
 

--- a/exim4.conf.template
+++ b/exim4.conf.template
@@ -92,9 +92,12 @@
 DKIM_SELECTOR_FILE = /etc/exim4/domains/${lookup{${lc:${domain:$h_from:}}}dsearch{/etc/exim4/domains/}}/selector
 DKIM_SELECTOR_NAME = ${if exists{DKIM_SELECTOR_FILE}{${lookup{selector}lsearch{DKIM_SELECTOR_FILE}{$value}{mail}}}{mail}}
 
-OUTGOING_IP = /etc/exim4/domains/${lookup{$sender_address_domain}dsearch{/etc/exim4/domains}}/ip
+# The domain that picks relay, outgoing address and relay exceptions. A null sender sent with SMTP AUTH (read receipt,
+# delivery report) takes the login's domain; a bounce has none. No ':' in it: SMTP_RELAY_FILE is a require_files list.
+SENDER_DOMAIN = ${if eq{$sender_address_domain}{}{${extract{2}{@}{$authenticated_id}}}{$sender_address_domain}}
+OUTGOING_IP = /etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains}}/ip
 # A second FILE so every /ip reader stays untouched; missing = no v6 pin, kernel picks.
-OUTGOING6_IP = /etc/exim4/domains/${lookup{$sender_address_domain}dsearch{/etc/exim4/domains}}/ipv6
+OUTGOING6_IP = /etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains}}/ipv6
 
 # Per-domain spam subject tag (h-change-mail-domain-spam-subject-tag): if the
 # recipient domain has this file, its content replaces the global
@@ -103,7 +106,7 @@
 SPAM_SUBJECT_TAG_FILE = /etc/exim4/domains/${lookup{$domain}dsearch{/etc/exim4/domains/}}/spam_subject_tag
 SPAM_SUBJECT_TAG_ACTIVE = ${if and{{match{$h_X-Spam-Status:}{\N^Yes\N}}{exists{SPAM_SUBJECT_TAG_FILE}}}{yes}{no}}
 
-SMTP_RELAY_FILE = ${if exists{/etc/exim4/domains/${lookup{$sender_address_domain}dsearch{/etc/exim4/domains}}/smtp_relay.conf}{/etc/exim4/domains/${lookup{$sender_address_domain}dsearch{/etc/exim4/domains}}/smtp_relay.conf}{/etc/exim4/smtp_relay.conf}}
+SMTP_RELAY_FILE = ${if exists{/etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains}}/smtp_relay.conf}{/etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains}}/smtp_relay.conf}{/etc/exim4/smtp_relay.conf}}
 SMTP_RELAY_HOST = ${lookup{host}lsearch{SMTP_RELAY_FILE}}
 SMTP_RELAY_PORT = ${lookup{port}lsearch{SMTP_RELAY_FILE}}
 SMTP_RELAY_USER = ${lookup{user}lsearch{SMTP_RELAY_FILE}}

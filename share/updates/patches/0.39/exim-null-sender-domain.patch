+  require_files = /etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains/}{$value}{no.such.dir}}/smtp_relay_exclude
+  condition = ${lookup{$domain}nwildlsearch{/etc/exim4/domains/${lookup{SENDER_DOMAIN}dsearch{/etc/exim4/domains/}{$value}{no.such.dir}}/smtp_relay_exclude}{yes}{no}}
